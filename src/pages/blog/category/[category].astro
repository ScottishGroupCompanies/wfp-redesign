---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BrandLogos from '../../../components/BrandLogos.astro';
import InnerPageHero from '../../../components/InnerPageHero.astro';
import { getCollection } from 'astro:content';
import { allCategories, benefitCategories, cityCategories, getCategoryBySlug } from '../../../data/categories';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  return allCategories.map((cat) => {
    const posts = allPosts
      .filter((p) => p.data.category === cat.slug)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { category: cat.slug },
      props: { category: cat, posts },
    };
  });
}

const { category, posts } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const title = `${category.label} Window Film Articles | Window Film Philadelphia`;
const description = category.description;

// Related categories (same group, excluding current)
const relatedCats = (category.group === 'benefit' ? benefitCategories : cityCategories)
  .filter((c) => c.slug !== category.slug)
  .slice(0, 6);
---

<BaseLayout
  title={title}
  description={description}
  canonical={`https://www.windowfilmphiladelphia.net/blog/category/${category.slug}/`}
>

<InnerPageHero
  title={`${category.label} Articles`}
  bgImage="/images/wfp-premium-films-v2.jpg"
  desc={category.description}
/>

<div class="ip-page-body">

  <!-- ══════════════════════════════════════
       BREADCRUMB + INTRO
       ══════════════════════════════════════ -->
  <div class="cat-intro">
    <nav class="cat-breadcrumb" aria-label="Breadcrumb">
      <a href="/blog/">Blog</a>
      <span aria-hidden="true">›</span>
      <span>{category.label}</span>
    </nav>

    <div class="cat-intro__head">
      <div>
        <span class="section-eyebrow">
          {category.group === 'city' ? 'City' : 'Topic'} Category
        </span>
        <h1 class="section-title">{category.label} <em>Articles</em></h1>
        <p class="cat-intro__desc">{category.description}</p>
      </div>
      <div class="cat-intro__meta">
        <span class="cat-post-count">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</span>
        {category.href && (
          <a href={category.href} class="cat-service-link">
            View {category.label} Service Page →
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       POST GRID
       ══════════════════════════════════════ -->
  <div class="blog-grid-wrap">
    {posts.length === 0 ? (
      <div class="cat-empty">
        <p>No articles published in this category yet. <a href="/blog/">Browse all articles →</a></p>
      </div>
    ) : (
      <div class="blog-grid">
        {posts.map((post) => (
          <article class="blog-card">
            {post.data.image && (
              <a href={`/blog/${post.slug}/`} class="blog-card__img-link" tabindex="-1" aria-hidden="true">
                <div class="blog-card__img">
                  <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" width="760" height="420" />
                </div>
              </a>
            )}
            <div class="blog-card__body">
              <div class="blog-card__meta">
                <a href={`/blog/category/${category.slug}/`} class="blog-card__cat">{category.label}</a>
                <span class="blog-card__date">{formatDate(post.data.pubDate)}</span>
              </div>
              <h2 class="blog-card__title">
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h2>
              <p class="blog-card__excerpt">{post.data.description}</p>
              <a href={`/blog/${post.slug}/`} class="blog-card__read-more">
                Read Article <span aria-hidden="true">&#8594;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>

  <!-- ══════════════════════════════════════
       RELATED CATEGORIES
       ══════════════════════════════════════ -->
  {relatedCats.length > 0 && (
    <div class="cat-related">
      <span class="section-eyebrow">
        {category.group === 'city' ? 'Other Cities' : 'Browse by Topic'}
      </span>
      <h2 class="cat-related__title">More Categories</h2>
      <div class="cat-related__pills">
        {relatedCats.map((c) => (
          <a href={`/blog/category/${c.slug}/`} class="cat-pill">{c.label}</a>
        ))}
        <a href="/blog/" class="cat-pill cat-pill--all">All Articles →</a>
      </div>
    </div>
  )}

  <!-- ══════════════════════════════════════
       BRAND LOGOS + CTA
       ══════════════════════════════════════ -->
  <BrandLogos />

  <div class="ip-cta">
    <h2>Ready to transform your <em>windows?</em></h2>
    <div class="ip-cta__btns">
      <a href="/contact/" class="ip-btn ip-btn--white">Get a Free Quote</a>
      <a href="tel:+12673947980" class="ip-btn ip-btn--green">Call (267) 394-7980</a>
    </div>
  </div>

</div><!-- end ip-page-body -->

</BaseLayout>

<style>
/* ── PAGE BODY WRAPPER ── */
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* ── INTRO ── */
.cat-intro {
  padding: 60px 10% 40px;
}
.cat-breadcrumb {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  color: var(--text-light, #888);
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.cat-breadcrumb a {
  color: var(--green, #81AB4C);
  text-decoration: none;
}
.cat-breadcrumb a:hover { text-decoration: underline; }

.cat-intro__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
  flex-wrap: wrap;
}
.cat-intro__desc {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.75;
  max-width: 580px;
  margin: 12px 0 0;
}
.cat-intro__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10px;
  flex-shrink: 0;
}
.cat-post-count {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  font-weight: 600;
  color: var(--text-light, #888);
  background: var(--off-white, #F7F6F3);
  padding: 6px 14px;
  border-radius: 100px;
}
.cat-service-link {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  font-weight: 600;
  color: var(--green, #81AB4C);
  text-decoration: none;
  transition: opacity 0.2s;
}
.cat-service-link:hover { opacity: 0.75; }

/* ── SHARED SECTION LABELS ── */
.section-eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 12px;
}
.section-title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 8px;
}
.section-title em { font-style: italic; color: var(--green, #81AB4C); }

/* ── EMPTY STATE ── */
.cat-empty {
  text-align: center;
  padding: 80px 20px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: var(--text-mid, #4a4a4a);
}
.cat-empty a { color: var(--green, #81AB4C); text-decoration: none; }
.cat-empty a:hover { text-decoration: underline; }

/* ── BLOG GRID ── */
.blog-grid-wrap { padding: 0 5% 80px; }
.blog-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}

/* ── BLOG CARD ── */
.blog-card {
  background: #fff;
  border-radius: var(--radius-lg, 24px);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border: 1px solid var(--light-gray, #EFEFED);
  transition: box-shadow 0.25s ease, transform 0.25s ease;
}
.blog-card:hover {
  box-shadow: 0 16px 48px rgba(0,0,0,0.10);
  transform: translateY(-4px);
}
.blog-card__img-link { display: block; overflow: hidden; }
.blog-card__img { height: 220px; overflow: hidden; }
.blog-card__img img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform 0.4s ease;
}
.blog-card:hover .blog-card__img img { transform: scale(1.04); }
.blog-card__body {
  padding: 24px 24px 28px;
  background: var(--off-white, #F7F6F3);
  display: flex; flex-direction: column; flex: 1;
}
.blog-card__meta {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 12px; flex-wrap: wrap;
}
.blog-card__cat {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px;
  color: #fff; background: var(--green, #81AB4C);
  padding: 3px 10px; border-radius: var(--radius-pill, 100px);
  text-decoration: none;
  transition: background 0.2s;
}
.blog-card__cat:hover { background: #6e9640; }
.blog-card__date {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 12px; color: var(--text-light, #888); font-weight: 500;
}
.blog-card__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(16px, 1.6vw, 20px);
  font-weight: 700; line-height: 1.3; letter-spacing: -0.2px; margin-bottom: 10px;
}
.blog-card__title a { color: var(--text-dark, #1a1a1a); text-decoration: none; transition: color 0.2s; }
.blog-card__title a:hover { color: var(--green, #81AB4C); }
.blog-card__excerpt {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px; color: var(--text-mid, #4a4a4a);
  line-height: 1.7; flex: 1; margin-bottom: 18px;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}
.blog-card__read-more {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px; font-weight: 700; color: var(--green, #81AB4C);
  text-decoration: none; display: inline-flex; align-items: center;
  gap: 4px; transition: gap 0.2s; align-self: flex-start;
}
.blog-card__read-more:hover { gap: 8px; }

/* ── RELATED CATEGORIES ── */
.cat-related {
  padding: 0 10% 80px;
}
.cat-related__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(24px, 2.5vw, 36px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 24px;
  line-height: 1.2;
}
.cat-related__pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.cat-pill {
  display: inline-block;
  padding: 10px 20px;
  background: var(--off-white, #F7F6F3);
  border: 1px solid var(--light-gray, #EFEFED);
  border-radius: 100px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  font-weight: 500;
  color: var(--text-mid, #4a4a4a);
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s, background 0.2s;
}
.cat-pill:hover {
  border-color: var(--green, #81AB4C);
  color: var(--green, #81AB4C);
}
.cat-pill--all {
  background: var(--brand, #272E32);
  color: #fff;
  border-color: var(--brand, #272E32);
  font-weight: 600;
}
.cat-pill--all:hover {
  background: #1a2320;
  border-color: #1a2320;
  color: #fff;
}

/* ── Buttons ── */
.ip-btn {
  display: inline-block; padding: 14px 28px;
  border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; font-weight: 500;
  text-decoration: none; transition: all 0.2s;
  border: 2px solid transparent; white-space: nowrap;
}
.ip-btn--white { background: #fff; color: var(--brand, #272E32); border-color: #fff; font-weight: 600; }
.ip-btn--white:hover { background: var(--off-white, #F7F6F3); transform: translateY(-2px); color: var(--brand, #272E32); }
.ip-btn--green { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.ip-btn--green:hover { background: #6e9640; transform: translateY(-2px); color: #fff; }

/* ── CTA BANNER ── */
.ip-cta {
  background: var(--brand, #272E32);
  border-radius: var(--radius-xl, 40px);
  padding: 64px 60px;
  display: flex; align-items: center;
  justify-content: space-between; gap: 40px; margin: 0 5%;
}
.ip-cta h2 {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 32px; font-weight: 600; color: #fff;
  line-height: 1.2; max-width: 460px; margin: 0;
}
.ip-cta h2 em { font-style: italic; color: var(--green, #81AB4C); }
.ip-cta__btns { display: flex; gap: 14px; flex-shrink: 0; }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .blog-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .cat-intro { padding: 48px 5% 32px; }
  .cat-intro__head { flex-direction: column; align-items: flex-start; }
  .cat-intro__meta { align-items: flex-start; }
  .blog-grid-wrap { padding: 0 5% 56px; }
  .blog-grid { grid-template-columns: 1fr; }
  .cat-related { padding: 0 5% 60px; }
  .ip-cta { flex-direction: column; padding: 40px 28px; text-align: center; }
  .ip-cta h2 { font-size: 26px; max-width: 100%; }
  .ip-cta__btns { flex-direction: column; width: 100%; }
}
</style>
