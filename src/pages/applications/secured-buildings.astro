  .of-space-card--dark-pattern {
    grid-column: span 4;
    border-radius: 24px;
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-shadow: 0 4px 20px rgba(0,0,0,0.18);
