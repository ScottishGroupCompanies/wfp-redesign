  .of-space-card__pill {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #7CB342;
    background: rgba(124,179,66,0.12);
    border: 1px solid rgba(124,179,66,0.25);
    padding: 6px 14px;
    border-radius: 100px;
    align-self: flex-start;
  }

  /* Cards 2 & 3: Photo — each spans 3 cols */
  .of-space-card--photo {
    grid-column: span 3;
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    min-height: 420px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .of-space-card--photo:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); }
  .of-space-card--photo:hover .of-space-card__img { transform: scale(1.04); }
  .of-space-card__img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    inset: 0;
    transition: transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .of-space-card__photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,20,14,0.88) 0%, rgba(10,20,14,0.3) 55%, rgba(10,20,14,0.05) 100%);
