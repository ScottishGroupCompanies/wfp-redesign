        <!-- Row 3: Glare & Comfort — image LEFT, text RIGHT -->
        <div class="of-row">
          <div class="of-row__image">
            <img
              src="/images/hc-glare.jpg"
              alt="Philadelphia home office, person comfortable at desk, afternoon sun diffused through treated window, no screen glare"
              width="680" height="480" loading="lazy" decoding="async"
            />
