    <script>
      // Split Text Reveal
      var splitObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          var el = entry.target;
          var stagger = el.dataset.stagger || '65';
          el.style.setProperty('--split-stagger', stagger + 'ms');
          el.classList.add('is-visible');
          splitObs.unobserve(el);
        });
      }, { threshold: 0.35 });
      document.querySelectorAll('.split-reveal').forEach(function(el) { splitObs.observe(el); });

      // Hand Drawn Title
      var handObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          handObs.unobserve(entry.target);
        });
      }, { threshold: 0.5 });
      document.querySelectorAll('.hand-drawn').forEach(function(el) { handObs.observe(el); });

      // Testimonial Stack
      document.querySelectorAll('.tstack').forEach(function(el) {
        var deck = el.querySelector('.tstack__deck');
        var cards = Array.from(deck.querySelectorAll('.tstack__card'));
        var order = cards.map(function(_,i){return i;});
        function restack() { order.forEach(function(ci,i){ cards[ci].style.setProperty('--i',String(i)); cards[ci].classList.remove('is-leaving'); }); }
        function advance() { var top = order[0]; cards[top].classList.add('is-leaving'); setTimeout(function(){ order.push(order.shift()); restack(); }, 450); }
        deck.addEventListener('click', advance);
        var dragging=false, startX=0;
        deck.addEventListener('mousedown', function(e){dragging=true;startX=e.clientX;});
        window.addEventListener('mouseup', function(e){if(dragging){dragging=false;if(Math.abs(startX-e.clientX)>60)advance();}});
        deck.addEventListener('touchstart',function(e){dragging=true;startX=e.touches[0].clientX;},{passive:true});
        window.addEventListener('touchend',function(e){if(dragging){dragging=false;if(Math.abs(startX-e.changedTouches[0].clientX)>60)advance();}});
      });

      // CTA Tint Slider
      document.querySelectorAll('.ctat').forEach(function(el) {
        var range = el.querySelector('.ctat__range');
        var tint = el.querySelector('.ctat__tint');
        var vltNum = el.querySelector('.ctat__vlt-num');
        if (!range) return;
        function update() { var v=Number(range.value); tint.style.setProperty('--tint',String(v/100)); vltNum.textContent=String(100-v); }
        range.addEventListener('input', update);
        update();
      });

      // Count Up
      var countUpObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          entry.target.querySelectorAll('[data-count-end]').forEach(function(el) {
            var end = parseInt(el.dataset.countEnd||'0',10);
            var suffix = el.dataset.countSuffix||'';
            var n = 0, step = end/60;
            var timer = setInterval(function(){
              n = Math.min(n+step, end);
              el.textContent = Math.round(n)+suffix;
              if(n>=end) clearInterval(timer);
            }, 30);
          });
          countUpObserver.unobserve(entry.target);
        });
      }, {threshold: 0.3});
      document.querySelectorAll('.countup').forEach(function(el){ countUpObserver.observe(el); });

      // Before/After Slider
      document.querySelectorAll('.before-after').forEach(function(el) {
        var frame = el.querySelector('.before-after__frame');
        var afterImg = el.querySelector('.before-after__img--after');
        var handle = el.querySelector('.before-after__handle');
        function setFrameWidth() {
          afterImg.style.setProperty('--frame-width', frame.offsetWidth + 'px');
        }
        function setPos(clientX) {
          var rect = frame.getBoundingClientRect();
          var pct = Math.max(0, Math.min(100, (clientX - rect.left) / rect.width * 100));
          el.style.setProperty('--pos', pct + '%');
          handle.setAttribute('aria-valuenow', String(Math.round(pct)));
        }
        var dragging = false;
        frame.addEventListener('mousedown', function(e) { dragging = true; setPos(e.clientX); });
        window.addEventListener('mouseup', function() { dragging = false; });
        window.addEventListener('mousemove', function(e) { if (dragging) setPos(e.clientX); });
        frame.addEventListener('touchstart', function(e) { dragging = true; setPos(e.touches[0].clientX); }, { passive: true });
        window.addEventListener('touchend', function() { dragging = false; });
        window.addEventListener('touchmove', function(e) { if (dragging) setPos(e.touches[0].clientX); }, { passive: true });
        handle.addEventListener('keydown', function(e) {
          var rect = frame.getBoundingClientRect();
          var cur = parseFloat(getComputedStyle(el).getPropertyValue('--pos')) || 50;
          if (e.key === 'ArrowLeft') setPos(rect.left + rect.width * (cur - 5) / 100);
          if (e.key === 'ArrowRight') setPos(rect.left + rect.width * (cur + 5) / 100);
        });
        window.addEventListener('resize', setFrameWidth);
        setFrameWidth();
      });

      // Gallery Banner
      document.querySelectorAll('.gallery-banner').forEach(function(el) {
        var strips = Array.from(el.querySelectorAll('.gallery-banner__strip'));
        strips.forEach(function(strip) {
          strip.addEventListener('click', function() {
            var wasActive = strip.classList.contains('is-active');
            strips.forEach(function(s) { s.classList.remove('is-active'); });
            if (!wasActive) strip.classList.add('is-active');
          });
        });
      });
    </script>

