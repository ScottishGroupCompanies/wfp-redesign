  .of-space-card--badge:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); }
  .of-space-card--badge:hover .of-space-card__img { transform: scale(1.04); }
  .of-space-card__badge-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(10,20,14,0.92) 0%, rgba(13,26,15,0.8) 50%, rgba(10,20,14,0.6) 100%);
    z-index: 2;
  }
  .of-space-card__badge-content {
    position: absolute;
    inset: 0;
    z-index: 5;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .of-space-card__badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #7CB342;
    background: rgba(124,179,66,0.12);
    border: 1px solid rgba(124,179,66,0.22);
    padding: 5px 10px;
    border-radius: 100px;
