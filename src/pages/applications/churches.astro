---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Church Window Film in Philadelphia | UV Protection, Privacy & Aesthetic Preservation';
const description = 'Window film for Philadelphia churches: protect historic stained glass, reduce UV exposure for congregations, improve comfort. Respectful installation that preserves architectural beauty.';

const heroImage = 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161507_0fcd75a1-4235-4a9d-b519-9a25205ae475.png';

const benefits = [
  {
    title: 'UV Protection',
    body: 'Block up to 99% of harmful UV rays, protecting congregation members and preserving historic stained glass, wood finishes, and upholstered seating from sun damage.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>`,
  },
  {
    title: 'Privacy',
    body: 'Frosted and decorative window films provide congregations with privacy without sacrificing natural light — ideal for confessionals, meeting rooms, and street-facing windows.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
  },
  {
    title: 'Aesthetic Preservation',
    body: 'Our films are designed to respect the historic character of Philadelphia\'s churches. Choose from nearly invisible solar films or decorative options that complement — not replace — original architecture.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    title: 'Energy Savings',
    body: 'Reduce cooling costs in large sanctuaries with tall windows. Solar control films reject heat gain, easing HVAC load and keeping congregations comfortable year-round.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
];

const stats = [
  { value: '99%', label: 'UV Blocked' },
  { value: '15+', label: 'Years Serving Philly Churches' },
  { value: '5,000+', label: 'Projects Completed' },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/applications/churches/" serviceName="Church Window Film" serviceDesc="Window film for churches and houses of worship in Philadelphia. UV protection, privacy, and aesthetic preservation." serviceUrl="https://www.windowfilmphiladelphia.net/applications/churches/">

<InnerPageHero
  title="Church Window Film"
  desc="Historic preservation · UV protection · Congregational comfort"
  bgImage={heroImage}
/>

<div class="ip-page-body">

  <!-- Benefits Section -->
  <section class="church-benefits">
    <div class="church-benefits__hd">
      <span class="eyebrow">Why Window Film</span>
      <h2 class="church-benefits__title">Designed for sacred spaces</h2>
      <p class="church-benefits__sub">Philadelphia's historic churches deserve solutions that honor their architecture while adding modern protection and comfort.</p>
    </div>
    <div class="church-benefits__grid">
      {benefits.map((b) => (
        <div class="benefit-card fade-in">
          <div class="benefit-card__icon" set:html={b.icon} />
          <h3 class="benefit-card__title">{b.title}</h3>
          <p class="benefit-card__body">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Why Churches Section -->
  <section class="church-why">
    <div class="church-why__inner">
      <span class="eyebrow">Our Approach</span>
      <h2 class="church-why__title">Preserving historic character while adding comfort</h2>
      <p class="church-why__body">Philadelphia is home to centuries-old churches featuring stained glass, original woodwork, and irreplaceable architectural details. Our window film solutions are chosen with care — from virtually invisible solar films that protect without altering appearance, to decorative options that enhance rather than replace historic character. We work closely with congregations and preservation committees to ensure every installation respects the building's legacy while delivering real, measurable benefits.</p>
    </div>
  </section>

  <!-- Statistics Row -->
  <section class="church-stats">
    {stats.map((s) => (
      <div class="stat-card fade-in">
        <span class="stat-card__value">{s.value}</span>
        <span class="stat-card__label">{s.label}</span>
      </div>
    ))}
  </section>

  <!-- CTA Section -->
  <section class="church-cta">
    <div class="church-cta__inner">
      <h2 class="church-cta__title">Ready to protect your <em>house of worship?</em></h2>
      <p class="church-cta__body">Our team provides free consultations for churches throughout Philadelphia and southern New Jersey.</p>
      <a href="/contact/" class="cta-btn-green">Get a Free Quote</a>
    </div>
  </section>

  <BrandLogos />

</div>

</BaseLayout>

<style>
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

.eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

/* Benefits */
.church-benefits {
  padding: 100px 10%;
  background: var(--off-white, #F7F6F3);
}
.church-benefits__hd {
  margin-bottom: 64px;
}
.church-benefits__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 16px;
}
.church-benefits__sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: var(--text-mid, #4a4a4a);
  max-width: 600px;
  line-height: 1.7;
  margin: 0;
}
.church-benefits__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.benefit-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 36px 28px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.benefit-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(0,0,0,0.10);
}
.benefit-card__icon {
  color: var(--green, #81AB4C);
  margin-bottom: 20px;
  display: flex;
}
.benefit-card__icon svg { display: block; }
.benefit-card__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 22px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 12px;
}
.benefit-card__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.75;
  margin: 0;
}

/* Why Churches */
.church-why {
  padding: 100px 10%;
  background: #ffffff;
}
.church-why__inner {
  max-width: 760px;
}
.church-why__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 24px;
}
.church-why__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.8;
  margin: 0;
}

/* Statistics */
.church-stats {
  padding: 80px 10%;
  background: var(--brand, #272E32);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
}
.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 20px 40px;
  border-right: 1px solid rgba(255,255,255,0.1);
}
.stat-card:last-child { border-right: none; }
.stat-card__value {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(40px, 5vw, 64px);
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
  margin-bottom: 8px;
}
.stat-card__label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-weight: 500;
  color: rgba(255,255,255,0.55);
  letter-spacing: 0.5px;
}

/* CTA */
.church-cta {
  padding: 80px 10%;
  background: var(--off-white, #F7F6F3);
}
.church-cta__inner {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 20px;
  max-width: 680px;
}
.church-cta__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 44px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  line-height: 1.2;
  margin: 0;
}
.church-cta__title em {
  font-style: italic;
  color: var(--green, #81AB4C);
}
.church-cta__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.7;
  margin: 0;
}
.cta-btn-green {
  display: inline-block;
  padding: 14px 32px;
  border-radius: 100px;
  background: var(--green, #81AB4C);
  color: #ffffff;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.2s, transform 0.2s;
}
.cta-btn-green:hover {
  background: #6e9640;
  transform: translateY(-2px);
  color: #ffffff;
}

/* Animations */
.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* Responsive */
@media (max-width: 1024px) {
  .church-benefits__grid { grid-template-columns: repeat(2, 1fr); }
  .church-stats { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 768px) {
  .church-benefits { padding: 60px 5%; }
  .church-benefits__grid { grid-template-columns: 1fr; }
  .church-why { padding: 60px 5%; }
  .church-stats { grid-template-columns: 1fr; padding: 60px 5%; }
  .stat-card { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .stat-card:last-child { border-bottom: none; }
  .church-cta { padding: 60px 5%; }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>