<script>
  // ── FAQ Accordion ──
  document.querySelectorAll('.swt-faq__item').forEach(item => {
    item.querySelector('.swt-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('swt-faq__item--open');
      document.querySelectorAll('.swt-faq__item').forEach(i => i.classList.remove('swt-faq__item--open'));
      if (!isOpen) item.classList.add('swt-faq__item--open');
    });
  });

  // ── Film Types Slider ──
  (() => {
    const track = document.getElementById('ofFtypeTrack');
    if (!track) return;
    const slides = Array.from(document.querySelectorAll('.of-ftype__slide'));
    const navItems = Array.from(document.querySelectorAll('[data-ofnav]'));
    const progressBar = document.getElementById('ofFtypeProgressBar');
    let current = 0;
    let timer;
    let progress = 0;
    const DURATION = 7000;
    const TICK = 50;

    function goTo(idx) {
      slides[current].classList.remove('of-ftype-active');
      navItems[current] && navItems[current].classList.remove('of-ftype__nav-item--active');
      current = ((idx % slides.length) + slides.length) % slides.length;
      slides[current].classList.add('of-ftype-active');
      navItems[current] && navItems[current].classList.add('of-ftype__nav-item--active');
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      progress = 0;
      if (progressBar) progressBar.style.width = '0%';
    }

    function startTimer() {
      clearInterval(timer);
      progress = 0;
      timer = setInterval(() => {
        progress += (TICK / DURATION) * 100;
        if (progressBar) progressBar.style.width = Math.min(progress, 100) + '%';
        if (progress >= 100) goTo(current + 1);
      }, TICK);
    }

    goTo(0);
    startTimer();

    const nextBtn = document.getElementById('ofFtypeNext');
    const prevBtn = document.getElementById('ofFtypePrev');
    if (nextBtn) nextBtn.addEventListener('click', () => { goTo(current + 1); startTimer(); });
    if (prevBtn) prevBtn.addEventListener('click', () => { goTo(current - 1); startTimer(); });
    navItems.forEach(btn => btn.addEventListener('click', () => { goTo(Number(btn.dataset.ofnav)); startTimer(); }));

    document.querySelectorAll('.of-ftype__faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.of-ftype__faq-item');
        const answer = item && item.querySelector('.of-ftype__faq-a');
        const icon = btn.querySelector('.of-ftype__faq-icon');
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        const slide = btn.closest('.of-ftype__slide');
        if (slide) {
          slide.querySelectorAll('.of-ftype__faq-q').forEach(b => {
            b.setAttribute('aria-expanded', 'false');
            const ic = b.querySelector('.of-ftype__faq-icon');
            if (ic) ic.style.transform = '';
            const a = b.closest('.of-ftype__faq-item') && b.closest('.of-ftype__faq-item').querySelector('.of-ftype__faq-a');
            if (a) a.hidden = true;
          });
        }
        if (!isOpen) {
          btn.setAttribute('aria-expanded', 'true');
          if (icon) icon.style.transform = 'rotate(45deg)';
          if (answer) answer.hidden = false;
        }
      });
    });
  })();
</script>
</BaseLayout>

