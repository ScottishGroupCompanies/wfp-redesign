  /* Responsive */
  @media (max-width: 1024px) {
    .of-space-card--hero { grid-column: span 12; min-height: auto; }
    .of-space-card--photo { grid-column: span 6; }
    .of-space-card--dark,
    .of-space-card--dark-pattern,
    .of-space-card--badge { grid-column: span 4; }
  }
  @media (max-width: 768px) {
    .of-spaces { padding: 64px 20px; }
