     SHARED TOKENS
  ══════════════════════════════════════ */
  :root {
    --of-green:        #4E6B2A;
    --of-green-light:  #7CB342;
    --of-dark:         #0D1A0F;
    --of-cream:        #F4EFE6;
    --of-alt:          #ECE4D4;
    --of-border:       #E1D6C1;
    --of-text-sec:     #5a6650;
    --of-white:        #ffffff;
    --of-radius:       6px;
  }

  /* ══════════════════════════════════════
     HERO
  ══════════════════════════════════════ */
  .of-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .of-hero__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
  }
  .of-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(13, 26, 15, 0.55) 0%,
      rgba(13, 26, 15, 0.78) 50%,
      rgba(13, 26, 15, 0.95) 100%
    );
  }
  .of-hero__content {
    position: relative;
    z-index: 10;
    max-width: 860px;
    padding: 120px 24px 80px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Eyebrow pill */
  .of-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(124, 179, 66, 0.85);
    margin-bottom: 28px;
    background: rgba(124, 179, 66, 0.08);
    border: 1px solid rgba(124, 179, 66, 0.2);
    padding: 8px 18px;
    border-radius: 100px;
  }
  .of-hero__eyebrow-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(124, 179, 66, 0.4);
    flex-shrink: 0;
  }

  /* H1 */
  .of-hero__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 700;
    color: #F3F6F1;
    line-height: 1.1;
    margin-bottom: 20px;
    letter-spacing: -0.01em;
  }
  .of-hero__br { display: none; }

  /* Animated flip line */
  .of-hero__animated-line {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.2rem, 2.5vw, 1.65rem);
    font-weight: 400;
    font-style: italic;
    color: rgba(243, 246, 241, 0.9);
    margin-bottom: 20px;
    line-height: 1.4;
  }
  .of-hero__flip.flipwords-wrap { display: inline; }
  .of-hero__flip .fw-word-col {
    display: inline-flex;
    flex-direction: column;
    position: relative;
    vertical-align: baseline;
  }
  .of-hero__flip .fw-word {
    display: block;
    position: absolute;
    top: 0; left: 0;
    white-space: nowrap;
    font-style: normal;
    min-width: unset;
  }
  .of-hero__flip .fw-word.is-active { position: relative; }

  /* Subtitle */
  .of-hero__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    color: rgba(243, 246, 241, 0.72);
    max-width: 680px;
    margin-bottom: 36px;
    line-height: 1.75;
  }

  /* CTA buttons */
  .of-hero__cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 56px;
  }
  .of-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 30px;
    background: var(--of-green);
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--of-radius);
    border: 2px solid var(--of-green);
    transition: background 0.2s, transform 0.2s;
  }
  .of-hero__btn-primary:hover {
    background: #3D5620;
    border-color: #3D5620;
    transform: translateY(-2px);
  }
  .of-hero__btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 26px;
    background: transparent;
    color: rgba(255,255,255,0.82);
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--of-radius);
    border: 2px solid rgba(255,255,255,0.3);
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }
  .of-hero__btn-secondary:hover {
    color: #fff;
    border-color: rgba(255,255,255,0.65);
    transform: translateY(-2px);
  }

  /* Stats panel */
  .of-hero__stats-panel {
    width: 100%;
    max-width: 720px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--of-radius);
    backdrop-filter: blur(8px);
    padding: 24px 32px;
  }
  .of-hero__stats-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .of-hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex: 1;
  }
  .of-hero__stat-number {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--of-green-light);
    line-height: 1;
  }
  .of-hero__stat-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.45);
    text-align: center;
  }
  .of-hero__stat-divider {
    width: 1px;
    height: 36px;
    background: rgba(255,255,255,0.12);
    flex-shrink: 0;
  }

  /* ══════════════════════════════════════
     TRUST BAR (shared swt- class)
  ══════════════════════════════════════ */
  .swt-trust {
    background: #ffffff;
    padding: 32px 0;
    border-bottom: 1px solid var(--of-border);
  }
  .swt-trust__label {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--of-text-sec);
    text-align: center;
    margin: 0 0 20px;
    opacity: 0.7;
  }
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 5%;
  }
  .swt-body {
    background: var(--of-white);
  }

  /* ══════════════════════════════════════
     RESPONSIVE
  ══════════════════════════════════════ */
  @media (max-width: 768px) {
    .of-hero__content { padding: 90px 20px 60px; }
    .of-hero__stats-inner { flex-wrap: wrap; gap: 20px; }
    .of-hero__stat-divider { display: none; }
    .of-hero__stat { flex: 0 0 45%; }
    .of-hero__br { display: block; }
    .of-hero__cta { flex-direction: column; align-items: center; }
  }
  @media (max-width: 480px) {
    .of-hero__stats-panel { padding: 20px 16px; }
    .of-hero__stat { flex: 0 0 100%; }
  }

  /* ══════════════════════════════════════
     WHAT IS
  ══════════════════════════════════════ */
  .of-whatis {
    background: #fff;
    padding: 96px 5%;
  }
  .of-whatis__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }
  .of-whatis__eyebrow {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--of-green);
    margin-bottom: 16px;
  }
  .of-whatis__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.9rem, 3vw, 2.8rem);
    font-weight: 700;
    color: var(--of-dark);
    line-height: 1.15;
    margin-bottom: 20px;
  }
  .of-whatis__body a { color: #7CB342; text-decoration: underline; text-decoration-color: #7CB342; text-underline-offset: 3px; font-weight: 500; transition: color 0.2s ease; }
  .of-whatis__body a:hover { color: #2E6B30; text-decoration-color: #2E6B30; }
  .of-whatis__body {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: var(--of-text-sec);
    line-height: 1.8;
    margin-bottom: 14px;
  }
  .of-whatis__stats {
    display: flex;
    align-items: center;
    gap: 0;
    margin-top: 28px;
    padding: 20px 24px;
    background: var(--of-cream);
    border-radius: var(--of-radius);
    border: 1px solid var(--of-border);
  }
  .of-whatis__stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
  }
  .of-whatis__stat strong {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--of-green);
    line-height: 1;
  }
  .of-whatis__stat span {
    font-family: 'Inter', sans-serif;
    font-size: 0.68rem;
    color: var(--of-text-sec);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }
  .of-whatis__stat-div {
    width: 1px;
    height: 40px;
    background: var(--of-border);
    flex-shrink: 0;
  }
  .of-whatis__image-wrap {
    position: relative;
    border-radius: var(--of-radius);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(13,26,15,0.12);
  }
  .of-whatis__image {
    width: 100%;
    height: 480px;
    object-fit: cover;
    display: block;
  }

  /* ══════════════════════════════════════
     WHY / PROBLEM
  ══════════════════════════════════════ */
  .of-why {
    background: var(--of-alt);
    padding: 96px 5%;
  }
  .of-why__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }
  .of-why__image-wrap {
    position: relative;
  }
  .of-why__image {
    width: 100%;
    height: 560px;
    object-fit: cover;
    border-radius: var(--of-radius);
    display: block;
    box-shadow: 0 24px 60px rgba(13,26,15,0.12);
  }
  .of-why__stat-card {
    position: absolute;
    bottom: -16px;
    right: -16px;
    background: var(--of-dark);
    border-radius: var(--of-radius);
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: 0 12px 32px rgba(13,26,15,0.25);
    min-width: 240px;
  }
  .of-why__stat-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    line-height: 1.4;
  }
  .of-why__stat-divider {
    height: 1px;
    background: rgba(255,255,255,0.1);
  }
  .of-why__eyebrow {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--of-green);
    margin-bottom: 14px;
  }
  .of-why__headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.7rem, 2.8vw, 2.5rem);
    font-weight: 700;
    color: var(--of-dark);
    line-height: 1.15;
    margin-bottom: 18px;
  }
  .of-why__intro {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: var(--of-text-sec);
    line-height: 1.8;
    margin-bottom: 20px;
  }
  .of-why__bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .of-why__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: var(--of-text-sec);
    line-height: 1.65;
  }
  .of-why__bullets li svg {
    flex-shrink: 0;
    margin-top: 3px;
  }
  .of-why__climate-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 28px;
    padding: 20px;
    background: rgba(255,255,255,0.6);
    border: 1px solid var(--of-border);
    border-radius: var(--of-radius);
  }
  .of-why__climate-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: center;
  }
  .of-why__climate-num {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--of-green);
    line-height: 1;
  }
  .of-why__climate-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    color: var(--of-text-sec);
    line-height: 1.4;
    font-weight: 500;
  }
  .of-why__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--of-green);
    text-decoration: none;
    border-bottom: 2px solid var(--of-green);
    padding-bottom: 2px;
    transition: gap 0.2s;
  }
  .of-why__cta:hover { gap: 12px; }

  /* ══════════════════════════════════════
     BENTO BAND
  ══════════════════════════════════════ */
  .of-bento {
    background: var(--of-dark);
    padding: 80px 5%;
  }
  .of-bento__header {
    max-width: 800px;
    margin: 0 auto 48px;
    text-align: center;
  }
  .of-bento__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    font-weight: 700;
    color: #F3F6F1;
    line-height: 1.2;
    margin-bottom: 12px;
  }
  .of-bento__sub {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: rgba(243,246,241,0.5);
    line-height: 1.7;
  }
  .of-bento__compact {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
  }
  .of-bento-item {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: background 0.2s;
  }
  .of-bento-item:hover { background: rgba(255,255,255,0.07); }
  .of-bento-item__title {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: #F3F6F1;
    line-height: 1.2;
    margin: 0;
  }
  .of-bento-item__text {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: rgba(243,246,241,0.52);
    line-height: 1.75;
    margin: 0;
  }

  /* ══════════════════════════════════════
     OFFICE SPACE TYPE GRID
  ══════════════════════════════════════ */
  .of-spaces {
    background: #0d1a0f;
    padding: 100px 24px;
  }
  .of-spaces__container { max-width: 1200px; margin: 0 auto; }
  .of-spaces__header {
    text-align: center;
    margin-bottom: 60px;
  }
  .of-spaces__eyebrow {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #7CB342;
    margin-bottom: 14px;
  }
  .of-spaces__headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: #F3F6F1;
    margin-bottom: 16px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .of-spaces__sub {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: rgba(243,246,241,0.65);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Grid */
  .of-spaces__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
  }
  .of-space-card {
    border-radius: 24px;
    transition: transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94), box-shadow 0.3s ease, border-color 0.3s ease;
  }

  /* Card 1: Hero — spans 6 cols */
  .of-space-card--hero {
    grid-column: span 6;
    background: linear-gradient(145deg, #1a3024 0%, #0d1a0f 60%);
    border: 1px solid rgba(124,179,66,0.15);
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0 4px 24px rgba(0,0,0,0.2);
    min-height: 420px;
  }
  .of-space-card--hero:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); border-color: rgba(124,179,66,0.25); }
  .of-space-card__hero-icon { margin-bottom: 24px; }
  .of-space-card__hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    font-weight: 700;
    color: #F3F6F1;
    line-height: 1.2;
    margin-bottom: 16px;
  }
  .of-space-card__hero-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: rgba(243,246,241,0.7);
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .of-space-card__pill {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #7CB342;
    background: rgba(124,179,66,0.12);
    border: 1px solid rgba(124,179,66,0.25);
    padding: 6px 14px;
    border-radius: 100px;
    align-self: flex-start;
  }

  /* Cards 2 & 3: Photo — each spans 3 cols */
  .of-space-card--photo {
    grid-column: span 3;
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    min-height: 420px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .of-space-card--photo:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); }
  .of-space-card--photo:hover .of-space-card__img { transform: scale(1.04); }
  .of-space-card__img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    inset: 0;
    transition: transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .of-space-card__photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,20,14,0.88) 0%, rgba(10,20,14,0.3) 55%, rgba(10,20,14,0.05) 100%);
  }
  .of-space-card__photo-content {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 28px;
    z-index: 5;
  }
  .of-space-card__photo-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: #F3F6F1;
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .of-space-card__photo-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: rgba(243,246,241,0.75);
    line-height: 1.5;
    margin: 0;
  }

  /* Cards 4 & 5: Dark — each spans 4 cols */
  .of-space-card--dark,
  .of-space-card--dark-pattern {
    grid-column: span 4;
    border-radius: 24px;
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-shadow: 0 4px 20px rgba(0,0,0,0.18);
    position: relative;
    overflow: hidden;
    min-height: 280px;
  }
  .of-space-card--dark {
    background: linear-gradient(145deg, #14201a 0%, #0d1a0f 100%);
    border: 1px solid rgba(124,179,66,0.18);
  }
  .of-space-card--dark-pattern {
    background: linear-gradient(145deg, #1a2e20 0%, #0d1a0f 100%);
    border: 1px solid rgba(124,179,66,0.12);
  }
  .of-space-card--dark-pattern::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(124,179,66,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(124,179,66,0.04) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .of-space-card--dark:hover,
  .of-space-card--dark-pattern:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.28); border-color: rgba(124,179,66,0.28); }
  .of-space-card__accent-line {
    position: absolute;
    top: 0; left: 32px; right: 32px;
    height: 2px;
    background: linear-gradient(90deg, #7CB342, transparent);
  }
  .of-space-card__icon-row { margin-bottom: 18px; }
  .of-space-card__dark-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #F3F6F1;
    margin-bottom: 10px;
    line-height: 1.25;
  }
  .of-space-card__dark-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    color: rgba(243,246,241,0.72);
    line-height: 1.65;
    margin: 0 0 16px;
    flex: 1;
  }
  .of-space-card__micro-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: rgba(124,179,66,0.85);
    background: rgba(124,179,66,0.08);
    border: 1px solid rgba(124,179,66,0.18);
    padding: 5px 10px;
    border-radius: 100px;
    align-self: flex-start;
