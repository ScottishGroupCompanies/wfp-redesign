---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'School Window Film in Philadelphia | Student Safety, UV Protection & Energy Savings';
const description = 'Window film for Philadelphia schools and universities: protect students from UV rays, reduce energy costs, enhance safety with security film. Trusted by local school districts.';

const galleryImages = [
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163317_14b3a927-e342-43ee-8828-c1acc1f7051d.png',
    alt: 'Classroom Comfort',
    label: 'Classroom Comfort',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163320_74e330ad-de2e-4ccd-ac27-6c7879152b34.png',
    alt: 'UV Blocked',
    label: 'UV Blocked',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163903_0bd4d160-e6ac-4397-b2c9-08351ecb76f8.png',
    alt: 'Student Safety',
    label: 'Student Safety',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163329_01ae0f63-03da-4ca5-bd71-0ce4e27ca85a.png',
    alt: 'Energy Reduction',
    label: 'Energy Reduction',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163334_a5aaf22c-d21e-48ac-9e5e-3086c3f52d72.png',
    alt: 'Security Film',
    label: 'Security Film',
  },
];

const benefits = [
  {
    title: 'UV Protection',
    body: 'Block 99% of harmful UV rays, protecting students and staff',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>`,
  },
  {
    title: 'Energy Savings',
    body: 'Reduce cooling costs by up to 30%, freeing budget for education',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
  {
    title: 'Safety & Security',
    body: 'Hold glass together on impact, creating a safer learning environment',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    title: 'Glare Reduction',
    body: 'Eliminate glare on screens and whiteboards for better learning',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`,
  },
];

const whereItGoes = [
  'Classrooms',
  'Gymnasiums',
  'Libraries',
  'Admin Buildings',
  'Auditoriums',
  'Dining Halls',
];

const stats = [
  { value: '16+', label: 'Years Experience' },
  { value: '100+', label: 'School Projects' },
  { value: '99%', label: 'UV Blocked' },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/applications/schools-universities/" serviceName="School & University Window Film" serviceDesc="Window film for Philadelphia schools and universities: student safety, UV protection, and energy savings for educational facilities." serviceUrl="https://www.windowfilmphiladelphia.net/applications/schools-universities/">

<InnerPageHero
  title="School & University Window Film"
  bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161447_64483f75-fa33-47fd-ac96-bfea50d9ab9e.png"
  desc="Student Safety · UV Protection · Energy Savings"
/>

<div class="ip-page-body">

  <!-- ─── 5-IMAGE GALLERY ─── -->
  <section class="sch-gallery">
    <div class="sch-gallery__inner">
      <!-- Row 1: 3 images -->
      <div class="sch-gallery__row sch-gallery__row--3">
        {galleryImages.slice(0, 3).map((img, i) => (
          <div class="sch-gallery__item fade-in" style={`--stagger: ${i}`}>
            <div class="sch-gallery__img-wrap">
              <img src={img.src} alt={img.alt} width="480" height="480" loading="lazy" />
              <div class="sch-gallery__overlay">
                <span class="sch-gallery__label">{img.label}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <!-- Row 2: 2 images centered -->
      <div class="sch-gallery__row sch-gallery__row--2">
        {galleryImages.slice(3).map((img, i) => (
          <div class="sch-gallery__item fade-in" style={`--stagger: ${i + 3}`}>
            <div class="sch-gallery__img-wrap">
              <img src={img.src} alt={img.alt} width="480" height="480" loading="lazy" />
              <div class="sch-gallery__overlay">
                <span class="sch-gallery__label">{img.label}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── BENEFITS ─── -->
  <section class="sch-benefits">
    <div class="sch-benefits__inner">
      <div class="sch-benefits__hd">
        <span class="sch-eyebrow">Key Benefits</span>
        <h2 class="sch-section-title">Why schools choose window film</h2>
      </div>
      <div class="sch-benefits__grid">
        {benefits.map((b, i) => (
          <div class="sch-benefit-card fade-in" style={`--stagger: ${i}`}>
            <div class="sch-benefit-card__icon" set:html={b.icon} />
            <h3 class="sch-benefit-card__title">{b.title}</h3>
            <p class="sch-benefit-card__body">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── WHERE IT GOES ─── -->
  <section class="sch-where">
    <div class="sch-where__inner">
      <div class="sch-where__left">
        <span class="sch-eyebrow">Applications</span>
        <h2 class="sch-section-title">Where window film fits on campus</h2>
        <p class="sch-where__lead">From single classrooms to entire residence halls, window film is a scalable, non-disruptive upgrade that installs quickly around your academic calendar.</p>
      </div>
      <div class="sch-where__right">
        <ul class="sch-where__list">
          {whereItGoes.map((area) => (
            <li class="sch-where__item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
              {area}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ─── STATISTICS ROW ─── -->
  <section class="sch-stats">
    {stats.map((s) => (
      <div class="sch-stat-card fade-in">
        <span class="sch-stat-card__value">{s.value}</span>
        <span class="sch-stat-card__label">{s.label}</span>
      </div>
    ))}
  </section>

  <!-- ─── CTA ─── -->
  <section class="sch-cta">
    <div class="sch-cta__content">
      <h2 class="sch-cta__title">Ready to protect your students?</h2>
      <p class="sch-cta__sub">Get a free on-site assessment and custom quote for your school or university.</p>
      <div class="sch-cta__btns">
        <a href="/contact/" class="sch-btn-quote">Get a Free Quote</a>
        <a href="tel:+12673947980" class="sch-btn-phone">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.06 6.06l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (267) 394-7980
        </a>
      </div>
    </div>
  </section>

  <BrandLogos />

</div>

</BaseLayout>

<style>
/* ── Page body wrapper ── */
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* ── Eyebrow label ── */
.sch-eyebrow {
  display: inline-block;
  font-family: 'DM Sans', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

/* ── Section title ── */
.sch-section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--brand, #272E32);
  margin: 0;
}

/* ── Fade-in animation ── */
.fade-in {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity 0.6s ease, transform 0.6s ease;
  transition-delay: calc(var(--stagger, 0) * 80ms);
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ════════════════════════════════
   GALLERY
   ════════════════════════════════ */
.sch-gallery {
  background: var(--off-white, #F7F6F3);
  padding: 80px 10% 0;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
}

.sch-gallery__inner {
  max-width: 1200px;
  margin: 0 auto;
}

.sch-gallery__row {
  display: grid;
  gap: 16px;
  margin-bottom: 16px;
}

.sch-gallery__row--3 {
  grid-template-columns: repeat(3, 1fr);
}

.sch-gallery__row--2 {
  grid-template-columns: repeat(2, 1fr);
  max-width: calc(66.666% + 8px);
  margin-left: auto;
  margin-right: 0;
}

.sch-gallery__item {
  position: relative;
}

.sch-gallery__img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 16px;
  overflow: hidden;
}

.sch-gallery__img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.sch-gallery__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(39, 46, 50, 0.75) 0%, transparent 50%);
  display: flex;
  align-items: flex-end;
  padding: 20px;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.sch-gallery__item:hover .sch-gallery__overlay {
  opacity: 1;
}

.sch-gallery__item:hover .sch-gallery__img-wrap img {
  transform: scale(1.04);
}

.sch-gallery__label {
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.5px;
}

/* ════════════════════════════════
   BENEFITS
   ════════════════════════════════ */
.sch-benefits {
  background: var(--off-white, #F7F6F3);
  padding: 80px 10%;
}

.sch-benefits__inner {
  max-width: 1200px;
  margin: 0 auto;
}

.sch-benefits__hd {
  text-align: center;
  margin-bottom: 52px;
}

.sch-benefits__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.sch-benefit-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 36px 28px;
  box-shadow: 0 2px 20px rgba(0,0,0,0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.sch-benefit-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 36px rgba(0,0,0,0.12);
}

.sch-benefit-card__icon {
  width: 56px;
  height: 56px;
  background: rgba(129, 171, 76, 0.12);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  color: var(--green, #81AB4C);
}

.sch-benefit-card__title {
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  font-weight: 700;
  color: var(--brand, #272E32);
  margin: 0 0 12px;
  line-height: 1.2;
}

.sch-benefit-card__body {
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  color: rgba(39, 46, 50, 0.65);
  line-height: 1.75;
  margin: 0;
}

/* ════════════════════════════════
   WHERE IT GOES
   ════════════════════════════════ */
.sch-where {
  background: #ffffff;
  padding: 100px 10%;
}

.sch-where__inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

.sch-where__lead {
  font-family: 'DM Sans', sans-serif;
  font-size: 16px;
  color: rgba(39, 46, 50, 0.6);
  line-height: 1.75;
  margin: 20px 0 0;
}

.sch-where__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px 32px;
}

.sch-where__item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'DM Sans', sans-serif;
  font-size: 15px;
  font-weight: 500;
  color: var(--brand, #272E32);
}

.sch-where__item svg {
  color: var(--green, #81AB4C);
  flex-shrink: 0;
}

/* ════════════════════════════════
   STATISTICS
   ════════════════════════════════ */
.sch-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  background: var(--brand, #272E32);
  padding: 72px 10%;
}

.sch-stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 40px;
  border-right: 1px solid rgba(255,255,255,0.1);
}

.sch-stat-card:last-child {
  border-right: none;
}

.sch-stat-card__value {
  font-family: 'Playfair Display', serif;
  font-size: clamp(36px, 4vw, 56px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
  margin-bottom: 10px;
}

.sch-stat-card__label {
  font-family: 'DM Sans', sans-serif;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
}

/* ════════════════════════════════
   CTA SECTION
   ════════════════════════════════ */
.sch-cta {
  background: var(--brand, #272E32);
  border-top: 1px solid rgba(255,255,255,0.06);
  padding: 80px 10%;
  display: flex;
  justify-content: center;
  text-align: center;
}

.sch-cta__content {
  max-width: 600px;
}

.sch-cta__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  margin: 0 0 12px;
}

.sch-cta__sub {
  font-family: 'DM Sans', sans-serif;
  font-size: 16px;
  color: rgba(255,255,255,0.5);
  margin: 0 0 32px;
  line-height: 1.6;
}

.sch-cta__btns {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}

.sch-btn-quote {
  display: inline-block;
  padding: 16px 36px;
  background: var(--green, #81AB4C);
  color: #ffffff;
  font-family: 'DM Sans', sans-serif;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  border-radius: 100px;
  transition: background 0.2s, transform 0.2s;
}

.sch-btn-quote:hover {
  background: #6e9640;
  transform: translateY(-2px);
}

.sch-btn-phone {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 16px 28px;
  background: transparent;
  color: #ffffff;
  font-family: 'DM Sans', sans-serif;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  border-radius: 100px;
  border: 1.5px solid rgba(255,255,255,0.25);
  transition: border-color 0.2s, background 0.2s, transform 0.2s;
}

.sch-btn-phone:hover {
  border-color: rgba(255,255,255,0.6);
  background: rgba(255,255,255,0.06);
  transform: translateY(-2px);
}

/* ════════════════════════════════
   RESPONSIVE
   ════════════════════════════════ */
@media (max-width: 1024px) {
  .sch-benefits__grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .sch-where__inner {
    grid-template-columns: 1fr;
    gap: 48px;
  }
  .sch-gallery__row--2 {
    max-width: 100%;
  }
}

@media (max-width: 768px) {
  .sch-gallery,
  .sch-benefits,
  .sch-where {
    padding-left: 5%;
    padding-right: 5%;
  }
  .sch-gallery {
    padding-top: 60px;
  }
  .sch-benefits {
    padding-top: 60px;
    padding-bottom: 60px;
  }
  .sch-benefits__grid {
    grid-template-columns: 1fr;
  }
  .sch-where {
    padding-top: 60px;
    padding-bottom: 60px;
  }
  .sch-where__list {
    grid-template-columns: 1fr;
  }
  .sch-stats {
    grid-template-columns: 1fr;
    gap: 40px;
    padding: 60px 5%;
  }
  .sch-stat-card {
    border-right: none;
    padding: 0;
  }
  .sch-cta {
    padding: 60px 5%;
  }
  .sch-gallery__row--3 {
    grid-template-columns: 1fr;
  }
  .sch-gallery__row--2 {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>
