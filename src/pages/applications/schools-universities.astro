---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'School Window Film in Philadelphia | Student Safety, UV Protection & Energy Savings';
const description = 'Window film for Philadelphia schools and universities: protect students from UV rays, reduce energy costs, enhance safety with security film.';

const benefits = [
  {
    icon: 'lucide:sun',
    title: 'UV Protection',
    body: 'Block up to 99% of harmful UV rays, protecting students and staff from skin damage and reducing sun fading on classroom furnishings and equipment.',
  },
  {
    icon: 'lucide:zap',
    title: 'Energy Savings',
    body: 'Solar control film reduces heat gain through large glass expanses, lowering cooling costs and easing the load on aging HVAC systems across campus buildings.',
  },
  {
    icon: 'lucide:shield-check',
    title: 'Safety & Security',
    body: 'Security window film holds shattered glass together on impact, preventing dangerous glass shards from injuring students during storms, accidents, or attempted break-ins.',
  },
  {
    icon: 'lucide:eye-off',
    title: 'Glare Reduction',
    body: 'Eliminate screen glare and eye strain in classrooms with west and south-facing windows, creating a more comfortable learning environment throughout the day.',
  },
];

const applicationAreas = [
  { label: 'Classrooms & Lecture Halls' },
  { label: 'Administrative Offices' },
  { label: 'Gymnasiums & Auditoriums' },
  { label: 'Library & Study Spaces' },
  { label: 'Dormitories & Residence Halls' },
  { label: 'Science Labs & Computer Rooms' },
  { label: 'Campus Dining Facilities' },
  { label: 'Athletic Facilities & Locker Rooms' },
];

const stats = [
  { value: 'Up to 99%', label: 'UV Ray Blocked' },
  { value: '30%', label: 'Energy Cost Reduction' },
  { value: '3–5 Yrs', label: 'Typical ROI' },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/applications/schools-universities/" serviceName="School & University Window Film" serviceDesc="Window film for Philadelphia schools and universities. Security, energy savings, and UV protection for educational facilities." serviceUrl="https://www.windowfilmphiladelphia.net/applications/schools-universities/">

<InnerPageHero
  title="School & University Window Film"
  bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161447_64483f75-fa33-47fd-ac96-bfea50d9ab9e.png"
  desc="Student safety · UV protection · Energy savings"
/>

<div class="ip-page-body">

  <!-- Benefits Section -->
  <section class="bp-benefits">
    <div class="bp-benefits__hd">
      <span class="bp-eyebrow">Key Benefits</span>
      <h2 class="bp-benefits__title">Why schools choose window film</h2>
    </div>
    <div class="bp-benefits__grid">
      {benefits.map((b) => (
        <div class="bp-benefit-card fade-in">
          <div class="bp-benefit-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><use href={`#icon-${b.icon}`} /></svg>
          </div>
          <h3 class="bp-benefit-card__title">{b.title}</h3>
          <p class="bp-benefit-card__body">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Application Areas -->
  <section class="bp-areas">
    <div class="bp-areas__inner">
      <div class="bp-areas__left">
        <span class="bp-eyebrow">Applications</span>
        <h2 class="bp-areas__title">Where window film fits on campus</h2>
        <p class="bp-areas__lead">From single classrooms to entire residence halls, window film is a scalable, non-disruptive upgrade that installs quickly around your academic calendar.</p>
      </div>
      <div class="bp-areas__right">
        <ul class="bp-areas__list">
          {applicationAreas.map((area) => (
            <li class="bp-areas__item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
              {area.label}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Statistics Row -->
  <section class="bp-stats">
    {stats.map((s) => (
      <div class="bp-stat-card fade-in">
        <span class="bp-stat-card__value">{s.value}</span>
        <span class="bp-stat-card__label">{s.label}</span>
      </div>
    ))}
  </section>

  <!-- CTA Section -->
  <section class="bp-cta">
    <div class="bp-cta__content">
      <h2 class="bp-cta__title">Ready to protect your students <em>and</em> your budget?</h2>
      <p class="bp-cta__sub">Get a free on-site assessment and custom quote for your school or university.</p>
      <a href="/contact/" class="bp-btn-quote">Get a Free Quote</a>
    </div>
  </section>

  <BrandLogos />

</div>

</BaseLayout>

<style>
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* Eyebrow */
.bp-eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

/* Benefits */
.bp-benefits {
  padding: 100px 10%;
  background: var(--off-white, #F7F6F3);
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
}
.bp-benefits__hd { margin-bottom: 56px; }
.bp-benefits__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
}
.bp-benefits__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.bp-benefit-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 36px 28px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.07);
  transition: transform 0.2s, box-shadow 0.2s;
}
.bp-benefit-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.12);
}
.bp-benefit-card__icon {
  width: 56px;
  height: 56px;
  background: var(--green-light, #eef4e4);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  color: var(--green, #81AB4C);
}
.bp-benefit-card__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 20px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 12px;
  line-height: 1.2;
}
.bp-benefit-card__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.75;
  margin: 0;
}

/* Application Areas */
.bp-areas {
  padding: 100px 10%;
  background: #ffffff;
}
.bp-areas__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.bp-areas__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 20px;
}
.bp-areas__lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.75;
  margin: 0;
}
.bp-areas__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px 32px;
}
.bp-areas__item {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 500;
  color: var(--text-dark, #1a1a1a);
}
.bp-areas__item svg {
  color: var(--green, #81AB4C);
  flex-shrink: 0;
}

/* Statistics */
.bp-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  background: var(--brand, #272E32);
  padding: 72px 10%;
  gap: 0;
}
.bp-stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 40px;
  border-right: 1px solid rgba(255,255,255,0.12);
}
.bp-stat-card:last-child { border-right: none; }
.bp-stat-card__value {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(36px, 4vw, 56px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
  margin-bottom: 12px;
}
.bp-stat-card__label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
}

/* CTA Section */
.bp-cta {
  background: var(--brand, #272E32);
  border-top: 1px solid rgba(255,255,255,0.06);
  padding: 80px 10%;
  display: flex;
  justify-content: center;
  text-align: center;
}
.bp-cta__content { max-width: 600px; }
.bp-cta__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  margin: 0 0 16px;
}
.bp-cta__title em {
  font-style: italic;
  color: var(--green, #81AB4C);
}
.bp-cta__sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  color: rgba(255,255,255,0.55);
  margin: 0 0 36px;
  line-height: 1.6;
}
.bp-btn-quote {
  display: inline-block;
  padding: 16px 40px;
  background: var(--green, #81AB4C);
  color: #ffffff;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  border-radius: 100px;
  transition: background 0.2s, transform 0.2s;
}
.bp-btn-quote:hover {
  background: #6e9640;
  transform: translateY(-2px);
}

/* Animations */
.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* Responsive */
@media (max-width: 1024px) {
  .bp-benefits__grid { grid-template-columns: repeat(2, 1fr); }
  .bp-areas__inner { grid-template-columns: 1fr; gap: 48px; }
  .bp-stats { grid-template-columns: repeat(3, 1fr); padding: 60px 5%; }
}
@media (max-width: 768px) {
  .bp-benefits { padding: 60px 5%; }
  .bp-benefits__grid { grid-template-columns: 1fr; }
  .bp-areas { padding: 60px 5%; }
  .bp-areas__list { grid-template-columns: 1fr; }
  .bp-stats { grid-template-columns: 1fr; gap: 40px; }
  .bp-stat-card { border-right: none; padding: 0; }
  .bp-cta { padding: 60px 5%; }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>