---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import FlipWords from '../../components/FlipWords.astro';
import CategoryBlogFeed from '../../components/CategoryBlogFeed.astro';

const title = 'School Window Film in Philadelphia | UV, Safety & Energy';
const description = 'School window film for Philadelphia — ballistic resistant, blast protection, and safety film for K-12 schools and universities. UV control and energy savings included. Free assessment.';

const faqItems = [
  { question: "What is school window film for Philadelphia?", answer: "School window film for Philadelphia is professionally applied polyester film installed on educational facility glass — classroom windows, gymnasium skylights, administrative partitions, and entry doors. It blocks up to 99% of UV radiation, rejects solar heat, controls glare on smartboards and screens, and strengthens windows against forced entry, all without structural changes or disruption to the school schedule." },
  { question: "What security film options are available for Philadelphia schools?", answer: "We install the full range of school security films — from anti-intrusion safety film that meets ANSI Z97.1 and CPSC 16 CFR Part 1201 for entry points and ground-floor classrooms, to 3M Scotchshield Ultra series blast-mitigation film meeting GSA and Department of Defense glazing standards, to ballistic-resistant glazing film systems for the highest-risk areas. We assess each campus and specify the appropriate film tier for each zone. Solar control and UV protection are built into most security film selections at no additional cost." },
  { question: "Will window film darken our classrooms?", answer: "Not necessarily. UV rejection and solar control are largely independent of visible light. Many of our films block 99% of UV while maintaining 70% or more of visible light transmission — classrooms stay bright and well-lit. We select the appropriate VLT level based on each room's orientation, use, and existing light levels." },
  { question: "Can window film reduce our school's cooling costs?", answer: "Yes. Solar control film reduces the amount of solar heat entering through glass — cutting the cooling load on HVAC systems, particularly in south and west-facing classrooms that overheat in the afternoon. School districts with significant glass exposure see year-over-year reductions in energy costs." },
  { question: "How is window film installed in an occupied school?", answer: "Window film installation requires no structural work, no fumes, and minimal noise — similar to a routine maintenance visit. Individual classrooms can typically be scheduled around the school day, after hours, or during breaks. Most installations cause no disruption to instruction." },
  { question: "Does window film work on older single-pane school windows?", answer: "Yes. Window film bonds to glass surfaces and is compatible with most single-pane and double-pane window constructions found in Philadelphia's school building stock — including older buildings with original glazing. We assess compatibility during our free site survey." },
  { question: "What is the difference between solar control film and safety film for schools?", answer: "Solar control film primarily manages heat, glare, and UV transmission — improving classroom comfort and energy efficiency. Safety film primarily strengthens glass against breakage and forced entry. Many of our products combine both functions in a single film, providing solar control and safety performance simultaneously." },
  { question: "Can we get frosted film for counselor and administrative offices?", answer: "Yes. Frosted and patterned decorative films are a standard application for school counselor offices, nurse stations, administrative suites, and any glazed space requiring visual privacy without eliminating natural light. Films are removable and replaceable as your facility layout evolves." },
  { question: "How long does professionally installed school window film last?", answer: "Professionally installed window film in educational settings typically carries a 10–15 year manufacturer warranty. With proper maintenance — gentle cleaning with non-abrasive products — most films perform effectively well beyond the warranty period." },
  { question: "Is school window film covered by any energy efficiency or safety grant programs?", answer: "Some Pennsylvania school districts have accessed energy efficiency and safety improvement funding for window film projects. We provide complete product documentation, performance data, and energy savings estimates to support grant applications and district sustainability reporting." }
];

const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Applications", "item": "https://www.windowfilmphiladelphia.net/applications/" },
      { "@type": "ListItem", "position": 3, "name": "School Window Film", "item": "https://www.windowfilmphiladelphia.net/applications/schools-universities/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.windowfilmphiladelphia.net/applications/schools-universities/",
    "name": "School Window Film in Philadelphia",
    "description": "School window film for Philadelphia — block 99% UV, eliminate smartboard glare, cut energy costs, and strengthen campus security. Free site assessment.",
    "dateModified": new Date().toISOString().slice(0, 10),
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".sc-hero__title", ".of-whatis__title", ".swt-faq"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "School Window Film Solutions Philadelphia",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Safety & Security Film" },
      { "@type": "ListItem", "position": 2, "name": "UV Protection Film" },
      { "@type": "ListItem", "position": 3, "name": "Solar Control & Glare Film" },
      { "@type": "ListItem", "position": 4, "name": "Energy Efficiency (Low-E) Film" },
      { "@type": "ListItem", "position": 5, "name": "Decorative & Privacy Film" },
      { "@type": "ListItem", "position": 6, "name": "Anti-Graffiti Film" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "School Window Film Installation Philadelphia",
    "description": "Professional window film installation for Philadelphia educational facilities.",
    "brand": { "@type": "Brand", "name": "Window Film Philadelphia" },
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "5.0", "reviewCount": "47" },
    "review": [
      { "@type": "Review", "author": { "@type": "Person", "name": "Marcus T." }, "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "reviewBody": "The smartboard glare in our south-facing classrooms was a constant problem. After installation, teachers stopped having to pull blinds every afternoon. The difference was immediate." },
      { "@type": "Review", "author": { "@type": "Person", "name": "Dr. Angela R." }, "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "reviewBody": "We needed a cost-effective way to address security concerns at our entry points. Window film met our specifications and the installation was completed without disrupting a single school day." },
      { "@type": "Review", "author": { "@type": "Person", "name": "James K." }, "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "reviewBody": "Our university facilities team was impressed by the process. Film selection was tailored to each building's orientation and use, and the results are immediately visible." }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.windowfilmphiladelphia.net/applications/schools-universities/"
  serviceName="School Window Film Installation Philadelphia"
  serviceDesc="Professional window film installation for Philadelphia K-12 schools, universities, charter schools, and educational facilities."
  serviceUrl="https://www.windowfilmphiladelphia.net/applications/schools-universities/"
  faqItems={faqItems}
  schemas={pageSchemas}
>

  <!-- ══ HERO ══ -->
  <section class="of-hero sc-hero">
    <div
      class="of-hero__bg"
      role="img"
      aria-label="Philadelphia classroom with professionally installed school window film and bright natural light"
      style="background-image: url('/images/school-window-film-philadelphia-hero.jpg')"
    ></div>
    <div class="of-hero__overlay"></div>

    <div class="of-hero__content">

      <div class="of-hero__eyebrow">
        <span>School &amp; University Window Film</span>
        <span class="of-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Philadelphia</span>
      </div>

      <h1 class="sc-hero__title">School Window Film in Philadelphia</h1>

      <p class="of-hero__animated-line">
        Window film built for Philadelphia
        <FlipWords
          words={["K-12 schools", "universities", "charter schools", "private academies", "daycare centers"]}
          staticText=""
          class="of-hero__flip"
        />
      </p>

      <p class="of-hero__subtitle">
        School window film for Philadelphia K-12 schools, universities, and charter campuses — security, UV protection, glare control, and energy savings in one installation.
      </p>

      <div class="of-hero__cta">
        <a href="/contact/" class="of-hero__btn-primary">Get a Free Assessment</a>
        <a href="/gallery/" class="of-hero__btn-secondary">View Our Work</a>
      </div>

      <div class="of-hero__stats-panel" aria-label="Key statistics">
        <div class="of-hero__stats-inner">
          <div class="of-hero__stat">
            <span class="of-hero__stat-number">99%</span>
            <span class="of-hero__stat-label">UV Rays Blocked</span>
          </div>
          <div class="of-hero__stat-divider" aria-hidden="true"></div>
          <div class="of-hero__stat">
            <span class="of-hero__stat-number">79%</span>
            <span class="of-hero__stat-label">Solar Heat Rejected</span>
          </div>
          <div class="of-hero__stat-divider" aria-hidden="true"></div>
          <div class="of-hero__stat">
            <span class="of-hero__stat-number">$0</span>
            <span class="of-hero__stat-label">Structural Alterations</span>
          </div>
          <div class="of-hero__stat-divider" aria-hidden="true"></div>
          <div class="of-hero__stat">
            <span class="of-hero__stat-number">30yr</span>
            <span class="of-hero__stat-label">Film Warranty Available</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <div class="swt-body">

    <!-- ══ TRUST BAR ══ -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by Philadelphia schools, universities &amp; educational campuses</p>
        <BrandLogos />
      </div>
    </section>

    <!-- ══ WHAT IS SCHOOL WINDOW FILM ══ -->
    <section class="of-whatis">
      <div class="of-whatis__container">
        <div class="of-whatis__content">
          <span class="of-whatis__eyebrow">School Window Film · Philadelphia</span>
          <h2 class="of-whatis__title">The Film That Works as Hard as Your Facilities Team</h2>
          <p class="of-whatis__body">School window film for Philadelphia is a professionally applied polyester film that bonds directly to existing classroom, gymnasium, and administrative glass. Once installed, it blocks up to 99% of UV radiation, rejects up to 79% of solar heat, and reduces visible glare on smartboards, Chromebook screens, and projectors — without altering window frames or requiring structural work. As a 3M Certified Dealer, we match each film specification to the room's orientation, glass type, and use. For campuses prioritizing student health and material preservation, <a href="/benefits/uv-blocking-window-film-philadelphia/">UV-blocking window film</a> provides a high-impact upgrade while keeping existing windows in place.</p>
          <p class="of-whatis__body">Unlike blinds or heavy shading that block natural light entirely, window film works with your existing glass — maintaining the bright, natural learning environments students and teachers prefer while eliminating the UV, heat, and glare that compromise them. Film is compatible with virtually all glass types found in Philadelphia's school building stock, from single-pane originals in historic school buildings to modern double-pane curtain walls at newer university facilities.</p>
          <div class="of-whatis__stats">
            <div class="of-whatis__stat"><strong>99%</strong><span>UV radiation blocked</span></div>
            <div class="of-whatis__stat-div"></div>
            <div class="of-whatis__stat"><strong>79%</strong><span>Solar heat rejection available</span></div>
            <div class="of-whatis__stat-div"></div>
            <div class="of-whatis__stat"><strong>3M</strong><span>Certified Dealer</span></div>
          </div>
        </div>
        <div class="of-whatis__image-wrap">
          <img
            src="/images/school-window-film-philadelphia-what-is-window-film.jpg"
            alt="School window film applied to Philadelphia classroom glass with natural light maintained"
            class="of-whatis__image"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- ══ THE PROBLEM ══ -->
    <section class="of-why" id="problem">
      <div class="of-why__container">

        <div class="of-why__image-wrap">
          <img
            src="/images/school-window-film-philadelphia-why-schools-need-film.jpg"
            alt="Bright Philadelphia classroom with comfortable filtered daylight through treated windows"
            class="of-why__image"
            loading="lazy"
          />
          <div class="of-why__stat-card">
            <div class="of-why__stat-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>99% UV blocked for classrooms and common areas</span>
            </div>
            <div class="of-why__stat-divider"></div>
            <div class="of-why__stat-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Safety film strengthens vulnerable entry glass</span>
            </div>
          </div>
        </div>

        <div class="of-why__content">
          <div class="of-why__eyebrow">The Challenge</div>
          <h2 class="of-why__headline">Philadelphia Schools Need More Than Standard Window Glass</h2>
          <p class="of-why__intro">Standard glazing is one of the most vulnerable points in any school building — and Philadelphia's educational facilities face a range of threats that require film solutions beyond basic solar control.</p>
          <ul class="of-why__bullets">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span><strong>Unprotected Entry &amp; Classroom Glass</strong> — Ground-floor windows, door sidelights, and classroom glazing that don't meet current security standards represent the most accessible forced-entry points in any school building — a gap safety and security film closes without structural renovation.</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span><strong>Blast &amp; Pressure Vulnerability</strong> — Standard glazing shatters into dangerous fragments under blast pressure. Blast-mitigation film holds glass together and absorbs energy — protecting students from flying glass shards in the event of an explosion or severe weather impact.</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span><strong>Glare on Smartboards &amp; Screens</strong> — South and west-facing classrooms lose productive learning time when afternoon sunlight renders smartboards, projectors, and Chromebooks unreadable — a problem most security films also address.</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span><strong>UV Exposure &amp; Energy Costs</strong> — UV radiation damages student health, fades furnishings, and solar heat gain strains school HVAC budgets — solar control and UV-blocking films address both as a secondary benefit of the security upgrade.</span>
            </li>
          </ul>
          <a href="/contact/" class="of-why__cta">
            Get a free school assessment
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
          </a>
        </div>

      </div>
    </section>

    <!-- ══ BENTO BAND ══ -->
    <section class="of-bento">
      <div class="of-bento__header">
        <h2 class="of-bento__title">One Glass Upgrade. Campus-Wide Performance.</h2>
        <p class="of-bento__sub">Window film supports safety, comfort, UV protection, and energy goals without changing the building envelope.</p>
      </div>
      <div class="of-bento__compact">

        <div class="of-bento-item">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><circle cx="14" cy="14" r="9" stroke="#7CB342" stroke-width="1.5"/><path d="M14 7v2M14 19v2M7 14h2M19 14h2" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round"/><circle cx="14" cy="14" r="3" fill="#7CB342" fill-opacity="0.15" stroke="#7CB342" stroke-width="1"/></svg>
          <div>
            <h3 class="of-bento-item__title">400+</h3>
            <p class="of-bento-item__text">Philadelphia Schools &amp; Universities</p>
          </div>
        </div>

        <div class="of-bento-item">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><rect x="5" y="5" width="18" height="14" rx="2" stroke="#7CB342" stroke-width="1.5"/><path d="M9 23h10M14 19v4" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round"/><path d="M8 11h12M8 14h8" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/></svg>
          <div>
            <h3 class="of-bento-item__title">99%</h3>
            <p class="of-bento-item__text">UV Reduction Achieved</p>
          </div>
        </div>

        <div class="of-bento-item">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M14 3L5 8v7c0 5 4 9 9 10 5-1 9-5 9-10V8L14 3z" stroke="#7CB342" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 14l3 3 5-5" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div>
            <h3 class="of-bento-item__title">3M</h3>
            <p class="of-bento-item__text">Certified Dealer</p>
          </div>
        </div>

        <div class="of-bento-item">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M14 4c-1.5 4-5 6-9 6 0 7 4 12 9 14 5-2 9-7 9-14-4 0-7.5-2-9-6z" stroke="#7CB342" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 14l3 3 5-6" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/></svg>
          <div>
            <h3 class="of-bento-item__title">0</h3>
            <p class="of-bento-item__text">Classroom Days Lost During Installation</p>
          </div>
        </div>

      </div>
    </section>

    <!-- ══ SCHOOL SPACE TYPE GRID ══ -->
    <section class="of-spaces">
      <div class="of-spaces__container">

        <div class="of-spaces__header">
          <div class="of-spaces__eyebrow">Educational Settings</div>
          <h2 class="of-spaces__headline">Film Solutions for Every Philadelphia Educational Setting</h2>
          <p class="of-spaces__sub">Each facility type has different security, comfort, budget, and daylighting priorities. We specify film by room, building, and campus goal.</p>
        </div>

        <div class="of-spaces__grid">

          <div class="of-space-card of-space-card--photo">
            <img src="/images/k12-school-window-film-philadelphia-classroom.jpg" alt="K-12 school classroom windows with school window film in Philadelphia" width="400" height="480" loading="lazy" class="of-space-card__img" />
            <div class="of-space-card__photo-overlay"></div>
            <div class="of-space-card__photo-content">
              <h3 class="of-space-card__photo-title">K-12 Schools</h3>
              <p class="of-space-card__photo-text">Public, private, and charter schools across Philadelphia — safety film for entry points, UV film for classrooms, glare control for smartboard rooms.</p>
            </div>
          </div>

          <div class="of-space-card of-space-card--photo">
            <img src="/images/university-window-film-philadelphia-glass-facade.jpg" alt="Philadelphia university glass facade with professional window film installed" width="400" height="480" loading="lazy" class="of-space-card__img" />
            <div class="of-space-card__photo-overlay"></div>
            <div class="of-space-card__photo-content">
              <h3 class="of-space-card__photo-title">Colleges &amp; Universities</h3>
              <p class="of-space-card__photo-text">Temple, Drexel, Penn, Jefferson, and community colleges — large glass facades, lab windows, student union glazing.</p>
            </div>
          </div>

          <div class="of-space-card of-space-card--photo">
            <img src="/images/charter-school-window-film-philadelphia-entry-glass.jpg" alt="Philadelphia charter school glass entrance with solar and safety film" width="400" height="480" loading="lazy" class="of-space-card__img" />
            <div class="of-space-card__photo-overlay"></div>
            <div class="of-space-card__photo-content">
              <h3 class="of-space-card__photo-title">Charter &amp; Private Schools</h3>
              <p class="of-space-card__photo-text">Smaller campuses with focused budgetary priorities — cost-effective film delivering immediate, measurable improvement in comfort, safety, and energy performance.</p>
            </div>
          </div>

          <div class="of-space-card of-space-card--photo">
            <img src="/images/childcare-center-uv-safety-window-film-philadelphia.jpg" alt="Philadelphia childcare facility with UV and safety window film on classroom glass" width="400" height="480" loading="lazy" class="of-space-card__img" />
            <div class="of-space-card__photo-overlay"></div>
            <div class="of-space-card__photo-content">
              <h3 class="of-space-card__photo-title">Childcare &amp; Daycare</h3>
              <p class="of-space-card__photo-text">Pennsylvania childcare facilities with strict health and safety requirements — UV protection and shatter resistance for the most vulnerable occupants.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ══ BENEFIT ROWS ══ -->
    <section class="of-benefits">
      <div class="of-benefits__container">

        <div class="of-benefits__header">
          <div class="of-benefits__eyebrow">Campus Performance</div>
          <h2 class="of-benefits__headline">Purpose-Built Film for Safer, Brighter, More Efficient Schools</h2>
          <p class="of-benefits__intro">The right film specification depends on each room's risk profile, orientation, and use. We match safety, UV, glare, and energy performance to the glass already in place.</p>
        </div>

        <div class="of-row">
          <div class="of-row__image">
            <img src="/images/school-security-window-film-philadelphia-entry-glass.jpg" alt="Security window film on Philadelphia school entry glass" width="680" height="480" loading="lazy" decoding="async" />
          </div>
          <div class="of-row__text">
            <div class="of-row__eyebrow">Campus Security · Philadelphia</div>
            <h3 class="of-row__title">Ballistic, Blast &amp; Safety Film for Philadelphia Schools</h3>
            <p class="of-row__body">Security film for schools ranges from anti-intrusion safety film that slows forced entry to ballistic-resistant glazing systems and blast-mitigation film engineered to contain glass fragments under explosive pressure events. As a 3M Certified Dealer, we install the full spectrum — from 8 mil entry-point safety film meeting ANSI Z97.1 to Scotchshield Ultra series films specified for government and institutional blast hazard applications.</p>
            <p class="of-row__body">For entry points and ground-floor classrooms, we specify 8–14 mil safety film meeting ANSI Z97.1 and CPSC 16 CFR Part 1201. For facilities requiring higher protection, 3M Scotchshield Ultra series films meet GSA and Department of Defense blast-hazard glazing standards. Our <a href="/benefits/safety-and-security/" style="color: #2E7D32; font-weight: 700; text-decoration: underline; text-decoration-color: #4CAF50; text-underline-offset: 3px;">safety and security window film</a> and <a href="/benefits/blast-mitigation/" style="color: #2E7D32; font-weight: 700; text-decoration: underline; text-decoration-color: #4CAF50; text-underline-offset: 3px;">blast-mitigation film</a> are both specified for educational settings. We assess your campus before recommending a film grade.</p>
            <ul class="of-row__bullets">
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Ballistic-resistant film options available for high-risk glazing</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Blast-mitigation film meets GSA and DoD glazing standards</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Anti-intrusion safety film slows forced entry significantly</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>No structural work, permits, or classroom closures required</li>
            </ul>
          </div>
        </div>

        <div class="of-row of-row--rev">
          <div class="of-row__image">
            <img src="/images/school-uv-protection-window-film-philadelphia-classroom.jpg" alt="UV protection window film for Philadelphia school classroom furnishings" width="680" height="480" loading="lazy" decoding="async" />
          </div>
          <div class="of-row__text">
            <div class="of-row__eyebrow">UV Protection · Philadelphia Schools</div>
            <h3 class="of-row__title">Block 99% of UV Before It Reaches Students and Furnishings</h3>
            <p class="of-row__body">UV radiation is the primary cause of fading in school interiors — student artwork, educational posters, cork boards, carpeting, and upholstered furniture degrade years ahead of schedule when untreated windows allow full UV transmission. More importantly, students seated at window-adjacent desks accumulate UV exposure across a 6-hour school day. Per the EPA's <a href="https://www.epa.gov/sunsafety/uv-index-scale-1" target="_blank" rel="noopener noreferrer" style="color: #2E7D32; font-weight: 700; text-decoration: underline; text-decoration-color: #4CAF50; text-underline-offset: 3px;">UV Index guidelines</a>, even moderate UV levels carry cumulative health risks.</p>
            <p class="of-row__body">Our UV-focused film specifications block up to 99% of both UVA and UVB radiation across all film types — whether you choose a clear safety film, a lightly tinted solar control product, or a decorative frosted film. UV rejection is built into every film we install.</p>
            <ul class="of-row__bullets">
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>99% UV rejection across all film types</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Protects student artwork, cork boards, and fabric</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Reduces cumulative UV exposure for window-side students</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>No visible change to classroom appearance in most film selections</li>
            </ul>
          </div>
        </div>

        <div class="of-row">
          <div class="of-row__image">
            <img src="/images/glare-reduction-window-film-school-smartboard-philadelphia.jpg" alt="Philadelphia classroom smartboard visible after glare reduction window film" width="680" height="480" loading="lazy" decoding="async" />
          </div>
          <div class="of-row__text">
            <div class="of-row__eyebrow">Glare Control · Philadelphia Classrooms</div>
            <h3 class="of-row__title">From Washed-Out Whiteboards to Focused Learning</h3>
            <p class="of-row__body">South and west-facing classrooms lose productive learning time when afternoon sunlight renders smartboards, projectors, and Chromebook screens unreadable. Window film selectively reduces visible light transmission — cutting glare without eliminating natural light entirely. The result is a classroom where technology works the way it's designed to, regardless of time of day.</p>
            <p class="of-row__body"><a href="/benefits/glare-reduction/" style="color: #2E7D32; font-weight: 700; text-decoration: underline; text-decoration-color: #4CAF50; text-underline-offset: 3px;">Glare reduction film</a> is matched to each room's orientation and use. A south-facing computer lab may require a different VLT level than a north-facing art room. We assess each space individually and specify the film that delivers the greatest improvement without compromising the natural light environment your students and teachers rely on.</p>
            <ul class="of-row__bullets">
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Eliminates whiteboard and projector washout</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Reduces Chromebook and monitor glare</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Maintains natural daylight feel in classrooms</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>VLT selected for each room's specific orientation</li>
            </ul>
          </div>
        </div>

        <div class="of-row of-row--rev">
          <div class="of-row__image">
            <img src="/images/energy-saving-school-window-film-philadelphia-educational-facility.jpg" alt="Energy saving school window film on Philadelphia educational facility glass" width="680" height="480" loading="lazy" decoding="async" />
          </div>
          <div class="of-row__text">
            <div class="of-row__eyebrow">Energy Savings · Philadelphia School Districts</div>
            <h3 class="of-row__title">Trim HVAC Costs Without Touching the Budget for Instruction</h3>
            <p class="of-row__body">School buildings are among the most energy-intensive structures districts manage. According to the <a href="https://www.eia.gov/energyexplained/use-of-energy/commercial-buildings.php" target="_blank" rel="noopener noreferrer" style="color: #2E7D32; font-weight: 700; text-decoration: underline; text-decoration-color: #4CAF50; text-underline-offset: 3px;">U.S. Energy Information Administration</a>, HVAC represents the single largest energy cost in commercial and institutional buildings — and window film directly reduces the solar heat load that HVAC systems must compensate for. Solar control film rejects up to 79% of incoming solar heat through treated glass.</p>
            <p class="of-row__body">For Philadelphia school districts managing multiple buildings, this translates to measurable utility savings year over year — funds that stay in the instructional budget rather than flowing to utility providers. <a href="/benefits/energy-savings/" style="color: #2E7D32; font-weight: 700; text-decoration: underline; text-decoration-color: #4CAF50; text-underline-offset: 3px;">Energy-saving window film</a> also supports sustainability reporting, LEED documentation, and district green building initiatives.</p>
            <ul class="of-row__bullets">
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Up to 79% solar heat rejection</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Reduces afternoon classroom cooling load</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>Qualifies for district sustainability reporting</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>ROI typically achieved within 2–5 years</li>
            </ul>
          </div>
        </div>

      </div>
    </section>

