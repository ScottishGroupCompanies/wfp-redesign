---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'School & University Window Film in Philadelphia | UV Protection, Safety & Energy Savings';
const description = 'Window film for Philadelphia schools and universities: block 99% of UV rays, eliminate glare on smartboards, improve energy efficiency, and enhance campus safety. Professional installation by certified technicians.';

const galleryImages = [
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175416_1fcba8a3-a2e1-432a-80bb-20a2f1638b5a.png', label: 'UV Protection for Classrooms' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175417_997747da-e186-459f-83ee-82d3a284366e.png', label: 'Energy Efficient Campus' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175418_bea5c327-50fb-4447-a570-41992e94e2ab.png', label: 'Campus Buildings' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175418_885cb5f7-7d7a-43f9-a1a2-33926a01abc1.png', label: 'Security Film Installed' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175420_b047539e-872f-4449-b9d6-24077cca5b56.png', label: 'Professional Installation' },
];

const newImages = {
  hero: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175418_bea5c327-50fb-4447-a570-41992e94e2ab.png',
  uvSection: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175416_1fcba8a3-a2e1-432a-80bb-20a2f1638b5a.png',
  energySection: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175417_997747da-e186-459f-83ee-82d3a284366e.png',
  securitySection: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175418_885cb5f7-7d7a-43f9-a1a2-33926a01abc1.png',
};

const faqItems = [
  { question: 'How long does installation take in an occupied school?', answer: 'Most school installations are completed within 2–5 days depending on the number of windows and buildings involved. We work around class schedules, summer breaks, and after-hours to minimize disruption. Installations can also be phased across academic years to spread costs.' },
  { question: 'Will window film damage historic windows?', answer: 'No. We specialize in historic and preservation-grade windows common in Philadelphia\'s older school buildings. We conduct a thorough thermal assessment before installation to ensure the film is compatible with the glass type, age, and condition. Many historic windows that were destined for replacement can be preserved with properly selected film.' },
  { question: 'Does window film help with noise?', answer: 'Window film alone does not significantly reduce noise transmission — it is not an acoustic solution. However, by allowing windows to stay closed more often (reducing the need for open windows for cooling), it can create a quieter indoor environment. For significant noise reduction, we recommend pairing window film with other acoustic treatments.' },
  { question: 'What is the maintenance cost for window film?', answer: 'Window film requires virtually no ongoing maintenance. Unlike blinds or shades, there are no mechanical parts to repair or replace. Occasional cleaning with standard glass cleaner and a soft cloth is all that is needed. Our commercial films are backed by 10–15 year manufacturer warranties.' },
  { question: 'Does window film affect indoor air quality?', answer: 'No. Window film is a passive, non-toxic solution that does not emit any gases, chemicals, or particles into the indoor environment. In fact, by reducing solar heat gain, it can decrease the workload on HVAC systems, helping them operate more efficiently and maintain better ventilation balance throughout the building.' },
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="School & University Window Film Installation"
  serviceDesc="Professional window film installation for Philadelphia schools and universities — UV protection, glare control, energy efficiency, and campus safety."
  serviceUrl="https://www.windowfilmphiladelphia.com/applications/schools-universities"
  faqItems={faqItems}
>
  <!-- HERO -->
  <section class="swt-hero">
    <div class="swt-hero__img">
      <img src={newImages.hero} alt="Philadelphia school building with window film installed" width="1440" height="700" />
      <div class="swt-hero__overlay"></div>
    </div>
    <div class="swt-hero__content">
      <span class="swt-badge">
        <svg width="8" height="8" viewBox="0 0 8 8" fill="none"><circle cx="4" cy="4" r="4" fill="#4E6B2A"/></svg>
        Education Facility Solutions
      </span>
      <h1 class="swt-hero__title">
        Protect Students.<br/>
        Cut Costs.<br/>
        <em>Improve Comfort.</em><br/>
        One Upgrade.
      </h1>
      <p class="swt-hero__sub">Block 99% of UV rays, eliminate screen glare in classrooms, and cut energy costs — installed across your Philadelphia campus with minimal disruption.</p>
      <div class="swt-hero__ctas">
        <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Quote</a>
        <a href="#benefits" class="swt-btn swt-btn--ghost-light">See Benefits</a>
      </div>
    </div>
  </section>

  <div class="swt-body">

    <!-- TRUST BAR -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by Philadelphia schools and universities</p>
        <BrandLogos />
      </div>
    </section>

    <!-- SECTION 1: THE PROBLEM — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="problem">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">The Challenge</span>
            <h2 class="swt-h2 swt-h2--light">Philadelphia Schools Are Fighting a Losing Battle Against Their Windows</h2>
            <p>Large classroom windows that were designed for light and learning have become liabilities. West-facing rooms become solar ovens by early afternoon. Smartboards and laptop screens become unreadable under glare. Students and teachers near windows receive chronic UV exposure equivalent to outdoor workers.</p>
            <p>Philadelphia's extreme heat days have increased significantly, pushing HVAC systems to their limits — and school budgets along with them. Meanwhile, older buildings with single-pane glass lose cooled air at alarming rates, making energy efficiency upgrades critical for district finances.</p>
            <div class="swt-problem-tags">
              <span class="swt-tag swt-tag--red">Solar Heat Gain</span>
              <span class="swt-tag swt-tag--red">Screen Glare</span>
              <span class="swt-tag swt-tag--red">UV Exposure</span>
              <span class="swt-tag swt-tag--red">HVAC Strain</span>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.energySection} alt="School classroom experiencing heat and glare from large windows" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: UV — white bg, image left, text right -->
    <section class="swt-split" id="uv">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.uvSection} alt="UV protection for students and staff in Philadelphia school" loading="lazy" />
            <div class="swt-img-badge">
              <strong>99%</strong>
              <span>UV Blocked</span>
            </div>
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 01</span>
            <h2 class="swt-h2">Block 99% of Harmful UV Rays — Protecting Students and Staff</h2>
            <p>Children receive three times more UV exposure per year than adults, and much of that exposure happens inside school buildings through untreated windows. UV-A and UV-B rays pass straight through standard glass, creating health risks for students and teachers who sit near windows during class.</p>
            <p>Beyond health concerns, UV is the primary cause of interior fading in schools — degrading artwork, cork boards, carpeting, and furnishings. Our films block up to 99% of UV transmission, creating a healthier indoor environment and extending the life of interior finishes.</p>
            <ul class="swt-check-list">
              <li>Reduced skin cancer and UV-related health risks for students and staff</li>
              <li>Protected artwork, carpet, and furnishings from irreversible fading</li>
              <li>Lower liability exposure for school districts and university administrations</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: ENERGY — alt cream bg, text left, image right -->
    <section class="swt-split swt-split--alt" id="energy">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 02</span>
            <h2 class="swt-h2">Cut Energy Costs for School Budgets Without Replacing a Single Window</h2>
            <p>Solar heat entering through untreated glass is the single largest driver of summer cooling loads in Philadelphia school buildings. A sun-facing classroom can have the equivalent heat input of a 5,000 BTU heater — per window. Your HVAC system runs constantly to compensate, and those energy costs come directly from educational budgets.</p>
            <p>Heat-rejecting window film is a fraction of the cost of window replacement — typically 1/10th the price — and takes days to install rather than months. The payback period for schools is typically 2–4 years, after which the savings fund educational priorities instead of utility bills.</p>
            <div class="swt-energy-metrics">
              <div class="swt-metric">
                <span class="swt-metric__num">30%</span>
                <span class="swt-metric__label">Avg. Cooling Cost Reduction</span>
              </div>
              <div class="swt-metric">
                <span class="swt-metric__num">2–4yr</span>
                <span class="swt-metric__label">Typical Payback Period</span>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.energySection} alt="Philadelphia school building energy efficiency with window film" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: GLARE — white bg, image left, text right -->
    <section class="swt-split" id="glare">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.hero} alt="Glare-free smartboard and screens in Philadelphia school classroom" loading="lazy" />
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 03</span>
            <h2 class="swt-h2">Eliminate Smartboard and Screen Glare — Create Better Learning Environments</h2>
            <p>Modern classrooms depend on technology — smartboards, projectors, Chromebooks, and tablets. But when the afternoon sun creates glare on screens, learning stops. Teachers close blinds, students squint, and the technology investment is undermined by an easily solvable environmental problem.</p>
            <p>Our glare-control films eliminate screen glare while maintaining full natural daylight and outdoor views. Classrooms stay bright and comfortable all day, technology becomes fully usable, and teachers stop spending class time managing window treatments.</p>
            <blockquote class="swt-inline-quote">
              "Our west-facing classrooms were unusable after 2pm. After the film was installed, we can use the smartboards all day. The difference in student engagement is noticeable."
              <cite>— Principal, Philadelphia magnet school, Graduate Hospital</cite>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: SECURITY — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="security">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow swt-eyebrow--green">Benefit 04</span>
            <h2 class="swt-h2 swt-h2--light">Safety & Security Film: Hold Glass Together When It Matters Most</h2>
            <p>Standard glass shatters on impact — whether from a severe storm, an accident, or an intrusion attempt. In a school environment, shattered glass poses an immediate safety risk to students. Security window film holds shattered panes in the frame, dramatically reducing injury risk and slowing forced entry.</p>
            <p>For Philadelphia schools — particularly those in older buildings with fragile historic glass, ground-floor classrooms, and high-traffic common areas — security film is a sensible, cost-effective upgrade that protects students without the disruption of full window replacement.</p>
            <div class="swt-security-features">
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Shatter Resistance</strong>
                  <p>Glass stays in frame on impact — no dangerous shards flying into classrooms</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Delayed Entry</strong>
                  <p>Slows intruders by 3–7 minutes — critical window for response and lockdown</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Storm Protection</strong>
                  <p>Holds glass in severe weather events — protects students from flying debris</p>
                </div>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.securitySection} alt="Security window film protecting school windows" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY — 5 images -->
    <section class="swt-gallery" id="gallery">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">Our Work</span>
          <h2 class="swt-h2 swt-h2--center">Window Film — In Action</h2>
          <p class="swt-subhead">From elementary schools to university campuses — here's what we install.</p>
        </div>
        <div class="swt-gallery__grid">
          {galleryImages.map((img, i) => (
            <div class="swt-gallery__item fade-in" style={`--delay: ${i * 80}ms`}>
              <img src={img.src} alt={img.label} loading="lazy" />
              <div class="swt-gallery__overlay">
                <span>{img.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STATS BAR — accent green -->
    <section class="swt-stats">
      <div class="container">
        <div class="swt-stats__row">
          <div class="swt-stats__item fade-in">
            <span class="swt-stats__num">16+</span>
            <span class="swt-stats__label">Years in Philadelphia</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 80ms">
            <span class="swt-stats__num">200+</span>
            <span class="swt-stats__label">School Projects</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 160ms">
            <span class="swt-stats__num">99%</span>
            <span class="swt-stats__label">UV Rays Blocked</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 240ms">
            <span class="swt-stats__num">30%</span>
            <span class="swt-stats__label">Avg. Energy Savings</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS — 4 steps -->
    <section class="swt-process">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">How It Works</span>
          <h2 class="swt-h2 swt-h2--center">4 Simple Steps to a Better School</h2>
        </div>
        <div class="swt-process__steps">
          <div class="swt-process__step fade-in">
            <div class="swt-process__num">01</div>
            <div class="swt-process__body">
              <h3>Assessment & Measurement</h3>
              <p>We visit your campus and conduct a thorough thermal and UV analysis of all target buildings. We document glass types, orientations, and environmental conditions to create a comprehensive specification. You receive a detailed proposal within 24 hours with the optimal film for each building type and budget.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 80ms">
            <div class="swt-process__num">02</div>
            <div class="swt-process__body">
              <h3>Custom Film Selection</h3>
              <p>No two buildings are alike. We select the right film for each orientation and room type — from clear safety film for historic windows to medium-tint heat-rejecting film for west-facing classrooms. We also offer anti-graffiti film for ground-floor surfaces.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 160ms">
            <div class="swt-process__num">03</div>
            <div class="swt-process__body">
              <h3>Professional Installation</h3>
              <p>Our factory-trained installers work around your academic calendar — during summer breaks, after school hours, or on weekends. We install building by building with no disruption to the learning environment. We leave every space spotless.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 240ms">
            <div class="swt-process__num">04</div>
            <div class="swt-process__body">
              <h3>Final Inspection</h3>
              <p>We walk every building with your facilities team before considering the job complete. Every installation is backed by our labor warranty and the manufacturer's material warranty — typically 10–15 years on commercial films. We provide full documentation for district energy reports.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS — dark bg -->
    <section class="swt-testimonials">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow swt-eyebrow--green">Client Stories</span>
          <h2 class="swt-h2 swt-h2--center swt-h2--light">Real Results from Real Schools</h2>
        </div>
        <div class="swt-testimonials__grid">
          <div class="swt-testimonial fade-in">
            <div class="swt-testimonial__quote">"</div>
            <p>We were spending $40,000 a year in excess cooling costs in our oldest building — single-pane windows throughout. The film paid for itself in under three years. The administration was initially skeptical, but the data convinced everyone.</p>
            <div class="swt-testimonial__author">
              <strong>Dr. Angela M.</strong>
              <span>Superintendent, Philadelphia charter school network</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 80ms">
            <div class="swt-testimonial__quote">"</div>
            <p>Our kindergarten classrooms are on the west side of the building. In September and October, teachers couldn't use the smartboards past 2pm because of the glare. After the film, they're usable all day. The kids are calmer, the teachers are happier.</p>
            <div class="swt-testimonial__author">
              <strong>James T.</strong>
              <span>Facilities Director, South Philadelphia School District</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 160ms">
            <div class="swt-testimonial__quote">"</div>
            <p>We had historic stained glass in our main administration building — can't replace it, can't remove it, but it was a liability in storms. Security film was the perfect solution. Holds everything in place, completely invisible, and the building looks unchanged from the street.</p>
            <div class="swt-testimonial__author">
              <strong>Rebecca K.</strong>
              <span>Director of Facilities, University of the Arts, Center City</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="swt-faq" id="faq">
      <div class="container">
        <div class="swt-faq__layout">
          <div class="swt-faq__header fade-in">
            <span class="swt-eyebrow">Questions</span>
            <h2 class="swt-h2">Frequently Asked Questions</h2>
            <p>Honest answers from people who've been doing this in Philadelphia for over 16 years.</p>
            <a href="/contact/" class="swt-btn swt-btn--primary">Talk to a Specialist</a>
          </div>
          <div class="swt-faq__list fade-in">
            {faqItems.map((item) => (
              <div class="swt-faq__item">
                <div class="swt-faq__q">
                  <span>{item.question}</span>
                  <span class="swt-faq__toggle">+</span>
                </div>
                <div class="swt-faq__a">
                  <p>{item.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA BANNER -->
    <section class="swt-cta">
      <div class="swt-cta__inner">
        <div class="swt-cta__text">
          <h2>Ready to <em>improve</em> your campus?</h2>
          <p>Get a free consultation and thermal analysis. No obligation, no pressure — just honest advice.</p>
        </div>
        <div class="swt-cta__btns">
          <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Quote</a>
          <a href="tel:+126****7980" class="swt-btn swt-btn--ghost-light">Call (267) 394-7980</a>
        </div>
      </div>
    </section>

  </div><!-- /swt-body -->
</BaseLayout>

<style>
  /* ══════════════════════════════════════
     BRAND TOKENS (local override)
     ══════════════════════════════════════ */
  :root {
    --swt-green:        #4E6B2A;
    --swt-green-accent: #83A94A;
    --swt-dark:         #2A241E;
    --swt-cream:        #F4EFE6;
    --swt-alt:          #ECE4D4;
    --swt-border:       #E1D6C1;
    --swt-text-sec:     #6E665C;
    --swt-gold:         #846212;
    --swt-white:        #ffffff;
    --swt-radius:       5px;
  }

  /* ══════════════════════════════════════
     HERO
     ══════════════════════════════════════ */
  .swt-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .swt-hero__img {
    position: absolute;
    inset: 0;
  }
  .swt-hero__img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .swt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(42,36,30,0.9) 0%, rgba(42,36,30,0.6) 50%, rgba(42,36,30,0.35) 100%);
  }
  .swt-hero__content {
    position: relative;
    z-index: 1;
    padding: 110px 8% 90px;
    max-width: 720px;
  }
  .swt-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
    background: rgba(78,107,42,0.25);
    color: rgba(255,255,255,0.75);
    border: 1px solid rgba(78,107,42,0.4);
  }
  .swt-hero__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(38px, 5.5vw, 66px);
    font-weight: 400;
    color: var(--swt-white);
    line-height: 1.1;
    margin: 0 0 20px;
  }
  .swt-hero__title em {
    font-style: italic;
    color: var(--swt-green-accent);
  }
  .swt-hero__sub {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 17px;
    color: rgba(255,255,255,0.65);
    line-height: 1.7;
    margin: 0 0 36px;
    max-width: 500px;
  }
  .swt-hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ══════════════════════════════════════
     BUTTONS
     ══════════════════════════════════════ */
  .swt-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .swt-btn--primary {
    background: var(--swt-green);
    color: var(--swt-white);
    border-color: var(--swt-green);
  }
  .swt-btn--primary:hover {
    background: #3D5620;
    border-color: #3D5620;
    transform: translateY(-2px);
  }
  .swt-btn--ghost-light {
    background: transparent;
