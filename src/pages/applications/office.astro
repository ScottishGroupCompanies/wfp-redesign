  /* ══════════════════════════════════════
     FILM TYPES SLIDER
  ══════════════════════════════════════ */
  .of-ftype { position: relative; width: 100%; min-height: 90vh; overflow: hidden; background: #14201A; }
  .of-ftype__track { display: flex; width: 100%; height: 100%; transition: transform 0.6s cubic-bezier(0.4,0,0.2,1); will-change: transform; }
  .of-ftype__slide { position: relative; min-width: 100%; min-height: 90vh; flex-shrink: 0; display: flex; align-items: center; }
  .of-ftype__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; z-index: 0; }
  .of-ftype__overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.80) 0%, rgba(0,0,0,0.25) 60%, transparent 100%); z-index: 1; }
  .of-ftype__content { position: relative; z-index: 2; max-width: 560px; padding-left: 80px; color: #fff; opacity: 0; transform: translateY(20px); transition: opacity 0.5s ease 0.1s, transform 0.5s ease 0.1s; }
  .of-ftype-active .of-ftype__content { opacity: 1; transform: translateY(0); }
  .of-ftype__step { font-family: 'Space Mono', monospace; font-size: 13px; color: #7CB342; letter-spacing: 0.2em; margin-bottom: 1rem; }
  .of-ftype__title { font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 4vw, 3.25rem); font-weight: 700; color: #fff; line-height: 1.1; margin: 0 0 1.5rem; white-space: pre-line; }
  .of-ftype__desc { font-family: 'Inter', sans-serif; font-size: 16px; line-height: 1.8; color: rgba(255,255,255,0.85); max-width: 460px; margin-bottom: 2rem; }
  .of-ftype__faq { display: flex; flex-direction: column; gap: 8px; margin-bottom: 2rem; }
  .of-ftype__faq-item { border-radius: 8px; overflow: hidden; }
  .of-ftype__faq-q { width: 100%; background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: rgba(255,255,255,0.88); font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 500; padding: 12px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center; gap: 12px; cursor: pointer; transition: background 0.2s ease; }
  .of-ftype__faq-q:hover { background: rgba(255,255,255,0.18); }
  .of-ftype__faq-icon { font-size: 1.2rem; color: #7CB342; flex-shrink: 0; transition: transform 0.3s ease; }
  .of-ftype__faq-a { background: rgba(255,255,255,0.08); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.10); border-top: none; border-radius: 0 0 8px 8px; color: rgba(255,255,255,0.70); font-family: 'Inter', sans-serif; font-size: 0.875rem; line-height: 1.6; padding: 12px 16px; margin-top: -4px; }
  .of-ftype__cta { display: inline-block; background: #7CB342; color: #fff; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; padding: 14px 32px; border-radius: 9999px; text-decoration: none; transition: background 0.25s ease, transform 0.2s ease; }
  .of-ftype__cta:hover { background: #2E6B30; transform: translateY(-2px); }
  .of-ftype__nav { position: absolute; top: 50%; right: 48px; transform: translateY(-50%); z-index: 10; display: flex; flex-direction: column; gap: 20px; }
  .of-ftype__nav-item { display: flex; align-items: center; gap: 12px; background: transparent; border: none; cursor: pointer; padding: 0; opacity: 0.35; transition: opacity 0.3s ease; }
  .of-ftype__nav-item:hover { opacity: 0.65; }
  .of-ftype__nav-item--active { opacity: 1; }
  .of-ftype__nav-line { display: block; width: 3px; height: 28px; background: rgba(255,255,255,0.4); border-radius: 2px; transition: background 0.3s ease, height 0.3s ease; }
  .of-ftype__nav-item--active .of-ftype__nav-line { background: #7CB342; height: 44px; }
  .of-ftype__nav-label { font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 500; color: #fff; text-transform: uppercase; letter-spacing: 0.15em; white-space: nowrap; }
  .of-ftype__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 10; width: 48px; height: 48px; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #fff; transition: background 0.3s ease, color 0.3s ease; }
  .of-ftype__arrow:hover { background: rgba(0,0,0,0.6); color: #7CB342; }
  .of-ftype__arrow--prev { left: 32px; }
  .of-ftype__arrow--next { right: 32px; }
  .of-ftype__progress { position: absolute; bottom: 0; left: 0; width: 100%; height: 2px; background: rgba(255,255,255,0.15); z-index: 10; }
  .of-ftype__progress-bar { height: 100%; background: #7CB342; width: 0; transition: width 0.05s linear; }
  @media (max-width: 768px) {
    .of-ftype__nav { display: none; }
    .of-ftype__content { padding-left: 32px; padding-right: 32px; max-width: calc(100% - 64px); }
    .of-ftype__arrow--prev { left: 16px; }
    .of-ftype__arrow--next { right: 16px; }
  }

  /* ══════════════════════════════════════
     FEATURED PROJECT
  ══════════════════════════════════════ */
  .of-project { background: #14201A; padding: 96px 5%; }
  .of-project__inner { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: start; }
  .of-project__image-col { display: flex; flex-direction: column; gap: 0; }
  .of-project__img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: 12px 12px 0 0; display: block; }
  .of-project__stats-strip { display: grid; grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 1fr); background: #7CB342; border-radius: 0 0 12px 12px; padding: 20px 16px; gap: 16px 0; }
  .of-project__stat { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 8px; }
  .of-project__stat-num { font-family: 'Space Mono', monospace; font-size: clamp(1.1rem, 2vw, 1.5rem); font-weight: 700; color: #fff; line-height: 1.1; }
  .of-project__stat-label { font-family: 'Inter', sans-serif; font-size: 0.65rem; color: rgba(255,255,255,0.85); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 4px; line-height: 1.3; }
  .of-project__stat-div { display: none; }
  .of-project__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin-bottom: 1.25rem; }
  .of-project__title { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 700; color: #fff; line-height: 1.1; margin: 0 0 2rem; }
  .of-project__detail { border-top: 1px solid rgba(255,255,255,0.1); padding: 16px 0; display: grid; grid-template-columns: 120px 1fr; gap: 16px; align-items: start; }
  .of-project__detail:last-of-type { border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 2rem; }
  .of-project__detail-label { font-family: 'Space Mono', monospace; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.12em; color: #7CB342; padding-top: 2px; }
  .of-project__detail-val { font-family: 'Inter', sans-serif; font-size: 0.9rem; color: rgba(255,255,255,0.82); line-height: 1.7; }
  .of-project__cta { display: inline-block; background: #7CB342; color: #fff; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; padding: 14px 32px; border-radius: 9999px; text-decoration: none; transition: background 0.25s ease; }
  .of-project__cta:hover { background: #2E6B30; }
  @media (max-width: 900px) {
    .of-project__inner { grid-template-columns: 1fr; gap: 40px; }
    .of-project__stats-strip { grid-template-columns: repeat(2, 1fr); row-gap: 16px; border-radius: 0 0 12px 12px; }
    .of-project__stat-div { display: none; }
  }

  /* ══════════════════════════════════════
     GALLERY
  ══════════════════════════════════════ */
  .of-gallery { background: #F5F3EE; padding: 96px 5% 80px; }
  .of-gallery__header { text-align: center; margin-bottom: 52px; }
  .of-gallery__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin-bottom: 0.75rem; }
  .of-gallery__title { font-family: 'Playfair Display', serif; font-size: clamp(1.9rem, 3vw, 2.75rem); font-weight: 700; color: #14201A; line-height: 1.15; margin: 0 0 1rem; }
  .of-gallery__sub { font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #4A5C48; max-width: 580px; margin: 0 auto; line-height: 1.75; }
  .of-gallery__grid { max-width: 1380px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: 280px 280px 280px; gap: 12px; }
  .of-gallery__panel { position: relative; overflow: hidden; border-radius: 10px; cursor: default; }
  .of-gallery__panel--tall { grid-row: span 2; }
  .of-gallery__panel--wide { grid-column: span 2; }
  .of-gallery__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .of-gallery__panel:hover .of-gallery__img { transform: scale(1.04); }
  .of-gallery__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 55%); pointer-events: none; }
  .of-gallery__label { position: absolute; bottom: 0; left: 0; right: 0; padding: 20px 18px; }
  .of-gallery__label-title { display: block; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 700; color: #fff; margin-bottom: 3px; }
  .of-gallery__label-sub { display: block; font-family: 'Inter', sans-serif; font-size: 0.72rem; color: rgba(255,255,255,0.75); }
  @media (max-width: 900px) {
    .of-gallery__grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .of-gallery__panel--tall, .of-gallery__panel--wide { grid-column: span 1; grid-row: span 1; height: 240px; }
    .of-gallery__panel { height: 220px; }
  }
  @media (max-width: 600px) {
    .of-gallery__grid { grid-template-columns: 1fr; }
    .of-gallery__panel, .of-gallery__panel--tall, .of-gallery__panel--wide { height: 220px; grid-column: span 1; grid-row: span 1; }
  }

  /* ══════════════════════════════════════
     STATS BAR
  ══════════════════════════════════════ */
  .of-stats { background: #14201A; padding: 56px 5%; }
  .of-stats__inner { max-width: 1280px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .of-stats__item { flex: 1; min-width: 140px; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 12px; }
  .of-stats__num { font-family: 'Space Mono', monospace; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 700; color: #7CB342; line-height: 1; margin-bottom: 8px; }
  .of-stats__label { font-family: 'Inter', sans-serif; font-size: 0.78rem; color: rgba(255,255,255,0.75); line-height: 1.5; }
  .of-stats__label small { display: block; font-size: 0.65rem; color: rgba(255,255,255,0.45); margin-top: 3px; }
  .of-stats__div { width: 1px; height: 60px; background: rgba(255,255,255,0.12); flex-shrink: 0; }
  @media (max-width: 768px) { .of-stats__div { display: none; } .of-stats__item { min-width: calc(50% - 24px); } }

  /* ══════════════════════════════════════
     SHARED DESIGN TOKENS
  ══════════════════════════════════════ */
  :root {
    --swt-green:        #4E6B2A;
    --swt-green-accent: #83A94A;
    --swt-dark:         #2A241E;
    --swt-border:       #E1D6C1;
    --swt-text-sec:     #6E665C;
    --swt-white:        #ffffff;
    --swt-radius:       5px;
  }

  /* ══════════════════════════════════════
     SWT SHARED (swt-btn, swt-eyebrow, swt-h2)
  ══════════════════════════════════════ */
  .swt-btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 28px; border-radius: var(--swt-radius); font-family: 'Hanken Grotesk', sans-serif; font-size: 15px; font-weight: 600; text-decoration: none; cursor: pointer; border: 2px solid transparent; transition: all 0.2s ease; white-space: nowrap; }
  .swt-btn--primary { background: var(--swt-green); color: var(--swt-white); border-color: var(--swt-green); }
  .swt-btn--primary:hover { background: #3D5620; border-color: #3D5620; transform: translateY(-2px); }
  .swt-eyebrow { display: inline-block; font-family: 'Hanken Grotesk', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--swt-green); margin-bottom: 12px; }
  .swt-h2 { font-family: 'Fraunces', Georgia, serif; font-size: clamp(26px, 3vw, 40px); font-weight: 400; color: var(--swt-dark); line-height: 1.15; margin: 0 0 18px; }
  .swt-h2--light { color: var(--swt-white); }
  .swt-h2--center { text-align: center; }

  /* ══════════════════════════════════════
     ES-PROCESS-SPLIT + ES-ACCORDION
  ══════════════════════════════════════ */
  .es-process-split { padding: 120px 0; background: #F5F3EE; }
  .es-process-split__container { max-width: 1280px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
  .es-process-split__eyebrow { font-family: 'Inter', sans-serif; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--swt-green); margin-bottom: 16px; }
  .es-process-split__title { font-family: 'Fraunces', Georgia, serif; font-size: clamp(2rem, 3.5vw, 2.75rem); font-weight: 400; color: #14201A; line-height: 1.15; margin: 0 0 40px; }
  .es-accordion { display: flex; flex-direction: column; gap: 16px; }
  .es-accordion__item { background: #fff; border-radius: 16px; overflow: hidden; transition: box-shadow 0.3s; }
  .es-accordion__item:hover { box-shadow: 0 8px 32px rgba(20,32,26,0.08); }
  .es-accordion__trigger { display: flex; align-items: center; gap: 20px; padding: 28px 32px; cursor: pointer; list-style: none; user-select: none; }
  .es-accordion__trigger::-webkit-details-marker { display: none; }
  .es-accordion__number { font-family: 'Space Mono', monospace; font-size: 1.25rem; font-weight: 700; color: var(--swt-green); flex-shrink: 0; }
  .es-accordion__label { font-family: 'Fraunces', Georgia, serif; font-size: 1.2rem; font-weight: 600; color: #14201A; flex: 1; }
  .es-accordion__icon { font-size: 2rem; color: var(--swt-green); font-weight: 300; transition: transform 0.3s; flex-shrink: 0; line-height: 1; }
  .es-accordion__item[open] .es-accordion__icon { transform: rotate(45deg); }
  .es-accordion__body { padding: 0 32px 32px; font-family: 'Inter', sans-serif; font-size: 0.95rem; line-height: 1.7; color: #4A5C48; }
  .es-process-split__content { display: flex; flex-direction: column; }
  .es-process-split__image-wrapper { position: relative; min-height: 600px; display: flex; align-items: stretch; }
  .es-process-split__image { width: 100%; height: 100%; object-fit: cover; object-position: center; border-radius: 16px; box-shadow: 0 16px 48px rgba(20,32,26,0.12); display: block; }
  @media (max-width: 900px) { .es-process-split__container { grid-template-columns: 1fr; } .es-process-split__image-wrapper { min-height: 400px; } }

  /* ══════════════════════════════════════
     CAM-TESTIMONIALS + CAM-TCARD
  ══════════════════════════════════════ */
  .cam-testimonials { background: #F5F3EE; padding: 96px 5%; }
  .cam-testimonials__header { text-align: center; margin-bottom: 56px; }
  .cam-testimonials__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin-bottom: 0.75rem; display: block; }
  .cam-testimonials__title { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 700; color: #14201A; line-height: 1.2; margin: 0 0 1rem; }
  .cam-testimonials__sub { font-family: 'Inter', sans-serif; font-size: 1rem; color: #4A5C48; max-width: 500px; margin: 0 auto; line-height: 1.7; }
  .cam-testimonials__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 1280px; margin: 0 auto; }
  .cam-tcard { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 2px 16px rgba(13,26,15,0.07); display: flex; flex-direction: column; }
  .cam-tcard__img-wrap { overflow: hidden; aspect-ratio: 1/1; flex-shrink: 0; }
  .cam-tcard__img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; transition: transform 0.4s ease; }
  .cam-tcard:hover .cam-tcard__img { transform: scale(1.03); }
  .cam-tcard__body { padding: 28px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
  .cam-tcard__stars { color: #F5A623; font-size: 1.1rem; letter-spacing: 2px; }
  .cam-tcard__quote { font-family: 'Inter', sans-serif; font-size: 0.92rem; color: #3a4a38; line-height: 1.75; margin: 0; font-style: italic; flex: 1; }
  .cam-tcard__meta { border-top: 1px solid #e8ede6; padding-top: 14px; margin-top: auto; }
  .cam-tcard__name { font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 700; color: #14201A; margin: 0 0 3px; }
  .cam-tcard__role { font-family: 'Inter', sans-serif; font-size: 0.8rem; color: #7CB342; margin: 0; font-weight: 500; }
  @media (max-width: 960px) { .cam-testimonials__grid { grid-template-columns: 1fr; max-width: 520px; margin: 0 auto; } .cam-testimonials { padding: 64px 5%; } }
  @media (max-width: 600px) { .cam-tcard__img-wrap { aspect-ratio: 1/1; } }

  /* ══════════════════════════════════════
     IP-LOCAL + CAM-NEIGHBORHOODS
  ══════════════════════════════════════ */
  .ip-local { padding: 64px 5%; }
  .ip-local__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .ip-local__content { display: flex; flex-direction: column; }
  .ip-local__map { border-radius: 20px; overflow: hidden; height: 400px; }
  .ip-local__map iframe { width: 100%; height: 100%; }
  .ip-local__content h2 { font-family: 'Playfair Display', serif; font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; letter-spacing: -0.5px; color: #14201A; margin: 12px 0 16px; }
  .ip-local__content p { font-family: 'Inter', sans-serif; font-size: 16px; color: #4a4a4a; line-height: 1.8; margin-bottom: 20px; }
  .cam-neighborhoods { display: flex; flex-direction: column; margin-top: 20px; }
  .cam-nh { display: flex; align-items: flex-start; gap: 14px; padding: 11px 0; border-bottom: 1px solid #EFEFED; }
  .cam-nh:last-child { border-bottom: none; }
  .cam-nh__name { font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 700; color: #7CB342; min-width: 130px; flex-shrink: 0; line-height: 1.65; }
  .cam-nh__desc { font-family: 'Inter', sans-serif; font-size: 13px; color: #4a4a4a; line-height: 1.65; }
  @media (max-width: 768px) { .ip-local__grid { grid-template-columns: 1fr; } .ip-local__map { height: 280px; } }

  /* ══════════════════════════════════════
     RES-SECTION
  ══════════════════════════════════════ */
  .res-section { background: #F5F3EE; padding: 80px 0; }
  .res-section__inner { max-width: 1200px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .res-section__image-col { position: relative; border-radius: 16px; overflow: hidden; }
  .res-section__img { width: 100%; height: 520px; object-fit: cover; object-position: center; display: block; border-radius: 16px; }
  .res-section__content-col { display: flex; flex-direction: column; gap: 20px; }
  .res-section__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin: 0; }
  .res-section__title { font-family: 'Playfair Display', serif; font-size: clamp(1.75rem, 2.5vw, 2.5rem); font-weight: 700; color: #14201A; line-height: 1.15; letter-spacing: -0.02em; margin: 0; }
  .res-section__body { font-family: 'Inter', sans-serif; font-size: 1rem; color: #4A5C48; line-height: 1.75; margin: 0; }
  .res-section__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .res-section__item { display: flex; align-items: flex-start; gap: 12px; font-family: 'Inter', sans-serif; font-size: 0.9rem; line-height: 1.5; }
  .res-section__item svg { flex-shrink: 0; margin-top: 2px; }
  .res-section__item a { color: #14201A; text-decoration: underline; text-decoration-color: #7CB342; text-underline-offset: 3px; transition: color 0.2s ease; font-weight: 500; }
  .res-section__item a:hover { color: #7CB342; }
  .res-section__cta { align-self: flex-start; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; color: #7CB342; text-decoration: none; display: flex; align-items: center; gap: 4px; transition: gap 0.2s ease; }
  .res-section__cta:hover { gap: 8px; }
  @media (max-width: 900px) { .res-section__inner { grid-template-columns: 1fr; gap: 40px; } .res-section__img { height: 360px; } }
  @media (max-width: 600px) { .res-section__inner { padding: 0 20px; } .res-section { padding: 60px 0; } }

  /* ══════════════════════════════════════
     SWT-FAQ
  ══════════════════════════════════════ */
  .swt-faq { background: var(--swt-white); padding: 96px 0; }
  .swt-faq__layout { display: grid; grid-template-columns: 300px 1fr; gap: 80px; align-items: start; }
  .swt-faq__header p { font-family: 'Hanken Grotesk', sans-serif; font-size: 15px; line-height: 1.75; color: var(--swt-text-sec); margin: 14px 0 24px; }
  .swt-faq__header { display: flex; flex-direction: column; }
  .swt-faq__list { display: flex; flex-direction: column; }
  .swt-faq__item { border-bottom: 1px solid var(--swt-border); padding: 18px 0; }
  .swt-faq__item:first-of-type { border-top: 1px solid var(--swt-border); }
  .swt-faq__q { font-family: 'Hanken Grotesk', sans-serif; font-size: 15px; font-weight: 600; color: var(--swt-dark); display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; cursor: pointer; padding: 3px 0; }
  .swt-faq__toggle { color: var(--swt-green); font-size: 22px; flex-shrink: 0; font-weight: 400; transition: transform 0.2s; line-height: 1; }
  .swt-faq__a { font-family: 'Hanken Grotesk', sans-serif; font-size: 14px; color: var(--swt-text-sec); line-height: 1.8; margin-top: 10px; display: none; }
  .swt-faq__a a { color: #7CB342; text-decoration: underline; text-underline-offset: 3px; font-weight: 500; }
  .swt-faq__a a:hover { color: #2E6B30; }
  .swt-faq__item--open .swt-faq__a { display: block; }
  .swt-faq__item--open .swt-faq__toggle { transform: rotate(45deg); }
  @media (max-width: 768px) { .swt-faq__layout { grid-template-columns: 1fr; gap: 40px; } }

  /* ══════════════════════════════════════
     CTA (priv-cinematic-cta pattern)
  ══════════════════════════════════════ */
  .priv-cinematic-cta { position: relative; min-height: 560px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .priv-cinematic-cta__media { position: absolute; inset: 0; background-size: cover; background-position: center; }
  .priv-cinematic-cta__overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(13,26,15,0.88) 0%, rgba(46,107,48,0.75) 40%, rgba(13,26,15,0.88) 100%); }
  .priv-cinematic-cta__vignette { position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(13,26,15,0.2) 0%, rgba(13,26,15,0.6) 100%); }
  .priv-cinematic-cta__content { position: relative; z-index: 10; max-width: 760px; padding: 80px 24px; text-align: center; }
  .priv-cinematic-cta__title { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4.5vw, 3.25rem); font-weight: 700; color: #F3F6F1; margin-bottom: 20px; line-height: 1.1; letter-spacing: -0.02em; }
  .priv-cinematic-cta__text { font-family: 'Inter', sans-serif; font-size: clamp(0.95rem, 1.8vw, 1.1rem); color: rgba(243,246,241,0.82); max-width: 620px; margin: 0 auto 40px; line-height: 1.75; }
  .priv-cinematic-cta__actions { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
  .priv-cinematic-cta__btn-primary { display: inline-flex; align-items: center; background: #7CB342; color: #fff; font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 600; text-decoration: none; padding: 16px 36px; border-radius: 100px; border: 2px solid #7CB342; transition: background 0.25s, border-color 0.25s, transform 0.2s, box-shadow 0.25s; }
  .priv-cinematic-cta__btn-primary:hover { background: #6aa032; border-color: #6aa032; transform: translateY(-2px); box-shadow: 0 10px 28px rgba(124,179,66,0.35); }
  .priv-cinematic-cta__btn-secondary { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.06); backdrop-filter: blur(8px); color: #F3F6F1; font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 600; text-decoration: none; padding: 14px 28px; border-radius: 100px; border: 2px solid rgba(255,255,255,0.3); transition: background 0.25s, border-color 0.25s, transform 0.2s; }
  .priv-cinematic-cta__btn-secondary:hover { background: rgba(255,255,255,0.12); border-color: rgba(124,179,66,0.6); transform: translateY(-2px); }

  /* ══════════════════════════════════════
     RESPONSIVE — WHATIS / WHY / BENTO
  ══════════════════════════════════════ */
  @media (max-width: 1024px) {
    .of-whatis__container,
    .of-why__container { gap: 48px; }
    .of-bento__compact { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .of-whatis { padding: 64px 5%; }
