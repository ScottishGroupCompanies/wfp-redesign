---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Office Window Film in Philadelphia | Privacy, Glare Control & Energy Savings';
const description = 'Window film for Philadelphia offices: reduce glare, block 99% of UV rays, improve energy efficiency and employee comfort. Professional installation by certified technicians.';

const galleryImages = [
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163219_ef8a6773-eb18-43d3-a8cf-305c12c72dd2.png',
    label: 'Professional Installation',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163222_79b81cd9-fd33-453a-8c62-ab37d4d031d1.png',
    label: '99% UV Protection',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163225_ef3d64e4-534f-42b3-bc9b-af78ddffac20.png',
    label: 'Security & Safety',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163229_6541b9dc-3f99-46f5-bc6f-5aecd8fd77ae.png',
    label: 'Glare-Free Workspaces',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163859_fabc7e12-368e-49f3-8971-08b76bbdd518.png',
    label: 'Energy Efficiency',
  },
];

const benefits = [
  {
    heading: 'UV Protection',
    body: 'Block 99% of harmful UV rays, protecting employees and reducing skin cancer risk',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>`,
  },
  {
    heading: 'Glare Reduction',
    body: 'Eliminate screen glare, reducing eye strain and improving productivity',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>`,
  },
  {
    heading: 'Energy Savings',
    body: 'Cut cooling costs by up to 30% with heat-rejecting window film',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h13.5v1.5H2.25v-1.5zM2.25 11.25h13.5v1.5H2.25v-1.5zM2.25 9h13.5V7.5H2.25V9zm15 7.5a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z"/></svg>`,
  },
  {
    heading: 'Safety & Security',
    body: 'Hold glass together on impact, protecting people and assets',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 12c0 6.627 5.373 12 12 12s12-5.373 12-12c0-2.157-.574-4.18-1.591-5.914z"/></svg>`,
  },
];

const whyParagraphs = [
  'Philadelphia offices face constant challenges from screen glare, rising energy costs, and the need for privacy in meeting areas. Our certified installation team delivers solar control, security, and decorative film solutions that improve workplace comfort and deliver measurable results.',
  'From single-story office suites to multi-floor commercial buildings, we provide professional on-site installation with minimal disruption to your operations.',
];

const stats = [
  { value: '16+', label: 'Years Experience' },
  { value: '500+', label: 'Projects Completed' },
  { value: '98%', label: 'Client Satisfaction' },
];

const testimonials = [
  {
    quote: 'The glare reduction was immediate. Our team stopped complaining about eye strain within the first week. The film is completely invisible — you would never know it was there.',
    name: 'Marcus T.',
    role: 'Operations Director, Center City Philadelphia',
  },
  {
    quote: 'We cut our cooling costs by nearly 28% in the first summer. The ROI paid for the installation in under four years. Highly recommend for any Philly office building.',
    name: 'Sandra L.',
    role: 'Facilities Manager, Old City Commercial Property',
  },
  {
    quote: 'The decorative film in our conference rooms looks incredible — modern, professional, and our clients always comment on it. Installation was done in a single day with zero downtime.',
    name: 'James R.',
    role: 'Principal, Rittenhouse Financial Group',
  },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/applications/office/" serviceName="Office Window Film" serviceDesc="Office window film installation in Philadelphia. Energy savings, glare reduction, and privacy solutions for commercial office buildings." serviceUrl="https://www.windowfilmphiladelphia.net/applications/office/">

<InnerPageHero
  title="Office Window Film"
  desc="Privacy · Glare Control · Energy Savings"
  bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161444_92b264a0-f13c-47ca-93dd-af03bc5e5db9.png"
/>

<div class="ip-page-body">

  <!-- ══════════════════════════════════════
       5-IMAGE GALLERY — 3+2 GRID
       ══════════════════════════════════════ -->
  <section class="o-gallery">
    <div class="o-gallery__grid">
      {galleryImages.map((img, i) => (
        <div class={`o-gallery__item o-gallery__item--${i + 1}`}>
          <div class="o-gallery__card">
            <img src={img.src} alt={img.label} loading="lazy" />
            <div class="o-gallery__overlay">
              <span class="o-gallery__label">{img.label}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════
       BENEFITS SECTION
       ══════════════════════════════════════ -->
  <section class="o-benefits">
    <div class="o-benefits__hd">
      <span class="eyebrow">Benefits</span>
      <h2 class="o-benefits__title">Why offices choose window film</h2>
    </div>
    <div class="o-benefits__grid">
      {benefits.map((b) => (
        <div class="o-benefit-card fade-in">
          <div class="o-benefit-card__icon">
            <span set:html={b.icon} />
          </div>
          <h3 class="o-benefit-card__heading">{b.heading}</h3>
          <p class="o-benefit-card__body">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════
       WHY OFFICES SECTION
       ══════════════════════════════════════ -->
  <section class="o-why">
    <div class="o-why__inner">
      <div class="o-why__hd">
        <span class="eyebrow">Why Office Window Film</span>
        <h2 class="o-why__title">Built for how Philadelphia offices really work</h2>
      </div>
      <div class="o-why__copy">
        {whyParagraphs.map((p) => (
          <p class="o-why__para">{p}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       STATISTICS ROW
       ══════════════════════════════════════ -->
  <section class="o-stats">
    {stats.map((s) => (
      <div class="o-stat fade-in">
        <span class="o-stat__value">{s.value}</span>
        <span class="o-stat__label">{s.label}</span>
      </div>
    ))}
  </section>

  <!-- ══════════════════════════════════════
       SOCIAL PROOF / TESTIMONIALS
       ══════════════════════════════════════ -->
  <section class="o-testimonials">
    <div class="o-testimonials__hd">
      <span class="eyebrow">Client Testimonials</span>
      <h2 class="o-testimonials__title">What Philadelphia offices are saying</h2>
    </div>
    <div class="o-testimonials__grid">
      {testimonials.map((t) => (
        <div class="o-testimonial fade-in">
          <p class="o-testimonial__quote">"{t.quote}"</p>
          <div class="o-testimonial__author">
            <span class="o-testimonial__name">{t.name}</span>
            <span class="o-testimonial__role">{t.role}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════
       BRAND LOGOS
       ══════════════════════════════════════ -->
  <BrandLogos />

  <!-- ══════════════════════════════════════
       CTA SECTION
       ══════════════════════════════════════ -->
  <div class="o-cta fade-in">
    <h2 class="o-cta__heading">Ready to upgrade your office?</h2>
    <p class="o-cta__sub">Get a free consultation and see how window film can transform your Philadelphia workspace.</p>
    <div class="o-cta__btns">
      <a href="/contact/" class="o-btn o-btn--green">Get a Free Quote</a>
      <a href="tel:+1267947980" class="o-btn o-btn--outline">Call (267) 394-7980</a>
    </div>
  </div>

</div><!-- end ip-page-body -->

</BaseLayout>

<style>
/* ── PAGE BODY WRAPPER ── */
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* ── EYEBROW ── */
.eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

/* ── BUTTONS ── */
.o-btn {
  display: inline-block;
  padding: 14px 28px;
  border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 500;
  text-decoration: none;
  transition: all 0.2s;
  border: 2px solid transparent;
  white-space: nowrap;
}
.o-btn--green {
  background: var(--green, #81AB4C);
  color: #ffffff;
  border-color: var(--green, #81AB4C);
}
.o-btn--green:hover {
  background: #6e9640;
  border-color: #6e9640;
  transform: translateY(-2px);
  color: #ffffff;
}
.o-btn--outline {
  background: transparent;
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.5);
}
.o-btn--outline:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: #ffffff;
  transform: translateY(-2px);
  color: #ffffff;
}

/* ── 5-IMAGE GALLERY — 3+2 GRID ── */
.o-gallery {
  padding: 72px 5% 64px;
}
.o-gallery__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.o-gallery__item--4,
.o-gallery__item--5 {
  grid-column: span 1;
}
.o-gallery__item--5 {
  /* last item in 3+2: spans 2 cols on large, stays full on medium */
  grid-column: 2 / 4;
}
.o-gallery__card {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(39, 46, 50, 0.10);
  cursor: pointer;
}
.o-gallery__card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.35s ease;
}
.o-gallery__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(39, 46, 50, 0.75) 0%, transparent 55%);
  display: flex;
  align-items: flex-end;
  padding: 20px 18px;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.o-gallery__card:hover img {
  transform: scale(1.03);
}
.o-gallery__card:hover .o-gallery__overlay {
  opacity: 1;
}
.o-gallery__label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.3px;
  transform: translateY(8px);
  transition: transform 0.3s ease;
}
.o-gallery__card:hover .o-gallery__label {
  transform: translateY(0);
}

/* ── BENEFITS SECTION ── */
.o-benefits {
  padding: 80px 5% 72px;
}
.o-benefits__hd {
  margin-bottom: 48px;
}
.o-benefits__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
  max-width: 560px;
}
.o-benefits__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.o-benefit-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 32px 24px 28px;
  box-shadow: 0 4px 24px rgba(39, 46, 50, 0.08);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.o-benefit-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 36px rgba(39, 46, 50, 0.14);
}
.o-benefit-card__icon {
  width: 52px;
  height: 52px;
  background: #81AB4C;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  color: #ffffff;
}
.o-benefit-card__heading {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 19px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 10px;
  line-height: 1.3;
}
.o-benefit-card__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.7;
  margin: 0;
}

/* ── WHY OFFICES SECTION ── */
.o-why {
  padding: 80px 5%;
  background: var(--off-white, #F7F6F3);
}
.o-why__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: start;
}
.o-why__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
  max-width: 520px;
}
.o-why__para {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.8;
  margin: 0 0 20px;
}
.o-why__para:last-child {
  margin-bottom: 0;
}

/* ── STATISTICS ROW ── */
.o-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  background: var(--brand, #272E32);
}
.o-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64px 40px;
  border-right: 1px solid rgba(255, 255, 255, 0.1);
  text-align: center;
}
.o-stat:last-child {
  border-right: none;
}
.o-stat__value {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(48px, 5vw, 72px);
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
  margin-bottom: 12px;
}
.o-stat__label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.6);
}

/* ── TESTIMONIALS SECTION ── */
.o-testimonials {
  padding: 100px 5%;
  background: #ffffff;
}
.o-testimonials__hd {
  margin-bottom: 56px;
}
.o-testimonials__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
  max-width: 560px;
}
.o-testimonials__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}
.o-testimonial {
  background: var(--off-white, #F7F6F3);
  border-radius: 18px;
  padding: 36px 32px 32px;
}
.o-testimonial__quote {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.75;
  margin: 0 0 24px;
  font-style: italic;
}
.o-testimonial__author {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.o-testimonial__name {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
}
.o-testimonial__role {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  color: var(--text-light, #888888);
}

/* ── CTA SECTION ── */
.o-cta {
  background: var(--brand, #272E32);
  border-radius: 40px;
  padding: 72px 60px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 20px;
  margin: 0 5% 0;
}
.o-cta__heading {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 44px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  margin: 0;
}
.o-cta__sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: rgba(255, 255, 255, 0.65);
  margin: 0;
  max-width: 480px;
}
.o-cta__btns {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 8px;
}

/* ── FADE IN ANIMATION ── */
.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .o-gallery__grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .o-gallery__item--3 {
    grid-column: span 1;
  }
  .o-gallery__item--4,
  .o-gallery__item--5 {
    grid-column: span 1;
  }
  .o-gallery__item--5 {
    grid-column: span 2;
  }
  .o-benefits__grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .o-why__inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .o-testimonials__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .o-gallery {
    padding: 48px 5% 40px;
  }
  .o-gallery__grid {
    grid-template-columns: 1fr;
  }
  .o-gallery__item--4,
  .o-gallery__item--5 {
    grid-column: span 1;
  }
  .o-gallery__item--5 {
    grid-column: span 1;
  }
  .o-gallery__overlay {
    opacity: 1;
  }
  .o-gallery__label {
    transform: translateY(0);
  }
  .o-benefits {
    padding: 60px 5%;
  }
  .o-benefits__grid {
    grid-template-columns: 1fr;
  }
  .o-why {
    padding: 60px 5%;
  }
  .o-stat {
    padding: 48px 24px;
  }
  .o-testimonials {
    padding: 60px 5%;
  }
  .o-testimonials__grid {
    grid-template-columns: 1fr;
  }
  .o-cta {
    padding: 48px 28px;
    margin: 0 3% 0;
  }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>
