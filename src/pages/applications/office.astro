---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Office Window Film in Philadelphia | Privacy, Glare Control & Energy Savings';
const description = 'Window film for Philadelphia offices: reduce glare, block 99% of UV rays, improve energy efficiency and employee comfort. Professional installation by certified technicians.';

const galleryImages = [
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163219_ef8a6773-eb18-43d3-a8cf-305c12c72dd2.png',
    label: 'Professional Installation',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163222_79b81cd9-fd33-453a-8c62-ab37d4d031d1.png',
    label: '99% UV Protection',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163225_ef3d64e4-534f-42b3-bc9b-af78ddffac20.png',
    label: 'Security & Safety',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163229_6541b9dc-3f99-46f5-bc6f-5aecd8fd77ae.png',
    label: 'Glare-Free Workspaces',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163859_fabc7e12-368e-49f3-8971-08b76bbdd518.png',
    label: 'Energy Efficiency',
  },
];

const faqItems = [
  {
    question: 'How long does office window film installation take?',
    answer: 'Most commercial office installations are completed within 1–3 days depending on the number of windows. Our team works around your business hours to minimize disruption. We can install in phases if your office has multiple floors or wings, ensuring your team can continue working without significant interruption.',
  },
  {
    question: 'Will window film make my office too dark?',
    answer: 'Not at all. We offer a wide range of film darkness levels — from nearly invisible clear safety films to moderate tinting. Most office clients choose a light to medium tint that reduces heat and glare while maintaining excellent natural daylight. Your space will stay bright and welcoming, just more comfortable.',
  },
  {
    question: 'Can window film help with office privacy?',
    answer: 'Yes. We offer frosted, decorative, and one-way mirror films that give your office a professional appearance while controlling visibility. This is especially popular for conference rooms, executive offices, and ground-floor windows facing busy streets. Privacy film still allows natural light in while preventing outside visibility during daytime hours.',
  },
  {
    question: 'Does window film damage window glass?',
    answer: 'No. When professionally installed by our certified technicians, window film will not damage your glass. In fact, security films can protect glass from shattering, which is especially beneficial for older buildings with single-pane windows. We assess each building\'s glass type and thermal conditions before recommending the right film.',
  },
  {
    question: 'What is the ROI on office window film?',
    answer: 'Most commercial clients see a full return on investment within 2–4 years through reduced cooling costs (up to 30%), fewer HVAC repairs from reduced strain, and increased employee productivity from improved comfort. Security films also reduce liability exposure and can lower insurance premiums for some properties.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Office Window Film Installation"
  serviceDesc="Professional window film installation for Philadelphia commercial office buildings — UV protection, glare control, privacy, and energy efficiency."
  serviceUrl="https://www.windowfilmphiladelphia.com/applications/office"
  faqItems={faqItems}
>
  <InnerPageHero
    title="Office Window Film"
    desc="Privacy · Glare Control · Energy Savings"
    bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161444_92b264a0-f13c-47ca-93dd-af03bc5e5db9.png"
  />

  <!-- Trust Bar -->
  <section class="office-trust">
    <div class="container">
      <p class="trust-label">Trusted by leading Philadelphia businesses</p>
      <BrandLogos />
    </div>
  </section>

  <!-- Pain Points (dark) -->
  <section class="pain-section">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">The Problem</span>
        <h2 class="section-title">Philadelphia Offices Face Real Window Challenges Every Day</h2>
        <p class="section-subtitle">Without window film, your office is fighting a constant battle against heat, glare, and UV exposure — and your team is paying the price.</p>
      </div>
      <div class="pain-grid">
        <div class="pain-card">
          <div class="pain-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#81AB4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          </div>
          <h3>Intense Solar Heat</h3>
          <p>Philadelphia's summer sun turns west-facing offices into furnaces. Your HVAC system works overtime fighting 90°F+ solar heat gain through unprotected glass — running constantly, breaking down more often, and driving utility bills up every single month.</p>
        </div>
        <div class="pain-card">
          <div class="pain-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#81AB4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3>Dazzling Screen Glare</h3>
          <p>Employees squinting at monitors, curtains pulled shut, blinds permanently angled the wrong way. Glare doesn't just cause discomfort — it creates eye strain, headaches, and reduced productivity. Workers in south and west-facing desks are the most affected throughout the afternoon.</p>
        </div>
        <div class="pain-card">
          <div class="pain-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#81AB4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Unprotected UV Exposure</h3>
          <p>Glass blocks sunburn — but UV rays pass right through. Employees near windows receive significant UV exposure throughout the workday, increasing long-term health risks. UV also bleaches furniture, carpets, artwork, and equipment, costing thousands in premature replacements.</p>
        </div>
        <div class="pain-card">
          <div class="pain-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#81AB4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3>Privacy & Security Risks</h3>
          <p>Ground-floor offices, executive conference rooms, and buildings on busy streets face constant visibility from passersby. Standard glass also shatters easily on impact — a security risk for employees and an liability concern for building owners that most insurance policies don't adequately address.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5-Image Gallery -->
  <section class="gallery-section">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">Our Work</span>
        <h2 class="section-title">What Office Window Film Looks Like in Action</h2>
        <p class="section-subtitle">From downtown high-rises to suburban office parks, our films deliver measurable results. Here's what we install.</p>
      </div>
      <div class="gallery-grid">
        {galleryImages.map((img, i) => (
          <div class="gallery-card" style={`--delay: ${i * 80}ms`}>
            <img src={img.src} alt={img.label} loading="lazy" />
            <div class="gallery-overlay">
              <span>{img.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits (white cards) -->
  <section class="benefits-section">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">Benefits</span>
        <h2 class="section-title">Transform Your Office Environment in Days</h2>
        <p class="section-subtitle">Window film is one of the fastest, most cost-effective upgrades you can make to any commercial building — with results you'll notice from day one.</p>
      </div>
      <div class="benefits-grid">
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>99% UV Blocked</h3>
          <p>Our films block up to 99% of harmful ultraviolet rays, protecting your employees' health and preventing the gradual fading of furniture, carpets, artwork, and equipment. It's the single most effective thing you can do for long-term asset protection.</p>
          <p class="benefit-detail">Skin cancer protection for employees · Furniture preservation · Reduced liability</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
          </div>
          <h3>Up to 30% Energy Savings</h3>
          <p>Heat-rejecting window film dramatically reduces solar heat gain through glass, meaning your HVAC system runs far less to maintain comfortable temperatures. Philadelphia businesses routinely report 20–30% reductions in summer cooling costs after installation.</p>
          <p class="benefit-detail">Lower utility bills · Reduced HVAC strain · Faster ROI than replacement windows</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3>Eliminates Glare Entirely</h3>
          <p>Screen glare turns a west-facing desk into an unusable nightmare. Our glare-control films eliminate this problem completely — employees can work comfortably all day without squinting, closing blinds, or repositioning monitors. Productivity follows comfort.</p>
          <p class="benefit-detail">All-day monitor clarity · No more closed blinds · Happier employees</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3>Security & Safety</h3>
          <p>Security window film holds glass together on impact — whether from an accidental bump, a storm, or an attempted break-in. It doesn't make glass unbreakable, but it makes broken glass stay in the frame, preventing injury and slowing down intruders significantly.</p>
          <p class="benefit-detail">Holds shattered glass · Slows intruders · Insurance-friendly</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Office (2-col: text left, image right) -->
  <section class="why-office-section">
    <div class="container">
      <div class="why-office-grid">
        <div class="why-office-text">
          <span class="eyebrow">Why Window Film for Offices</span>
          <h2 class="section-title">Philadelphia's Office Buildings Deserve Better Glass</h2>
          <p>Philadelphia's commercial building stock includes a remarkable number of architecturally significant structures built before 1980 — offices with beautiful large windows that are genuinely gorgeous but catastrophically inefficient by modern standards. Single-pane glass, no low-E coating, no thermal break. Beautiful and painful in equal measure.</p>
          <p>Rather than replacing windows — an enormously expensive, disruptive, and time-consuming process — window film offers an immediate solution. In just 1–3 days, we can treat an entire floor of an office building with films that perform better than most replacement windows at a fraction of the cost.</p>
          <p>Our commercial clients include law firms in Center City high-rises, medical offices in University City, tech startups in Old City, and corporate campuses throughout the Main Line. Each has different needs — privacy, aesthetics, energy performance — and we have the right film for every situation.</p>
          <div class="why-office-cta">
            <a href="/contact/" class="btn btn--primary">Schedule a Consultation</a>
            <a href="tel:+12155551234" class="btn btn--outline-light">(215) 555-1234</a>
          </div>
        </div>
        <div class="why-office-image">
          <img src="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163229_6541b9dc-3f99-46f5-bc6f-5aecd8fd77ae.png" alt="Office with window film — glare-free workspace" loading="lazy" />
          <div class="image-badge">
            <strong>30%</strong>
            <span>Avg. Energy Cost Reduction</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Row (dark) -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-number">16+</span>
          <span class="stat-label">Years in Philadelphia</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">500+</span>
          <span class="stat-label">Commercial Projects</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">99%</span>
          <span class="stat-label">UV Rays Blocked</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">30%</span>
          <span class="stat-label">Energy Savings Avg.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="process-section">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">How It Works</span>
        <h2 class="section-title">From First Call to Finished Installation in 3 Simple Steps</h2>
        <p class="section-subtitle">We handle everything — from initial assessment to final clean-up. Your team keeps working while we transform your building.</p>
      </div>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-number">01</div>
          <div class="step-content">
            <h3>Free Consultation & Thermal Analysis</h3>
            <p>We start with a complimentary on-site visit or virtual consultation. Our certified technician assesses your building's orientation, glass type, current issues, and goals. We use thermal imaging equipment to identify exactly where heat is entering and recommend the optimal film specification for your situation and budget. You'll receive a detailed proposal within 24 hours.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">02</div>
          <div class="step-content">
            <h3>Professional Installation</h3>
            <p>Our factory-trained installers arrive on schedule with all equipment. We work around your business hours — evenings, weekends, or in phases across multiple floors — to ensure zero disruption to your operations. We use precise, professional techniques that ensure a flawless, bubble-free application. Most commercial projects are completed within 1–3 days.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">03</div>
          <div class="step-content">
            <h3>Quality Inspection & Warranty</h3>
            <p>Every installation is inspected by our supervisor before we consider the job complete. We walk the space with you, demonstrate the film's performance, and answer any questions. Your installation is backed by our labor warranty and the manufacturer's material warranty — typically 10–15 years on commercial films. We're always available for any future adjustments or service needs.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">Questions</span>
        <h2 class="section-title">Frequently Asked Questions About Office Window Film</h2>
        <p class="section-subtitle">Honest answers from people who've been installing window film in Philadelphia for over 16 years.</p>
      </div>
      <div class="faq-list">
        {faqItems.map((item, i) => (
          <div class="faq-item" data-faq>
            <button class="faq-question" aria-expanded="false">
              <span>{item.question}</span>
              <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="faq-cta">
        <p>Have more questions?</p>
        <a href="/contact/" class="btn btn--primary">Talk to a Specialist</a>
      </div>
    </div>
  </section>

  <!-- Testimonials (dark bg) -->
  <section class="testimonials-section">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow eyebrow--light">Client Stories</span>
        <h2 class="section-title section-title--light">What Philadelphia Businesses Are Saying</h2>
      </div>
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <div class="stars">★★★★★</div>
          <p class="testimonial-text">"Our Center City law firm had a major problem — the west-facing wall of our conference room turned into a solar oven every afternoon, making client meetings miserable. Window Film Philadelphia installed heat-rejecting film on all 22 windows in two days. The difference was immediate. Conference room is comfortable all day now, and our cooling bills in July and August dropped noticeably. Absolutely worth every dollar."</p>
          <div class="testimonial-author">
            <strong>David R.</strong>
            <span>Managing Partner, Rittenhouse Law Group</span>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="stars">★★★★★</div>
          <p class="testimonial-text">"We have 12 employees in an open-plan office with floor-to-ceiling windows. The glare issue was destroying morale — people were literally wearing sunglasses at their desks at 3pm. We tried blinds, but nobody liked them. The window film was the right solution. It's barely noticeable visually but the glare is completely gone. Our team is happier and more productive. This was a quality-of-life upgrade for the whole office."</p>
          <div class="testimonial-author">
            <strong>Sarah M.</strong>
            <span>Operations Director, Launchpad Tech, Fishtown</span>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="stars">★★★★★</div>
          <p class="testimonial-text">"As a building owner, I'm always looking for cost-effective ways to improve my properties. Window film is one of the best investments I've made — it's increased tenant satisfaction in both buildings where we've installed it, reduced vacancy-related turnover, and the energy savings have been real and measurable. The Window Film Philadelphia team was professional, on-time, and left the buildings spotless."</p>
          <div class="testimonial-author">
            <strong>Michael T.</strong>
            <span>Property Owner, MT Commercial Real Estate, Main Line</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section (brand dark) -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-box">
        <h2>Ready to Transform Your Office?</h2>
        <p>Get a free consultation and thermal analysis. No obligation, no pressure — just honest advice on whether window film is right for your building.</p>
        <div class="cta-buttons">
          <a href="/contact/" class="btn btn--primary btn--large">Get a Free Quote</a>
          <a href="tel:+12155551234" class="btn btn--outline-light btn--large">Call (215) 555-1234</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Global Helpers ─────────────────────────────────────── */
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 5%;
  }
  .eyebrow {
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 12px;
  }
  .eyebrow--light { color: rgba(255,255,255,0.55); }
  .section-header { margin-bottom: 56px; }
  .section-header--center { text-align: center; }
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 600;
    color: var(--brand);
    line-height: 1.2;
    margin: 0 0 16px;
  }
  .section-title--light { color: #ffffff; }
  .section-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 17px;
    color: #6b7280;
    line-height: 1.7;
    max-width: 640px;
    margin: 0 auto;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 2px solid transparent;
    white-space: nowrap;
  }
  .btn--primary {
    background: var(--green);
    color: #ffffff;
    border-color: var(--green);
  }
  .btn--primary:hover {
    background: #6a9439;
    border-color: #6a9439;
    transform: translateY(-2px);
  }
  .btn--outline-light {
    background: transparent;
    color: #ffffff;
    border-color: rgba(255,255,255,0.4);
  }
  .btn--outline-light:hover {
    border-color: #ffffff;
    background: rgba(255,255,255,0.08);
  }
  .btn--large { padding: 16px 36px; font-size: 16px; }

  /* ── Trust Bar ────────────────────────────────────────────── */
  .office-trust {
    background: var(--off-white);
    padding: 32px 0;
    border-bottom: 1px solid #e5e7eb;
  }
  .trust-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #9ca3af;
    text-align: center;
    margin: 0 0 20px;
  }

  /* ── Pain Section ─────────────────────────────────────────── */
  .pain-section {
    background: var(--brand);
    padding: 80px 0;
  }
  .pain-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 48px;
  }
  .pain-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 18px;
    padding: 32px;
    transition: background 0.2s ease;
  }
  .pain-card:hover { background: rgba(255,255,255,0.1); }
  .pain-icon {
    width: 52px;
    height: 52px;
    background: rgba(129,171,76,0.15);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .pain-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 12px;
  }
  .pain-card p {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: rgba(255,255,255,0.65);
    margin: 0;
  }

  /* ── Gallery ─────────────────────────────────────────────── */
  .gallery-section { background: #ffffff; padding: 80px 0; }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 280px);
    gap: 16px;
  }
  .gallery-grid .gallery-card:nth-child(4) { grid-column: 1; }
  .gallery-grid .gallery-card:nth-child(5) { grid-column: 2; }
  .gallery-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
  }
  .gallery-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
