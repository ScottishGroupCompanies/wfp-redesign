  .of-row__image img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .of-row__image:hover img { transform: scale(1.03); }
  .of-row__text { display: flex; flex-direction: column; }
  .of-row__eyebrow {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7CB342;
    margin-bottom: 12px;
  }
  .of-row__title {
    font-family: 'Playfair Display', serif;
