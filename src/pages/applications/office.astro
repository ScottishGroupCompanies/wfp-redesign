---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Office Window Film in Philadelphia | Privacy, Glare Control & Energy Savings';
const description = 'Window film for Philadelphia offices: reduce glare, block 99% of UV rays, improve energy efficiency and employee comfort. Professional installation by certified technicians.';

const galleryImages = [
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163219_ef8a6773-eb18-43d3-a8cf-305c12c72dd2.png', label: 'Professional Installation' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163222_79b81cd9-fd33-453a-8c62-ab37d4d031d1.png', label: '99% UV Blocked' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163225_ef3d64e4-534f-42b3-bc9b-af78ddffac20.png', label: 'Security & Safety' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163229_6541b9dc-3f99-46f5-bc6f-5aecd8fd77ae.png', label: 'Glare-Free Workspace' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163859_fabc7e12-368e-49f3-8971-08b76bbdd518.png', label: 'Energy Efficiency' },
];

const newImages = {
  officeInterior: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170300_522f3006-3bdb-434a-a84b-472b0b56e0e8.png',
  buildingExterior: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170303_116dd402-20cd-4cc2-96fd-f34262614195.png',
  installer: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170307_c36c9b4c-09ec-4e15-b334-d83e9f590a89.png',
  glare: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170324_f2fb6bcd-4ac1-4aae-a52b-d57053ccab28.png',
  uvDamage: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170329_e2a5af28-c541-4107-94ea-8315fa119347.png',
  privacy: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170332_7a02abaf-9a99-4d42-b4d6-965dcbfe18ea.png',
  hvac: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170335_205f9050-c15e-4135-9684-8380335dac7c.png',
};

const faqItems = [
  { question: 'How long does office window film installation take?', answer: 'Most commercial office installations are completed within 1–3 days depending on the number of windows. Our team works around your business hours to minimize disruption. We can install in phases across multiple floors or wings.' },
  { question: 'Will window film make my office too dark?', answer: 'Not at all. We offer films from nearly invisible clear safety films to moderate tinting. Most office clients choose a light to medium tint that reduces heat and glare while maintaining excellent natural daylight.' },
  { question: 'Can window film help with office privacy?', answer: 'Yes. We offer frosted, decorative, and one-way mirror films that give your office a professional appearance while controlling visibility — ideal for conference rooms, executive offices, and ground-floor windows.' },
  { question: 'Does window film damage window glass?', answer: 'No. When professionally installed, window film will not damage your glass. Security films actually protect glass from shattering. We assess each building\'s glass type and thermal conditions before recommending the right film.' },
  { question: 'What is the ROI on office window film?', answer: 'Most commercial clients see a full return within 2–4 years through reduced cooling costs — up to 30% — fewer HVAC repairs, and increased employee productivity. Security films also reduce liability and may lower insurance premiums.' },
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Office Window Film Installation"
  serviceDesc="Professional window film installation for Philadelphia commercial office buildings — UV protection, glare control, privacy, and energy efficiency."
  serviceUrl="https://www.windowfilmphiladelphia.com/applications/office"
  faqItems={faqItems}
>
  <!-- HERO -->
  <section class="swt-hero">
    <div class="swt-hero__img">
      <img src={newImages.officeInterior} alt="Modern Philadelphia office with window film installed" width="1440" height="700" />
      <div class="swt-hero__overlay"></div>
    </div>
    <div class="swt-hero__content">
      <span class="swt-badge">
        <svg width="8" height="8" viewBox="0 0 8 8" fill="none"><circle cx="4" cy="4" r="4" fill="#4E6B2A"/></svg>
        Commercial Window Solutions
      </span>
      <h1 class="swt-hero__title">
        Privacy. Comfort.<br/>
        <em>Energy Savings.</em><br/>
        One Professional Upgrade.
      </h1>
      <p class="swt-hero__sub">Block 99% of UV rays, eliminate screen glare, and cut cooling costs by up to 30% — installed in your Philadelphia office in 1–3 days.</p>
      <div class="swt-hero__ctas">
        <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Quote</a>
        <a href="#benefits" class="swt-btn swt-btn--ghost-light">See Benefits</a>
      </div>
    </div>
  </section>

  <div class="swt-body">

    <!-- TRUST BAR -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by leading Philadelphia businesses</p>
        <BrandLogos />
      </div>
    </section>

    <!-- SECTION 1: THE PROBLEM — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="problem">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">The Challenge</span>
            <h2 class="swt-h2 swt-h2--light">Philadelphia Offices Are Losing the Battle Against Their Windows</h2>
            <p>Large glass facades look stunning on architectural drawings. In practice, they create a daily struggle — west-facing offices that become solar ovens by 2pm, employees squinting at screens all afternoon, and HVAC systems running constantly to compensate.</p>
            <p>Philadelphia's changing climate has made this worse. The city now sees over 30% more extreme heat days per decade. UV rays pass straight through standard glass, creating health risks for employees near windows and accelerating fading of furniture, carpets, and equipment.</p>
            <div class="swt-problem-tags">
              <span class="swt-tag swt-tag--red">Solar Heat Gain</span>
              <span class="swt-tag swt-tag--red">Screen Glare</span>
              <span class="swt-tag swt-tag--red">UV Exposure</span>
              <span class="swt-tag swt-tag--red">Privacy Risks</span>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.glare} alt="Office worker experiencing screen glare from large windows" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: UV — white bg, image left, text right -->
    <section class="swt-split" id="uv">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src="https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163222_79b81cd9-fd33-453a-8c62-ab37d4d031d1.png" alt="UV protection demonstration on office windows" loading="lazy" />
            <div class="swt-img-badge">
              <strong>99%</strong>
              <span>UV Blocked</span>
            </div>
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 01</span>
            <h2 class="swt-h2">Block 99% of Harmful UV Rays — Protect People and Assets</h2>
            <p>UV-A and UV-B rays pass straight through untreated glass. Employees working near windows receive the equivalent UV exposure of outdoor workers — without the awareness that usually comes with stepping outside. Over years, this accumulates into serious health risk.</p>
            <p>Beyond health, UV is the primary driver of interior fading. Carpets, artwork, leather furniture, and branded displays all degrade irreversibly under chronic UV exposure. Our films block up to 99% of UV transmission, extending the life of everything inside your building.</p>
            <ul class="swt-check-list">
              <li>Reduced skin cancer risk for window-proximate employees</li>
              <li>Protected furniture, carpet, and artwork from fading</li>
              <li>Reduced liability exposure for building owners</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: ENERGY — alt cream bg, text left, image right -->
    <section class="swt-split swt-split--alt" id="energy">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 02</span>
            <h2 class="swt-h2">Cut Cooling Costs by 30% Without Replacing a Single Window</h2>
            <p>The solar heat entering through untreated glass is the single largest driver of summer cooling loads in Philadelphia commercial buildings. A west-facing wall of windows can add the equivalent heat output of a 6,000 BTU heater — per window. Your HVAC system fights this 24/7.</p>
            <p>Heat-rejecting window film is a fraction of the cost of replacement windows — typically 1/10th the price — and takes days to install rather than months. The payback period is usually 2–4 years, after which the savings are pure operational benefit.</p>
            <div class="swt-energy-metrics">
              <div class="swt-metric">
                <span class="swt-metric__num">30%</span>
                <span class="swt-metric__label">Avg. Cooling Cost Reduction</span>
              </div>
              <div class="swt-metric">
                <span class="swt-metric__num">2–4yr</span>
                <span class="swt-metric__label">Typical Payback Period</span>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.hvac} alt="Philadelphia office building HVAC working hard in summer heat" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: GLARE — white bg, image left, text right -->
    <section class="swt-split" id="glare">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.buildingExterior} alt="Philadelphia commercial office building exterior" loading="lazy" />
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 03</span>
            <h2 class="swt-h2">Eliminate Screen Glare — Give Your Team Their Afternoons Back</h2>
            <p>If you've ever watched an office team battle over the desk furthest from the west windows, you've seen the productivity cost of glare in real time. Employees tilt blinds, rotate monitors, and squint through headaches — all because one afternoon window creates an unbearable working environment.</p>
            <p>Our glare-control films eliminate this entirely. The film selectively filters the wavelengths that cause screen glare while maintaining full natural daylight and outdoor views. Employees stop fighting their environment and start working.</p>
            <blockquote class="swt-inline-quote">
              "We stopped having 'the west desk problem.' Everyone is comfortable all day now."
              <cite>— Operations Manager, tech firm, Old City Philadelphia</cite>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: SECURITY — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="security">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow swt-eyebrow--green">Benefit 04</span>
            <h2 class="swt-h2 swt-h2--light">Security Film: Hold Glass Together When It Matters Most</h2>
            <p>Standard glass shatters on impact — a real danger in storms, accidents, or break-in attempts. Security window film doesn't make glass unbreakable, but it holds shattered panes in the frame, dramatically reducing injury risk and slowing forced entry.</p>
            <p>For Philadelphia offices — particularly ground-floor retail branches, medical offices, and government-adjacent buildings — this is a sensible, insurance-friendly security upgrade at a fraction of the cost of laminated glass replacement.</p>
            <div class="swt-security-features">
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Shatter Resistance</strong>
                  <p>Glass stays in frame on impact — no dangerous shards flying</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Delayed Entry</strong>
                  <p>Slows intruders by 3–7 minutes — critical window for response</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Insurance-Friendly</strong>
                  <p>Documented security upgrade that may qualify for premium discounts</p>
                </div>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.privacy} alt="Conference room privacy with window film" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY — 5 images -->
    <section class="swt-gallery" id="gallery">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">Our Work</span>
          <h2 class="swt-h2 swt-h2--center">Window Film — In Action</h2>
          <p class="swt-subhead">From downtown high-rises to suburban office parks — here's what we install.</p>
        </div>
        <div class="swt-gallery__grid">
          {galleryImages.map((img, i) => (
            <div class="swt-gallery__item fade-in" style={`--delay: ${i * 80}ms`}>
              <img src={img.src} alt={img.label} loading="lazy" />
              <div class="swt-gallery__overlay">
                <span>{img.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STATS BAR — accent green -->
    <section class="swt-stats">
      <div class="container">
        <div class="swt-stats__row">
          <div class="swt-stats__item fade-in">
            <span class="swt-stats__num">16+</span>
            <span class="swt-stats__label">Years in Philadelphia</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 80ms">
            <span class="swt-stats__num">500+</span>
            <span class="swt-stats__label">Commercial Projects</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 160ms">
            <span class="swt-stats__num">99%</span>
            <span class="swt-stats__label">UV Rays Blocked</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 240ms">
            <span class="swt-stats__num">30%</span>
            <span class="swt-stats__label">Avg. Energy Savings</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS — 3 steps -->
    <section class="swt-process">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">How It Works</span>
          <h2 class="swt-h2 swt-h2--center">3 Simple Steps to a Better Office</h2>
        </div>
        <div class="swt-process__steps">
          <div class="swt-process__step fade-in">
            <div class="swt-process__num">01</div>
            <div class="swt-process__body">
              <h3>Free Consultation & Thermal Analysis</h3>
              <p>We visit your office and use thermal imaging to identify exactly where heat enters. You receive a detailed proposal within 24 hours with the optimal film for your building, orientation, and budget. No obligation.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 80ms">
            <div class="swt-process__num">02</div>
            <div class="swt-process__body">
              <h3>Professional Installation in 1–3 Days</h3>
              <p>Our factory-trained installers work around your business hours. We install in phases across multiple floors if needed, with no disruption to your team. We leave the building spotless.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 160ms">
            <div class="swt-process__num">03</div>
            <div class="swt-process__body">
              <h3>Inspection & Long-Term Warranty</h3>
              <p>We walk the space with you before considering the job done. Every installation is backed by our labor warranty and the manufacturer's material warranty — typically 10–15 years on commercial films.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS — dark bg -->
    <section class="swt-testimonials">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow swt-eyebrow--green">Client Stories</span>
          <h2 class="swt-h2 swt-h2--center swt-h2--light">Real Results from Real Businesses</h2>
        </div>
        <div class="swt-testimonials__grid">
          <div class="swt-testimonial fade-in">
            <div class="swt-testimonial__quote">"</div>
            <p>Our conference room was unusable in the afternoon — direct west sun turned it into a solar oven. After the film was installed, it's comfortable all day. The difference was immediate and dramatic. Worth every dollar.</p>
            <div class="swt-testimonial__author">
              <strong>David R.</strong>
              <span>Managing Partner, Rittenhouse Law Group</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 80ms">
            <div class="swt-testimonial__quote">"</div>
            <p>We had people literally wearing sunglasses at their desks at 3pm. The glare was that bad. Window film fixed it completely. No more closed blinds, no more fights over which desk is 'the bad desk.' Best office upgrade we've done in years.</p>
            <div class="swt-testimonial__author">
              <strong>Sarah M.</strong>
              <span>Operations Director, Launchpad Tech, Fishtown</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 160ms">
            <div class="swt-testimonial__quote">"</div>
            <p>As a building owner, I'm always looking for cost-effective ways to improve tenant satisfaction. Window film in two of my buildings reduced vacancy turnover measurably and the energy savings are real and documented. The team was professional and on time.</p>
            <div class="swt-testimonial__author">
              <strong>Michael T.</strong>
              <span>Property Owner, MT Commercial Real Estate</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="swt-faq" id="faq">
      <div class="container">
        <div class="swt-faq__layout">
          <div class="swt-faq__header fade-in">
            <span class="swt-eyebrow">Questions</span>
            <h2 class="swt-h2">Frequently Asked Questions</h2>
            <p>Honest answers from people who've been doing this in Philadelphia for over 16 years.</p>
            <a href="/contact/" class="swt-btn swt-btn--primary">Talk to a Specialist</a>
          </div>
          <div class="swt-faq__list fade-in">
            {faqItems.map((item) => (
              <div class="swt-faq__item">
                <div class="swt-faq__q">
                  <span>{item.question}</span>
                  <span class="swt-faq__toggle">+</span>
                </div>
                <div class="swt-faq__a">
                  <p>{item.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA BANNER -->
    <section class="swt-cta">
      <div class="swt-cta__inner">
        <div class="swt-cta__text">
          <h2>Ready to <em>transform</em> your office?</h2>
          <p>Get a free consultation and thermal analysis. No obligation, no pressure — just honest advice.</p>
        </div>
        <div class="swt-cta__btns">
          <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Quote</a>
          <a href="tel:+12673947980" class="swt-btn swt-btn--ghost-light">Call (267) 394-7980</a>
        </div>
      </div>
    </section>

  </div><!-- /swt-body -->
</BaseLayout>

<style>
  /* ══════════════════════════════════════
     BRAND TOKENS (local override)
     ══════════════════════════════════════ */
  :root {
    --swt-green:        #4E6B2A;
    --swt-green-accent: #83A94A;
    --swt-dark:         #2A241E;
    --swt-cream:        #F4EFE6;
    --swt-alt:          #ECE4D4;
    --swt-border:       #E1D6C1;
    --swt-text-sec:     #6E665C;
    --swt-gold:         #846212;
    --swt-white:        #ffffff;
    --swt-radius:       5px;
  }

  /* ══════════════════════════════════════
     HERO
     ══════════════════════════════════════ */
  .swt-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .swt-hero__img {
    position: absolute;
    inset: 0;
  }
  .swt-hero__img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .swt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(42,36,30,0.9) 0%, rgba(42,36,30,0.6) 50%, rgba(42,36,30,0.35) 100%);
  }
  .swt-hero__content {
    position: relative;
    z-index: 1;
    padding: 110px 8% 90px;
    max-width: 720px;
  }
  .swt-badge {
    display: inline-flex;
