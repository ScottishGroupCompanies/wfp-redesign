---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Office Window Film in Philadelphia | Privacy, Glare Control & Energy Savings';
const description = 'Window film for Philadelphia offices: reduce glare, block 99% of UV rays, improve energy efficiency and employee comfort. Professional installation by certified technicians.';

const galleryImages = [
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163219_ef8a6773-eb18-43d3-a8cf-305c12c72dd2.png', label: 'Professional Installation' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163222_79b81cd9-fd33-453a-8c62-ab37d4d031d1.png', label: '99% UV Blocked' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163225_ef3d64e4-534f-42b3-bc9b-af78ddffac20.png', label: 'Security & Safety' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163229_6541b9dc-3f99-46f5-bc6f-5aecd8fd77ae.png', label: 'Glare-Free Workspace' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163859_fabc7e12-368e-49f3-8971-08b76bbdd518.png', label: 'Energy Efficiency' },
];

const faqItems = [
  { question: 'How long does office window film installation take?', answer: 'Most commercial office installations are completed within 1–3 days depending on the number of windows. Our team works around your business hours to minimize disruption. We can install in phases if your office has multiple floors or wings.' },
  { question: 'Will window film make my office too dark?', answer: 'Not at all. We offer films from nearly invisible clear safety films to moderate tinting. Most office clients choose a light to medium tint that reduces heat and glare while maintaining excellent natural daylight.' },
  { question: 'Can window film help with office privacy?', answer: 'Yes. We offer frosted, decorative, and one-way mirror films that give your office a professional appearance while controlling visibility — ideal for conference rooms, executive offices, and ground-floor windows.' },
  { question: 'Does window film damage window glass?', answer: 'No. When professionally installed, window film will not damage your glass. Security films actually protect glass from shattering. We assess each building\'s glass type and thermal conditions before recommending the right film.' },
  { question: 'What is the ROI on office window film?', answer: 'Most commercial clients see a full return within 2–4 years through reduced cooling costs (up to 30%), fewer HVAC repairs, and increased employee productivity. Security films also reduce liability and can lower insurance premiums.' },
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Office Window Film Installation"
  serviceDesc="Professional window film installation for Philadelphia commercial office buildings — UV protection, glare control, privacy, and energy efficiency."
  serviceUrl="https://www.windowfilmphiladelphia.com/applications/office"
  faqItems={faqItems}
>
  <!-- Hero -->
  <InnerPageHero
    title="Office Window Film"
    desc="Privacy · Glare Control · Energy Savings"
    bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161444_92b264a0-f13c-47ca-93dd-af03bc5e5db9.png"
  />

  <!-- Trust Bar -->
  <section class="trust-bar">
    <div class="container">
      <p class="trust-label">Trusted by leading Philadelphia businesses</p>
      <BrandLogos />
    </div>
  </section>

  <!-- Section 1: The Problem — 2 columns: text LEFT, image RIGHT (dark bg) -->
  <section class="split-section split-section--dark">
    <div class="container">
      <div class="split-grid split-grid--text-left">
        <div class="split-text reveal-left">
          <span class="eyebrow eyebrow--green">The Challenge</span>
          <h2 class="section-heading">Philadelphia Offices Are Losing the Battle Against Their Windows</h2>
          <p>Large glass facades look stunning on architectural drawings. In practice, they create a daily struggle — west-facing offices that turn into solar ovens by 2pm, employees squinting at screens all afternoon, and HVAC systems running constantly to compensate.</p>
          <p>UV rays pass straight through standard glass, creating health risks for employees near windows, fading furniture and equipment, and making workspaces genuinely unpleasant to occupy. Philadelphia's changing climate has only made this worse — the city now sees over 30% more extreme heat days per decade.</p>
          <div class="problem-tags">
            <span class="tag tag--red">🔥 Solar Heat Gain</span>
            <span class="tag tag--red">😵 Screen Glare</span>
            <span class="tag tag--red">☀️ UV Exposure</span>
            <span class="tag tag--red">👁️ Privacy Risks</span>
          </div>
        </div>
        <div class="split-image reveal-right">
          <img src="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163219_ef8a6773-eb18-43d3-a8cf-305c12c72dd2.png" alt="Office window film installation" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: UV Protection — 2 cols: image LEFT, text RIGHT (light bg) -->
  <section class="split-section">
    <div class="container">
      <div class="split-grid split-grid--image-left">
        <div class="split-image reveal-left">
          <img src="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163222_79b81cd9-fd33-453a-8c62-ab37d4d031d1.png" alt="UV protection in office" loading="lazy" />
          <div class="image-stat-badge">
            <strong>99%</strong>
            <span>UV Blocked</span>
          </div>
        </div>
        <div class="split-text reveal-right">
          <span class="eyebrow">Benefit 01</span>
          <h2 class="section-heading">Block 99% of Harmful UV Rays — Protect People and Assets</h2>
          <p>UV-A and UV-B rays pass straight through untreated glass. Employees working near windows receive the equivalent UV exposure of outdoor workers — without the awareness that usually comes with stepping outside. Over years, this accumulates into serious health risk.</p>
          <p>Beyond health, UV is the primary driver of interior fading. Carpets, artwork, leather furniture, and branded displays all degrade irreversibly under chronic UV exposure. Our films block up to 99% of UV transmission, extending the life of everything inside your building.</p>
          <ul class="check-list">
            <li>↓ Skin cancer risk for window-proximate employees</li>
            <li>↓ Furniture, carpet, and artwork fading</li>
            <li>↓ Liability exposure for building owners</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Energy — 2 cols: text LEFT, image RIGHT (sage bg) -->
  <section class="split-section split-section--sage">
    <div class="container">
      <div class="split-grid split-grid--text-left">
        <div class="split-text reveal-left">
          <span class="eyebrow">Benefit 02</span>
          <h2 class="section-heading">Cut Cooling Costs by 30% Without Replacing a Single Window</h2>
          <p>The solar heat entering through untreated glass is the single largest driver of summer cooling loads in Philadelphia commercial buildings. A west-facing wall of windows can add the equivalent heat output of a 6,000 BTU heater — per window. Your HVAC system fights this 24/7.</p>
          <p>Heat-rejecting window film is a fraction of the cost of replacement windows — typically 1/10th the price — and takes days to install rather than months. The payback period is usually 2–4 years, after which the savings are pure operational benefit.</p>
          <div class="energy-stats">
            <div class="energy-stat">
              <span class="energy-num">30%</span>
              <span class="energy-label">Avg. Cooling Cost Reduction</span>
            </div>
            <div class="energy-stat">
              <span class="energy-num">2–4yr</span>
              <span class="energy-label">Typical Payback Period</span>
            </div>
          </div>
        </div>
        <div class="split-image reveal-right">
          <img src="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163859_fabc7e12-368e-49f3-8971-08b76bbdd518.png" alt="Energy efficient office windows" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Glare — 2 cols: image LEFT, text RIGHT (white bg) -->
  <section class="split-section">
    <div class="container">
      <div class="split-grid split-grid--image-left">
        <div class="split-image reveal-left">
          <img src="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163229_6541b9dc-3f99-46f5-bc6f-5aecd8fd77ae.png" alt="Glare-free office workspace" loading="lazy" />
        </div>
        <div class="split-text reveal-right">
          <span class="eyebrow">Benefit 03</span>
          <h2 class="section-heading">Eliminate Screen Glare — Give Your Team Their Afternoons Back</h2>
          <p>If you've ever watched an office team battle over the desk furthest from the west windows, you've seen the productivity cost of glare in real time. Employees tilt blinds, rotate monitors, and squint through headaches — all because one afternoon window creates an unbearable working environment.</p>
          <p>Our glare-control films eliminate this entirely. The film selectively filters the wavelengths that cause screen glare while maintaining full natural daylight and outdoor views. Employees stop fighting their environment and start working.</p>
          <blockquote class="inline-quote">
            "We stopped having 'the west desk problem.' Everyone is comfortable all day now — no more rotaing chairs to avoid the glare."
            <cite>— Operations Manager, tech firm, Old City Philadelphia</cite>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Security — 2 cols: text LEFT, image RIGHT (dark bg) -->
  <section class="split-section split-section--dark">
    <div class="container">
      <div class="split-grid split-grid--text-left">
        <div class="split-text reveal-left">
          <span class="eyebrow eyebrow--green">Benefit 04</span>
          <h2 class="section-heading">Security Film: Hold Glass Together When It Matters Most</h2>
          <p>Standard glass shatters on impact — a real danger in storms, accidents, or break-in attempts. Security window film doesn't make glass unbreakable, but it holds shattered panes in the frame, dramatically reducing injury risk and slowing forced entry.</p>
          <p>For Philadelphia offices — particularly ground-floor retail branches, medical offices, and government-adjacent buildings — this is a sensible, insurance-friendly security upgrade at a fraction of the cost of laminated glass replacement.</p>
          <div class="security-features">
            <div class="security-feature">
              <span class="security-icon">🛡️</span>
              <div>
                <strong>Shatter Resistance</strong>
                <p>Glass stays in frame on impact — no dangerous shards</p>
              </div>
            </div>
            <div class="security-feature">
              <span class="security-icon">⏱️</span>
              <div>
                <strong>Delayed Entry</strong>
                <p>Slows intruders by 3–7 minutes — critical window for response</p>
              </div>
            </div>
            <div class="security-feature">
              <span class="security-icon">💼</span>
              <div>
                <strong>Insurance-Friendly</strong>
                <p>Documented security upgrade that may qualify for premium discounts</p>
              </div>
            </div>
          </div>
        </div>
        <div class="split-image reveal-right">
          <img src="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163225_ef3d64e4-534f-42b3-bc9b-af78ddffac20.png" alt="Security window film protection" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery: 5 Images (full-width, white bg) -->
  <section class="gallery-section">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="eyebrow eyebrow--dark">Our Work</span>
        <h2 class="section-heading section-heading--center">Window Film — Looks Like in Action</h2>
        <p class="section-sub">From downtown high-rises to suburban office parks — here's what we install.</p>
      </div>
      <div class="gallery-grid">
        {galleryImages.map((img, i) => (
          <div class="gallery-item reveal-up" style={`--delay: ${i * 80}ms`}>
            <img src={img.src} alt={img.label} loading="lazy" />
            <div class="gallery-label">{img.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats Bar (sage green bg) -->
  <section class="stats-bar">
    <div class="container">
      <div class="stats-row">
        <div class="stat-item reveal-up">
          <span class="stat-num">16+</span>
          <span class="stat-label">Years in Philadelphia</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item reveal-up" style="--delay: 100ms">
          <span class="stat-num">500+</span>
          <span class="stat-label">Commercial Projects</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item reveal-up" style="--delay: 200ms">
          <span class="stat-num">99%</span>
          <span class="stat-label">UV Rays Blocked</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item reveal-up" style="--delay: 300ms">
          <span class="stat-num">30%</span>
          <span class="stat-label">Avg. Energy Savings</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Process: 3 steps (light bg) -->
  <section class="process-section">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="eyebrow eyebrow--dark">How It Works</span>
        <h2 class="section-heading section-heading--center">3 Simple Steps to a Better Office</h2>
      </div>
      <div class="process-steps">
        <div class="process-step reveal-up" style="--delay: 0ms">
          <div class="step-num">01</div>
          <div class="step-body">
            <h3>Free Consultation & Thermal Analysis</h3>
            <p>We visit your office and use thermal imaging to identify exactly where heat enters. You receive a detailed proposal within 24 hours with the optimal film for your building, orientation, and budget. No obligation.</p>
          </div>
        </div>
        <div class="process-step reveal-up" style="--delay: 100ms">
          <div class="step-num">02</div>
          <div class="step-body">
            <h3>Professional Installation in 1–3 Days</h3>
            <p>Our factory-trained installers work around your business hours. We install in phases across multiple floors if needed, with no disruption to your team. We leave the building spotless.</p>
          </div>
        </div>
        <div class="process-step reveal-up" style="--delay: 200ms">
          <div class="step-num">03</div>
          <div class="step-body">
            <h3>Inspection & Long-Term Warranty</h3>
            <p>We walk the space with you before considering the job done. Every installation is backed by our labor warranty and the manufacturer's material warranty — typically 10–15 years on commercial films.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials (dark bg) -->
  <section class="testimonials-section">
    <div class="container">
      <div class="section-header reveal-up">
        <span class="eyebrow eyebrow--green">Client Stories</span>
        <h2 class="section-heading section-heading--center section-heading--white">Real Results from Real Businesses</h2>
      </div>
      <div class="testimonials-grid">
        <div class="testimonial-card reveal-up" style="--delay: 0ms">
          <div class="quote-mark">"</div>
          <p>Our conference room was unusable in the afternoon — direct west sun turned it into a solar oven. After the film was installed, it's comfortable all day. The difference was immediate and dramatic. Worth every dollar.</p>
          <div class="testimonial-author">
            <strong>David R.</strong>
            <span>Managing Partner, Rittenhouse Law Group</span>
          </div>
        </div>
        <div class="testimonial-card reveal-up" style="--delay: 100ms">
          <div class="quote-mark">"</div>
          <p>We had people literally wearing sunglasses at their desks at 3pm. The glare was that bad. Window film fixed it completely. No more closed blinds, no more fights over which desk is 'the bad desk.' Best office upgrade we've done in years.</p>
          <div class="testimonial-author">
            <strong>Sarah M.</strong>
            <span>Operations Director, Launchpad Tech, Fishtown</span>
          </div>
        </div>
        <div class="testimonial-card reveal-up" style="--delay: 200ms">
          <div class="quote-mark">"</div>
          <p>As a building owner, I'm always looking for cheap ways to improve tenant satisfaction. Window film in two of my buildings reduced vacancy turnover measurably and the energy savings are real and documented. The team was professional and fast.</p>
          <div class="testimonial-author">
            <strong>Michael T.</strong>
            <span>Property Owner, MT Commercial Real Estate</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ (white bg) -->
  <section class="faq-section">
    <div class="container">
      <div class="faq-layout">
        <div class="faq-header reveal-left">
          <span class="eyebrow eyebrow--dark">Questions</span>
          <h2 class="section-heading">Frequently Asked Questions</h2>
          <p>Honest answers from people who've been doing this in Philadelphia for over 16 years.</p>
          <a href="/contact/" class="btn btn--primary">Talk to a Specialist</a>
        </div>
        <div class="faq-list reveal-right">
          {faqItems.map((item, i) => (
            <div class="faq-item" data-faq>
              <button class="faq-question" aria-expanded="false">
                <span>{item.question}</span>
                <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA (brand dark) -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-inner reveal-up">
        <h2>Ready to transform your office?</h2>
        <p>Get a free consultation and thermal analysis. No obligation, no pressure — just honest advice.</p>
        <div class="cta-buttons">
          <a href="/contact/" class="btn btn--primary btn--large">Get a Free Quote</a>
          <a href="tel:+121****1234" class="btn btn--outline btn--large">Call (215) 555-1234</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Variables ─────────────────────────────────────────────── */
  :root {
    --brand: #272E32;
    --green: #81AB4C;
    --green-dark: #6a9439;
    --off-white: #F7F6F3;
    --sage: #EFF3EC;
    --white: #ffffff;
    --text: #272E32;
    --text-muted: #6b7280;
    --red: #dc2626;
  }

  /* ─── Base ───────────────────────────────────────────────────── */
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 5%;
  }
  .eyebrow {
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 12px;
  }
  .eyebrow--green { color: var(--green); }
  .eyebrow--dark { color: var(--green); }
  .section-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 600;
    color: var(--brand);
    line-height: 1.15;
    margin: 0 0 20px;
  }
  .section-heading--white { color: #ffffff; }
  .section-heading--center { text-align: center; }

  /* ─── Buttons ────────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.22s ease;
  }
  .btn--primary {
    background: var(--green);
    color: #ffffff;
    border-color: var(--green);
  }
  .btn--primary:hover {
    background: var(--green-dark);
    border-color: var(--green-dark);
    transform: translateY(-2px);
  }
  .btn--outline {
    background: transparent;
    color: rgba(255,255,255,0.75);
    border-color: rgba(255,255,255,0.3);
  }
  .btn--outline:hover {
    color: #ffffff;
    border-color: rgba(255,255,255,0.7);
  }
  .btn--large { padding: 15px 36px; font-size: 16px; }

  /* ─── Trust Bar ─────────────────────────────────────────────── */
  .trust-bar {
    background: var(--off-white);
    padding: 32px 0;
    border-bottom: 1px solid #e5e7eb;
  }
  .trust-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9ca3af;
    text-align: center;
    margin: 0 0 20px;
  }

  /* ─── Split Sections ─────────────────────────────────────────── */
  .split-section {
    padding: 96px 0;
    background: var(--white);
  }
  .split-section--dark { background: var(--brand); }
  .split-section--sage { background: var(--sage); }

  .split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }
  .split-grid--image-left .split-image { order: -1; }

  .split-text p {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.85;
    color: #6b7280;
    margin: 0 0 16px;
  }
  .split-section--dark .split-text p { color: rgba(255,255,255,0.6); }
  .split-section--dark .split-text .eyebrow { color: var(--green); }
  .split-section--dark .split-text .section-heading { color: #ffffff; }

  .split-image {
    position: relative;
    border-radius: 20px;
    overflow: visible;
  }
  .split-image img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: 20px;
    display: block;
    box-shadow: 0 20px 60px rgba(0,0,0,0.12);
  }

  .image-stat-badge {
    position: absolute;
    bottom: -16px;
    right: -16px;
    background: var(--green);
    color: #ffffff;
    border-radius: 16px;
    padding: 16px 24px;
    text-align: center;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }
  .image-stat-badge strong {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
  }
  .image-stat-badge span {
    font-size: 12px;
    font-weight: 600;
    opacity: 0.9;
    margin-top: 2px;
    display: block;
  }

  /* ─── Problem Tags ───────────────────────────────────────────── */
  .problem-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .tag {
    padding: 8px 18px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
  }
  .tag--red {
    background: rgba(220, 38, 38, 0.12);
    color: #fca5a5;
    border: 1px solid rgba(220, 38, 38, 0.25);
  }

  /* ─── Check List ─────────────────────────────────────────────── */
  .check-list {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
  }
  .check-list li {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    color: #4b5563;
    padding: 8px 0;
    border-bottom: 1px solid #f0f0f0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .check-list li::before {
    content: '✓';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: rgba(129, 171, 76, 0.12);
    border-radius: 50%;
    font-size: 12px;
    color: var(--green);
    flex-shrink: 0;
    font-weight: 700;
  }

  /* ─── Energy Stats ───────────────────────────────────────────── */
