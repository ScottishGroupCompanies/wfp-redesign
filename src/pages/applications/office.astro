---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import FlipWords from '../../components/FlipWords.astro';

const title = 'Office Window Film Philadelphia | Commercial Window Tinting';
const description = 'Office window film in Philadelphia cuts cooling costs 30%, eliminates screen glare, and blocks 99% of UV. 3M authorized commercial installer. Free estimate.';

const faqItems = [
  { question: 'How long does office window film installation take?', answer: 'Most commercial office installations complete in 1–3 days depending on floor count and window area. We work around your business hours — early mornings, evenings, or weekends — so your team stays productive throughout.' },
  { question: 'Will window film make our office too dark?', answer: 'Not with the right film. Spectrally selective films like 3M Prestige 70 let in 70% of visible light while still rejecting 50% of solar heat. We assess your glass orientation and present samples before you commit to anything.' },
  { question: 'Can window film help with conference room privacy?', answer: 'Yes. Frosted and one-way mirror films give glass-walled conference rooms daytime privacy without sacrificing the open feel. 3M FASARA offers 100+ decorative patterns including frosted, gradient, and custom-branded options.' },
  { question: 'Does window film interfere with Wi-Fi or cellular signals?', answer: 'Metal-free films — like the 3M Prestige series — have zero signal interference. If you have metallic film currently installed on other floors, we can assess and recommend non-metallic alternatives.' },
  { question: 'Can window film qualify our building for LEED credits?', answer: 'Yes. Window film can contribute to LEED v4 Energy and Atmosphere credits by improving the building\'s modeled energy performance. We provide documentation packages including SHGC, VLT, and U-factor data for your project team.' },
  { question: 'Who pays — the tenant or the building owner?', answer: 'Both scenarios are common. Tenants often fund it for comfort and productivity. Building owners fund it to improve HVAC efficiency, reduce vacancy turnover, and qualify for green certifications. We work with property managers on multi-floor proposals.' },
  { question: 'Does window film damage existing glass?', answer: 'No. When professionally installed on compatible glass types, window film will not damage your glass. We assess glass type, age, and coating before recommending a film — older IGUs and tinted glass require careful selection.' },
  { question: 'What is the ROI on commercial window film?', answer: 'Typical payback is 3–5 years through reduced cooling costs alone. Factor in reduced HVAC wear, lower vacancy turnover, and potential insurance credits for security film, and the full ROI is often faster.' },
  { question: 'Do you install anti-graffiti film for ground-floor offices?', answer: 'Yes. 3M Anti-Graffiti film protects lobby glass, storefronts, and elevators from etching and spray paint. It\'s sacrificial — when vandalized, only the film is replaced, not the glass. Particularly useful in Center City and high foot-traffic areas.' },
  { question: 'What warranty covers commercial window film?', answer: 'Manufacturer warranties for commercial film typically run 10–15 years covering delamination, bubbling, and color shift. Our labor is separately warranted. We provide written documentation at project close.' },
  { question: 'How do I choose the right window film for my office?', answer: 'Start with your biggest pain point. If heat and energy costs are the priority, a spectrally selective solar control film like 3M Prestige 70 or Vista VS70 gives you high heat rejection without darkening the space. If glare on screens is the issue, a lower VLT film like LLumar R20 cuts more light. For privacy in conference rooms or reception areas, frosted or one-way mirror films are the right fit. Security film is its own category — it holds glass together on impact. During your consultation, we assess your building\'s orientation, glass type, and HVAC situation and recommend the best option for your specific floors.' },
  { question: 'How do you handle multi-floor or multi-building projects?', answer: 'We have the crew capacity for large commercial projects. For multi-floor buildings we typically phase the installation floor by floor, working around occupied tenant spaces. Multi-building portfolios receive a single point of contact and consistent film specification across all properties. Contact us for a portfolio pricing consultation.' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.windowfilmphiladelphia.net/applications/office/"
  serviceName="Office Window Film Philadelphia"
  serviceDesc="Professional commercial window film installation for Philadelphia offices — solar control, privacy, security, and decorative film. Energy savings, glare elimination, and UV protection."
  serviceUrl="https://www.windowfilmphiladelphia.net/applications/office/"
  faqItems={faqItems}
>

  <!-- ══ SEO: BREADCRUMB + WEBPAGE/SPEAKABLE + ITEMLIST SCHEMA ══ -->
  <script type="application/ld+json">{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": "https://www.windowfilmphiladelphia.net/applications/office/#breadcrumb",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Applications", "item": "https://www.windowfilmphiladelphia.net/applications/" },
      { "@type": "ListItem", "position": 3, "name": "Office Window Film Philadelphia", "item": "https://www.windowfilmphiladelphia.net/applications/office/" }
    ]
  })}</script>

  <script type="application/ld+json">{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.windowfilmphiladelphia.net/applications/office/#webpage",
    "url": "https://www.windowfilmphiladelphia.net/applications/office/",
    "name": "Office Window Film Philadelphia | Commercial Window Tinting",
    "description": "Office window film in Philadelphia — cut cooling costs 30%, eliminate screen glare, block 99% of UV, and add security. Professional commercial installation. Free estimate.",
    "dateModified": "2026-07-07",
    "isPartOf": { "@type": "WebSite", "@id": "https://www.windowfilmphiladelphia.net/#website", "url": "https://www.windowfilmphiladelphia.net/", "name": "Window Film Philadelphia" },
    "breadcrumb": { "@id": "https://www.windowfilmphiladelphia.net/applications/office/#breadcrumb" },
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".of-hero__subtitle", ".of-whatis__body", ".of-geo", ".swt-faq__a"] },
    "about": { "@type": "Service", "@id": "https://www.windowfilmphiladelphia.net/applications/office/#service" }
  })}</script>

  <script type="application/ld+json">{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Office Window Film Types Available in Philadelphia",
    "description": "Professional office window film options for Philadelphia commercial buildings, installed by certified technicians. Serving Center City, University City, King of Prussia, and the Greater Philadelphia metro.",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Solar Control Window Film", "description": "Spectrally selective film that rejects up to 50% of solar heat while maintaining 70% visible light transmission — eliminating hot spots and cutting cooling costs without darkening Philadelphia office spaces." },
      { "@type": "ListItem", "position": 2, "name": "Privacy & Decorative Window Film", "description": "Frosted, one-way mirror, and custom-branded film for Philadelphia conference rooms, reception areas, and glass partitions. 3M FASARA offers 100+ patterns with daytime privacy and no light loss." },
      { "@type": "ListItem", "position": 3, "name": "Security Window Film", "description": "3M ScotchShield Ultra safety film holds glass together on impact, slowing forced entry and reducing injury risk. Rated to ANSI Z97.1 and ASTM F1642 — ideal for ground-floor Philadelphia offices and lobbies." },
      { "@type": "ListItem", "position": 4, "name": "Anti-Graffiti Window Film", "description": "Clear sacrificial film for Philadelphia office lobbies, elevator interiors, and storefronts. When scratched or etched, only the film is replaced — not the glass — at a fraction of replacement cost." }
    ]
  })}</script>

  <!-- ══ HERO ══ -->
  <section class="of-hero">
    <div
      class="of-hero__bg"
      role="img"
      aria-label="Philadelphia office building interior with professional window film installed — diffused sunlight, clear city views, no screen glare"
      style="background-image: url('/images/office-window-film-philadelphia-hero.jpg')"
      role="img"
      aria-label="Philadelphia commercial office with floor-to-ceiling windows and professional window film installed"
    ></div>
    <div class="of-hero__overlay"></div>

    <div class="of-hero__content">

      <div class="of-hero__eyebrow">
        <span>Office Window Film</span>
        <span class="of-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Philadelphia, PA</span>
        <span class="of-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Since 2008</span>
      </div>

      <h1 class="of-hero__title">Office Window Film<br class="of-hero__br"/> for Philadelphia</h1>

      <p class="of-hero__animated-line">
        Stop losing productivity to
        <FlipWords
          words={["screen glare", "solar heat", "UV exposure", "hot spots", "privacy issues"]}
          staticText=""
          class="of-hero__flip"
        />.
      </p>

      <p class="of-hero__subtitle">
        Window film for Philadelphia offices blocks 99% of UV, cuts cooling costs by up to 30%, and eliminates screen glare — without replacing a single window.
      </p>

      <div class="of-hero__cta">
        <a href="/contact/" class="of-hero__btn-primary">Get a Free Commercial Estimate</a>
        <a href="tel:2673947980" class="of-hero__btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z" fill="currentColor"/></svg>
          Call (267) 394-7980
        </a>
      </div>

      <div class="of-hero__stats-panel" aria-label="Key statistics">
        <div class="of-hero__stats-inner">
          <div class="of-hero__stat">
            <span class="of-hero__stat-number">99%</span>
            <span class="of-hero__stat-label">UV Rays Blocked</span>
          </div>
          <div class="of-hero__stat-divider" aria-hidden="true"></div>
          <div class="of-hero__stat">
            <span class="of-hero__stat-number">30%</span>
            <span class="of-hero__stat-label">Avg. Cooling Savings</span>
          </div>
          <div class="of-hero__stat-divider" aria-hidden="true"></div>
          <div class="of-hero__stat">
            <span class="of-hero__stat-number">500+</span>
            <span class="of-hero__stat-label">Commercial Projects</span>
          </div>
          <div class="of-hero__stat-divider" aria-hidden="true"></div>
          <div class="of-hero__stat">
            <span class="of-hero__stat-number">2008</span>
            <span class="of-hero__stat-label">Serving Philadelphia Since</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <div class="swt-body">

    <!-- ══ TRUST BAR ══ -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by 500+ Philadelphia businesses — law firms, tech companies, property managers, and building owners</p>
        <BrandLogos />
      </div>
    </section>

    <!-- ══ WHAT IS OFFICE WINDOW FILM ══ -->
    <section class="of-whatis">
      <div class="of-whatis__container">
        <div class="of-whatis__content">
          <span class="of-whatis__eyebrow">What Is Office Window Film?</span>
          <h2 class="of-whatis__title">A Smarter Office.<br/>Same Windows.</h2>
          <p class="of-whatis__body">Office window film in Philadelphia is a professionally applied polyester film that bonds directly to your existing glass — rejecting solar heat, blocking 99% of UV, eliminating screen glare, and adding privacy or security. No window replacement. No renovation. No downtime.</p>
          <p class="of-whatis__body">Films are rated by the <a href="https://www.nfrc.org/for-homeowners/window-film/" target="_blank" rel="noopener noreferrer">National Fenestration Rating Council (NFRC)</a> for solar heat gain coefficient (SHGC), UV rejection, and visible light transmission. For Philadelphia commercial buildings in IECC Climate Zone 4A, professional-grade window film is one of the fastest-returning energy upgrades available — typically paying back in 3–5 years.</p>
          <div class="of-whatis__stats">
            <div class="of-whatis__stat"><strong>3–5 yrs</strong><span>Typical commercial payback</span></div>
            <div class="of-whatis__stat-div"></div>
            <div class="of-whatis__stat"><strong>10–15 yrs</strong><span>Manufacturer warranty</span></div>
            <div class="of-whatis__stat-div"></div>
            <div class="of-whatis__stat"><strong>Zero</strong><span>Window replacement needed</span></div>
          </div>
        </div>
        <div class="of-whatis__image-wrap">
          <img
            src="/images/office-window-film-philadelphia-whatis.jpg"
            alt="Modern Philadelphia office interior with professionally installed window film — diffused daylight, no glare on screens"
            class="of-whatis__image"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- ══ THE PROBLEM ══ -->
    <section class="of-why" id="problem">
      <div class="of-why__container">

        <!-- Left: image + floating stat card -->
        <div class="of-why__image-wrap">
          <img
            src="/images/office-window-film-philadelphia-problem.jpg"
            alt="Philadelphia office worker struggling with harsh afternoon glare through untreated windows — the problem office window film solves"
            class="of-why__image"
            loading="lazy"
          />
          <div class="of-why__stat-card">
            <div class="of-why__stat-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>33% of cooling costs = solar heat gain</span>
            </div>
            <div class="of-why__stat-divider"></div>
            <div class="of-why__stat-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Film costs 1/10th of window replacement</span>
            </div>
          </div>
        </div>

        <!-- Right: content -->
        <div class="of-why__content">
          <div class="of-why__eyebrow">Why It Matters</div>
          <h2 class="of-why__headline">Philadelphia Offices Are Losing the Battle Against Their Windows</h2>
          <p class="of-why__intro">Large glass facades look great in architectural renderings. In practice, they create a daily productivity tax — west-facing offices that become solar ovens by 2pm, employees squinting at screens, HVAC systems running at full capacity, and conference rooms no one wants to use after lunch.</p>
          <ul class="of-why__bullets">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Untreated glass passes 80%+ of solar heat — every south and west-facing window fights your HVAC all afternoon.
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              UV-A and UV-B rays pass through standard glass, fading carpets, artwork, and branded displays — and raise health risks for window-adjacent employees.
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Glass conference rooms and ground-floor offices offer zero privacy — sensitive client meetings and employee workspaces are fully exposed.
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Standard glass shatters on impact — a break-in or storm event creates immediate injury risk for anyone near the window.
            </li>
          </ul>
          <div class="of-why__climate-facts">
            <div class="of-why__climate-item">
              <span class="of-why__climate-num">91°F</span>
              <span class="of-why__climate-label">ASHRAE summer design temp, Philadelphia (Zone 4A)</span>
            </div>
            <div class="of-why__climate-item">
              <span class="of-why__climate-num">33%</span>
              <span class="of-why__climate-label">Of commercial cooling costs from solar heat gain (3M)</span>
            </div>
            <div class="of-why__climate-item">
              <span class="of-why__climate-num">16.26¢</span>
              <span class="of-why__climate-label">Average per kWh electricity rate, Philadelphia (2026)</span>
            </div>
          </div>
          <a href="/contact/" class="of-why__cta">
            Get a free commercial assessment
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
          </a>
        </div>

      </div>
    </section>

    <!-- ══ BENTO BAND ══ -->
    <section class="of-bento">
      <div class="of-bento__header">
        <h2 class="of-bento__title">Philadelphia Offices Have the Same Complaints. Window Film Fixes All of Them.</h2>
        <p class="of-bento__sub">One installation. Multiple results. No renovation required.</p>
      </div>
      <div class="of-bento__compact">

        <div class="of-bento-item">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <circle cx="14" cy="14" r="9" stroke="#7CB342" stroke-width="1.5"/>
            <path d="M14 7v2M14 19v2M7 14h2M19 14h2" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="14" cy="14" r="3" fill="#7CB342" fill-opacity="0.15" stroke="#7CB342" stroke-width="1"/>
          </svg>
          <div>
            <h3 class="of-bento-item__title">Cut Cooling Costs 30%</h3>
            <p class="of-bento-item__text">Solar control film rejects up to 78% of solar heat before it enters the building — reducing HVAC load and your energy bill starting the first summer.</p>
          </div>
        </div>

        <div class="of-bento-item">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <rect x="5" y="5" width="18" height="14" rx="2" stroke="#7CB342" stroke-width="1.5"/>
            <path d="M9 23h10M14 19v4" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M8 11h12M8 14h8" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
          </svg>
          <div>
            <h3 class="of-bento-item__title">Eliminate Screen Glare</h3>
            <p class="of-bento-item__text">Glare-control film selectively filters the wavelengths that cause eye strain on monitors — without closing blinds or darkening the space.</p>
          </div>
        </div>

        <div class="of-bento-item">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <path d="M14 3L5 8v7c0 5 4 9 9 10 5-1 9-5 9-10V8L14 3z" stroke="#7CB342" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M10 14l3 3 5-5" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div>
            <h3 class="of-bento-item__title">Add Privacy & Security</h3>
            <p class="of-bento-item__text">Frosted, one-way mirror, and security films protect conference rooms from visual exposure and hold shattered glass in the frame on impact.</p>
          </div>
        </div>

        <div class="of-bento-item">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <path d="M14 4c-1.5 4-5 6-9 6 0 7 4 12 9 14 5-2 9-7 9-14-4 0-7.5-2-9-6z" stroke="#7CB342" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M10 14l3 3 5-6" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
          </svg>
          <div>
            <h3 class="of-bento-item__title">Block 99% of UV Rays</h3>
            <p class="of-bento-item__text">UV film protects employees near windows from cumulative UV exposure and stops the fading of carpet, artwork, and branded interior elements.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- ══ OFFICE SPACE TYPE GRID ══ -->
    <section class="of-spaces">
      <div class="of-spaces__container">

        <div class="of-spaces__header">
          <div class="of-spaces__eyebrow">Where We Install</div>
          <h2 class="of-spaces__headline">The Right Film for Every Corner of Your Office</h2>
          <p class="of-spaces__sub">Different spaces have different needs. Here's how we approach each area of a Philadelphia commercial building.</p>
        </div>

        <div class="of-spaces__grid">

          <!-- Card 1: Conference Rooms — hero -->
          <div class="of-space-card of-space-card--hero">
            <div class="of-space-card__hero-icon">
              <svg width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true">
                <rect x="4" y="10" width="36" height="24" rx="2" stroke="#7CB342" stroke-width="1.5"/>
                <path d="M4 18h36M14 10v24M30 10v24" stroke="#7CB342" stroke-width="1.5" opacity="0.5"/>
                <circle cx="22" cy="22" r="3" fill="rgba(124,179,66,0.15)" stroke="#7CB342" stroke-width="1"/>
              </svg>
            </div>
            <h3 class="of-space-card__hero-title">Conference Rooms</h3>
            <p class="of-space-card__hero-text">Glass-walled conference rooms look great but expose every meeting to passersby. Frosted and one-way mirror films give you daytime privacy without losing the open feel — 3M FASARA offers 100+ patterns including gradients, etched textures, and custom branded designs.</p>
            <div class="of-space-card__pill">Privacy + Glare Control</div>
          </div>

          <!-- Card 2: Open Plan Floor — photo -->
          <div class="of-space-card of-space-card--photo">
            <img
              src="/images/office-open-plan-window-film.jpg"
              alt="Open plan Philadelphia office floor with solar control window film keeping employees comfortable at their desks"
              width="400" height="480"
              loading="lazy"
              class="of-space-card__img"
            />
            <div class="of-space-card__photo-overlay"></div>
            <div class="of-space-card__photo-content">
              <h3 class="of-space-card__photo-title">Open Plan Floors</h3>
              <p class="of-space-card__photo-text">Eliminate hot spots and screen glare across every workstation — no blinds required.</p>
            </div>
          </div>

          <!-- Card 3: Conference Room photo -->
          <div class="of-space-card of-space-card--photo">
            <img
              src="/images/office-conference-room-window-film.jpg"
              alt="Glass conference room with frosted privacy window film in a Philadelphia office building"
              width="400" height="480"
              loading="lazy"
              class="of-space-card__img"
            />
            <div class="of-space-card__photo-overlay"></div>
            <div class="of-space-card__photo-content">
              <h3 class="of-space-card__photo-title">Executive Offices</h3>
              <p class="of-space-card__photo-text">Premium spectrally selective film — maximum comfort and views, zero heat gain.</p>
            </div>
          </div>

          <!-- Card 4: Reception / Lobby — dark accent -->
          <div class="of-space-card of-space-card--dark">
            <div class="of-space-card__accent-line" aria-hidden="true"></div>
            <div class="of-space-card__icon-row">
              <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <path d="M5 28V12l12-7 12 7v16" stroke="#7CB342" stroke-width="1.5" stroke-linejoin="round"/>
                <rect x="12" y="18" width="10" height="10" rx="1" stroke="#7CB342" stroke-width="1.5"/>
                <path d="M17 18v10" stroke="#7CB342" stroke-width="1.5" opacity="0.4"/>
              </svg>
            </div>
            <h3 class="of-space-card__dark-title">Reception &amp; Lobby</h3>
            <p class="of-space-card__dark-text">Branded decorative films turn your reception glass into a design statement. Anti-graffiti film protects lobby windows and elevator interiors from etching and vandalism.</p>
            <div class="of-space-card__micro-pill">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l3 6.5L22 9l-5 5 1.18 7L12 18l-6.18 3L7 14 2 9l7-.5L12 2z" stroke="#7CB342" stroke-width="2" stroke-linejoin="round"/></svg>
