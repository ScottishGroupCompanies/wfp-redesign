---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Office Window Film in Philadelphia | Privacy, Glare Control & Energy Savings';
const description = 'Window film for Philadelphia offices: reduce glare on screens, block UV rays, improve employee comfort, and enhance building security. Professional installation.';

const benefits = [
  {
    icon: '☀️',
    heading: 'Glare Control for Screens',
    body: 'Eliminate monitor glare and eye strain without blocking natural light. Your team stays focused and productive all day long.',
  },
  {
    icon: '⚡',
    heading: 'Energy Savings',
    body: 'Solar control films reduce cooling costs up to 30%, easing the load on HVAC and delivering ROI in 3–5 years.',
  },
  {
    icon: '🔒',
    heading: 'Privacy & Security',
    body: 'Frosted, decorative, and security films control sightlines in conference rooms and executive spaces — while reinforcing glass against break-ins.',
  },
  {
    icon: '☂️',
    heading: 'UV Ray Blocking',
    body: 'Block over 99% of harmful UV rays to protect employees, furnishings, and merchandise from sun damage and fading.',
  },
];

const whyParagraphs = [
  'Philadelphia offices face constant challenges from screen glare, rising energy costs, and the need for privacy in meeting areas. Our certified installation team delivers solar control, security, and decorative film solutions that improve workplace comfort and deliver measurable results.',
  'From single-story office suites to multi-floor commercial buildings, we provide professional on-site installation with minimal disruption to your operations.',
];

const stats = [
  { value: '16+', label: 'Years Experience' },
  { value: '500+', label: 'Projects Completed' },
  { value: '98%', label: 'Client Satisfaction' },
];

const testimonials = [
  {
    quote: 'The glare reduction was immediate. Our team stopped complaining about eye strain within the first week. The film is completely invisible — you would never know it was there.',
    name: 'Marcus T.',
    role: 'Operations Director, Center City Philadelphia',
  },
  {
    quote: 'We cut our cooling costs by nearly 28% in the first summer. The ROI paid for the installation in under four years. Highly recommend for any Philly office building.',
    name: 'Sandra L.',
    role: 'Facilities Manager, Old City Commercial Property',
  },
  {
    quote: 'The decorative film in our conference rooms looks incredible — modern, professional, and our clients always comment on it. Installation was done in a single day with zero downtime.',
    name: 'James R.',
    role: 'Principal, Rittenhouse Financial Group',
  },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/applications/office/" serviceName="Office Window Film" serviceDesc="Office window film installation in Philadelphia. Energy savings, glare reduction, and privacy solutions for commercial office buildings." serviceUrl="https://www.windowfilmphiladelphia.net/applications/office/">

<InnerPageHero
  title="Office Window Film"
  desc="Privacy · Glare control · Energy savings"
  bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161444_92b264a0-f13c-47ca-93dd-af03bc5e5db9.png"
/>

<div class="ip-page-body">

  <!-- ══════════════════════════════════════
       BENEFITS SECTION
       ══════════════════════════════════════ -->
  <section class="o-benefits">
    <div class="o-benefits__hd">
      <span class="eyebrow">Benefits</span>
      <h2 class="o-benefits__title">Why offices choose window film</h2>
    </div>
    <div class="o-benefits__grid">
      {benefits.map((b) => (
        <div class="o-benefit-card fade-in">
          <div class="o-benefit-card__icon">
            <span>{b.icon}</span>
          </div>
          <h3 class="o-benefit-card__heading">{b.heading}</h3>
          <p class="o-benefit-card__body">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════
       WHY OFFICES SECTION
       ══════════════════════════════════════ -->
  <section class="o-why">
    <div class="o-why__inner">
      <div class="o-why__hd">
        <span class="eyebrow">Why Office Window Film</span>
        <h2 class="o-why__title">Built for how Philadelphia offices really work</h2>
      </div>
      <div class="o-why__copy">
        {whyParagraphs.map((p) => (
          <p class="o-why__para">{p}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       STATISTICS ROW
       ══════════════════════════════════════ -->
  <section class="o-stats">
    {stats.map((s) => (
      <div class="o-stat fade-in">
        <span class="o-stat__value">{s.value}</span>
        <span class="o-stat__label">{s.label}</span>
      </div>
    ))}
  </section>

  <!-- ══════════════════════════════════════
       SOCIAL PROOF / TESTIMONIALS
       ══════════════════════════════════════ -->
  <section class="o-testimonials">
    <div class="o-testimonials__hd">
      <span class="eyebrow">Client Testimonials</span>
      <h2 class="o-testimonials__title">What Philadelphia offices are saying</h2>
    </div>
    <div class="o-testimonials__grid">
      {testimonials.map((t) => (
        <div class="o-testimonial fade-in">
          <p class="o-testimonial__quote">"{t.quote}"</p>
          <div class="o-testimonial__author">
            <span class="o-testimonial__name">{t.name}</span>
            <span class="o-testimonial__role">{t.role}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════
       BRAND LOGOS
       ══════════════════════════════════════ -->
  <BrandLogos />

  <!-- ══════════════════════════════════════
       CTA SECTION
       ══════════════════════════════════════ -->
  <div class="o-cta fade-in">
    <h2 class="o-cta__heading">Ready to upgrade your office?</h2>
    <p class="o-cta__sub">Get a free consultation and see how window film can transform your Philadelphia workspace.</p>
    <div class="o-cta__btns">
      <a href="/contact/" class="o-btn o-btn--green">Get a Free Quote</a>
      <a href="tel:+12673947980" class="o-btn o-btn--outline">Call (267) 394-7980</a>
    </div>
  </div>

</div><!-- end ip-page-body -->

</BaseLayout>

<style>
/* ── PAGE BODY WRAPPER ── */
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* ── EYEBROW ── */
.eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

/* ── BUTTONS ── */
.o-btn {
  display: inline-block;
  padding: 14px 28px;
  border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 500;
  text-decoration: none;
  transition: all 0.2s;
  border: 2px solid transparent;
  white-space: nowrap;
}
.o-btn--green {
  background: var(--green, #81AB4C);
  color: #ffffff;
  border-color: var(--green, #81AB4C);
}
.o-btn--green:hover {
  background: #6e9640;
  border-color: #6e9640;
  transform: translateY(-2px);
  color: #ffffff;
}
.o-btn--outline {
  background: transparent;
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.5);
}
.o-btn--outline:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: #ffffff;
  transform: translateY(-2px);
  color: #ffffff;
}

/* ── BENEFITS SECTION ── */
.o-benefits {
  padding: 100px 10% 80px;
}
.o-benefits__hd {
  margin-bottom: 56px;
}
.o-benefits__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
  max-width: 560px;
}
.o-benefits__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.o-benefit-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 36px 28px 32px;
  box-shadow: 0 4px 24px rgba(39, 46, 50, 0.08);
  transition: transform 0.2s, box-shadow 0.2s;
}
.o-benefit-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(39, 46, 50, 0.14);
}
.o-benefit-card__icon {
  width: 48px;
  height: 48px;
  background: var(--green-light, #eef4e4);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  font-size: 22px;
  line-height: 1;
}
.o-benefit-card__heading {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 20px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 12px;
  line-height: 1.3;
}
.o-benefit-card__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.7;
  margin: 0;
}

/* ── WHY OFFICES SECTION ── */
.o-why {
  padding: 80px 10%;
  background: var(--off-white, #F7F6F3);
}
.o-why__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: start;
}
.o-why__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
  max-width: 520px;
}
.o-why__para {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.8;
  margin: 0 0 20px;
}
.o-why__para:last-child {
  margin-bottom: 0;
}

/* ── STATISTICS ROW ── */
.o-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  background: var(--brand, #272E32);
}
.o-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64px 40px;
  border-right: 1px solid rgba(255, 255, 255, 0.1);
  text-align: center;
}
.o-stat:last-child {
  border-right: none;
}
.o-stat__value {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(48px, 5vw, 72px);
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
  margin-bottom: 12px;
}
.o-stat__label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.6);
}

/* ── TESTIMONIALS SECTION ── */
.o-testimonials {
  padding: 100px 10%;
  background: #ffffff;
}
.o-testimonials__hd {
  margin-bottom: 56px;
}
.o-testimonials__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
  max-width: 560px;
}
.o-testimonials__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}
.o-testimonial {
  background: var(--off-white, #F7F6F3);
  border-radius: 18px;
  padding: 36px 32px 32px;
}
.o-testimonial__quote {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.75;
  margin: 0 0 24px;
  font-style: italic;
}
.o-testimonial__author {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.o-testimonial__name {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
}
.o-testimonial__role {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  color: var(--text-light, #888888);
}

/* ── CTA SECTION ── */
.o-cta {
  background: var(--brand, #272E32);
  border-radius: 40px;
  padding: 72px 60px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 20px;
  margin: 0 5% 0;
}
.o-cta__heading {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 44px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  margin: 0;
}
.o-cta__sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: rgba(255, 255, 255, 0.65);
  margin: 0;
  max-width: 480px;
}
.o-cta__btns {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 8px;
}

/* ── FADE IN ANIMATION ── */
.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .o-benefits__grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .o-why__inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .o-testimonials__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 768px) {
  .o-benefits {
    padding: 60px 5%;
  }
  .o-benefits__grid {
    grid-template-columns: 1fr;
  }
  .o-why {
    padding: 60px 5%;
  }
  .o-stat {
    padding: 48px 24px;
  }
  .o-testimonials {
    padding: 60px 5%;
  }
  .o-testimonials__grid {
    grid-template-columns: 1fr;
  }
  .o-cta {
    padding: 48px 28px;
    margin: 0 3% 0;
  }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>