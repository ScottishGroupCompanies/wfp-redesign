  .of-pullquote { border-left: 4px solid #7CB342; margin: 0 0 24px; padding: 16px 24px; background: #F5F9F0; border-radius: 0 8px 8px 0; }
  .of-pullquote__text { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-style: italic; color: #14201A; line-height: 1.7; margin: 0 0 10px; }
  .of-pullquote__cite { font-family: 'Inter', sans-serif; font-size: 0.8rem; color: #4A5C48; font-style: normal; display: block; }
  .of-pullquote__cite a { color: #7CB342; text-decoration: underline; text-underline-offset: 3px; font-weight: 500; }
  .of-pullquote__cite a:hover { color: #2E6B30; }
  .of-row__body a { color: #7CB342; text-decoration: underline; text-decoration-color: #7CB342; text-underline-offset: 3px; font-weight: 500; transition: color 0.2s ease; }
  .of-row__body a:hover { color: #2E6B30; text-decoration-color: #2E6B30; }
  .of-row__bullets {
