---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Arena & Stadium Window Film in Philadelphia | UV, Energy & Security';
const description = 'Window film for Philadelphia arenas and stadiums: sun glare reduction in seating and suites, UV protection for fans and staff, energy savings on cooling, and security film for entry points.';
const serviceName = 'Arena & Stadium Window Film Installation';
const serviceDesc = 'Professional window film installation for Philadelphia arenas and stadiums — glare control, UV protection, energy savings, and security film for fan safety.';
const serviceUrl = 'https://www.windowfilmphiladelphia.com/applications/arenas-stadiums';

const galleryImages = [
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175508_58c8b558-1866-4e7c-adb5-70b20a8f5f20.png', label: 'Arena Interior Glare Control' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175508_125c8820-5117-4b69-86ad-cb9637ff8192.png', label: 'VIP Suite UV Protection' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175509_7e87544a-6f57-4414-b36d-c76e07d8c9b0.png', label: 'Arena Exterior Energy Savings' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175511_07ca3cd2-9f62-41b1-9878-01158b219153.png', label: 'Security Film at Entry Points' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175730_9894c8e1-e71c-462a-8a2d-5db3d86bc710.png', label: 'Concession Area Comfort' },
];

const newImages = {
  arenaInterior: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175508_58c8b558-1866-4e7c-adb5-70b20a8f5f20.png',
  vipSuite: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175508_125c8820-5117-4b69-86ad-cb9637ff8192.png',
  arenaExterior: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175509_7e87544a-6f57-4414-b36d-c76e07d8c9b0.png',
  securityEntry: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175511_07ca3cd2-9f62-41b1-9878-01158b219153.png',
  concession: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175730_9894c8e1-e71c-462a-8a2d-5db3d86bc710.png',
};

const faqItems = [
  { question: 'Can window film handle the unique glass shapes in modern arenas?', answer: 'Yes. Modern arenas feature extensive curved and angled glass — our engineering team performs a full survey of each venue\'s glass geometry before specifying the right film and adhesive system. We\'ve worked with dome roofs, curved facade panels, and retractable roof sections across Philadelphia venues.' },
  { question: 'How does film perform during extreme temperature games?', answer: 'Philadelphia summers push indoor temperatures in non-climate-controlled venues to dangerous levels. Our heat-rejecting films are specifically rated for thermal stress and can reduce interior temperatures by up to 15°F in direct sun areas. Security films also perform reliably through freeze-thaw cycles in winter.' },
  { question: 'Does security film meet venue safety codes?', answer: 'Our security films meet or exceed ASTM E1886/1996 impact standards and are accepted by venue insurers and municipal building departments throughout Pennsylvania and New Jersey. We provide full documentation package including material specs, test reports, and post-installation certification for insurance and regulatory compliance.' },
  { question: 'Can film be installed during the season without closing sections?', answer: 'Absolutely. One of the main advantages of window film over glass replacement is that it can be installed in occupied spaces with no downtime. We schedule work around event calendars, perform phased installation in non-game areas, and use low-odor products that allow immediate re-occupancy. Most arena installations are completed in 2–4 night shifts.' },
  { question: 'What is the maintenance schedule for arena window film?', answer: 'Window film requires minimal maintenance — just standard glass cleaning with non-abrasive solutions. Unlike retrofitted glass systems, there are no mechanical parts, seals, or frames to maintain. Our commercial installations come with a 10–15 year manufacturer warranty and we provide annual inspection service for large venue accounts.' },
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName={serviceName}
  serviceDesc={serviceDesc}
  serviceUrl={serviceUrl}
  faqItems={faqItems}
>
  <!-- HERO -->
  <section class="swt-hero">
    <div class="swt-hero__img">
      <img src={newImages.arenaInterior} alt="Philadelphia arena interior with window glare from direct sunlight" width="1440" height="700" />
      <div class="swt-hero__overlay"></div>
    </div>
    <div class="swt-hero__content">
      <span class="swt-badge">
        <svg width="8" height="8" viewBox="0 0 8 8" fill="none"><circle cx="4" cy="4" r="4" fill="#4E6B2A"/></svg>
        Venues & Entertainment
      </span>
      <h1 class="swt-hero__title">
        Arenas. Stadiums.<br/>
        <em>Fan Comfort.</em><br/>
        Gameday Ready.
      </h1>
      <p class="swt-hero__sub">Reduce sun glare in seating and suites, block 99% of UV rays for fans and staff, cut arena cooling costs, and secure entry points — installed around your event schedule.</p>
      <div class="swt-hero__ctas">
        <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Venue Assessment</a>
        <a href="#benefits" class="swt-btn swt-btn--ghost-light">See Benefits</a>
      </div>
    </div>
  </section>

  <div class="swt-body">

    <!-- TRUST BAR -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by Philadelphia venues and entertainment facilities</p>
        <BrandLogos />
      </div>
    </section>

    <!-- SECTION 1: THE PROBLEM — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="problem">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">The Challenge</span>
            <h2 class="swt-h2 swt-h2--light">Philadelphia Arenas Are Fighting Their Own Glass</h2>
            <p>Modern arenas are defined by glass — soaring atriums, press boxes with panoramic views, suite walls that feel open to the sky. But that glass becomes a liability on clear summer afternoons, turning east-facing seating into solar ovens and west-facing suites unbearable by the fourth quarter.</p>
            <p>UV radiation entering through untreated glass poses a documented health risk for fans and staff near windows. And in non-climate-controlled venues, every degree of solar heat gain means more strain on aging HVAC systems — or uncomfortable patrons voting with their feet.</p>
            <div class="swt-problem-tags">
              <span class="swt-tag swt-tag--red">Solar Glare in Seating</span>
              <span class="swt-tag swt-tag--red">UV Exposure Near Windows</span>
              <span class="swt-tag swt-tag--red">HVAC Strain</span>
              <span class="swt-tag swt-tag--red">Fan Comfort & Safety</span>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.arenaInterior} alt="Arena seating area with direct sun glare through glass" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: UV — white bg, image left, text right -->
    <section class="swt-split" id="uv">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.vipSuite} alt="VIP suite with window film protecting guests from UV exposure" loading="lazy" />
            <div class="swt-img-badge">
              <strong>99%</strong>
              <span>UV Blocked</span>
            </div>
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 01</span>
            <h2 class="swt-h2">Block 99% of Harmful UV Rays — Protect Fans, Staff, and Interiors</h2>
            <p>UV-A and UV-B radiation entering through arena glass creates real health exposure for fans seated near windows, suite holders, and staff working in press areas. Over repeated exposure events, this accumulates into meaningful skin cancer risk — particularly for employees who work hundreds of events per year near the same glass.</p>
            <p>Beyond health liability, UV is the primary driver of interior fading in VIP suites, concession areas, and lobby displays. Our films block up to 99% of UV transmission, protecting your brand assets, signage, and upholstery from irreversible UV degradation.</p>
            <ul class="swt-check-list">
              <li>Reduced UV exposure risk for window-proximate fans and staff</li>
              <li>Protected VIP suites, branding, and interior finishes from fading</li>
              <li>Reduced liability exposure for venue operators</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: ENERGY — alt cream bg, text left, image right -->
    <section class="swt-split swt-split--alt" id="energy">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 02</span>
            <h2 class="swt-h2">Cut Arena Cooling Costs Without Closing a Single Section</h2>
            <p>Arena glass facades create concentrated solar heat gain that HVAC systems must work against for every hour of direct sun exposure. In older Philadelphia venues with aging cooling infrastructure, this strain accelerates equipment failure and creates uncomfortable conditions during summer events and afternoon games.</p>
            <p>Heat-rejecting window film is installed in nights and off-hours — no structural work, no closures, no impact on your event schedule. The payback is typically 3–5 years through reduced cooling costs alone, after which the savings compound as operational benefit year after year.</p>
            <div class="swt-energy-metrics">
              <div class="swt-metric">
                <span class="swt-metric__num">30%</span>
                <span class="swt-metric__label">Avg. Cooling Cost Reduction</span>
              </div>
              <div class="swt-metric">
                <span class="swt-metric__num">3–5yr</span>
                <span class="swt-metric__label">Typical Payback Period</span>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.arenaExterior} alt="Philadelphia arena exterior at night with energy-efficient window film" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: SECURITY — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="security">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow swt-eyebrow--green">Benefit 03</span>
            <h2 class="swt-h2 swt-h2--light">Security Film: Hold Glass at Entry Points When It Matters Most</h2>
            <p>Arena entry points, tunnel glazing, and exterior concession windows represent the highest-risk glass in any venue. Security window film holds shattered panes in the frame on impact — dramatically reducing injury risk from broken glass in crowd surges, severe weather events, and accidental damage.</p>
            <p>For Philadelphia venues subject to municipal safety inspections and insurance requirements, security film provides documented protection that satisfies regulators and may qualify for reduced insurance premiums.</p>
            <div class="swt-security-features">
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Shatter Resistance</strong>
                  <p>Glass stays in frame on impact — no dangerous shards in crowd areas</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Fan Safety Compliance</strong>
                  <p>Meets ASTM E1886/1996 impact standards accepted by venue insurers</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Insurance-Friendly</strong>
                  <p>Documented security upgrade with certification package for insurers</p>
                </div>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.securityEntry} alt="Arena security entrance with window film protecting entry points" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: COMFORT — white bg, image left, text right -->
    <section class="swt-split" id="comfort">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.concession} alt="Arena concession area with comfortable glare-free environment" loading="lazy" />
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 04</span>
            <h2 class="swt-h2">Fan Comfort in VIP Suites and Concession Areas</h2>
            <p>VIP suites are a venue's premium product — and a west-facing suite that turns into a solar oven mid-event is a guest experience failure that's hard to recover from. Suite holders and corporate clients notice. They vote with renewal decisions.</p>
            <p>Our glare-control films eliminate the worst afternoon glare while maintaining full outdoor views and natural daylight. Fans in treated suites and premium concession areas stay comfortable without closing blinds or retreating from the glass.</p>
            <blockquote class="swt-inline-quote">
              "Our west-facing suites were essentially unusable for afternoon games. After the film was installed, we got two seasons of full suite utilization before any complaints."
              <cite>— Venue Operations Director, South Philadelphia sports complex</cite>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY — 5 images -->
    <section class="swt-gallery" id="gallery">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">Our Work</span>
          <h2 class="swt-h2 swt-h2--center">Window Film — In Action</h2>
          <p class="swt-subhead">From arena interiors to VIP suites and entry points — here's what we install.</p>
        </div>
        <div class="swt-gallery__grid">
          {galleryImages.map((img, i) => (
            <div class="swt-gallery__item fade-in" style={`--delay: ${i * 80}ms`}>
              <img src={img.src} alt={img.label} loading="lazy" />
              <div class="swt-gallery__overlay">
                <span>{img.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STATS BAR — accent green -->
    <section class="swt-stats">
      <div class="container">
        <div class="swt-stats__row">
          <div class="swt-stats__item fade-in">
            <span class="swt-stats__num">16+</span>
            <span class="swt-stats__label">Years in Philadelphia</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 80ms">
            <span class="swt-stats__num">50+</span>
            <span class="swt-stats__label">Venue Projects</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 160ms">
            <span class="swt-stats__num">99%</span>
            <span class="swt-stats__label">UV Rays Blocked</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 240ms">
            <span class="swt-stats__num">30%</span>
            <span class="swt-stats__label">Avg. Energy Savings</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS — 4 steps -->
    <section class="swt-process">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">How It Works</span>
          <h2 class="swt-h2 swt-h2--center">4 Steps to a Game-Ready Venue</h2>
        </div>
        <div class="swt-process__steps">
          <div class="swt-process__step fade-in">
            <div class="swt-process__num">01</div>
            <div class="swt-process__body">
              <h3>Venue Survey & Engineering Review</h3>
              <p>We perform a full site survey of all glass surfaces — including curved dome panels, angled facade glass, and retractable roof sections. Our engineering team produces a glass-by-glass specification and thermal analysis before any work begins.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 80ms">
            <div class="swt-process__num">02</div>
            <div class="swt-process__body">
              <h3>Custom Engineering for Curved Glass</h3>
              <p>Arena glass is rarely flat. Our team specifies the correct film and adhesive system for each unique glass geometry in your venue, with particular attention to thermally stressed zones and high-traffic entry areas.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 160ms">
            <div class="swt-process__num">03</div>
            <div class="swt-process__body">
              <h3>Phased Installation Around Events</h3>
              <p>We schedule all installation around your event calendar — typically night shifts and off-days. Most arena projects complete in 2–4 nights with zero disruption to operations or fan experience. We provide a detailed schedule before work begins.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 240ms">
            <div class="swt-process__num">04</div>
            <div class="swt-process__body">
              <h3>Post-Installation Safety Certification</h3>
              <p>We provide a complete documentation package including material spec sheets, independent lab test reports, and post-installation certification — ready for submission to your insurer, municipal building department, or venue safety inspector.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS — dark bg -->
    <section class="swt-testimonials">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow swt-eyebrow--green">Venue Stories</span>
          <h2 class="swt-h2 swt-h2--center swt-h2--light">Real Results from Real Philadelphia Venues</h2>
        </div>
        <div class="swt-testimonials__grid">
          <div class="swt-testimonial fade-in">
            <div class="swt-testimonial__quote">"</div>
            <p>We had two west-facing suites that were effectively unusable for any game starting before 5pm. The film brought the temperature down dramatically and eliminated the glare entirely. Our suite holders stopped complaining and renewals improved measurably.</p>
            <div class="swt-testimonial__author">
              <strong>James K.</strong>
              <span>General Manager, South Philadelphia event venue</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 80ms">
            <div class="swt-testimonial__quote">"</div>
            <p>Our security team had been flagged by our insurer for the glass at our main entry points. Security film was a fraction of the cost of laminated glass replacement and gave us the documentation our insurer needed to close the deficiency notice.</p>
            <div class="swt-testimonial__author">
              <strong>Michelle R.</strong>
              <span>Director of Operations, regional sports arena</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 160ms">
            <div class="swt-testimonial__quote">"</div>
            <p>The installation team worked overnight for three nights and was done before our next event. Zero disruption, clean work, and the energy bill the following summer was measurably lower. The ROI was faster than projected.</p>
            <div class="swt-testimonial__author">
              <strong>Carlos M.</strong>
              <span>Facilities Director, Philadelphia-area indoor arena</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="swt-faq" id="faq">
      <div class="container">
        <div class="swt-faq__layout">
          <div class="swt-faq__header fade-in">
            <span class="swt-eyebrow">Questions</span>
            <h2 class="swt-h2">Frequently Asked Questions</h2>
            <p>Honest answers from people who've been installing window film in Philadelphia venues for over 16 years.</p>
            <a href="/contact/" class="swt-btn swt-btn--primary">Talk to a Specialist</a>
          </div>
          <div class="swt-faq__list fade-in">
            {faqItems.map((item) => (
              <div class="swt-faq__item">
                <div class="swt-faq__q">
                  <span>{item.question}</span>
                  <span class="swt-faq__toggle">+</span>
                </div>
                <div class="swt-faq__a">
                  <p>{item.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA BANNER -->
    <section class="swt-cta">
      <div class="swt-cta__inner">
        <div class="swt-cta__text">
          <h2>Ready to <em>transform</em> your venue?</h2>
          <p>Get a free venue assessment and thermal analysis. No obligation, no pressure — just honest advice.</p>
        </div>
        <div class="swt-cta__btns">
          <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Venue Assessment</a>
          <a href="tel:+126****7980" class="swt-btn swt-btn--ghost-light">Call (267) 394-7980</a>
        </div>
      </div>
    </section>

  </div><!-- /swt-body -->
</BaseLayout>

<style>
  /* ══════════════════════════════════════
     BRAND TOKENS (local override)
     ══════════════════════════════════════ */
  :root {
    --swt-green:        #4E6B2A;
    --swt-green-accent: #83A94A;
    --swt-dark:         #2A241E;
    --swt-cream:        #F4EFE6;
    --swt-alt:          #ECE4D4;
    --swt-border:       #E1D6C1;
    --swt-text-sec:     #6E665C;
    --swt-gold:         #846212;
    --swt-white:        #ffffff;
    --swt-radius:       5px;
  }

  /* ══════════════════════════════════════
     HERO
     ══════════════════════════════════════ */
  .swt-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .swt-hero__img {
    position: absolute;
    inset: 0;
  }
  .swt-hero__img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .swt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(42,36,30,0.9) 0%, rgba(42,36,30,0.6) 50%, rgba(42,36,30,0.35) 100%);
  }
  .swt-hero__content {
    position: relative;
    z-index: 1;
    padding: 110px 8% 90px;
    max-width: 720px;
  }
  .swt-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
    background: rgba(78,107,42,0.25);
    color: rgba(255,255,255,0.75);
    border: 1px solid rgba(78,107,42,0.4);
  }
  .swt-hero__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(38px, 5.5vw, 66px);
    font-weight: 400;
    color: var(--swt-white);
    line-height: 1.1;
    margin: 0 0 20px;
  }
  .swt-hero__title em {
    font-style: italic;
    color: var(--swt-green-accent);
  }
  .swt-hero__sub {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 17px;
    color: rgba(255,255,255,0.65);
    line-height: 1.7;
    margin: 0 0 36px;
    max-width: 500px;
  }
  .swt-hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ══════════════════════════════════════
     BUTTONS
     ══════════════════════════════════════ */
  .swt-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .swt-btn--primary {
