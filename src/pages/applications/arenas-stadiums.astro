// ─── TestimonialMarquee reviews ───
const reviews = [
  { quote: "Our west-facing suites were essentially unusable for afternoon games. After stadium window film in Philadelphia was installed, we got two full seasons of suite utilization before any complaints. The film paid for itself in retained suite revenue alone.", name: 'James K.', role: 'Operations Director · South Philadelphia sports complex', img: '/images/arenas-stadiums/avatar-1.jpg' },
