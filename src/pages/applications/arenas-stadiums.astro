---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import { Icon } from 'astro-icon/components';

const title = 'Arena & Stadium Window Film in Philadelphia | Safety, UV & Glare for Sports Venues';
const description = 'Window film for Philadelphia arenas and stadiums: safety and security film, UV protection, glare reduction. Keep fans comfortable and buildings secure at any scale.';

const gallery = [
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163916_8e68f6c9-9c0b-4c70-b195-d9da467839b1.png',
    label: 'Arena Safety',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163920_10944058-a5bb-4715-9381-3261c2c364f0.png',
    label: 'Security Film',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163920_10944058-a5bb-4715-9381-3261c2c364f0.png',
    label: 'VIP Suites',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163923_764fdb8a-ab16-49ca-95c8-2905c140937e.png',
    label: 'UV Protection',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163924_0b743798-4037-4b8a-903d-e83f051875d0.png',
    label: 'Fan Comfort',
  },
];

const benefits = [
  {
    icon: 'lucide:shield-check',
    title: 'Safety & Security',
    body: 'Hold glass together on impact, protecting thousands of fans from injury',
  },
  {
    icon: 'lucide:sun',
    title: 'UV Protection',
    body: 'Block 99% of harmful UV rays in seating areas and suites',
  },
  {
    icon: 'lucide:glasses',
    title: 'Glare Reduction',
    body: 'Eliminate sun glare through roof panels and glass facades',
  },
  {
    icon: 'lucide:zap',
    title: 'Energy Efficiency',
    body: 'Reduce arena cooling costs with heat-rejecting film on glass',
  },
];

const stats = [
  { value: '10,000+', label: 'Fans Protected Per Venue' },
  { value: '99%', label: 'UV Blocked' },
  { value: '16+', label: 'Years Experience' },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/applications/arenas-stadiums/" serviceName="Arena & Stadium Window Film" serviceDesc={description} serviceUrl="https://www.windowfilmphiladelphia.net/applications/arenas-stadiums/">

<InnerPageHero
  title="Arena & Stadium Window Film"
  bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161502_42844d1e-6f6a-4636-ae2c-cd6cb623280b.png"
  desc="Safety · UV Protection · Fan Comfort"
/>

<div class="ip-page-body">

  <!-- Image Gallery -->
  <section class="gallery">
    <div class="gallery__row gallery__row--top">
      {gallery.slice(0, 3).map((img) => (
        <div class="gallery__item fade-in">
          <img src={img.src} alt={img.label} class="gallery__img" loading="lazy" />
          <div class="gallery__overlay">
            <span class="gallery__label">{img.label}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="gallery__row gallery__row--bottom">
      {gallery.slice(3).map((img) => (
        <div class="gallery__item fade-in">
          <img src={img.src} alt={img.label} class="gallery__img" loading="lazy" />
          <div class="gallery__overlay">
            <span class="gallery__label">{img.label}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="benefits">
    <div class="benefits__hd">
      <span class="eyebrow">Key Benefits</span>
      <h2 class="benefits__title">Why arenas & stadiums choose window film</h2>
    </div>
    <div class="benefits__grid">
      {benefits.map((b) => (
        <div class="benefit-card fade-in">
          <div class="benefit-card__icon">
            <Icon name={b.icon} width="28" height="28" />
          </div>
          <h3 class="benefit-card__title">{b.title}</h3>
          <p class="benefit-card__body">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Statistics Row -->
  <section class="stats">
    <div class="stats__inner">
      {stats.map((s) => (
        <div class="stat-card fade-in">
          <span class="stat-card__value">{s.value}</span>
          <span class="stat-card__label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <BrandLogos />

  <!-- CTA Section -->
  <section class="cta">
    <div class="cta__inner">
      <div class="cta__content">
        <h2 class="cta__title">Ready to protect your venue?</h2>
        <p class="cta__sub">Get a free on-site consultation and quote for your arena or stadium.</p>
      </div>
      <div class="cta__actions">
        <a href="/contact/" class="cta__btn">Get a Free Quote</a>
        <a href="tel:+12158885555" class="cta__phone">(215) 888-5555</a>
      </div>
    </div>
  </section>

</div>

</BaseLayout>

<style>
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* Gallery */
.gallery {
  padding: 80px 10% 0;
}

.gallery__row {
  display: grid;
  gap: 20px;
}

.gallery__row--top {
  grid-template-columns: repeat(3, 1fr);
}

.gallery__row--bottom {
  grid-template-columns: repeat(2, 1fr);
  max-width: calc(66.667% + 40px);
  margin-top: 20px;
}

.gallery__item {
  position: relative;
  border-radius: 18px;
  overflow: hidden;
  aspect-ratio: 1 / 1;
}

.gallery__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.gallery__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(39, 46, 50, 0.75) 0%, transparent 60%);
  display: flex;
  align-items: flex-end;
  padding: 20px;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.gallery__item:hover .gallery__overlay {
  opacity: 1;
}

.gallery__item:hover .gallery__img {
  transform: scale(1.04);
}

.gallery__label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.5px;
}

/* Benefits */
.eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

.benefits {
  padding: 100px 10%;
  background: var(--off-white, #F7F6F3);
}

.benefits__hd {
  margin-bottom: 56px;
}

.benefits__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
}

.benefits__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.benefit-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 36px 28px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  transition: transform 0.2s, box-shadow 0.2s;
}

.benefit-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

.benefit-card__icon {
  width: 56px;
  height: 56px;
  background: var(--green-light, #eef4e4);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--green, #81AB4C);
  margin-bottom: 20px;
}

.benefit-card__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 20px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 12px;
  line-height: 1.2;
}

.benefit-card__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.7;
  margin: 0;
}

/* Stats */
.stats {
  padding: 80px 10%;
  background: var(--brand, #272E32);
}

.stats__inner {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}

.stat-card__value {
  display: block;
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(48px, 6vw, 72px);
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
  margin-bottom: 12px;
}

.stat-card__label {
  display: block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.6);
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* CTA */
.cta {
  padding: 80px 10%;
  background: var(--brand, #272E32);
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
}

.cta__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  max-width: 1200px;
  margin: 0 auto;
}

.cta__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3vw, 40px);
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 8px;
  line-height: 1.2;
}

.cta__sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  color: rgba(255, 255, 255, 0.6);
  margin: 0;
}

.cta__actions {
  display: flex;
  align-items: center;
  gap: 24px;
  flex-shrink: 0;
}

.cta__btn {
  display: inline-block;
  padding: 16px 36px;
  background: var(--green, #81AB4C);
  color: #ffffff;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  border-radius: 100px;
  border: 2px solid var(--green, #81AB4C);
  transition: all 0.2s;
  white-space: nowrap;
}

.cta__btn:hover {
  background: #6e9640;
  border-color: #6e9640;
  transform: translateY(-2px);
}

.cta__phone {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.8);
  text-decoration: none;
  transition: color 0.2s;
}

.cta__phone:hover {
  color: var(--green, #81AB4C);
}

.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}

.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 1024px) {
  .benefits__grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .gallery__row--top {
    grid-template-columns: repeat(3, 1fr);
  }
  .gallery__row--bottom {
    max-width: 100%;
  }
}

@media (max-width: 768px) {
  .gallery {
    padding: 60px 5% 0;
  }
  .gallery__row--top {
    grid-template-columns: repeat(3, 1fr);
  }
  .gallery__row--bottom {
    grid-template-columns: repeat(2, 1fr);
  }
  .benefits {
    padding: 60px 5%;
  }
  .stats {
    padding: 60px 5%;
  }
  .stats__inner {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .cta {
    padding: 60px 5%;
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
  }
  .cta__inner {
    flex-direction: column;
    text-align: center;
  }
  .cta__actions {
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }
  .cta__btn {
    width: 100%;
    text-align: center;
  }
}

@media (max-width: 480px) {
  .benefits__grid {
    grid-template-columns: 1fr;
  }
  .gallery__row--top,
  .gallery__row--bottom {
    grid-template-columns: 1fr 1fr;
  }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>
