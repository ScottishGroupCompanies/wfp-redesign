<script>
  // ── Full-bleed slider (of-ftype pattern) ──
  (() => {
    const track = document.getElementById('asFtypeTrack');
    if (!track) return;
    const slides = Array.from(document.querySelectorAll('.as-ftype__slide'));
    const navItems = Array.from(document.querySelectorAll('[data-asnav]'));
    const progressBar = document.getElementById('asFtypeProgressBar');
    let current = 0;
    let timer;
    let progress = 0;
    const DURATION = 7000;
    const TICK = 50;

    function goTo(idx) {
      slides[current].classList.remove('as-ftype-active');
      navItems[current] && navItems[current].classList.remove('as-ftype__nav-item--active');
      current = ((idx % slides.length) + slides.length) % slides.length;
      slides[current].classList.add('as-ftype-active');
      navItems[current] && navItems[current].classList.add('as-ftype__nav-item--active');
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      progress = 0;
      if (progressBar) progressBar.style.width = '0%';
    }

    function startTimer() {
      clearInterval(timer);
      progress = 0;
      timer = setInterval(() => {
        progress += (TICK / DURATION) * 100;
        if (progressBar) progressBar.style.width = Math.min(progress, 100) + '%';
        if (progress >= 100) goTo(current + 1);
      }, TICK);
    }

    goTo(0);
    startTimer();

    const nextBtn = document.getElementById('asFtypeNext');
    const prevBtn = document.getElementById('asFtypePrev');
    if (nextBtn) nextBtn.addEventListener('click', () => { goTo(current + 1); startTimer(); });
    if (prevBtn) prevBtn.addEventListener('click', () => { goTo(current - 1); startTimer(); });
    navItems.forEach(btn => btn.addEventListener('click', () => { goTo(Number(btn.dataset.asnav)); startTimer(); }));
  })();
</script>
