  { span: 'lg', title: 'VIP Suites & Premium Seating', desc: 'Glare control and UV protection for the highest-revenue spaces in your venue.', img: '/images/arenas-stadiums/bento-suite.jpg', href: '/contact/' },
  { span: 'sm', title: 'Concourses', desc: 'Heat and glare reduction for fan circulation areas.', img: '/images/arenas-stadiums/bento-concourse.jpg', href: '/contact/' },
  { span: 'sm', title: 'Press Boxes', desc: 'Glare-free broadcast windows with full visibility.', img: '/images/arenas-stadiums/bento-press-box.jpg', href: '/contact/' },
  { span: 'md', title: 'Entry Points', desc: 'Security film for crowd safety at main entrances and vestibules.', img: '/images/arenas-stadiums/bento-entry.jpg', href: '/contact/' },
  { span: 'md', title: 'Concession Areas', desc: 'Anti-graffiti and solar control for high-traffic food service glass.', img: '/images/arenas-stadiums/bento-concession.jpg', href: '/contact/' },
  { span: 'md', title: 'Atriums & Lobbies', desc: 'Energy savings and comfort for soaring glass entrance spaces.', img: '/images/arenas-stadiums/bento-atrium.jpg', href: '/contact/' },
