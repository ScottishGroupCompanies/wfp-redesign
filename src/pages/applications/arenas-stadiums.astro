---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
import GalleryBanner from '../../components/GalleryBanner.astro';
import BentoGridPhoto from '../../components/BentoGridPhoto.astro';
import AccordionBenefits from '../../components/AccordionBenefits.astro';
import HowItWorksSlideshow from '../../components/HowItWorksSlideshow.astro';
import TestimonialMarquee from '../../components/TestimonialMarquee.astro';
import AccordionFAQ from '../../components/AccordionFAQ.astro';
import CTAAvatars from '../../components/CTAAvatars.astro';

const title = 'Stadium Window Film in Philadelphia | Arena & Venue Window Tinting';
const description = 'Stadium window film in Philadelphia — glare control for fans and suites, UV protection, energy savings on massive glass facades, and security film for entry points. Serving the Delaware Valley since 2008.';

const serviceName = 'Arena & Stadium Window Film Installation';
const serviceDesc = 'Professional window film installation for Philadelphia arenas, stadiums, concert venues, and convention centers — glare control, UV protection, energy savings, and security film for fan safety.';
const serviceUrl = 'https://www.windowfilmphiladelphia.com/applications/arenas-stadiums/';

// ─── FAQ items (BaseLayout expects { question, answer }) ───
const faqItems = [
  {
    question: 'Can window film handle the curved and angled glass in modern arenas?',
    answer: 'Yes. Modern arenas feature curved facade panels, angled atrium glass, and retractable roof sections. Our engineering team performs a full glass geometry survey before specifying the right film and adhesive system for each unique surface. We have experience with thermally stressed zones, dome panels, and non-standard glazing across Philadelphia venues.'
  },
  {
    question: 'How does stadium window film perform during extreme temperature swings?',
    answer: 'Philadelphia summers push untreated glass temperatures to dangerous levels in non-climate-controlled concourses and press areas. Our heat-rejecting films are rated for thermal stress and reduce interior temperatures significantly in direct sun zones. Security films also perform reliably through winter freeze-thaw cycles. Film is engineered to handle the thermal cycling that large glass facades experience season after season.'
  },
  {
    question: 'Does security film meet venue safety codes and insurance requirements?',
    answer: 'Our security films meet or exceed ASTM E1886/1996 impact standards and are accepted by venue insurers and municipal building departments throughout Pennsylvania and New Jersey. We provide a full documentation package including material specifications, independent lab test reports, and post-installation certification — ready for submission to your insurer, safety inspector, or municipal building department.'
  },
  {
    question: 'Can film be installed during the season without closing sections?',
    answer: 'Absolutely. One of the main advantages of window film over glass replacement is that it can be installed in occupied spaces with no downtime. We schedule work around your event calendar, perform phased installation in non-game areas, and use low-odor products that allow immediate re-occupancy. Most arena installations are completed in night shifts with zero disruption to operations or fan experience.'
  },
  {
    question: 'What maintenance does arena window film require?',
    answer: 'Window film requires minimal maintenance — standard glass cleaning with non-abrasive solutions. Unlike retrofitted glass systems, there are no mechanical parts, seals, or frames to maintain. Commercial installations come with manufacturer warranties covering delamination, bubbling, and color shift, and we provide annual inspection service for large venue accounts to catch any issues early.'
  },
  {
    question: 'Will window film darken the venue or affect broadcast lighting?',
    answer: 'Not with the right film selection. Spectrally selective films like 3M Prestige 70 maintain 70% visible light transmission while still rejecting up to 50% of solar heat. For broadcast-critical areas, we specify high-VLT films that preserve natural light levels and do not interfere with camera exposure. We assess each zone individually and bring samples before specifying.'
  },
  {
    question: 'How much can arena window film reduce cooling costs?',
    answer: 'Solar heat gain through untreated glass is a major contributor to arena cooling loads. Heat-rejecting window film can reduce solar heat gain by up to 78% at the glass surface, translating to meaningful reductions in HVAC operating costs — especially for large glass facades facing south and west. The actual impact depends on your venue\'s glass area, orientation, HVAC capacity, and usage patterns. We provide performance data for every film we recommend.'
  },
  {
    question: 'Do you install anti-graffiti film for high-traffic arena areas?',
    answer: 'Yes. Anti-graffiti film is a clear sacrificial layer that protects arena glass partitions, concession windows, elevator interiors, and entry doors from etching, scratching, and spray paint. When vandalized, only the film is replaced — not the glass underneath — at a fraction of replacement cost. It is particularly valuable for concourse areas and high-traffic entry points that see heavy public use event after event.'
  },
];

// Map for AccordionFAQ component which expects { q, a } keys
const faqAccordionItems = faqItems.map(f => ({ q: f.question, a: f.answer }));

// ─── AccordionBenefits data ───
const benefits = [
  {
    number: '01',
    title: 'Glare Control for Fans and VIP Suites',
    image: '/images/arenas-stadiums/benefit-glare-control.jpg',
    imageAlt: 'Arena VIP suite with glare control window film — comfortable diffused light through treated glass',
    detail: `
      <p>West-facing suites that turn into solar ovens by the second quarter are a premium product failure. Suite holders notice. Press box operators notice. Fans in affected seating sections notice. Stadium window film in Philadelphia eliminates the worst afternoon glare while maintaining full outdoor views and natural daylight.</p>
      <p>Spectrally selective films block the infrared wavelengths that cause heat and visible light scatter without darkening the space. Fans in treated suites stay comfortable without closing blinds or retreating from the glass — and broadcast cameras get clean, glare-free shots through treated press box windows.</p>
      <ul>
        <li>Eliminates harsh glare in VIP suites, press boxes, and premium seating</li>
        <li>Maintains 70%+ visible light transmission — spaces stay bright</li>
        <li>No blinds required — full outdoor views preserved</li>
      </ul>
    `,
  },
  {
    number: '02',
    title: 'UV Protection for Interiors and Branding',
    image: '/images/arenas-stadiums/benefit-uv-protection.jpg',
    imageAlt: 'Arena luxury suite interior with UV protection window film preserving upholstery and flooring',
    detail: `
      <p>UV-A and UV-B radiation entering through untreated arena glass creates cumulative health exposure for staff who work hundreds of events per year near the same windows. UV is also the primary driver of interior fading in VIP suites, concession signage, lobby displays, and branded upholstery.</p>
      <p>Our <a href="/benefits/uv-blocking-window-film-philadelphia/">UV protection window film</a> blocks up to 99% of UV transmission, protecting your brand assets, signage, and interior finishes from irreversible UV degradation — with no visible change to how the space looks.</p>
      <ul>
        <li>Blocks 99% of UV-A and UV-B radiation</li>
        <li>Protects suite upholstery, branding, signage, and interior finishes from fading</li>
        <li>Reduces long-term health liability for window-adjacent staff</li>
      </ul>
    `,
  },
  {
    number: '03',
    title: 'Energy Savings on Massive Glass Facades',
    image: '/images/arenas-stadiums/benefit-energy-savings.jpg',
    imageAlt: 'Large arena exterior glass facade with energy-saving window film — reflective curtain wall',
    detail: `
      <p>Arena glass facades create concentrated solar heat gain that HVAC systems must fight for every hour of direct sun exposure. In older Philadelphia venues with aging cooling infrastructure, this strain accelerates equipment failure and creates uncomfortable conditions during summer events and afternoon games.</p>
      <p>Heat-rejecting window film addresses the root cause — it rejects solar heat at the glass surface before it enters the building. The payback is typically 3–5 years through reduced cooling costs alone. See our full guide to <a href="/benefits/energy-savings/">energy-saving window film</a> for Philadelphia commercial buildings.</p>
      <ul>
        <li>Rejects up to 78% of solar heat at the glass surface</li>
        <li>Reduces HVAC load on massive glass facades — lower cooling costs</li>
        <li>3–5 year payback period, then 10+ years of continued savings</li>
      </ul>
    `,
  },
  {
    number: '04',
    title: 'Security Film for Entry Points',
    image: '/images/arenas-stadiums/benefit-security-film.jpg',
    imageAlt: 'Arena entrance with security window film on glass doors — modern institutional architecture',
    detail: `
      <p>Arena entry points, tunnel glazing, and exterior concession windows represent the highest-risk glass in any venue. Security window film holds shattered panes in the frame on impact — dramatically reducing injury risk from broken glass in crowd surges, severe weather events, and accidental damage.</p>
      <p>For Philadelphia venues subject to municipal safety inspections and insurance requirements, <a href="/benefits/safety-and-security/">security window film</a> provides documented protection that satisfies regulators and may qualify for reduced insurance premiums. Learn more about our <a href="/services/commercial/">commercial window film services</a> for large venues.</p>
      <ul>
        <li>Holds shattered glass in the frame — reduces injury risk in crowd areas</li>
        <li>Meets ASTM E1886/1996 impact standards accepted by venue insurers</li>
        <li>Full documentation package for insurance and regulatory compliance</li>
      </ul>
    `,
  },
  {
    number: '05',
    title: 'Anti-Graffiti Film for High-Traffic Areas',
    image: '/images/arenas-stadiums/benefit-anti-graffiti.jpg',
    imageAlt: 'Clean arena concourse glass partition with anti-graffiti film — pristine transparent surface',
    detail: `
      <p>Arena concourses, concession windows, and elevator interiors take a beating event after event. Etching, scratching, and spray paint on glass are expensive to repair — and replacement glass means downtime. <a href="/benefits/anti-graffiti/">Anti-graffiti window film</a> is a clear sacrificial layer that takes the abuse instead of your glass.</p>
      <p>When vandalized, only the film is peeled and replaced — the glass underneath stays pristine. At a fraction of glass replacement cost, with no venue downtime. Essential for high-traffic concourse areas, restroom partitions, and entry vestibules.</p>
      <ul>
        <li>Clear sacrificial layer protects glass from etching, scratching, and spray paint</li>
        <li>Only the film is replaced — not the glass — at fraction of replacement cost</li>
        <li>Zero venue downtime — film replacement takes minutes, not days</li>
      </ul>
    `,
  },
  {
    number: '06',
    title: 'HVAC Load Reduction and Equipment Longevity',
    image: '/images/arenas-stadiums/benefit-hvac-reduction.jpg',
    imageAlt: 'Arena mechanical room with HVAC equipment — modern building systems',
    detail: `
      <p>Every degree of solar heat gain through untreated glass is a degree your HVAC system has to remove. For large venues with massive glass facades, that translates to significant cooling load — and accelerated wear on chillers, air handlers, and distribution systems that are expensive to replace and difficult to service during event seasons.</p>
      <p>Stadium window film in Philadelphia reduces the thermal load at the source, extending the service life of existing HVAC equipment and deferring capital replacement. According to the <a href="https://betterbuildingssolutioncenter.energy.gov/" target="_blank" rel="noopener noreferrer">U.S. Department of Energy Better Buildings Initiative</a>, window film is one of the most cost-effective energy upgrades available for commercial buildings with significant glazing.</p>
      <ul>
        <li>Reduces solar heat load — extends HVAC equipment service life</li>
        <li>Defers capital replacement of chillers and air handlers</li>
        <li>Lower operating costs season after season</li>
      </ul>
    `,
  },
];

// ─── BentoGridPhoto items ───
