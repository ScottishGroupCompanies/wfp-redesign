---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import { Icon } from 'astro-icon/components';

const title = 'Arena & Stadium Window Film in Philadelphia | Safety, UV & Glare for Sports Venues';
const description = 'Window film for Philadelphia arenas and stadiums: safety and security film, UV protection, glare reduction. Keep fans comfortable and buildings secure.';

const benefits = [
  {
    icon: 'lucide:shield-check',
    title: 'Safety & Security',
    body: 'Security window film holds shattered glass in place, protecting fans and staff from injury during impacts, storms, or vandalism. Essential for high-occupancy venues.',
  },
  {
    icon: 'lucide:sun',
    title: 'UV Protection',
    body: 'Block up to 99% of harmful UV rays, protecting fans, players, and staff from sun exposure while reducing fabric and upholstery fading in your venue.',
  },
  {
    icon: 'lucide:glasses',
    title: 'Glare Reduction',
    body: 'Eliminate harsh glare on scoreboards, concourse displays, and seating areas, creating a more comfortable and visually clear experience for everyone.',
  },
  {
    icon: 'lucide:zap',
    title: 'Energy Efficiency',
    body: 'Reduce solar heat gain through expansive glass facades, lowering HVAC costs and creating consistent indoor temperatures across all seating zones.',
  },
];

const stats = [
  { value: '99%', label: 'UV Blocked' },
  { value: '40%', label: 'Heat Reduction' },
  { value: '3–5 yr', label: 'ROI Timeline' },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/applications/arenas-stadiums/" serviceName="Arena & Stadium Window Film" serviceDesc="Window film for Philadelphia arenas and stadiums: safety and security film, UV protection, glare reduction. Keep fans comfortable and buildings secure." serviceUrl="https://www.windowfilmphiladelphia.net/applications/arenas-stadiums/">

<InnerPageHero
  title="Arena & Stadium Window Film"
  bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161502_42844d1e-6f6a-4636-ae2c-cd6cb623280b.png"
  desc="Safety · UV protection · Fan comfort"
/>

<div class="ip-page-body">

  <section class="benefits">
    <div class="benefits__hd">
      <span class="eyebrow">Key Benefits</span>
      <h2 class="benefits__title">Why arenas & stadiums choose window film</h2>
    </div>
    <div class="benefits__grid">
      {benefits.map((b) => (
        <div class="benefit-card fade-in">
          <div class="benefit-card__icon">
            <Icon name={b.icon} width="28" height="28" />
          </div>
          <h3 class="benefit-card__title">{b.title}</h3>
          <p class="benefit-card__body">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="why-arenas">
    <span class="eyebrow">For Large Venues</span>
    <h2 class="why-arenas__title">Built for the scale and demands of major sports venues</h2>
    <p class="why-arenas__lead">Philadelphia's arenas and stadiums face unique challenges: massive glass facades, thousands of daily visitors, and constant exposure to the elements. Window film provides a cost-effective, passive solution that enhances safety, comfort, and energy performance — without the cost or disruption of full glass replacement. From solar control for fan comfort to security film for blast mitigation, our films are engineered for large-scale commercial applications.</p>
  </section>

  <section class="stats">
    <div class="stats__inner">
      {stats.map((s) => (
        <div class="stat-card fade-in">
          <span class="stat-card__value">{s.value}</span>
          <span class="stat-card__label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <BrandLogos />

  <section class="cta">
    <div class="cta__inner">
      <div class="cta__content">
        <h2 class="cta__title">Ready to protect your venue?</h2>
        <p class="cta__sub">Get a free on-site consultation and quote for your arena or stadium.</p>
      </div>
      <a href="/contact/" class="cta__btn">Get a Free Quote</a>
    </div>
  </section>

</div>

</BaseLayout>

<style>
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

.eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

.benefits {
  padding: 100px 10%;
  background: var(--off-white, #F7F6F3);
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
}

.benefits__hd {
  margin-bottom: 56px;
}

.benefits__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
}

.benefits__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.benefit-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 36px 28px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  transition: transform 0.2s, box-shadow 0.2s;
}

.benefit-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

.benefit-card__icon {
  width: 56px;
  height: 56px;
  background: var(--green-light, #eef4e4);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--green, #81AB4C);
  margin-bottom: 20px;
}

.benefit-card__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 20px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 12px;
  line-height: 1.2;
}

.benefit-card__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.7;
  margin: 0;
}

.why-arenas {
  padding: 100px 10%;
  background: #ffffff;
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
}

.why-arenas__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 28px;
}

.why-arenas__lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.8;
  margin: 0;
}

.stats {
  padding: 80px 10%;
  background: var(--brand, #272E32);
}

.stats__inner {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}

.stat-card__value {
  display: block;
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(48px, 6vw, 72px);
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
  margin-bottom: 12px;
}

.stat-card__label {
  display: block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.6);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.cta {
  padding: 80px 10%;
  background: var(--brand, #272E32);
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
}

.cta__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  max-width: 1200px;
  margin: 0 auto;
}

.cta__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3vw, 40px);
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 8px;
  line-height: 1.2;
}

.cta__sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  color: rgba(255, 255, 255, 0.6);
  margin: 0;
}

.cta__btn {
  display: inline-block;
  padding: 16px 36px;
  background: var(--green, #81AB4C);
  color: #ffffff;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  border-radius: 100px;
  border: 2px solid var(--green, #81AB4C);
  transition: all 0.2s;
  white-space: nowrap;
  flex-shrink: 0;
}

.cta__btn:hover {
  background: #6e9640;
  border-color: #6e9640;
  transform: translateY(-2px);
}

.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}

.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 1024px) {
  .benefits__grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .stats__inner {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 768px) {
  .benefits {
    padding: 60px 5%;
  }
  .why-arenas {
    padding: 60px 5%;
  }
  .stats {
    padding: 60px 5%;
  }
  .stats__inner {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .cta {
    padding: 60px 5%;
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
  }
  .cta__inner {
    flex-direction: column;
    text-align: center;
  }
  .cta__btn {
    width: 100%;
    justify-content: center;
  }
}

@media (max-width: 480px) {
  .benefits__grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>
