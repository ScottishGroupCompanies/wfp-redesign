---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import { Icon } from 'astro-icon/components';

const title = 'Restaurant Window Film in Philadelphia | UV Protection, Glare & Customer Comfort';
const description = 'Window film for Philadelphia restaurants and dining spaces: protect guests from UV rays, reduce glare on tables, save on energy costs. Professional installation.';

const benefits = [
  {
    icon: 'lucide:sun',
    title: 'UV Protection',
    body: 'Block up to 99% of harmful UV rays, protecting guests, staff, and furnishings from sun damage while maintaining natural brightness.',
  },
  {
    icon: 'lucide:glasses',
    title: 'Glare Reduction',
    body: 'Eliminate harsh glare on dining tables and bar seating, so guests can read menus and enjoy their meal without squinting.',
  },
  {
    icon: 'lucide:zap',
    title: 'Energy Savings',
    body: 'Reduce heat buildup in summer and heat loss in winter, lowering HVAC costs year-round without sacrificing natural light.',
  },
  {
    icon: 'lucide:lamp',
    title: 'Ambient Ambiance',
    body: 'Create a consistently comfortable dining atmosphere — warm in winter, cool in summer — that keeps guests coming back.',
  },
];

const stats = [
  { value: '99%', label: 'UV Rays Blocked' },
  { value: '40%', label: 'Glare Reduction' },
  { value: '30%', label: 'Energy Cost Savings' },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/applications/restaurants-window-film-philadelphia/" serviceName="Restaurant Window Film" serviceDesc="Window film for Philadelphia restaurants: UV protection, glare reduction, and energy savings for dining spaces." serviceUrl="https://www.windowfilmphiladelphia.net/applications/restaurants-window-film-philadelphia/">

<InnerPageHero
  title="Restaurant Window Film"
  bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161712_f3d7c784-873c-4b35-bd02-ae590b144072.jpeg"
  desc="Guest comfort · UV protection · Energy savings"
/>

<div class="ip-page-body">

  <section class="bp-intro">
    <div class="bp-intro__inner">
      <div class="bp-intro__left">
        <span class="bp-eyebrow">Restaurants & Hospitality</span>
        <h1 class="bp-intro__title">Window Film Solutions for Philadelphia Restaurants</h1>
      </div>
      <div class="bp-intro__right">
        <p class="bp-intro__lead">Philadelphia restaurants face a unique challenge: guests expect bright, airy spaces with abundant natural light, but uncontrolled sun creates glare, heat, and UV exposure that diminishes the dining experience. Our window film solutions address all three — protecting your guests, preserving your interiors, and reducing your operating costs.</p>
        <div class="bp-intro__ctas">
          <a href="/contact/" class="bp-btn bp-btn--primary">Get a Free Quote</a>
          <a href="/benefits/" class="bp-btn bp-btn--ghost">View Film Benefits</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bp-benefits">
    <div class="bp-benefits__hd">
      <span class="bp-eyebrow">Key Benefits</span>
      <h2 class="bp-benefits__title">Why window film is a smart investment for restaurants</h2>
    </div>
    <div class="bp-benefits__grid">
      {benefits.map((b) => (
        <div class="bp-benefit-card fade-in">
          <div class="bp-benefit-card__icon">
            <Icon name={b.icon} width="28" height="28" />
          </div>
          <h3 class="bp-benefit-card__title">{b.title}</h3>
          <p class="bp-benefit-card__body">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bp-stats">
    <div class="bp-stats__hd">
      <span class="bp-eyebrow">By the Numbers</span>
      <h2 class="bp-stats__title">Measurable results for Philadelphia restaurants</h2>
    </div>
    <div class="bp-stats__row">
      {stats.map((s) => (
        <div class="bp-stat-card fade-in">
          <span class="bp-stat-card__value">{s.value}</span>
          <span class="bp-stat-card__label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <BrandLogos />

  <div class="bp-cta fade-in">
    <h2>Ready to upgrade your <em>Philadelphia restaurant?</em></h2>
    <div class="bp-cta__btns">
      <a href="/contact/" class="bp-btn bp-btn--green">Get a Free Quote</a>
    </div>
  </div>

</div>

</BaseLayout>

<style>
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}
.bp-eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}
.bp-btn {
  display: inline-block; padding: 14px 28px;
  border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; font-weight: 500;
  text-decoration: none; transition: all 0.2s;
  border: 2px solid transparent; white-space: nowrap;
}
.bp-btn--primary { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.bp-btn--primary:hover { background: #6e9640; border-color: #6e9640; transform: translateY(-2px); color: #fff; }
.bp-btn--ghost { background: transparent; color: var(--brand, #272E32); border-color: var(--brand, #272E32); }
.bp-btn--ghost:hover { background: var(--brand, #272E32); color: #fff; transform: translateY(-2px); }
.bp-btn--green { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.bp-btn--green:hover { background: #6e9640; transform: translateY(-2px); color: #fff; }

/* Intro */
.bp-intro {
  padding: 80px 10%;
}
.bp-intro__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.bp-intro__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(36px, 4.5vw, 58px);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -1px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
}
.bp-intro__lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.75;
  margin-bottom: 32px;
}
.bp-intro__ctas { display: flex; gap: 14px; flex-wrap: wrap; }

/* Benefits */
.bp-benefits {
  padding: 100px 10%;
  background: var(--off-white, #F7F6F3);
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
}
.bp-benefits__hd { margin-bottom: 64px; }
.bp-benefits__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
  max-width: 560px;
}
.bp-benefits__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.bp-benefit-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 32px 28px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
}
.bp-benefit-card__icon {
  color: var(--green, #81AB4C);
  margin-bottom: 20px;
  display: flex;
  align-items: center;
}
.bp-benefit-card__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 20px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin-bottom: 12px;
  line-height: 1.2;
}
.bp-benefit-card__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.7;
  margin: 0;
}

/* Stats */
.bp-stats {
  background: var(--brand, #272E32);
  padding: 100px 10%;
}
.bp-stats__hd { margin-bottom: 64px; }
.bp-stats__hd .bp-eyebrow { color: var(--green, #81AB4C); }
.bp-stats__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.15;
  letter-spacing: -0.5px;
  margin: 0;
  max-width: 500px;
}
.bp-stats__row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
}
.bp-stat-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.bp-stat-card__value {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(48px, 6vw, 80px);
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
}
.bp-stat-card__label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.55);
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* CTA */
.bp-cta {
  background: var(--brand, #272E32);
  border-radius: 40px;
  padding: 64px 60px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  margin: 0 5% 0;
}
.bp-cta h2 {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 32px; font-weight: 700;
  color: #fff; line-height: 1.2;
  max-width: 460px; margin: 0;
}
.bp-cta h2 em { font-style: italic; color: var(--green, #81AB4C); }
.bp-cta__btns { display: flex; gap: 14px; flex-shrink: 0; }

/* Fade-in */
.fade-in { opacity: 0; transform: translateY(24px); transition: opacity 0.65s ease, transform 0.65s ease; }
.fade-in.visible { opacity: 1; transform: translateY(0); }

/* Responsive */
@media (max-width: 1024px) {
  .bp-intro__inner { grid-template-columns: 1fr; gap: 40px; }
  .bp-benefits__grid { grid-template-columns: repeat(2, 1fr); }
  .bp-stats__row { grid-template-columns: repeat(2, 1fr); }
  .bp-cta { flex-direction: column; padding: 40px 28px; text-align: center; }
  .bp-cta h2 { font-size: 26px; max-width: 100%; }
  .bp-cta__btns { flex-direction: column; width: 100%; }
}
@media (max-width: 768px) {
  .bp-intro { padding: 60px 5%; }
  .bp-benefits { padding: 60px 5%; }
  .bp-stats { padding: 60px 5%; }
  .bp-benefits__grid { grid-template-columns: 1fr; }
  .bp-stats__row { grid-template-columns: 1fr; }
}
@media (max-width: 480px) {
  .bp-intro__ctas { flex-direction: column; }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>