---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Restaurant Window Film in Philadelphia | Comfort, Privacy & Energy Savings';
const description = 'Window film for Philadelphia restaurants: reduce glare on dining tables, block UV rays for staff, cut kitchen and dining cooling costs. Professional after-hours installation available.';

const galleryImages = [
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175520_f2aa01e8-65b5-4c0f-88e9-7c2e534d6c2f.png', label: 'Dining Room Comfort' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175521_9869558b-94ef-4b87-b9d1-48b84293f064.png', label: 'UV Protection' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175522_c68490a1-d827-47ee-8230-39b0d307d72d.png', label: 'Kitchen Heat Control' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175523_9132e88c-c214-4150-a8ef-941665fa455c.png', label: 'Evening Privacy' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175513_9a474dbe-6be1-4a2b-8bb9-8ef4cbf58388.png', label: 'Outdoor Patio' },
];

const newImages = {
  hero: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175520_f2aa01e8-65b5-4c0f-88e9-7c2e534d6c2f.png',
  uv: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175521_9869558b-94ef-4b87-b9d1-48b84293f064.png',
  energy: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175522_c68490a1-d827-47ee-8230-39b0d307d72d.png',
  privacy: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175523_9132e88c-c214-4150-a8ef-941665fa455c.png',
};

const faqItems = [
  { question: 'Can window film reduce the glare on dining tables during brunch?', answer: 'Yes — this is one of the most immediate benefits for restaurant owners. Sunlight streaming through west or south-facing windows creates harsh glare on tables, making it uncomfortable for guests and nearly impossible for staff to seat customers in those sections. Our glare-control films filter the wavelengths that cause glare while preserving natural light and outdoor views. Your dining room stays bright and welcoming without the blinding hot spots.' },
  { question: 'How does film affect restaurant ambiance and photography?', answer: 'Guests constantly photograph their meals and the restaurant interior — for food content creators, this is a real consideration. Our films are available in a range of tints, from nearly invisible clear films to moderate tints that add a warm, golden-hour feel to the dining room without the orange cast of some lighting. We can show you samples in your actual space before you commit, so there are no surprises on launch night.' },
  { question: 'Will staff working near kitchen windows be more comfortable?', answer: 'Absolutely. Line cooks and prep staff working near south or west-facing kitchen windows are exposed to significant solar heat and UV all shift. This isn\'t just a comfort issue — it\'s a retention and safety issue. Chronic heat exposure leads to fatigue,脱水, and higher turnover. Kitchen window film can reduce surface temperatures near windows by 15-20°F and block UV, making those stations genuinely safer and more comfortable year-round.' },
  { question: 'Does film help with outdoor patio noise?', answer: 'Window film alone doesn\'t significantly reduce noise — for that you\'d want acoustic panels or laminated glass. However, many restaurant owners combine window film with other upgrades that do reduce noise. The key benefit is that film keeps your outdoor patio comfortable without requiring expensive structural changes. If noise from the street is a concern, we can discuss layered solutions as part of a broader comfort package.' },
  { question: 'How quickly does film pay for itself in a high-volume restaurant?', answer: 'For a high-volume restaurant spending $2,000-$4,000/month on energy, a window film installation costing $5,000-$15,000 can pay back in 18-36 months through reduced cooling loads — especially in kitchens and enclosed dining areas with significant glass exposure. Beyond energy, you\'ll see savings in staff comfort (reduced turnover and sick days near windows), fabric and furniture fading, and if you serve alcohol, reduced HVAC run-time during peak hours when utility rates are highest.' },
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Restaurant Window Film Installation"
  serviceDesc="Professional window film installation for Philadelphia restaurants — customer comfort, UV protection for staff, energy savings, and privacy for private dining areas."
  serviceUrl="https://www.windowfilmphiladelphia.com/applications/restaurants-window-film-philadelphia"
  faqItems={faqItems}
>
  <!-- HERO -->
  <section class="swt-hero">
    <div class="swt-hero__img">
      <img src={newImages.hero} alt="Philadelphia restaurant dining room with glare from large windows" width="1440" height="700" />
      <div class="swt-hero__overlay"></div>
    </div>
    <div class="swt-hero__content">
      <span class="swt-badge">
        <svg width="8" height="8" viewBox="0 0 8 8" fill="none"><circle cx="4" cy="4" r="4" fill="#4E6B2A"/></svg>
        Hospitality Window Solutions
      </span>
      <h1 class="swt-hero__title">
        Customer Comfort.<br/>
        Staff Health.<br/>
        <em>Energy Savings.</em><br/>
        One Professional Upgrade.
      </h1>
      <p class="swt-hero__sub">Eliminate dining table glare, block 99% of UV rays for all-day staff exposure, and cut cooling costs in your kitchen and dining room — installed after hours in Philadelphia.</p>
      <div class="swt-hero__ctas">
        <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Quote</a>
        <a href="#benefits" class="swt-btn swt-btn--ghost-light">See Benefits</a>
      </div>
    </div>
  </section>

  <div class="swt-body">

    <!-- TRUST BAR -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by Philadelphia restaurants and hospitality businesses</p>
        <BrandLogos />
      </div>
    </section>

    <!-- SECTION 1: THE PROBLEM — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="problem">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">The Challenge</span>
            <h2 class="swt-h2 swt-h2--light">Philadelphia Restaurants Are Losing the Battle Against Their Windows</h2>
            <p>Floor-to-ceiling windows look stunning on a restaurant's Instagram feed. In practice, they create a daily operational headache — dining tables near windows that guests actively avoid at brunch, servers squinting through afternoon glare, and kitchens where staff near west-facing windows struggle through summer shifts.</p>
            <p>Philadelphia's changing climate has made this worse. The city sees more extreme heat days every decade, and large glass fronts that were an architectural advantage now act as solar collectors — heating dining rooms and kitchens from the moment the morning sun hits them until well after sunset.</p>
            <div class="swt-problem-tags">
              <span class="swt-tag swt-tag--red">Dining Table Glare</span>
              <span class="swt-tag swt-tag--red">Kitchen Heat</span>
              <span class="swt-tag swt-tag--red">Staff UV Exposure</span>
              <span class="swt-tag swt-tag--red">Energy Waste</span>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.energy} alt="Restaurant kitchen with staff working near hot west-facing windows in summer heat" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: UV — white bg, image left, text right -->
    <section class="swt-split" id="uv">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.uv} alt="Upscale Philadelphia restaurant dining room with UV-protective window film" loading="lazy" />
            <div class="swt-img-badge">
              <strong>99%</strong>
              <span>UV Blocked</span>
            </div>
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 01</span>
            <h2 class="swt-h2">Block 99% of Harmful UV Rays — Protect Your Staff and Your Guests</h2>
            <p>Restaurant staff working near windows receive the same chronic UV exposure as outdoor workers — without the awareness that usually comes with a job that involves being outside. A server on a 6-hour shift near a south-facing window accumulates significant UV exposure that accumulates over years.</p>
            <p>Beyond staff health, UV is the primary driver of fading in restaurant interiors. Upholstered seating, leather menus, branded displays, and decorative fabrics all degrade irreversibly under chronic UV exposure. Our films block up to 99% of UV transmission, extending the life of everything your guests see.</p>
            <ul class="swt-check-list">
              <li>Reduced skin cancer risk for window-proximate staff</li>
              <li>Protected seating, menus, and decor from fading</li>
              <li>Reduced liability exposure for restaurant ownership</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: ENERGY — alt cream bg, text left, image right -->
    <section class="swt-split swt-split--alt" id="energy">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 02</span>
            <h2 class="swt-h2">Cut Kitchen and Dining Room Cooling Costs Without Replacing a Single Window</h2>
            <p>The solar heat entering through untreated glass is the single largest driver of summer cooling loads in Philadelphia restaurants. A wall of south or west-facing windows can add the equivalent heat output of a 10,000 BTU heater — per window. Your HVAC system fights this from open to close, every single day in peak season.</p>
            <p>Heat-rejecting window film is a fraction of the cost of replacement windows — typically 1/10th the price — and takes a single overnight shift to install with no disruption to service. The payback period for most high-volume restaurants is 18-36 months.</p>
            <div class="swt-energy-metrics">
              <div class="swt-metric">
                <span class="swt-metric__num">30%</span>
                <span class="swt-metric__label">Avg. Cooling Cost Reduction</span>
              </div>
              <div class="swt-metric">
                <span class="swt-metric__num">18–36mo</span>
                <span class="swt-metric__label">Typical Payback Period</span>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.energy} alt="Philadelphia restaurant kitchen with heat-reducing window film installed" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: COMFORT — white bg, image left, text right -->
    <section class="swt-split" id="comfort">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.hero} alt="Philadelphia restaurant dining room with comfortable natural light after window film installation" loading="lazy" />
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 03</span>
            <h2 class="swt-h2">No More Dead Tables — Give Every Seat in the House a Great Experience</h2>
            <p>If you've ever watched a restaurant's hostess quietly steer guests away from certain tables at certain times, you've seen the cost of window glare in real time. Those tables aren't just uncomfortable — they're unprofitable. A 4-top that sits empty for two hours because the afternoon sun makes it unbearable is lost revenue that compounds across a season.</p>
            <p>Our glare-control films eliminate this entirely. The film selectively filters the wavelengths that cause glare while maintaining full natural daylight and outdoor views. Every table in your dining room becomes equally comfortable, equally desirable, equally profitable.</p>
            <blockquote class="swt-inline-quote">
              "We used to close the blinds in the afternoon. Now every table is equally comfortable and the room still looks beautiful at golden hour."
              <cite>— General Manager, Center City Philadelphia restaurant</cite>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: PRIVACY — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="privacy">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow swt-eyebrow--green">Benefit 04</span>
            <h2 class="swt-h2 swt-h2--light">Privacy for Private Dining — Without Closing the Blinds</h2>
            <p>Private dining rooms, executive dinners, and intimate celebrations are central to a restaurant's revenue mix — but they only work when guests feel genuinely secluded. Standard glass walls and large windows can make private dining feel exposed, especially in busy ground-floor spaces.</p>
            <p>Our frosted and decorative films give private dining areas a genuine sense of enclosure without sacrificing natural light. Guests feel comfortable and exclusive, while your dining room retains its open, airy character in the public areas.</p>
            <div class="swt-security-features">
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Frosted & Decorative Films</strong>
                  <p>Elegant, seamless privacy that looks intentional — not like an afterthought</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>One-Way Mirror Options</strong>
                  <p>See out, not in — ideal for ground-floor private dining with street visibility</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>After-Hours Installation</strong>
                  <p>We install when your kitchen is cool and your dining room is empty</p>
                </div>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.privacy} alt="Restaurant bar area with evening privacy film applied" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY — 5 images -->
    <section class="swt-gallery" id="gallery">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">Our Work</span>
          <h2 class="swt-h2 swt-h2--center">Window Film — In Action</h2>
          <p class="swt-subhead">From Center City fine dining to South Philly casual spots — here's what we install.</p>
        </div>
        <div class="swt-gallery__grid">
          {galleryImages.map((img, i) => (
            <div class="swt-gallery__item fade-in" style={`--delay: ${i * 80}ms`}>
              <img src={img.src} alt={img.label} loading="lazy" />
              <div class="swt-gallery__overlay">
                <span>{img.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STATS BAR — accent green -->
    <section class="swt-stats">
      <div class="container">
        <div class="swt-stats__row">
          <div class="swt-stats__item fade-in">
            <span class="swt-stats__num">16+</span>
            <span class="swt-stats__label">Years in Philadelphia</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 80ms">
            <span class="swt-stats__num">500+</span>
            <span class="swt-stats__label">Commercial Projects</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 160ms">
            <span class="swt-stats__num">99%</span>
            <span class="swt-stats__label">UV Rays Blocked</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 240ms">
            <span class="swt-stats__num">30%</span>
            <span class="swt-stats__label">Avg. Energy Savings</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS — 4 steps -->
    <section class="swt-process">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">How It Works</span>
          <h2 class="swt-h2 swt-h2--center">4 Simple Steps to a Better Restaurant</h2>
        </div>
        <div class="swt-process__steps">
          <div class="swt-process__step fade-in">
            <div class="swt-process__num">01</div>
            <div class="swt-process__body">
              <h3>Restaurant Assessment</h3>
              <p>We visit your restaurant during service hours to see where your real problem areas are — the dining tables guests avoid, the kitchen stations that can't retain staff, the private dining area that feels exposed. You receive a detailed proposal with specific film recommendations within 24 hours.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 80ms">
            <div class="swt-process__num">02</div>
            <div class="swt-process__body">
              <h3>Menu of Film Options</h3>
              <p>We present you with a curated range of film options — from nearly invisible clear films to frosted privacy options — matched to your aesthetic, your budget, and your specific glare and heat challenges. We bring samples to your actual space so you can see exactly what you're getting.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 160ms">
            <div class="swt-process__num">03</div>
            <div class="swt-process__body">
              <h3>After-Hours Installation</h3>
              <p>Restaurant installations happen after close, typically starting at 10pm or later, so your dining room and kitchen are fully operational the next day. We work through the night, clean up completely, and leave nothing behind but comfortable windows.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 240ms">
            <div class="swt-process__num">04</div>
            <div class="swt-process__body">
              <h3>Reopening Ready</h3>
              <p>We walk the space with you before your next service. Every installation is backed by our labor warranty and the manufacturer's material warranty — typically 10-15 years on commercial films. Your guests notice the difference the moment they walk in.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS — dark bg -->
    <section class="swt-testimonials">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow swt-eyebrow--green">Client Stories</span>
          <h2 class="swt-h2 swt-h2--center swt-h2--light">Real Results from Real Restaurants</h2>
        </div>
        <div class="swt-testimonials__grid">
          <div class="swt-testimonial fade-in">
            <div class="swt-testimonial__quote">"</div>
            <p>We had a section of four tables that we essentially lost from 2pm to 5pm every day because of the glare off the building across the street. After the film went in, those tables are some of our most requested for the view. The installation was done overnight — we opened the next day and our regulars thought we'd done a renovation.</p>
            <div class="swt-testimonial__author">
              <strong>Maria C.</strong>
              <span>Owner, Rittenhouse Square restaurant</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 80ms">
            <div class="swt-testimonial__quote">"</div>
            <p>Our line cooks near the west windows were miserable every summer. We tried portable fans, but it was heat radiating through the glass that was the real problem. The film made a genuine difference — those stations are comfortable now, and our turnover in those positions dropped significantly. The crew noticed it immediately.</p>
            <div class="swt-testimonial__author">
              <strong>James T.</strong>
              <span>Executive Chef, Fishtown</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 160ms">
            <div class="swt-testimonial__quote">"</div>
            <p>We host a lot of private dinners for corporate clients and the exposed glass wall in our private room always made it feel less exclusive than it should. The frosted film transformed the space — it feels genuinely private now, but it's still bright and elegant. The installation happened after a Saturday service and we were fully booked that Sunday night.</p>
            <div class="swt-testimonial__author">
              <strong>Sophie L.</strong>
              <span>Events Manager, Old City restaurant</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="swt-faq" id="faq">
      <div class="container">
        <div class="swt-faq__layout">
          <div class="swt-faq__header fade-in">
            <span class="swt-eyebrow">Questions</span>
            <h2 class="swt-h2">Frequently Asked Questions</h2>
            <p>Honest answers from people who've been doing this in Philadelphia for over 16 years.</p>
            <a href="/contact/" class="swt-btn swt-btn--primary">Talk to a Specialist</a>
          </div>
          <div class="swt-faq__list fade-in">
            {faqItems.map((item) => (
              <div class="swt-faq__item">
                <div class="swt-faq__q">
                  <span>{item.question}</span>
                  <span class="swt-faq__toggle">+</span>
                </div>
                <div class="swt-faq__a">
                  <p>{item.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA BANNER -->
    <section class="swt-cta">
      <div class="swt-cta__inner">
        <div class="swt-cta__text">
          <h2>Ready to <em>transform</em> your restaurant?</h2>
          <p>Get a free consultation and thermal analysis. No obligation, no pressure — just honest advice from a team that's been doing this in Philadelphia for 16 years.</p>
        </div>
        <div class="swt-cta__btns">
          <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Quote</a>
          <a href="tel:+126****7980" class="swt-btn swt-btn--ghost-light">Call (267) 394-7980</a>
        </div>
      </div>
    </section>

  </div><!-- /swt-body -->
</BaseLayout>

<style>
  /* ══════════════════════════════════════
     BRAND TOKENS (local override)
     ══════════════════════════════════════ */
  :root {
    --swt-green:        #4E6B2A;
    --swt-green-accent: #83A94A;
    --swt-dark:         #2A241E;
    --swt-cream:        #F4EFE6;
    --swt-alt:          #ECE4D4;
    --swt-border:       #E1D6C1;
    --swt-text-sec:     #6E665C;
    --swt-gold:         #846212;
    --swt-white:        #ffffff;
    --swt-radius:       5px;
  }

  /* ══════════════════════════════════════
     HERO
     ══════════════════════════════════════ */
  .swt-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .swt-hero__img {
    position: absolute;
    inset: 0;
  }
  .swt-hero__img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .swt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(42,36,30,0.9) 0%, rgba(42,36,30,0.6) 50%, rgba(42,36,30,0.35) 100%);
  }
