  }
  .of-space-card__badge-content {
    position: absolute;
    inset: 0;
    z-index: 5;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .of-space-card__badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #7CB342;
    background: rgba(124,179,66,0.12);
    border: 1px solid rgba(124,179,66,0.22);
    padding: 5px 10px;
    border-radius: 100px;
    margin-bottom: 10px;
    align-self: flex-start;
  }
  .of-space-card__badge-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #F3F6F1;
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .of-space-card__badge-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: rgba(243,246,241,0.72);
    line-height: 1.55;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .of-space-card--hero { grid-column: span 12; min-height: auto; }
    .of-space-card--photo { grid-column: span 6; }
    .of-space-card--dark,
    .of-space-card--dark-pattern,
    .of-space-card--badge { grid-column: span 4; }
  }
  @media (max-width: 768px) {
    .of-spaces { padding: 64px 20px; }
    .of-space-card--hero,
    .of-space-card--photo,
    .of-space-card--dark,
    .of-space-card--dark-pattern,
    .of-space-card--badge { grid-column: span 12; }
    .of-space-card--photo { min-height: 280px; }
  }

  /* ══════════════════════════════════════
     BENEFIT ROWS
  ══════════════════════════════════════ */
  .of-benefits {
    background: #F3F6F1;
    padding: 100px 24px;
  }
  .of-benefits__container {
    max-width: 1200px;
    margin: 0 auto;
  }
