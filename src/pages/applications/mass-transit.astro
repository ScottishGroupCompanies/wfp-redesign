  .of-space-card__accent-line {
    position: absolute;
    top: 0; left: 32px; right: 32px;
    height: 2px;
    background: linear-gradient(90deg, #7CB342, transparent);
  }
  .of-space-card__icon-row { margin-bottom: 18px; }
  .of-space-card__dark-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #F3F6F1;
    margin-bottom: 10px;
    line-height: 1.25;
  }
  .of-space-card__dark-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    color: rgba(243,246,241,0.72);
    line-height: 1.65;
    margin: 0 0 16px;
    flex: 1;
  }
  .of-space-card__micro-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
