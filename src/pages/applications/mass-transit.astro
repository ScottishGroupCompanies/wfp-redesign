  /* Grid */
  .of-spaces__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
  }
  .of-space-card {
    border-radius: 24px;
    transition: transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94), box-shadow 0.3s ease, border-color 0.3s ease;
  }

  /* Card 1: Hero — spans 6 cols */
  .of-space-card--hero {
    grid-column: span 6;
    background: linear-gradient(145deg, #1a3024 0%, #0d1a0f 60%);
    border: 1px solid rgba(124,179,66,0.15);
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0 4px 24px rgba(0,0,0,0.2);
    min-height: 420px;
  }
  .of-space-card--hero:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); border-color: rgba(124,179,66,0.25); }
  .of-space-card__hero-icon { margin-bottom: 24px; }
  .of-space-card__hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    font-weight: 700;
    color: #F3F6F1;
    line-height: 1.2;
    margin-bottom: 16px;
  }
  .of-space-card__hero-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: rgba(243,246,241,0.7);
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .of-space-card__pill {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #7CB342;
    background: rgba(124,179,66,0.12);
    border: 1px solid rgba(124,179,66,0.25);
    padding: 6px 14px;
    border-radius: 100px;
    align-self: flex-start;
  }

  /* Cards 2 & 3: Photo — each spans 3 cols */
  .of-space-card--photo {
    grid-column: span 3;
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    min-height: 420px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .of-space-card--photo:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); }
  .of-space-card--photo:hover .of-space-card__img { transform: scale(1.04); }
  .of-space-card__img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    inset: 0;
    transition: transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .of-space-card__photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,20,14,0.88) 0%, rgba(10,20,14,0.3) 55%, rgba(10,20,14,0.05) 100%);
  }
  .of-space-card__photo-content {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 28px;
    z-index: 5;
  }
  .of-space-card__photo-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: #F3F6F1;
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .of-space-card__photo-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: rgba(243,246,241,0.75);
    line-height: 1.5;
    margin: 0;
  }

  /* Cards 4 & 5: Dark — each spans 4 cols */
  .of-space-card--dark,
  .of-space-card--dark-pattern {
    grid-column: span 4;
    border-radius: 24px;
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-shadow: 0 4px 20px rgba(0,0,0,0.18);
    position: relative;
    overflow: hidden;
    min-height: 280px;
  }
  .of-space-card--dark {
    background: linear-gradient(145deg, #14201a 0%, #0d1a0f 100%);
    border: 1px solid rgba(124,179,66,0.18);
  }
  .of-space-card--dark-pattern {
    background: linear-gradient(145deg, #1a2e20 0%, #0d1a0f 100%);
    border: 1px solid rgba(124,179,66,0.12);
  }
  .of-space-card--dark-pattern::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(124,179,66,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(124,179,66,0.04) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
