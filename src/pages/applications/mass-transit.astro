  /* ══════════════════════════════════════
     OFFICE SPACE TYPE GRID
  ══════════════════════════════════════ */
  .of-spaces {
    background: #0d1a0f;
    padding: 100px 24px;
  }
  .of-spaces__container { max-width: 1200px; margin: 0 auto; }
  .of-spaces__header {
    text-align: center;
    margin-bottom: 60px;
  }
  .of-spaces__eyebrow {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #7CB342;
    margin-bottom: 14px;
  }
  .of-spaces__headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: #F3F6F1;
