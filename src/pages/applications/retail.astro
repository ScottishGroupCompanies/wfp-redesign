---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Retail Window Film in Philadelphia | UV Protection, Energy Savings & Store Security';
const description = 'Window film for Philadelphia retail stores: protect merchandise from UV fading, reduce cooling costs, improve customer comfort, and enhance store security. Professional installation by certified technicians.';

const galleryImages = [
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175444_b1c0fb4b-7e18-435c-ac74-ba416ff51fe1.png', label: 'Retail Storefront' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175446_f320deaf-2e71-4adf-917d-371be97bdf92.png', label: 'Boutique Interior' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175728_a7ad634b-4336-45a2-a8a4-b760f30566c9.png', label: 'Mall Store' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175448_2451a1a4-f064-491b-90fe-f63b8877331c.png', label: 'Jewelry Store Security' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175513_9a474dbe-6be1-4a2b-8bb9-8ef4cbf58388.png', label: 'Decorative Film' },
];

const newImages = {
  hero: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175444_b1c0fb4b-7e18-435c-ac74-ba416ff51fe1.png',
  uvInterior: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175446_f320deaf-2e71-4adf-917d-371be97bdf92.png',
  energyMall: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175728_a7ad634b-4336-45a2-a8a4-b760f30566c9.png',
  securityJewelry: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175448_2451a1a4-f064-491b-90fe-f63b8877331c.png',
};

const faqItems = [
  { question: 'How does window film prevent merchandise fading?', answer: 'Window film blocks up to 99% of UV-A and UV-B rays — the primary cause of fading in fabrics, artwork, leather goods, and branded displays. Even indirect UV passing through glass causes cumulative, irreversible damage over time. Our films stop it at the source.' },
  { question: 'Will customers feel the heat difference immediately?', answer: 'Yes. Heat-rejecting window film reduces solar heat transmission significantly. On hot Philadelphia summer days, customers will notice the difference the moment they walk in — especially near large display windows. This improves comfort, extends browsing time, and reduces your air conditioning load.' },
  { question: 'Can decorative film match our brand colors?', answer: 'Absolutely. Decorative and frosted films come in a wide range of colors, patterns, and opacity levels. We can create custom designs that incorporate your brand palette — perfect for fitting rooms, partition walls, store entryways, and feature windows.' },
  { question: 'How effective is security film against smash-and-grab?', answer: 'Security film holds glass together on impact, making it significantly harder and slower to break through. For smash-and-grab threats — a growing concern for Philadelphia retailers — this delay (3–7 minutes) is often enough to deter opportunists or allow security response. It also reduces liability from glass shards.' },
  { question: 'Does film affect visibility of products from outside?', answer: 'It depends on the film type. Clear safety and UV films are virtually invisible. Privacy films create a one-way effect during daytime. Decorative frosted films obscure the interior while maintaining a premium appearance. We\'ll help you choose the right balance for your store\'s display strategy.' },
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Retail Window Film Installation"
  serviceDesc="Professional window film installation for Philadelphia retail stores — UV protection, energy efficiency, customer comfort, security, and decorative branding."
  serviceUrl="https://www.windowfilmphiladelphia.com/applications/retail"
  faqItems={faqItems}
>
  <!-- HERO -->
  <section class="swt-hero">
    <div class="swt-hero__img">
      <img src={newImages.hero} alt="Retail storefront with window glare issues" width="1440" height="700" />
      <div class="swt-hero__overlay"></div>
    </div>
    <div class="swt-hero__content">
      <span class="swt-badge">
        <svg width="8" height="8" viewBox="0 0 8 8" fill="none"><circle cx="4" cy="4" r="4" fill="#4E6B2A"/></svg>
        Retail Window Solutions
      </span>
      <h1 class="swt-hero__title">
        Protect Your Merchandise.<br/>
        <em>Delight Your Customers.</em><br/>
        Cut Your Energy Bills.
      </h1>
      <p class="swt-hero__sub">Block 99% of UV rays, eliminate storefront glare, and cut cooling costs by up to 30% — installed in your Philadelphia retail space with minimal disruption to your business.</p>
      <div class="swt-hero__ctas">
        <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Quote</a>
        <a href="#benefits" class="swt-btn swt-btn--ghost-light">See Benefits</a>
      </div>
    </div>
  </section>

  <div class="swt-body">

    <!-- TRUST BAR -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by leading Philadelphia retailers</p>
        <BrandLogos />
      </div>
    </section>

    <!-- SECTION 1: THE PROBLEM — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="problem">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">The Challenge</span>
            <h2 class="swt-h2 swt-h2--light">Philadelphia Retailers Are Losing Revenue to Their Own Windows</h2>
            <p>Large display windows are a retailer's best marketing tool — and their biggest operational liability. Philadelphia's intense summer sun floods through untreated glass, heating your store, fading your merchandise, and making customers uncomfortable within minutes of walking in.</p>
            <p>UV rays don't just fade clothing and accessories. They degrade leather goods, artwork, signage, and point-of-purchase displays. Every hour your best-sellers sit in that sunlit window is an hour of irreversible damage and perceived value loss.</p>
            <div class="swt-problem-tags">
              <span class="swt-tag swt-tag--red">UV Fading</span>
              <span class="swt-tag swt-tag--red">Solar Heat Gain</span>
              <span class="swt-tag swt-tag--red">Customer Discomfort</span>
              <span class="swt-tag swt-tag--red">Security Risk</span>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.hero} alt="Retail storefront suffering from sun glare and heat" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: UV — white bg, image left, text right -->
    <section class="swt-split" id="uv">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.uvInterior} alt="Upscale boutique interior with UV protection film" loading="lazy" />
            <div class="swt-img-badge">
              <strong>99%</strong>
              <span>UV Blocked</span>
            </div>
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 01</span>
            <h2 class="swt-h2">Block 99% of UV Rays — Stop Merchandise Fading at the Source</h2>
            <p>UV radiation is the primary driver of fading in retail merchandise. Fabrics, leather, artwork, and branded displays all degrade irreversibly under chronic UV exposure. Your most expensive items — displayed prominently in sunlit windows — are the most vulnerable.</p>
            <p>Our window films block up to 99% of UV transmission, extending the life and appearance of everything in your store. This means less spoilage, fewer markdowns on sun-damaged goods, and protected brand presentation.</p>
            <ul class="swt-check-list">
              <li>Protected merchandise from irreversible UV fading</li>
              <li>Extended lifespan of leather goods and premium displays</li>
              <li>Reduced spoilage and markdown requirements</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: ENERGY — alt cream bg, text left, image right -->
    <section class="swt-split swt-split--alt" id="energy">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 02</span>
            <h2 class="swt-h2">Cut Cooling Costs by 30% — Without Renovating Your Store</h2>
            <p>Large storefront windows are the primary driver of summer cooling loads in Philadelphia retail spaces. A sun-facing wall of glass can add the equivalent heat of a 6,000 BTU heater per window. Your HVAC system runs constantly to compensate, and your energy bills reflect it.</p>
            <p>Heat-rejecting window film is a fraction of the cost of window replacement — typically 1/10th — and installs in hours rather than weeks. The payback period is usually 2–4 years, after which the savings are pure operational profit.</p>
            <div class="swt-energy-metrics">
              <div class="swt-metric">
                <span class="swt-metric__num">30%</span>
                <span class="swt-metric__label">Avg. Cooling Cost Reduction</span>
              </div>
              <div class="swt-metric">
                <span class="swt-metric__num">2–4yr</span>
                <span class="swt-metric__label">Typical Payback Period</span>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.energyMall} alt="Philadelphia mall corridor with large glass storefronts" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: COMFORT — white bg, image left, text right -->
    <section class="swt-split" id="comfort">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.uvInterior} alt="Comfortable retail shopping environment with window film" loading="lazy" />
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 03</span>
            <h2 class="swt-h2">Keep Customers Browsing Longer — Not Fleeing the Heat</h2>
            <p>Customer comfort directly affects purchase behavior. When shoppers enter a store that's significantly warmer near the windows, they instinctively gravitate toward the cooler back sections — missing your prime window displays entirely. Worse, they cut their visit short.</p>
            <p>Our films reduce hot spots and eliminate the oppressive feeling of standing near sunlit glass. Customers stay longer, browse more thoroughly, and associate your store with a comfortable, premium shopping experience.</p>
            <blockquote class="swt-inline-quote">
              "Customers used to comment on how hot it was near our entrance. After the film, nobody says anything — because there's nothing to notice. The comfort is just... normal now."
              <cite>— Store Manager, boutique, Reading Terminal Market</cite>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: SECURITY — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="security">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow swt-eyebrow--green">Benefit 04</span>
            <h2 class="swt-h2 swt-h2--light">Security Film: Deter Smash-and-Grab with Glass That Holds</h2>
            <p>Philadelphia retailers face growing smash-and-grab risk. Standard glass shatters on impact, giving thieves instant access. Security window film holds shattered panes in the frame — making forced entry dramatically harder and slower. That 3–7 minute delay often changes a thief's calculus entirely.</p>
            <p>Beyond theft deterrence, security film reduces liability from dangerous glass shards and protects your storefront from storm damage — a real consideration for Philadelphia's occasional severe weather events.</p>
            <div class="swt-security-features">
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Smash-and-Grab Deterrence</strong>
                  <p>Glass holds in frame on impact — critical delay for security response</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Storm Protection</strong>
                  <p>Holds glass together during severe weather and wind events</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Reduced Liability</strong>
                  <p>No dangerous glass shards — protects staff and customers</p>
                </div>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.securityJewelry} alt="Jewelry store with security window film protection" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY — 5 images -->
    <section class="swt-gallery" id="gallery">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">Our Work</span>
          <h2 class="swt-h2 swt-h2--center">Window Film — In Action</h2>
          <p class="swt-subhead">From high-end boutiques to large retail chains — here's what we install.</p>
        </div>
        <div class="swt-gallery__grid">
          {galleryImages.map((img, i) => (
            <div class="swt-gallery__item fade-in" style={`--delay: ${i * 80}ms`}>
              <img src={img.src} alt={img.label} loading="lazy" />
              <div class="swt-gallery__overlay">
                <span>{img.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STATS BAR — accent green -->
    <section class="swt-stats">
      <div class="container">
        <div class="swt-stats__row">
          <div class="swt-stats__item fade-in">
            <span class="swt-stats__num">16+</span>
            <span class="swt-stats__label">Years in Philadelphia</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 80ms">
            <span class="swt-stats__num">500+</span>
            <span class="swt-stats__label">Commercial Projects</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 160ms">
            <span class="swt-stats__num">99%</span>
            <span class="swt-stats__label">UV Rays Blocked</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 240ms">
            <span class="swt-stats__num">30%</span>
            <span class="swt-stats__label">Avg. Energy Savings</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS — 4 steps -->
    <section class="swt-process">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">How It Works</span>
          <h2 class="swt-h2 swt-h2--center">4 Simple Steps to a Better Retail Space</h2>
        </div>
        <div class="swt-process__steps">
          <div class="swt-process__step fade-in">
            <div class="swt-process__num">01</div>
            <div class="swt-process__body">
              <h3>Store Assessment</h3>
              <p>We visit your retail location and analyze window orientation, sun exposure patterns, and security needs. You receive a detailed proposal within 24 hours with the optimal film recommendations for your merchandise and budget.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 80ms">
            <div class="swt-process__num">02</div>
            <div class="swt-process__body">
              <h3>Custom Film Recommendations</h3>
              <p>From clear UV protection to decorative branding films, we match the right product to your specific needs — considering aesthetics, heat rejection, security, and your brand identity.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 160ms">
            <div class="swt-process__num">03</div>
            <div class="swt-process__body">
              <h3>After-Hours Installation</h3>
              <p>We schedule installation around your business hours — typically evenings or weekends — so your store stays open. Our professional installers work cleanly and efficiently, leaving your space spotless.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 240ms">
            <div class="swt-process__num">04</div>
            <div class="swt-process__body">
              <h3>Display Reconfiguration</h3>
              <p>After installation, we help you reorganize your window displays to take full advantage of your new comfortable, UV-protected environment. Your best merchandise deserves to be seen in its best light — literally.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS — dark bg -->
    <section class="swt-testimonials">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow swt-eyebrow--green">Client Stories</span>
          <h2 class="swt-h2 swt-h2--center swt-h2--light">Real Results from Real Retailers</h2>
        </div>
        <div class="swt-testimonials__grid">
          <div class="swt-testimonial fade-in">
            <div class="swt-testimonial__quote">"</div>
            <p>We had a jewelry display near the window that kept getting cloudy and tarnished within weeks. UV film completely solved it — the pieces stay pristine now. The ROI was obvious within the first month.</p>
            <div class="swt-testimonial__author">
              <strong>Amanda K.</strong>
              <span>Owner, Diamonds & Dust, Manayunk</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 80ms">
            <div class="swt-testimonial__quote">"</div>
            <p>My boutique is small and every square foot matters. The film made the front of the store so much more comfortable that customers are actually shopping that section now. Before, they would literally walk past the window displays to get to the back.</p>
            <div class="swt-testimonial__author">
              <strong>Marcus J.</strong>
              <span>Owner, Thread & Needle, South Street</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 160ms">
            <div class="swt-testimonial__quote">"</div>
            <p>After-hours installation was a game-changer for us. We didn't lose a single day of sales. The team was professional, fast, and left the store spotless. I was skeptical it could be that smooth — it was.</p>
            <div class="swt-testimonial__author">
              <strong>Patricia M.</strong>
              <span>Store Director, lifestyle brand, King of Prussia</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="swt-faq" id="faq">
      <div class="container">
        <div class="swt-faq__layout">
          <div class="swt-faq__header fade-in">
            <span class="swt-eyebrow">Questions</span>
            <h2 class="swt-h2">Frequently Asked Questions</h2>
            <p>Honest answers from people who've been doing this in Philadelphia for over 16 years.</p>
            <a href="/contact/" class="swt-btn swt-btn--primary">Talk to a Specialist</a>
          </div>
          <div class="swt-faq__list fade-in">
            {faqItems.map((item) => (
              <div class="swt-faq__item">
                <div class="swt-faq__q">
                  <span>{item.question}</span>
                  <span class="swt-faq__toggle">+</span>
                </div>
                <div class="swt-faq__a">
                  <p>{item.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA BANNER -->
    <section class="swt-cta">
      <div class="swt-cta__inner">
        <div class="swt-cta__text">
          <h2>Ready to <em>transform</em> your retail space?</h2>
          <p>Get a free consultation and thermal analysis. No obligation, no pressure — just honest advice.</p>
        </div>
        <div class="swt-cta__btns">
          <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Quote</a>
          <a href="tel:+126****7980" class="swt-btn swt-btn--ghost-light">Call (267) 394-7980</a>
        </div>
      </div>
    </section>

  </div><!-- /swt-body -->
</BaseLayout>

<style>
  /* ══════════════════════════════════════
     BRAND TOKENS (local override)
     ══════════════════════════════════════ */
  :root {
    --swt-green:        #4E6B2A;
    --swt-green-accent: #83A94A;
    --swt-dark:         #2A241E;
    --swt-cream:        #F4EFE6;
    --swt-alt:          #ECE4D4;
    --swt-border:       #E1D6C1;
    --swt-text-sec:     #6E665C;
    --swt-gold:         #846212;
    --swt-white:        #ffffff;
    --swt-radius:       5px;
  }

  /* ══════════════════════════════════════
     HERO
     ══════════════════════════════════════ */
  .swt-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .swt-hero__img {
    position: absolute;
    inset: 0;
  }
  .swt-hero__img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .swt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(42,36,30,0.9) 0%, rgba(42,36,30,0.6) 50%, rgba(42,36,30,0.35) 100%);
  }
  .swt-hero__content {
    position: relative;
    z-index: 1;
    padding: 110px 8% 90px;
    max-width: 720px;
  }
  .swt-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
    background: rgba(78,107,42,0.25);
    color: rgba(255,255,255,0.75);
    border: 1px solid rgba(78,107,42,0.4);
  }
  .swt-hero__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(38px, 5.5vw, 66px);
    font-weight: 400;
    color: var(--swt-white);
    line-height: 1.1;
    margin: 0 0 20px;
  }
  .swt-hero__title em {
    font-style: italic;
    color: var(--swt-green-accent);
  }
  .swt-hero__sub {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 17px;
    color: rgba(255,255,255,0.65);
    line-height: 1.7;
    margin: 0 0 36px;
    max-width: 500px;
  }
  .swt-hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ══════════════════════════════════════
     BUTTONS
     ══════════════════════════════════════ */
  .swt-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .swt-btn--primary {
    background: var(--swt-green);
    color: var(--swt-white);
    border-color: var(--swt-green);
  }
  .swt-btn--primary:hover {
    background: #3D5620;
    border-color: #3D5620;
    transform: translateY(-2px);
  }
  .swt-btn--ghost-light {
    background: transparent;
    color: rgba(255,255,255,0.8);
    border-color: rgba(255,255,255,0.35);
  }
  .swt-btn--ghost-light:hover {
    color: #fff;
    border-color: rgba(255,255,255,0.65);
    background: rgba(255,255,255,0.06);
  }
  .swt-btn--ghost {
    background: transparent;
