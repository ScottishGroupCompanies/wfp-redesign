    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
  }
  .of-space-card {
    border-radius: 24px;
    transition: transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94), box-shadow 0.3s ease, border-color 0.3s ease;
  }

  /* Card 1: Hero — spans 6 cols */
  .of-space-card--hero {
    grid-column: span 6;
    background: linear-gradient(145deg, #1a3024 0%, #0d1a0f 60%);
    border: 1px solid rgba(124,179,66,0.15);
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0 4px 24px rgba(0,0,0,0.2);
    min-height: 420px;
  }
  .of-space-card--hero:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); border-color: rgba(124,179,66,0.25); }
  .of-space-card__hero-icon { margin-bottom: 24px; }
  .of-space-card__hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    font-weight: 700;
    color: #F3F6F1;
    line-height: 1.2;
    margin-bottom: 16px;
  }
  .of-space-card__hero-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: rgba(243,246,241,0.7);
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .of-space-card__pill {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #7CB342;
    background: rgba(124,179,66,0.12);
    border: 1px solid rgba(124,179,66,0.25);
    padding: 6px 14px;
    border-radius: 100px;
    align-self: flex-start;
  }

  /* Cards 2 & 3: Photo — each spans 3 cols */
  .of-space-card--photo {
    grid-column: span 3;
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    min-height: 420px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .of-space-card--photo:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); }
  .of-space-card--photo:hover .of-space-card__img { transform: scale(1.04); }
  .of-space-card__img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    inset: 0;
    transition: transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .of-space-card__photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,20,14,0.88) 0%, rgba(10,20,14,0.3) 55%, rgba(10,20,14,0.05) 100%);
  }
  .of-space-card__photo-content {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 28px;
    z-index: 5;
  }
  .of-space-card__photo-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: #F3F6F1;
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .of-space-card__photo-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: rgba(243,246,241,0.75);
    line-height: 1.5;
    margin: 0;
  }

  /* Card 4: Dark — spans 12 cols full width row */
  .of-space-card--dark {
    grid-column: span 12;
    border-radius: 24px;
    padding: 36px 40px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-shadow: 0 4px 20px rgba(0,0,0,0.18);
    position: relative;
    overflow: hidden;
    background: linear-gradient(145deg, #14201a 0%, #0d1a0f 100%);
    border: 1px solid rgba(124,179,66,0.18);
  }
  .of-space-card--dark:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.28); border-color: rgba(124,179,66,0.28); }
  .of-space-card__accent-line {
    position: absolute;
    top: 0; left: 40px; right: 40px;
    height: 2px;
    background: linear-gradient(90deg, #7CB342, transparent);
  }
  .of-space-card__icon-row { margin-bottom: 18px; }
  .of-space-card__dark-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #F3F6F1;
    margin-bottom: 10px;
    line-height: 1.25;
  }
  .of-space-card__dark-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    color: rgba(243,246,241,0.72);
    line-height: 1.65;
    margin: 0 0 16px;
    max-width: 700px;
  }
  .of-space-card__micro-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: rgba(124,179,66,0.85);
    background: rgba(124,179,66,0.08);
    border: 1px solid rgba(124,179,66,0.18);
    padding: 5px 10px;
    border-radius: 100px;
    align-self: flex-start;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .of-space-card--hero { grid-column: span 12; min-height: auto; }
    .of-space-card--photo { grid-column: span 6; }
    .of-space-card--dark { grid-column: span 12; }
  }
  @media (max-width: 768px) {
    .of-spaces { padding: 64px 20px; }
    .of-space-card--hero,
    .of-space-card--photo,
    .of-space-card--dark { grid-column: span 12; }
    .of-space-card--photo { min-height: 280px; }
  }

  /* ══════════════════════════════════════
     BENEFIT ROWS
  ══════════════════════════════════════ */
  .of-benefits {
    background: #F3F6F1;
    padding: 100px 24px;
  }
  .of-benefits__container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .of-benefits__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 72px;
  }
  .of-benefits__eyebrow {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7CB342;
    margin-bottom: 8px;
  }
  .of-benefits__headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: #14201A;
    margin: 12px 0 20px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .of-benefits__intro {
    font-family: 'Inter', sans-serif;
    font-size: 1.0625rem;
    color: #4A5C48;
    line-height: 1.75;
  }
  .of-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
    margin-bottom: 80px;
  }
  .of-row:last-child { margin-bottom: 0; }
  .of-row--rev { direction: rtl; }
  .of-row--rev > * { direction: ltr; }
  .of-row__image {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(13,26,15,0.12);
    position: relative;
  }
  .of-row__image::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(124,179,66,0.15);
    border-radius: 16px;
    pointer-events: none;
    z-index: 2;
  }
  .of-row__image img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .of-row__image:hover img { transform: scale(1.03); }
  .of-row__text { display: flex; flex-direction: column; }
  .of-row__eyebrow {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7CB342;
    margin-bottom: 12px;
  }
  .of-row__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.35rem, 2.5vw, 1.875rem);
    font-weight: 700;
    color: #14201A;
    margin: 0 0 20px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .of-row__body {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: #4A5C48;
    line-height: 1.8;
    margin: 0 0 20px;
  }
  .of-row__body a { color: #7CB342; text-decoration: underline; text-decoration-color: #7CB342; text-underline-offset: 3px; font-weight: 500; transition: color 0.2s ease; }
  .of-row__body a:hover { color: #2E6B30; text-decoration-color: #2E6B30; }
  .of-row__bullets {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .of-row__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    color: #14201A;
    line-height: 1.5;
  }
  .of-row__bullets svg { flex-shrink: 0; margin-top: 2px; }

  @media (max-width: 900px) {
    .of-benefits { padding: 64px 20px; }
    .of-row { grid-template-columns: 1fr; gap: 40px; margin-bottom: 64px; }
    .of-row--rev { direction: ltr; }
    .of-row__image img { height: 320px; }
    .of-benefits__header { margin-bottom: 48px; }
  }

  /* ══════════════════════════════════════
     FILM TYPES SLIDER
  ══════════════════════════════════════ */
  .of-ftype { position: relative; width: 100%; min-height: 90vh; overflow: hidden; background: #14201A; }
  .of-ftype__track { display: flex; width: 100%; height: 100%; transition: transform 0.6s cubic-bezier(0.4,0,0.2,1); will-change: transform; }
  .of-ftype__slide { position: relative; min-width: 100%; min-height: 90vh; flex-shrink: 0; display: flex; align-items: center; }
  .of-ftype__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; z-index: 0; }
  .of-ftype__overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.80) 0%, rgba(0,0,0,0.25) 60%, transparent 100%); z-index: 1; }
  .of-ftype__content { position: relative; z-index: 2; max-width: 560px; padding-left: 80px; color: #fff; opacity: 0; transform: translateY(20px); transition: opacity 0.5s ease 0.1s, transform 0.5s ease 0.1s; }
  .of-ftype-active .of-ftype__content { opacity: 1; transform: translateY(0); }
  .of-ftype__step { font-family: 'Space Mono', monospace; font-size: 13px; color: #7CB342; letter-spacing: 0.2em; margin-bottom: 1rem; }
  .of-ftype__title { font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 4vw, 3.25rem); font-weight: 700; color: #fff; line-height: 1.1; margin: 0 0 1.5rem; white-space: pre-line; }
  .of-ftype__desc { font-family: 'Inter', sans-serif; font-size: 16px; line-height: 1.8; color: rgba(255,255,255,0.85); max-width: 460px; margin-bottom: 2rem; }
  .of-ftype__faq { display: flex; flex-direction: column; gap: 8px; margin-bottom: 2rem; }
  .of-ftype__faq-item { border-radius: 8px; overflow: hidden; }
  .of-ftype__faq-q { width: 100%; background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: rgba(255,255,255,0.88); font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 500; padding: 12px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center; gap: 12px; cursor: pointer; transition: background 0.2s ease; }
  .of-ftype__faq-q:hover { background: rgba(255,255,255,0.18); }
  .of-ftype__faq-icon { font-size: 1.2rem; color: #7CB342; flex-shrink: 0; transition: transform 0.3s ease; }
  .of-ftype__faq-a { background: rgba(255,255,255,0.08); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.10); border-top: none; border-radius: 0 0 8px 8px; color: rgba(255,255,255,0.70); font-family: 'Inter', sans-serif; font-size: 0.875rem; line-height: 1.6; padding: 12px 16px; margin-top: -4px; }
  .of-ftype__cta { display: inline-block; background: #7CB342; color: #fff; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; padding: 14px 32px; border-radius: 9999px; text-decoration: none; transition: background 0.25s ease, transform 0.2s ease; }
  .of-ftype__cta:hover { background: #2E6B30; transform: translateY(-2px); }
  .of-ftype__nav { position: absolute; top: 50%; right: 48px; transform: translateY(-50%); z-index: 10; display: flex; flex-direction: column; gap: 20px; }
  .of-ftype__nav-item { display: flex; align-items: center; gap: 12px; background: transparent; border: none; cursor: pointer; padding: 0; opacity: 0.35; transition: opacity 0.3s ease; }
  .of-ftype__nav-item:hover { opacity: 0.65; }
  .of-ftype__nav-item--active { opacity: 1; }
  .of-ftype__nav-line { display: block; width: 3px; height: 28px; background: rgba(255,255,255,0.4); border-radius: 2px; transition: background 0.3s ease, height 0.3s ease; }
  .of-ftype__nav-item--active .of-ftype__nav-line { background: #7CB342; height: 44px; }
  .of-ftype__nav-label { font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 500; color: #fff; text-transform: uppercase; letter-spacing: 0.15em; white-space: nowrap; }
  .of-ftype__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 10; width: 48px; height: 48px; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #fff; transition: background 0.3s ease, color 0.3s ease; }
  .of-ftype__arrow:hover { background: rgba(0,0,0,0.6); color: #7CB342; }
  .of-ftype__arrow--prev { left: 32px; }
  .of-ftype__arrow--next { right: 32px; }
  .of-ftype__progress { position: absolute; bottom: 0; left: 0; width: 100%; height: 2px; background: rgba(255,255,255,0.15); z-index: 10; }
  .of-ftype__progress-bar { height: 100%; background: #7CB342; width: 0; transition: width 0.05s linear; }
  @media (max-width: 768px) {
    .of-ftype__nav { display: none; }
    .of-ftype__content { padding-left: 32px; padding-right: 32px; max-width: calc(100% - 64px); }
    .of-ftype__arrow--prev { left: 16px; }
    .of-ftype__arrow--next { right: 16px; }
  }

  /* ══════════════════════════════════════
     FEATURED PROJECT
  ══════════════════════════════════════ */
  .of-project { background: #14201A; padding: 96px 5%; }
  .of-project__inner { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: start; }
  .of-project__image-col { display: flex; flex-direction: column; gap: 0; }
  .of-project__img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: 12px 12px 0 0; display: block; }
  .of-project__stats-strip { display: grid; grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 1fr); background: #7CB342; border-radius: 0 0 12px 12px; padding: 20px 16px; gap: 16px 0; }
  .of-project__stat { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 8px; }
  .of-project__stat-num { font-family: 'Space Mono', monospace; font-size: clamp(1.1rem, 2vw, 1.5rem); font-weight: 700; color: #fff; line-height: 1.1; }
  .of-project__stat-label { font-family: 'Inter', sans-serif; font-size: 0.65rem; color: rgba(255,255,255,0.85); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 4px; line-height: 1.3; }
  .of-project__stat-div { display: none; }
  .of-project__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin-bottom: 1.25rem; }
  .of-project__title { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 700; color: #fff; line-height: 1.1; margin: 0 0 2rem; }
  .of-project__detail { border-top: 1px solid rgba(255,255,255,0.1); padding: 16px 0; display: grid; grid-template-columns: 120px 1fr; gap: 16px; align-items: start; }
  .of-project__detail:last-of-type { border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 2rem; }
  .of-project__detail-label { font-family: 'Space Mono', monospace; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.12em; color: #7CB342; padding-top: 2px; }
  .of-project__detail-val { font-family: 'Inter', sans-serif; font-size: 0.9rem; color: rgba(255,255,255,0.82); line-height: 1.7; }
  .of-project__cta { display: inline-block; background: #7CB342; color: #fff; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; padding: 14px 32px; border-radius: 9999px; text-decoration: none; transition: background 0.25s ease; }
  .of-project__cta:hover { background: #2E6B30; }
  @media (max-width: 900px) {
    .of-project__inner { grid-template-columns: 1fr; gap: 40px; }
    .of-project__stats-strip { grid-template-columns: repeat(2, 1fr); row-gap: 16px; border-radius: 0 0 12px 12px; }
    .of-project__stat-div { display: none; }
  }

  /* ══════════════════════════════════════
     GALLERY
  ══════════════════════════════════════ */
  .of-gallery { background: #F5F3EE; padding: 96px 5% 80px; }
  .of-gallery__header { text-align: center; margin-bottom: 52px; }
  .of-gallery__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin-bottom: 0.75rem; }
  .of-gallery__title { font-family: 'Playfair Display', serif; font-size: clamp(1.9rem, 3vw, 2.75rem); font-weight: 700; color: #14201A; line-height: 1.15; margin: 0 0 1rem; }
  .of-gallery__sub { font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #4A5C48; max-width: 580px; margin: 0 auto; line-height: 1.75; }
  .of-gallery__grid { max-width: 1380px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: 280px 280px 280px; gap: 12px; }
  .of-gallery__panel { position: relative; overflow: hidden; border-radius: 10px; cursor: default; }
  .of-gallery__panel--tall { grid-row: span 2; }
  .of-gallery__panel--wide { grid-column: span 2; }
  .of-gallery__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .of-gallery__panel:hover .of-gallery__img { transform: scale(1.04); }
  .of-gallery__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 55%); pointer-events: none; }
  .of-gallery__label { position: absolute; bottom: 0; left: 0; right: 0; padding: 20px 18px; }
  .of-gallery__label-title { display: block; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 700; color: #fff; margin-bottom: 3px; }
  .of-gallery__label-sub { display: block; font-family: 'Inter', sans-serif; font-size: 0.72rem; color: rgba(255,255,255,0.75); }
  @media (max-width: 900px) {
    .of-gallery__grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .of-gallery__panel--tall, .of-gallery__panel--wide { grid-column: span 1; grid-row: span 1; height: 240px; }
    .of-gallery__panel { height: 220px; }
  }
  @media (max-width: 600px) {
    .of-gallery__grid { grid-template-columns: 1fr; }
    .of-gallery__panel, .of-gallery__panel--tall, .of-gallery__panel--wide { height: 220px; grid-column: span 1; grid-row: span 1; }
  }

  /* ══════════════════════════════════════
     STATS BAR
  ══════════════════════════════════════ */
  .of-stats { background: #14201A; padding: 56px 5%; }
  .of-stats__inner { max-width: 1280px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .of-stats__item { flex: 1; min-width: 140px; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 12px; }
  .of-stats__num { font-family: 'Space Mono', monospace; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 700; color: #7CB342; line-height: 1; margin-bottom: 8px; }
  .of-stats__label { font-family: 'Inter', sans-serif; font-size: 0.78rem; color: rgba(255,255,255,0.75); line-height: 1.5; }
  .of-stats__label small { display: block; font-size: 0.65rem; color: rgba(255,255,255,0.45); margin-top: 3px; }
  .of-stats__div { width: 1px; height: 60px; background: rgba(255,255,255,0.12); flex-shrink: 0; }
  @media (max-width: 768px) { .of-stats__div { display: none; } .of-stats__item { min-width: calc(50% - 24px); } }

  /* ══════════════════════════════════════
     SHARED DESIGN TOKENS
  ══════════════════════════════════════ */
  :root {
    --swt-green:        #4E6B2A;
    --swt-green-accent: #83A94A;
    --swt-dark:         #2A241E;
    --swt-border:       #E1D6C1;
    --swt-text-sec:     #6E665C;
    --swt-white:        #ffffff;
    --swt-radius:       5px;
  }

  /* ══════════════════════════════════════
     SWT SHARED
  ══════════════════════════════════════ */
