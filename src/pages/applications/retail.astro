---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import { Icon } from 'astro-icon/components';

const title = 'Retail Window Film in Philadelphia | Storefront UV Protection, Glare & Customer Comfort';
const description = 'Window film for Philadelphia retail stores: reduce glare on displays, protect merchandise from UV fading, improve customer comfort. Professional installation with minimal disruption.';

const gallery = [
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163348_c7fe9042-5571-4cae-be7e-e5b62bc242d3.png',
    label: 'Storefront Display',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163401_f68228ec-fe56-48e5-94f3-aa085c691e64.png',
    label: 'UV Protection',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163912_f2b923a2-19cc-4e76-b031-f8e1a11dad3a.png',
    label: 'Energy Savings',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163418_19954ca7-f4a4-4aab-89bb-cb193cb2249e.png',
    label: 'Security Film',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163401_f68228ec-fe56-48e5-94f3-aa085c691e64.png',
    label: 'Decorative Film',
  },
];

const benefits = [
  {
    icon: 'lucide:sun',
    title: 'UV Protection',
    body: 'Block 99% of UV rays, preventing merchandise fading and customer discomfort',
  },
  {
    icon: 'lucide:glasses',
    title: 'Glare Reduction',
    body: 'Eliminate glare on display windows and product shelves',
  },
  {
    icon: 'lucide:store',
    title: 'Brand Appearance',
    body: 'Custom decorative and frosted films to elevate your storefront aesthetic',
  },
  {
    icon: 'lucide:zap',
    title: 'Energy Savings',
    body: 'Reduce cooling costs by up to 30%, lowering operating expenses',
  },
];

const stats = [
  { value: '99%', label: 'UV Blocked' },
  { value: '40%', label: 'Glare Reduction' },
  { value: '30%', label: 'Energy Savings' },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/applications/retail/" serviceName="Retail Window Film" serviceDesc="Retail window film installation in Philadelphia. Reduce glare, protect merchandise from UV fading, and enhance storefront aesthetics." serviceUrl="https://www.windowfilmphiladelphia.net/applications/retail/">

<InnerPageHero
  title="Retail Window Film"
  desc="Protect Merchandise · Reduce Glare · Customer Comfort"
  bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161459_a9669100-320a-4c7d-a59b-ced3fb335c53.png"
/>

<div class="ip-page-body">

  <!-- ══════════════════════════════════════
       IMAGE GALLERY — 3+2 grid
       ══════════════════════════════════════ -->
  <section class="gallery-section">
    <div class="gallery-grid">
      {gallery.slice(0, 3).map((img) => (
        <div class="gallery-item fade-in">
          <img src={img.src} alt={img.label} loading="lazy" />
          <div class="gallery-overlay">
            <span class="gallery-label">{img.label}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="gallery-grid gallery-grid--bottom">
      {gallery.slice(3).map((img) => (
        <div class="gallery-item fade-in">
          <img src={img.src} alt={img.label} loading="lazy" />
          <div class="gallery-overlay">
            <span class="gallery-label">{img.label}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════
       BENEFITS SECTION
       ══════════════════════════════════════ -->
  <section class="benefits">
    <div class="benefits__hd">
      <span class="eyebrow">Why Window Film</span>
      <h2 class="benefits__title">Retail window film benefits</h2>
    </div>
    <div class="benefits__grid">
      {benefits.map((b) => (
        <div class="benefit-card fade-in">
          <div class="benefit-card__icon">
            <Icon name={b.icon} width="28" height="28" />
          </div>
          <h3 class="benefit-card__title">{b.title}</h3>
          <p class="benefit-card__body">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════
       STATISTICS ROW
       ══════════════════════════════════════ -->
  <section class="stats-row">
    {stats.map((s) => (
      <div class="stat-card fade-in">
        <span class="stat-card__value">{s.value}</span>
        <span class="stat-card__label">{s.label}</span>
      </div>
    ))}
  </section>

  <!-- ══════════════════════════════════════
       CTA SECTION
       ══════════════════════════════════════ -->
  <section class="cta-section">
    <div class="cta-section__inner">
      <h2 class="cta-section__title">Ready to upgrade your storefront?</h2>
      <div class="cta-section__actions">
        <a href="/contact/" class="cta-btn">Get a Free Quote</a>
        <a href="tel:+12155551234" class="cta-phone">(215) 555-1234</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       BRAND LOGOS
       ══════════════════════════════════════ -->
  <BrandLogos />

</div><!-- end ip-page-body -->

</BaseLayout>

<style>
/* ── PAGE BODY WRAPPER ── */
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* ── EYEBROW ── */
.eyebrow {
  display: inline-block;
  font-family: 'DM Sans', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

/* ── GALLERY ── */
.gallery-section {
  padding: 64px 5% 0;
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.gallery-grid--bottom {
  grid-template-columns: repeat(2, 1fr);
  margin-top: 16px;
  max-width: calc(66.667% + 16px);
}
.gallery-item {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 16px;
  overflow: hidden;
  cursor: pointer;
}
.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.gallery-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(39, 46, 50, 0.7) 0%, transparent 50%);
  display: flex;
  align-items: flex-end;
  padding: 20px;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.gallery-label {
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.5px;
}
.gallery-item:hover img {
  transform: scale(1.05);
}
.gallery-item:hover .gallery-overlay {
  opacity: 1;
}

/* ── BENEFITS ── */
.benefits {
  padding: 80px 5% 60px;
}
.benefits__hd {
  margin-bottom: 48px;
}
.benefits__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  line-height: 1.15;
  letter-spacing: -0.5px;
  margin: 0;
}
.benefits__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.benefit-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 32px 28px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.benefit-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
}
.benefit-card__icon {
  width: 52px;
  height: 52px;
  background: var(--green-light, #eef4e4);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  color: var(--green, #81AB4C);
}
.benefit-card__icon svg { display: block; }
.benefit-card__title {
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin-bottom: 12px;
}
.benefit-card__body {
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.7;
  margin: 0;
}

/* ── STATISTICS ── */
.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  padding: 60px 5%;
  background: var(--brand, #272E32);
}
.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 32px 20px;
}
.stat-card__value {
  font-family: 'Playfair Display', serif;
  font-size: clamp(48px, 6vw, 72px);
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
  margin-bottom: 12px;
}
.stat-card__label {
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

/* ── CTA SECTION ── */
.cta-section {
  padding: 60px 5%;
  background: var(--brand, #272E32);
  display: flex;
  justify-content: center;
}
.cta-section__inner {
  text-align: center;
  max-width: 560px;
}
.cta-section__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  margin: 0 0 32px;
}
.cta-section__actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  flex-wrap: wrap;
}
.cta-btn {
  display: inline-block;
  padding: 14px 36px;
  background: var(--green, #81AB4C);
  color: #ffffff;
  font-family: 'DM Sans', sans-serif;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  border-radius: 100px;
  transition: background 0.2s ease, transform 0.2s ease;
}
.cta-btn:hover {
  background: #6e9640;
  transform: translateY(-2px);
}
.cta-phone {
  font-family: 'DM Sans', sans-serif;
  font-size: 15px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.8);
  text-decoration: none;
  transition: color 0.2s ease;
}
.cta-phone:hover {
  color: var(--green, #81AB4C);
}

/* ── FADE IN ── */
.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .benefits__grid { grid-template-columns: repeat(2, 1fr); }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .gallery-grid--bottom { max-width: 100%; }
}
@media (max-width: 768px) {
  .benefits__grid { grid-template-columns: 1fr; }
  .gallery-grid { grid-template-columns: 1fr; }
  .gallery-grid--bottom { grid-template-columns: 1fr; }
  .stats-row { grid-template-columns: 1fr; gap: 16px; }
  .stat-card { padding: 24px 20px; }
  .cta-section__actions { flex-direction: column; gap: 16px; }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>
