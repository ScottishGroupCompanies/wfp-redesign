---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import { Icon } from 'astro-icon/components';

const title = 'Retail Window Film in Philadelphia | Storefront UV Protection, Glare & Customer Comfort';
const description = 'Window film for Philadelphia retail stores and restaurants: reduce glare on displays, protect merchandise from UV fading, improve customer comfort. Professional installation.';

const benefits = [
  {
    icon: 'lucide:sun',
    title: 'UV Protection',
    body: 'Block up to 99% of harmful UV rays that cause merchandise fading, fabric degradation, and damage to products displayed near windows.',
  },
  {
    icon: 'lucide:glasses',
    title: 'Glare Reduction',
    body: 'Eliminate harsh glare on storefront windows and interior displays, creating a more comfortable shopping environment for customers.',
  },
  {
    icon: 'lucide:store',
    title: 'Brand Appearance',
    body: 'Enhance your storefront\'s visual appeal with a clean, professional look while protecting interior aesthetics from sun damage.',
  },
  {
    icon: 'lucide:zap',
    title: 'Energy Savings',
    body: 'Reduce cooling costs by rejecting solar heat — keeping your retail space comfortable and your energy bills lower year-round.',
  },
];

const stats = [
  { value: '99%', label: 'UV Blocked' },
  { value: '40%', label: 'Glare Reduction' },
  { value: '30%', label: 'Cooling Cost Savings' },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/applications/retail/" serviceName="Retail Window Film" serviceDesc="Retail window film installation in Philadelphia. Reduce glare, protect merchandise from UV fading, and enhance storefront aesthetics." serviceUrl="https://www.windowfilmphiladelphia.net/applications/retail/">

<InnerPageHero
  title="Retail Window Film"
  desc="Protect merchandise · Reduce glare · Customer comfort"
  bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161459_a9669100-320a-4c7d-a59b-ced3fb335c53.png"
/>

<div class="ip-page-body">

  <!-- ══════════════════════════════════════
       BENEFITS SECTION
       ══════════════════════════════════════ -->
  <section class="benefits">
    <div class="benefits__hd">
      <span class="eyebrow">Why Window Film</span>
      <h2 class="benefits__title">Retail window film benefits</h2>
    </div>
    <div class="benefits__grid">
      {benefits.map((b) => (
        <div class="benefit-card fade-in">
          <div class="benefit-card__icon">
            <Icon name={b.icon} width="28" height="28" />
          </div>
          <h3 class="benefit-card__title">{b.title}</h3>
          <p class="benefit-card__body">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════
       WHY RETAIL SECTION
       ══════════════════════════════════════ -->
  <section class="why-retail">
    <div class="why-retail__inner">
      <span class="eyebrow">For Philadelphia Retailers</span>
      <h2 class="why-retail__title">Why retailers choose window film</h2>
      <p class="why-retail__lead">Philadelphia's retail environment demands both aesthetic appeal and practical protection. Window film delivers both — shielding your merchandise from UV fading while creating a more comfortable, inviting space for customers. Whether you run a boutique in Old City, a restaurant in Fishtown, or a storefront on South Street, professional window film installation keeps your products looking great and your customers coming back.</p>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       STATISTICS ROW
       ══════════════════════════════════════ -->
  <section class="stats-row">
    {stats.map((s) => (
      <div class="stat-card fade-in">
        <span class="stat-card__value">{s.value}</span>
        <span class="stat-card__label">{s.label}</span>
      </div>
    ))}
  </section>

  <!-- ══════════════════════════════════════
       CTA SECTION
       ══════════════════════════════════════ -->
  <section class="cta-section">
    <div class="cta-section__inner">
      <h2 class="cta-section__title">Ready to protect your storefront?</h2>
      <p class="cta-section__sub">Get a free consultation and quote for your Philadelphia retail space.</p>
      <a href="/contact/" class="cta-btn">Get a Free Quote</a>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       BRAND LOGOS
       ══════════════════════════════════════ -->
  <BrandLogos />

</div><!-- end ip-page-body -->

</BaseLayout>

<style>
/* ── PAGE BODY WRAPPER ── */
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* ── EYEBROW ── */
.eyebrow {
  display: inline-block;
  font-family: 'DM Sans', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

/* ── BENEFITS ── */
.benefits {
  padding: 80px 5% 60px;
}
.benefits__hd {
  margin-bottom: 48px;
}
.benefits__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  line-height: 1.15;
  letter-spacing: -0.5px;
  margin: 0;
}
.benefits__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.benefit-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 32px 28px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.benefit-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
}
.benefit-card__icon {
  color: var(--green, #81AB4C);
  margin-bottom: 20px;
  display: flex;
  align-items: center;
}
.benefit-card__icon svg { display: block; }
.benefit-card__title {
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin-bottom: 12px;
}
.benefit-card__body {
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.7;
  margin: 0;
}

/* ── WHY RETAIL ── */
.why-retail {
  padding: 60px 5%;
  background: var(--off-white, #F7F6F3);
}
.why-retail__inner {
  max-width: 720px;
}
.why-retail__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  line-height: 1.15;
  letter-spacing: -0.5px;
  margin: 0 0 20px;
}
.why-retail__lead {
  font-family: 'DM Sans', sans-serif;
  font-size: 16px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.8;
  margin: 0;
}

/* ── STATISTICS ── */
.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  padding: 60px 5%;
  background: var(--brand, #272E32);
}
.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 32px 20px;
}
.stat-card__value {
  font-family: 'Playfair Display', serif;
  font-size: clamp(48px, 6vw, 72px);
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
  margin-bottom: 12px;
}
.stat-card__label {
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

/* ── CTA SECTION ── */
.cta-section {
  padding: 60px 5%;
  background: var(--brand, #272E32);
  display: flex;
  justify-content: center;
}
.cta-section__inner {
  text-align: center;
  max-width: 560px;
}
.cta-section__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  margin: 0 0 16px;
}
.cta-section__sub {
  font-family: 'DM Sans', sans-serif;
  font-size: 16px;
  color: rgba(255, 255, 255, 0.6);
  margin: 0 0 32px;
  line-height: 1.6;
}
.cta-btn {
  display: inline-block;
  padding: 14px 36px;
  background: var(--green, #81AB4C);
  color: #ffffff;
  font-family: 'DM Sans', sans-serif;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  border-radius: 100px;
  transition: background 0.2s ease, transform 0.2s ease;
}
.cta-btn:hover {
  background: #6e9640;
  transform: translateY(-2px);
}

/* ── FADE IN ── */
.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .benefits__grid { grid-template-columns: repeat(2, 1fr); }
  .stats-row { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 768px) {
  .benefits__grid { grid-template-columns: 1fr; }
  .stats-row { grid-template-columns: 1fr; gap: 16px; }
  .stat-card { padding: 24px 20px; }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>
