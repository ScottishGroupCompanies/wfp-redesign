---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import { Icon } from 'astro-icon/components';

const title = 'Hotel Window Film in Philadelphia | Guest Comfort, Energy Savings & Privacy';
const description = 'Window film for Philadelphia hotels and hospitality: reduce energy costs, protect furnishings from UV fading, enhance guest privacy.';

const benefits = [
  {
    icon: 'lucide:sun',
    title: 'UV Protection',
    body: 'Block up to 99% of harmful UV rays to protect guests, staff, and interiors from sun damage while extending the life of furnishings and artwork.',
  },
  {
    icon: 'lucide:zap',
    title: 'Energy Efficiency',
    body: 'Reduce HVAC costs by up to 30% with solar control films that reject heat in summer and retain warmth in winter — year-round savings.',
  },
  {
    icon: 'lucide:eye-off',
    title: 'Guest Privacy',
    body: 'Give guests the privacy they expect without sacrificing natural light. Ideal for ground-floor rooms, balconies, and common areas.',
  },
  {
    icon: 'lucide:sparkles',
    title: 'Aesthetic Appeal',
    body: 'Modernize your property\'s exterior and interior with decorative and architectural films that elevate the guest experience.',
  },
];

const whyItems = [
  {
    icon: 'lucide:shield-check',
    title: 'Minimize Disruption',
    sub: 'Our team schedules work around your operations — often floor-by-floor, during off-peak hours — so your property stays open.',
  },
  {
    icon: 'lucide:thermometer',
    title: 'Consistent Comfort',
    sub: 'Eliminate hot and cold spots near windows. Every guest room stays comfortable regardless of sun exposure or floor level.',
  },
  {
    icon: 'lucide:trending-down',
    title: 'Fast ROI',
    sub: 'Most hospitality properties see full payback within 3–5 years through reduced energy bills and extended furniture replacement cycles.',
  },
  {
    icon: 'lucide:palette',
    title: 'Custom Aesthetics',
    sub: 'From frosted lobby panels to branded conference room graphics — decorative films refresh spaces without construction or replacement.',
  },
];

const stats = [
  { value: '99%', label: 'UV Rejected' },
  { value: '30%', label: 'Energy Cost Reduction' },
  { value: '3–5 yrs', label: 'Average ROI' },
  { value: '15+', label: 'Years Serving Philly' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.windowfilmphiladelphia.net/applications/hotel-window-film/"
  serviceName="Hotel Window Film"
  serviceDesc="Hotel window film installation in Philadelphia. Energy savings, privacy, and aesthetic solutions for hospitality properties."
  serviceUrl="https://www.windowfilmphiladelphia.net/applications/hotel-window-film/"
>

<InnerPageHero
  title="Hotel &amp; Hospitality Window Film"
  desc="Guest comfort · Energy savings · UV protection"
  bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161451_ddf5ce59-4e3d-408b-8d0c-87182d748e11.png"
/>

<div class="ip-page-body">

  <!-- Benefits Section -->
  <section class="sec-benefits">
    <div class="sec-benefits__inner">
      <div class="sec-hd">
        <span class="eyebrow">Key Benefits</span>
        <h2 class="sec-title">Why hotels choose window film</h2>
        <p class="sec-lead">From guest comfort to operational savings, window film delivers measurable results across every touchpoint of the hospitality experience.</p>
      </div>
      <div class="benefits-grid">
        {benefits.map((b) => (
          <div class="benefit-card fade-in">
            <div class="benefit-card__icon">
              <Icon name={b.icon} width="28" height="28" />
            </div>
            <h3 class="benefit-card__title">{b.title}</h3>
            <p class="benefit-card__body">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Hospitality Section -->
  <section class="sec-why-hosp">
    <div class="sec-why-hosp__inner">
      <div class="sec-hd">
        <span class="eyebrow">Built for Hospitality</span>
        <h2 class="sec-title sec-title--light">Window film solutions that respect your property</h2>
        <p class="sec-lead sec-lead--light">We understand that hotels and resorts operate on tight schedules and demand minimal disruption. Our team has installed window film in hundreds of active hospitality properties across the Philadelphia region.</p>
      </div>
      <div class="why-grid">
        {whyItems.map((item) => (
          <div class="why-item fade-in">
            <div class="why-item__icon">
              <Icon name={item.icon} width="24" height="24" />
            </div>
            <div class="why-item__divider"></div>
            <h4 class="why-item__title">{item.title}</h4>
            <p class="why-item__sub">{item.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Statistics Row -->
  <section class="sec-stats">
    <div class="sec-stats__inner">
      {stats.map((s) => (
        <div class="stat-item fade-in">
          <span class="stat-item__value">{s.value}</span>
          <span class="stat-item__label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Brand Logos -->
  <BrandLogos />

  <!-- CTA Section -->
  <section class="sec-cta">
    <div class="sec-cta__inner">
      <h2 class="sec-cta__title">Ready to upgrade your property?</h2>
      <p class="sec-cta__sub">Get a free consultation and see how window film can transform your Philadelphia hotel.</p>
      <div class="sec-cta__btns">
        <a href="/contact/" class="btn btn--green">Get a Free Quote</a>
        <a href="tel:+12673947980" class="btn btn--outline">Call (267) 394-7980</a>
      </div>
    </div>
  </section>

</div>

</BaseLayout>

<style>
/* ── Global page wrapper ── */
.ip-page-body {
  position: relative;
  background: var(--off-white, #F7F6F3);
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 0;
}

/* ── Shared typography ── */
.eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}
.sec-hd {
  text-align: center;
  margin-bottom: 56px;
}
.sec-title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(30px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 16px;
}
.sec-title--light { color: #ffffff; }
.sec-lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  line-height: 1.75;
  color: var(--text-mid, #4a4a4a);
  max-width: 620px;
  margin: 0 auto;
}
.sec-lead--light { color: rgba(255,255,255,0.65); }

/* ── Benefits Section ── */
.sec-benefits {
  padding: 80px 5% 90px;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
}
.sec-benefits__inner { max-width: 1200px; margin: 0 auto; }

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.benefit-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 36px 28px;
  box-shadow: 0 4px 24px rgba(39, 46, 50, 0.08), 0 1px 4px rgba(39, 46, 50, 0.04);
  border: 1px solid rgba(39, 46, 50, 0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.benefit-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(39, 46, 50, 0.12), 0 2px 8px rgba(39, 46, 50, 0.06);
}
.benefit-card__icon {
  width: 52px;
  height: 52px;
  background: var(--green-light, #eef4e4);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--green, #81AB4C);
  margin-bottom: 20px;
}
.benefit-card__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 20px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 12px;
  letter-spacing: -0.2px;
}
.benefit-card__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  line-height: 1.7;
  color: var(--text-mid, #4a4a4a);
  margin: 0;
}

/* ── Why Hospitality Section ── */
.sec-why-hosp {
  background: var(--brand, #272E32);
  padding: 90px 5%;
}
.sec-why-hosp__inner { max-width: 1200px; margin: 0 auto; }

.why-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}
.why-item {
  padding: 36px 28px;
  border-right: 1px solid rgba(255,255,255,0.08);
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.why-item:nth-child(4n) { border-right: none; }
.why-item:nth-child(n+5) { border-bottom: none; }
.why-item__icon {
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
  display: flex;
  align-items: center;
}
.why-item__divider {
  width: 28px;
  height: 2px;
  background: var(--green, #81AB4C);
  margin-bottom: 16px;
}
.why-item__title {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 8px;
}
.why-item__sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  color: rgba(255,255,255,0.5);
  line-height: 1.6;
  margin: 0;
}

/* ── Statistics Section ── */
.sec-stats {
  background: var(--off-white, #F7F6F3);
  padding: 80px 5%;
}
.sec-stats__inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}
.stat-item {
  text-align: center;
  padding: 0 24px;
  border-right: 1px solid rgba(39, 46, 50, 0.1);
}
.stat-item:last-child { border-right: none; }
.stat-item__value {
  display: block;
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(40px, 5vw, 64px);
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
  margin-bottom: 8px;
  letter-spacing: -2px;
}
.stat-item__label {
  display: block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-weight: 600;
  color: var(--text-mid, #4a4a4a);
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* ── CTA Section ── */
.sec-cta {
  background: var(--brand, #272E32);
  border-radius: 40px;
  margin: 0 5%;
  padding: 72px 60px;
}
.sec-cta__inner { text-align: center; max-width: 640px; margin: 0 auto; }
.sec-cta__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 44px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.15;
  margin: 0 0 12px;
  letter-spacing: -0.5px;
}
.sec-cta__sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: rgba(255,255,255,0.6);
  margin: 0 0 36px;
  line-height: 1.6;
}
.sec-cta__btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

/* ── Buttons ── */
.btn {
  display: inline-block;
  padding: 15px 30px;
  border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
  border: 2px solid transparent;
  white-space: nowrap;
}
.btn--green {
  background: var(--green, #81AB4C);
  color: #ffffff;
  border-color: var(--green, #81AB4C);
}
.btn--green:hover {
  background: #6e9640;
  border-color: #6e9640;
  transform: translateY(-2px);
  color: #ffffff;
}
.btn--outline {
  background: transparent;
  color: #ffffff;
  border-color: rgba(255,255,255,0.35);
}
.btn--outline:hover {
  border-color: #ffffff;
  transform: translateY(-2px);
  color: #ffffff;
}

/* ── Fade-in animation ── */
.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── Responsive ── */
@media (max-width: 1024px) {
  .benefits-grid { grid-template-columns: repeat(2, 1fr); }
  .why-grid { grid-template-columns: repeat(2, 1fr); }
  .why-item:nth-child(4n) { border-right: 1px solid rgba(255,255,255,0.08); }
  .why-item:nth-child(2n) { border-right: none; }
  .why-item:nth-child(n+5) { border-bottom: none; }
  .sec-stats__inner { grid-template-columns: repeat(2, 1fr); gap: 40px 0; }
  .stat-item:nth-child(2n) { border-right: none; }
  .stat-item:nth-child(n+3) { border-bottom: none; }
}
@media (max-width: 768px) {
  .sec-benefits { padding: 60px 5% 70px; }
  .sec-why-hosp { padding: 60px 5%; }
  .sec-stats { padding: 60px 5%; }
  .benefits-grid { grid-template-columns: 1fr; }
  .why-grid { grid-template-columns: 1fr; }
  .why-item { border-right: none !important; }
  .sec-stats__inner { grid-template-columns: repeat(2, 1fr); }
  .sec-cta { margin: 0 3%; padding: 48px 28px; }
  .sec-cta__btns { flex-direction: column; width: 100%; }
  .sec-cta__btns .btn { width: 100%; text-align: center; }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>