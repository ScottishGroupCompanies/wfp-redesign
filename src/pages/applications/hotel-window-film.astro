<script>
  // ── Film Types Slider (ht-ftype)
  (function() {
    const track = document.getElementById('htFtypeTrack');
    if (!track) return;
    const slides = Array.from(track.querySelectorAll('.ht-ftype__slide'));
    const navItems = Array.from(document.querySelectorAll('[data-htnav]'));
    const progressBar = document.getElementById('htFtypeProgressBar');
    const prevBtn = document.getElementById('htFtypePrev');
    const nextBtn = document.getElementById('htFtypeNext');
    let current = 0;
    const total = slides.length;

    function goTo(idx) {
      slides[current].classList.remove('ht-ftype-active');
      navItems[current]?.classList.remove('ht-ftype__nav-item--active');
      current = (idx + total) % total;
      slides[current].classList.add('ht-ftype-active');
      navItems[current]?.classList.add('ht-ftype__nav-item--active');
      if (progressBar) progressBar.style.width = ((current + 1) / total * 100) + '%';
    }

    navItems.forEach(btn => {
      btn.addEventListener('click', () => goTo(parseInt(btn.dataset.htnav)));
    });
    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));

    // FAQ accordions inside slides
    track.querySelectorAll('.ht-ftype__faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        const answer = btn.nextElementSibling;
        if (answer) answer.hidden = expanded;
      });
    });
  })();

  // ── FAQ accordion (swt-faq)
  document.querySelectorAll('.swt-faq__item').forEach(item => {
    item.querySelector('.swt-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('swt-faq__item--open');
      document.querySelectorAll('.swt-faq__item').forEach(i => i.classList.remove('swt-faq__item--open'));
      if (!isOpen) item.classList.add('swt-faq__item--open');
    });
  });
</script>
