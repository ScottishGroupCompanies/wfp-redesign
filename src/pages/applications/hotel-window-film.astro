  .ht-row__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    color: var(--ht-text-sec);
    line-height: 1.6;
  }
  .ht-row__bullets li svg { flex-shrink: 0; margin-top: 2px; }
  @media (max-width: 900px) {
    .ht-row { grid-template-columns: 1fr; gap: 36px; direction: ltr; padding: 56px 5%; }
    .ht-row__image { height: 300px; }
  }

  /* ══════════════════════════════════════
     FILM TYPES SLIDER  (ht-ftype)
  ══════════════════════════════════════ */
  .ht-ftype {
    position: relative;
    height: 100vh;
    min-height: 600px;
    max-height: 900px;
    overflow: hidden;
    background: var(--ht-dark);
  }
  .ht-ftype__track { position: relative; width: 100%; height: 100%; }
  .ht-ftype__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }
  .ht-ftype__slide.ht-ftype-active {
    opacity: 1;
    pointer-events: auto;
  }
  .ht-ftype__bg {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .ht-ftype__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.30) 60%, transparent 100%);
  }
  .ht-ftype__content {
    position: relative;
    z-index: 5;
    max-width: 560px;
    padding: 80px 5% 80px 8%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .ht-ftype__step {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(124,179,66,0.7);
    margin-bottom: 14px;
  }
  .ht-ftype__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 700;
    color: #F3F6F1;
    line-height: 1.2;
    margin-bottom: 16px;
    white-space: pre-line;
  }
  .ht-ftype__desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.72);
    line-height: 1.8;
    margin-bottom: 24px;
  }
  .ht-ftype__faq { display: flex; flex-direction: column; gap: 2px; margin-bottom: 28px; }
  .ht-ftype__faq-item { border-top: 1px solid rgba(255,255,255,0.1); }
  .ht-ftype__faq-item:last-child { border-bottom: 1px solid rgba(255,255,255,0.1); }
  .ht-ftype__faq-q {
    width: 100%;
    background: none;
    border: none;
    padding: 12px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(255,255,255,0.82);
    text-align: left;
  }
  .ht-ftype__faq-icon {
    font-size: 18px;
    color: var(--ht-green-light);
    font-weight: 400;
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .ht-ftype__faq-q[aria-expanded="true"] .ht-ftype__faq-icon { transform: rotate(45deg); }
  .ht-ftype__faq-a {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.75;
    padding: 0 0 14px;
  }
  .ht-ftype__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ht-green-light);
    text-decoration: none;
    border-bottom: 2px solid var(--ht-green-light);
    padding-bottom: 2px;
    align-self: flex-start;
    transition: gap 0.2s;
  }
  .ht-ftype__cta:hover { gap: 10px; }
  /* Right nav */
  .ht-ftype__nav {
    position: absolute;
    right: 40px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ht-ftype__nav-item {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
  }
  .ht-ftype__nav-line {
    width: 24px;
    height: 2px;
    background: rgba(255,255,255,0.25);
    transition: width 0.25s, background 0.25s;
  }
  .ht-ftype__nav-item--active .ht-ftype__nav-line,
  .ht-ftype__nav-item:hover .ht-ftype__nav-line {
    width: 40px;
    background: var(--ht-green-light);
  }
  .ht-ftype__nav-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(255,255,255,0.45);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .ht-ftype__nav-item--active .ht-ftype__nav-label,
  .ht-ftype__nav-item:hover .ht-ftype__nav-label { color: rgba(255,255,255,0.9); }
  /* Arrows */
  .ht-ftype__arrow {
    position: absolute;
    bottom: 32px;
    z-index: 10;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 50%;
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    color: rgba(255,255,255,0.7);
    transition: background 0.2s, color 0.2s;
  }
  .ht-ftype__arrow:hover { background: rgba(255,255,255,0.18); color: #fff; }
  .ht-ftype__arrow--prev { left: 8%; }
  .ht-ftype__arrow--next { left: calc(8% + 56px); }
  /* Progress */
  .ht-ftype__progress {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 3px;
    background: rgba(255,255,255,0.1);
    z-index: 10;
  }
  .ht-ftype__progress-bar {
    height: 100%;
    background: var(--ht-green-light);
    transition: width 0.4s ease;
    width: 16.66%;
  }
  @media (max-width: 900px) {
    .ht-ftype { max-height: none; height: auto; min-height: 0; }
    .ht-ftype__slide { position: relative; opacity: 0; max-height: 0; overflow: hidden; pointer-events: none; }
    .ht-ftype__slide.ht-ftype-active { opacity: 1; max-height: none; pointer-events: auto; }
    .ht-ftype__content { padding: 60px 5%; max-width: 100%; }
    .ht-ftype__bg { position: absolute; height: 100%; }
    .ht-ftype__nav { right: 20px; }
    .ht-ftype__nav-label { display: none; }
    .ht-ftype__arrow--prev { left: 5%; }
    .ht-ftype__arrow--next { left: calc(5% + 56px); }
  }

  /* ══════════════════════════════════════
     FEATURED PROJECT
  ══════════════════════════════════════ */
  .ht-project {
    background: var(--ht-alt);
    padding: 96px 5%;
  }
  .ht-project__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 72px;
    align-items: start;
  }
  .ht-project__img {
    width: 100%;
    height: auto;
    border-radius: var(--ht-radius);
    display: block;
    box-shadow: 0 24px 60px rgba(13,26,15,0.14);
  }
  .ht-project__stats-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 20px;
    background: var(--ht-dark);
    border-radius: var(--ht-radius);
    padding: 18px 20px;
  }
  .ht-project__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex: 1;
    text-align: center;
  }
  .ht-project__stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--ht-green-light);
    line-height: 1;
  }
  .ht-project__stat-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.6rem;
    color: rgba(255,255,255,0.45);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    line-height: 1.3;
  }
  .ht-project__stat-div { width: 1px; height: 32px; background: rgba(255,255,255,0.1); flex-shrink: 0; }
  .ht-project__eyebrow {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--ht-green);
    margin-bottom: 14px;
  }
  .ht-project__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.7rem, 2.5vw, 2.4rem);
    font-weight: 700;
    color: var(--ht-dark);
    line-height: 1.15;
    margin-bottom: 32px;
  }
  .ht-project__detail {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 12px 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--ht-border);
    align-items: baseline;
  }
  .ht-project__detail-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--ht-green);
  }
  .ht-project__detail-val {
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    color: var(--ht-text-sec);
    line-height: 1.7;
  }
  .ht-project__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ht-green);
    text-decoration: none;
    border-bottom: 2px solid var(--ht-green);
    padding-bottom: 2px;
    transition: gap 0.2s;
  }
  .ht-project__cta:hover { gap: 12px; }
  @media (max-width: 900px) {
    .ht-project__inner { grid-template-columns: 1fr; gap: 36px; }
    .ht-project__detail { grid-template-columns: 1fr; gap: 6px; }
    .ht-project__stats-strip { flex-wrap: wrap; gap: 16px; }
  }

  /* ══════════════════════════════════════
     TESTIMONIALS
  ══════════════════════════════════════ */
  .ht-testimonials {
    background: var(--ht-cream);
    padding: 96px 5%;
  }
  .ht-testimonials__inner { max-width: 1200px; margin: 0 auto; }
  .ht-testimonials__header { text-align: center; margin-bottom: 56px; }
  .ht-testimonials__eyebrow {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--ht-green);
    margin-bottom: 12px;
  }
  .ht-testimonials__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.7rem, 2.8vw, 2.5rem);
    font-weight: 700;
    color: var(--ht-dark);
    line-height: 1.15;
    margin: 0;
  }
  .ht-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  /* cam-tcard shared pattern */
  .cam-tcard { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 2px 16px rgba(13,26,15,0.07); display: flex; flex-direction: column; }
  .cam-tcard__img-wrap { overflow: hidden; aspect-ratio: 1/1; flex-shrink: 0; }
  .cam-tcard__img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; transition: transform 0.4s ease; }
  .cam-tcard:hover .cam-tcard__img { transform: scale(1.03); }
  .cam-tcard__body { padding: 28px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
  .cam-tcard__stars { color: #F5A623; font-size: 1.1rem; letter-spacing: 2px; }
  .cam-tcard__quote { font-family: 'Inter', sans-serif; font-size: 0.92rem; color: #3a4a38; line-height: 1.75; margin: 0; font-style: italic; flex: 1; }
  .cam-tcard__meta { border-top: 1px solid #e8ede6; padding-top: 14px; margin-top: auto; }
  .cam-tcard__name { font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 700; color: #14201A; margin: 0 0 3px; }
  .cam-tcard__role { font-family: 'Inter', sans-serif; font-size: 0.8rem; color: var(--ht-green-light); margin: 0; font-weight: 500; }
  @media (max-width: 900px) { .ht-testimonials__grid { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; } }
  @media (max-width: 600px) { .ht-testimonials__grid { max-width: 100%; } }

  /* ══════════════════════════════════════
     PHILADELPHIA AREAS (ip-local)
  ══════════════════════════════════════ */
  .ip-local { background: var(--ht-white); }
  .ip-local__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 640px;
  }
  .ip-local__map { background: #dde; }
  .ip-local__map iframe { display: block; width: 100%; height: 100%; min-height: 400px; }
  .ip-local__content {
    padding: 72px 6%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: center;
  }
  .ip-local__content h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    font-weight: 700;
    color: var(--ht-dark);
    line-height: 1.15;
    margin: 0;
  }
  .ip-local__content p {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: var(--ht-text-sec);
    line-height: 1.8;
    margin: 0;
  }
  .cam-testimonials__eyebrow {
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--ht-green);
  }
  .cam-neighborhoods { display: flex; flex-direction: column; gap: 0; }
  .cam-nh {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 12px 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--ht-border);
    align-items: baseline;
  }
  .cam-nh:first-child { border-top: 1px solid var(--ht-border); }
  .cam-nh__name {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ht-dark);
  }
  .cam-nh__desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: var(--ht-text-sec);
    line-height: 1.65;
  }
  @media (max-width: 900px) {
    .ip-local__grid { grid-template-columns: 1fr; }
    .ip-local__map { min-height: 320px; }
    .ip-local__content { padding: 56px 5%; }
    .cam-nh { grid-template-columns: 1fr; gap: 4px; }
  }

  /* ══════════════════════════════════════
     FAQ  (swt-faq)
  ══════════════════════════════════════ */
  :root {
    --swt-white: #fff;
    --swt-dark:  #0D1A0F;
    --swt-green: #4E6B2A;
    --swt-text-sec: #5a6650;
    --swt-border: #E1D6C1;
  }
  .swt-faq { background: var(--swt-white); padding: 96px 0; }
  .swt-faq__layout { display: grid; grid-template-columns: 300px 1fr; gap: 80px; align-items: start; }
  .swt-faq__header { display: flex; flex-direction: column; }
  .swt-faq__header p { font-family: 'Inter', sans-serif; font-size: 15px; line-height: 1.75; color: var(--swt-text-sec); margin: 14px 0 24px; }
  .swt-eyebrow { font-family: 'Space Mono', monospace; font-size: 0.68rem; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: var(--ht-green); margin-bottom: 10px; }
  .swt-h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.6rem, 2.5vw, 2.2rem); font-weight: 700; color: var(--swt-dark); line-height: 1.15; margin: 0; }
  .swt-btn { display: inline-flex; align-items: center; padding: 12px 24px; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; text-decoration: none; border-radius: var(--ht-radius); transition: background 0.2s, transform 0.2s; }
  .swt-btn--primary { background: var(--ht-green); color: #fff; border: 2px solid var(--ht-green); }
  .swt-btn--primary:hover { background: #3D5620; border-color: #3D5620; transform: translateY(-2px); }
  .swt-faq__list { display: flex; flex-direction: column; }
  .swt-faq__item { border-bottom: 1px solid var(--swt-border); padding: 18px 0; }
  .swt-faq__item:first-of-type { border-top: 1px solid var(--swt-border); }
  .swt-faq__q { font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 600; color: var(--swt-dark); display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; cursor: pointer; padding: 3px 0; }
  .swt-faq__toggle { color: var(--ht-green-light); font-size: 22px; flex-shrink: 0; font-weight: 400; transition: transform 0.2s; line-height: 1; }
  .swt-faq__a { font-family: 'Inter', sans-serif; font-size: 14px; color: var(--swt-text-sec); line-height: 1.8; margin-top: 10px; display: none; }
  .swt-faq__a a { color: var(--ht-green-light); text-decoration: underline; text-underline-offset: 3px; font-weight: 500; }
  .swt-faq__a a:hover { color: var(--ht-green); }
  .swt-faq__item--open .swt-faq__a { display: block; }
  .swt-faq__item--open .swt-faq__toggle { transform: rotate(45deg); }
  @media (max-width: 768px) { .swt-faq__layout { grid-template-columns: 1fr; gap: 40px; } }

  /* ══════════════════════════════════════
     CTA BANNER (priv-cinematic-cta)
  ══════════════════════════════════════ */
  .priv-cinematic-cta {
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .priv-cinematic-cta__media {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .priv-cinematic-cta__overlay {
    position: absolute;
    inset: 0;
    background: rgba(13,26,15,0.72);
  }
  .priv-cinematic-cta__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.4) 100%);
  }
  .priv-cinematic-cta__content {
    position: relative;
    z-index: 5;
    text-align: center;
    max-width: 700px;
    padding: 80px 5%;
  }
  .priv-cinematic-cta__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    font-weight: 700;
    color: #F3F6F1;
    line-height: 1.15;
    margin-bottom: 18px;
  }
  .priv-cinematic-cta__text {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: rgba(243,246,241,0.75);
    line-height: 1.8;
    margin-bottom: 36px;
  }
  .priv-cinematic-cta__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .priv-cinematic-cta__btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 15px 32px;
    background: var(--ht-green);
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--ht-radius);
    border: 2px solid var(--ht-green);
    transition: background 0.2s, transform 0.2s;
  }
  .priv-cinematic-cta__btn-primary:hover { background: #3D5620; border-color: #3D5620; transform: translateY(-2px); }
  .priv-cinematic-cta__btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 15px 28px;
    background: transparent;
    color: rgba(255,255,255,0.85);
