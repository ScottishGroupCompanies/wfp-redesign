    box-shadow: 0 20px 50px rgba(13,26,15,0.1);
  }
  .ht-row__image {
    width: 100%;
    height: 440px;
    object-fit: cover;
    display: block;
  }
  .ht-row__eyebrow {
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--ht-green);
    margin-bottom: 14px;
    display: block;
  }
  .ht-row__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    font-weight: 700;
    color: var(--ht-dark);
    line-height: 1.2;
    margin-bottom: 18px;
  }
  .ht-row__body {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: var(--ht-text-sec);
    line-height: 1.8;
    margin-bottom: 14px;
  }
  .ht-row__body a { color: #2E7D32; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; font-weight: 600; }
  .ht-row__body a:hover { color: #1B5E20; text-decoration-color: #1B5E20; }
  .ht-whatis__body a { color: #2E7D32; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; font-weight: 600; }
  .ht-whatis__body a:hover { color: #1B5E20; }
  .ht-row__bullets {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-direction: column;
