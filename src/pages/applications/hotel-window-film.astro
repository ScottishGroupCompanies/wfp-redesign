---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Hotel Window Film in Philadelphia | Guest Comfort, Energy Savings & Privacy';
const description = 'Window film for Philadelphia hotels and hospitality: reduce energy costs, protect furnishings from UV fading, enhance guest privacy. Luxury look, professional installation.';

const gallery = [
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163338_97d1e02a-3bf3-4ae4-a436-199ae46d8b17.png',
    label: 'Guest Room Comfort',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163341_bdd5ec56-1d62-4d32-857d-06179e31d16b.png',
    label: 'Energy Savings',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163344_ac6c6e0d-3ed1-4900-a641-d836da40ba67.png',
    label: 'Privacy',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163348_450f2fd8-2333-42dd-928f-9775a84e2391.png',
    label: 'UV Protection',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163351_c7fe9042-5571-4cae-be7e-e5b62bc242d3.png',
    label: 'Furnishing Protection',
  },
];

const benefits = [
  {
    title: 'UV Protection',
    body: 'Block 99% of UV rays, protecting furniture, carpets and artwork from fading.',
    stat: '99%',
    statLabel: 'UV Blocked',
  },
  {
    title: 'Energy Efficiency',
    body: 'Reduce HVAC costs by up to 30% with heat-rejecting film.',
    stat: '30%',
    statLabel: 'Energy Saved',
  },
  {
    title: 'Privacy',
    body: 'One-way mirror and frosted film options for guest privacy.',
    stat: '100%',
    statLabel: 'Privacy Options',
  },
  {
    title: 'Guest Comfort',
    body: 'Consistent room temperature, no hot or cold spots near windows.',
    stat: '86°F',
    statLabel: 'Heat Reduced',
  },
];

const stats = [
  { value: '86°F', label: 'Heat Reduction' },
  { value: '30%', label: 'Energy Savings' },
  { value: '5-Star', label: 'Reviews' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.windowfilmphiladelphia.net/applications/hotel-window-film/"
  serviceName="Hotel Window Film"
  serviceDesc="Hotel window film installation in Philadelphia. Energy savings, privacy, and aesthetic solutions for hospitality properties."
  serviceUrl="https://www.windowfilmphiladelphia.net/applications/hotel-window-film/"
>

<InnerPageHero
  title="Hotel &amp; Hospitality Window Film"
  desc="Guest Comfort · Energy Savings · UV Protection"
  bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161451_ddf5ce59-4e3d-408b-8d0c-87182d748e11.png"
/>

<div class="ip-page-body">

  <!-- ── Gallery Section ── -->
  <section class="sec-gallery">
    <div class="sec-gallery__inner">
      <div class="gallery-grid">
        {gallery.slice(0, 3).map((item) => (
          <div class="gallery-item fade-in">
            <img src={item.src} alt={item.label} loading="lazy" />
            <div class="gallery-item__overlay">
              <span class="gallery-item__label">{item.label}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="gallery-row-two">
        {gallery.slice(3).map((item) => (
          <div class="gallery-item fade-in">
            <img src={item.src} alt={item.label} loading="lazy" />
            <div class="gallery-item__overlay">
              <span class="gallery-item__label">{item.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Benefits Section ── -->
  <section class="sec-benefits">
    <div class="sec-benefits__inner">
      <div class="sec-hd">
        <span class="eyebrow">Key Benefits</span>
        <h2 class="sec-title">Why hotels choose window film</h2>
        <p class="sec-lead">From guest comfort to operational savings, window film delivers measurable results across every touchpoint of the hospitality experience.</p>
      </div>
      <div class="benefits-grid">
        {benefits.map((b) => (
          <div class="benefit-card fade-in">
            <div class="benefit-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {b.title === 'UV Protection' && <path d="M12 2v8m0 12v.01M2 12h8m12 0h-8"/>}
                {b.title === 'Energy Efficiency' && <><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></>}
                {b.title === 'Privacy' && <><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></>}
                {b.title === 'Guest Comfort' && <><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/></>}
              </svg>
            </div>
            <div class="benefit-card__stat">{b.stat}</div>
            <div class="benefit-card__stat-label">{b.statLabel}</div>
            <h3 class="benefit-card__title">{b.title}</h3>
            <p class="benefit-card__body">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Statistics Row ── -->
  <section class="sec-stats">
    <div class="sec-stats__inner">
      {stats.map((s) => (
        <div class="stat-item fade-in">
          <span class="stat-item__value">{s.value}</span>
          <span class="stat-item__label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Brand Logos ── -->
  <BrandLogos />

  <!-- ── CTA Section ── -->
  <section class="sec-cta">
    <div class="sec-cta__inner">
      <h2 class="sec-cta__title">Ready to upgrade your property?</h2>
      <p class="sec-cta__sub">Get a free consultation and see how window film can transform your Philadelphia hotel.</p>
      <div class="sec-cta__btns">
        <a href="/contact/" class="btn btn--green">Get a Free Quote</a>
        <a href="tel:+1267****7980" class="btn btn--outline">Call (267) 394-7980</a>
      </div>
    </div>
  </section>

</div>

</BaseLayout>

<style>
/* ── Page body wrapper ── */
.ip-page-body {
  position: relative;
  background: var(--off-white, #F7F6F3);
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 0;
}

/* ── Gallery Section ── */
.sec-gallery {
  padding: 64px 5% 0;
  background: var(--off-white, #F7F6F3);
}
.sec-gallery__inner { max-width: 1200px; margin: 0 auto; }

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.gallery-row-two {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin-top: 16px;
  max-width: calc(66.667% - 8px);
}

.gallery-item {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 18px;
  overflow: hidden;
  cursor: pointer;
}
.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.45s ease;
  display: block;
}
.gallery-item:hover img {
  transform: scale(1.04);
}
.gallery-item__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(39, 46, 50, 0.65) 0%,
    rgba(39, 46, 50, 0.1) 50%,
    transparent 100%
  );
  display: flex;
  align-items: flex-end;
  padding: 24px;
  transition: background 0.35s ease;
}
.gallery-item:hover .gallery-item__overlay {
  background: linear-gradient(
    to top,
    rgba(39, 46, 50, 0.8) 0%,
    rgba(39, 46, 50, 0.25) 60%,
    transparent 100%
  );
}
.gallery-item__label {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 18px;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.2px;
}

/* ── Shared typography ── */
.eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}
.sec-hd {
  text-align: center;
  margin-bottom: 56px;
}
.sec-title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(30px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 16px;
}
.sec-lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  line-height: 1.75;
  color: var(--text-mid, #4a4a4a);
  max-width: 620px;
  margin: 0 auto;
}

/* ── Benefits Section ── */
.sec-benefits {
  padding: 80px 5% 90px;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  margin-top: 48px;
}
.sec-benefits__inner { max-width: 1200px; margin: 0 auto; }

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.benefit-card {
  background: #ffffff;
  border-radius: 18px;
  padding: 36px 28px;
  box-shadow: 0 4px 24px rgba(39, 46, 50, 0.08), 0 1px 4px rgba(39, 46, 50, 0.04);
  border: 1px solid rgba(39, 46, 50, 0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  text-align: center;
}
.benefit-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(39, 46, 50, 0.12), 0 2px 8px rgba(39, 46, 50, 0.06);
}
.benefit-card__icon {
  width: 56px;
  height: 56px;
  background: var(--green, #81AB4C);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  margin: 0 auto 20px;
}
.benefit-card__stat {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 40px;
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
  letter-spacing: -1px;
  margin-bottom: 4px;
}
.benefit-card__stat-label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--text-light, #888888);
  margin-bottom: 20px;
}
.benefit-card__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 20px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 12px;
  letter-spacing: -0.2px;
}
.benefit-card__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  line-height: 1.7;
  color: var(--text-mid, #4a4a4a);
  margin: 0;
}

/* ── Statistics Section ── */
.sec-stats {
  background: var(--brand, #272E32);
  padding: 80px 5%;
}
.sec-stats__inner {
  max-width: 900px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  text-align: center;
}
.stat-item {
  padding: 0 40px;
  border-right: 1px solid rgba(255, 255, 255, 0.1);
}
.stat-item:last-child { border-right: none; }
.stat-item__value {
  display: block;
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(48px, 5vw, 72px);
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
  margin-bottom: 10px;
  letter-spacing: -2px;
}
.stat-item__label {
  display: block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.55);
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

/* ── CTA Section ── */
.sec-cta {
  background: var(--brand, #272E32);
  border-radius: 40px;
  margin: 0 5% 80px;
  padding: 72px 60px;
}
.sec-cta__inner { text-align: center; max-width: 640px; margin: 0 auto; }
.sec-cta__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 44px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.15;
  margin: 0 0 12px;
  letter-spacing: -0.5px;
}
.sec-cta__sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: rgba(255, 255, 255, 0.6);
  margin: 0 0 36px;
  line-height: 1.6;
}
.sec-cta__btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

/* ── Buttons ── */
.btn {
  display: inline-block;
  padding: 15px 30px;
  border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
  border: 2px solid transparent;
  white-space: nowrap;
}
.btn--green {
  background: var(--green, #81AB4C);
  color: #ffffff;
  border-color: var(--green, #81AB4C);
}
.btn--green:hover {
  background: #6e9640;
  border-color: #6e9640;
  transform: translateY(-2px);
  color: #ffffff;
}
.btn--outline {
  background: transparent;
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.35);
}
.btn--outline:hover {
  border-color: #ffffff;
  transform: translateY(-2px);
  color: #ffffff;
}

/* ── Fade-in animation ── */
.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── Responsive ── */
@media (max-width: 1024px) {
  .benefits-grid { grid-template-columns: repeat(2, 1fr); }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .gallery-row-two { grid-template-columns: repeat(2, 1fr); max-width: 100%; }
  .sec-stats__inner { grid-template-columns: repeat(3, 1fr); }
  .stat-item:nth-child(2) { border-right: none; }
}
@media (max-width: 768px) {
  .sec-gallery { padding: 48px 5% 0; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .gallery-row-two { grid-template-columns: repeat(2, 1fr); }
  .sec-benefits { padding: 60px 5% 70px; margin-top: 32px; }
  .benefits-grid { grid-template-columns: 1fr; }
  .sec-stats { padding: 60px 5%; }
  .sec-stats__inner { grid-template-columns: 1fr; gap: 40px 0; }
  .stat-item { border-right: none !important; padding: 0; }
  .sec-cta { margin: 0 3% 60px; padding: 48px 28px; }
  .sec-cta__btns { flex-direction: column; width: 100%; }
  .sec-cta__btns .btn { width: 100%; text-align: center; }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>
