  .of-space-card__dark-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #F3F6F1;
    margin-bottom: 10px;
    line-height: 1.25;
  }
  .of-space-card__dark-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    color: rgba(243,246,241,0.72);
    line-height: 1.65;
