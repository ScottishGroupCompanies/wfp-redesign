  }
  .of-space-card__badge-content {
    position: absolute;
    inset: 0;
    z-index: 5;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .of-space-card__badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #7CB342;
    background: rgba(124,179,66,0.12);
