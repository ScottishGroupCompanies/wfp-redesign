    <!-- ══ CASE STUDY ══ -->
    <section class="of-project" id="featuredProject"><div class="of-project__inner"><div class="of-project__image-col"><img src="/images/hospital-window-film-case-study-university-city-philadelphia.jpg" alt="University City outpatient medical clinic after hospital window film installation" title="University City outpatient medical clinic after hospital window film installation" class="of-project__img" width="848" height="1264" loading="lazy" decoding="async" /><div class="of-project__stats-strip"><div class="of-project__stat"><span class="of-project__stat-num">3</span><span class="of-project__stat-label">Challenges Addressed</span></div><div class="of-project__stat-div"></div><div class="of-project__stat"><span class="of-project__stat-num">70</span><span class="of-project__stat-label">Prestige VLT</span></div><div class="of-project__stat-div"></div><div class="of-project__stat"><span class="of-project__stat-num">0</span><span class="of-project__stat-label">Clinical Disruption</span></div><div class="of-project__stat-div"></div><div class="of-project__stat"><span class="of-project__stat-num">S800</span><span class="of-project__stat-label">Pharmacy Safety Film</span></div></div></div><div class="of-project__text-col"><div class="of-project__eyebrow">University City · Outpatient Medical Clinic</div><h2 class="of-project__title">A University City Medical Clinic Solves Solar Comfort, Patient Privacy, and Pharmacy Security in a Single Installation</h2><div class="of-project__detail"><span class="of-project__detail-label">Challenge</span><span class="of-project__detail-val">South-facing patient waiting area experienced intense afternoon solar heat gain; patients complained of discomfort during extended waits; consultation rooms adjacent to public corridor had clear glass creating privacy concerns; pharmacy window lacked adequate security.</span></div><div class="of-project__detail"><span class="of-project__detail-label">Solution</span><span class="of-project__detail-val">3M Prestige 70 solar control film on south-facing waiting room and patient room windows; LLumar frosted privacy film on consultation room corridor-facing glass; 3M Scotchshield Ultra S800 safety film on pharmacy window.</span></div><div class="of-project__detail"><span class="of-project__detail-label">Result</span><span class="of-project__detail-val">Waiting room temperature measurably reduced on sunny afternoons, patient privacy concerns fully resolved at consultation rooms, pharmacy window upgraded to meet facility security requirements — all completed across two scheduled maintenance windows without affecting clinical operations.</span></div><div class="of-project__detail"><span class="of-project__detail-label">Support Docs</span><span class="of-project__detail-val"><a href="/resources/hospital-window-film-3m-prestige-70-solar-control-spec-philadelphia.pdf" target="_blank" rel="noopener noreferrer">3M Prestige 70 solar control spec</a> · <a href="/resources/hospital-window-film-llumar-reflective-privacy-spec-philadelphia.pdf" target="_blank" rel="noopener noreferrer">LLumar reflective privacy spec</a></span></div><a href="/contact/" class="of-project__cta">Discuss your facility →</a></div></div></section>

