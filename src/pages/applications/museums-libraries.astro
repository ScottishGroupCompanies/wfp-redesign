  /* ══════════════════════════════════════
     BENTO BAND
  ══════════════════════════════════════ */
  .of-bento {
    background: var(--of-dark);
    padding: 80px 5%;
  }
  .of-bento__header {
    max-width: 800px;
    margin: 0 auto 48px;
