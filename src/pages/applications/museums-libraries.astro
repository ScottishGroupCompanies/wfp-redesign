    <!-- ══ GALLERY ══ -->
    <section class="of-gallery" id="ofGallery">
      <div class="of-gallery__header"><p class="of-gallery__eyebrow">Museum &amp; Library Installations</p><h2 class="of-gallery__title">Window Film Across Philadelphia's Cultural Institutions</h2><p class="of-gallery__sub">Art museums, public libraries, history museums, university archives, and science centers treated for UV preservation, glare control, energy performance, and security.</p></div>
      <div class="of-gallery__grid">
        <div class="of-gallery__panel of-gallery__panel--tall"><img src="/images/mu-gallery-1.jpg" alt="Museum of Art gallery with UV conservation window film in Philadelphia" class="of-gallery__img" loading="lazy" /><div class="of-gallery__overlay"></div><div class="of-gallery__label"><span class="of-gallery__label-title">Museum of Art</span><span class="of-gallery__label-sub">UV Conservation</span></div></div>
