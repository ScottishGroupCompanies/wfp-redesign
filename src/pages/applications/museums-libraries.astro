---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Museum & Library Window Film in Philadelphia | Preservation, UV Protection & Energy Savings';
const description = 'Window film for Philadelphia museums and libraries: block 99% of UV rays to protect priceless artifacts, control glare for visitors, and reduce energy costs. Professional installation by certified technicians.';

const galleryImages = [
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175438_b9076a71-84ca-42f8-a050-52c4251c8cda.png', label: 'Artifact Preservation' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175440_a021f403-4b19-4661-89fc-f9f8748ade26.png', label: 'Energy Efficiency' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175441_2bf7f7ee-b250-4b07-a109-514c7ef21e2c.png', label: 'Museum Interior' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175441_b8d644eb-5c77-4ff0-862a-0cea6fb6b9f2.png', label: 'Security Film' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175443_6dae7fb2-0daa-4b21-ae3f-59fe7f464458.png', label: 'Glare-Free Viewing' },
];

const newImages = {
  hero: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175441_2bf7f7ee-b250-4b07-a109-514c7ef21e2c.png',
  uv: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175438_b9076a71-84ca-42f8-a050-52c4251c8cda.png',
  energy: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175440_a021f403-4b19-4661-89fc-f9f8748ade26.png',
  security: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_600/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_175441_b8d644eb-5c77-4ff0-862a-0cea6fb6b9f2.png',
};

const faqItems = [
  { question: 'How does UV film compare to UV-filtering glass?', answer: 'UV-filtering glass is a permanent replacement option but costs 5–10x more than window film and requires full glass replacement. UV-blocking window film achieves 99% UV rejection at a fraction of the cost, installs in days, and can be removed or replaced without altering the building. For most museums, film is the more practical and cost-effective solution.' },
  { question: 'Can film be installed on stained glass windows?', answer: 'Yes — but it requires specialized conservation-grade films and careful assessment by a trained installer. We work with conservators and curators to select films that provide UV protection without altering the color or appearance of stained glass. This is one of our most delicate specialty installations.' },
  { question: 'Does window film affect the appearance of historic buildings?', answer: 'We understand the sensitivity around historic preservation. We offer nearly invisible clear films that provide UV protection and some thermal benefit with virtually no change to the exterior appearance. For buildings with strict historic review requirements, we can provide documentation and samples for review before any installation.' },
  { question: 'How much can museums save on energy costs?', answer: 'Museums and libraries with large glass areas — atriums, skylights, and east/west-facing galleries — often see 20–30% reductions in cooling costs after film installation. Because these institutions typically run HVAC continuously to protect collections, the savings compound year-round. Many clients see payback within 3–5 years.' },
  { question: 'Is security film visible on glass?', answer: 'Security film is designed to be optically clear. From the street or gallery standpoint, it looks identical to untreated glass. The difference only becomes apparent under impact — where it holds shattered panes in the frame. We can combine security and solar-control films in a single installation when needed.' },
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Museum & Library Window Film Installation"
  serviceDesc="Professional window film installation for Philadelphia museums and libraries — UV protection for priceless collections, climate control, and display security."
  serviceUrl="https://www.windowfilmphiladelphia.com/applications/museums-libraries"
  faqItems={faqItems}
>
  <!-- HERO -->
  <section class="swt-hero">
    <div class="swt-hero__img">
      <img src={newImages.hero} alt="Philadelphia museum with window film protecting priceless collections" width="1440" height="700" />
      <div class="swt-hero__overlay"></div>
    </div>
    <div class="swt-hero__content">
      <span class="swt-badge">
        <svg width="8" height="8" viewBox="0 0 8 8" fill="none"><circle cx="4" cy="4" r="4" fill="#4E6B2A"/></svg>
        Cultural Institution Solutions
      </span>
      <h1 class="swt-hero__title">
        Preserve Your Collection.<br/>
        <em>Protect Your Visitors.</em><br/>
        Sustain Your Institution.
      </h1>
      <p class="swt-hero__sub">Block 99% of UV rays, regulate gallery climate, and eliminate glare — window film solutions engineered for Philadelphia's museums and libraries.</p>
      <div class="swt-hero__ctas">
        <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Assessment</a>
        <a href="#benefits" class="swt-btn swt-btn--ghost-light">See Benefits</a>
      </div>
    </div>
  </section>

  <div class="swt-body">

    <!-- TRUST BAR -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by Philadelphia's leading cultural institutions</p>
        <BrandLogos />
      </div>
    </section>

    <!-- SECTION 1: THE CHALLENGE — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="challenge">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">The Challenge</span>
            <h2 class="swt-h2 swt-h2--light">Philadelphia's Museums Are in a Constant Battle Against Their Own Windows</h2>
            <p>Natural light is among the most damaging forces a museum or library faces. UV rays, visible light, and infrared radiation pass through standard glass continuously — fading pigments, drying out organic materials, and degrading paper, textiles, and coatings at a molecular level.</p>
            <p>Philadelphia's historic buildings compound this problem. Many institutions occupy century-old structures with original single-pane glass — beautiful but thermally inefficient. The result is chronic climate instability, excessive energy costs, and gradual, irreversible damage to collections.</p>
            <div class="swt-problem-tags">
              <span class="swt-tag swt-tag--red">UV Degradation</span>
              <span class="swt-tag swt-tag--red">Climate Fluctuation</span>
              <span class="swt-tag swt-tag--red">Glare on Displays</span>
              <span class="swt-tag swt-tag--red">Display Case Vulnerability</span>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.uv} alt="UV light damage on museum artifacts and documents" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: UV — white bg, image left, text right -->
    <section class="swt-split" id="uv">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.uv} alt="UV protection film installed on museum gallery windows" loading="lazy" />
            <div class="swt-img-badge">
              <strong>99%</strong>
              <span>UV Blocked</span>
            </div>
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 01</span>
            <h2 class="swt-h2">Block 99% of UV Rays — Stop Fading Before It Starts</h2>
            <p>Fading from UV exposure is cumulative and irreversible. Once the pigments in a textile, painting, or document have broken down, nothing can restore them. Prevention is the only effective strategy — and window film is one of the most cost-effective prevention tools available.</p>
            <p>Conservation-grade UV-blocking films reject up to 99% of UV-A and UV-B radiation without significantly altering the appearance of your windows. For institutions with historic glass, stained glass, or sensitive east and west elevations, this is often the only practical solution that doesn't require glass replacement.</p>
            <ul class="swt-check-list">
              <li>Extended lifespan for paintings, textiles, and paper collections</li>
              <li>Reduced need for rotation of light-sensitive works</li>
              <li>Conservation-grade films compatible with archival display standards</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: ENERGY — alt cream bg, text left, image right -->
    <section class="swt-split swt-split--alt" id="energy">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 02</span>
            <h2 class="swt-h2">Climate Control Without Compromising Your Collection — or Your Budget</h2>
            <p>Museums and libraries maintain strict environmental controls to protect collections — but HVAC systems working against single-pane, unfilmed glass in historic buildings run expensively and constantly. Solar heat gain through untreated glass forces systems to work hardest precisely when they should be resting.</p>
            <p>Heat-rejecting window film reduces solar heat gain by up to 78%, allowing your HVAC system to operate more efficiently and consistently. The result is a more stable interior environment for both visitors and collections — at a fraction of the cost of replacing the glass itself.</p>
            <div class="swt-energy-metrics">
              <div class="swt-metric">
                <span class="swt-metric__num">30%</span>
                <span class="swt-metric__label">Avg. Cooling Cost Reduction</span>
              </div>
              <div class="swt-metric">
                <span class="swt-metric__num">3–5yr</span>
                <span class="swt-metric__label">Typical Payback Period</span>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.energy} alt="Philadelphia museum building exterior with efficient climate control" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: GLARE — white bg, image left, text right -->
    <section class="swt-split" id="glare">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.hero} alt="Museum gallery with glare-free natural lighting for visitors" loading="lazy" />
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 03</span>
            <h2 class="swt-h2">Eliminate Display Glare — Give Visitors the Experience They Came For</h2>
            <p>Glare doesn't just make it harder to read exhibit labels or view artwork — it creates an uncomfortable, lower-quality experience that undermines the institution's investment in its collections and programming. Visitors migrate away from glare-affected galleries, reducing engagement with entire wings.</p>
            <p>Glare-control window film selectively filters the wavelengths responsible for screen and surface glare while maintaining full natural daylight. The result is soft, even illumination throughout the gallery — the kind that makes collections look their best and keeps visitors停留 longer.</p>
            <blockquote class="swt-inline-quote">
              "Our east galleries were nearly unusable in the morning. After the film installation, they're some of our most popular spaces."
              <cite>— Curator of Exhibitions, Philadelphia cultural institution</cite>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: SECURITY — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="security">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow swt-eyebrow--green">Benefit 04</span>
            <h2 class="swt-h2 swt-h2--light">Security Film for Display Cases and Entrance Glass — Protection Without Compromise</h2>
            <p>Display cases and entrance glass are among the most vulnerable points in any museum or library. Security window film holds glass in the frame on impact — preventing the cascade of shards that causes injury and enabling faster emergency response. It slows forced entry by several critical minutes.</p>
            <p>For institutions displaying high-value artifacts, rare manuscripts, or serving high-traffic public hours, security film is a sensible, cost-effective layer of protection that doesn't alter the building's historic character or require replacing existing glass.</p>
            <div class="swt-security-features">
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Display Case Protection</strong>
                  <p>Glass stays intact on impact — protecting artifacts and visitors alike</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Entrance Glass Security</strong>
                  <p>Delayed entry provides critical response time for staff and authorities</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Storm Protection</strong>
                  <p>Philadelphia weather events are increasingly severe — film helps glass withstand impact</p>
                </div>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.security} alt="Museum security film protecting display cases and entrance glass" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY — 5 images -->
    <section class="swt-gallery" id="gallery">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">Our Work</span>
          <h2 class="swt-h2 swt-h2--center">Window Film — In Action</h2>
          <p class="swt-subhead">From gallery UV protection to climate control and security — here's what we install.</p>
        </div>
        <div class="swt-gallery__grid">
          {galleryImages.map((img, i) => (
            <div class="swt-gallery__item fade-in" style={`--delay: ${i * 80}ms`}>
              <img src={img.src} alt={img.label} loading="lazy" />
              <div class="swt-gallery__overlay">
                <span>{img.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STATS BAR — accent green -->
    <section class="swt-stats">
      <div class="container">
        <div class="swt-stats__row">
          <div class="swt-stats__item fade-in">
            <span class="swt-stats__num">16+</span>
            <span class="swt-stats__label">Years in Philadelphia</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 80ms">
            <span class="swt-stats__num">500+</span>
            <span class="swt-stats__label">Commercial Projects</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 160ms">
            <span class="swt-stats__num">99%</span>
            <span class="swt-stats__label">UV Rays Blocked</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 240ms">
            <span class="swt-stats__num">30%</span>
            <span class="swt-stats__label">Avg. Energy Savings</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS — 4 steps -->
    <section class="swt-process">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">How It Works</span>
          <h2 class="swt-h2 swt-h2--center">4 Steps to a Better-Preserved Institution</h2>
        </div>
        <div class="swt-process__steps">
          <div class="swt-process__step fade-in">
            <div class="swt-process__num">01</div>
            <div class="swt-process__body">
              <h3>Collection Survey & Risk Assessment</h3>
              <p>We conduct a thorough survey of your facility's glass — identifying which elevations, galleries, and display cases pose the greatest risk to your collections. We document light levels, UV index, and thermal conditions throughout the building to build a film specification matched to your specific needs.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 80ms">
            <div class="swt-process__num">02</div>
            <div class="swt-process__body">
              <h3>Conservation-Grade Film Selection</h3>
              <p>We work with curators and conservators to select the appropriate film for each zone — prioritizing optical clarity and conservation standards. For historic buildings, we provide samples and documentation for review by historic preservation officers or review boards before proceeding.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 160ms">
            <div class="swt-process__num">03</div>
            <div class="swt-process__body">
              <h3>Precision Installation</h3>
              <p>Our factory-trained installers work around your public hours and programming schedule. We use techniques calibrated for historic and heritage glass — avoiding any risk of thermal stress or frame damage. Installations are completed in discrete phases to avoid disrupting ongoing exhibitions.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 240ms">
            <div class="swt-process__num">04</div>
            <div class="swt-process__body">
              <h3>Ongoing Preservation Monitoring</h3>
              <p>We return annually to verify film performance and document any changes in light levels or UV transmission. Our conservation partners can provide detailed fading rate analysis using calibrated instruments — giving you quantifiable evidence of the film's protective effect over time.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS — dark bg -->
    <section class="swt-testimonials">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow swt-eyebrow--green">Client Stories</span>
          <h2 class="swt-h2 swt-h2--center swt-h2--light">Real Results from Real Institutions</h2>
        </div>
        <div class="swt-testimonials__grid">
          <div class="swt-testimonial fade-in">
            <div class="swt-testimonial__quote">"</div>
            <p>Our painting conservator was skeptical — she'd seen other "solutions" come and go. But after 18 months of data, she's a believer. The fading rate in our west gallery dropped measurably after the film went in. We wish we'd done it a decade ago.</p>
            <div class="swt-testimonial__author">
              <strong>Dr. Anne K.</strong>
              <span>Chief Conservator, Philadelphia museum</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 80ms">
            <div class="swt-testimonial__quote">"</div>
            <p>We serve school groups every morning, and the glare in our main reading room was making it impossible for kids to see the books they were looking at. The film made an immediate difference. The children can read comfortably now, and our librarians stopped getting headaches.</p>
            <div class="swt-testimonial__author">
              <strong>Thomas R.</strong>
              <span>Director, Philadelphia research library</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 160ms">
            <div class="swt-testimonial__quote">"</div>
            <p>Historic preservation board approval was a real concern. We needed documentation, samples, and a detailed appearance analysis before they'd approve anything. The team provided all of it — and the film is essentially invisible from the street. The board was satisfied and our collections are better protected.</p>
            <div class="swt-testimonial__author">
              <strong>Maria L.</strong>
              <span>Facilities Director, historic Philadelphia cultural institution</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="swt-faq" id="faq">
      <div class="container">
        <div class="swt-faq__layout">
          <div class="swt-faq__header fade-in">
            <span class="swt-eyebrow">Questions</span>
            <h2 class="swt-h2">Frequently Asked Questions</h2>
            <p>Honest answers from people who've been protecting Philadelphia's collections for over 16 years.</p>
            <a href="/contact/" class="swt-btn swt-btn--primary">Talk to a Specialist</a>
          </div>
          <div class="swt-faq__list fade-in">
            {faqItems.map((item) => (
              <div class="swt-faq__item">
                <div class="swt-faq__q">
                  <span>{item.question}</span>
                  <span class="swt-faq__toggle">+</span>
                </div>
                <div class="swt-faq__a">
                  <p>{item.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA BANNER -->
    <section class="swt-cta">
      <div class="swt-cta__inner">
        <div class="swt-cta__text">
          <h2>Ready to <em>protect</em> your collection for the next generation?</h2>
          <p>Get a free collection risk assessment and UV analysis. No obligation, no pressure — just honest, conservation-focused advice.</p>
        </div>
        <div class="swt-cta__btns">
          <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Assessment</a>
          <a href="tel:+126****7980" class="swt-btn swt-btn--ghost-light">Call (267) 394-7980</a>
        </div>
      </div>
    </section>

  </div><!-- /swt-body -->
</BaseLayout>

<style>
  /* ══════════════════════════════════════
     BRAND TOKENS (local override)
     ══════════════════════════════════════ */
  :root {
    --swt-green:        #4E6B2A;
    --swt-green-accent: #83A94A;
    --swt-dark:         #2A241E;
    --swt-cream:        #F4EFE6;
    --swt-alt:          #ECE4D4;
    --swt-border:       #E1D6C1;
    --swt-text-sec:     #6E665C;
    --swt-gold:         #846212;
    --swt-white:        #ffffff;
    --swt-radius:       5px;
  }

  /* ══════════════════════════════════════
     HERO
     ══════════════════════════════════════ */
  .swt-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .swt-hero__img {
    position: absolute;
    inset: 0;
  }
  .swt-hero__img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .swt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(42,36,30,0.9) 0%, rgba(42,36,30,0.6) 50%, rgba(42,36,30,0.35) 100%);
  }
  .swt-hero__content {
    position: relative;
    z-index: 1;
    padding: 110px 8% 90px;
    max-width: 720px;
  }
  .swt-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
    background: rgba(78,107,42,0.25);
    color: rgba(255,255,255,0.75);
    border: 1px solid rgba(78,107,42,0.4);
  }
  .swt-hero__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(38px, 5.5vw, 66px);
    font-weight: 400;
    color: var(--swt-white);
    line-height: 1.1;
    margin: 0 0 20px;
  }
  .swt-hero__title em {
    font-style: italic;
    color: var(--swt-green-accent);
  }
  .swt-hero__sub {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 17px;
    color: rgba(255,255,255,0.65);
    line-height: 1.7;
    margin: 0 0 36px;
    max-width: 500px;
  }
  .swt-hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ══════════════════════════════════════
     BUTTONS
