---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Museum & Library Window Film in Philadelphia | UV Protection for Artifacts & Collections';
const description = 'Window film for Philadelphia museums and libraries: protect priceless artifacts, documents, and collections from harmful UV rays. Maintain perfect viewing conditions with professional installation.';

const heroImage = 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161453_dd0988e5-3650-4928-b7e8-05cab024928f.png';

const gallery = [
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163404_0869fb3d-e841-4709-85fc-2113e3147633.png',
    label: 'Collection Protection',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163401_f68228ec-fe56-48e5-94f3-aa085c691e64.png',
    label: 'UV Blocked',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163906_e0f8ee22-fdd4-42a4-b1bf-b025b1926c55.png',
    label: 'Museum Exterior',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163909_b8bfca96-2bb4-4601-91b9-e688ae6686b7.png',
    label: 'Archive Preservation',
  },
  {
    src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163511_a650aea4-54d3-4da7-ac89-5368bdf6fdcd.png',
    label: 'Reading Room Comfort',
  },
];

const benefits = [
  {
    heading: 'UV Protection',
    body: 'Block 99% of harmful UV rays, protecting priceless artifacts and documents from irreversible damage.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>`,
  },
  {
    heading: 'Climate Control',
    body: 'Maintain stable temperature and humidity levels, ideal for sensitive collections.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"/></svg>`,
  },
  {
    heading: 'Glare Reduction',
    body: 'Eliminate glare on display cases and reading areas for better viewing.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v2"/><path d="M12 21v2"/><path d="M4.22 4.22l1.42 1.42"/><path d="M18.36 18.36l1.42 1.42"/><path d="M1 12h2"/><path d="M21 12h2"/><path d="M4.22 19.78l1.42-1.42"/><path d="M18.36 5.64l1.42-1.42"/></svg>`,
  },
  {
    heading: 'Privacy',
    body: 'Control visibility into private archives and restricted areas.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
  },
];

const stats = [
  { value: '99%', label: 'UV Blocked' },
  { value: '50+', label: 'Cultural Institutions' },
  { value: '16+', label: 'Years Experience' },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/applications/museums-libraries/" serviceName="Museum & Library Window Film" serviceDesc="UV-blocking and solar control window film for museums and libraries in Philadelphia. Protect collections and artifacts from UV damage." serviceUrl="https://www.windowfilmphiladelphia.net/applications/museums-libraries/">

<InnerPageHero
  title="Museum & Library Window Film"
  desc="Protect Collections · Block 99% UV · Preserve History"
  bgImage={heroImage}
/>

<div class="ip-page-body">

  <!-- Gallery Section -->
  <section class="gallery-section">
    <div class="gallery-section__inner">
      <div class="gallery-row gallery-row--top">
        {gallery.slice(0, 3).map((img) => (
          <div class="gallery-item fade-in">
            <img src={img.src} alt={img.label} loading="lazy" />
            <div class="gallery-item__overlay">
              <span class="gallery-item__label">{img.label}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="gallery-row gallery-row--bottom">
        {gallery.slice(3).map((img) => (
          <div class="gallery-item fade-in">
            <img src={img.src} alt={img.label} loading="lazy" />
            <div class="gallery-item__overlay">
              <span class="gallery-item__label">{img.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="benefits-section">
    <div class="benefits-section__inner">
      <div class="benefits-section__hd">
        <span class="eyebrow">Key Benefits</span>
        <h2 class="benefits-section__title">Why Museums & Libraries Choose Window Film</h2>
      </div>
      <div class="benefits-grid">
        {benefits.map((b) => (
          <div class="benefit-card fade-in">
            <div class="benefit-card__icon" set:html={b.icon} />
            <h3 class="benefit-card__heading">{b.heading}</h3>
            <p class="benefit-card__body">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Museums Section -->
  <section class="why-museums">
    <div class="why-museums__inner">
      <span class="eyebrow">Collection Preservation</span>
      <h2 class="why-museums__title">Protecting Cultural Heritage for Future Generations</h2>
      <p class="why-museums__lead">Museums and libraries hold some of the world's most irreplaceable collections — manuscripts, textiles, paintings, and historical artifacts that must be preserved for generations. Harmful ultraviolet light is one of the leading causes of irreversible damage to these materials, causing fading, brittleness, and discoloration. Our specialized window film solutions filter out up to 99% of UV rays while preserving crystal-clear glass visibility, so your visitors enjoy unobstructed views of your collections without compromise. Combined with solar heat reduction and glare control, window film creates the stable, low-UV environment that archivists and conservators recommend.</p>
    </div>
  </section>

  <!-- Statistics Row -->
  <section class="stats-section">
    <div class="stats-section__inner">
      {stats.map((s) => (
        <div class="stat-card fade-in">
          <span class="stat-card__value">{s.value}</span>
          <span class="stat-card__label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="cta-section__inner">
      <h2 class="cta-section__title">Protect Your Collections Today</h2>
      <p class="cta-section__sub">Get a free consultation and discover how window film can transform your facility.</p>
      <div class="cta-buttons">
        <a href="/contact/" class="cta-btn">Get a Free Quote</a>
        <a href="tel:+12155551234" class="cta-phone">(215) 555-1234</a>
      </div>
    </div>
  </section>

  <BrandLogos />

</div>

</BaseLayout>

<style>
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* Eyebrow */
.eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

/* Gallery Section */
.gallery-section {
  padding: 80px 10% 60px;
}
.gallery-section__inner {
  max-width: 1200px;
  margin: 0 auto;
}
.gallery-row {
  display: grid;
  gap: 20px;
}
.gallery-row--top {
  grid-template-columns: repeat(3, 1fr);
}
.gallery-row--bottom {
  grid-template-columns: repeat(2, 1fr);
  max-width: calc(66.667% - 10px);
  margin-left: 0;
  padding-left: calc(33.333% + 10px);
}
.gallery-item {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 18px;
  overflow: hidden;
  cursor: pointer;
}
.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.gallery-item__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(39, 46, 50, 0.8) 0%, transparent 60%);
  display: flex;
  align-items: flex-end;
  padding: 24px;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.gallery-item__label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.3px;
}
.gallery-item:hover img {
  transform: scale(1.04);
}
.gallery-item:hover .gallery-item__overlay {
  opacity: 1;
}

/* Benefits Section */
.benefits-section {
  padding: 80px 10%;
}
.benefits-section__inner {
  max-width: 1200px;
  margin: 0 auto;
}
.benefits-section__hd {
  margin-bottom: 56px;
}
.benefits-section__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
}
.benefits-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.benefit-card {
  background: #ffffff;
  border-radius: 18px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  padding: 36px 28px;
  display: flex;
  flex-direction: column;
  gap: 0;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.benefit-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
}
.benefit-card__icon {
  width: 56px;
  height: 56px;
  background: var(--green-light, #eef4e4);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  color: var(--green, #81AB4C);
}
.benefit-card__heading {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 20px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 12px;
}
.benefit-card__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.7;
  margin: 0;
}

/* Why Museums Section */
.why-museums {
  padding: 80px 10%;
  background: var(--off-white, #F7F6F3);
}
.why-museums__inner {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
}
.why-museums__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 24px;
}
.why-museums__lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.8;
  margin: 0;
}

/* Statistics Section */
.stats-section {
  padding: 80px 10%;
  background: var(--brand, #272E32);
}
.stats-section__inner {
  max-width: 900px;
  margin: 0 auto;
  display: flex;
  justify-content: space-around;
  align-items: center;
  gap: 40px;
}
.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  flex: 1;
}
.stat-card__value {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(48px, 6vw, 80px);
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
  margin-bottom: 8px;
}
.stat-card__label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

/* CTA Section */
.cta-section {
  padding: 80px 10%;
  background: var(--brand, #272E32);
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
}
.cta-section__inner {
  max-width: 700px;
  margin: 0 auto;
  text-align: center;
}
.cta-section__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 4vw, 48px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  margin: 0 0 16px;
}
.cta-section__sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: rgba(255, 255, 255, 0.6);
  margin: 0 0 36px;
  line-height: 1.6;
}
.cta-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  flex-wrap: wrap;
}
.cta-btn {
  display: inline-block;
  padding: 16px 40px;
  border-radius: 100px;
  background: var(--green, #81AB4C);
  color: #ffffff;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
  border: 2px solid var(--green, #81AB4C);
}
.cta-btn:hover {
  background: #6e9640;
  border-color: #6e9640;
  transform: translateY(-2px);
}
.cta-phone {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.7);
  text-decoration: none;
  transition: color 0.2s ease;
}
.cta-phone:hover {
  color: #ffffff;
}

/* Fade in animation */
.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* Responsive */
@media (max-width: 1024px) {
  .benefits-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .gallery-row--top {
    grid-template-columns: repeat(3, 1fr);
  }
  .gallery-row--bottom {
    grid-template-columns: repeat(2, 1fr);
    max-width: 100%;
    padding-left: 0;
  }
  .stats-section__inner {
    flex-direction: column;
    gap: 32px;
  }
}
@media (max-width: 768px) {
  .gallery-section {
    padding: 60px 5% 40px;
  }
  .benefits-section {
    padding: 60px 5%;
  }
  .why-museums {
    padding: 60px 5%;
  }
  .stats-section {
    padding: 60px 5%;
  }
  .cta-section {
    padding: 60px 5%;
  }
  .benefits-grid {
    grid-template-columns: 1fr;
  }
  .gallery-row--top {
    grid-template-columns: 1fr 1fr;
  }
  .gallery-row--top .gallery-item:last-child {
    grid-column: 1 / -1;
  }
  .gallery-row--bottom {
    grid-template-columns: 1fr 1fr;
  }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>
