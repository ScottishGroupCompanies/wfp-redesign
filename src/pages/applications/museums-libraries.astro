---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Museum & Library Window Film in Philadelphia | UV Protection for Artifacts & Collections';
const description = 'Window film for Philadelphia museums and libraries: protect priceless artifacts, documents, and collections from harmful UV rays. Maintain perfect viewing conditions.';
const heroImage = 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_161453_dd0988e5-3650-4928-b7e8-05cab024928f.png';

const benefits = [
  {
    heading: 'UV Protection',
    body: 'Block up to 99% of harmful UV rays that cause fading, fabric degradation, and irreversible damage to priceless artifacts, documents, and artwork on display.',
    icon: '☀️',
  },
  {
    heading: 'Climate Control',
    body: 'Reduce solar heat gain and maintain stable interior temperatures, protecting sensitive materials from thermal expansion, moisture fluctuation, and climate-related deterioration.',
    icon: '🌡️',
  },
  {
    heading: 'Glare Reduction',
    body: 'Eliminate distracting glare on glass display cases and reading areas, creating comfortable, optimal viewing conditions for visitors and staff throughout the day.',
    icon: '👁️',
  },
  {
    heading: 'Privacy',
    body: 'Apply decorative or frosted window film to create private consultation zones, secure storage areas, and elegant spatial divisions without sacrificing natural light.',
    icon: '🔒',
  },
];

const stats = [
  { value: '99%', label: 'UV Blocked' },
  { value: '40%', label: 'Heat Reduction' },
  { value: '15+', label: 'Years Serving Philadelphia' },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/applications/museums-libraries/" serviceName="Museum & Library Window Film" serviceDesc="UV-blocking and solar control window film for museums and libraries in Philadelphia. Protect collections and artifacts from UV damage." serviceUrl="https://www.windowfilmphiladelphia.net/applications/museums-libraries/">

<InnerPageHero
  title="Museum & Library Window Film"
  desc="Protect collections · Block 99% UV · Preserve history"
  bgImage={heroImage}
/>

<div class="ip-page-body">

  <!-- Benefits Section -->
  <section class="benefits-section">
    <div class="benefits-section__inner">
      <div class="benefits-section__hd">
        <span class="eyebrow">Key Benefits</span>
        <h2 class="benefits-section__title">Why museums & libraries choose window film</h2>
      </div>
      <div class="benefits-grid">
        {benefits.map((b) => (
          <div class="benefit-card fade-in">
            <div class="benefit-card__icon">{b.icon}</div>
            <h3 class="benefit-card__heading">{b.heading}</h3>
            <p class="benefit-card__body">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Museums Section -->
  <section class="why-museums">
    <div class="why-museums__inner">
      <span class="eyebrow">Collection Preservation</span>
      <h2 class="why-museums__title">Protecting artifacts, preserving history</h2>
      <p class="why-museums__lead">Museums and libraries hold some of the world's most irreplaceable collections — manuscripts, textiles, paintings, and historical artifacts that must be protected for generations. Harmful ultraviolet light is one of the leading causes of irreversible damage to these materials, causing fading, brittleness, and discoloration. Our specialized window film solutions filter out up to 99% of UV rays while preserving crystal-clear glass visibility, so your visitors enjoy unobstructed views of your collections without compromise. Combined with solar heat reduction and glare control, window film creates the stable, low-UV environment that archivists and conservators recommend.</p>
    </div>
  </section>

  <!-- Statistics Row -->
  <section class="stats-section">
    <div class="stats-section__inner">
      {stats.map((s) => (
        <div class="stat-card fade-in">
          <span class="stat-card__value">{s.value}</span>
          <span class="stat-card__label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="cta-section__inner">
      <h2 class="cta-section__title">Ready to protect your collections?</h2>
      <p class="cta-section__sub">Get a free consultation and see how window film can transform your facility.</p>
      <a href="/contact/" class="cta-btn">Get a Free Quote</a>
    </div>
  </section>

  <BrandLogos />

</div>

</BaseLayout>

<style>
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* Eyebrow label */
.eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

/* Benefits Section */
.benefits-section {
  padding: 100px 10% 80px;
}
.benefits-section__inner {
  max-width: 1200px;
  margin: 0 auto;
}
.benefits-section__hd {
  margin-bottom: 56px;
}
.benefits-section__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
}
.benefits-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.benefit-card {
  background: #ffffff;
  border-radius: 18px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  padding: 36px 28px;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.benefit-card__icon {
  font-size: 36px;
  margin-bottom: 20px;
  line-height: 1;
}
.benefit-card__heading {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 20px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 12px;
}
.benefit-card__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.7;
  margin: 0;
}

/* Why Museums Section */
.why-museums {
  padding: 80px 10%;
  background: var(--off-white, #F7F6F3);
}
.why-museums__inner {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
}
.why-museums__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 24px;
}
.why-museums__lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.8;
  margin: 0;
}

/* Statistics Section */
.stats-section {
  padding: 80px 10%;
  background: var(--brand, #272E32);
}
.stats-section__inner {
  max-width: 900px;
  margin: 0 auto;
  display: flex;
  justify-content: space-around;
  align-items: center;
  gap: 40px;
}
.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  flex: 1;
}
.stat-card__value {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(48px, 6vw, 80px);
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
  margin-bottom: 8px;
}
.stat-card__label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

/* CTA Section */
.cta-section {
  padding: 80px 10%;
  background: var(--brand, #272E32);
}
.cta-section__inner {
  max-width: 700px;
  margin: 0 auto;
  text-align: center;
}
.cta-section__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 4vw, 48px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  margin: 0 0 16px;
}
.cta-section__sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: rgba(255, 255, 255, 0.6);
  margin: 0 0 36px;
  line-height: 1.6;
}
.cta-btn {
  display: inline-block;
  padding: 16px 40px;
  border-radius: 100px;
  background: var(--green, #81AB4C);
  color: #ffffff;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
  border: 2px solid var(--green, #81AB4C);
}
.cta-btn:hover {
  background: #6e9640;
  border-color: #6e9640;
  transform: translateY(-2px);
}

/* Fade in animation */
.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* Responsive */
@media (max-width: 1024px) {
  .benefits-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .stats-section__inner {
    flex-direction: column;
    gap: 32px;
  }
}
@media (max-width: 768px) {
  .benefits-section {
    padding: 60px 5% 60px;
  }
  .why-museums {
    padding: 60px 5%;
  }
  .stats-section {
    padding: 60px 5%;
  }
  .cta-section {
    padding: 60px 5%;
  }
  .benefits-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>
