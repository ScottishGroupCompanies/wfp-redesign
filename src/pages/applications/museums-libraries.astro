---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import FlipWords from '../../components/FlipWords.astro';

const title = 'Library & Museum Window Film Philly | UV Preservation';
const description = 'Library and museum window film for Philadelphia: block 99% UV, protect artifacts and collections, reduce glare, cut energy costs. AIC-standard installation.';
const canonical = 'https://www.windowfilmphiladelphia.net/applications/museums-libraries/';

const faqItems = [
  {
    question: 'What UV protection level do AIC conservation standards require?',
    answer: 'The American Institute for Conservation recommends keeping UV radiation below 10 uW/lm for sensitive collections. Conservation-grade window film blocks up to 99% of UV radiation at the glass, giving museums and libraries a practical path to AIC-referenced protection without changing the building envelope.'
  },
  {
    question: 'Can window film protect existing stained glass or decorative historic windows?',
    answer: 'Yes. Clear UV conservation film can be specified for compatible historic, stained, or decorative glass after a professional glass assessment. The goal is to reduce damaging UV transmission while preserving the visible character of the window and supporting Philadelphia historic preservation requirements.'
  },
  {
    question: 'Will film affect the color rendering index for accurate artwork viewing?',
    answer: 'Conservation-grade UV film is optically clear and selected to preserve color accuracy. For galleries where curators need reliable artwork viewing, we recommend high-VLT films that block UV while maintaining the natural color quality of daylight and exhibit lighting.'
  },
  {
    question: 'How does glare reduction film improve the visitor experience without blocking light?',
    answer: 'Glare reduction film cuts harsh visible glare before it washes out artwork, display screens, or reading surfaces. The right film keeps rooms daylit while removing the uncomfortable brightness that makes visitors squint, shortens viewing time, and makes library tables hard to use.'
  },
  {
    question: 'Can film be installed without closing the museum or library?',
    answer: 'Yes. Museum window film for Philadelphia and library window film for Philadelphia projects are planned around public programming, collection access, and staff workflows. We phase work by room or glass area, protect nearby materials, and coordinate with facilities teams so the institution can keep operating.'
  },
  {
    question: 'Does window film require Philadelphia Historical Commission approval for landmark buildings?',
    answer: 'Some landmark buildings may require review, especially if exterior appearance changes. We can specify clear or low-reflective films, provide product data, and support the documentation your team needs for Philadelphia Historical Commission or preservation consultant review.'
  },
  {
    question: 'How does film help with climate control for temperature-sensitive collections?',
    answer: 'Solar control film rejects heat before it enters through glass, reducing the load on HVAC systems that maintain collection-safe temperature and humidity ranges. For museums and libraries, that helps stabilize galleries, reading rooms, archives, and special collections without replacing windows.'
  },
  {
    question: 'Is window film reversible if conservation requirements change?',
    answer: 'Yes. Professionally installed window film can be removed from compatible glass without destructive alteration. That reversibility matters for museums, libraries, archives, and historic buildings where future conservation standards or exhibit plans may require a different specification.'
  },
  {
    question: 'What manufacturer warranty covers UV protection performance claims?',
    answer: 'Warranty terms vary by manufacturer and film series, but professional-grade 3M, LLumar, Vista, and Solar Gard films include written performance documentation for UV rejection, visible light transmission, and durability. We provide the relevant manufacturer data sheets with every museum or library specification package.'
  },
  {
    question: 'Can security film and UV conservation film be combined in a single installation?',
    answer: 'Yes. Many institutions combine UV conservation, solar control, glare reduction, and security goals in one specification. Depending on the glass and risk profile, we can recommend a single multi-benefit film or a coordinated film package for entries, display cases, galleries, archives, and reading rooms.'
  }
];

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': canonical + '#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Applications', item: 'https://www.windowfilmphiladelphia.net/applications/' },
      { '@type': 'ListItem', position: 3, name: 'Library & Museum Window Film', item: canonical }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonical,
    url: canonical,
    name: title,
    description,
    dateModified: new Date().toISOString().slice(0, 10),
    primaryImageOfPage: { '@type': 'ImageObject', url: 'https://www.windowfilmphiladelphia.net/images/mu-hero.jpg' },
    breadcrumb: { '@id': canonical + '#breadcrumb' },
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.of-hero__title', '.of-whatis__title', '.swt-faq'] }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Library and Museum Window Film Solutions Philadelphia',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'UV Conservation Film', description: 'Optically clear film that blocks 99% of UV radiation for artifact preservation and AIC-referenced collection protection.' },
      { '@type': 'ListItem', position: 2, name: 'Glare Reduction Film', description: 'Reduces harsh daylight glare in galleries, exhibits, reading rooms, and visitor spaces while preserving natural light.' },
      { '@type': 'ListItem', position: 3, name: 'Solar Control & Energy Film', description: 'Rejects solar heat gain to reduce HVAC load in climate-managed museums, libraries, archives, and science centers.' },
      { '@type': 'ListItem', position: 4, name: 'Security & Anti-Intrusion Film', description: 'Holds shattered glass together to delay forced entry and protect visitors and collections from flying glass.' },
      { '@type': 'ListItem', position: 5, name: 'Privacy Film', description: 'Frosted and privacy films for staff areas, special collections rooms, and restricted research spaces.' },
      { '@type': 'ListItem', position: 6, name: 'Decorative Film', description: 'Branded, frosted, and wayfinding films for exhibit transitions, donor recognition glass, and interior partitions.' }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Library and Museum Window Film Installation Philadelphia',
    description: 'Professional UV conservation, glare reduction, solar control, security, privacy, and decorative window film for Philadelphia museums and libraries.',
    brand: { '@type': 'Brand', name: 'Window Film Philadelphia' },
    aggregateRating: { '@type': 'AggregateRating', ratingValue: '5.0', reviewCount: '47', bestRating: '5', worstRating: '1' },
    review: [
      { '@type': 'Review', author: { '@type': 'Person', name: 'Curator, Philadelphia art institution' }, reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }, reviewBody: 'We needed UV protection that would not change how visitors see the work. The recommended film gave us the conservation data we needed and the galleries still look natural.' },
      { '@type': 'Review', author: { '@type': 'Person', name: 'Director of Facilities, Free Library of Philadelphia' }, reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }, reviewBody: 'The afternoon glare in our reading areas was a constant complaint. Window film improved patron comfort and helped our facilities team reduce solar heat gain across the branch.' },
      { '@type': 'Review', author: { '@type': 'Person', name: 'Collections Manager, Philadelphia history museum' }, reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }, reviewBody: 'We combined UV protection with security film at vulnerable glass areas. The installation team understood the sensitivity of the collection spaces and documented everything clearly.' }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.windowfilmphiladelphia.net/applications/museums-libraries/"
  serviceName="Library & Museum Window Film Philadelphia"
  serviceDesc="Professional window film installation for Philadelphia museums, libraries, archives, and cultural institutions — UV preservation, glare control, energy management, privacy, and security."
  serviceUrl={canonical}
  faqItems={faqItems}
  schemas={pageSchemas}
>

  <!-- ══ HERO ══ -->
  <section class="of-hero mu-hero">
    <div
      class="of-hero__bg"
      role="img"
      aria-label="Philadelphia museum gallery and library reading room glass treated with UV conservation window film"
      style="background-image: url('/images/mu-hero.jpg')"
    ></div>
    <div class="of-hero__overlay"></div>

    <div class="of-hero__content">

      <div class="of-hero__eyebrow">
        <span>Museum &amp; Library Window Film</span>
        <span class="of-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Philadelphia</span>
        <span class="of-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>3M Certified Dealer</span>
      </div>

      <h1 class="of-hero__title">Library &amp; Museum Window Film</h1>

      <p class="of-hero__animated-line">
        <FlipWords
          words={["for Philadelphia Museums &amp; Libraries", "for Philadelphia Art Museums", "for Philadelphia Libraries", "for Philadelphia's History Museums", "for Philadelphia University Archives", "for Philadelphia Science Centers"]}
          staticText=""
          class="of-hero__flip"
        />
      </p>

      <p class="of-hero__subtitle">
        Museum window film for Philadelphia and library window film for Philadelphia institutions supports UV preservation, glare control for visitors, collection climate management, and security for the city's museums, libraries, archives, and science centers.
      </p>

      <div class="of-hero__cta">
        <a href="/contact/" class="of-hero__btn-primary">Request a Museum Assessment</a>
        <a href="tel:2673947980" class="of-hero__btn-secondary">Call (267) 394-7980</a>
      </div>

      <div class="of-hero__stats-panel" aria-label="Key statistics">
        <div class="of-hero__stats-inner">
          <div class="of-hero__stat"><span class="of-hero__stat-number">99%</span><span class="of-hero__stat-label">UV Blocked</span></div>
          <div class="of-hero__stat-divider" aria-hidden="true"></div>
          <div class="of-hero__stat"><span class="of-hero__stat-number">70-90%</span><span class="of-hero__stat-label">Glare Reduced</span></div>
          <div class="of-hero__stat-divider" aria-hidden="true"></div>
          <div class="of-hero__stat"><span class="of-hero__stat-number">3M</span><span class="of-hero__stat-label">Certified Dealer</span></div>
          <div class="of-hero__stat-divider" aria-hidden="true"></div>
          <div class="of-hero__stat"><span class="of-hero__stat-number">AIC</span><span class="of-hero__stat-label">Referenced Specs</span></div>
        </div>
      </div>

    </div>
  </section>

  <div class="swt-body">

    <!-- ══ TRUST BAR ══ -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted window film guidance for Philadelphia cultural, civic, educational, and public facilities</p>
        <BrandLogos />
      </div>
    </section>

    <!-- ══ WHAT IS OFFICE WINDOW FILM ══ -->
    <section class="of-whatis">
      <div class="of-whatis__container">
        <div class="of-whatis__content">
          <span class="of-whatis__eyebrow">Philadelphia's Certified Window Film Installer</span>
          <h2 class="of-whatis__title">Philadelphia's Greatest Collections Face One Common Threat: Unprotected Glass</h2>
          <p class="of-whatis__body">Philadelphia has one of the greatest museum concentrations in the United States, from the Barnes Foundation and Philadelphia Museum of Art to the Franklin Institute, Rodin Museum, and Penn Museum. These buildings welcome daylight, but untreated glass exposes artifacts, textiles, paper, photographs, and exhibit materials to cumulative damage.</p>
          <p class="of-whatis__body">The Free Library of Philadelphia operates 54 branches, each with its own mix of reading rooms, circulating collections, public computers, community spaces, and rare materials. Library window film for Philadelphia branches reduces glare for patrons, blocks damaging UV, and helps facilities teams manage solar heat through older and modern glazing alike.</p>
          <p class="of-whatis__body">UV damage to artifacts and collections is irreversible, which is why conservation teams reference American Institute for Conservation standards when evaluating daylight exposure. As a 3M Certified Dealer, we specify museum window film for Philadelphia institutions with documented UV rejection, visible light transmission, security, and energy performance data.</p>
          <div class="of-whatis__stats">
            <div class="of-whatis__stat"><strong>54</strong><span>Free Library branches</span></div>
            <div class="of-whatis__stat-div"></div>
            <div class="of-whatis__stat"><strong>99%</strong><span>UV radiation blocked</span></div>
            <div class="of-whatis__stat-div"></div>
            <div class="of-whatis__stat"><strong>3M</strong><span>Certified Dealer</span></div>
          </div>
        </div>
        <div class="of-whatis__image-wrap">
          <img src="/images/mu-whatis.jpg" alt="Philadelphia museum gallery with clear UV conservation window film protecting artwork and artifacts" class="of-whatis__image" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- ══ THE PROBLEM ══ -->
    <section class="of-why" id="problem">
      <div class="of-why__container">
        <div class="of-why__image-wrap">
          <img src="/images/mu-why.jpg" alt="Sunlit Philadelphia museum gallery with large glass facade creating UV and glare exposure" class="of-why__image" loading="lazy" />
          <div class="of-why__stat-card">
            <div class="of-why__stat-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>UV damage to collections is cumulative and irreversible</span></div>
            <div class="of-why__stat-divider"></div>
            <div class="of-why__stat-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>Reading rooms lose usability when afternoon glare is uncontrolled</span></div>
          </div>
        </div>

        <div class="of-why__content">
          <div class="of-why__eyebrow">The Challenge</div>
          <h2 class="of-why__headline">Sunlight Is the Invisible Threat Inside Philadelphia's Greatest Collections</h2>
          <p class="of-why__intro">UV radiation causes irreversible fading of pigments, textiles, paper, and organic materials. Even low-UV daylight creates cumulative exposure over years of display, storage, research, and public use. For institutions with large glass facades along the Parkway and throughout the city, the threat is built into the architecture.</p>
          <ul class="of-why__bullets">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>UV exposure breaks down pigments, dyes, lignin, binders, and organic materials that cannot be restored to original condition.</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Visible daylight and solar heat continue to stress collections even when glass blocks some UV by itself.</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Museums with broad glazed entrances and gallery-adjacent windows are particularly vulnerable to solar gain and washed-out exhibits.</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Library reading rooms with poor glare control become hard to use in afternoon light, especially at tables near south- and west-facing glass.</li>
          </ul>
          <div class="of-why__climate-facts">
            <div class="of-why__climate-item"><span class="of-why__climate-num">99%</span><span class="of-why__climate-label">UV rejection available for conservation specifications</span></div>
            <div class="of-why__climate-item"><span class="of-why__climate-num">75 lux</span><span class="of-why__climate-label">AIC-referenced UV exposure threshold for sensitive materials</span></div>
            <div class="of-why__climate-item"><span class="of-why__climate-num">54</span><span class="of-why__climate-label">Free Library branches facing varied solar and glare conditions</span></div>
          </div>
          <a href="/contact/" class="of-why__cta">Schedule a conservation film assessment <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg></a>
        </div>
      </div>
    </section>

    <!-- ══ BENTO BAND ══ -->
    <section class="of-bento">
      <div class="of-bento__header">
        <h2 class="of-bento__title">Conservation-Grade Performance for Philadelphia's Collections</h2>
        <p class="of-bento__sub">One glass upgrade can support preservation, visitor comfort, facility performance, and security.</p>
      </div>
      <div class="of-bento__compact">
        <div class="of-bento-item"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><circle cx="14" cy="14" r="9" stroke="#7CB342" stroke-width="1.5"/><path d="M14 7v2M14 19v2M7 14h2M19 14h2" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round"/><circle cx="14" cy="14" r="3" fill="#7CB342" fill-opacity="0.15" stroke="#7CB342" stroke-width="1"/></svg><div><h3 class="of-bento-item__title">99% UV Blocked</h3><p class="of-bento-item__text">Meets AIC conservation standards for artifact protection and long-term collection care.</p></div></div>
        <div class="of-bento-item"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M3 14s4-7 11-7 11 7 11 7-4 7-11 7S3 14 3 14z" stroke="#7CB342" stroke-width="1.5"/><circle cx="14" cy="14" r="3" fill="#7CB342" fill-opacity="0.15" stroke="#7CB342" stroke-width="1.5"/></svg><div><h3 class="of-bento-item__title">Glare Eliminated</h3><p class="of-bento-item__text">Visitors can view artwork, read labels, study, and use public computers without eye strain.</p></div></div>
        <div class="of-bento-item"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M14 3L5 8v7c0 5 4 9 9 10 5-1 9-5 9-10V8L14 3z" stroke="#7CB342" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 14l3 3 5-5" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><div><h3 class="of-bento-item__title">3M Certified Dealer</h3><p class="of-bento-item__text">Only certified installer serving Philadelphia museums with documented product specifications.</p></div></div>
        <div class="of-bento-item"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M15 2L6 15h7l-1 11 10-15h-7l0-9z" stroke="#7CB342" stroke-width="1.5" stroke-linejoin="round"/></svg><div><h3 class="of-bento-item__title">20-30% Energy Savings</h3><p class="of-bento-item__text">Typical cooling cost reduction for large glazed institutions using solar control film.</p></div></div>
      </div>
    </section>

    <!-- ══ OFFICE SPACE TYPE GRID ══ -->
    <section class="of-spaces">
      <div class="of-spaces__container">
        <div class="of-spaces__header">
          <div class="of-spaces__eyebrow">Institution Types</div>
          <h2 class="of-spaces__headline">Window Film for Every Philadelphia Museum and Library</h2>
          <p class="of-spaces__sub">Different collections, buildings, and public spaces need different combinations of UV rejection, glare control, energy performance, privacy, and security.</p>
        </div>
        <div class="of-spaces__grid">

          <!-- Card 1: Art Museums — hero -->
          <div class="of-space-card of-space-card--hero">
            <div class="of-space-card__hero-icon">
              <svg width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true">
                <rect x="6" y="8" width="32" height="24" rx="2" stroke="#7CB342" stroke-width="1.5"/>
                <rect x="10" y="12" width="10" height="8" rx="1" stroke="#7CB342" stroke-width="1" opacity="0.6"/>
                <rect x="24" y="12" width="10" height="8" rx="1" stroke="#7CB342" stroke-width="1" opacity="0.6"/>
                <path d="M10 24h24" stroke="#7CB342" stroke-width="1" opacity="0.4"/>
                <path d="M16 36v-4M28 36v-4" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="of-space-card__hero-title">Art Museums &amp; Galleries</h3>
            <p class="of-space-card__hero-text">Gallery windows are the primary UV risk for permanent collections. Conservation-grade UV film blocks 99% of ultraviolet radiation — the threshold recommended by the American Institute for Conservation — while glare reduction film eliminates the wash-out that makes artwork hard to view. Both can be specified in a single coordinated installation.</p>
            <div class="of-space-card__pill">UV Conservation + Glare Control</div>
          </div>

          <!-- Card 2: Libraries — photo -->
          <div class="of-space-card of-space-card--photo">
            <img src="/images/mu-type-library.jpg" alt="Philadelphia public library reading room with glare reduction window film for patron comfort" width="400" height="480" loading="lazy" class="of-space-card__img" />
            <div class="of-space-card__photo-overlay"></div>
            <div class="of-space-card__photo-content">
              <h3 class="of-space-card__photo-title">Public &amp; Branch Libraries</h3>
              <p class="of-space-card__photo-text">Afternoon glare on reading tables and computer screens is the most common complaint — glare reduction film reclaims those spaces without darkening the room.</p>
            </div>
          </div>

          <!-- Card 3: History Museums — photo -->
          <div class="of-space-card of-space-card--photo">
            <img src="/images/mu-type-history.jpg" alt="Philadelphia history museum exhibit hall with artifact-protecting UV window film" width="400" height="480" loading="lazy" class="of-space-card__img" />
            <div class="of-space-card__photo-overlay"></div>
            <div class="of-space-card__photo-content">
              <h3 class="of-space-card__photo-title">History &amp; Science Museums</h3>
              <p class="of-space-card__photo-text">Organic artifacts — textiles, paper, leather, natural specimens — are especially vulnerable to UV. Conservation film protects exhibits without altering gallery light quality.</p>
            </div>
          </div>

          <!-- Card 4: University Libraries — dark -->
          <div class="of-space-card of-space-card--dark">
            <div class="of-space-card__accent-line" aria-hidden="true"></div>
            <div class="of-space-card__icon-row">
              <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <path d="M6 28V10l11-5 11 5v18" stroke="#7CB342" stroke-width="1.5" stroke-linejoin="round"/>
                <rect x="12" y="16" width="10" height="12" rx="1" stroke="#7CB342" stroke-width="1.5"/>
                <path d="M17 16v12" stroke="#7CB342" stroke-width="1" opacity="0.4"/>
              </svg>
            </div>
            <h3 class="of-space-card__dark-title">University Libraries &amp; Research Collections</h3>
            <p class="of-space-card__dark-text">Research libraries face a distinct challenge: faculty and graduate students need natural light for long work sessions, but rare book and manuscript collections near windows require strict UV control. We specify different films for reading and collection zones in the same installation.</p>
            <div class="of-space-card__micro-pill">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l3 6.5L22 9l-5 5 1.18 7L12 18l-6.18 3L7 14 2 9l7-.5L12 2z" stroke="#7CB342" stroke-width="2" stroke-linejoin="round"/></svg>
              UV Protection + Glare Control
            </div>
          </div>

          <!-- Card 5: Science Centers — dark-pattern -->
          <div class="of-space-card of-space-card--dark-pattern">
            <div class="of-space-card__icon-row">
              <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <circle cx="17" cy="17" r="5" stroke="#7CB342" stroke-width="1.5"/>
                <path d="M17 4v5M17 25v5M4 17h5M25 17h5M7.5 7.5l3.5 3.5M23 23l3.5 3.5M26.5 7.5L23 11M11 23l-3.5 3.5" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="of-space-card__dark-title">Science Centers &amp; Planetariums</h3>
            <p class="of-space-card__dark-text">Interactive science exhibits and planetarium lobbies require controlled daylight. Solar control film reduces glare on interactive screens and exhibit panels while maintaining the bright, energetic atmosphere that engages visitors of all ages.</p>
            <div class="of-space-card__micro-pill">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l3 6.5L22 9l-5 5 1.18 7L12 18l-6.18 3L7 14 2 9l7-.5L12 2z" stroke="#7CB342" stroke-width="2" stroke-linejoin="round"/></svg>
              Solar Control + Security
            </div>
          </div>

          <!-- Card 6: Archives — badge -->
          <div class="of-space-card of-space-card--badge">
            <img src="/images/mu-type-archive.jpg" alt="Special collections and archives room with conservation-grade UV window film Philadelphia" width="520" height="360" loading="lazy" class="of-space-card__img" />
            <div class="of-space-card__badge-overlay"></div>
            <div class="of-space-card__badge-content">
              <div class="of-space-card__badge-pill">
