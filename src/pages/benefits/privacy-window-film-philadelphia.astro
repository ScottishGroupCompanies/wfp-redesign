</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));

  document.querySelectorAll('.auron-faq__item').forEach(item => {
    item.querySelector('.auron-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('auron-faq__item--open');
      document.querySelectorAll('.auron-faq__item').forEach(i => i.classList.remove('auron-faq__item--open'));
      if (!isOpen) item.classList.add('auron-faq__item--open');
    });
  });
</script>
