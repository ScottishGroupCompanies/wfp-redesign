  .auron-feat--rev .auron-feat__img { order: 0; }
  .auron-feat--rev .auron-feat__content { order: 1; }
  .auron-mission__inner { grid-template-columns: 1fr; }
  .auron-benefits__grid { grid-template-columns: repeat(2, 1fr); }
  .auron-benefit:nth-child(4n) { border-right: 1px solid #E8E8E0; }
