---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import FlipWords from '../../components/FlipWords.astro';

const title = 'Privacy Window Film Philadelphia | Frosted & One-Way Mirror Film';
const description = 'Privacy window film in Philadelphia - frosted, decorative, and one-way mirror films that block unwanted views while keeping natural light. Free estimate.';

const heroImage = 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181859_31ec3d4f-26af-4deb-8e15-706faf51648b.png';

const galleryImages = [
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163219_ef8a6773-eb18-43d3-a8cf-305c12c72dd2.png', label: 'Frosted Conference Room' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163222_79b81cd9-fd33-453a-8c62-ab37d4d031d1.png', label: 'One-Way Mirror Office' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163225_ef3d64e4-534f-42b3-bc9b-af78ddffac20.png', label: 'Decorative Pattern Film' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163229_6541b9dc-3f99-46f5-bc6f-5aecd8fd77ae.png', label: 'Privacy for Ground Floor' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170332_7a02abaf-9a99-4d42-b4d6-965dcbfe18ea.png', label: 'Bathroom Privacy Film' },
];

const faqItems = [
  { question: "What's the difference between frosted film and one-way mirror film?", answer: "Frosted film creates a uniformly translucent, etched-glass look - it blocks visibility equally from both sides and is ideal for bathrooms, conference rooms, and private offices. One-way mirror film (also called day-night privacy film) uses a reflective coating to create a mirror-like appearance from the outside during daylight hours while allowing clear visibility from inside. The effect reverses at night when interior lights are on, so supplemental treatments may be needed for round-the-clock privacy." },
  { question: "Does privacy film work at night when interior lights are on?", answer: "One-way mirror films lose their mirror effect at night when interior lighting is brighter than exterior light - people outside can see in. For nighttime privacy, we recommend pairing one-way film with blinds or curtains, or choosing frosted decorative film which works 24/7 regardless of lighting conditions. We can assess your building's lighting environment and recommend the right solution." },
  { question: "Can privacy film be removed and reused?", answer: "Privacy films are designed for permanent installation and are not typically reusable if removed. The adhesive bonds strongly over time, and removing and reapplying will usually damage the film. However, film is relatively inexpensive to replace compared to frosted glass, so a new installation is often the more practical approach if your needs change." },
  { question: "What's the best privacy film for bathrooms?", answer: "For bathrooms, we strongly recommend frosted film - either a standard frosted finish or a decorative patterned frosted. Frosted film provides consistent privacy regardless of lighting conditions, resists moisture, and is easy to clean. It also avoids the mirror effect that can feel uncomfortable in private spaces. We offer several opacity levels and patterns so you can control exactly how much light filters through." },
  { question: "Does film affect emergency egress visibility?", answer: "Privacy films - especially frosted films - can reduce visibility through glass, which is an important consideration for emergency egress windows and fire-rated assemblies. If the affected windows serve as emergency exits, we select films that meet applicable safety standards and we clearly advise on any restrictions. Most standard privacy films do not affect the structural integrity of the glass or impede emergency egress in non-fire-rated applications." },
  { question: "What's the difference between privacy window film and window tinting?", answer: "Window tinting typically refers to solar control film — designed primarily to reduce heat and glare while darkening the glass. Privacy window film is designed specifically to block visibility, either by making the glass translucent (frosted) or reflective (one-way mirror). Some films do both: spectrally selective privacy films can block unwanted views while also rejecting solar heat. We'll help you identify which type — or combination — is right for your Philadelphia property." },
  { question: "Can privacy window film be applied to double-pane windows?", answer: "Yes. Most professional privacy films are engineered for dual-pane and triple-pane glass. The key is selecting the right film — certain highly absorptive films can cause heat buildup between the panes, which may void the insulated glass unit warranty. We only recommend films that are rated safe for your specific glass type, and we'll confirm compatibility before installation." },
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Privacy Window Film Installation"
  serviceDesc="Professional privacy window film installation for Philadelphia homes and offices - frosted, decorative, and one-way mirror films that block views while letting in natural light."
  serviceUrl="https://www.windowfilmphiladelphia.net/benefits/privacy-window-film-philadelphia"
  faqItems={faqItems}
>
  <!-- HERO -->
  <section class="priv-hero">
    <div class="priv-hero__bg" style={`background-image: url('${heroImage}')`} role="img" aria-label="Privacy window film installed in a Philadelphia office with frosted glass"></div>
    <div class="priv-hero__overlay"></div>
    <div class="priv-hero__content">

      <div class="priv-hero__eyebrow">
        <span>Philadelphia Privacy Film</span>
        <span class="priv-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Frosted & One-Way Mirror</span>
        <span class="priv-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Since 2008</span>
      </div>

      <h1 class="priv-hero__title">Privacy Window Film<br class="priv-hero__br"/> for Philadelphia</h1>

      <p class="priv-hero__animated-line">
        <FlipWords
          words={["The Privacy You Need.", "The Light You Want."]}
          staticText=""
          class="priv-hero__flip"
        />
      </p>

      <p class="priv-hero__subtitle">
        Frosted, decorative, and one-way mirror privacy window film for Philadelphia offices and homes - professional installation at a fraction of the cost of frosted glass.
      </p>

      <div class="priv-hero__cta">
        <a href="/contact/" class="priv-hero__btn-primary">Get Your Free Estimate</a>
        <a href="tel:2673947980" class="priv-hero__btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z" fill="currentColor"/></svg>
          Call (267) 394-7980
        </a>
      </div>

      <div class="priv-hero__stats-panel" aria-label="Key statistics">
        <div class="priv-hero__stats-inner">
          <div class="priv-hero__stat">
            <span class="priv-hero__stat-number">24/7</span>
            <span class="priv-hero__stat-label">24/7 Privacy</span>
          </div>
          <div class="priv-hero__stat-divider" aria-hidden="true"></div>
          <div class="priv-hero__stat">
            <span class="priv-hero__stat-number">2008</span>
            <span class="priv-hero__stat-label">Serving Philadelphia Since</span>
          </div>
          <div class="priv-hero__stat-divider" aria-hidden="true"></div>
          <div class="priv-hero__stat">
            <span class="priv-hero__stat-number">500+</span>
            <span class="priv-hero__stat-label">Commercial Projects</span>
          </div>
          <div class="priv-hero__stat-divider" aria-hidden="true"></div>
          <div class="priv-hero__stat">
            <span class="priv-hero__stat-number">90%</span>
            <span class="priv-hero__stat-label">Less Than Frosted Glass</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <div class="swt-body">

    <!-- TRUST BAR -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by leading Philadelphia businesses</p>
        <BrandLogos />
      </div>
    </section>

    <!-- SECTION 1: THE PROBLEM -->
    <section class="priv-why" id="problem">
      <div class="priv-why__container">

        <div class="priv-why__image-wrap">
          <img
            src="/images/privacy-window-film-philadelphia-problem.jpg"
            alt="Philadelphia office building with floor-to-ceiling windows fully visible from the street - showing the need for privacy window film"
            class="priv-why__image"
            loading="lazy"
          />
          <div class="priv-why__stat-card">
            <div class="priv-why__stat-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>24/7 privacy with frosted film</span>
            </div>
            <div class="priv-why__stat-divider"></div>
            <div class="priv-why__stat-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Natural light fully preserved</span>
            </div>
            <div class="priv-why__stat-divider"></div>
            <div class="priv-why__stat-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>90% less than frosted glass</span>
            </div>
          </div>
        </div>

        <div class="priv-why__content">
          <div class="priv-why__eyebrow">The Challenge</div>
          <h2 class="priv-why__headline">Every Glass Surface Is a Privacy Compromise</h2>
          <p class="priv-why__intro">Philadelphia's dense, walkable streets make this problem acute. Law firms on Market Street, medical offices in University City, financial services firms in Center City, ground-floor retail on Walnut - every one of them has glass that exposes their people, their work, and their conversations to anyone walking by.</p>
          <ul class="priv-why__bullets">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Pedestrians and neighboring tenants can see directly into your office, exam room, or workspace.
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Blinds solve the view problem but block the natural light your team depends on.
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Frosted or etched glass requires full window replacement - costly, time-consuming, disruptive.
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              HIPAA, attorney-client privilege, and basic confidentiality all demand a better solution.
            </li>
          </ul>
          <p class="priv-why__closing">Privacy window film in Philadelphia solves all of this - no blinds, no glass replacement, no darkness. Just privacy that works from the moment it's installed.</p>
          <a href="/contact/" class="priv-why__cta">
            Get a free privacy consultation
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
          </a>
        </div>

      </div>
    </section>

    <!-- FILM TYPE SLIDER: Frosted / One-Way Mirror / Decorative -->
    <section class="priv-slider" id="privSlider">
      <div class="priv-slider__track" id="privTrack">

        <!-- SLIDE 01: Frosted Film -->
        <div class="priv-slider__slide" data-slide="0">
          <img src="/images/privacy-window-film-frosted-philadelphia.jpg" alt="Frosted privacy window film on Philadelphia office conference room" class="priv-slider__bg" />
          <div class="priv-slider__overlay"></div>
          <div class="priv-slider__content">
            <div class="priv-slider__step">01</div>
            <h2 class="priv-slider__title">Frosted Film.
Elegant. 24/7.</h2>
            <p class="priv-slider__desc">Frosted privacy window film in Philadelphia transforms any glass surface into the appearance of etched or sandblasted glass - at roughly 1/10th the cost of real frosted glass. Consistent privacy day and night, regardless of lighting conditions. Available in a wide range of opacity levels and patterns from the leading brands we carry.</p>
            <div class="priv-slider__faq">
              <div class="priv-slider__faq-item">
                <button class="priv-slider__faq-q" aria-expanded="false">What opacity levels are available?<span class="priv-slider__faq-icon" aria-hidden="true">+</span></button>
                <div class="priv-slider__faq-a" hidden>Frosted films range from light diffusion (90% VLT - subtle privacy) to near-opaque full block. We offer low, medium, and high privacy options across multiple brands so you can control exactly how much light passes through. We bring a full sample kit to every consultation.</div>
              </div>
              <div class="priv-slider__faq-item">
                <button class="priv-slider__faq-q" aria-expanded="false">Does frosted film block views from both sides?<span class="priv-slider__faq-icon" aria-hidden="true">+</span></button>
                <div class="priv-slider__faq-a" hidden>Yes - unlike one-way mirror film, frosted film blocks visibility equally from both sides at all times. It works 24/7 regardless of whether it's day or night or whether interior lights are on.</div>
              </div>
              <div class="priv-slider__faq-item">
                <button class="priv-slider__faq-q" aria-expanded="false">Can I get a custom pattern or design?<span class="priv-slider__faq-icon" aria-hidden="true">+</span></button>
                <div class="priv-slider__faq-a" hidden>Yes. 3M FASARA offers over 100 pre-printed decorative patterns including geometric designs, gradients, and textures. We can also work with you on custom graphics and company logo integration for branded spaces.</div>
              </div>
            </div>
            <a href="/contact/" class="priv-slider__cta">Get a frosted film estimate →</a>
          </div>
        </div>

        <!-- SLIDE 02: One-Way Mirror -->
        <div class="priv-slider__slide" data-slide="1">
          <img src="/images/privacy-window-film-one-way-mirror-philadelphia.jpg" alt="One-way mirror privacy window film on Philadelphia street-facing office" class="priv-slider__bg" />
          <div class="priv-slider__overlay"></div>
          <div class="priv-slider__content">
            <div class="priv-slider__step">02</div>
            <h2 class="priv-slider__title">One-Way Mirror.
See Out. Not In.</h2>
            <p class="priv-slider__desc">One-way mirror privacy window film for Philadelphia storefronts and street-facing offices creates a mirror-like exterior during daylight hours while preserving your complete outward view. Pedestrians see only their reflection. Your team sees the street.</p>
            <div class="priv-slider__faq">
              <div class="priv-slider__faq-item">
                <button class="priv-slider__faq-q" aria-expanded="false">Does one-way mirror film work at night?<span class="priv-slider__faq-icon" aria-hidden="true">+</span></button>
                <div class="priv-slider__faq-a" hidden>One-way films rely on a lighting differential to work - when the outside is brighter than inside, the mirror effect holds. At night, when interior lights are on, the effect reverses. For 24/7 privacy we recommend pairing with frosted film or choosing frosted for nighttime-sensitive spaces.</div>
              </div>
              <div class="priv-slider__faq-item">
                <button class="priv-slider__faq-q" aria-expanded="false">How much light does it block?<span class="priv-slider__faq-icon" aria-hidden="true">+</span></button>
                <div class="priv-slider__faq-a" hidden>Maximum daytime privacy is achieved at VLT below 20% - meaning less than 20% of visible light passes through. Higher VLT options (30-50%) are less reflective but allow more light. We'll recommend the right balance for your space during the consultation.</div>
              </div>
              <div class="priv-slider__faq-item">
                <button class="priv-slider__faq-q" aria-expanded="false">Is it good for Philadelphia storefronts?<span class="priv-slider__faq-icon" aria-hidden="true">+</span></button>
                <div class="priv-slider__faq-a" hidden>Yes - it's one of the most popular options for Walnut Street retail, ground-floor offices, and street-facing medical spaces. It maintains a professional, polished exterior appearance while giving your team complete visibility out.</div>
              </div>
            </div>
            <a href="/contact/" class="priv-slider__cta">Get a one-way mirror estimate →</a>
          </div>
        </div>

        <!-- SLIDE 03: Decorative -->
        <div class="priv-slider__slide" data-slide="2">
          <img src="/images/privacy-window-film-decorative-philadelphia.jpg" alt="Decorative privacy window film pattern on Philadelphia office lobby glass partition" class="priv-slider__bg" />
          <div class="priv-slider__overlay"></div>
          <div class="priv-slider__content">
            <div class="priv-slider__step">03</div>
            <h2 class="priv-slider__title">Decorative Film.
Privacy Meets Design.</h2>
            <p class="priv-slider__desc">Decorative privacy window film transforms Philadelphia offices, lobbies, and conference rooms into branded, design-forward spaces. With hundreds of patterns available across the brands we carry - geometric lattices, frosted gradients, etched textures, custom graphics - the result looks like custom etched glass at a fraction of the cost. Eligible for LEED v4 credits.</p>
            <div class="priv-slider__faq">
              <div class="priv-slider__faq-item">
                <button class="priv-slider__faq-q" aria-expanded="false">Can decorative film include our company logo?<span class="priv-slider__faq-icon" aria-hidden="true">+</span></button>
                <div class="priv-slider__faq-a" hidden>Yes. Many of the decorative films we carry can be electrocut into custom shapes and designs, including company logos, wordmarks, and custom graphics. This is a popular option for lobby glass, reception partitions, and branded conference rooms throughout Philadelphia.</div>
              </div>
              <div class="priv-slider__faq-item">
                <button class="priv-slider__faq-q" aria-expanded="false">Does it qualify for LEED credits?<span class="priv-slider__faq-icon" aria-hidden="true">+</span></button>
                <div class="priv-slider__faq-a" hidden>Yes - select decorative window films qualify as a component of LEED Sustainable Design (LEEDv4). For Philadelphia commercial properties pursuing LEED certification, decorative window film can contribute to relevant credits. Each application is evaluated individually; we can advise during your consultation.</div>
              </div>
              <div class="priv-slider__faq-item">
                <button class="priv-slider__faq-q" aria-expanded="false">How many pattern options are available?<span class="priv-slider__faq-icon" aria-hidden="true">+</span></button>
                <div class="priv-slider__faq-a" hidden>Across the brands we carry - including Solyx, HDClear, LLumar, and others - there are hundreds of pre-printed patterns available, covering everything from subtle diffusion to bold geometric statements. We bring a physical sample book to every consultation so you can see options in your actual space.</div>
              </div>
            </div>
            <a href="/contact/" class="priv-slider__cta">Explore decorative options →</a>
          </div>
        </div>

      </div>

      <!-- Right nav -->
      <nav class="priv-slider__nav" aria-label="Slide navigation">
        <button class="priv-slider__nav-item priv-slider__nav-item--active" data-privnav="0">
          <span class="priv-slider__nav-line"></span>
          <span class="priv-slider__nav-label">Frosted</span>
        </button>
        <button class="priv-slider__nav-item" data-privnav="1">
          <span class="priv-slider__nav-line"></span>
          <span class="priv-slider__nav-label">One-Way Mirror</span>
        </button>
        <button class="priv-slider__nav-item" data-privnav="2">
          <span class="priv-slider__nav-line"></span>
          <span class="priv-slider__nav-label">Decorative</span>
        </button>
      </nav>

      <!-- Arrows -->
      <button class="priv-slider__arrow priv-slider__arrow--prev" id="privPrev" aria-label="Previous slide">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="priv-slider__arrow priv-slider__arrow--next" id="privNext" aria-label="Next slide">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>

      <!-- Progress bar -->
      <div class="priv-slider__progress"><div class="priv-slider__progress-bar" id="privProgressBar"></div></div>

    </section>

    <!-- SECTIONS 5+6: BENTO GRID - Light Balance + Cost Benefits -->
    <section class="priv-bento" id="lightbalance">
      <div class="priv-bento__container">
        <div class="priv-bento__header">
          <div class="priv-bento__eyebrow">Key Benefits</div>
          <h2 class="priv-bento__headline">Privacy Without Sacrificing Your Light</h2>
          <p class="priv-bento__sub">The most common objection to privacy solutions is that they darken a space. Privacy window film in Philadelphia eliminates that trade-off entirely.</p>
        </div>
        <div class="priv-bento__grid">

          <div class="priv-bento-card priv-bento-card--hero">
            <div class="priv-bento-card__hero-icon">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="10" stroke="#7CB342" stroke-width="1.5"/><path d="M24 6v4M24 38v4M6 24h4M38 24h4M10.1 10.1l2.83 2.83M35.07 35.07l2.83 2.83M10.1 37.9l2.83-2.83M35.07 12.93l2.83-2.83" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <h3 class="priv-bento-card__hero-title">The Only Solution That Does Both</h3>
            <p class="priv-bento-card__hero-text">Frosted and decorative films filter and diffuse light beautifully - spaces feel bright and open, not closed off. One-way mirror film preserves full light transmission while blocking outside views. You get privacy and natural light, not a choice between them.</p>
            <div class="priv-bento-card__pill">No Blinds Required</div>
          </div>

          <div class="priv-bento-card priv-bento-card--photo">
            <img src="/images/privacy-window-film-natural-light-philadelphia.jpg" alt="Philadelphia office with privacy window film maintaining full natural light" loading="lazy" class="priv-bento-card__img" />
            <div class="priv-bento-card__photo-overlay"></div>
            <div class="priv-bento-card__photo-content">
              <h3 class="priv-bento-card__photo-title">Natural Light Preserved</h3>
              <p class="priv-bento-card__photo-text">Film filters and softens light - spaces stay bright and welcoming.</p>
            </div>
          </div>

          <div class="priv-bento-card priv-bento-card--photo">
            <img src="/images/privacy-window-film-employee-comfort-philadelphia.jpg" alt="Philadelphia office employees comfortable and focused with privacy window film" loading="lazy" class="priv-bento-card__img" />
            <div class="priv-bento-card__photo-overlay"></div>
            <div class="priv-bento-card__photo-content">
              <h3 class="priv-bento-card__photo-title">Employee Comfort &amp; Focus</h3>
