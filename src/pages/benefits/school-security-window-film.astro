---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import FlipWords from '../../components/FlipWords.astro';

const title = 'School Security Window Film Philadelphia | K-12 Safety';
const description = 'School security window film in Philadelphia. Safety film that holds glass during forced entry, active threats, and accidents — protecting students and staff.';
const heroImage = '/images/school-security-window-film-philadelphia-hero.jpg';
const serviceUrl = 'https://www.windowfilmphiladelphia.net/benefits/school-security-window-film/';

const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Benefits", "item": "https://www.windowfilmphiladelphia.net/benefits/" },
      { "@type": "ListItem", "position": 3, "name": "School Security Window Film", "item": "https://www.windowfilmphiladelphia.net/benefits/school-security-window-film/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.windowfilmphiladelphia.net/benefits/school-security-window-film/",
    "name": title,
    "description": description,
    "dateModified": new Date().toISOString().slice(0, 10),
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".ss-hero__title", ".ss-why__headline", ".swt-faq__a"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "School Security Window Film Types — Philadelphia",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "3M Scotchshield Ultra S800", "description": "8 mil clear security film tested to GSA TS01-2003 blast standard. Holds glass in place after impact." },
      { "@type": "ListItem", "position": 2, "name": "Solar Gard Armorcoat 14 mil", "description": "Heavy-duty 14 mil safety film tested to ASTM F1642. Provides extended forced entry delay." },
      { "@type": "ListItem", "position": 3, "name": "Madico Clear Safety 14 mil", "description": "Multi-layer 14 mil safety film. Texas School District case study validated performance." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "School Security Window Film Philadelphia",
    "description": "Safety and security window film for Philadelphia K-12 schools, universities, and childcare facilities. Holds glass in place during forced entry attempts, active threats, and accidents — protecting students and staff.",
    "brand": { "@type": "Brand", "name": "Window Film Philadelphia" },
    "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "areaServed": "Philadelphia, PA" },
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "67", "bestRating": "5" },
    "review": [
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Principal Sarah M." }, "reviewBody": "We installed security window film on every entrance glass panel during the summer break. The installation team worked quickly and efficiently. Our staff feels significantly more confident about the physical security of our building." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "David K." }, "reviewBody": "As facilities director for a Philadelphia school district we've been looking for cost-effective ways to harden our buildings. Security window film on the entry glass has been one of the most affordable interventions we've made." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Linda P." }, "reviewBody": "Our daycare facility needed to reassure parents about security. The film on our entrance glass is invisible but the knowledge that it significantly delays forced entry has made a real difference in how families feel about drop-off." }
    ]
  }
];

const faqItems = [
  { question: 'How does school security window film protect students?', answer: 'School security window film holds glass together after impact rather than allowing it to shatter into dangerous fragments or fall out of the frame. During a forced entry attempt, an intruder must apply sustained, repeated force to penetrate film-protected glass — this delay is critical for students and staff to shelter in place or evacuate. The film does not stop determined intrusion indefinitely, but it significantly increases the time available for lockdown procedures and law enforcement response.' },
  { question: 'What is the difference between 4 mil, 8 mil, and 14 mil security film?', answer: 'Film thickness is measured in mils (thousandths of an inch). Thicker films provide greater fragment retention and longer forced entry delay. Standard safety film starts at 4 mil and provides basic fragment retention. Security film at 8 mil (such as 3M Scotchshield Ultra S800) is tested to GSA TS01-2003 standards and provides meaningful forced entry delay. Heavy-duty 14 mil film (Solar Gard Armorcoat, Madico Clear Safety) provides maximum forced entry resistance and is appropriate for primary entrance glass and high-risk glazing. We evaluate each school building and recommend the appropriate mil rating for each location.' },
  { question: 'Can school security film be installed over summer break?', answer: 'Yes — summer break is the preferred installation window for school security film projects. Philadelphia K-12 schools typically complete security film installation during July and August when buildings are unoccupied. This eliminates disruption to the school day, allows installers to work on all glazing simultaneously, and ensures the film is fully cured before the academic year begins.' },
  { question: 'Does the film affect how the glass looks?', answer: 'Security window film is optically clear — it does not tint, color, or visually alter the appearance of glass. From inside or outside the building, windows and glass doors look identical before and after installation. There is no visible difference to students, parents, or visitors. The only way to detect the film is close physical inspection.' },
  { question: 'Does security window film stop bullets?', answer: 'Standard security window film is not designed or rated to stop ballistic impacts. The film holds glass together and delays forced entry by hand or hand tool — it is not a ballistic barrier. For ballistic-rated glazing, laminated polycarbonate or purpose-built ballistic glass is required. Our team can advise on the appropriate solution for your facility\'s specific risk profile.' },
  { question: 'What ASTM or GSA standards does school security film meet?', answer: '3M Scotchshield Ultra S800 is tested to GSA TS01-2003, the General Services Administration blast mitigation standard. Solar Gard Armorcoat 14 mil is tested to ASTM F1642, the standard specification for glazing and glazing systems subject to airblast loadings. These standards measure fragment retention and glass integrity after impact — not forced entry specifically, but they validate the film\'s ability to hold glass in place under significant force.' },
  { question: 'Is security film required for Philadelphia schools?', answer: 'Philadelphia school security requirements are established by the School District of Philadelphia and state guidelines, not by a single mandated film specification. Many Philadelphia school districts and private schools have voluntarily adopted security film as a cost-effective physical hardening measure. Our team can provide documentation and product specifications to support procurement and administrative approval processes.' },
  { question: 'How much does school security window film cost?', answer: 'We do not publish per-square-foot pricing as costs depend on the number of windows, glass size, accessibility, film product selected, and the scope of the installation. School security film consistently costs significantly less than window replacement, laminated safety glass, or polycarbonate panels. Most school districts find it the most cost-effective physical hardening option available for existing glazing. Contact us for a free site assessment and written proposal.' },
  { question: 'Does the film help with UV and energy costs as well?', answer: 'Many security films also block up to 99% of UV radiation and provide modest solar heat rejection — an added benefit for classrooms with east and west-facing windows. While the primary reason to install security film is safety, the UV-blocking and heat-rejection properties reduce fading of classroom materials and can reduce cooling load in warm months.' },
  { question: 'How do I get school security window film installed in Philadelphia?', answer: 'Contact us for a free site assessment. We evaluate your school\'s entry glass, corridor windows, classroom glazing, and identify the highest-priority areas for security film installation. We then recommend the appropriate film specification for each zone and provide a detailed proposal. We work around your school calendar and can complete most installations during summer break.' }
];

const slides = [
  {
    step: '01',
    nav: '3M S800',
    img: '/images/school-security-film-philadelphia-scotchshield-s800.jpg',
    alt: '3M Scotchshield Ultra S800 security film on Philadelphia school entrance glass',
    title: 'Scotchshield Ultra S800. GSA-Tested. School Ready.',
    desc: '3M Scotchshield Ultra S800 is an 8 mil optically clear security film tested to GSA TS01-2003 — the U.S. General Services Administration\'s blast mitigation standard. At 8 mil, the film holds glass fragments in place after impact and requires sustained, repeated force to penetrate. It is one of the most widely specified security films for school entrance glass, sidelights, and corridor windows in Philadelphia and across Pennsylvania.',
    stat: '8 mil thickness tested to GSA TS01-2003 — holds glass intact under blast-equivalent impact force.',
    faqs: [
      ['Is S800 right for school entrances?', 'Yes. S800 is a strong fit for primary entrances, vestibules, sidelights, and corridor glass where clear appearance and meaningful forced entry delay are both priorities.'],
      ['How long does forced entry take through S800?', 'Exact delay depends on glass type, frame strength, attachment system, and tool used. The important difference is that film-protected glass requires sustained repeated impacts rather than failing open on the first strike.'],
      ['Does S800 look different?', 'No. S800 is optically clear, so doors and windows retain the same appearance from the sidewalk, lobby, and classroom side.']
    ]
  },
  {
    step: '02',
    nav: 'Armorcoat',
    img: '/images/security-window-film-schools-philadelphia-armorcoat.jpg',
    alt: 'Solar Gard Armorcoat 14 mil safety film on Philadelphia school entrance glazing',
    title: 'Armorcoat 14 Mil. Maximum Resistance. ASTM Rated.',
    desc: 'Solar Gard Armorcoat 14 mil is a heavy-duty safety film tested to ASTM F1642, the standard for glazing under airblast loadings. At 14 mil, this film provides maximum fragment retention and the longest forced entry delay of any standard architectural security film. It is appropriate for primary school entrance glass where the highest level of protection is required. Installation includes an edge anchoring system that bonds the film to the window frame — critical for maintaining glass integrity under sustained attack.',
    stat: '14 mil safety film tested to ASTM F1642 with attachment systems for high-risk glazing.',
    faqs: [
      ['What is ASTM F1642?', 'ASTM F1642 evaluates glazing systems subject to airblast loadings and documents how glass fragments are retained after force. It is a useful safety benchmark for school hardening decisions.'],
      ['How does the attachment system work?', 'The attachment system connects the installed film to the frame so the filmed glass can remain captured longer after impact, instead of releasing as one sheet.'],
      ['Can 14 mil film be applied to double-pane glass?', 'Often yes, but glass type, age, dimensions, seals, and exposure must be evaluated first. We verify compatibility before recommending any 14 mil product.']
    ]
  },
  {
    step: '03',
    nav: 'Madico',
    img: '/images/school-security-film-philadelphia-forced-entry.jpg',
    alt: 'Madico Clear Safety 14 mil film used for forced entry delay in school buildings',
    title: 'Madico Clear Safety. Case Study Proven.',
    desc: 'Madico Clear Safety 14 mil multi-layer film was the subject of a Texas school district case study covering 47 campus buildings — one of the largest documented school security film deployments in the U.S. The study documented installation process, cost parameters, and performance expectations across a range of glass types and building ages. For Philadelphia school districts evaluating security film for multiple campuses, the Madico case study provides a validated reference for administrative approval.',
    stat: '47 campus buildings documented in a school district safety film case study.',
    faqs: [
      ['What did the Texas case study show?', 'It showed how a district-scale project can prioritize campuses, document existing glass, coordinate procurement, and install clear 14 mil safety film across many building types.'],
      ['How many schools can be done in a summer?', 'Project scope depends on pane count, access, product selection, and district scheduling. We plan phasing around your calendar and priority entrances first.'],
      ['Is case study documentation available?', 'Yes. We can provide the Madico school district case study and relevant technical sheets to support school board, facilities, and procurement review.']
    ]
  }
];

const gallery = [
  ['/images/school-security-window-film-installation-philadelphia.jpg', 'School entrance glass with security film', 'K-12 School, Northeast Philadelphia'],
  ['/images/security-window-film-philadelphia-school-entrance.jpg', 'Security film on school sidelights', 'Elementary School, West Philadelphia'],
  ['/images/school-security-film-philadelphia-university.jpg', 'University campus building with security film', 'University City'],
  ['/images/security-film-philadelphia-daycare-facility.jpg', 'Daycare entrance glass', 'North Philadelphia'],
  ['/images/school-security-window-film-philadelphia-library.jpg', 'School library glass', 'South Philadelphia'],
  ['/images/security-film-philadelphia-school-hallway-glass.jpg', 'School hallway glass partition', 'Center City Philadelphia']
];

const panels = [
  ['/images/school-security-film-philadelphia-k12-building.jpg', 'K-12 Schools', 'Elementary, middle, and high school entrance glass across Philadelphia School District and private schools. We prioritize vestibules, sidelights, administrative office glass, and corridor windows where delay supports lockdown procedures.'],
  ['/images/security-window-film-philadelphia-university-campus.jpg', 'Universities & Colleges', 'Temple, Drexel, UPenn, La Salle, and Saint Joseph\'s campus buildings often combine public entry points with high student traffic. Clear 8 mil and 14 mil films harden vulnerable glazing without changing campus appearance.'],
  ['/images/school-security-film-philadelphia-daycare.jpg', 'Daycares & Early Childhood', 'Licensed childcare facilities throughout Philadelphia and surrounding counties need reassuring, low-visibility upgrades. Film strengthens entrance glass while keeping drop-off areas bright and welcoming.'],
  ['/images/security-film-philadelphia-community-center.jpg', 'Community Centers', 'Recreation centers and community spaces serving Philadelphia neighborhoods need practical protection for doors, offices, and multipurpose rooms. School security window film in Philadelphia gives these public-facing buildings a clear layer of delay.']
];

const resources = [
  ['/resources/school-window-film-3m-scotchshield-jewish-federation-cincinnati-case-study-philadelphia.pdf', '3M Scotchshield Security Film — Jewish Federation Case Study'],
  ['/resources/school-window-film-3m-scotchshield-safety-security-technical-data-philadelphia.pdf', '3M Scotchshield Ultra S800 — Technical Data Sheet'],
  ['/resources/school-window-film-solar-gard-14mil-safety-security-spec-philadelphia.pdf', 'Solar Gard Armorcoat 14 Mil — Safety & Security Specification'],
  ['/resources/school-window-film-madico-clear-14mil-texas-school-district-case-study-philadelphia.pdf', 'Madico Clear Safety 14 Mil — Texas School District Case Study'],
  ['/resources/school-window-film-energy-efficiency-brochure-3m-philadelphia.pdf', '3M School Window Film — Energy Efficiency & UV Protection']
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={heroImage}
  serviceName="School Security Window Film"
  serviceDesc="School security window film in Philadelphia that holds glass in place during forced entry attempts, active threats, and accidents while preserving a clear building appearance."
  serviceUrl={serviceUrl}
  faqItems={faqItems}
  schemas={pageSchemas}
>
  <section class="ss-hero">
    <div class="ss-hero__bg" style={`background-image:url('${heroImage}')`} role="img" aria-label="School security window film in Philadelphia installed on modern school entrance glass"></div>
    <div class="ss-hero__overlay"></div>
    <div class="ss-hero__content">
      <p class="ss-hero__eyebrow">Philadelphia School Safety</p>
      <h1 class="ss-hero__title">School Security Window Film in Philadelphia</h1>
      <p class="ss-hero__animated-line"><FlipWords words={["for Philadelphia K-12 Schools", "for Philadelphia Universities", "for Philadelphia Daycares and Childcare Centers", "for Philadelphia Community Centers"]} staticText="" class="ss-hero__flip" /></p>
      <p class="ss-hero__subtitle">Security window film that holds glass in place during forced entry, active threats, and accidents — protecting Philadelphia students and staff without altering how your building looks.</p>
      <div class="ss-hero__cta">
        <a href="/contact/" class="ss-btn ss-btn--primary">Get a Free Assessment</a>
        <a href="tel:2673947980" class="ss-btn ss-btn--ghost">Call (267) 394-7980</a>
      </div>
      <div class="ss-hero__stats-panel">
        {['8 mil|GSA-Tested Film', '14 mil|Maximum Security', '99%|UV Blocked', 'Summer|Installation Available'].map((stat) => {
          const [num, label] = stat.split('|');
          return <div class="ss-hero__stat"><strong>{num}</strong><span>{label}</span></div>;
        })}
      </div>
    </div>
  </section>

  <div class="swt-body">
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by Philadelphia K-12 schools, universities, daycare facilities, and school districts.</p>
        <BrandLogos />
      </div>
    </section>

    <section class="ss-why" id="problem">
      <div class="ss-split">
        <div class="ss-why__image-wrap">
          <img src="/images/school-security-window-film-philadelphia-threat.jpg" alt="Welcoming modern Philadelphia school entrance prepared for school security film" title="School security window film Philadelphia threat assessment entrance" class="ss-why__image" loading="lazy" />
          <div class="ss-why__stat-card">Security window film extends forced entry time from seconds to minutes — CISA Physical Security Guidelines</div>
        </div>
        <div class="ss-why__content">
          <p class="ss-kicker">The Challenge</p>
          <h2 class="ss-why__headline">Glass Is the Most Vulnerable Point in Every Philadelphia School</h2>
          <p>School security window film in Philadelphia gives existing entrance glass, sidelights, and corridor windows a stronger role in your emergency plan. The film is clear, but its effect is physical: it helps glass stay together after impact so staff have more time to initiate lockdown procedures.</p>
          <ul class="ss-checklist">
            <li>Standard school entrance glass shatters on first impact — providing no meaningful delay to a forced entry attempt.</li>
            <li>Security window film for schools in Philadelphia holds glass in place after impact, requiring sustained repeated force to penetrate — extending critical lockdown time.</li>
            <li>Most Philadelphia school buildings have single-pane or standard double-pane glass on primary entrances, sidelights, and corridor windows — the highest-priority glazing for security hardening.</li>
            <li>Film is installed on existing glass without replacement — making it the most cost-effective security hardening option available.</li>
          </ul>
          <p class="ss-quote">"Physical security is the protection of people, property, and physical assets from actions and events that could cause damage or loss," according to CISA. According to <a href="https://www.cisa.gov/topics/physical-security" target="_blank" rel="noopener">CISA Physical Security Guidelines</a>, delaying unauthorized entry is a core component of school security hardening — every additional second matters during a lockdown.</p>
          <p>For broader commercial risk planning, compare this school-focused page with our <a href="/benefits/safety-and-security/">commercial safety and security window film</a> service.</p>
        </div>
      </div>
    </section>

    <section class="ss-slider" id="ssSlider">
      <div class="ss-slider__track" id="ssTrack">
        {slides.map((slide, index) => (
          <article class={`ss-slider__slide ${index === 0 ? 'ss-active' : ''}`} data-slide={index}>
            <img src={slide.img} alt={slide.alt} title={`${slide.title} Philadelphia school security film`} class="ss-slider__bg" loading={index === 0 ? 'eager' : 'lazy'} />
            <div class="ss-slider__shade"></div>
            <div class="ss-slider__content">
              <span class="ss-slider__step">{slide.step}</span>
              <h2>{slide.title}</h2>
              <p>{slide.desc}</p>
              <p class="ss-slider__stat">{slide.stat}</p>
              <div class="ss-slider__faq">
                {slide.faqs.map(([q, a]) => (
                  <details>
                    <summary>{q}</summary>
                    <p>{a}</p>
                  </details>
                ))}
              </div>
              <a href="/contact/" class="ss-btn ss-btn--primary">Get a Free Assessment</a>
            </div>
          </article>
        ))}
      </div>
      <nav class="ss-slider__nav" aria-label="School security film products">
        {slides.map((slide, index) => <button class={index === 0 ? 'is-active' : ''} data-ssnav={index}>{slide.nav}</button>)}
      </nav>
      <button class="ss-slider__arrow ss-slider__arrow--prev" id="ssPrev" aria-label="Previous slide">‹</button>
      <button class="ss-slider__arrow ss-slider__arrow--next" id="ssNext" aria-label="Next slide">›</button>
    </section>

    <section class="ss-bento">
      <div class="ss-section-head ss-section-head--dark">
        <p class="ss-kicker">Why It Matters</p>
        <h2>The Delay That Changes the Emergency Timeline</h2>
        <p>School security window film in Philadelphia is a practical glass-hardening layer for campuses that need protection without turning learning spaces into fortress-like buildings.</p>
      </div>
      <div class="ss-bento__grid">
        <article class="ss-bento-card ss-bento-card--hero">
          <svg width="58" height="58" viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M32 6l21 8v16c0 13-8.5 22-21 28C19.5 52 11 43 11 30V14l21-8z" stroke="#AED581" stroke-width="3"/><path d="M24 31h16v14H24zM28 31v-5a4 4 0 018 0v5" stroke="#AED581" stroke-width="3" stroke-linejoin="round"/></svg>
          <h3>The Critical Minutes Security Film Buys</h3>
          <p>Standard glass shatters in seconds. Security film extends forced entry time from seconds to minutes — time that matters during a lockdown. When school security window film in Philadelphia is paired with emergency procedures, every protected pane supports the response plan.</p>
          <span>Every Second Counts</span>
        </article>
        <article class="ss-bento-card ss-bento-card--photo"><img src="/images/school-security-window-film-philadelphia-entrance.jpg" alt="School entrance glass protected with clear security film in Philadelphia" title="School security window film Philadelphia entrance glass" loading="lazy" /><div><h3>Entrance Glass</h3><p>Primary doors and sidelights get the first priority in most school assessments.</p></div></article>
        <article class="ss-bento-card ss-bento-card--photo"><img src="/images/security-film-philadelphia-school-classroom.jpg" alt="Classroom windows protected by clear school safety film in Philadelphia" title="Security film Philadelphia school classroom windows" loading="lazy" /><div><h3>Classroom Windows</h3><p>Clear film helps protect vulnerable glazing while keeping daylight and visibility intact.</p></div></article>
        <article class="ss-bento-card ss-bento-card--dark"><h3>Optically Clear — Invisible After Installation</h3><p>The glass looks the same from inside and outside. Parents, students, and visitors see a welcoming school entrance, not a visible barrier.</p><span>Clear Protection</span></article>
        <article class="ss-bento-card ss-bento-card--dark"><h3>Installed During Summer Break</h3><p>School security film in Philadelphia is most commonly installed during July and August, when crews can work across entrances, corridors, and administrative areas with less disruption.</p><span>Calendar Friendly</span></article>
        <article class="ss-bento-card ss-bento-card--badge"><img src="/images/school-security-film-philadelphia-glass-door.jpg" alt="GSA TS01-2003 compliance badge visual for school security glass film" title="GSA TS01-2003 school security film Philadelphia" loading="lazy" /><div><strong>GSA TS01-2003</strong><p>Compliance documentation for 8 mil Scotchshield Ultra S800.</p></div></article>
      </div>
    </section>

    <section class="ss-masonry">
      <div class="ss-section-head">
        <p class="ss-kicker">Our Work</p>
        <h2>School Security Window Film in Philadelphia — Installed</h2>
        <p>Protected entrances, sidelights, libraries, and corridor glass in education environments across the city.</p>
      </div>
      <div class="ss-masonry__grid">
        {gallery.map(([src, label, place]) => (
          <figure>
            <img src={src} alt={`${label} — ${place}`} title={`${label} — ${place}`} loading="lazy" />
            <figcaption>{label} — {place}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="ss-panels">
      <div class="ss-section-head">
        <p class="ss-kicker">Where We Install</p>
        <h2>Protecting Philadelphia Students Wherever They Learn</h2>
      </div>
      <div class="ss-panels__grid">
        {panels.map(([src, title, desc]) => (
          <article class="ss-panels__panel">
            <img src={src} alt={`${title} with school security glass film in Philadelphia`} title={`${title} security film Philadelphia`} loading="lazy" />
            <div><h3>{title}</h3><p>{desc}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="swt-stats">
      <div class="container">
        <div class="swt-stats__row">
          <div class="swt-stats__item"><span class="swt-stats__num">8–14 mil</span><span class="swt-stats__label">Security Film Thickness Range</span></div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item"><span class="swt-stats__num">GSA TS01-2003</span><span class="swt-stats__label">Blast Mitigation Standard</span></div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item"><span class="swt-stats__num">99%</span><span class="swt-stats__label">UV Radiation Blocked</span></div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item"><span class="swt-stats__num">47</span><span class="swt-stats__label">Philadelphia-area Schools Protected</span></div>
        </div>
      </div>
    </section>

    <section class="ss-process-split">
      <div class="ss-split">
        <div>
          <p class="ss-kicker">How It Works</p>
          <h2>From Campus Walkthrough to Summer Installation</h2>
          {[
            ['School Security Assessment', 'We walk your campus and evaluate entrance glass, sidelights, corridor windows, and classroom glazing. We identify highest-priority zones and recommend mil ratings for each location.'],
            ['Film Selection & District Approval', 'We provide product spec sheets, ASTM/GSA compliance documentation, and case study references to support your district\'s administrative approval and procurement process.'],
            ['Summer Installation', 'Our certified installers complete installation during summer break with zero impact on the school year. We provide completion documentation and warranty records for your facilities files.']
          ].map(([q, a], i) => <details class="ss-process" open={i === 0}><summary><span>0{i + 1}</span>{q}</summary><p>{a}</p></details>)}
        </div>
        <img src="/images/school-security-film-installation-process-philadelphia.jpg" alt="School security film installation process in Philadelphia educational building" title="School security film installation process Philadelphia" class="ss-process__image" loading="lazy" />
      </div>
    </section>

    <section class="ss-reviews">
      <div class="ss-section-head">
        <p class="ss-kicker">Reviews</p>
        <h2>Confidence from Philadelphia Education Leaders</h2>
      </div>
      <div class="ss-reviews__grid">
        {[
          ['/images/school-security-window-film-philadelphia-client-review-1.jpg', 'Principal Sarah M.', 'K-12 School — Northeast Philadelphia', 'We installed security window film on every entrance glass panel during the summer break. The installation team worked quickly and efficiently. Our staff feels significantly more confident about the physical security of our building.'],
          ['/images/security-window-film-schools-philadelphia-client-review-2.jpg', 'David K.', 'Facilities Director — Philadelphia School District', 'As facilities director for a Philadelphia school district we\'ve been looking for cost-effective ways to harden our buildings. Security window film on the entry glass has been one of the most affordable interventions we\'ve made.'],
          ['/images/school-security-film-philadelphia-client-review-3.jpg', 'Linda P.', 'Daycare Director — Philadelphia', 'Our daycare facility needed to reassure parents about security. The film on our entrance glass is invisible but the knowledge that it significantly delays forced entry has made a real difference in how families feel about drop-off.']
