<script is:inline>
  (() => {
    const slides = Array.from(document.querySelectorAll('.ss-slider__slide'));
    const nav = Array.from(document.querySelectorAll('[data-ssnav]'));
    let index = 0;
    function show(next) {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('ss-active', i === index));
      nav.forEach((button, i) => button.classList.toggle('is-active', i === index));
    }
    document.getElementById('ssPrev')?.addEventListener('click', () => show(index - 1));
    document.getElementById('ssNext')?.addEventListener('click', () => show(index + 1));
    nav.forEach((button) => button.addEventListener('click', () => show(Number(button.dataset.ssnav))));
  })();
  document.querySelectorAll('.swt-faq__item').forEach(item => {
    item.querySelector('.swt-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('swt-faq__item--open');
      document.querySelectorAll('.swt-faq__item').forEach(i => i.classList.remove('swt-faq__item--open'));
      if (!isOpen) item.classList.add('swt-faq__item--open');
    });
  });
</script>

