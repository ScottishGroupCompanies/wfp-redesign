---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'School Security Window Film Philadelphia | Affordable Protection for K-12 & Universities';
const description = 'School security window film holds glass during active threats, giving students and staff critical time to shelter in place. Quick summer installation. Serving Philadelphia K-12, universities & childcare facilities.';

const galleryImages = [
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181654_97c89d71-1268-4c53-92f5-e397e2e5507f.png', label: 'School Entrance Protection' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163222_79b81cd9-fd33-453a-8c62-ab37d4d031d1.png', label: '99% UV Blocked' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163225_ef3d64e4-534f-42b3-bc9b-af78ddffac20.png', label: 'Security & Safety' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163229_6541b9dc-3f99-46f5-bc6f-5aecd8fd77ae.png', label: 'Classroom Windows' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163859_fabc7e12-368e-49f3-8971-08b76bbdd518.png', label: 'Energy Efficiency' },
];

const newImages = {
  schoolExterior: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181654_97c89d71-1268-4c53-92f5-e397e2e5507f.png',
  glassHolding: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163222_79b81cd9-fd33-453a-8c62-ab37d4d031d1.png',
  summerInstall: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163225_ef3d64e4-534f-42b3-bc9b-af78ddffac20.png',
  invisibleFilm: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163229_6541b9dc-3f99-46f5-bc6f-5aecd8fd77ae.png',
  shelterInPlace: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170335_205f9050-c15e-4135-9684-8380335dac7c.png',
};

const faqItems = [
  { question: 'How does school security film compare to bulletproof glass?', answer: 'Security film is a fraction of the cost of bulletproof or laminated glass replacement — typically 1/5th to 1/10th the price. It holds broken glass in place the same way laminated glass does, preventing dangerous shards from entering the room. The key difference is that extreme force can eventually breach filmed glass, while laminated glass is structurally reinforced. However, the delay and noise created by filmed glass almost always triggers an alarm and deters the attempt before breach occurs.' },
  { question: 'Can film be installed without disrupting the school schedule?', answer: 'Yes. Interior film installation is fast, quiet, and produces no dust or fumes. We can work around class schedules, focus on specific wings or buildings after hours, and time installations to coincide with summer breaks, holidays, or in-service days. Most schools are fully installed within 1–3 weeks depending on building size, with minimal to no impact on daily operations.' },
  { question: 'Does film work on historic school buildings?', answer: 'Historic schools often have original single-pane glass that is particularly vulnerable. Security film can be retrofitted to these windows without altering the historic character of the building — no glass replacement, no frame changes, no visible hardware. This makes it an ideal solution for schools in historic districts or buildings with preservation requirements, where aesthetic changes may be restricted.' },
  { question: "What's the maintenance cost after installation?", answer: 'There is virtually no ongoing maintenance cost. Once installed, security film requires no servicing, no adjustments, and no replacement for 15–20 years on commercial-grade films. Unlike mechanical security systems, there are no sensors, batteries, or components that wear out. The only occasional maintenance is normal glass cleaning — film is washed just like untreated glass.' },
  { question: 'How quickly can windows be secured after a break-in attempt?', answer: 'If an existing window is damaged during a break-in attempt or vandalism, we can often apply security film to that window within 24–48 hours as an emergency response. For ongoing security upgrades, most schools are fully assessed, quoted, and installed within a few weeks. After a documented threat or incident, we work on expedited timelines to secure your facility as quickly as possible.' },
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="School Security Window Film Installation"
  serviceDesc="Shatter-resistant security window film for Philadelphia K-12 schools, universities, and childcare facilities. Holds glass during active threats and gives students critical time to shelter in place."
  serviceUrl="https://www.windowfilmphiladelphia.com/benefits/school-security-window-film"
  faqItems={faqItems}
>
  <!-- HERO -->
  <section class="swt-hero">
    <div class="swt-hero__img">
      <img src={newImages.schoolExterior} alt="Philadelphia school protected with security window film" width="1440" height="700" />
      <div class="swt-hero__overlay"></div>
    </div>
    <div class="swt-hero__content">
      <span class="swt-badge">
        <svg width="8" height="8" viewBox="0 0 8 8" fill="none"><circle cx="4" cy="4" r="4" fill="#4E6B2A"/></svg>
        School Safety Solutions
      </span>
      <h1 class="swt-hero__title">
        Hold Glass.<br/>
        Buy Time.<br/>
        <em>Protect Students.</em>
      </h1>
      <p class="swt-hero__sub">Security window film holds shattered glass in place during active threat situations — giving students and staff the critical minutes they need to shelter in place.</p>
      <div class="swt-hero__ctas">
        <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Security Assessment</a>
        <a href="#benefits" class="swt-btn swt-btn--ghost-light">See Benefits</a>
      </div>
    </div>
  </section>

  <div class="swt-body">

    <!-- TRUST BAR -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by leading Philadelphia schools and universities</p>
        <BrandLogos />
      </div>
    </section>

    <!-- SECTION 1: THE PROBLEM — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="problem">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">The Vulnerability</span>
            <h2 class="swt-h2 swt-h2--light">Standard School Windows Are One of the Most Dangerous Overlooked Risks in K-12 Safety</h2>
            <p>When a window breaks during an active threat — whether from forced entry, severe weather, or accidental impact — glass shards become projectiles. In a school full of children, those shards cause the most serious injuries, not the initial breach itself.</p>
            <p>Philadelphia schools face genuine glass vulnerability. Ground-floor classroom windows, gymnasium glass, main entrance systems, and corridor panels are all common weak points. Most were never designed with security in mind — they were designed to look good and let in light.</p>
            <div class="swt-problem-tags">
              <span class="swt-tag swt-tag--red">Shattered Glass Projectiles</span>
              <span class="swt-tag swt-tag--red">Unprotected Entrances</span>
              <span class="swt-tag swt-tag--red">Ground-Floor Vulnerability</span>
              <span class="swt-tag swt-tag--red">No Entry Delay</span>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.glassHolding} alt="Security window film holding shattered glass in place" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: ACTIVE THREAT — white bg, image left, text right -->
    <section class="swt-split" id="threat">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.schoolExterior} alt="Philadelphia school with security window film on entrance" loading="lazy" />
            <div class="swt-img-badge">
              <strong>3–7</strong>
              <span>Minutes of Delay</span>
            </div>
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 01</span>
            <h2 class="swt-h2">Holds Glass During Active Threat Situations</h2>
            <p>When someone attempts to break through a window during a security incident, security film is the difference between a room full of dangerous glass shards and a room where the glass stays in the frame. The high-tensile polyester membrane holds the broken pane together, preventing glass from becoming a weapon itself.</p>
            <p>This delay also creates noise and resistance that triggers alarms — and every second of delay is a second that law enforcement is closer. In shelter-in-place scenarios, keeping glass contained means students and staff are genuinely protected while they wait for the all-clear.</p>
            <ul class="swt-check-list">
              <li>Prevents dangerous glass shard injuries during impact events</li>
              <li>Creates alarm-triggering resistance during forced entry attempts</li>
              <li>Keeps students safe during shelter-in-place situations</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: AFFORDABLE — alt cream bg, text left, image right -->
    <section class="swt-split swt-split--alt" id="affordable">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 02</span>
            <h2 class="swt-h2">An Affordable Layer of Protection for Any School Budget</h2>
            <p>Replacing existing glass with laminated or bulletproof glazing costs $40–$100+ per square foot and requires full window frame replacement. Security window film costs $8–$18 per square foot — applied directly to existing glass with no frame modification needed.</p>
            <p>For a typical Philadelphia K-8 school with 200 windows, a full security film installation costs less than a single athletic facility renovation. It is one of the highest-impact safety investments a school can make relative to its cost — and it qualifies in most cases for facility improvement budgets without requiring a bond referendum.</p>
            <div class="swt-energy-metrics">
              <div class="swt-metric">
                <span class="swt-metric__num">5–10x</span>
                <span class="swt-metric__label">Lower Cost Than Replacement Glass</span>
              </div>
              <div class="swt-metric">
                <span class="swt-metric__num">15–20yr</span>
                <span class="swt-metric__label">Expected Film Lifespan</span>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.summerInstall} alt="Summer window film installation at Philadelphia school" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: QUICK INSTALL — white bg, image left, text right -->
    <section class="swt-split" id="installation">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.invisibleFilm} alt="Invisible security film on school windows — no aesthetic impact" loading="lazy" />
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 03</span>
            <h2 class="swt-h2">Quick Installation Over Summer Breaks — Zero Disruption to Learning</h2>
            <p>Security film installation is fast, clean, and silent — no power tools, no dust, no fumes. Our crews can work around your school calendar, installing during summer breaks, in-service days, or after school hours to avoid any impact on instruction.</p>
            <p>A complete K-8 school installation typically takes 1–2 weeks. We focus on priority areas first — entrances, ground-floor corridors, gymnasium, and admin areas — so your school has immediate protection while we complete the full installation.</p>
            <blockquote class="swt-inline-quote">
              "They installed film in our gym and all ground-floor corridors over a single summer break. By the time students returned, every window was protected — and no one even noticed the work was being done."
              <cite>— Facilities Director, public elementary school, Northeast Philadelphia</cite>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: INVISIBLE — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="invisible">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow swt-eyebrow--green">Benefit 04</span>
            <h2 class="swt-h2 swt-h2--light">Invisible Until It's Needed — No Prison Aesthetic</h2>
            <p>Security film is virtually invisible. From the outside, no one can tell which windows are filmed and which are not. The school looks like a school — not a detention facility. This matters enormously for school culture, community perception, and student wellbeing.</p>
            <p>Unlike security bars, screens, or impact-resistant glass replacements, film does not impair natural daylight, block views from inside, or create a sense of confinement. Students still learn next to bright, open windows — with protection they will never see unless they need it.</p>
            <div class="swt-security-features">
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Zero Aesthetic Impact</strong>
                  <p>Film is optically clear — indistinguishable from untreated glass</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Preserves Daylight and Views</strong>
                  <p>No reduction in natural light or visual connection to outdoors</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>No Ongoing Maintenance</strong>
                  <p>15–20 year film lifespan with zero servicing requirements</p>
                </div>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.shelterInPlace} alt="Philadelphia school hallway with security film installed" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY — 5 images -->
    <section class="swt-gallery" id="gallery">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">Our Work</span>
          <h2 class="swt-h2 swt-h2--center">School Security Film — In Action</h2>
          <p class="swt-subhead">From K-8 elementary schools to university campuses — here's what we install.</p>
        </div>
        <div class="swt-gallery__grid">
          {galleryImages.map((img, i) => (
            <div class="swt-gallery__item fade-in" style={`--delay: ${i * 80}ms`}>
              <img src={img.src} alt={img.label} loading="lazy" />
              <div class="swt-gallery__overlay">
                <span>{img.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STATS BAR — accent green -->
    <section class="swt-stats">
      <div class="container">
        <div class="swt-stats__row">
          <div class="swt-stats__item fade-in">
            <span class="swt-stats__num">16+</span>
            <span class="swt-stats__label">Years in Philadelphia</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 80ms">
            <span class="swt-stats__num">500+</span>
            <span class="swt-stats__label">Commercial Projects</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 160ms">
            <span class="swt-stats__num">3–7</span>
            <span class="swt-stats__label">Minutes Entry Delay</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 240ms">
            <span class="swt-stats__num">15–20yr</span>
            <span class="swt-stats__label">Film Lifespan</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS — 3 steps -->
    <section class="swt-process">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">How It Works</span>
          <h2 class="swt-h2 swt-h2--center">3 Simple Steps to a Safer School</h2>
        </div>
        <div class="swt-process__steps">
          <div class="swt-process__step fade-in">
            <div class="swt-process__num">01</div>
            <div class="swt-process__body">
              <h3>Free Security Assessment</h3>
              <p>We survey every window in your school, identify priority areas based on building layout and current threat assessments, and provide a detailed proposal within 24 hours. No obligation — just honest, school-specific advice.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 80ms">
            <div class="swt-process__num">02</div>
            <div class="swt-process__body">
              <h3>Professional Summer Installation</h3>
              <p>Our factory-trained installers work around your academic calendar. We install in phases if needed, prioritizing entrances and ground-floor corridors. The process is clean, quiet, and completed without disrupting instruction.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 160ms">
            <div class="swt-process__num">03</div>
            <div class="swt-process__body">
              <h3>Inspection & Long-Term Warranty</h3>
              <p>We walk every space with your facilities team before considering the job done. Every installation is backed by our labor warranty and the manufacturer's 15–20 year material warranty — no ongoing maintenance, no recurring costs.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS — dark bg -->
    <section class="swt-testimonials">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow swt-eyebrow--green">Client Stories</span>
          <h2 class="swt-h2 swt-h2--center swt-h2--light">Real Results from Real Schools</h2>
        </div>
        <div class="swt-testimonials__grid">
          <div class="swt-testimonial fade-in">
            <div class="swt-testimonial__quote">"</div>
            <p>After we had a window smash during a break-in attempt, we knew we had to act. The film installation was fast, affordable, and non-disruptive. We now have every ground-floor window protected and I sleep better at night knowing our kids are safer.</p>
            <div class="swt-testimonial__author">
              <strong>Maria T.</strong>
              <span>Principal, K-5 public school, West Philadelphia</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 80ms">
            <div class="swt-testimonial__quote">"</div>
            <p>We were quoted $180,000 to replace our gymnasium glass with laminated panels. Security film gave us the same shatter-resistance for about $22,000. The installation was done in four days over spring break. It was the obvious choice.</p>
            <div class="swt-testimonial__author">
              <strong>James R.</strong>
              <span>Facilities Director, charter school network, South Philadelphia</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 160ms">
            <div class="swt-testimonial__quote">"</div>
            <p>Our historic building had original single-pane windows in every classroom — beautiful but fragile. We couldn't replace them without changing the building's character. Film was the perfect retrofitted solution that preserved the look and added real protection.</p>
            <div class="swt-testimonial__author">
              <strong>Sandra L.</strong>
              <span>Head of School, private K-8, Society Hill</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="swt-faq" id="faq">
      <div class="container">
        <div class="swt-faq__layout">
          <div class="swt-faq__header fade-in">
            <span class="swt-eyebrow">Questions</span>
            <h2 class="swt-h2">Frequently Asked Questions</h2>
            <p>Honest answers from people who've been doing this in Philadelphia for over 16 years.</p>
            <a href="/contact/" class="swt-btn swt-btn--primary">Talk to a Specialist</a>
          </div>
          <div class="swt-faq__list fade-in">
            {faqItems.map((item) => (
              <div class="swt-faq__item">
                <div class="swt-faq__q">
                  <span>{item.question}</span>
                  <span class="swt-faq__toggle">+</span>
                </div>
                <div class="swt-faq__a">
                  <p>{item.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA BANNER -->
    <section class="swt-cta">
      <div class="swt-cta__inner">
        <div class="swt-cta__text">
          <h2>Ready to <em>protect</em> your students?</h2>
          <p>Get a free security assessment and proposal for your school. No obligation — just honest advice.</p>
        </div>
        <div class="swt-cta__btns">
          <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Quote</a>
          <a href="tel:+126****7980" class="swt-btn swt-btn--ghost-light">Call (267) 394-7980</a>
        </div>
      </div>
    </section>

  </div><!-- /swt-body -->
</BaseLayout>

<style>
  /* ══════════════════════════════════════
     BRAND TOKENS (local override)
     ══════════════════════════════════════ */
  :root {
    --swt-green:        #4E6B2A;
    --swt-green-accent: #83A94A;
    --swt-dark:         #2A241E;
    --swt-cream:        #F4EFE6;
    --swt-alt:          #ECE4D4;
    --swt-border:       #E1D6C1;
    --swt-text-sec:     #6E665C;
    --swt-gold:         #846212;
    --swt-white:        #ffffff;
    --swt-radius:       5px;
  }

  /* ══════════════════════════════════════
     HERO
     ══════════════════════════════════════ */
  .swt-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .swt-hero__img {
    position: absolute;
    inset: 0;
  }
  .swt-hero__img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .swt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(42,36,30,0.9) 0%, rgba(42,36,30,0.6) 50%, rgba(42,36,30,0.35) 100%);
  }
  .swt-hero__content {
    position: relative;
    z-index: 1;
    padding: 110px 8% 90px;
    max-width: 720px;
  }
  .swt-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
    background: rgba(78,107,42,0.25);
    color: rgba(255,255,255,0.75);
    border: 1px solid rgba(78,107,42,0.4);
  }
  .swt-hero__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(38px, 5.5vw, 66px);
    font-weight: 400;
    color: var(--swt-white);
    line-height: 1.1;
    margin: 0 0 20px;
  }
  .swt-hero__title em {
    font-style: italic;
    color: var(--swt-green-accent);
  }
  .swt-hero__sub {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 17px;
    color: rgba(255,255,255,0.65);
    line-height: 1.7;
    margin: 0 0 36px;
    max-width: 500px;
  }
  .swt-hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ══════════════════════════════════════
     BUTTONS
     ══════════════════════════════════════ */
  .swt-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .swt-btn--primary {
    background: var(--swt-green);
    color: var(--swt-white);
