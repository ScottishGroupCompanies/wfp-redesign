---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Decorative & Promotional Window Film in Philadelphia | Custom Graphics on Glass';
const description = 'Transform your Philadelphia glass with custom printed graphics, frosted privacy patterns, brand messaging, and promotional window film. Professional design and installation.';

const galleryImages = [
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181649_c92f558e-5eea-42cf-961f-5d503e133b1b.jpeg', label: 'Custom Brand Graphics' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163222_79b81cd9-fd33-453a-8c62-ab37d4d031d1.png', label: 'Frosted Privacy Film' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163225_ef3d64e4-534f-42b3-bc9b-af78ddffac20.png', label: 'Promotional Displays' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163229_6541b9dc-3f99-46f5-bc6f-5aecd8fd77ae.png', label: 'Wayfinding Films' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163859_fabc7e12-368e-49f3-8971-08b76bbdd518.png', label: 'Seasonal Promotions' },
];

const newImages = {
  decorativeInterior: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181649_c92f558e-5eea-42cf-961f-5d503e133b1b.jpeg',
  brandGraphics: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181649_c92f558e-5eea-42cf-961f-5d503e133b1b.jpeg',
  frostedPrivacy: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181649_c92f558e-5eea-42cf-961f-5d503e133b1b.jpeg',
  wayfinding: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181649_c92f558e-5eea-42cf-961f-5d503e133b1b.jpeg',
};

const faqItems = [
  { question: 'Can we print our brand logo on the film?', answer: 'Yes. We create custom decorative film designs incorporating your company logo, brand colors, and messaging. Custom graphics are produced using high-resolution printing on vinyl-compatible film media, then applied to your glass surfaces. Our in-house design team handles everything from concept to final installation.' },
  { question: 'How long does custom printing take?', answer: 'Custom printed decorative film typically takes 5–10 business days from design approval to final production, depending on complexity. Simple frosted patterns or standard designs can be produced faster. We also offer rush turnaround for time-sensitive promotional campaigns and events.' },
  { question: 'Can decorative film be removed and replaced?', answer: 'Yes. Decorative film is designed to be removable. The process involves heating the film and peeling it off, with adhesive residue cleaned from the glass surface. This makes it ideal for seasonal promotions — swap out holiday graphics for spring promotions without replacing the glass.' },
  { question: 'Does print quality hold up in sunlight?', answer: 'Our custom printed films use UV-resistant inks and protective overlaminates designed for long-term durability in sun-exposed applications. Interior installations typically last 5–10 years with no visible fading. For high-exposure exterior applications, we use specialized UV-stable media to ensure long-term color retention.' },
  { question: 'What is the minimum order for custom prints?', answer: 'There is no strict minimum order — single-panel custom installations are common, especially for residential or small business projects. For larger commercial orders, volume pricing applies and the per-panel cost decreases significantly. We provide a detailed quote for any quantity.' },
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Decorative & Promotional Window Film"
  serviceDesc="Custom printed graphics, frosted privacy patterns, brand messaging, and promotional window film for Philadelphia businesses."
  serviceUrl="https://www.windowfilmphiladelphia.com/benefits/decorative-promotional"
  faqItems={faqItems}
>
  <!-- HERO -->
  <section class="swt-hero">
    <div class="swt-hero__img">
      <img src={newImages.decorativeInterior} alt="Decorative window film with custom brand graphics on Philadelphia glass" width="1440" height="700" />
      <div class="swt-hero__overlay"></div>
    </div>
    <div class="swt-hero__content">
      <span class="swt-badge">
        <svg width="8" height="8" viewBox="0 0 8 8" fill="none"><circle cx="4" cy="4" r="4" fill="#4E6B2A"/></svg>
        Decorative & Promotional Film
      </span>
      <h1 class="swt-hero__title">
        Your Glass.<br/>
        <em>Your Brand,</em><br/>
        Amplified.
      </h1>
      <p class="swt-hero__sub">Custom printed graphics, frosted privacy patterns, brand messaging, and promotional window film — transforming Philadelphia glass into a dynamic brand and communication tool.</p>
      <div class="swt-hero__ctas">
        <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Design Consultation</a>
        <a href="#benefits" class="swt-btn swt-btn--ghost-light">See Benefits</a>
      </div>
    </div>
  </section>

  <div class="swt-body">

    <!-- TRUST BAR -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by leading Philadelphia businesses</p>
        <BrandLogos />
      </div>
    </section>

    <!-- SECTION 1: THE OPPORTUNITY — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="opportunity">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">The Opportunity</span>
            <h2 class="swt-h2 swt-h2--light">Your Glass Is Prime Real Estate — and It's Going to Waste</h2>
            <p>Every window, glass partition, and storefront panel in your building is a silent billboard visible to customers, visitors, and passersby. Most Philadelphia businesses leave that space completely blank — or settle for generic frosted film that does nothing for their brand.</p>
            <p>Decorative and promotional window film changes that. It turns glass into a canvas for custom brand graphics, elegant frosted privacy screens, wayfinding systems, and seasonal promotions — at a fraction of the cost of replacing glass or traditional signage.</p>
            <div class="swt-problem-tags">
              <span class="swt-tag swt-tag--red">Unused Glass Surface</span>
              <span class="swt-tag swt-tag--red">Generic Appearance</span>
              <span class="swt-tag swt-tag--red">No Brand Expression</span>
              <span class="swt-tag swt-tag--red">Missed Marketing Space</span>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.brandGraphics} alt="Custom brand graphics printed on decorative window film" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: CUSTOM GRAPHICS — white bg, image left, text right -->
    <section class="swt-split" id="graphics">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.decorativeInterior} alt="Philadelphia restaurant with custom printed window graphics" loading="lazy" />
            <div class="swt-img-badge">
              <strong>100%</strong>
              <span>Customizable</span>
            </div>
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 01</span>
            <h2 class="swt-h2">Custom Printed Graphics on Glass — Your Brand, in Full Color</h2>
            <p>From logos and brand campaigns to full photographic imagery, our wide-format printers produce stunning custom graphics on vinyl-compatible film media. The result looks like the design was printed directly on the glass — because in a sense, it was.</p>
            <p>Custom printed decorative film is ideal for storefronts, office glass partitions, conference rooms, lobby walls, and any glass surface where brand expression matters. The film adheres seamlessly and removes cleanly when it's time for a refresh.</p>
            <ul class="swt-check-list">
              <li>Full-color custom graphics with photographic quality</li>
              <li>Logo, branding, and promotional content on any glass</li>
              <li>Easy removal and replacement for updates and campaigns</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: FROSTED PRIVACY — alt cream bg, text left, image right -->
    <section class="swt-split swt-split--alt" id="frosted">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 02</span>
            <h2 class="swt-h2">Frosted Privacy Patterns — Elegant Glass Transformation</h2>
            <p>Frosted decorative film replicates the appearance of sandblasted or etched glass at a fraction of the cost — and with full design flexibility. Choose from hundreds of existing patterns, or work with our design team to create something completely custom for your brand.</p>
            <p>Frosted film is one of the most versatile applications: conference rooms, bathroom windows, lobby entries, glass partitions, and executive offices all benefit from the elegant, diffused privacy it provides. Natural light passes through while the view is elegantly obscured.</p>
            <div class="swt-energy-metrics">
              <div class="swt-metric">
                <span class="swt-metric__num">200+</span>
                <span class="swt-metric__label">Pattern Options</span>
              </div>
              <div class="swt-metric">
                <span class="swt-metric__num">5–10yr</span>
                <span class="swt-metric__label">Interior Lifespan</span>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.frostedPrivacy} alt="Elegant frosted privacy window film on Philadelphia office glass" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: BRAND MESSAGING — white bg, image left, text right -->
    <section class="swt-split" id="branding">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.decorativeInterior} alt="Philadelphia retail store with brand messaging on glass" loading="lazy" />
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 03</span>
            <h2 class="swt-h2">Brand Messaging on Glass — Tell Your Story Before They Walk In</h2>
            <p>Your storefront and lobby glass is the first thing potential customers see. Decorative film lets you control that first impression with brand-forward messaging, values statements, and visual identity elements that communicate who you are before a single word is spoken.</p>
            <p>From "Welcome" panels with your logo to full-wall exterior wraps, brand messaging film turns glass into a silent salesperson that works 24/7 — visible to every person who passes by your building.</p>
            <blockquote class="swt-inline-quote">
              "Our lobby glass now communicates our brand values before clients even sit down. It's the best first impression upgrade we've made."
              <cite>— Office Manager, consulting firm, Center City Philadelphia</cite>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: WAYFINDING — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="wayfinding">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow swt-eyebrow--green">Benefit 04</span>
            <h2 class="swt-h2 swt-h2--light">Wayfinding & Directory Films — Glass That Guides</h2>
            <p>Large buildings, medical offices, hotels, and corporate campuses need clear wayfinding — but traditional signage on glass is obtrusive and expensive. Decorative wayfinding film solves this by integrating directional information, room numbers, and directory content directly into your glass surfaces.</p>
            <p>The result is clean, professional, and brand-consistent. Visitors receive clear guidance without the visual clutter of hanging signs. It's particularly effective in buildings with modern glass architecture where traditional signage feels out of place.</p>
            <div class="swt-security-features">
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Seamless Integration</strong>
                  <p>Wayfinding blends with glass — no bulky signs or surface-mounted hardware</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Brand Consistent</strong>
                  <p>Matches your visual identity — fonts, colors, and design language all aligned</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Easy Updates</strong>
                  <p>Replacement films update directories without replacing glass or removing fixtures</p>
                </div>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.wayfinding} alt="Philadelphia office building wayfinding window film on glass directories" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY — 5 images -->
    <section class="swt-gallery" id="gallery">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">Our Work</span>
          <h2 class="swt-h2 swt-h2--center">Decorative Film — In Action</h2>
          <p class="swt-subhead">From frosted office partitions to full-color storefront graphics — here's what we create.</p>
        </div>
        <div class="swt-gallery__grid">
          {galleryImages.map((img, i) => (
            <div class="swt-gallery__item fade-in" style={`--delay: ${i * 80}ms`}>
              <img src={img.src} alt={img.label} loading="lazy" />
              <div class="swt-gallery__overlay">
                <span>{img.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STATS BAR — accent green -->
    <section class="swt-stats">
      <div class="container">
        <div class="swt-stats__row">
          <div class="swt-stats__item fade-in">
            <span class="swt-stats__num">100%</span>
            <span class="swt-stats__label">Customizable Designs</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 80ms">
            <span class="swt-stats__num">200+</span>
            <span class="swt-stats__label">Pattern Options</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 160ms">
            <span class="swt-stats__num">5–10yr</span>
            <span class="swt-stats__label">Interior Lifespan</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 240ms">
            <span class="swt-stats__num">24h</span>
            <span class="swt-stats__label">Rush Turnaround Available</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS — 3 steps -->
    <section class="swt-process">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">How It Works</span>
          <h2 class="swt-h2 swt-h2--center">3 Simple Steps to Custom Decorative Film</h2>
        </div>
        <div class="swt-process__steps">
          <div class="swt-process__step fade-in">
            <div class="swt-process__num">01</div>
            <div class="swt-process__body">
              <h3>Free Design Consultation</h3>
              <p>We meet at your location to understand your goals, brand, and glass surfaces. Our design team then creates mockups showing exactly how the finished film will look — no obligation, just a clear vision of what's possible.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 80ms">
            <div class="swt-process__num">02</div>
            <div class="swt-process__body">
              <h3>Custom Production & Professional Installation</h3>
              <p>Once you approve the design, we produce the film in our facility and schedule professional installation. Our installers ensure a seamless, bubble-free application on every panel — typically completed within 1–2 days.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 160ms">
            <div class="swt-process__num">03</div>
            <div class="swt-process__body">
              <h3>Inspection & Long-Term Warranty</h3>
              <p>We walk the space with you before considering the job done. Every installation is backed by our labor warranty and the manufacturer's material warranty covering adhesion, fading, and delamination.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS — dark bg -->
    <section class="swt-testimonials">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow swt-eyebrow--green">Client Stories</span>
          <h2 class="swt-h2 swt-h2--center swt-h2--light">Real Results from Real Businesses</h2>
        </div>
        <div class="swt-testimonials__grid">
          <div class="swt-testimonial fade-in">
            <div class="swt-testimonial__quote">"</div>
            <p>We had our logo and brand story printed on the lobby glass — it looks like custom glass fabrication. Clients comment on it constantly. The installation was fast and the quality exceeded what we expected at this price point.</p>
            <div class="swt-testimonial__author">
              <strong>Rachel T.</strong>
              <span>Marketing Director, boutique hotel, Old City Philadelphia</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 80ms">
            <div class="swt-testimonial__quote">"</div>
            <p>Our conference rooms were always too exposed — you could see straight through from the hallway. Frosted film completely solved the privacy issue while keeping the modern glass aesthetic. Staff and clients both notice the upgrade.</p>
            <div class="swt-testimonial__author">
              <strong>James K.</strong>
              <span>Operations Manager, financial services, Rittenhouse area</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 160ms">
            <div class="swt-testimonial__quote">"</div>
            <p>We switch out our storefront graphics for every seasonal promotion — Halloween, Thanksgiving, holiday, Valentine's Day. The film swaps out cleanly and the cost is a fraction of what custom signage would have been. Game changer for our marketing calendar.</p>
            <div class="swt-testimonial__author">
              <strong>Maria S.</strong>
              <span>Owner, retail boutique, South Street, Philadelphia</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="swt-faq" id="faq">
      <div class="container">
        <div class="swt-faq__layout">
          <div class="swt-faq__header fade-in">
            <span class="swt-eyebrow">Questions</span>
            <h2 class="swt-h2">Frequently Asked Questions</h2>
            <p>Honest answers from people who've been doing this in Philadelphia for over 16 years.</p>
            <a href="/contact/" class="swt-btn swt-btn--primary">Talk to a Specialist</a>
          </div>
          <div class="swt-faq__list fade-in">
            {faqItems.map((item) => (
              <div class="swt-faq__item">
                <div class="swt-faq__q">
                  <span>{item.question}</span>
                  <span class="swt-faq__toggle">+</span>
                </div>
                <div class="swt-faq__a">
                  <p>{item.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA BANNER -->
    <section class="swt-cta">
      <div class="swt-cta__inner">
        <div class="swt-cta__text">
          <h2>Ready to <em>transform</em> your glass?</h2>
          <p>Get a free design consultation and mockup for your project. No obligation, no pressure — just a clear vision of what's possible.</p>
        </div>
        <div class="swt-cta__btns">
          <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Quote</a>
          <a href="tel:+126****7980" class="swt-btn swt-btn--ghost-light">Call (267) 394-7980</a>
        </div>
      </div>
    </section>

  </div><!-- /swt-body -->
</BaseLayout>

<style>
  /* ══════════════════════════════════════
     BRAND TOKENS (local override)
     ══════════════════════════════════════ */
  :root {
    --swt-green:        #4E6B2A;
    --swt-green-accent: #83A94A;
    --swt-dark:         #2A241E;
    --swt-cream:        #F4EFE6;
    --swt-alt:          #ECE4D4;
    --swt-border:       #E1D6C1;
    --swt-text-sec:     #6E665C;
    --swt-gold:         #846212;
    --swt-white:        #ffffff;
    --swt-radius:       5px;
  }

  /* ══════════════════════════════════════
     HERO
     ══════════════════════════════════════ */
  .swt-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .swt-hero__img {
    position: absolute;
    inset: 0;
  }
  .swt-hero__img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .swt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(42,36,30,0.9) 0%, rgba(42,36,30,0.6) 50%, rgba(42,36,30,0.35) 100%);
  }
  .swt-hero__content {
    position: relative;
    z-index: 1;
    padding: 110px 8% 90px;
    max-width: 720px;
  }
  .swt-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
    background: rgba(78,107,42,0.25);
    color: rgba(255,255,255,0.75);
    border: 1px solid rgba(78,107,42,0.4);
  }
  .swt-hero__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(38px, 5.5vw, 66px);
    font-weight: 400;
    color: var(--swt-white);
    line-height: 1.1;
    margin: 0 0 20px;
  }
  .swt-hero__title em {
    font-style: italic;
    color: var(--swt-green-accent);
  }
  .swt-hero__sub {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 17px;
    color: rgba(255,255,255,0.65);
    line-height: 1.7;
    margin: 0 0 36px;
    max-width: 500px;
  }
  .swt-hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

