---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import CategoryBlogFeed from '../../components/CategoryBlogFeed.astro';

const title = 'Decorative Window Film in Philadelphia | Frosted Graphics';
const description = 'Decorative window film in Philadelphia for offices, retail, and healthcare. Frosted privacy, custom branding, and printed glass graphics.';

const faqItems = [
  { question: 'What is decorative window film and how is it different from tinted film?', answer: 'Decorative window film is applied to glass for aesthetic, privacy, or branding purposes rather than purely for solar performance. Options include frosted and sandblasted-style patterns for privacy, custom printed graphics for branding, color-gradient films, and architectural geometric patterns. Unlike solar tint, decorative film is chosen primarily for how it looks — privacy and light diffusion are secondary effects.' },
  { question: 'Can decorative film provide privacy without blocking light?', answer: 'Yes. Frosted and translucent decorative films diffuse light rather than blocking it — they obscure direct sightlines while still allowing natural light to pass through. Conference rooms and healthcare examination rooms benefit most: occupants inside have visual privacy, but the space remains bright and naturally lit. Gradient films are particularly useful where you want privacy at seated eye level but openness above.' },
  { question: 'Can I get my company logo or custom graphics printed on window film?', answer: 'Yes. We print full-color custom graphics, logos, patterns, and artwork directly onto window film. Custom printed film can be applied to storefront glass, interior partitions, lobby glass walls, and conference rooms. The printing is UV-stable and designed for long-term display. For seasonal or promotional campaigns, film can be replaced when the promotion ends without damaging the glass.' },
  { question: 'Is decorative film removable? Will it damage the glass when removed?', answer: 'Decorative window film is designed for clean removal without damaging the underlying glass when installed and removed correctly. This makes it ideal for leased commercial spaces in Philadelphia where tenants cannot make permanent alterations, and for seasonal or promotional campaigns where the design needs to change. Always use a professional installer for removal to avoid adhesive residue.' },
  { question: 'Does decorative film also block UV rays?', answer: 'Yes. Most decorative films, including frosted, patterned, and printed options, block up to 99% of UV radiation. This protects interior furnishings, flooring, retail merchandise, and artwork from UV-induced fading. For retail storefronts on Walnut Street and Chestnut Street where merchandise is displayed in sunlit windows, UV-blocking decorative film provides protection alongside branding.' },
  { question: 'What is the difference between frosted film and etched glass?', answer: 'Etched glass permanently alters the glass surface through acid or abrasive treatment — it cannot be reversed and is significantly more expensive. Frosted decorative window film achieves a visually identical sandblasted or etched appearance at a fraction of the cost and can be removed or updated at any time. For Philadelphia commercial spaces with leased glass, film is almost always the better choice.' },
  { question: 'Can decorative film be used on patterned or textured glass?', answer: 'Decorative film is generally applied to smooth flat glass surfaces. Highly textured, wired, or patterned glass may not accept film adhesion correctly depending on the texture depth. Our technicians evaluate the glass surface before installation to confirm compatibility. Most standard commercial glass in Philadelphia office buildings and retail spaces is suitable.' },
  { question: 'How long does decorative window film last?', answer: 'Interior decorative films typically carry warranties of 5–10 years. Films installed in exterior-facing positions or exposed to direct sun may experience more wear over time. Custom printed films follow similar warranty terms depending on the ink system used. Proper installation by a certified technician is required for warranty coverage.' },
  { question: 'Which Philadelphia settings use decorative window film most?', answer: 'The highest-use applications in Philadelphia include conference room and office partition glass throughout Center City and University City, healthcare and medical office privacy glazing in Jefferson Health and Penn Medicine facilities, retail storefront branding on Walnut Street, Chestnut Street, and Rittenhouse Square, restaurant and hospitality privacy in Old City and Fishtown, and residential glass in high-rise condos in Northern Liberties and Society Hill.' },
  { question: 'How do I get decorative window film installed in Philadelphia?', answer: 'Contact us for a free consultation. We will discuss your privacy, branding, or design goals, evaluate your glass surfaces, and recommend the right decorative film option. For custom printed film, we work with your design team or create artwork from scratch. Most commercial installations are completed in a single visit with minimal disruption to your business.' }
];

const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Benefits", "item": "https://windowfilmphiladelphia.net/benefits/" },
      { "@type": "ListItem", "position": 3, "name": "Decorative Window Film", "item": "https://windowfilmphiladelphia.net/benefits/decorative-promotional/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://windowfilmphiladelphia.net/benefits/decorative-promotional/",
    "name": title,
    "description": description,
    "dateModified": new Date().toISOString().slice(0, 10),
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".dc-hero__title", ".dc-hero__subtitle", ".faq__a-inner"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Decorative Window Film Applications",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Office Glass Partitions" },
      { "@type": "ListItem", "position": 2, "name": "Retail Storefronts" },
      { "@type": "ListItem", "position": 3, "name": "Conference Rooms" },
      { "@type": "ListItem", "position": 4, "name": "Healthcare Facilities" },
      { "@type": "ListItem", "position": 5, "name": "Restaurant & Hospitality" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Decorative Window Film Philadelphia",
    "description": "Custom frosted, printed, and branded decorative window film for Philadelphia offices, retail storefronts, conference rooms, and healthcare facilities.",
    "brand": { "@type": "Brand", "name": "Window Film Philadelphia" },
    "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "areaServed": "Philadelphia, PA" },
  }
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Decorative Window Film"
  serviceDesc="Frosted privacy, custom printed graphics, and branded decorative glass film for Philadelphia offices, retail, healthcare, and hospitality spaces."
  serviceUrl="https://windowfilmphiladelphia.net/benefits/decorative-promotional/"
  faqItems={faqItems}
  schemas={pageSchemas}
>

  <!-- ══ HERO — Hero Subpage (library component) ══ -->
  <section class="hs">
    <img src="/images/decorative-window-film-philadelphia-hero.jpg"
         alt="Decorative window film installed on Philadelphia office glass partition — elegant frosted stripe pattern"
         title="Decorative window film Philadelphia — office glass partition"
         class="hs__bg" loading="eager" />
    <div class="hs__overlay" aria-hidden="true"></div>
    <div class="hs__inner">
      <p class="hs__eyebrow">
        <span class="hs__dot" aria-hidden="true"></span>
        Philadelphia Glass Design
      </p>
      <h1 class="hs__title dc-hero__title">Decorative Window Film in Philadelphia</h1>
      <p class="hs__sub dc-hero__subtitle">Transform your glass into a design element. Frosted privacy, custom printed graphics, and branded films — installed on Philadelphia offices, retail storefronts, and healthcare facilities.</p>
      <div class="hs__cta">
        <a href="/contact/" class="hs__btn-primary">Get a Free Assessment</a>
        <a href="/benefits/" class="hs__btn-secondary">All Benefits</a>
      </div>
    </div>
  </section>

  <!-- ══ TRUST BAR ══ -->
  <section class="swt-trust">
    <div class="container">
      <p class="swt-trust__label">Trusted by Philadelphia offices, retail boutiques, healthcare facilities, and restaurants.</p>
      <BrandLogos />
    </div>
  </section>

  <!-- ══ THE CHALLENGE — Accordion Vertical ══ -->
  <section class="dc-accv-wrap">
    <div class="dc-accv-wrap__header">
      <div class="dc-accv-wrap__eyebrow">THE CHALLENGE</div>
      <h2 class="dc-accv-wrap__title split-reveal" data-stagger="65" aria-label="Your Glass Can Work Harder">
        <span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:0">Your&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:1">Glass&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:2">Can&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:3">Work&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:4">Harder</span></span>
      </h2>
      <p class="dc-accv-wrap__sub">Decorative film for Philadelphia spaces turns plain glass into privacy, branding, or design — without construction, without etching, and without permanent alterations.</p>
    </div>
    <div class="accv">
      <div class="accv__panel is-open" data-panel style="background-image:url('/images/decorative-window-film-philadelphia-frosted-privacy.jpg')">
        <button class="accv__tab" data-tab aria-expanded="true">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 8h10M7 12h10M7 16h10"/></svg>
          </span>
          <span class="accv__title">Privacy</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Privacy Without Losing Natural Light</h3>
            <p>Open-plan Philadelphia offices face a tension between transparency and privacy — glass walls look modern but leave conference rooms, HR offices, and executive suites exposed. Frosted decorative window film installed by Window Film Philadelphia provides full visual privacy while diffusing rather than blocking natural light. 3M Fasara alone offers over 50 decorative glass patterns across multiple design collections, giving architects and facility teams a wide range of privacy and design options. According to the <a href="https://www.ada.gov/law-and-regs/design-standards/2010-stds/" target="_blank" rel="noopener">Americans with Disabilities Act (ADA)</a>, accessible design in commercial facilities requires consideration of visual privacy in sensitive spaces such as healthcare examination rooms and consultation areas — frosted film is one of the most compliant and cost-effective solutions available.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/branded-decorative-film-philadelphia-retail.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h10M4 18h16"/><path d="M16 10l4 2-4 2z"/></svg>
          </span>
          <span class="accv__title">Branding</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Branded Glass That Reinforces Your Identity</h3>
            <p>Philadelphia retailers, restaurants, and professional offices use glass as a branding canvas. Custom printed window film delivers full-color logos, patterns, and promotional graphics directly onto glass surfaces — at a fraction of the cost of architectural modifications. Printed film by 3M Fasara and Solyx SXLT series achieve optical clarity at 95% visible light transmission while delivering print resolutions suitable for large-format logo work and detailed graphic patterns.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/decorative-window-film-philadelphia-privacy-glass.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M4 14l6-6 4 4 2-2 4 4"/></svg>
          </span>
          <span class="accv__title">Design</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Architectural Glass Design Without Etching</h3>
            <p>Sandblasted and acid-etched glass is expensive, permanent, and not viable in leased commercial spaces. Decorative window film achieves a visually identical result — geometric patterns, gradient frosts, and custom designs — at a fraction of the cost, with the ability to remove or update as your space evolves.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ FILM OPTIONS — Bento Photo Grid ══ -->
  <section class="bgp dc-film-bento">
    <div class="bgp__head">
      <div class="bgp__eyebrow">THE FILM OPTIONS</div>
      <h2 class="bgp__title">Which decorative film fits your application?</h2>
      <p class="bgp__sub">Frosted privacy, printed graphics, gradient designs, and architectural patterns — decorative window film is not one product, it is a family of glass design solutions.</p>
    </div>
    <div class="bgp__grid">
      <div class="bgp__card bgp__card--lg">
        <img src="/images/decorative-window-film-philadelphia-privacy-glass.jpg" alt="Decorative frosted privacy window film on Philadelphia office conference room glass" title="Decorative frosted window film — Philadelphia conference room" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Frosted &amp; Privacy Films</h3>
          <p>Sandblasted-style frosted patterns that block direct sightlines while preserving natural light. Available in full-frost, gradient, horizontal stripe, and custom geometric designs. Ideal for conference rooms, HR offices, and healthcare examination rooms.</p>
        </div>
      </div>
      <div class="bgp__card bgp__card--sm">
        <img src="/images/frosted-window-film-philadelphia-conference-room.jpg" alt="Frosted decorative window film on Philadelphia conference room glass partition" title="Frosted decorative film — Philadelphia office partition" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Gradient &amp; Ombre Films</h3>
          <p>Opacity transitions from opaque at seated height to clear above — providing privacy where it matters without fully obscuring the space. Popular for open-plan offices and co-working environments.</p>
        </div>
      </div>
      <div class="bgp__card bgp__card--sm">
        <img src="/images/decorative-film-philadelphia-retail-branding.jpg" alt="Custom branded decorative window film on Philadelphia retail storefront glass" title="Branded decorative window film — Philadelphia retail" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Custom Printed Graphics</h3>
          <p>Full-color logos, patterns, promotional graphics, and artwork printed directly on film. UV-stable inks, clean removal, and seasonal update capability. Ideal for Philadelphia retail storefronts and restaurant frontages.</p>
        </div>
      </div>
      <div class="bgp__card bgp__card--md">
        <img src="/images/custom-printed-window-film-philadelphia-office.jpg" alt="Custom printed architectural window film on Philadelphia office lobby glass" title="Custom architectural window film — Philadelphia office lobby" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Architectural Patterns</h3>
          <p>Geometric patterns, etched-glass replication, and abstract designs that integrate with interior design schemes. 3M Fasara and Solyx SXLT series offer over 100 pre-designed patterns plus custom options.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ HOW DECORATIVE FILM WORKS — Accordion Benefits ══ -->
  <section class="accb">
    <div class="accb__head">
      <h2 class="accb__title">What Each Decorative Film Type Actually Does</h2>
      <p class="accb__sub">Privacy, branding, design, and UV protection — each decorative film type solves a different challenge for Philadelphia commercial and residential glass.</p>
    </div>
    <div class="accb__wrap">
      <div class="accb__list">
        <div class="accb__row is-open" data-row data-index="0">
          <button class="accb__trigger" data-trigger aria-expanded="true">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 8h10M7 12h10M7 16h10"/></svg></span>
            <span class="accb__row-title">Frosted &amp; Privacy Film — Visual Privacy Without Blinds</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Philadelphia offices lose the benefit of glass walls when employees feel observed in sensitive conversations. Frosted decorative window film resolves this without blinds, curtains, or construction — it diffuses direct sightlines while maintaining natural light flow. 3M Fasara SH2MCOS frost film achieves 95% visible light transmission while providing full visual privacy from normal viewing distances. The film is applied to interior glass surfaces and can cover the full panel, a gradient from floor level, or custom-cut geometric sections. This works especially well in <a href="/applications/office/">Philadelphia office buildings</a> and <a href="/applications/healthcare/">healthcare facilities</a>.</p>
              <img class="accb__mobile-img" src="/images/decorative-window-film-philadelphia-frosted-privacy.jpg" alt="Frosted privacy decorative window film on Philadelphia office glass partition" title="Frosted privacy window film — Philadelphia office" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="1">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h10M4 18h16"/><path d="M16 10l4 2-4 2z"/></svg></span>
            <span class="accb__row-title">Branded &amp; Printed Film — Custom Graphics on Glass</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Custom printed window film turns Philadelphia storefront glass and interior partitions into brand-reinforcing displays. Full-color printing on UV-stable film adheres directly to glass and produces print quality suitable for logos, lifestyle imagery, and detailed graphic patterns. For <a href="/applications/retail/">Philadelphia retail storefronts</a> and restaurant frontages, printed film can be changed seasonally or for promotional campaigns without damaging the glass. The Solyx SXLT-1305 series achieves 95% VLT with full-color print stability rated for 7+ years on interior glass. Frosted window film in Philadelphia is a complementary option when privacy rather than branding is the primary goal.</p>
              <img class="accb__mobile-img" src="/images/branded-decorative-film-philadelphia-retail.jpg" alt="Branded printed decorative window film on Philadelphia retail storefront" title="Branded window film — Philadelphia retail" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="2">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M4 15h16M4 11h16"/></svg></span>
            <span class="accb__row-title">Gradient &amp; Ombre Film — Precision Privacy at Eye Level</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Gradient films transition from opaque frosting at seated height to clear glass above — providing seated privacy while maintaining sightlines from standing height and preserving the open feel of a glass-walled space. This is the preferred solution for co-working spaces, trading floors, and executive suites throughout Center City, Rittenhouse Square, and University City Philadelphia. The International Window Film Association notes that architectural film can be selected to change appearance and function while retaining the glass already in place, making gradients a practical retrofit for occupied interiors.</p>
              <img class="accb__mobile-img" src="/images/frosted-glass-film-philadelphia-office-partition.jpg" alt="Gradient frosted decorative window film on Philadelphia office glass wall" title="Gradient frosted film — Philadelphia office wall" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="3">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
            <span class="accb__row-title">UV-Blocking Decorative Film — Protection Built In</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>All decorative window films — frosted, printed, and patterned — block up to 99% of UV radiation as a baseline property of the polyester film substrate. For Philadelphia retail storefronts where merchandise is displayed in sun-facing windows, this means fading protection is included alongside whatever design treatment is chosen. For residential applications in Fishtown, Society Hill, and Northern Liberties condos with large glass facades, decorative film delivers both design character and furniture/floor protection in a single application.</p>
              <img class="accb__mobile-img" src="/images/printed-window-film-philadelphia-custom-graphics.jpg" alt="Custom printed UV-blocking decorative window film on Philadelphia commercial glass" title="UV-blocking decorative film — Philadelphia commercial" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
      <div class="accb__media">
        <img class="accb__img is-active" data-img data-index="0" src="/images/decorative-window-film-philadelphia-frosted-privacy.jpg" alt="Frosted privacy decorative window film on Philadelphia office glass partition" title="Frosted privacy window film — Philadelphia office" loading="lazy" />
        <img class="accb__img" data-img data-index="1" src="/images/branded-decorative-film-philadelphia-retail.jpg" alt="Branded printed decorative window film on Philadelphia retail storefront" title="Branded window film — Philadelphia retail" loading="lazy" />
        <img class="accb__img" data-img data-index="2" src="/images/frosted-glass-film-philadelphia-office-partition.jpg" alt="Gradient frosted decorative window film on Philadelphia office glass wall" title="Gradient frosted film — Philadelphia office wall" loading="lazy" />
        <img class="accb__img" data-img data-index="3" src="/images/printed-window-film-philadelphia-custom-graphics.jpg" alt="Custom printed UV-blocking decorative window film on Philadelphia commercial glass" title="UV-blocking decorative film — Philadelphia commercial" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ══ BEFORE/AFTER SLIDER — Decorative Film in Action ══ -->
  <section class="dc-slider-wrap">
    <div class="dc-slider-wrap__header">
      <div class="dc-slider-wrap__eyebrow">THE FILM IN ACTION</div>
      <h2 class="dc-slider-wrap__title">Decorative Window Film in Action</h2>
      <p class="dc-slider-wrap__sub">Drag the handle to see plain clear glass transformed with frosted decorative window film on a Philadelphia conference room partition.</p>
    </div>
    <div class="dc-slider-wrap__slider">
      <div class="before-after" style="--pos:50%">
        <div class="before-after__frame">
          <img src="/images/philadelphia-office-glass-clear-before-decorative-film.jpg" alt="Plain clear Philadelphia office glass partition before decorative window film — full visibility" title="Philadelphia office glass before decorative film installation" class="before-after__img before-after__img--before" draggable="false" loading="lazy" />
          <div class="before-after__after-wrap">
            <img src="/images/decorative-window-film-philadelphia-after-installation.jpg" alt="Same Philadelphia office glass partition after decorative frosted window film — professional privacy" title="Decorative window film Philadelphia — frosted partition after installation" class="before-after__img before-after__img--after" draggable="false" loading="lazy" />
          </div>
          <span class="before-after__tag before-after__tag--before">Plain clear glass</span>
          <span class="before-after__tag before-after__tag--after">Decorative film applied</span>
          <div class="before-after__handle" role="slider" tabindex="0" aria-label="Drag to compare clear and decorative Philadelphia glass" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
            <span class="before-after__handle-grip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M8 7L3 12L8 17M16 7L21 12L16 17" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ WHERE IT'S USED — What We Do Panels ══ -->
  <section class="dc-wwd-wrap">
    <div class="dc-wwd-wrap__header">
      <div class="dc-wwd-wrap__eyebrow">WHERE IT'S USED</div>
      <h2 class="dc-wwd-wrap__title">Who We Install Decorative Film For</h2>
      <p class="dc-wwd-wrap__sub">Decorative window film works wherever glass needs privacy, branding, or design — across Philadelphia's offices, retail spaces, healthcare facilities, and hospitality venues.</p>
    </div>
    <div class="dc-wwd-panels">
      <a href="/applications/office/" class="wwd__panel">
        <div class="wwd__panel-img-wrap">
          <img src="/images/decorative-film-philadelphia-office-lobby-glass.jpg" alt="Decorative window film on Philadelphia office lobby glass wall" title="Decorative window film for Philadelphia office lobbies" class="wwd__panel-img" loading="lazy" />
        </div>
        <div class="wwd__panel-overlay"></div>
        <div class="wwd__panel-content">
          <h3>Offices &amp; Lobbies</h3>
          <p class="wwd__panel-desc">Center City and University City office lobbies, reception areas, and conference room partitions. Frosted privacy film, branded graphics, and architectural patterns that align with corporate identity.</p>
          <span class="wwd__panel-arrow">Learn more →</span>
          <span class="wwd__panel-line"></span>
        </div>
      </a>
      <a href="/applications/retail/" class="wwd__panel">
        <div class="wwd__panel-img-wrap">
          <img src="/images/decorative-window-film-philadelphia-retail-storefront.jpg" alt="Promotional decorative window film on Philadelphia retail storefront glass" title="Decorative promotional film for Philadelphia retail" class="wwd__panel-img" loading="lazy" />
        </div>
        <div class="wwd__panel-overlay"></div>
        <div class="wwd__panel-content">
          <h3>Retail &amp; Storefronts</h3>
