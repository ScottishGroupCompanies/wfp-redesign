  /* ── Fade In ── */
  .fade-in {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .swt-split__grid { gap: 48px; }
    .swt-gallery__grid { grid-template-columns: repeat(3, 1fr); }
    .swt-testimonials__grid { grid-template-columns: 1fr; }
    .swt-stats__row { flex-wrap: wrap; gap: 24px; }
    .swt-stats__div { display: none; }
    .swt-faq__layout { grid-template-columns: 1fr; gap: 40px; }
    .swt-cta__inner { flex-direction: column; text-align: center; }
  }
  @media (max-width: 768px) {
    .swt-split__grid { grid-template-columns: 1fr; gap: 32px; }
    .swt-split__grid--rev .swt-split__img { order: 0; }
    .swt-split__img img { height: 280px; }
    .swt-gallery__grid { grid-template-columns: repeat(2, 1fr); }
    .swt-process__step { grid-template-columns: 48px 1fr; gap: 20px; }
    .swt-process__num { font-size: 36px; }
    .es-hero__content { padding: 100px 20px 64px; }
    .es-hero__title { font-size: clamp(1.9rem, 8vw, 2.5rem); }
    .es-hero__br { display: block; }
    .es-hero__cta { flex-direction: column; align-items: center; gap: 12px; width: 100%; max-width: 320px; }
    .swt-cta__btns { flex-direction: column; width: 100%; }
    .swt-energy-metrics { flex-direction: column; gap: 16px; }
    /* Fix horizontal overflow */
    .es-bento__grid { grid-template-columns: 1fr; }
    .es-hero__stats-inner { flex-wrap: wrap; }
    .es-hero__stat { min-width: 50%; }
    .es-hero__stat-divider { display: none; }
    .es-reviews__card { min-width: 260px; max-width: 260px; }
    .es-reviews__card-photo { height: 260px; }
  }
  @media (max-width: 480px) {
    .swt-gallery__grid { grid-template-columns: repeat(2, 1fr); }
    .swt-split { padding: 64px 0; }
    .swt-stats__row { flex-direction: column; }
    .es-reviews__card { min-width: 240px; max-width: 240px; }
    .es-reviews__card-photo { height: 240px; }
    .es-hero__stat { min-width: 100%; }
  }
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const el = e.target as HTMLElement;
        const delay = el.style.getPropertyValue('--delay') || '0ms';
        setTimeout(() => el.classList.add('visible'), parseInt(delay));
        obs.unobserve(el);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));

  document.querySelectorAll('.swt-faq__item').forEach(item => {
    item.querySelector('.swt-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('swt-faq__item--open');
      document.querySelectorAll('.swt-faq__item').forEach(i => i.classList.remove('swt-faq__item--open'));
      if (!isOpen) item.classList.add('swt-faq__item--open');
    });
  });

  // ── Energy Savings Slider ──
  (function() {
    const track = document.getElementById('esTrack');
    const slides = document.querySelectorAll('.es-slider__slide');
    const navItems = document.querySelectorAll('[data-esnav]');
    const prevBtn = document.getElementById('esPrev');
    const nextBtn = document.getElementById('esNext');
    const progressBar = document.getElementById('esProgressBar');
    if (!track || !slides.length) return;
    let current = 0;
    const total = slides.length;

    function goTo(i) {
      if (i < 0) i = total - 1;
      if (i >= total) i = 0;
      current = i;
      track.style.transform = `translateX(-${current * 100}%)`;
      navItems.forEach((n, idx) => n.classList.toggle('es-slider__nav-item--active', idx === current));
      slides.forEach((s, idx) => s.classList.toggle('es-active', idx === current));
      if (progressBar) {
        progressBar.style.transition = 'none';
        progressBar.style.width = '0';
        setTimeout(() => { progressBar.style.transition = 'width 6s linear'; progressBar.style.width = '100%'; }, 50);
      }
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    navItems.forEach((n, i) => n.addEventListener('click', () => goTo(i)));

    // FAQ accordion
    document.querySelectorAll('.es-slider__faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const slide = btn.closest('.es-slider__slide');
        slide.querySelectorAll('.es-slider__faq-q').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          const a = b.nextElementSibling; if (a) a.hidden = true;
        });
        if (!expanded) {
          btn.setAttribute('aria-expanded', 'true');
          const a = btn.nextElementSibling; if (a) a.hidden = false;
        }
      });
    });

    // Auto-play
    let timer = setInterval(() => goTo(current + 1), 6000);
    document.getElementById('esSlider')?.addEventListener('mouseenter', () => clearInterval(timer));
    document.getElementById('esSlider')?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 6000); });

    // Kick off progress bar
    goTo(0);
  })();

  // ── Reviews carousel ──
  (function initEsReviews() {
    const track   = document.getElementById('esReviewsTrack');
    const dotsEl  = document.getElementById('esReviewsDots');
    const btnLeft  = document.getElementById('esReviewsArrowLeft');
    const btnRight = document.getElementById('esReviewsArrowRight');
    if (!track) return;
    const CARD = 444; // card(420) + gap(24)
    const cards = track.querySelectorAll('.es-reviews__card');
    if (dotsEl) {
      cards.forEach((_, i) => {
        const d = document.createElement('button');
        d.className = 'es-reviews__dot' + (i === 0 ? ' active' : '');
        d.setAttribute('aria-label', `Go to review ${i + 1}`);
        d.addEventListener('click', () => scrollToCard(i));
        dotsEl.appendChild(d);
      });
    }
    function scrollToCard(index) {
      const clamped = Math.max(0, Math.min(index, cards.length - 1));
      track.scrollTo({ left: clamped * CARD, behavior: 'smooth' });
    }
    function updateDots() {
      if (!dotsEl) return;
      const idx = Math.round(track.scrollLeft / CARD);
      dotsEl.querySelectorAll('.es-reviews__dot').forEach((d, i) => d.classList.toggle('active', i === idx));
      if (btnLeft)  btnLeft.classList.toggle('hidden', idx === 0);
      if (btnRight) btnRight.classList.toggle('hidden', idx >= cards.length - 1);
    }
    if (btnLeft)  btnLeft.addEventListener('click',  () => scrollToCard(Math.round(track.scrollLeft / CARD) - 1));
    if (btnRight) btnRight.addEventListener('click', () => scrollToCard(Math.round(track.scrollLeft / CARD) + 1));
    let isDragging = false, startX = 0, scrollLeft0 = 0;
    track.addEventListener('mousedown', (e) => { isDragging = true; startX = e.pageX - track.offsetLeft; scrollLeft0 = track.scrollLeft; }, { passive: true });
    window.addEventListener('mouseup', () => { if (!isDragging) return; isDragging = false; const snapped = Math.round(track.scrollLeft / CARD) * CARD; track.scrollTo({ left: snapped, behavior: 'smooth' }); }, { passive: true });
    track.addEventListener('mousemove', (e) => { if (!isDragging) return; track.scrollLeft = scrollLeft0 - (e.pageX - track.offsetLeft - startX); }, { passive: true });
    track.addEventListener('scroll', updateDots, { passive: true });
    updateDots();
  })();

  // Accordion: close others when one opens
  document.querySelectorAll('.es-accordion__item').forEach(item => {
    item.addEventListener('toggle', () => {
      if (item.open) {
        document.querySelectorAll('.es-accordion__item').forEach(other => {
          if (other !== item) other.removeAttribute('open');
        });
      }
    });
  });
</script>