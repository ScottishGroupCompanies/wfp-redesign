  }
  .res-row__body a { color: #5a7a2e; text-decoration: underline; text-underline-offset: 2px; }
  .res-row__body a:hover { color: #83A94A; }

  /* ── Pull Quote Band ── */
  .es-pullquote { background: #14201A; padding: 80px 40px; }
  .es-pullquote__inner { max-width: 860px; margin: 0 auto; text-align: center; position: relative; }
  .es-pullquote__mark { color: #7CB342; display: block; margin: 0 auto 24px; }
  .es-pullquote__quote p { font-family: 'Fraunces', Georgia, serif; font-style: italic; font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.5; color: #fff; margin: 0 0 24px; }
  .es-pullquote__quote cite { font-family: 'Inter', sans-serif; font-size: 0.875rem; color: rgba(255,255,255,0.55); font-style: normal; letter-spacing: 0.02em; }
  .es-pullquote__quote cite a { color: #7CB342; text-decoration: underline; text-underline-offset: 2px; }
  .es-pullquote__quote cite a:hover { color: #a8c96b; }
