  .res-row__text {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .res-row__eyebrow { margin-bottom: 12px; }
  .res-row__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.35rem, 2.5vw, 1.875rem);
    font-weight: 700;
    color: #14201A;
    margin: 0 0 20px;
    line-height: 1.2;
    letter-spacing: -0.02em;
