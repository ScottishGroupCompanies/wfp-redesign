  /* ── Trust Bar ── */
  .swt-trust {
    background: #ffffff;
    padding: 32px 0;
    border-bottom: 1px solid var(--swt-border);
  }
  .swt-trust__label {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--swt-text-sec);
    text-align: center;
    margin: 0 0 20px;
    opacity: 0.7;
  }

  /* ── Split Sections ── */
  .swt-split {
    padding: 96px 0;
    background: var(--swt-white);
  }
  .swt-split--dark { background: var(--swt-dark); }
  .swt-split--alt { background: var(--swt-alt); }

  .swt-split__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }
  .swt-split__grid--rev .swt-split__img { order: -1; }

  .swt-split__text p {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 16px;
    line-height: 1.85;
    color: var(--swt-text-sec);
    margin: 0 0 14px;
  }
  .swt-split--dark .swt-split__text p { color: rgba(255,255,255,0.55); }

  .swt-split__img {
    position: relative;
  }
  .swt-split__img img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: var(--swt-radius);
    display: block;
    box-shadow: 0 20px 60px rgba(42,36,30,0.12);
  }

  .swt-img-badge {
    position: absolute;
    bottom: -12px;
    right: -12px;
    background: var(--swt-green);
    color: var(--swt-white);
    border-radius: var(--swt-radius);
    padding: 16px 24px;
    text-align: center;
    box-shadow: 0 8px 24px rgba(42,36,30,0.2);
  }
  .swt-img-badge strong {
    display: block;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1;
  }
  .swt-img-badge span {
    display: block;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 600;
    opacity: 0.85;
    margin-top: 3px;
  }

  /* ── Problem Tags ── */
  .swt-problem-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .swt-tag {
    padding: 8px 16px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 600;
  }
  .swt-tag--red {
    background: rgba(180,60,60,0.1);
    color: #e8a0a0;
    border: 1px solid rgba(180,60,60,0.2);
  }

  /* ── Check List ── */
  .swt-check-list {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
  }
  .swt-check-list li {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 15px;
    color: var(--swt-text-sec);
