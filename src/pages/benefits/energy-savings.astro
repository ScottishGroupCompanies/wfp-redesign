---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import FlipWords from '../../components/FlipWords.astro';
import CategoryBlogFeed from '../../components/CategoryBlogFeed.astro';

const title = 'Energy-Saving Window Film Philadelphia | Cut Costs 25-35%';
const description = 'Energy-saving window film in Philadelphia that rejects 78% of solar heat, cuts cooling costs 25-35%, and keeps your property comfortable. Free estimate.';

const galleryImages = [
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181647_234b5a3b-2c0b-4a99-b2e2-d80621d3ecd2.png', label: 'Solar control film — Center City high-rise', alt: 'Energy saving window film installed on a Center City Philadelphia high-rise, rejecting solar heat through floor-to-ceiling glass' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170300_522f3006-3bdb-434a-a84b-472b0b56e0e8.png', label: 'Glare reduction — Philly office', alt: 'Energy saving window film reducing glare in a Philadelphia office while maintaining natural light' },
  { src: '/images/energy-saving-window-film-south-philadelphia-rowhome.jpg', label: 'Residential solar film — South Philly', alt: 'Energy saving solar window film installed in a South Philadelphia rowhome reducing heat gain through bay windows' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163222_79b81cd9-fd33-453a-8c62-ab37d4d031d1.png', label: 'UV protection — on-site measurement', alt: 'UV-blocking energy saving window film in Philadelphia tested on-site showing zero UV transmission after installation' },
  { src: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163219_ef8a6773-eb18-43d3-a8cf-305c12c72dd2.png', label: 'Professional installation — residential', alt: 'Window Film Philadelphia technician professionally installing energy saving window film on residential glass' },
  { src: '/images/low-e-energy-saving-window-film-philadelphia-winter.jpg', label: 'Low-E film — year-round comfort', alt: 'Low-E energy saving window film in a Philadelphia home maintaining warmth in winter and blocking heat in summer' },
];

const newImages = {
  hero: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181647_234b5a3b-2c0b-4a99-b2e2-d80621d3ecd2.png',
  heatRejection: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170335_205f9050-c15e-4135-9684-8380335dac7c.png',
  coolingSavings: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170300_522f3006-3bdb-434a-a84b-472b0b56e0e8.png',
  hvac: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170324_f2fb6bcd-4ac1-4aae-a52b-d57053ccab28.png',
  comfort: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163225_ef3d64e4-534f-42b3-bc9b-af78ddffac20.png',
  warranty: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170332_7a02abaf-9a99-4d42-b4d6-965dcbfe18ea.png',
};

const faqItems = [
  { question: 'How much can I save on cooling costs with window film?', answer: 'Most Philadelphia property owners see a 25-35% reduction in summer cooling costs after installing heat-rejecting window film. The exact savings depend on your building\'s glass orientation, square footage, and current HVAC efficiency — but even a modest installation typically pays for itself within 2-3 years. Our <a href="/resources/window-film-pricing/">window film pricing guide</a> breaks down costs by property type.' },
  { question: 'Does window film work on double-pane glass?', answer: 'Yes. Modern spectrally selective films are specifically engineered for dual-pane and even triple-pane glass. They reject solar heat without trapping energy between panes, so there\'s no risk of thermal stress or seal failure when professionally installed on the correct film type for your glass.' },
  { question: 'How long until window film pays for itself?', answer: 'For most commercial buildings in Philadelphia, the payback period is 2-4 years through cooling cost reductions alone. Residential installations typically see 4-7 years, but when you factor in reduced HVAC wear, furniture and flooring protected by <a href="/benefits/uv-protection-film/">UV-blocking window film</a>, and increased comfort, the real-world ROI is significantly faster.' },
  { question: 'Does window film reduce heating costs in winter?', answer: 'Yes - especially Low-E window film. While standard solar control films focus on rejecting heat in summer, Low-E films add an insulating metallic layer that reflects interior heat back into your building during winter. This can reduce winter heating costs by 10-15% in Philadelphia\'s climate.' },
  { question: 'What is the warranty on energy performance?', answer: 'Every energy-saving film we install is backed by the manufacturer\'s warranty covering film performance - including solar heat rejection ratings and fade protection. We also provide a labor warranty on every installation. Warranty terms vary by product — we\'ll walk you through the specifics during your consultation.' },
  { question: 'What does SHGC mean for window film in Philadelphia?', answer: 'SHGC stands for Solar Heat Gain Coefficient — a number between 0 and 1 that measures how much solar heat passes through glass. The lower the number, the less heat enters. Philadelphia\'s IECC 2021 energy code (Climate Zone 4A) requires new windows to meet an SHGC of 0.40 or below. High-performance energy-saving window film applied to existing glass can bring the effective SHGC well below that threshold — often achieving 0.22 to 0.35 depending on the film selected — without replacing your windows.' },
  { question: 'How quickly does commercial window film pay for itself?', answer: 'Most commercial installations in Philadelphia see payback within 2-4 years through cooling cost reductions alone. Larger glass footprints and south- or west-facing exposures accelerate that timeline significantly.' },
  { question: 'Does energy-saving window film work on large commercial glass?', answer: 'Yes — commercial energy-saving window film is specifically engineered for large glass surfaces. It is applied in panels with nearly invisible seams and performs consistently across floor-to-ceiling curtain wall systems.' },
  { question: 'Will window film installation disrupt my business?', answer: 'Minimal disruption. Our crews work floor by floor, often during off-hours or weekends if needed. Most commercial installations are complete within 1-3 days with no impact on daily operations.' },
  { question: 'How much can I save on home energy bills with window film?', answer: 'Philadelphia rowhomes with south- or west-facing windows — especially those with bay windows — can see cooling cost reductions of 10-30% in summer months after installing energy-saving window film in Philadelphia, according to 3M window film energy savings data and the U.S. Department of Energy\'s guidance on energy-efficient window coverings.' },
  { question: 'Will energy-saving window film make my rooms look dark?', answer: 'Not with the right film. Spectrally selective and nanoceramic options block heat while preserving 70-80% of visible light. Many homeowners say their rooms feel brighter and more comfortable after installation.' },
  { question: 'Can I get energy-saving window film on older single-pane windows?', answer: 'Yes — single-pane windows actually benefit the most from energy-saving window film. We will recommend the right film type for your specific glass to maximize performance and ensure long-term durability.' },
];

const testimonials = [
  {
    quote: 'Our electric bill dropped nearly $400 in the first summer after the film was installed. The building is actually comfortable in the afternoon now - before, the west side was unbearable.',
    author: 'Jennifer K.',
    role: 'Property Manager, Society Hill Condominiums',
  },
  {
    quote: 'I was skeptical because we\'d tried blinds and tinted blinds before. But window film actually solved the problem - no more adjusting blinds, no more squinting. The HVAC ran half as much.',
    author: 'Marcus T.',
    role: 'Office Manager, Consulting Firm, Center City',
  },
  {
    quote: 'As a building engineer, I\'ve watched film save thousands of dollars in HVAC calls over the years. The ROI is real and documentable. We specify it on every retrofit now.',
    author: 'Robert H.',
    role: 'Chief Engineer, Commercial Property Group, Philadelphia',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage="https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_1200/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181647_234b5a3b-2c0b-4a99-b2e2-d80621d3ecd2.png"
  serviceName="Energy-Saving Window Film Philadelphia"
  serviceDesc="Energy-saving window film in Philadelphia for homes and businesses. Reduce cooling costs 25-35% with professional heat rejection and Low-E film installation."
  serviceUrl="https://windowfilmphiladelphia.net/benefits/energy-savings/"
  faqItems={faqItems}
  howToName="How Energy-Saving Window Film is Installed in Philadelphia"
  howToDesc="The professional energy-saving window film installation process for Philadelphia homes and businesses — from free thermal analysis to final inspection and warranty."
  howToSteps={[
    { name: 'Free Thermal Analysis & Consultation', text: 'We visit your property and use thermal imaging to identify exactly where heat enters and escapes. You receive a detailed proposal with the optimal film for your glass type, building orientation, and energy goals. No obligation.', image: 'https://windowfilmphiladelphia.net/images/window-film-installation-free-consultation-philadelphia.jpg' },
    { name: 'Custom Film Selection & Quote', text: 'Receive a detailed written quote with product options, pricing breakdown, and projected energy savings. We recommend the right energy-saving window film for your Philadelphia property\'s glass type, orientation, and budget — no upselling, no pressure.', image: 'https://windowfilmphiladelphia.net/images/2021-10-window-film-preparation-philadelphia.jpg' },
    { name: 'Professional Installation', text: 'Our factory-trained installers complete the energy-saving window film installation cleanly and efficiently with minimal disruption to your home or business. We work around your schedule and leave the space spotless.', image: 'https://windowfilmphiladelphia.net/images/2021-10-window-film-installation-philadelphia.jpg' },
    { name: 'Inspection & Long-Term Warranty', text: 'We walk the space with you before considering the job done. Every installation is backed by our labor warranty, and most films come with a manufacturer\'s performance warranty. Warranty terms vary by product.', image: 'https://windowfilmphiladelphia.net/images/window-film-installation-final-inspection-philadelphia.jpg' },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": "https://windowfilmphiladelphia.net/benefits/energy-savings/#breadcrumb",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Benefits", "item": "https://windowfilmphiladelphia.net/benefits/" },
      { "@type": "ListItem", "position": 3, "name": "Energy-Saving Window Film Philadelphia", "item": "https://windowfilmphiladelphia.net/benefits/energy-savings/" }
    ]
  })}></script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://windowfilmphiladelphia.net/benefits/energy-savings/#webpage",
    "url": "https://windowfilmphiladelphia.net/benefits/energy-savings/",
    "name": "Energy-Saving Window Film Philadelphia | Cut Costs 25-35%",
    "description": "Energy-saving window film in Philadelphia that rejects 78% of solar heat, cuts cooling costs 25-35%, and keeps your property comfortable. Free estimate.",
    "dateModified": "2026-06-29",
    "isPartOf": { "@type": "WebSite", "@id": "https://windowfilmphiladelphia.net/#website", "url": "https://windowfilmphiladelphia.net/", "name": "Window Film Philadelphia" },
    "breadcrumb": { "@id": "https://windowfilmphiladelphia.net/benefits/energy-savings/#breadcrumb" },
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".es-hero__subtitle", ".es-why__direct-answer", ".es-why__intro", ".swt-faq__a"] },
    "about": { "@type": "Service", "@id": "https://windowfilmphiladelphia.net/benefits/energy-savings/#service" }
  })}></script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Energy-Saving Window Film Types Available in Philadelphia",
    "description": "Professional energy-saving window film options for Philadelphia homes and businesses, installed by certified technicians.",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Low-E Film", "description": "Year-round insulation for Philadelphia homes. Reflects interior heat back inside during winter while blocking solar heat in summer. Ideal for older single-pane windows." },
      { "@type": "ListItem", "position": 2, "name": "Heat Blocking Film", "description": "Absorbs and reflects incoming solar energy before it becomes heat inside your Philadelphia building. Best for south- and west-facing exposures." },
      { "@type": "ListItem", "position": 3, "name": "Nanoceramic Film", "description": "Uses nano-sized ceramic particles to reject heat and UV without any metallic tint or signal interference. Virtually invisible on Philadelphia residential and commercial glass." },
      { "@type": "ListItem", "position": 4, "name": "Spectrally Selective Film", "description": "Filters out infrared heat while allowing maximum visible light through Philadelphia windows. Bright, naturally lit space without the heat." }
    ]
  })}></script>
  <!-- HERO -->
  <section class="es-hero">
    <div class="es-hero__bg" style={`background-image: url('${newImages.hero}')`} role="img" aria-label="Energy savings window film on a Philadelphia home reducing solar heat gain"></div>
    <div class="es-hero__overlay"></div>
    <div class="es-hero__content">

      <div class="es-hero__eyebrow">
        <span>Energy Savings Window Film</span>
        <span class="es-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Philadelphia, PA</span>
        <span class="es-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Since 2008</span>
      </div>

      <h1 class="es-hero__title">Energy Savings Window Film<br class="es-hero__br"/> for Philadelphia</h1>

      <p class="es-hero__animated-line">
        Reduce your
        <FlipWords
          words={["cooling costs", "energy bills", "HVAC load", "discomfort", "heat gain"]}
          staticText=""
          class="es-hero__flip"
        />.
      </p>

      <p class="es-hero__subtitle">
        Energy-saving window film for Philadelphia homes and businesses rejects 78% of solar heat and cuts cooling costs 25-35% — without replacing your windows.
      </p>

      <div class="es-hero__cta">
        <a href="/contact/" class="es-hero__btn-primary">Get Your Free Estimate</a>
        <a href="tel:2673947980" class="es-hero__btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z" fill="currentColor"/></svg>
          Call (267) 394-7980
        </a>
      </div>

      <div class="es-hero__stats-panel" aria-label="Key statistics">
        <div class="es-hero__stats-inner">
          <div class="es-hero__stat">
            <span class="es-hero__stat-number">78%</span>
            <span class="es-hero__stat-label">Solar Heat Rejected</span>
          </div>
          <div class="es-hero__stat-divider" aria-hidden="true"></div>
          <div class="es-hero__stat">
            <span class="es-hero__stat-number">2008</span>
            <span class="es-hero__stat-label">Serving Philadelphia Since</span>
          </div>
          <div class="es-hero__stat-divider" aria-hidden="true"></div>
          <div class="es-hero__stat">
            <span class="es-hero__stat-number">2,400+</span>
            <span class="es-hero__stat-label">Projects Completed</span>
          </div>
          <div class="es-hero__stat-divider" aria-hidden="true"></div>
          <div class="es-hero__stat">
            <span class="es-hero__stat-number">2-4 Yrs</span>
            <span class="es-hero__stat-label">Avg. Payback Period</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <div class="swt-body">

    <!-- TRUST BAR -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by 500+ Philadelphia homes and businesses</p>
      </div>
    </section>

    <!-- BRAND LOGOS -->
    <BrandLogos />

    <!-- WHAT IS WINDOW FILM -->
    <section class="es-whatis">
      <div class="es-whatis__container">
        <div class="es-whatis__content">
          <span class="es-whatis__eyebrow">What Is Energy-Saving Window Film?</span>
          <h2 class="es-whatis__title">A Simple Upgrade.<br/>A Measurable Impact.</h2>
          <p class="es-whatis__body">Energy-saving window film can cut cooling costs by 10–30% for Philadelphia homes and businesses by rejecting up to 79% of solar heat gain. Applied directly to existing glass, it blocks UV radiation, reduces glare, and lowers HVAC load without window replacement.</p>
          <p class="es-whatis__body">Films are rated by the National Fenestration Rating Council (NFRC) for solar heat gain, UV rejection, and visible light transmission. For Philadelphia homes and businesses in IECC Climate Zone 4A, professional-grade film is one of the fastest-returning energy upgrades available.</p>
          <div class="es-whatis__stats">
            <div class="es-whatis__stat"><strong>2–4 yrs</strong><span>Typical payback period</span></div>
            <div class="es-whatis__stat-div"></div>
            <div class="es-whatis__stat"><strong>15+ yrs</strong><span>Continued savings after payback</span></div>
          </div>
        </div>
        <div class="es-whatis__image-wrap">
          <img
            src="/images/energy-saving-window-film-philadelphia-interior.jpg"
            alt="Luxury Philadelphia interior with floor-to-ceiling windows overlooking the city skyline after energy-saving window film installation" title="Luxury Philadelphia interior with floor-to-ceiling windows overlooking the city skyline after energy-saving window film installation"
            class="es-whatis__image"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="es-why" id="problem">
      <div class="es-why__container">

        <!-- Left: image with floating stat card -->
        <div class="es-why__image-wrap">
          <img
            src="/images/philadelphia-home-solar-heat-gain-window-film.jpg"
            alt="Philadelphia home with untreated windows causing heat gain and glare — showing why energy saving window film is needed" title="Philadelphia home with untreated windows causing heat gain and glare — showing why energy saving window film is needed"
            width="720"
            height="900"
            loading="lazy"
            class="es-why__image"
          />
          <div class="es-why__stat-card">
            <div class="es-why__stat-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>78% solar heat rejected</span>
            </div>
            <div class="es-why__stat-divider"></div>
            <div class="es-why__stat-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>2-4 year average payback</span>
            </div>
          </div>
        </div>

        <!-- Right: content -->
        <div class="es-why__content">
          <div class="eyebrow-modern">Why It Matters</div>
          <h2 class="es-why__headline">Philadelphia Buildings Are Losing Energy Through Every Window</h2>
          <p class="es-why__intro">Philadelphia summers push glass buildings into solar overload. A single west-facing window can add the equivalent heat of a small space heater - all day, every afternoon. Your HVAC fights this relentlessly, burning energy and lifespan with every cycle.</p>
          <ul class="es-why__bullets">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              In summer, untreated windows let in solar heat that overwhelms your air conditioning.
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              In winter, poorly insulated glass radiates interior warmth outside - buildings lose 15-25% of heating energy through windows alone.
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Window film addresses both - no replacement, no renovation, no downtime.
            </li>
          </ul>
          <div class="es-why__climate-facts">
            <div class="es-why__climate-item"><span class="es-why__climate-num">91°F</span><span class="es-why__climate-label">ASHRAE summer design temp for Philadelphia (Zone 4A)</span></div>
            <div class="es-why__climate-item"><span class="es-why__climate-num">1,300</span><span class="es-why__climate-label">Cooling degree days annually in Philadelphia (NOAA)</span></div>
            <div class="es-why__climate-item"><span class="es-why__climate-num">16.26¢</span><span class="es-why__climate-label">Average per kWh electricity rate in Philadelphia (2026)</span></div>
          </div>
          <p class="es-why__closing">Since 2008, Window Film Philadelphia has installed energy-saving window film for hundreds of Philadelphia homes and businesses — cutting energy costs with professional-grade solar control and Low-E films.</p>
          <a href="/contact/" class="es-why__cta">
            Get a free energy assessment
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
          </a>
        </div>

      </div>
    </section>

    <!-- COMPACT BENTO BAND -->
    <section class="es-bento">
      <div class="es-bento__header">
        <h2 class="es-bento__title">How does window film save energy without replacing windows?</h2>
        <p class="es-bento__sub">Energy-saving window film in Philadelphia delivers real energy performance — no renovation, no mess, no window replacement needed.</p>
      </div>
      <div class="es-bento__compact">

        <div class="es-bento-item">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <circle cx="14" cy="14" r="9" stroke="#7CB342" stroke-width="1.5"/>
            <path d="M14 7v2M14 19v2M7 14h2M19 14h2" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="14" cy="14" r="3" fill="#7CB342" fill-opacity="0.15" stroke="#7CB342" stroke-width="1"/>
