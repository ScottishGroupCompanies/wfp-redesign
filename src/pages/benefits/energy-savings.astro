  /* ══════════════════════════════════════
     ENERGY SAVINGS SLIDER
     ══════════════════════════════════════ */
  .es-slider { position: relative; width: 100%; min-height: 90vh; overflow: hidden; background: #14201A; }
  .es-slider__track { display: flex; width: 100%; height: 100%; transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); will-change: transform; }

  .es-slider__overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.22) 60%, transparent 100%); z-index: 1; }
  .es-slider__content { position: relative; z-index: 2; max-width: 560px; padding-left: 80px; color: #fff; opacity: 0; transform: translateY(20px); transition: opacity 0.5s ease 0.1s, transform 0.5s ease 0.1s; }
  .es-slider__slide[data-slide="0"] .es-slider__content { opacity: 1; transform: translateY(0); }
  .es-slider__step { font-family: 'Space Mono', monospace; font-size: 13px; color: #7CB342; letter-spacing: 0.2em; margin-bottom: 1rem; opacity: 0; animation: esFadeUp 0.4s ease 0.2s forwards; }
  .es-slider__title { font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 4vw, 3.25rem); font-weight: 700; color: #fff; line-height: 1.1; margin: 0 0 1.5rem; opacity: 0; animation: esFadeUp 0.4s ease 0.3s forwards; }
  .es-slider__desc { font-family: 'Inter', sans-serif; font-size: 16px; line-height: 1.8; color: rgba(255,255,255,0.85); max-width: 460px; margin-bottom: 2rem; opacity: 0; animation: esFadeUp 0.4s ease 0.4s forwards; }
  .es-slider__faq { display: flex; flex-direction: column; gap: 8px; margin-bottom: 2rem; opacity: 0; animation: esFadeUp 0.4s ease 0.5s forwards; }
  .es-slider__faq-item { border-radius: 8px; overflow: hidden; }
  .es-slider__faq-q { width: 100%; background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: rgba(255,255,255,0.88); font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 500; padding: 12px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center; gap: 12px; cursor: pointer; transition: background 0.2s ease; }
  .es-slider__faq-q:hover { background: rgba(255,255,255,0.18); }
  .es-slider__faq-icon { font-size: 1.2rem; color: #7CB342; flex-shrink: 0; font-style: normal; transition: transform 0.3s ease; }
  .es-slider__faq-q[aria-expanded="true"] .es-slider__faq-icon { transform: rotate(45deg); }
  .es-slider__faq-a { background: rgba(255,255,255,0.08); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.10); border-top: none; border-radius: 0 0 8px 8px; color: rgba(255,255,255,0.70); font-family: 'Inter', sans-serif; font-size: 0.875rem; line-height: 1.6; padding: 12px 16px; margin-top: -4px; }
  .es-slider__faq-a a { color: #a8c96b; text-decoration: underline; text-underline-offset: 2px; }
  .es-slider__faq-a a:hover { color: #c5e088; }
  .es-slider__cta { display: inline-block; background: #7CB342; color: #fff; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; padding: 14px 32px; border-radius: 9999px; text-decoration: none; transition: background 0.25s ease, transform 0.2s ease; opacity: 0; animation: esFadeUp 0.4s ease 0.6s forwards; }
  .es-slider__cta:hover { background: #2E6B30; transform: translateY(-2px); }
  .es-slider__nav { position: absolute; top: 50%; right: 48px; transform: translateY(-50%); z-index: 10; display: flex; flex-direction: column; gap: 24px; }
  .es-slider__nav-item { display: flex; align-items: center; gap: 12px; background: transparent; border: none; cursor: pointer; padding: 0; opacity: 0.35; transition: opacity 0.3s ease; }
  .es-slider__nav-item:hover { opacity: 0.65; }
  .es-slider__nav-item--active { opacity: 1; }
  .es-slider__nav-line { display: block; width: 3px; height: 32px; background: rgba(255,255,255,0.4); border-radius: 2px; transition: background 0.3s ease, height 0.3s ease; }
  .es-slider__nav-item--active .es-slider__nav-line { background: #7CB342; height: 48px; }
  .es-slider__nav-label { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 500; color: #fff; text-transform: uppercase; letter-spacing: 0.15em; white-space: nowrap; }
  .es-slider__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 10; width: 48px; height: 48px; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #fff; transition: background 0.3s ease, color 0.3s ease; }
  .es-slider__arrow:hover { background: rgba(0,0,0,0.6); color: #7CB342; }
  .es-slider__arrow--prev { left: 32px; }
  .es-slider__arrow--next { right: 32px; }
  .es-slider__progress { position: absolute; bottom: 0; left: 0; width: 100%; height: 2px; background: rgba(255,255,255,0.15); z-index: 10; }
  .es-slider__progress-bar { height: 100%; background: #7CB342; width: 0; transition: width 0.05s linear; }
  @keyframes esFadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  .es-slider__slide.es-active .es-slider__content { opacity: 1; transform: translateY(0); }
  .es-slider__slide.es-active .es-slider__step { animation: esFadeUp 0.4s ease 0.2s forwards; }
  .es-slider__slide.es-active .es-slider__title { animation: esFadeUp 0.4s ease 0.3s forwards; }
  .es-slider__slide.es-active .es-slider__desc { animation: esFadeUp 0.4s ease 0.4s forwards; }
  .es-slider__slide.es-active .es-slider__faq { animation: esFadeUp 0.4s ease 0.5s forwards; }
  .es-slider__slide.es-active .es-slider__cta { animation: esFadeUp 0.4s ease 0.6s forwards; }
  @media (max-width: 1024px) { .es-slider__nav { right: 32px; } .es-slider__content { padding-left: 60px; } }
  @media (max-width: 768px) {
  .es-slider { min-height: auto; }

  .es-slider__overlay { position: absolute; top: 0; left: 0; right: 0; height: 280px; background: linear-gradient(to bottom, rgba(0,0,0,0.30) 0%, rgba(0,0,0,0.50) 100%); }
  .es-slider__content { position: relative; padding: 32px 24px 48px; max-width: 100%; background: #14201A; }
  .es-slider__nav { display: none; }
  .es-slider__title { font-size: 1.75rem; }
  .es-slider__desc { font-size: 0.9rem; }
  .es-slider__arrow--prev { left: 20px; }
  .es-slider__arrow--next { right: 20px; }
}

  /* ══════════════════════════════════════
     BENEFIT FEATURE ROWS
     ══════════════════════════════════════ */
  .res-features {
    background: #F3F6F1;
    padding: 100px 24px;
  }
  .res-features__container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .res-features__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 72px;
  }
  .res-features__headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: #14201A;
    margin: 12px 0 20px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .res-features__intro {
    font-family: 'Inter', sans-serif;
    font-size: 1.0625rem;
    color: #4A5C48;
    line-height: 1.75;
  }
  .res-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
    margin-bottom: 80px;
  }
  .res-row:last-child { margin-bottom: 0; }
  .res-row--reversed { direction: rtl; }
  .res-row--reversed > * { direction: ltr; }
  .res-row__image {
