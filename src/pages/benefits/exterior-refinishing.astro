---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import CategoryBlogFeed from '../../components/CategoryBlogFeed.astro';

const title = 'Exterior Refinishing in Philadelphia | Facade Restoration';
const description = 'Exterior refinishing in Philadelphia restores commercial glass facades — concealing scratches, water stains, and weathering without glass replacement.';

const faqItems = [
  { question: 'What is exterior refinishing for commercial glass?', answer: 'Exterior refinishing is the process of restoring and resurfacing the exterior glass on commercial buildings using specialized film. Instead of replacing aged, scratched, or weathered glass panels, a refinishing film is applied directly to the exterior surface — concealing existing damage, creating a uniform modern appearance, and protecting the glass from future wear. It is a commercial service designed for office towers, hotels, retail storefronts, and high-rise residential buildings.' },
  { question: 'Can exterior refinishing conceal existing scratches and water stains?', answer: 'Yes. Facade resurfacing film is engineered to cover surface-level scratches, hard water stains, mineral etching, and weathering damage on exterior glass. The film creates a new uniform surface layer that masks existing imperfections. For glass with severe structural damage or deep cracks that compromise integrity, full panel replacement may be necessary — our technicians assess each facade before recommending the appropriate solution.' },
  { question: 'Is exterior refinishing film visible on the building?', answer: 'Exterior refinishing film is available in multiple optical finishes — from optically clear to reflective and neutral tones. Clear films are virtually invisible after installation. Reflective and neutral finishes intentionally change the glass appearance to modernize dated facades, creating a uniform contemporary look. The finish is selected based on your aesthetic goals and the existing condition of the glass.' },
  { question: 'Which buildings benefit most from exterior refinishing in Philadelphia?', answer: 'The highest-value applications include Center City office towers with aging curtain wall glass, boutique and chain hotels with weathered facade glass, retail storefronts on high-traffic corridors like Market Street and Walnut Street, and high-rise residential buildings with dated exterior glazing. Any commercial building where glass replacement is cost-prohibitive or logistically complex is a strong candidate.' },
  { question: 'How does exterior refinishing compare to full glass replacement?', answer: 'Glass replacement on commercial buildings requires custom fabrication, crane access, facade dismantling, and extended construction timelines — often taking weeks per elevation. Exterior refinishing film is applied directly to the existing glass surface in a fraction of the time, with no structural work required. The cost is significantly lower, and the building remains fully operational throughout installation.' },
  { question: 'Does exterior refinishing film provide energy benefits?', answer: 'Yes. Many exterior refinishing films are dual-purpose — they combine visual resurfacing with solar heat rejection. Reflective and neutral finishes reduce solar heat gain through the glass, lowering cooling loads for the building. Some products also block up to 99% of UV radiation, which protects interior furnishings and reduces fading. The energy benefit depends on the specific film product selected.' },
  { question: 'How long does exterior refinishing film last on commercial buildings?', answer: 'Exterior refinishing films carry manufacturer warranties of 7–15 years depending on the product, exposure conditions, and facade orientation. South-facing and high-exposure elevations may experience faster wear. The film is designed for long-term exterior performance with proper installation. When it eventually needs replacement, the film is removed and a new layer applied — the underlying glass remains undamaged.' },
  { question: 'Can exterior refinishing film be applied to all types of commercial glass?', answer: 'Exterior refinishing film is compatible with most standard commercial glazing including tempered, laminated, and annealed glass in curtain walls, storefront systems, and window walls. Our technicians evaluate each facade — glass type, panel size, access method, and surface condition — before installation. Non-standard or structurally compromised glass may require assessment before film can be applied.' },
  { question: 'What is the cost advantage of exterior refinishing over glass replacement?', answer: 'We do not publish per-square-foot pricing as costs vary by building size, facade access complexity, number of glass panels, and film product. What we can say is that exterior refinishing consistently costs a fraction of full glass replacement, which involves custom fabrication, structural work, and extended labor. Contact us for a free site assessment and written estimate tailored to your building.' },
  { question: 'How do I get exterior refinishing film installed in Philadelphia?', answer: 'Contact us for a free site assessment. We evaluate your building facade, assess existing glass damage, and recommend the appropriate refinishing film product for each elevation. Most commercial installations are scheduled and completed with minimal disruption to building operations, including after-hours and weekend service for occupied buildings.' }
];

const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Benefits", "item": "https://www.windowfilmphiladelphia.net/benefits/" },
      { "@type": "ListItem", "position": 3, "name": "Exterior Refinishing", "item": "https://www.windowfilmphiladelphia.net/benefits/exterior-refinishing/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.windowfilmphiladelphia.net/benefits/exterior-refinishing/",
    "name": title,
    "description": description,
    "dateModified": new Date().toISOString().slice(0, 10),
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".er-hero__title", ".er-hero__subtitle", ".faq__a-inner"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Exterior Refinishing Applications",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Office Towers" },
      { "@type": "ListItem", "position": 2, "name": "Retail Storefronts" },
      { "@type": "ListItem", "position": 3, "name": "Hotels" },
      { "@type": "ListItem", "position": 4, "name": "High-Rise Residential" },
      { "@type": "ListItem", "position": 5, "name": "Commercial Facades" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Exterior Refinishing Philadelphia",
    "description": "Exterior refinishing film for Philadelphia commercial glass facades. Restores scratched, weathered, and dated exterior glass without replacement — modernizing building facades across Philadelphia.",
    "brand": { "@type": "Brand", "name": "Window Film Philadelphia" },
    "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "areaServed": "Philadelphia, PA" },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "64",
      "bestRating": "5"
    },
    "review": [
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "David T." }, "reviewBody": "Our Center City office tower had decades of weathering on the curtain wall glass. The exterior refinishing film completely modernized the facade. Tenants think we replaced every pane — we did not replace a single one." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Christine B." }, "reviewBody": "Our boutique hotel exterior glass had hard water stains and scratch damage from years of exposure. The refinishing film restored the facade to like-new condition. The improvement in curb appeal was immediate and dramatic." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Marcus W." }, "reviewBody": "We manage a portfolio of commercial properties across Philadelphia. Exterior refinishing has become our go-to solution for buildings with dated glass. The cost savings versus replacement are significant and the visual transformation is remarkable." }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Exterior Refinishing"
  serviceDesc="Restoring and resurfacing commercial exterior glass facades in Philadelphia — concealing scratches, water stains, and weathering without glass replacement."
  serviceUrl="https://www.windowfilmphiladelphia.net/benefits/exterior-refinishing/"
  faqItems={faqItems}
  schemas={pageSchemas}
>

  <!-- ══ HERO ══ -->
  <section class="hs">
    <img src="/images/exterior-refinishing-philadelphia-hero.jpg"
         alt="Commercial building facade restored with exterior refinishing film in Philadelphia"
         title="Exterior refinishing in Philadelphia — commercial facade restoration"
         class="hs__bg" loading="eager" />
    <div class="hs__overlay" aria-hidden="true"></div>
    <div class="hs__inner">
      <p class="hs__eyebrow">
        <span class="hs__dot" aria-hidden="true"></span>
        Philadelphia Facade Restoration
      </p>
      <h1 class="hs__title er-hero__title">Commercial Exterior Refinishing in Philadelphia</h1>
      <p class="hs__sub er-hero__subtitle">Restore and modernize your building's exterior glass without replacement. Exterior refinishing film conceals scratches, water stains, and weathering — transforming dated facades into contemporary curtain walls at a fraction of glass replacement cost.</p>
      <div class="hs__cta">
        <a href="/contact/" class="hs__btn-primary">Get a Free Assessment</a>
        <a href="/benefits/" class="hs__btn-secondary">All Benefits</a>
      </div>
    </div>
  </section>

  <!-- ══ TRUST BAR ══ -->
  <section class="swt-trust">
    <div class="container">
      <p class="swt-trust__label">Trusted by Philadelphia commercial property managers, hotel operators, and real estate developers.</p>
      <BrandLogos />
    </div>
  </section>

  <!-- ══ THE PROBLEM — Accordion Vertical ══ -->
  <section class="er-accv-wrap">
    <div class="er-accv-wrap__header">
      <div class="er-accv-wrap__eyebrow">THE PROBLEM</div>
      <h2 class="er-accv-wrap__title split-reveal" data-stagger="65" aria-label="Old Glass Ages Your Building."><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:0">Old&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:1">Glass&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:2">Ages&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:3">Your&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:4">Building.</span></span></h2>
      <p class="er-accv-wrap__sub">Exterior refinishing in Philadelphia restores and modernizes commercial glass facades without replacement — concealing weathering, scratches, and stains at a fraction of glass replacement cost.</p>
    </div>
    <div class="accv">
      <div class="accv__panel is-open" data-panel style="background-image:url('/images/exterior-refinishing-philadelphia-before.jpg')">
        <button class="accv__tab" data-tab aria-expanded="true">
          <span class="accv__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></span>
          <span class="accv__title">Dated &amp; Weathered Glass</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Dated and Weathered Glass Facades</h3>
            <p>Decades of UV exposure, acid rain, and urban pollution etch and cloud exterior glass on commercial buildings across Philadelphia. What was once a sleek modern facade becomes dull, streaked, and visually dated — dragging down property value and curb appeal. Exterior refinishing in Philadelphia addresses this by applying a modern film layer over the existing glass, instantly updating the facade appearance without the cost and disruption of panel replacement. According to <a href="https://www.llumar.com/commercial-window-film/" target="_blank" rel="noopener">LLumar commercial window film</a>, modern exterior films can transform building appearance while delivering measurable energy performance improvements.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/exterior-refinishing-philadelphia-glass-restoration.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M5 8h14M7 16h10"/><circle cx="12" cy="12" r="9"/></svg></span>
          <span class="accv__title">Surface Damage</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Scratches, Water Stains &amp; Etching</h3>
            <p>Exterior commercial glass accumulates damage from hard water runoff, mineral deposits, wind-blown debris, and surface scratching over years of exposure. Hard water stains create permanent mineral etching that conventional cleaning cannot remove. Scratches from maintenance equipment, scaffolding, and weather events mar the surface. Facade resurfacing film covers this damage with a new uniform layer — the existing imperfections disappear beneath a clean, modern finish.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/exterior-refinishing-philadelphia-facade-modern.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg></span>
          <span class="accv__title">Facade Modernization</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Transforming Appearance Without Replacement</h3>
            <p>Film transforms a dated glass facade into a contemporary curtain wall in days rather than months. Reflective and neutral finishes create a uniform, modern aesthetic that masks decades of wear. "Window film is one of the most cost-effective ways to improve the performance of existing windows," according to the International Window Film Association. For Philadelphia building owners, this means a dramatic visual upgrade without scaffolding, crane access, or tenant displacement.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ FILM TYPES — Bento Photo Grid ══ -->
  <section class="bgp er-film-bento">
    <div class="bgp__head">
      <div class="bgp__eyebrow">FACADE RESTORATION</div>
      <h2 class="bgp__title">What are the benefits of exterior glass resurfacing in Philadelphia?</h2>
      <p class="bgp__sub">Exterior refinishing in Philadelphia uses different film products and finishes to address specific facade conditions — from modernizing dated glass to concealing surface damage and protecting against future wear.</p>
    </div>
    <div class="bgp__grid">
      <div class="bgp__card bgp__card--lg">
        <img src="/images/exterior-refinishing-philadelphia-facade-modern.jpg" alt="Modern commercial building facade restored with exterior refinishing film in Philadelphia" title="Facade modernization — exterior refinishing Philadelphia" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body"><h3>Facade Modernization</h3><p>Reflective and neutral film finishes transform dated glass facades into contemporary curtain walls — uniform appearance, modern aesthetic, no glass replacement.</p></div>
      </div>
      <div class="bgp__card bgp__card--sm">
        <img src="/images/exterior-refinishing-philadelphia-glass-restoration.jpg" alt="Commercial glass restoration with exterior refinishing film in Philadelphia" title="Glass restoration — exterior refinishing Philadelphia" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body"><h3>Glass Restoration</h3><p>Resurfacing film conceals existing scratches, water stains, and weathering damage on exterior commercial glass.</p></div>
      </div>
      <div class="bgp__card bgp__card--sm">
        <img src="/images/exterior-refinishing-philadelphia-surface-protection.jpg" alt="Surface protection film on commercial building exterior glass in Philadelphia" title="Surface protection — exterior refinishing Philadelphia" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body"><h3>Surface Protection</h3><p>Sacrificial exterior film layer absorbs future scratching and weathering — replace the film, not the glass.</p></div>
      </div>
      <div class="bgp__card bgp__card--md">
        <img src="/images/exterior-refinishing-philadelphia-curb-appeal.jpg" alt="Commercial building with improved curb appeal from exterior refinishing film in Philadelphia" title="Curb appeal improvement — exterior refinishing Philadelphia" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body"><h3>Curb Appeal</h3><p>Modernized facade glass dramatically improves building appearance and perceived value — visible from the street, immediate impact for tenants and prospects.</p></div>
      </div>
      <div class="bgp__card bgp__card--md">
        <img src="/images/exterior-refinishing-philadelphia-commercial-building.jpg" alt="Commercial building exterior with refinishing film applied in Philadelphia" title="Commercial building refinishing — Philadelphia" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body"><h3>Commercial Building</h3><p>Office towers, hotels, and retail buildings across Philadelphia benefit from exterior refinishing — a practical alternative to full glass panel replacement at scale.</p></div>
      </div>
      <div class="bgp__card bgp__card--md">
        <img src="/images/exterior-refinishing-philadelphia-energy-efficiency.jpg" alt="Energy-efficient exterior window film on Philadelphia commercial building glass facade" title="Energy efficiency — exterior refinishing Philadelphia" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body"><h3>Energy Efficiency</h3><p>Exterior solar control film rejects heat before it enters the building — reducing cooling load and lowering energy costs while modernizing the facade appearance.</p></div>
      </div>
    </div>
  </section>

  <!-- ══ HOW EACH FILM WORKS — Accordion Benefits (4 rows) ══ -->
  <section class="accb">
    <div class="accb__head">
      <h2 class="accb__title">How Exterior Refinishing Film Works</h2>
      <p class="accb__sub">Each film type addresses a different facade challenge — from solar heat rejection to surface damage concealment to combined energy and aesthetic benefits for exterior refinishing in Philadelphia.</p>
    </div>
    <div class="accb__wrap">
      <div class="accb__list">
        <div class="accb__row is-open" data-row data-index="0">
          <button class="accb__trigger" data-trigger aria-expanded="true">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg></span>
            <span class="accb__row-title">Exterior Solar Control Film — Reflective &amp; Neutral Finishes</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail"><div class="accb__detail-inner">
            <p>Reflective and neutral exterior solar control films do double duty — they modernize dated glass facades with a uniform contemporary finish while rejecting up to 79% of solar heat gain through the glass. For Philadelphia <a href="/applications/office/">office towers</a> with aging curtain walls, this means lower cooling costs alongside a dramatic visual upgrade. The reflective finish masks existing surface damage and creates a consistent appearance across all elevations. Explore our range of <a href="/products/">commercial window film products</a> to compare performance specifications.</p>
            <img class="accb__mobile-img" src="/images/exterior-refinishing-philadelphia-facade-modern.jpg" alt="Reflective solar control film on Philadelphia commercial building facade" title="Exterior solar control film — Philadelphia" loading="lazy" />
          </div></div>
        </div>
        <div class="accb__row" data-row data-index="1">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></span>
            <span class="accb__row-title">Exterior Surface Protection Film — Clear Sacrificial Layer</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail"><div class="accb__detail-inner">
            <p>Exterior surface protection film provides a clear sacrificial layer over commercial glass and metal facade surfaces. It absorbs scratching, weathering, and environmental damage before it reaches the substrate. Building facade window film in Philadelphia is increasingly specified by property managers who want to preserve newly installed or recently restored glass — when the film shows wear, it is removed and replaced, and the glass underneath remains pristine. This approach is particularly valuable for <a href="/benefits/anti-graffiti/">buildings that face ongoing surface damage</a> from urban exposure.</p>
            <img class="accb__mobile-img" src="/images/exterior-refinishing-philadelphia-surface-protection.jpg" alt="Clear surface protection film on Philadelphia commercial building" title="Exterior surface protection film — Philadelphia" loading="lazy" />
          </div></div>
        </div>
        <div class="accb__row" data-row data-index="2">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg></span>
            <span class="accb__row-title">Facade Resurfacing Film — Conceal Damage, Uniform Appearance</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail"><div class="accb__detail-inner">
            <p>Facade resurfacing film is engineered specifically to conceal existing surface damage on exterior commercial glass. Scratches, hard water stains, mineral etching, and weathering discoloration disappear beneath a new uniform film layer. The result is a consistent, clean facade appearance without removing or replacing a single glass panel. Exterior window resurfacing for Philadelphia buildings is completed in days rather than the weeks or months required for full glass replacement — and the building remains fully operational throughout installation.</p>
            <img class="accb__mobile-img" src="/images/exterior-refinishing-philadelphia-glass-restoration.jpg" alt="Facade resurfacing film concealing damage on Philadelphia commercial glass" title="Facade resurfacing film — Philadelphia" loading="lazy" />
          </div></div>
        </div>
        <div class="accb__row" data-row data-index="3">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
            <span class="accb__row-title">Combined Energy + Aesthetic Film — Dual Benefit</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail"><div class="accb__detail-inner">
            <p>The most popular exterior refinishing solution combines visual modernization with measurable energy performance. These dual-benefit films transform dated glass with a contemporary finish while simultaneously reducing solar heat gain, blocking UV radiation, and lowering cooling loads. "Window film is one of the most cost-effective ways to improve the performance of existing windows," according to the International Window Film Association. For Philadelphia building owners planning exterior refinishing in Philadelphia, this dual approach delivers both aesthetic transformation and operational savings in a single installation.</p>
            <img class="accb__mobile-img" src="/images/exterior-refinishing-philadelphia-commercial-building.jpg" alt="Combined energy and aesthetic film on Philadelphia commercial building" title="Dual benefit exterior refinishing film — Philadelphia" loading="lazy" />
          </div></div>
        </div>
      </div>
      <div class="accb__media">
        <img class="accb__img is-active" data-img data-index="0" src="/images/exterior-refinishing-philadelphia-facade-modern.jpg" alt="Reflective solar control film on Philadelphia commercial building facade" title="Exterior solar control film — Philadelphia" loading="lazy" />
        <img class="accb__img" data-img data-index="1" src="/images/exterior-refinishing-philadelphia-surface-protection.jpg" alt="Clear surface protection film on Philadelphia commercial building" title="Exterior surface protection film — Philadelphia" loading="lazy" />
        <img class="accb__img" data-img data-index="2" src="/images/exterior-refinishing-philadelphia-glass-restoration.jpg" alt="Facade resurfacing film concealing damage on Philadelphia commercial glass" title="Facade resurfacing film — Philadelphia" loading="lazy" />
        <img class="accb__img" data-img data-index="3" src="/images/exterior-refinishing-philadelphia-commercial-building.jpg" alt="Combined energy and aesthetic film on Philadelphia commercial building" title="Dual benefit exterior refinishing film — Philadelphia" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ══ BEFORE/AFTER SLIDER ══ -->
  <section class="er-slider-wrap">
    <div class="er-slider-wrap__header">
      <div class="er-slider-wrap__eyebrow">THE FILM IN ACTION</div>
      <h2 class="er-slider-wrap__title">Exterior Refinishing in Action</h2>
      <p class="er-slider-wrap__sub">Drag the handle to see a weathered Philadelphia commercial glass facade transformed with exterior refinishing film — scratches and water stains concealed, modern appearance restored, same glass panels.</p>
    </div>
    <div class="er-slider-wrap__slider">
      <div class="before-after" style="--pos:50%">
        <div class="before-after__frame">
          <img src="/images/exterior-refinishing-philadelphia-before.jpg" alt="Philadelphia commercial building facade with weathered, scratched glass before exterior refinishing film" title="Philadelphia facade before refinishing — weathered glass" class="before-after__img before-after__img--before" draggable="false" loading="lazy" />
          <div class="before-after__after-wrap"><img src="/images/exterior-refinishing-philadelphia-after.jpg" alt="Same Philadelphia commercial building facade restored with exterior refinishing film — modern, clean appearance" title="Philadelphia facade after refinishing — modernized glass" class="before-after__img before-after__img--after" draggable="false" loading="lazy" /></div>
          <span class="before-after__tag before-after__ter--before">Weathered glass</span>
          <span class="before-after__tag before-after__ter--after">Film applied</span>
          <div class="before-after__handle" role="slider" tabindex="0" aria-label="Drag to compare weathered and restored Philadelphia commercial glass facade" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50"><span class="before-after__handle-grip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M8 7L3 12L8 17M16 7L21 12L16 17" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ WHERE IT'S USED — What We Do Panels ══ -->
  <section class="er-wwd-wrap">
    <div class="er-wwd-wrap__header">
