---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import CategoryBlogFeed from '../../components/CategoryBlogFeed.astro';

const title = 'Mirror Refinishing in Philadelphia | Mirror Shield Film';
const description = 'Mirror refinishing in Philadelphia using protective film. Restore scratched, tarnished, and damaged mirrors without replacement.';

const faqItems = [
  { question: 'What is mirror refinishing using film?', answer: 'Mirror refinishing with film applies a thin, optically clear protective layer directly over the existing mirror surface. The film acts as a sacrificial layer — absorbing scratches, etching, and surface abrasion rather than letting damage reach the mirror backing. When the film is damaged, it is removed and replaced, restoring the mirror to a like-new appearance without full replacement.' },
  { question: 'Can mirror refinishing film restore a mirror that is already scratched?', answer: 'Yes, for surface-level scratches on the reflective coating, Mirror Shield film can conceal existing damage when applied over the affected area. For minor scratching and surface abrasion, the film layer covers the damage and restores visual clarity. Severe damage that has penetrated the mirror backing may require full mirror replacement — our technicians assess each mirror before recommending the appropriate solution.' },
  { question: 'Is mirror refinishing film visible? Does it affect the reflection?', answer: 'Mirror Shield film is optically engineered to be visually transparent — it does not alter reflectivity, introduce distortion, or create a visible seam when properly installed. The reflection quality is preserved exactly as it was prior to installation. Most clients and their customers cannot tell that any film has been applied.' },
  { question: 'Which mirrors benefit most from refinishing film in Philadelphia?', answer: 'The highest-value applications include commercial restroom mirrors in high-traffic Philadelphia venues, hotel lobby and elevator mirrors that face daily contact damage, restaurant dining room mirrors prone to back-of-chair and accessory scratching, retail fitting room mirrors that face repeated contact from clothing and hangers, and elevator cab mirrors in office towers and residential buildings throughout Center City and Old City.' },
  { question: 'How quickly can mirror refinishing film be replaced after damage?', answer: 'In most cases our team can remove damaged film and reinstall fresh film in a single visit. Response time depends on scheduling and location. For commercial clients in Philadelphia with ongoing maintenance needs, we can establish a service schedule that ensures mirrors are always in pristine condition with minimal turnaround.' },
  { question: 'Does mirror refinishing film work on all mirror types?', answer: 'Mirror Shield film is compatible with most standard flat and slightly curved commercial mirrors. It is assessed on a mirror-by-mirror basis — our technicians evaluate the mirror backing, surface condition, and mounting before installation. Heavily contoured, antique, or non-standard mirrors may require different treatment approaches.' },
  { question: 'How long does mirror refinishing film last?', answer: 'Mirror Shield film carries manufacturer warranties of 5–10 years depending on the product and application. In high-traffic locations where surface contact is frequent, the film may be replaced after incidents as designed. The ongoing protection is what creates long-term value — each replacement restores the mirror rather than requiring full replacement.' },
  { question: 'What is the cost advantage of mirror refinishing film over full replacement?', answer: 'We do not publish per-square-foot pricing as costs vary by mirror size, access complexity, number of mirrors, and film product. What we can say is that protective film refinishing consistently costs significantly less than full mirror replacement, which involves glass fabrication, delivery, and installation of new mirror panels. Contact us for a free site assessment and written estimate.' },
  { question: 'Is mirror refinishing film different from anti-graffiti film?', answer: 'Mirror Shield is a product in the anti-graffiti film family, specifically engineered for mirror surfaces. Unlike clear Glass Shield film for windows, Mirror Shield maintains full mirror reflectivity while providing a sacrificial surface layer. The chemistry and application process are optimized for mirror substrates where maintaining reflection quality is as important as the protective function.' },
  { question: 'How do I get mirror refinishing film installed in Philadelphia?', answer: 'Contact us for a free site assessment. We evaluate your mirror surfaces, assess existing damage, and recommend the appropriate Mirror Shield product. Most commercial installations are scheduled and completed with minimal disruption, including after-hours service for restaurants and hospitality venues.' }
];

const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Benefits", "item": "https://windowfilmphiladelphia.net/benefits/" },
      { "@type": "ListItem", "position": 3, "name": "Mirror Refinishing", "item": "https://windowfilmphiladelphia.net/benefits/mirror-refinishing/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://windowfilmphiladelphia.net/benefits/mirror-refinishing/",
    "name": title,
    "description": description,
    "dateModified": new Date().toISOString().slice(0, 10),
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".mr-hero__title", ".mr-hero__subtitle", ".faq__a-inner"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Mirror Refinishing Applications",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Commercial Restroom Mirrors" },
      { "@type": "ListItem", "position": 2, "name": "Hotel Lobby Mirrors" },
      { "@type": "ListItem", "position": 3, "name": "Restaurant Dining Room Mirrors" },
      { "@type": "ListItem", "position": 4, "name": "Retail Fitting Room Mirrors" },
      { "@type": "ListItem", "position": 5, "name": "Elevator Interior Mirrors" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Mirror Refinishing Philadelphia",
    "description": "Mirror refinishing using protective Mirror Shield film for Philadelphia commercial restrooms, hotels, restaurants, and retail spaces. Restores scratched and tarnished mirrors without replacement.",
    "brand": { "@type": "Brand", "name": "Window Film Philadelphia" },
    "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "areaServed": "Philadelphia, PA" },
  }
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Mirror Refinishing"
  serviceDesc="Protective Mirror Shield film for scratched, tarnished, and damaged Philadelphia commercial mirrors."
  serviceUrl="https://windowfilmphiladelphia.net/benefits/mirror-refinishing/"
  faqItems={faqItems}
  schemas={pageSchemas}
>

  <!-- HERO -->
  <section class="hs">
    <img src="/images/mirror-refinishing-philadelphia-hero.jpg"
         alt="Pristine commercial mirror after mirror refinishing film application in Philadelphia restroom"
         title="Mirror refinishing Philadelphia — protective Mirror Shield film"
         class="hs__bg" loading="eager" />
    <div class="hs__overlay" aria-hidden="true"></div>
    <div class="hs__inner">
      <p class="hs__eyebrow">
        <span class="hs__dot" aria-hidden="true"></span>
        Philadelphia Mirror Restoration
      </p>
      <h1 class="hs__title mr-hero__title">Mirror Refinishing in Philadelphia</h1>
      <p class="hs__sub mr-hero__subtitle">Restore scratched, tarnished, and damaged mirrors without replacement. Mirror Shield protective film applied by our Philadelphia team — pristine reflection restored in a single visit.</p>
      <div class="hs__cta">
        <a href="/contact/" class="hs__btn-primary">Get a Free Assessment</a>
        <a href="/benefits/" class="hs__btn-secondary">All Benefits</a>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="swt-trust">
    <div class="container">
      <p class="swt-trust__label">Trusted by Philadelphia hotels, restaurants, retail stores, and commercial property managers.</p>
      <BrandLogos />
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="mr-accv-wrap">
    <div class="mr-accv-wrap__header">
      <div class="mr-accv-wrap__eyebrow">THE PROBLEM</div>
      <h2 class="mr-accv-wrap__title split-reveal" data-stagger="65" aria-label="Your Mirrors Are Costing You More Than They Need To"><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:0">Your&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:1">Mirrors&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:2">Are&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:3">Costing&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:4">You&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:5">Too&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:6">Much</span></span></h2>
      <p class="mr-accv-wrap__sub">Mirror restoration in Philadelphia using protective film costs a fraction of full replacement — and keeps mirrors looking new indefinitely.</p>
    </div>
    <div class="accv">
      <div class="accv__panel is-open" data-panel style="background-image:url('/images/mirror-refinishing-philadelphia-shield-film.jpg')">
        <button class="accv__tab" data-tab aria-expanded="true">
          <span class="accv__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 8h10M7 12h10M7 16h6"/></svg></span>
          <span class="accv__title">Scratches &amp; Etching</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Surface Scratches and Acid Etching</h3>
            <p>Commercial mirrors in Philadelphia restrooms, hotel lobbies, and restaurant dining rooms accumulate scratches from jewelry, accessories, and deliberate etching. Once the reflective silver backing is damaged, the mirror cannot be repaired — only covered or replaced. Mirror Shield film applied by Window Film Philadelphia protects the reflective surface before damage occurs. Replacing a single large commercial mirror typically costs $200–$600 plus labor and disposal, while Mirror Shield film restoration is completed in a single visit at a fraction of replacement cost. According to the <a href="https://popcenter.asu.edu/content/graffiti-0" target="_blank" rel="noopener">ASU Center for Problem-Oriented Policing</a>, mirror and glass surfaces are among the most frequently targeted substrates in commercial vandalism — their research confirms that barrier-based surface protection is the most cost-effective intervention for high-frequency, low-severity damage like scratching and etching.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/mirror-restoration-philadelphia-tarnish-repair.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/><circle cx="8" cy="12" r="2"/></svg></span>
          <span class="accv__title">Tarnishing &amp; Silver Spots</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Tarnishing, Foxing, and Silver Deterioration</h3>
            <p>Restroom mirrors in high-humidity environments — particularly in older Philadelphia buildings — develop dark edge spots, foxing, and silver deterioration as moisture penetrates the backing seal. Mirror Shield film applied early prevents this moisture ingress. For mirrors already showing early-stage spotting, the film covers the affected area and prevents further deterioration while the mirror remains in service.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/mirror-film-philadelphia-scratch-protection.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 7h7l-5.5 4 2 7-6.5-4.5L5.5 20l2-7L2 9h7l3-7z"/></svg></span>
          <span class="accv__title">Vandalism Damage</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Scratch Vandalism and Deliberate Damage</h3>
            <p>High-traffic Philadelphia public restrooms, SEPTA facilities, and school buildings face deliberate mirror scratching. Mirror Shield film absorbs this damage rather than allowing it to reach the backing — when vandalised, only the film is replaced, and the mirror is pristine again within hours rather than days.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MIRROR APPLICATIONS -->
  <section class="bgp mr-film-bento">
    <div class="bgp__head">
      <div class="bgp__eyebrow">MIRROR APPLICATIONS</div>
      <h2 class="bgp__title">Which mirrors can film protect in Philadelphia?</h2>
      <p class="bgp__sub">Restroom mirrors, lobby displays, elevator interiors, and fitting rooms — Mirror Shield film works wherever pristine reflection is required for mirror refinishing in Philadelphia.</p>
    </div>
    <div class="bgp__grid">
      <div class="bgp__card bgp__card--lg">
        <img src="/images/mirror-refinishing-philadelphia-restroom-mirror.jpg" alt="Mirror refinishing film protecting commercial restroom mirror in Philadelphia" title="Mirror refinishing film — Philadelphia commercial restroom" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body"><h3>Restroom Mirrors</h3><p>Commercial restroom mirrors in Philadelphia hotels, restaurants, offices, and public facilities. Mirror Shield applied directly over the reflective surface — invisible, fully reflective, and replaceable on damage.</p></div>
      </div>
      <div class="bgp__card bgp__card--sm">
        <img src="/images/mirror-film-philadelphia-lobby-display.jpg" alt="Mirror Shield film protecting hotel lobby display mirror in Philadelphia" title="Mirror Shield film — Philadelphia hotel lobby mirror" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body"><h3>Lobby &amp; Display Mirrors</h3><p>Hotel lobby, retail display, and architectural mirrors in Philadelphia commercial spaces. Protective film maintains full optical quality and surface integrity against daily contact.</p></div>
      </div>
      <div class="bgp__card bgp__card--sm">
        <img src="/images/mirror-restoration-philadelphia-elevator.jpg" alt="Mirror Shield protective film on elevator cab mirror in Philadelphia" title="Mirror restoration film — Philadelphia elevator interior" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body"><h3>Elevator Cab Mirrors</h3><p>Elevator interior mirrors in Philadelphia office towers and residential buildings face daily scratching from luggage, carts, and accessories. Mirror Shield provides a replaceable protective layer on both flat and slightly curved surfaces.</p></div>
      </div>
      <div class="bgp__card bgp__card--md">
        <img src="/images/mirror-refinishing-film-philadelphia-retail.jpg" alt="Mirror refinishing film in Philadelphia retail fitting room mirrors" title="Mirror film for Philadelphia retail fitting rooms" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body"><h3>Retail Fitting Rooms</h3><p>Fitting room mirrors in Philadelphia boutiques and clothing retail face constant contact from hangers, jewelry, and accessories. Refinishing film maintains pristine reflection and allows same-day restoration after any damage.</p></div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="accb">
    <div class="accb__head">
      <h2 class="accb__title">What Mirror Shield Film Does — and Why It Works</h2>
      <p class="accb__sub">Each application scenario for mirror refinishing film addresses a different damage challenge in Philadelphia commercial properties, making mirror refinishing in Philadelphia practical at portfolio scale.</p>
    </div>
    <div class="accb__wrap">
      <div class="accb__list">
        <div class="accb__row is-open" data-row data-index="0">
          <button class="accb__trigger" data-trigger aria-expanded="true">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span>
            <span class="accb__row-title">Mirror Shield Film — Clear Sacrificial Protection</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail"><div class="accb__detail-inner">
            <p>Mirror refinishing film for Philadelphia commercial mirrors is applied directly over the existing reflective surface — invisible in normal use but designed to absorb damage rather than let it reach the backing. The Mirror Shield product from Graffiti Shield is engineered specifically for mirror substrates, maintaining full optical clarity and achieving 99% UV blocking as a baseline property. Refinishing film for Philadelphia restrooms and lobby mirrors creates a fully replaceable surface layer: when scratching, etching, or vandalism damages the film, our team removes and reinstalls fresh film in a single visit for <a href="/applications/office/">Philadelphia office buildings</a> and <a href="/applications/retail/">retail fitting rooms</a>.</p>
            <img class="accb__mobile-img" src="/images/mirror-refinishing-philadelphia-shield-film.jpg" alt="Mirror refinishing film installation on Philadelphia commercial mirror" title="Mirror Shield film — Philadelphia" loading="lazy" />
          </div></div>
        </div>
        <div class="accb__row" data-row data-index="1">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19l16-14M7 7h.01M12 12h.01M17 17h.01"/></svg></span>
            <span class="accb__row-title">Scratch &amp; Vandalism Protection — Surface-Level Damage Absorbed</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail"><div class="accb__detail-inner">
            <p>Philadelphia high-traffic mirrors face scratching from metal accessories, hangers, luggage wheels, and deliberate etching. Without protection, each incident permanently damages the reflective silver backing — requiring costly full-panel replacement. Mirror Shield film absorbs these impacts. When the film shows visible damage, it is replaced — not the mirror. For Philadelphia <a href="/applications/hotels/">hotel mirrors</a> and <a href="/applications/restaurants/">restaurant restroom mirrors</a>, this eliminates emergency replacement calls and the business disruption that comes with them.</p>
            <img class="accb__mobile-img" src="/images/mirror-film-philadelphia-scratch-protection.jpg" alt="Mirror film protecting Philadelphia commercial mirror from scratch damage" title="Scratch protection mirror film — Philadelphia" loading="lazy" />
          </div></div>
        </div>
        <div class="accb__row" data-row data-index="2">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M5 8h14M7 16h10"/><circle cx="12" cy="12" r="9"/></svg></span>
            <span class="accb__row-title">Tarnish &amp; Humidity Protection — Extending Mirror Life</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail"><div class="accb__detail-inner">
            <p>Philadelphia commercial restrooms — particularly in older Center City and Old City buildings — are prone to mirror tarnishing from steam, cleaning chemical exposure, and seal failure. Mirror Shield film provides a barrier between the cleaning environment and the mirror backing, dramatically slowing or preventing the silver deterioration that causes black-edge foxing. For mirrors already showing early tarnishing, the film covers and stabilises the affected area while keeping <a href="/applications/office/">commercial restroom mirrors</a> in service.</p>
            <img class="accb__mobile-img" src="/images/mirror-restoration-philadelphia-tarnish-repair.jpg" alt="Mirror restoration film protecting Philadelphia mirror from tarnishing" title="Tarnish protection mirror film — Philadelphia" loading="lazy" />
          </div></div>
        </div>
        <div class="accb__row" data-row data-index="3">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M12 4v16"/><path d="M6 6l12 12M18 6L6 18"/></svg></span>
            <span class="accb__row-title">Long-Term Cost Efficiency — Replace Film, Not the Mirror</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail"><div class="accb__detail-inner">
            <p>A single full-mirror replacement in a commercial Philadelphia property — accounting for custom fabrication, removal of the existing mirror, new panel installation, and potential wall repairs — is a significant expenditure. Mirror Shield film refinishing costs a fraction of that, and the film can be replaced multiple times before approaching replacement cost. For Philadelphia property managers overseeing portfolios of hotels, restaurants, or office buildings with multiple mirror installations, refinishing film dramatically reduces annual mirror maintenance budgets.</p>
            <img class="accb__mobile-img" src="/images/mirror-refinishing-film-philadelphia-commercial.jpg" alt="Mirror refinishing film protecting Philadelphia commercial mirror long-term" title="Long-term mirror refinishing film — Philadelphia commercial" loading="lazy" />
          </div></div>
        </div>
      </div>
      <div class="accb__media">
        <img class="accb__img is-active" data-img data-index="0" src="/images/mirror-refinishing-philadelphia-shield-film.jpg" alt="Mirror refinishing film installation on Philadelphia commercial mirror" title="Mirror Shield film — Philadelphia commercial mirror" loading="lazy" />
        <img class="accb__img" data-img data-index="1" src="/images/mirror-film-philadelphia-scratch-protection.jpg" alt="Mirror film protecting Philadelphia commercial mirror from scratch damage" title="Scratch protection mirror film — Philadelphia commercial mirror" loading="lazy" />
        <img class="accb__img" data-img data-index="2" src="/images/mirror-restoration-philadelphia-tarnish-repair.jpg" alt="Mirror restoration film protecting Philadelphia mirror from tarnishing" title="Tarnish protection mirror film — Philadelphia commercial mirror" loading="lazy" />
        <img class="accb__img" data-img data-index="3" src="/images/mirror-refinishing-film-philadelphia-commercial.jpg" alt="Mirror refinishing film protecting Philadelphia commercial mirror long-term" title="Long-term mirror refinishing film — Philadelphia commercial mirror" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- BEFORE/AFTER -->
  <section class="mr-slider-wrap">
    <div class="mr-slider-wrap__header">
      <div class="mr-slider-wrap__eyebrow">THE FILM IN ACTION</div>
      <h2 class="mr-slider-wrap__title">Mirror Refinishing in Action</h2>
      <p class="mr-slider-wrap__sub">Drag the handle to see a damaged Philadelphia commercial mirror restored with Mirror Shield refinishing film — pristine reflection, same mirror.</p>
    </div>
    <div class="mr-slider-wrap__slider">
      <div class="before-after" style="--pos:50%">
        <div class="before-after__frame">
          <img src="/images/philadelphia-mirror-damaged-before-refinishing.jpg" alt="Philadelphia commercial mirror with scratches and tarnishing before mirror refinishing film" title="Philadelphia mirror before refinishing film — scratched and damaged" class="before-after__img before-after__img--before" draggable="false" loading="lazy" />
          <div class="before-after__after-wrap"><img src="/images/mirror-refinishing-philadelphia-after-installation.jpg" alt="Philadelphia commercial mirror restored with mirror refinishing film — pristine clear reflection" title="Philadelphia mirror after refinishing film — Mirror Shield applied" class="before-after__img before-after__img--after" draggable="false" loading="lazy" /></div>
          <span class="before-after__label before-after__label--before">Damaged mirror</span>
          <span class="before-after__label before-after__label--after">Mirror Shield applied</span>
          <div class="before-after__handle" role="slider" tabindex="0" aria-label="Drag to compare damaged and restored Philadelphia commercial mirror" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50"><span class="before-after__handle-grip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M8 7L3 12L8 17M16 7L21 12L16 17" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHERE IT'S USED -->
  <section class="mr-wwd-wrap">
    <div class="mr-wwd-wrap__header">
      <div class="mr-wwd-wrap__eyebrow">WHERE IT'S USED</div>
      <h2 class="mr-wwd-wrap__title">Where Philadelphia Clients Use Mirror Refinishing</h2>
      <p class="mr-wwd-wrap__sub">Mirror Shield film works wherever pristine mirror reflection is required — from high-traffic restrooms to luxury hotel lobbies across Philadelphia.</p>
    </div>
    <div class="mr-wwd-panels">
      <a href="/applications/office/" class="wwd__panel"><div class="wwd__panel-img-wrap"><img src="/images/mirror-refinishing-philadelphia-commercial-restroom.jpg" alt="Mirror refinishing film in Philadelphia commercial restroom" title="Philadelphia mirror refinishing film for commercial restrooms" class="wwd__panel-img" loading="lazy" /></div><div class="wwd__panel-overlay"></div><div class="wwd__panel-content"><h3>Commercial Restrooms</h3><p class="wwd__panel-desc">Philadelphia office tower, hotel, and restaurant restroom mirrors face the highest contact frequency. Mirror Shield film provides continuous protection and same-day restoration after any incident.</p><span class="wwd__panel-arrow">Learn more →</span><span class="wwd__panel-line"></span></div></a>
      <a href="/applications/hotels/" class="wwd__panel"><div class="wwd__panel-img-wrap"><img src="/images/mirror-film-philadelphia-hotel-lobby.jpg" alt="Mirror Shield film on Philadelphia hotel lobby mirror" title="Mirror film for Philadelphia hotel lobby" class="wwd__panel-img" loading="lazy" /></div><div class="wwd__panel-overlay"></div><div class="wwd__panel-content"><h3>Hotel Lobbies</h3><p class="wwd__panel-desc">Hotel lobby and corridor mirrors in Center City and Old City Philadelphia. Pristine mirror condition is non-negotiable for hospitality — refinishing film eliminates costly emergency replacement calls.</p><span class="wwd__panel-arrow">Learn more →</span><span class="wwd__panel-line"></span></div></a>
      <a href="/applications/restaurants/" class="wwd__panel"><div class="wwd__panel-img-wrap"><img src="/images/mirror-restoration-philadelphia-restaurant.jpg" alt="Mirror restoration film in Philadelphia restaurant dining room" title="Mirror restoration film for Philadelphia restaurants" class="wwd__panel-img" loading="lazy" /></div><div class="wwd__panel-overlay"></div><div class="wwd__panel-content"><h3>Restaurants</h3><p class="wwd__panel-desc">Dining room wall mirrors in Fishtown, Old City, and Rittenhouse Square restaurants. Mirror Shield applied proactively prevents the scratching and back-of-chair damage that marks mirrors in active dining rooms.</p><span class="wwd__panel-arrow">Learn more →</span><span class="wwd__panel-line"></span></div></a>
