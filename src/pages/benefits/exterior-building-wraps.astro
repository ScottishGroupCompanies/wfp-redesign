---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Exterior Building Wraps in Philadelphia | Complete Building Transformation';
const description = 'Transform your Philadelphia building exterior with architectural wraps — custom graphics, branding, advertising, and privacy without construction. Removable for lease changes.';

const heroImg = 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181655_9d561f86-1c4d-419b-9758-d65ca4907c5e.png';

const galleryImages = [
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_201132_dfe84e1c-24f7-4116-ad0c-c55fbaadc0e3.png', label: 'Full Building Wrap' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_202130_f73dd42c-c007-4aaa-aebe-a693e81ccf4b.png', label: 'Installation Process' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_202306_68044e57-5950-46b8-aa04-a323ef970a9e.png', label: 'Branded Facade' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181655_9d561f86-1c4d-419b-9758-d65ca4907c5e.png', label: 'Exterior Detail' },
  { src: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_163219_ef8a6773-eb18-43d3-a8cf-305c12c72dd2.png', label: 'Professional Finish' },
];

const newImages = {
  privacy: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170332_7a02abaf-9a99-4d42-b4d6-965dcbfe18ea.png',
  glare: 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_170324_f2fb6bcd-4ac1-4aae-a52b-d57053ccab28.png',
};

const faqItems = [
  { question: 'How long do exterior building wraps last?', answer: 'High-quality cast vinyl wraps from manufacturers like 3M and Avery Dennison are rated for 7–12 years of exterior exposure. UV-resistant overlaminates protect printed graphics from fading. Actual lifespan depends on climate exposure and installation quality — our team surveys every surface before installation.' },
  { question: 'Can wraps be removed without damaging the building?', answer: 'Yes. Building wraps are specifically designed to be removable. Professional removal involves heat and careful peeling by trained installers. The underlying surface must be assessed for adhesion compatibility before installation — not all surfaces are equally suitable, which is why we conduct a thorough survey before every project.' },
  { question: 'How weather-resistant are exterior wraps?', answer: 'Exterior building wraps are engineered for outdoor durability — they withstand rain, wind, UV exposure, and temperature extremes. Premium films include UV-stable pigments and protective overlaminates. In severe weather events, wraps can sustain damage like any exterior surface, but they also protect the underlying facade from weathering.' },
  { question: "What's the installation timeline for a full building wrap?", answer: 'A typical commercial building wrap installation takes 3–7 days depending on building size, surface complexity, and graphic scope. Our team works efficiently section by section, and unlike construction, there is no drying time or weather dependency — the building remains operational throughout the process.' },
  { question: 'Do exterior wraps affect building inspections or permits?', answer: 'Building wraps are generally non-structural and do not alter the building\'s footprint or use, so they typically do not require the same permits as construction. However, local regulations vary by municipality within the Philadelphia region. We advise on permit requirements during the site survey and help navigate any local requirements.' },
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Exterior Building Wraps"
  serviceDesc="Complete building exterior transformation with architectural wraps — bold branding, advertising, and privacy without construction. Fully removable."
  serviceUrl="https://www.windowfilmphiladelphia.com/benefits/exterior-building-wraps"
  faqItems={faqItems}
>
  <!-- HERO -->
  <section class="swt-hero">
    <div class="swt-hero__img">
      <img src={heroImg} alt="Exterior building wrap transformation for Philadelphia commercial property" width="1440" height="700" />
      <div class="swt-hero__overlay"></div>
    </div>
    <div class="swt-hero__content">
      <span class="swt-badge">
        <svg width="8" height="8" viewBox="0 0 8 8" fill="none"><circle cx="4" cy="4" r="4" fill="#4E6B2A"/></svg>
        Exterior Building Wraps
      </span>
      <h1 class="swt-hero__title">
        Your Building.<br/>
        <em>Completely</em><br/>
        Transformed.
      </h1>
      <p class="swt-hero__sub">Bold full-building transformations — custom graphics, brand advertising, and privacy — without construction, scaffolding, or months of downtime. Removable when your brand evolves.</p>
      <div class="swt-hero__ctas">
        <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Consultation</a>
        <a href="#benefits" class="swt-btn swt-btn--ghost-light">See Benefits</a>
      </div>
    </div>
  </section>

  <div class="swt-body">

    <!-- TRUST BAR -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by leading Philadelphia businesses</p>
        <BrandLogos />
      </div>
    </section>

    <!-- SECTION 1: TRANSFORMATION — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="problem">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow swt-eyebrow--green">Exterior Building Wraps</span>
            <h2 class="swt-h2 swt-h2--light">Complete Building Transformation Without Construction</h2>
            <p>Your building's exterior is your most visible asset — and sometimes it needs a transformation that traditional construction cannot deliver quickly or affordably. Exterior building wraps let you completely reimagine your building's appearance — bold brand graphics, architectural updates, or concealing aging facades — without scaffolding, downtime, or months of renovation.</p>
            <p>The result is dramatic, professional, and fully reversible. When your brand evolves, the wrap evolves with you.</p>
            <div class="swt-problem-tags">
              <span class="swt-tag swt-tag--green">Zero Construction</span>
              <span class="swt-tag swt-tag--green">Fully Removable</span>
              <span class="swt-tag swt-tag--green">Photographic Quality</span>
              <span class="swt-tag swt-tag--green">Fast Installation</span>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={newImages.glare} alt="Philadelphia commercial building before and after exterior wrap" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: CUSTOM GRAPHICS — white bg, image left, text right -->
    <section class="swt-split" id="graphics">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={galleryImages[0].src} alt="Custom graphics and branding on building exterior wrap" loading="lazy" />
            <div class="swt-img-badge">
              <strong>100%</strong>
              <span>Custom Graphics</span>
            </div>
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 01</span>
            <h2 class="swt-h2">Custom Graphics and Branding at Full-Building Scale</h2>
            <p>Paint is limited by what a brush can achieve. Building wraps deliver photographic-quality imagery and unlimited color at architectural scale — transforming your entire facade into a living brand statement. No limitations, no compromise.</p>
            <p>From franchise rebrands to landmark building transformations, our large-format digital printing produces colors and imagery that remain vivid for years under UV-stable overlaminates.</p>
            <ul class="swt-check-list">
              <li>Full-color photographic-quality output at building scale</li>
              <li>Unlimited design flexibility — gradients, photography, bold graphics</li>
              <li>UV-stable inks and overlaminates for long-lasting color fidelity</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: ADVERTISING — alt cream bg, text left, image right -->
    <section class="swt-split swt-split--alt" id="advertising">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 02</span>
            <h2 class="swt-h2">Turn Your Building Exterior Into High-Visibility Advertising</h2>
            <p>Your building is the largest piece of real estate your brand controls. Exterior building wraps convert that asset into premium advertising space — visible to every person who passes by, 24 hours a day, 365 days a year.</p>
            <p>Unlike billboards or digital ads, your building wrap works for your brand continuously, with no recurring media costs. For franchise operators, retail chains, and multi-location businesses, consistency of brand presence across locations is built into the material specification.</p>
            <div class="swt-energy-metrics">
              <div class="swt-metric">
                <span class="swt-metric__num">24/7</span>
                <span class="swt-metric__label">Passive Brand Exposure</span>
              </div>
              <div class="swt-metric">
                <span class="swt-metric__num">0</span>
                <span class="swt-metric__label">Recurring Media Costs</span>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={galleryImages[1].src} alt="Philadelphia building exterior wrap serving as advertising billboard" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: PRIVACY — white bg, image left, text right -->
    <section class="swt-split" id="privacy">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={newImages.privacy} alt="Building exterior wrap providing privacy while maintaining natural light" loading="lazy" />
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 03</span>
            <h2 class="swt-h2">Privacy for Ground-Floor Tenants Without Blocking Natural Light</h2>
            <p>For ground-floor retail, medical offices, and mixed-use buildings, street-level visibility creates genuine privacy concerns. Frosted and tinted exterior wraps solve this — providing privacy from passersby while preserving abundant natural light inside.</p>
            <p>This is a critical advantage over window shades or tinted glass: the exterior wrap creates the privacy barrier on the outside of the building, meaning interior spaces stay bright and welcoming while remaining concealed from the street.</p>
            <blockquote class="swt-inline-quote">
              "The frosted wrap on our ground-floor offices gives us complete privacy during consultations — yet the space feels completely open and bright."
              <cite>— Practice Manager, medical office, Center City Philadelphia</cite>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: REMOVABLE — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="removable">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow swt-eyebrow--green">Benefit 04</span>
            <h2 class="swt-h2 swt-h2--light">Removable for Lease Changes or Brand Rebranding</h2>
            <p>Unlike paint, which is permanent, building wraps are a reversible investment. This matters enormously for leased spaces, franchise locations, and any building where the brand or tenant may change within a decade.</p>
            <p>Professional removal involves heat application and careful peeling — the building returns to its original surface. There is no sanding, no repainting, no restoration cost at the end of the wrap's life. For property owners, this means the building's appearance is an asset that can evolve rather than a permanent commitment.</p>
            <div class="swt-security-features">
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Lease-Friendly</strong>
                  <p>Restore original facade when tenants leave — no restoration cost</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Rebrand-Ready</strong>
                  <p>Change your building's look as often as your brand evolves</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Surface Protected</strong>
                  <p>Wrap also shields the underlying facade from weathering</p>
                </div>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={galleryImages[2].src} alt="Building wrap being professionally removed during rebranding" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY — 5 images -->
    <section class="swt-gallery" id="gallery">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">Our Work</span>
          <h2 class="swt-h2 swt-h2--center">Building Wraps — In Action</h2>
          <p class="swt-subhead">From storefronts to multi-story commercial buildings — here's what we install.</p>
        </div>
        <div class="swt-gallery__grid">
          {galleryImages.map((img, i) => (
            <div class="swt-gallery__item fade-in" style={`--delay: ${i * 80}ms`}>
              <img src={img.src} alt={img.label} loading="lazy" />
              <div class="swt-gallery__overlay">
                <span>{img.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STATS BAR — accent green -->
    <section class="swt-stats">
      <div class="container">
        <div class="swt-stats__row">
          <div class="swt-stats__item fade-in">
            <span class="swt-stats__num">7–12yr</span>
            <span class="swt-stats__label">Wrap Lifespan</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 80ms">
            <span class="swt-stats__num">100%</span>
            <span class="swt-stats__label">Custom Graphics</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 160ms">
            <span class="swt-stats__num">3–7</span>
            <span class="swt-stats__label">Day Installation</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 240ms">
            <span class="swt-stats__num">0</span>
            <span class="swt-stats__label">Construction Required</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS — 3 steps -->
    <section class="swt-process">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">How It Works</span>
          <h2 class="swt-h2 swt-h2--center">3 Simple Steps to a Transformed Building</h2>
        </div>
        <div class="swt-process__steps">
          <div class="swt-process__step fade-in">
            <div class="swt-process__num">01</div>
            <div class="swt-process__body">
              <h3>Free Site Survey & Design Consultation</h3>
              <p>We assess your building surface, discuss design goals, and review material options. You receive a detailed proposal with graphic mockups and exact specifications within 48 hours. No obligation.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 80ms">
            <div class="swt-process__num">02</div>
            <div class="swt-process__body">
              <h3>Custom Print & Professional Installation in 3–7 Days</h3>
              <p>Your graphics are printed at full-building scale with UV-stable inks. Our factory-trained installers apply the wrap section by section, ensuring seamless alignment across complex architectural surfaces. The building stays fully operational.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 160ms">
            <div class="swt-process__num">03</div>
            <div class="swt-process__body">
              <h3>Final Inspection & Long-Term Warranty</h3>
              <p>We walk the completed installation with you before considering the job done. Every wrap is backed by our labor warranty and the manufacturer's material warranty — typically 7–12 years on exterior-grade films.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS — dark bg -->
    <section class="swt-testimonials">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow swt-eyebrow--green">Client Stories</span>
          <h2 class="swt-h2 swt-h2--center swt-h2--light">Real Results from Real Buildings</h2>
        </div>
        <div class="swt-testimonials__grid">
          <div class="swt-testimonial fade-in">
            <div class="swt-testimonial__quote">"</div>
            <p>We rebranded three franchise locations in a single month — building wraps let us do it without closing a single store. The quality of the print and the installation was indistinguishable from paint at half the cost and a fraction of the time.</p>
            <div class="swt-testimonial__author">
              <strong>Marcus J.</strong>
              <span>Franchise Director, regional retail chain</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 80ms">
            <div class="swt-testimonial__quote">"</div>
            <p>Our dated 1980s brick facade was an embarrassment. We couldn't afford a full renovation. The building wrap transformed the entire look — it looks like a modern new construction building now. Our tenant inquiries doubled immediately.</p>
            <div class="swt-testimonial__author">
              <strong>Linda P.</strong>
              <span>Property Owner, Old City Philadelphia</span>
            </div>
          </div>
          <div class="swt-testimonial fade-in" style="--delay: 160ms">
            <div class="swt-testimonial__quote">"</div>
            <p>For a medical practice on a busy street, privacy is a clinical requirement, not a preference. The frosted exterior wrap gives us exactly that — complete privacy from sidewalk foot traffic while the interior stays flooded with natural light.</p>
            <div class="swt-testimonial__author">
              <strong>Dr. Rajesh M.</strong>
              <span>Medical Director, outpatient clinic, University City</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="swt-faq" id="faq">
      <div class="container">
        <div class="swt-faq__layout">
          <div class="swt-faq__header fade-in">
            <span class="swt-eyebrow">Questions</span>
            <h2 class="swt-h2">Frequently Asked Questions</h2>
            <p>Honest answers from people who've been installing building wraps across the Philadelphia region for over 16 years.</p>
            <a href="/contact/" class="swt-btn swt-btn--primary">Talk to a Specialist</a>
          </div>
          <div class="swt-faq__list fade-in">
            {faqItems.map((item) => (
              <div class="swt-faq__item">
                <div class="swt-faq__q">
                  <span>{item.question}</span>
                  <span class="swt-faq__toggle">+</span>
                </div>
                <div class="swt-faq__a">
                  <p>{item.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA BANNER -->
    <section class="swt-cta">
      <div class="swt-cta__inner">
        <div class="swt-cta__text">
          <h2>Ready to <em>transform</em> your building?</h2>
          <p>Get a free consultation and site survey. No obligation, no pressure — just honest advice.</p>
        </div>
        <div class="swt-cta__btns">
          <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Quote</a>
          <a href="tel:+126****7980" class="swt-btn swt-btn--ghost-light">Call (267) 394-7980</a>
        </div>
      </div>
    </section>

  </div><!-- /swt-body -->
</BaseLayout>

<style>
  /* ══════════════════════════════════════
     BRAND TOKENS
     ══════════════════════════════════════ */
  :root {
    --swt-green:        #4E6B2A;
    --swt-green-accent: #83A94A;
    --swt-dark:         #2A241E;
    --swt-cream:        #F4EFE6;
    --swt-alt:          #ECE4D4;
    --swt-border:       #E1D6C1;
    --swt-text-sec:     #6E665C;
    --swt-white:        #ffffff;
    --swt-radius:       5px;
  }

  /* ══════════════════════════════════════
     HERO
     ══════════════════════════════════════ */
  .swt-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .swt-hero__img {
    position: absolute;
    inset: 0;
  }
  .swt-hero__img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .swt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(42,36,30,0.9) 0%, rgba(42,36,30,0.6) 50%, rgba(42,36,30,0.35) 100%);
  }
  .swt-hero__content {
    position: relative;
    z-index: 1;
    padding: 110px 8% 90px;
    max-width: 720px;
  }
  .swt-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
    background: rgba(78,107,42,0.25);
    color: rgba(255,255,255,0.75);
    border: 1px solid rgba(78,107,42,0.4);
  }
  .swt-hero__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(38px, 5.5vw, 66px);
    font-weight: 400;
    color: var(--swt-white);
    line-height: 1.1;
    margin: 0 0 20px;
  }
  .swt-hero__title em {
    font-style: italic;
    color: var(--swt-green-accent);
  }
  .swt-hero__sub {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 17px;
    color: rgba(255,255,255,0.65);
    line-height: 1.7;
    margin: 0 0 36px;
    max-width: 500px;
  }
  .swt-hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ══════════════════════════════════════
     BUTTONS
     ══════════════════════════════════════ */
  .swt-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .swt-btn--primary {
    background: var(--swt-green);
    color: var(--swt-white);
    border-color: var(--swt-green);
  }
  .swt-btn--primary:hover {
    background: #3D5620;
    border-color: #3D5620;
    transform: translateY(-2px);
  }
  .swt-btn--ghost-light {
    background: transparent;
    color: rgba(255,255,255,0.8);
    border-color: rgba(255,255,255,0.35);
  }
  .swt-btn--ghost-light:hover {
    color: #fff;
    border-color: rgba(255,255,255,0.65);
    background: rgba(255,255,255,0.06);
    transform: translateY(-2px);
  }

  /* ══════════════════════════════════════
     SHARED
     ══════════════════════════════════════ */
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 5%;
  }
  .swt-body { background: var(--swt-white); }

  .swt-eyebrow {
    display: inline-block;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--swt-green);
    margin-bottom: 12px;
  }
  .swt-eyebrow--green { color: var(--swt-green-accent); }

  .swt-h2 {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(26px, 3vw, 40px);
