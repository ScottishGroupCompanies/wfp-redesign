---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import CategoryBlogFeed from '../../components/CategoryBlogFeed.astro';

const title = 'Exterior Building Wraps in Philadelphia | Vinyl Wraps';
const description = 'Exterior building wraps in Philadelphia. Transform your building facade with custom vinyl wraps — branding, advertising, and privacy. Removable.';

const faqItems = [
  { question: 'What is an exterior building wrap?', answer: 'An exterior building wrap is a large-format vinyl graphic applied to the exterior surface of a building — typically the glass facade, spandrel panels, or architectural cladding. The vinyl is printed with custom graphics, branding, advertising, or privacy treatments and adheres directly to the exterior surface. Building wraps transform the visual identity of a structure without painting, construction, or permanent alteration.' },
  { question: 'Will the wrap damage my building glass or facade?', answer: 'Exterior building wraps use pressure-sensitive vinyl adhesives engineered for clean removal without damaging the underlying glass or facade surface. When installed and removed by experienced professionals, the glass returns to its original condition. The vinyl selection matters — we specify appropriate outdoor-grade materials rated for the specific substrate and exposure conditions of your Philadelphia building.' },
  { question: 'How long does an exterior building wrap last?', answer: 'Outdoor-grade vinyl building wraps are typically rated for 3–7 years depending on the material specification, print quality, building orientation, and sun exposure. Philadelphia buildings with direct south or west exposure may see faster fade on lower-grade materials. We specify wrap materials appropriate for your building orientation and desired campaign duration.' },
  { question: 'Can building wraps be used on buildings under construction?', answer: 'Yes. Construction hoarding wraps are one of the most common applications in Philadelphia. Plywood hoarding panels around active construction sites can be covered with full-color vinyl wraps — turning site barriers into brand statements, advertising, or community messaging. The wrap generates awareness for the completed building or tenant while the site is active.' },
  { question: 'Is a building wrap removable at the end of a lease or campaign?', answer: 'Yes. This is one of the key advantages of removable vinyl wraps for Philadelphia commercial tenants. Unlike paint or architectural modifications, vinyl wraps are removed cleanly at campaign end, lease termination, or rebrand. The glass or facade returns to its original appearance. Many Philadelphia retail tenants use seasonal or promotional wraps on a rotating basis.' },
  { question: 'Can a building wrap provide privacy as well as branding?', answer: 'Yes. Exterior building wraps can incorporate opaque or perforated vinyl that provides interior privacy while displaying an outward-facing graphic. Perforated one-way vision vinyl allows occupants to see out while displaying a full-coverage printed graphic to the street. This is popular for Philadelphia retail ground floors, hotel lobbies, and co-working spaces.' },
  { question: 'What is perforated one-way vision vinyl?', answer: 'Perforated one-way vision vinyl is a printed exterior wrap material with a micro-perforated pattern — typically 50% open area. From the outside, the graphic reads as a solid printed image. From the inside, the perforations allow occupants to see through the material in a manner similar to looking through a screen. It is commonly used on Philadelphia retail storefronts and ground-floor office glass where exterior privacy and interior visibility are both required.' },
  { question: 'What is the design process for an exterior building wrap?', answer: 'We begin with a site assessment to measure the building facade, evaluate the substrate, and identify any access considerations. We then develop a design scaled to the exact dimensions of your building. Once approved, we print on specification vinyl and schedule installation. For multi-story buildings, we coordinate lift access and sequencing to minimize disruption.' },
  { question: 'Which Philadelphia buildings use exterior wraps most?', answer: 'The most common exterior building wrap applications in Philadelphia include retail storefronts on Walnut Street, Chestnut Street, and South Street for seasonal and promotional campaigns, office towers in Center City and University City for tenant rebranding and major lease announcements, construction hoarding on Old City, Northern Liberties, and Fishtown development sites, hotel exterior facades in Center City for grand openings and rebrands, and advertising-facing building sides with high pedestrian or vehicular traffic.' },
  { question: 'How do I get an exterior building wrap installed in Philadelphia?', answer: 'Contact us for a free site assessment. We evaluate your building facade, substrate, access requirements, and design goals. We provide a transparent quote covering materials, printing, and installation. For time-sensitive campaigns we offer expedited scheduling. Our team handles all aspects from design approval through installation and removal.' }
];

const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Benefits", "item": "https://www.windowfilmphiladelphia.net/benefits/" },
      { "@type": "ListItem", "position": 3, "name": "Exterior Building Wraps", "item": "https://www.windowfilmphiladelphia.net/benefits/exterior-building-wraps/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.windowfilmphiladelphia.net/benefits/exterior-building-wraps/",
    "name": title,
    "description": description,
    "dateModified": new Date().toISOString().slice(0, 10),
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".ex-hero__title", ".ex-hero__subtitle", ".faq__a-inner"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Exterior Building Wrap Applications",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Office Tower Facades" },
      { "@type": "ListItem", "position": 2, "name": "Retail Storefronts" },
      { "@type": "ListItem", "position": 3, "name": "Construction Hoarding" },
      { "@type": "ListItem", "position": 4, "name": "Hotel Exteriors" },
      { "@type": "ListItem", "position": 5, "name": "Advertising & Promotional Campaigns" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Exterior Building Wraps Philadelphia",
    "description": "Custom vinyl exterior building wraps for Philadelphia office towers, retail storefronts, construction hoarding, and hotels. Full-coverage branding, advertising, and privacy wraps — removable without building damage.",
    "brand": { "@type": "Brand", "name": "Window Film Philadelphia" },
    "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "areaServed": "Philadelphia, PA" },
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "58", "bestRating": "5" },
    "review": [
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Kevin T." }, "reviewBody": "We wrapped our Center City building exterior for a major tenant rebrand. The finished product looked incredible — full-coverage graphic on the glass facade. Install was fast and there was no disruption to tenants." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Rachel B." }, "reviewBody": "Our Walnut Street retail storefront wrap for the spring campaign generated more foot traffic than anything we have done before. The graphic quality was outstanding and removal at campaign end was clean." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Daniel M." }, "reviewBody": "Construction hoarding wrap on our Old City development site turned an eyesore into a brand statement. The wrap held up through a full Philadelphia winter without peeling or fading. Excellent work." }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Exterior Building Wraps"
  serviceDesc="Custom exterior building wraps in Philadelphia for building-scale branding, advertising, privacy, and temporary campaign graphics."
  serviceUrl="https://www.windowfilmphiladelphia.net/benefits/exterior-building-wraps/"
  faqItems={faqItems}
  schemas={pageSchemas}
>

  <!-- ══ HERO — Hero Subpage (library component) ══ -->
  <section class="hs">
    <img src="/images/exterior-building-wraps-window-film-philadelphia-hero.jpg"
         alt="Exterior building wrap installed on Philadelphia commercial building facade — full vinyl graphic coverage"
         title="Exterior building wraps Philadelphia — full facade vinyl graphic"
         class="hs__bg" loading="eager" />
    <div class="hs__overlay" aria-hidden="true"></div>
    <div class="hs__inner">
      <p class="hs__eyebrow">
        <span class="hs__dot" aria-hidden="true"></span>
        Philadelphia Building Transformation
      </p>
      <h1 class="hs__title ex-hero__title">Exterior Building Wraps in Philadelphia</h1>
      <p class="hs__sub ex-hero__subtitle">Transform your Philadelphia building facade with custom vinyl wraps — full-coverage branding, advertising, and privacy graphics applied without construction, removable without damage.</p>
      <div class="hs__cta">
        <a href="/contact/" class="hs__btn-primary">Get a Free Assessment</a>
        <a href="/benefits/" class="hs__btn-secondary">All Benefits</a>
      </div>
    </div>
  </section>

  <!-- ══ TRUST BAR ══ -->
  <section class="swt-trust">
    <div class="container">
      <p class="swt-trust__label">Trusted by Philadelphia building owners, retail brands, developers, and advertising agencies.</p>
      <BrandLogos />
    </div>
  </section>

  <!-- ══ THE OPPORTUNITY — Accordion Vertical ══ -->
  <section class="ex-accv-wrap">
    <div class="ex-accv-wrap__header">
      <div class="ex-accv-wrap__eyebrow">THE OPPORTUNITY</div>
      <h2 class="ex-accv-wrap__title split-reveal" data-stagger="65" aria-label="Philadelphia Buildings Are Missing a Canvas"><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:0">Philadelphia&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:1">Buildings&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:2">Are&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:3">Missing&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:4">a&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:5">Canvas</span></span></h2>
      <p class="ex-accv-wrap__sub">Building wrap in Philadelphia turns plain glass facades into revenue-generating, brand-reinforcing, privacy-providing surfaces — without a single structural change.</p>
    </div>
    <div class="accv">
      <div class="accv__panel is-open" data-panel style="background-image:url('/images/exterior-building-wraps-window-film-philadelphia-full-facade.jpg')">
        <button class="accv__tab" data-tab aria-expanded="true">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </span>
          <span class="accv__title">Branding</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Exterior Branding That Changes Everything</h3>
            <p>A Philadelphia commercial building's glass facade is one of its most visible marketing assets — most owners leave it completely blank. Full-coverage vinyl building wraps transform glass curtain walls into large-format brand statements visible to thousands of pedestrians and commuters daily. According to the <a href="https://www.signs.org/about/" target="_blank" rel="noopener">International Sign Association (ISA)</a>, large-format exterior graphics and building-level signage consistently rank among the highest-impact brand investments for commercial real estate — transforming anonymous facades into recognizable brand statements visible to thousands of daily commuters and pedestrians.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/building-wrap-window-film-philadelphia-advertising-graphics.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="18" rx="1"/><path d="M8 21V3M16 21V3"/></svg>
          </span>
          <span class="accv__title">Advertising</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Monetize Your Building Exterior</h3>
            <p>Philadelphia building owners with high-visibility facades — particularly those facing pedestrian corridors, transit stops, or major intersections — can generate advertising revenue from their exterior glass. Full-coverage vinyl wrap campaigns are sold to advertisers for 3–12 month runs. The wrap installs without structural modifications and removes cleanly, returning the facade to its original appearance.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/building-wrap-window-film-philadelphia-privacy-screen.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="12" cy="12" r="4"/></svg>
          </span>
          <span class="accv__title">Privacy &amp; Screening</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Exterior Privacy Without Permanent Tinting</h3>
            <p>Ground-floor and mezzanine glass in Philadelphia office buildings and co-working spaces creates privacy challenges for occupants near street level. Opaque or perforated one-way vision exterior wrap provides privacy from the street while maintaining outward visibility for occupants. Unlike permanently tinted or frosted glass, the wrap can be updated or removed as occupancy or leasing needs change.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ WRAP OPTIONS — Bento Photo Grid ══ -->
  <section class="bgp ex-film-bento">
    <div class="bgp__head">
      <div class="bgp__eyebrow">THE WRAP OPTIONS</div>
      <h2 class="bgp__title">Does every building have a wrap option?</h2>
      <p class="bgp__sub">For exterior building wraps in Philadelphia, full-coverage branding, perforated one-way vision, opaque privacy, and temporary promotional wraps are a family of graphic solutions.</p>
    </div>
    <div class="bgp__grid">
      <div class="bgp__card bgp__card--lg">
        <img src="/images/exterior-building-wraps-window-film-philadelphia-full-facade.jpg" alt="Full coverage exterior building wrap on Philadelphia office building facade" title="Full coverage exterior building wrap — Philadelphia" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Full-Coverage Branding Wraps</h3>
          <p>Floor-to-ceiling vinyl graphic coverage on Philadelphia glass curtain walls. Custom printed to exact building dimensions. Ideal for tenant rebrands, major lease announcements, and landmark building transformations.</p>
        </div>
      </div>
      <div class="bgp__card bgp__card--sm">
        <img src="/images/vinyl-building-wraps-window-film-philadelphia-retail.jpg" alt="Vinyl building wrap on Philadelphia retail storefront exterior" title="Vinyl building wrap — Philadelphia retail storefront" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Retail &amp; Promotional Wraps</h3>
          <p>Seasonal and campaign-length wraps for Philadelphia retail storefronts. Walnut Street, Chestnut Street, and South Street retail. Full-color print, clean removal, update for each season.</p>
        </div>
      </div>
      <div class="bgp__card bgp__card--sm">
        <img src="/images/building-wrap-window-film-philadelphia-advertising-graphics.jpg" alt="Advertising building wrap on Philadelphia commercial building" title="Advertising building wrap — Philadelphia commercial" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Advertising Wraps</h3>
          <p>Revenue-generating advertising wraps on high-visibility Philadelphia building facades. 3–12 month campaign runs on glass curtain walls facing major pedestrian corridors and transit stops.</p>
        </div>
      </div>
      <div class="bgp__card bgp__card--md">
        <img src="/images/exterior-wrap-window-film-philadelphia-commercial.jpg" alt="Perforated one-way vision exterior wrap on Philadelphia commercial building" title="One-way vision exterior wrap — Philadelphia commercial" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Perforated One-Way Vision</h3>
          <p>Full-coverage exterior graphic from the outside; occupants see through from the inside. Standard perforation ratios of 50/50 or 60/40 solid-to-open. Ideal for Philadelphia retail ground floors and hotel facades.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ HOW WRAPS WORK — Accordion Benefits (4 rows) ══ -->
  <section class="accb">
    <div class="accb__head">
      <h2 class="accb__title">What Philadelphia Exterior Wraps Can Do for You</h2>
      <p class="accb__sub">For exterior building wraps in Philadelphia, each exterior wrap type addresses a different goal — branding, advertising, privacy, or temporary campaigns.</p>
    </div>
    <div class="accb__wrap">
      <div class="accb__list">
        <div class="accb__row is-open" data-row data-index="0">
          <button class="accb__trigger" data-trigger aria-expanded="true">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></span>
            <span class="accb__row-title">Full-Coverage Branding Wraps — Building-Scale Brand Identity</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Vinyl building wraps for Philadelphia office towers, hotels, and retail buildings are printed on outdoor-rated cast vinyl films rated for 5–7 years of exterior exposure. Material specification matters for Philadelphia's climate — freeze-thaw cycles, humidity, and UV load from south-facing glass require vinyl and adhesive systems engineered for four-season outdoor performance. Cast vinyl, not calendered vinyl, is selected for dimensional stability on curved or irregular surfaces. All wrap installations include a site-specific substrate assessment before material selection for <a href="/applications/office/">Center City office buildings</a> and <a href="/applications/retail/">Philadelphia retail storefronts</a>.</p>
              <img class="accb__mobile-img" src="/images/exterior-building-wraps-window-film-philadelphia-installation.jpg" alt="Exterior building wrap installation on Philadelphia commercial building" title="Exterior building wrap installation — Philadelphia" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="1">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="18" rx="1"/><path d="M8 21V3M16 21V3"/></svg></span>
            <span class="accb__row-title">Perforated One-Way Vision — See Out, Brand Out</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Perforated vinyl allows a full-coverage graphic to display on the exterior of Philadelphia buildings while occupants maintain outward visibility through the micro-perforated surface. Standard formats are 50% perforation (50% open, 50% ink-covered) or 60/40 variants depending on desired opacity and visibility balance. This is the preferred format for <a href="/applications/retail/">Philadelphia retail ground floors</a> on Walnut Street and Chestnut Street, where exterior branding and interior daylight are both priorities.</p>
              <img class="accb__mobile-img" src="/images/vinyl-wrap-window-film-philadelphia-building-branding.jpg" alt="Vinyl building wrap with one-way vision perforations on Philadelphia building" title="One-way vision vinyl wrap — Philadelphia building" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="2">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="12" cy="12" r="4"/></svg></span>
            <span class="accb__row-title">Construction Hoarding Wraps — Turn the Site Into a Statement</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Active construction sites in Old City, Northern Liberties, Fishtown, and Center City Philadelphia generate significant pedestrian exposure for the projects behind them. Hoarding wrap transforms raw plywood barriers into branded marketing for the future building — communicating the project name, timeline, developer brand, and key tenants to the neighborhood before construction completes. Printed on outdoor-grade vinyl panels, hoarding wraps hold up through Philadelphia winters and are removed cleanly when the site opens near <a href="/applications/mass-transit/">high-traffic transit corridors</a>.</p>
              <img class="accb__mobile-img" src="/images/building-wrap-window-film-philadelphia-construction-hoarding.jpg" alt="Construction hoarding building wrap on Philadelphia development site" title="Construction hoarding wrap — Philadelphia development" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="3">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
            <span class="accb__row-title">Removable Campaign Wraps — Update Your Building for Each Season</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Philadelphia retail brands and hospitality operators use seasonal exterior building wraps to refresh their street presence for major campaigns — holiday promotions, new collection launches, grand openings, and local events. The wrap installs efficiently for most ground-floor retail applications and removes cleanly without glass damage. For multi-story buildings on high-traffic corridors, campaign wraps generate exposure-per-dollar that few other media formats can match.</p>
              <img class="accb__mobile-img" src="/images/exterior-wrap-window-film-philadelphia-temporary-graphics.jpg" alt="Temporary campaign building wrap on Philadelphia retail storefront" title="Temporary campaign wrap — Philadelphia retail" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
      <div class="accb__media">
        <img class="accb__img is-active" data-img data-index="0" src="/images/exterior-building-wraps-window-film-philadelphia-installation.jpg" alt="Exterior building wrap installation on Philadelphia commercial building" title="Exterior building wrap installation — Philadelphia" loading="lazy" />
        <img class="accb__img" data-img data-index="1" src="/images/vinyl-wrap-window-film-philadelphia-building-branding.jpg" alt="Vinyl building wrap with one-way vision perforations on Philadelphia building" title="One-way vision vinyl wrap — Philadelphia building" loading="lazy" />
        <img class="accb__img" data-img data-index="2" src="/images/building-wrap-window-film-philadelphia-construction-hoarding.jpg" alt="Construction hoarding building wrap on Philadelphia development site" title="Construction hoarding wrap — Philadelphia development" loading="lazy" />
        <img class="accb__img" data-img data-index="3" src="/images/exterior-wrap-window-film-philadelphia-temporary-graphics.jpg" alt="Temporary campaign building wrap on Philadelphia retail storefront" title="Temporary campaign wrap — Philadelphia retail" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ══ BEFORE/AFTER SLIDER — Exterior Wrap in Action ══ -->
  <section class="ex-slider-wrap">
    <div class="ex-slider-wrap__header">
      <div class="ex-slider-wrap__eyebrow">THE WRAP IN ACTION</div>
      <h2 class="ex-slider-wrap__title">Exterior Building Wrap in Action</h2>
      <p class="ex-slider-wrap__sub">Drag the handle to see a plain Philadelphia commercial building facade transformed with a full-coverage vinyl exterior wrap.</p>
    </div>
    <div class="ex-slider-wrap__slider">
      <div class="before-after" style="--pos:50%">
        <div class="before-after__frame">
          <img src="/images/philadelphia-building-exterior-window-film-before-wrap.jpg" alt="Plain untreated Philadelphia commercial building facade before exterior wrap installation" title="Philadelphia building before exterior building wrap" class="before-after__img before-after__img--before" draggable="false" loading="lazy" />
          <div class="before-after__after-wrap">
            <img src="/images/exterior-building-wraps-window-film-philadelphia-after-installation.jpg" alt="Same Philadelphia commercial building after full-coverage exterior vinyl building wrap installation" title="Philadelphia building after exterior building wrap installation" class="before-after__img before-after__img--after" draggable="false" loading="lazy" />
          </div>
          <span class="before-after__tag before-after__tag--before">Plain facade</span>
          <span class="before-after__tag before-after__tag--after">Building wrap applied</span>
          <div class="before-after__handle" role="slider" tabindex="0" aria-label="Drag to compare plain and wrapped Philadelphia building facade" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
            <span class="before-after__handle-grip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M8 7L3 12L8 17M16 7L21 12L16 17" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ WHERE IT'S USED — What We Do Panels ══ -->
  <section class="ex-wwd-wrap">
    <div class="ex-wwd-wrap__header">
      <div class="ex-wwd-wrap__eyebrow">WHERE IT'S USED</div>
      <h2 class="ex-wwd-wrap__title">Philadelphia Buildings We Transform</h2>
      <p class="ex-wwd-wrap__sub">Exterior building wraps in Philadelphia work on any building with sufficient exterior glass, panel, or hoarding surface — commercial, retail, hospitality, or under construction.</p>
    </div>
    <div class="ex-wwd-panels">
