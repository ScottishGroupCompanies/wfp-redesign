<script>
  // ── Reviews carousel ──────────────────────────────────────
  (function () {
    const track = document.getElementById('grReviewsTrack');
    const dotsEl = document.getElementById('grReviewsDots');
    if (!track) return;
    const cards = Array.from(track.querySelectorAll('.es-reviews__card'));
    if (cards.length === 0) return;
    let current = 0;
    const dots = cards.map((_, i) => {
      const d = document.createElement('button');
      d.className = 'es-reviews__dot' + (i === 0 ? ' is-active' : '');
      d.setAttribute('aria-label', `Review ${i + 1}`);
      d.addEventListener('click', () => go(i));
      dotsEl?.appendChild(d);
      return d;
    });
    function go(idx) {
      const w = cards[0].offsetWidth + 24;
      track.scrollTo({ left: idx * w, behavior: 'smooth' });
      dots[current]?.classList.remove('is-active');
      current = idx;
      dots[current]?.classList.add('is-active');
    }
    setInterval(() => go((current + 1) % cards.length), 5000);
  })();

  // ── FAQ accordion ──────────────────────────────────────────
  (function () {
    document.querySelectorAll('.swt-faq__item').forEach((item) => {
      const q = item.querySelector('.swt-faq__q');
      const a = item.querySelector('.swt-faq__a') as HTMLElement | null;
      const toggle = item.querySelector('.swt-faq__toggle');
      if (!q || !a) return;
      a.style.maxHeight = '0';
      a.style.overflow = 'hidden';
      a.style.transition = 'max-height 0.35s ease';
      q.addEventListener('click', () => {
        const open = a.style.maxHeight !== '0px' && a.style.maxHeight !== '';
        document.querySelectorAll('.swt-faq__a').forEach((el) => {
          (el as HTMLElement).style.maxHeight = '0';
        });
        document.querySelectorAll('.swt-faq__toggle').forEach((t) => (t.textContent = '+'));
        if (!open) {
          a.style.maxHeight = a.scrollHeight + 'px';
          if (toggle) toggle.textContent = '-';
        }
      });
    });
  })();

  // ── Process accordion ──────────────────────────────────────
  (function () {
    document.querySelectorAll('.es-accordion__item').forEach((item) => {
      const summary = item.querySelector('.es-accordion__trigger') as HTMLElement | null;
      const body = item.querySelector('.es-accordion__body') as HTMLElement | null;
      const icon = item.querySelector('.es-accordion__icon');
      if (!summary || !body) return;
      if (!(item as HTMLDetailsElement).open) {
        body.style.maxHeight = '0';
        body.style.overflow = 'hidden';
      }
      summary.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = (item as HTMLDetailsElement).open;
        document.querySelectorAll('.es-accordion__item').forEach((el) => {
          (el as HTMLDetailsElement).open = false;
          const b = el.querySelector('.es-accordion__body') as HTMLElement | null;
          if (b) { b.style.maxHeight = '0'; b.style.overflow = 'hidden'; }
          const ic = el.querySelector('.es-accordion__icon');
          if (ic) ic.textContent = '+';
        });
        if (!isOpen) {
          (item as HTMLDetailsElement).open = true;
          body.style.overflow = 'hidden';
          body.style.maxHeight = body.scrollHeight + 'px';
          if (icon) icon.textContent = '-';
        }
      });
    });
  })();

  // ── Fade in on scroll ──────────────────────────────────────
  (function () {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { (e.target as HTMLElement).style.opacity = '1'; (e.target as HTMLElement).style.transform = 'translateY(0)'; obs.unobserve(e.target); }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.fade-in').forEach((el) => {
      (el as HTMLElement).style.opacity = '0';
      (el as HTMLElement).style.transform = 'translateY(20px)';
      (el as HTMLElement).style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      obs.observe(el);
    });
  })();
</script>

