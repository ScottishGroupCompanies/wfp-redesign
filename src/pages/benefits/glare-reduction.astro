  /* Cards 4-6 - row 2, span 4 cols each */
  .kb-card--dark-accent {
    grid-column: span 4;
    background: rgba(20, 32, 26, 0.8);
    border: 1px solid rgba(124, 179, 66, 0.12);
    padding: 32px;
