  /* ══════════════════════════════════════
     FILM COMPARISON TABLE
     ══════════════════════════════════════ */
  .film-table { background: #F5F3EE; padding: 80px 0; }
  .film-table__inner { max-width: 1440px; margin: 0 auto; padding: 0 40px; }
  .film-table__header { text-align: center; margin-bottom: 48px; }
  .film-table__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin-bottom: 0.75rem; }
  .film-table__title { font-family: 'Playfair Display', serif; font-size: clamp(1.9rem, 3vw, 2.75rem); font-weight: 700; color: #14201A; letter-spacing: -0.02em; line-height: 1.15; margin: 0 0 1rem; }
  .film-table__sub { font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #4A5C48; max-width: 680px; margin: 0 auto; line-height: 1.7; }
  .film-table__scroll { overflow-x: visible; border-radius: 12px; box-shadow: 0 2px 24px rgba(0,0,0,0.08); }
  .film-table__tbl { width: 100%; border-collapse: collapse; font-family: 'Inter', sans-serif; font-size: 0.82rem; background: #fff; table-layout: fixed; }
  .film-table__tbl thead tr { background: #14201A; color: #fff; }
  .film-table__tbl thead th { padding: 14px 12px; text-align: left; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; white-space: normal; word-break: break-word; }

  .film-table__tbl thead th:first-child { border-radius: 12px 0 0 0; }
  .film-table__tbl thead th:last-child { border-radius: 0 12px 0 0; }
  .film-table__row td { padding: 13px 12px; border-bottom: 1px solid #eee; color: #222; vertical-align: middle; }
  .film-table__row--light { background: #fafaf8; }
  .film-table__row:last-child td { border-bottom: none; }
  .film-table__row:last-child td:first-child { border-radius: 0 0 0 12px; }
  .film-table__row:last-child td:last-child { border-radius: 0 0 12px 0; }
  .film-table__product { font-weight: 700; color: #14201A; white-space: nowrap; }
  .film-table__brand { display: inline-block; font-size: 0.75rem; font-weight: 600; color: #4A5C48; }
  .film-table__type { display: inline-block; font-size: 0.7rem; font-weight: 600; padding: 3px 10px; border-radius: 999px; white-space: nowrap; }
  .film-table__type--ss { background: #e8f5e2; color: #2E6B30; }
  .film-table__type--cer { background: #e3eaf9; color: #1a3a7a; }
  .film-table__type--dr { background: #fef3e2; color: #7a4a00; }
  .film-table__num { font-weight: 700; font-size: 0.9rem; color: #14201A; white-space: nowrap; }
  .film-table__glare { display: inline-block; font-weight: 800; font-size: 0.95rem; padding: 4px 12px; border-radius: 6px; white-space: nowrap; }
  .film-table__glare--low { background: #e8f5e2; color: #2E6B30; }
  .film-table__glare--mid { background: #d4edce; color: #1e5a20; }
  .film-table__glare--high { background: #7CB342; color: #fff; }
  .film-table__source { font-family: 'Inter', sans-serif; font-size: 0.78rem; color: #6b7c6a; margin-top: 20px; display: flex; align-items: flex-start; gap: 6px; line-height: 1.6; }
  .film-table__source a { color: #7CB342; text-decoration: underline; text-underline-offset: 2px; }
  .film-table__source a:hover { color: #2E6B30; }
  @media (max-width: 900px) { .film-table__scroll { overflow-x: auto; } .film-table__tbl { table-layout: auto; font-size: 0.78rem; } }
  @media (max-width: 768px) {
    .film-table__inner { padding: 0 20px; }
    .film-table { padding: 60px 0; }
    .film-table__tbl { font-size: 0.8rem; }
    .film-table__tbl thead th, .film-table__row td { padding: 12px 12px; }
  }

/* FILM TYPES SLIDER (gr-slider)
     ══════════════════════════════════════ */
  .gr-slider { position: relative; width: 100%; min-height: 90vh; overflow: hidden; background: #14201A; }
  .gr-slider__track { display: flex; width: 100%; height: 100%; transition: transform 0.6s cubic-bezier(0.4,0,0.2,1); will-change: transform; }
  .gr-slider__slide { position: relative; min-width: 100%; min-height: 90vh; flex-shrink: 0; display: flex; align-items: center; }
  .gr-slider__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; z-index: 0; }
  .gr-slider__overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.80) 0%, rgba(0,0,0,0.25) 60%, transparent 100%); z-index: 1; }
  .gr-slider__content { position: relative; z-index: 2; max-width: 560px; padding-left: 80px; color: #fff; opacity: 0; transform: translateY(20px); transition: opacity 0.5s ease 0.1s, transform 0.5s ease 0.1s; }
  .gr-slider__slide[data-slide="0"] .gr-slider__content { opacity: 1; transform: translateY(0); }
  .gr-slider__step { font-family: 'Space Mono', monospace; font-size: 13px; color: #7CB342; letter-spacing: 0.2em; margin-bottom: 1rem; opacity: 0; animation: grFadeUp 0.4s ease 0.2s forwards; }
  .gr-slider__title { font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 4vw, 3.25rem); font-weight: 700; color: #fff; line-height: 1.1; margin: 0 0 1.5rem; white-space: pre-line; opacity: 0; animation: grFadeUp 0.4s ease 0.3s forwards; }
  .gr-slider__desc { font-family: 'Inter', sans-serif; font-size: 16px; line-height: 1.8; color: rgba(255,255,255,0.85); max-width: 460px; margin-bottom: 2rem; opacity: 0; animation: grFadeUp 0.4s ease 0.4s forwards; }
  .gr-slider__faq { display: flex; flex-direction: column; gap: 8px; margin-bottom: 2rem; opacity: 0; animation: grFadeUp 0.4s ease 0.5s forwards; }
  .gr-slider__faq-item { border-radius: 8px; overflow: hidden; }
  .gr-slider__faq-q { width: 100%; background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: rgba(255,255,255,0.88); font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 500; padding: 12px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center; gap: 12px; cursor: pointer; transition: background 0.2s ease; }
  .gr-slider__faq-q:hover { background: rgba(255,255,255,0.18); }
  .gr-slider__faq-icon { font-size: 1.2rem; color: #7CB342; flex-shrink: 0; font-style: normal; transition: transform 0.3s ease; }
  .gr-slider__faq-q[aria-expanded="true"] .gr-slider__faq-icon { transform: rotate(45deg); }
  .gr-slider__faq-a { background: rgba(255,255,255,0.08); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.10); border-top: none; border-radius: 0 0 8px 8px; color: rgba(255,255,255,0.70); font-family: 'Inter', sans-serif; font-size: 0.875rem; line-height: 1.6; padding: 12px 16px; margin-top: -4px; }
  .gr-slider__cta { display: inline-block; background: #7CB342; color: #fff; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; padding: 14px 32px; border-radius: 9999px; text-decoration: none; transition: background 0.25s ease, transform 0.2s ease; opacity: 0; animation: grFadeUp 0.4s ease 0.6s forwards; }
  .gr-slider__cta:hover { background: #2E6B30; transform: translateY(-2px); }
  .gr-slider__nav { position: absolute; top: 50%; right: 48px; transform: translateY(-50%); z-index: 10; display: flex; flex-direction: column; gap: 24px; }
  .gr-slider__nav-item { display: flex; align-items: center; gap: 12px; background: transparent; border: none; cursor: pointer; padding: 0; opacity: 0.35; transition: opacity 0.3s ease; }
  .gr-slider__nav-item:hover { opacity: 0.65; }
  .gr-slider__nav-item--active { opacity: 1; }
  .gr-slider__nav-line { display: block; width: 3px; height: 32px; background: rgba(255,255,255,0.4); border-radius: 2px; transition: background 0.3s ease, height 0.3s ease; }
  .gr-slider__nav-item--active .gr-slider__nav-line { background: #7CB342; height: 48px; }
  .gr-slider__nav-label { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 500; color: #fff; text-transform: uppercase; letter-spacing: 0.15em; white-space: nowrap; }
  .gr-slider__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 10; width: 48px; height: 48px; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #fff; transition: background 0.3s ease, color 0.3s ease; }
  .gr-slider__arrow:hover { background: rgba(0,0,0,0.6); color: #7CB342; }
  .gr-slider__arrow--prev { left: 32px; }
  .gr-slider__arrow--next { right: 32px; }
  .gr-slider__progress { position: absolute; bottom: 0; left: 0; width: 100%; height: 2px; background: rgba(255,255,255,0.15); z-index: 10; }
  .gr-slider__progress-bar { height: 100%; background: #7CB342; width: 0; transition: width 0.05s linear; }
  @keyframes grFadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  .gr-slider__slide.gr-active .gr-slider__content { opacity: 1; transform: translateY(0); }
  .gr-slider__slide.gr-active .gr-slider__step,
  .gr-slider__slide.gr-active .gr-slider__title,
  .gr-slider__slide.gr-active .gr-slider__desc,
  .gr-slider__slide.gr-active .gr-slider__faq,
  .gr-slider__slide.gr-active .gr-slider__cta { animation: grFadeUp 0.4s ease forwards; }
  @media (max-width: 768px) {
  .gr-slider { min-height: auto; }
  .gr-slider__slide { min-height: auto; padding: 60px 0 40px; }
  .gr-slider__nav { display: none; }
  .gr-slider__overlay { background: linear-gradient(to bottom, rgba(0,0,0,0.60) 0%, rgba(0,0,0,0.85) 100%); }
  .gr-slider__content { padding-left: 5%; padding-right: 5%; max-width: 100%; }
  .gr-slider__title { font-size: 1.75rem; }
  .gr-slider__desc { font-size: 0.9rem; }
  .gr-slider__arrow--prev { left: 20px; }
  .gr-slider__arrow--next { right: 20px; }
}

