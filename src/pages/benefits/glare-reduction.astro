  /* ══════════════════════════════════════
     KEY BENEFITS BENTO GRID (shared kb-*)
     ══════════════════════════════════════ */
  .kb-section {
    background: var(--swt-dark);
    padding: 96px 0;
  }
  .kb-section__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .kb-section__header {
    text-align: center;
    margin-bottom: 56px;
  }
  .kb-section__headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 700;
    color: #F3F6F1;
    margin-bottom: 12px;
    line-height: 1.2;
  }
  .kb-section__sub {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: rgba(243, 246, 241, 0.6);
