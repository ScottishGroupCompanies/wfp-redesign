    flex-direction: column;
  }
  .kb-card__hero-icon { margin-bottom: 24px; }
  .kb-card__hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    font-weight: 700;
    color: #F3F6F1;
    margin-bottom: 16px;
    line-height: 1.2;
  }
  .kb-card__hero-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: rgba(243, 246, 241, 0.7);
