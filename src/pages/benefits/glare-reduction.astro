  .kb-card { border-radius: 16px; overflow: hidden; position: relative; }

  /* Card 1 - hero dark card spans 6 cols, row 1 */
  .kb-card--hero {
    grid-column: span 6;
    background: rgba(124, 179, 66, 0.07);
