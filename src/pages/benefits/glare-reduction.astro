<script>
  // Film type slider
  (function () {
    const track = document.getElementById('grTrack');
    const slides = document.querySelectorAll('.gr-slider__slide');
    const navItems = document.querySelectorAll('[data-grnav]');
    const prevBtn = document.getElementById('grPrev');
    const nextBtn = document.getElementById('grNext');
    const progressBar = document.getElementById('grProgressBar');
    if (!track || !slides.length) return;
    let current = 0;
    const total = slides.length;

    function goTo(i) {
      if (i < 0) i = total - 1;
      if (i >= total) i = 0;
      current = i;
      track.style.transform = `translateX(-${current * 100}%)`;
      navItems.forEach((n, idx) => n.classList.toggle('gr-slider__nav-item--active', idx === current));
      slides.forEach((s, idx) => s.classList.toggle('gr-active', idx === current));
      if (progressBar) {
        progressBar.style.transition = 'none';
        progressBar.style.width = '0';
        setTimeout(() => { progressBar.style.transition = 'width 6s linear'; progressBar.style.width = '100%'; }, 50);
      }
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    navItems.forEach((n, i) => n.addEventListener('click', () => goTo(i)));

    document.querySelectorAll('.gr-slider__faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const slide = btn.closest('.gr-slider__slide');
        slide.querySelectorAll('.gr-slider__faq-q').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          const a = b.nextElementSibling; if (a) a.hidden = true;
        });
        if (!expanded) {
          btn.setAttribute('aria-expanded', 'true');
          const a = btn.nextElementSibling; if (a) a.hidden = false;
        }
      });
    });

    let timer = setInterval(() => goTo(current + 1), 6000);
    document.getElementById('grSlider')?.addEventListener('mouseenter', () => clearInterval(timer));
    document.getElementById('grSlider')?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 6000); });
    goTo(0);
  })();

  // Stats bar intersection observer
  (function () {
    const items = document.querySelectorAll('.swt-stats__item');
    const obs = new IntersectionObserver((entries) => {
      if (entries.some(e => e.isIntersecting)) {
        items.forEach(item => item.classList.add('is-visible'));
        obs.disconnect();
      }
    }, { threshold: 0.3 });
    if (items.length) obs.observe(items[0]);
  })();
</script>
