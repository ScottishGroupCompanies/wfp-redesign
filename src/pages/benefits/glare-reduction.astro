  }
  .kb-card__dark-text a { color: #7CB342; }
  .kb-card__micro-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(124, 179, 66, 0.1);
    border: 1px solid rgba(124, 179, 66, 0.2);
    color: #7CB342;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 100px;
