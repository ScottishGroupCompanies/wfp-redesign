  .kb-card--retail {
    grid-column: span 4;
    min-height: 280px;
    position: relative;
  }
  .kb-card__retail-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14, 24, 16, 0.92) 35%, rgba(14, 24, 16, 0.45) 70%, transparent 100%);
  }
  .kb-card__retail-content {
    position: absolute;
