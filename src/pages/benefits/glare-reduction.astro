    .kb-card--dark-accent,
    .kb-card--dark-pattern,
    .kb-card--retail { grid-column: span 4; }
  }
  @media (max-width: 700px) {
    .kb-grid { grid-template-columns: 1fr; }
    .kb-card--hero,
    .kb-card--photo,
    .kb-card--dark-accent,
    .kb-card--dark-pattern,
