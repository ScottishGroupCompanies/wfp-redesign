<script>
  document.querySelectorAll('.swt-faq__item').forEach(item => {
    item.querySelector('.swt-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('swt-faq__item--open');
      document.querySelectorAll('.swt-faq__item').forEach(i => i.classList.remove('swt-faq__item--open'));
      if (!isOpen) item.classList.add('swt-faq__item--open');
    });
  });

  document.querySelectorAll('.bm-accordion__item').forEach(item => {
    item.addEventListener('toggle', () => {
      if (item.open) {
        document.querySelectorAll('.bm-accordion__item').forEach(other => {
          if (other !== item) other.removeAttribute('open');
        });
      }
    });
  });

  (function initReviews() {
    const track = document.getElementById('bmReviewsTrack');
    const dotsEl = document.getElementById('bmReviewsDots');
    if (!track || !dotsEl) return;
    const cards = track.querySelectorAll('.bm-reviews__card');
    cards.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.className = 'bm-reviews__dot' + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', `Go to review ${i + 1}`);
      dot.addEventListener('click', () => track.scrollTo({ left: i * 414, behavior: 'smooth' }));
      dotsEl.appendChild(dot);
    });
    track.addEventListener('scroll', () => {
      const idx = Math.round(track.scrollLeft / 414);
      dotsEl.querySelectorAll('.bm-reviews__dot').forEach((dot, i) => dot.classList.toggle('active', i === idx));
    }, { passive: true });
  })();

  (function initSlider() {
    const track = document.getElementById('bmTrack');
    const slides = document.querySelectorAll('.bm-slider__slide');
    const navItems = document.querySelectorAll('[data-bmnav]');
    const prevBtn = document.getElementById('bmPrev');
    const nextBtn = document.getElementById('bmNext');
    const progressBar = document.getElementById('bmProgressBar');
    if (!track || !slides.length) return;
    let current = 0;
    const total = slides.length;

    function goTo(i) {
      current = (i + total) % total;
      track.style.transform = `translateX(-${current * 100}%)`;
      navItems.forEach((n, idx) => n.classList.toggle('bm-slider__nav-item--active', idx === current));
      if (progressBar) {
        progressBar.style.transition = 'none';
        progressBar.style.width = '0';
        setTimeout(() => { progressBar.style.transition = 'width 6s linear'; progressBar.style.width = '100%'; }, 50);
      }
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    navItems.forEach((n, i) => n.addEventListener('click', () => goTo(i)));

    document.querySelectorAll('.bm-slider__faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const slide = btn.closest('.bm-slider__slide');
        slide?.querySelectorAll('.bm-slider__faq-q').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          const a = b.nextElementSibling;
          if (a) a.hidden = true;
        });
        if (!expanded) {
          btn.setAttribute('aria-expanded', 'true');
          const a = btn.nextElementSibling;
          if (a) a.hidden = false;
        }
      });
    });

    let timer = setInterval(() => goTo(current + 1), 6000);
    document.getElementById('bmSlider')?.addEventListener('mouseenter', () => clearInterval(timer));
    document.getElementById('bmSlider')?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 6000); });
    goTo(0);
  })();
</script>
