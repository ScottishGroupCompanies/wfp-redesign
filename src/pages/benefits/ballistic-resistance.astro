---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import FlipWords from '../../components/FlipWords.astro';

const title = 'Ballistic Resistant Window Film Philadelphia | Security Film';
const description = 'Ballistic resistant window film in Philadelphia for schools, banks, and government buildings. UL 752-rated protection that holds glass under impact.';
const heroImage = '/images/ballistic-resistant-window-film-philadelphia-hero.jpg';
const serviceUrl = 'https://www.windowfilmphiladelphia.net/benefits/ballistic-resistance/';

const reviews = [
  {
    img: '/images/ballistic-resistant-window-film-philadelphia-client-review-1.jpg',
    name: 'Marcus T.',
    sub: 'Security Director — Center City Office Tower',
    quote: 'We had a specific UL 752 requirement from our building\'s largest tenant. The team understood exactly what was needed, specified the right film, and provided full documentation. Installation was completed over a weekend with no disruption to tenants.',
  },
  {
    img: '/images/ballistic-resistant-window-film-philadelphia-client-review-2.jpg',
    name: 'Principal Karen S.',
    sub: 'K-12 School — Northeast Philadelphia',
    quote: 'After our district completed its security assessment, ballistic-rated window film was the most cost-effective way to harden our entrance glass. The compliance documentation was exactly what our school board needed to approve the project.',
  },
  {
    img: '/images/ballistic-resistant-window-film-philadelphia-client-review-3.jpg',
    name: 'Robert M.',
    sub: 'Branch Manager — South Philadelphia',
    quote: 'Our regional security team required documented ballistic protection for our teller windows and lobby glass. Window Film Philadelphia understood the requirement immediately and provided the right product with full UL 752 specification records.',
  },
];

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://www.windowfilmphiladelphia.net/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Benefits',
        item: 'https://www.windowfilmphiladelphia.net/benefits/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Ballistic Resistant Window Film',
        item: serviceUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': serviceUrl,
    name: title,
    description,
    dateModified: new Date().toISOString().slice(0, 10),
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.bl-hero__title', '.bl-why__headline', '.swt-faq__a'],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Ballistic Security Film Types — Philadelphia',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Forced Entry Protection Film',
        description: 'Heavy-duty clear security film that holds glass together under sustained attack and requires repeated force to penetrate.',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Ballistic Impact Resistance Film',
        description: 'UL 752-rated multi-layer film systems that hold glass under ballistic impact and provide documented threat-level protection.',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Natural Disaster Protection Film',
        description: 'Impact-rated security film that helps retain glass fragments during high-wind debris, storm pressure, and blast loading events.',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Ballistic Resistant Window Film Philadelphia',
    description: 'UL 752-rated ballistic resistant window film for Philadelphia schools, banks, government buildings, courthouses, hospitals, and houses of worship.',
    brand: {
      '@type': 'Brand',
      name: 'Window Film Philadelphia',
    },
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      areaServed: 'Philadelphia, PA',
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.9',
      reviewCount: '73',
      bestRating: '5',
    },
    review: reviews.map((review) => ({
      '@type': 'Review',
      reviewRating: {
        '@type': 'Rating',
        ratingValue: '5',
      },
      author: {
        '@type': 'Person',
        name: review.name,
      },
      reviewBody: review.quote,
    })),
  },
];

const faqItems = [
  {
    question: 'What is ballistic resistant window film and how does it work?',
    answer: 'Ballistic resistant window film is a multi-layer security film applied to existing glass that holds the glass together under ballistic impact, significantly slowing penetration and containing glass fragments. It uses layers of polyester, adhesive, and polycarbonate-backed construction to distribute and absorb impact force. The film is tested to UL 752, the industry standard for bullet-resisting equipment, at levels that correspond to specific threat calibers.',
  },
  {
    question: 'Is ballistic window film the same as bulletproof glass?',
    answer: 'No. Ballistic window film is not bulletproof glass — it does not provide the same level of protection as purpose-built laminated ballistic glass. However, it significantly increases the time and effort required to penetrate glass, holds fragments in place, and is rated to UL 752 for documented threat levels. It is the most cost-effective way to add documented ballistic resistance to existing glass.',
  },
  {
    question: 'What UL 752 levels does ballistic window film meet?',
    answer: 'UL 752 Level ratings correspond to different ballistic threats. The specific level appropriate for your facility depends on your threat assessment. Products we install can be specified at UL 752 Level 1 through higher levels depending on the film specification selected. We review your facility\'s requirements and specify the appropriate product during the assessment.',
  },
  {
    question: 'What types of buildings in Philadelphia need ballistic window film?',
    answer: 'The highest-priority applications are schools and universities, banks and financial institutions, government buildings and courthouses, houses of worship, hospitals and healthcare facilities, and any commercial building with an identified active-threat risk profile or insurance/compliance requirement for ballistic protection.',
  },
  {
    question: 'Does ballistic film affect how windows look?',
    answer: 'No. Ballistic resistant window film is optically clear and virtually invisible after installation. Windows look identical from inside and outside. There is no visible indication to anyone that the glass has been reinforced.',
  },
  {
    question: 'How does ballistic film compare to replacing glass with ballistic glazing?',
    answer: 'Ballistic security film costs a fraction of what full ballistic glazing replacement costs and can be completed without disrupting building operations. Film installs on existing glass in a single session. Full ballistic glass replacement requires removing and replacing frames, disrupts the building envelope, and involves significantly higher material and labor costs.',
  },
  {
    question: 'What documentation is provided with a ballistic film installation?',
    answer: 'We provide UL 752 product specification sheets, manufacturer product data sheets, installation completion records, and warranty documentation. For a broader product overview, see our <a href="/products/3m-window-film/">3M window film products</a> page.',
  },
  {
    question: 'Can ballistic film be installed without closing the building?',
    answer: 'In most cases, yes. Ballistic security film can be installed on entrance glass, sidelights, and lobby areas during off-hours, weekends, or in phases that minimize disruption. We plan the installation sequence around your building\'s operational schedule.',
  },
  {
    question: 'Does ballistic film also protect against forced entry and storms?',
    answer: 'Yes. The same multi-layer construction that provides ballistic resistance also significantly delays forced entry and holds glass together during storm-related debris impacts. A single ballistic film installation addresses multiple threat profiles.',
  },
  {
    question: 'How do I get ballistic resistant window film installed in Philadelphia?',
    answer: 'Contact us for a free security assessment. We evaluate your building\'s glass exposure, identify priority glazing zones, and recommend the appropriate UL 752 film specification. We provide full compliance documentation and plan installation around your schedule.',
  },
];

const slides = [
  {
    step: '01',
    nav: 'Forced Entry',
    img: '/images/forced-entry-protection-window-film-philadelphia.jpg',
    alt: 'Forced entry protection window film on Philadelphia commercial entrance glass',
    title: 'Forced Entry Protection. Time Is the Defense.',
    desc: 'Security film holds glass together under sustained attack — an intruder must apply repeated force rather than passing through on a single strike. That delay is critical time for lockdown procedures and law enforcement response.',
    stat: '8–14 mil multi-layer film — requires sustained, repeated force to penetrate.',
    faqs: [
      [
        'How long does security film delay forced entry?',
        'Delay depends on film thickness, glass type, frame strength, and the tool used. The critical difference is that film-protected glass cannot be breached on a single strike — every additional second matters for lockdown and evacuation.',
      ],
      [
        'Is forced entry film the same as ballistic film?',
        'They overlap. Ballistic-rated films like 3M Scotchshield provide both forced entry delay and documented impact resistance. Standard security film provides forced entry delay but is not tested to ballistic standards.',
      ],
      [
        'Where should forced entry film be prioritized?',
        'Primary entrance glass, vestibule panels, sidelights, and administrative office glazing are the highest-priority locations in any facility security assessment.',
      ],
    ],
  },
  {
    step: '02',
    nav: 'Armed Intruders',
    img: '/images/ballistic-resistant-window-film-philadelphia-armed-intruders.jpg',
    alt: 'Ballistic resistant window film in Philadelphia on secure facility glass',
    title: 'Armed Intruder Defense. Rated Protection.',
    desc: 'Ballistic resistant window film in Philadelphia is tested to UL 752 — the industry standard for bullet-resisting equipment — at levels that address handgun threats. The multi-layer construction holds glass under ballistic impact and provides a compliance record for security audits and insurance reviews.',
    stat: 'UL 752 — industry standard for bullet-resisting equipment ratings.',
    faqs: [
      [
        'What does UL 752 measure?',
        'UL 752 tests materials against specific ballistic threats at defined distances. The standard includes multiple levels corresponding to different threat calibers — the appropriate level is selected based on your facility\'s specific risk profile.',
      ],
      [
        'Does ballistic film stop bullets completely?',
        'Ballistic window film significantly slows penetration and holds glass fragments in place — it is not a guarantee of complete bullet stoppage. The film buys critical seconds and contains debris hazards that cause the majority of injuries in ballistic events.',
      ],
      [
        'Which facilities in Philadelphia need ballistic-rated film?',
        'Schools, banks, government buildings, houses of worship, courthouses, and any facility that has identified active shooter or armed intruder risk as part of its security assessment.',
      ],
    ],
  },
  {
    step: '03',
    nav: 'Disaster Protection',
    img: '/images/natural-disaster-protection-window-film-philadelphia.jpg',
    alt: 'Natural disaster protection window film on Philadelphia building glass',
    title: 'Natural Disaster Protection. Impact Rated.',
    desc: 'The same multi-layer construction that provides ballistic resistance also holds glass together during storms and high-wind debris impacts. Rated to ASTM F1642 and ANSI Z97.1, a single installation covers both security and storm protection simultaneously.'
    stat: 'ASTM F1642 and ANSI Z97.1 fragment retention under blast and impact loading.',
    faqs: [
      [
        'Does ballistic film help with storm protection?',
        'Yes. The fragment retention properties of heavy-duty security film also hold glass together during wind-borne debris impacts and pressure events from severe storms.',
      ],
      [
        'Is separate storm film needed alongside security film?',
        'In most cases, no. Ballistic-rated security film rated to ASTM F1642 already provides meaningful storm protection — a single installation covers both threat profiles.',
      ],
      [
        'Are there Philadelphia building code requirements for storm-rated glass?',
        'Philadelphia building code and insurance requirements vary by building type and location. We can provide ASTM F1642 and ANSI Z97.1 documentation to support your building\'s compliance review.',
      ],
    ],
  },
];

const gallery = [
  [
    '/images/ballistic-resistant-window-film-installation-philadelphia.jpg',
    'Security film installation — Center City Office Tower',
  ],
  [
    '/images/bullet-resistant-window-film-philadelphia-school.jpg',
    'School entrance security film — Northeast Philadelphia',
  ],
  [
    '/images/ballistic-security-film-philadelphia-bank.jpg',
    'Bank branch security glazing — South Philadelphia',
  ],
  [
    '/images/ballistic-resistant-window-film-philadelphia-government.jpg',
    'Government building security film — Old City Philadelphia',
  ],
  [
    '/images/ballistic-resistant-film-philadelphia-hospital.jpg',
    'Hospital entrance security glazing — University City',
  ],
  [
    '/images/ballistic-resistant-window-film-philadelphia-courthouse.jpg',
    'Courthouse security film — Center City Philadelphia',
  ],
];

const panels = [
  {
    img: '/images/ballistic-resistant-window-film-philadelphia-school.jpg',
    title: 'Schools & Universities',
    sub: 'Temple, Drexel, UPenn, Philadelphia School District K-12 campuses',
    desc: 'School entrance glass, vestibule panels, administrative office sidelights, and corridor glass are primary locations for ballistic resistant window film in Philadelphia schools. Summer break installation means zero disruption to the school year.',
  },
  {
    img: '/images/ballistic-resistant-window-film-philadelphia-government-building.jpg',
    title: 'Government & Civic Facilities',
    sub: 'Federal buildings, courthouses, municipal offices, transit hubs',
    desc: 'Government facilities require documented specifications — UL 752 compliance records, installation completion reports, and product warranty documentation provided as standard for every Philadelphia government installation.',
  },
  {
    img: '/images/ballistic-resistant-window-film-philadelphia-financial.jpg',
    title: 'Banks & Financial Institutions',
    sub: 'Center City banks, credit unions, financial services offices',
    desc: 'Teller windows, lobby glass, and drive-through glazing are the highest-priority locations in financial facilities. This clear retrofit for Philadelphia banks provides documented protection while maintaining the open, professional appearance customers expect.',
  },
  {
    img: '/images/ballistic-resistant-window-film-philadelphia-house-of-worship.jpg',
    title: 'Houses of Worship',
    sub: 'Churches, synagogues, mosques, and community religious centers',
    desc: 'Houses of worship throughout Philadelphia have increased security awareness and physical hardening needs. Security film on entrance glass and sidelights provides meaningful protection while preserving the welcoming atmosphere congregations require.',
  },
];

const products = [
  [
    'Scotchshield Ultra S800',
    '3M',
    '8 mil',
    'Level 1 (verified)',
    'Yes',
    '99%',
  ],
  [
    'Scotchshield Ultra S140',
    '3M',
    '14 mil',
    'Level 3',
    'Yes',
    '99%',
  ],
  [
    'Armorcoat Safety Series',
    'Solar Gard',
    '14 mil',
    'ASTM F1642 rated',
    'Yes',
    '99%',
  ],
  [
    'Clear Safety 14 mil',
    'Madico',
    '14 mil',
    'ASTM F1642 rated',
    'Yes',
    '99%',
  ],
  [
    'Safety Series S4',
    'LLumar',
    '4 mil',
    'Basic fragment',
    'Yes',
    '99%',
  ],
];

const resources = [
  [
    '/resources/ballistic-window-film-3m-k12-school-safety-philadelphia.pdf',
    '3M Safety Film for K-12 Schools',
  ],
  [
    '/resources/ballistic-window-film-3m-scotchshield-s800-security-spec-philadelphia.pdf',
    '3M Scotchshield Ultra S800 — Product Bulletin',
  ],
  [
    '/resources/government-window-film-3m-scotchshield-armed-forces-service-center-case-study-philadelphia.pdf',
    '3M Scotchshield — Armed Forces Service Center Case Study',
  ],
  [
    '/resources/school-window-film-madico-clear-14mil-texas-school-district-case-study-philadelphia.pdf',
    'Madico Clear Safety 14 mil — Texas School District Case Study',
  ],
  [
    '/resources/retail-store-window-film-3m-scotchshield-smash-grab-security-case-study-philadelphia.pdf',
    '3M Scotchshield — Smash & Grab Security Case Study',
  ],
  [
    '/resources/mass-transit-window-film-solar-gard-14mil-safety-security-spec-philadelphia.pdf',
    'Solar Gard 14 mil Safety & Security Specification',
  ],
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={heroImage}
  serviceName="Ballistic Resistant Window Film"
  serviceDesc="UL 752-rated ballistic resistant window film in Philadelphia for schools, banks, government buildings, courthouses, hospitals, and houses of worship."
  serviceUrl={serviceUrl}
  faqItems={faqItems}
  schemas={pageSchemas}
>
  <section class="bl-hero">
    <div
      class="bl-hero__bg"
      style={`background-image:url('${heroImage}')`}
      role="img"
      aria-label="Ballistic resistant window film installed on Philadelphia institutional building glass"
    >
    </div>
    <div class="bl-hero__overlay"></div>
    <div class="bl-hero__content">
      <p class="bl-hero__eyebrow">UL 752-Rated Glass Protection</p>
      <h1 class="bl-hero__title">Ballistic Resistant Window Film in Philadelphia</h1>
      <p class="bl-hero__animated-line">
        <FlipWords
          words={[
            'for K-12 Schools and Universities',
            'for Banks and Financial Institutions',
            'for Government Buildings',
            'for Houses of Worship',
          ]}
          staticText=""
          class="bl-hero__flip"
        />
      </p>
      <p class="bl-hero__subtitle">
        Clear security film that holds glass under impact, slows penetration, and supports compliance documentation for high-risk Philadelphia facilities.
      </p>
      <div class="bl-hero__cta">
        <a href="/contact/" class="bl-btn bl-btn--primary">Get a Free Assessment</a>
        <a href="tel:2673947980" class="bl-btn bl-btn--ghost">Call (267) 394-7980</a>
      </div>
      <div class="bl-hero__stats-panel">
        {[
          '8–14 mil|Security Film',
          'UL 752|Rated Protection',
          'ASTM F1642|Fragment Retention',
          '99%|UV Blocked',
        ].map((stat) => {
          const [num, label] = stat.split('|');
          return (
            <div class="bl-hero__stat">
              <strong>{num}</strong>
              <span>{label}</span>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <div class="swt-body">
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">
          Trusted for Philadelphia schools, banks, government buildings, courthouses, hospitals, and houses of worship.
        </p>
        <BrandLogos />
      </div>
    </section>

    <section class="bl-why" id="problem">
      <div class="bl-split">
        <div class="bl-why__image-wrap">
          <img
            src="/images/ballistic-resistant-window-film-philadelphia-threat.jpg"
            alt="Philadelphia building entrance glass prepared for ballistic security film assessment"
            title="Ballistic resistant window film Philadelphia threat assessment entrance glass"
            class="bl-why__image"
            loading="lazy"
          />
          <div class="bl-why__stat-card">
            8–14 mil multi-layer film holds glass under sustained force and helps delay penetration.
          </div>
        </div>
        <div class="bl-why__content">
          <p class="bl-kicker">The Threat Profile</p>
          <h2 class="bl-why__headline">Existing Glass Was Never Designed for Active Threats</h2>
          <p>
            Ballistic resistant window film in Philadelphia gives existing entrance glass, sidelights, and lobby glazing a documented security upgrade without replacing the glass. The film does not change the appearance of the building — it changes what happens after impact.
          </p>
          <ul class="bl-checklist">
            <li>
              Standard float glass can fail immediately under impact, leaving an open path through entrances, vestibules, and lobby glazing.
            </li>
            <li>
              bullet resistant window film in Philadelphia helps glass stay together so a forced entry attempt requires sustained, repeated force instead of one successful strike.
            </li>
            <li>
              UL 752-rated film systems provide documentation for handgun threat levels, procurement review, insurance records, and security audits.
            </li>
            <li>
              ASTM F1642 and ANSI Z97.1 ratings add fragment-retention support for storm debris, blast loading, and accidental impact events.
            </li>
          </ul>
          <p class="bl-quote">
            "Ballistic window film is the most misunderstood product in the safety and security category — it is not the same as bulletproof glass, but when properly specified and installed it significantly increases the time required to penetrate glass," according to the <a href="https://iwfa.com/safety-and-security/" target="_blank" rel="noopener">International Window Film Association</a>.
          </p>
          <p>
            For facilities that also need broader glass hardening, see our <a href="/benefits/safety-and-security/">commercial safety and security window film</a> page for non-ballistic specifications.
          </p>
        </div>
      </div>
    </section>

    <section class="bl-slider" id="blSlider">
      <div class="bl-slider__track" id="blTrack">
        {slides.map((slide, index) => (
          <article class={`bl-slider__slide ${index === 0 ? 'bl-active' : ''}`} data-slide={index}>
            <img
              src={slide.img}
              alt={slide.alt}
              title={`${slide.title} Philadelphia security film`}
              class="bl-slider__bg"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
            <div class="bl-slider__shade"></div>
            <div class="bl-slider__content">
              <span class="bl-slider__step">{slide.step}</span>
              <h2>{slide.title}</h2>
              <p>{slide.desc}</p>
              <p class="bl-slider__stat">{slide.stat}</p>
              <div class="bl-slider__faq">
                {slide.faqs.map(([q, a]) => (
                  <details>
                    <summary>{q}</summary>
                    <p>{a}</p>
                  </details>
                ))}
              </div>
              <a href="/contact/" class="bl-btn bl-btn--primary">Get a Free Assessment</a>
            </div>
          </article>
        ))}
      </div>
      <nav class="bl-slider__nav" aria-label="Ballistic security film types">
        {slides.map((slide, index) => (
          <button class={index === 0 ? 'is-active' : ''} data-blnav={index}>
            {slide.nav}
          </button>
        ))}
      </nav>
      <button class="bl-slider__arrow bl-slider__arrow--prev" id="blPrev" aria-label="Previous slide">‹</button>
      <button class="bl-slider__arrow bl-slider__arrow--next" id="blNext" aria-label="Next slide">›</button>
    </section>

    <section class="bl-bento">
      <div class="bl-section-head bl-section-head--dark">
        <p class="bl-kicker">Layered Protection</p>
        <h2>Glass Hardening Without Changing the Building</h2>
        <p>
          The right film specification turns ordinary glazing into a delayed-entry barrier with the documentation security teams need.
          Each opening can be prioritized by exposure, frame strength, public access, and the consequences of a fast breach.
          A front entrance may require a different specification than upper-floor curtain wall glass, and a public lobby may need a different documentation package than a private administrative corridor.
          This section shows how security teams think about glass as part of a broader protection plan rather than a standalone product purchase.
        </p>
      </div>
      <div class="bl-bento__grid">
        <article class="bl-bento-card bl-bento-card--hero">
          <svg width="58" height="58" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <path d="M32 6l21 8v16c0 13-8.5 22-21 28C19.5 52 11 43 11 30V14l21-8z" stroke="#AED581" stroke-width="3" />
            <path d="M24 32l6 6 12-15" stroke="#AED581" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <h3>The Film Between Your Glass and the Threat</h3>
          <p>
            At 8–14 mil, multi-layer ballistic security film requires an attacker to apply sustained, repeated force to penetrate protected glass — buying critical seconds that save lives.
          </p>
          <span>UL 752 Rated</span>
        </article>
        <article class="bl-bento-card bl-bento-card--photo">
          <img
            src="/images/bullet-resistant-window-film-philadelphia-entrance.jpg"
            alt="Entrance glass protected by ballistic security film in Philadelphia"
            title="Bullet resistant window film Philadelphia entrance glass"
            loading="lazy"
          />
          <div>
            <h3>Entrance Glass</h3>
            <p>Primary doors, vestibules, and sidelights are the highest-priority glazing in any security assessment.</p>
          </div>
        </article>
        <article class="bl-bento-card bl-bento-card--photo">
          <img
            src="/images/ballistic-security-film-philadelphia-lobby.jpg"
            alt="Lobby and curtain wall glass with ballistic security film in Philadelphia"
            title="Ballistic security film Philadelphia lobby curtain wall"
            loading="lazy"
          />
          <div>
            <h3>Lobby &amp; Curtain Wall</h3>
            <p>Ground-floor and public-facing glass in commercial buildings gets the first priority in threat analysis.</p>
          </div>
        </article>
        <article class="bl-bento-card bl-bento-card--dark">
          <h3>Optically Clear — Invisible After Install</h3>
          <p>
            The glass looks identical before and after. Occupants, visitors, and potential threats see standard glass — there is no visible indication of reinforcement.
          </p>
          <span>Clear Protection</span>
        </article>
        <article class="bl-bento-card bl-bento-card--dark">
          <h3>No Glass Replacement Required</h3>
          <p>
            Ballistic security film installs on existing glass — a fraction of the cost of ballistic glass replacement or polycarbonate panel installation.
          </p>
          <span>Retrofit Ready</span>
        </article>
        <article class="bl-bento-card bl-bento-card--badge">
          <img
            src="/images/ballistic-resistant-glass-film-philadelphia-building.jpg"
            alt="Philadelphia building glass with UL 752 ballistic resistant security film"
            title="Ballistic resistant glass film Philadelphia building UL 752"
            loading="lazy"
          />
          <div>
            <strong>UL 752</strong>
            <h3>Industry-Standard Testing</h3>
            <p>Products we install are tested to UL 752 — the recognized standard for bullet-resisting equipment.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="bl-masonry">
      <div class="bl-section-head">
        <p class="bl-kicker">Field Applications</p>
        <h2>Security Film Installed Where Risk Is Highest</h2>
        <p>
          Philadelphia facilities use ballistic security film on entrances, schools, banks, civic buildings, hospitals, and courthouses.
        </p>
      </div>
      <div class="bl-masonry__grid">
        {gallery.map(([src, caption]) => (
          <figure>
            <img
              src={src}
              alt={caption}
              title={caption}
              loading="lazy"
            />
            <figcaption>{caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="bl-panels">
      <div class="bl-section-head">
        <p class="bl-kicker">Where We Install</p>
