<script is:inline>
  (() => {
    const slides = Array.from(document.querySelectorAll('.bl-slider__slide'));
    const nav = Array.from(document.querySelectorAll('[data-blnav]'));
    let index = 0;

    function show(next) {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('bl-active', i === index));
      nav.forEach((button, i) => button.classList.toggle('is-active', i === index));
    }

    document.getElementById('blPrev')?.addEventListener('click', () => show(index - 1));
    document.getElementById('blNext')?.addEventListener('click', () => show(index + 1));
    nav.forEach((button) => button.addEventListener('click', () => show(Number(button.dataset.blnav))));
  })();

  document.querySelectorAll('.swt-faq__item').forEach(item => {
    item.querySelector('.swt-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('swt-faq__item--open');
      document.querySelectorAll('.swt-faq__item').forEach(i => i.classList.remove('swt-faq__item--open'));
      if (!isOpen) item.classList.add('swt-faq__item--open');
    });
  });
</script>

