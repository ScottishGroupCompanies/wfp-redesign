---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import CategoryBlogFeed from '../../components/CategoryBlogFeed.astro';

const title = 'Security Window Film for Philadelphia | Glass Safety';
const description = 'Security window film for Philadelphia holds glass fragments, delays forced entry, and reduces injury risk. Schools, retail, healthcare, and offices.';

const faqItems = [
  { question: 'What is security window film and how does it work?', answer: 'Security window film is a clear or tinted PET-based film applied to the interior surface of existing glass. It bonds to the glass and holds fragments together after breakage, reduces the flying glass hazard from impacts, and helps delay forced entry by keeping cracked glass in the opening longer. Security window film for Philadelphia buildings is a retrofit option that works on most standard glass types.' },
  { question: 'Does security window film make glass ballistic-resistant?', answer: 'No. Standard security window film does not make glass ballistic-resistant. It holds shattered fragments together and delays forced entry, but it is not rated for ballistic resistance. For high-security applications requiring ballistic performance, we assess the specific threat level and recommend tested systems with appropriate documentation.' },
  { question: 'Will the glass still break with security film on it?', answer: 'Yes — security film does not make glass unbreakable. When glass breaks, the film changes how it behaves: fragments stay attached to the film instead of flying or falling, and the broken pane stays in the opening rather than collapsing inward. This is what reduces injury risk and slows entry.' },
  { question: 'What thickness of security film does Philadelphia use?', answer: 'Safety films typically run 4-8 mil and are used where the primary concern is reducing injury from accidental breakage or storm debris. Security films run 8-15 mil and are specified where forced-entry delay is the priority — schools, retail storefronts, healthcare facilities, and commercial entry points. We assess each opening and recommend the appropriate thickness based on glass type, frame condition, and threat level.' },
  { question: 'What is an attachment system and do I need one?', answer: 'An attachment system anchors the edge of the filmed glass to the window frame, so that when glass breaks, the filmed pane cannot be pushed out of the frame. Without attachment, an intruder can sometimes push a broken filmed pane out of the opening. For high-security entry points — school sidelites, retail entries, pharmacy windows — we typically recommend an attachment system as part of the installation.' },
  { question: 'Can security window film be clear?', answer: 'Yes. Most security films are nearly invisible once installed. Clear security film is the most common choice for commercial and institutional applications where appearance matters. Tinted, reflective, solar-control, and frosted options are also available for locations where privacy, glare reduction, or solar heat control is also a priority.' },
  { question: 'Does security film protect against storms and wind?', answer: 'Security and safety films help hold glass together after storm-related breakage, reducing the flying glass hazard from windborne debris. Some products are tested to applicable wind impact standards. We discuss the specific exposure and relevant testing references during the site assessment.' },
  { question: 'Which Philadelphia buildings benefit most from security window film?', answer: 'Security window film for Philadelphia is most commonly installed at schools and universities at entry vestibules, sidelites, and ground-floor windows; retail storefronts on high-foot-traffic corridors where smash-and-grab is a risk; healthcare facilities including hospitals and pharmacies where entry delay and fragment retention both matter; and commercial office buildings where invisible security is preferred over bars, grilles, or polycarbonate overlays.' },
  { question: 'How does security film work in schools?', answer: 'In Philadelphia schools, security window film is applied at entry doors, glass sidelites, and accessible ground-floor windows. When an intruder strikes the glass, the film holds broken fragments together and keeps the broken pane in the opening, forcing continued attack instead of immediate entry. This is used as part of a layered physical security approach alongside locks, alarms, cameras, and access control.' },
  { question: 'Can security window film reduce UV or heat?', answer: 'Clear safety film is not a heat or UV control product by itself. However, solar control security films are available that combine impact resistance with meaningful heat rejection and UV blocking — useful for Philadelphia buildings where south- or west-facing entry glass gets hot in the afternoon. We recommend the appropriate product based on each opening\'s priorities.' },
];

const pageSchemas = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://windowfilmphiladelphia.net/" },
    { "@type": "ListItem", "position": 2, "name": "Benefits", "item": "https://windowfilmphiladelphia.net/benefits/" },
    { "@type": "ListItem", "position": 3, "name": "Security Window Film for Philadelphia", "item": "https://windowfilmphiladelphia.net/benefits/safety-and-security/" }
  ] },
  { "@context": "https://schema.org", "@type": "WebPage", "@id": "https://windowfilmphiladelphia.net/benefits/safety-and-security/", "url": "https://windowfilmphiladelphia.net/benefits/safety-and-security/", "name": title, "description": description, "dateModified": new Date().toISOString().slice(0,10), "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".hs__title", ".hs__sub", ".faq__a-inner"] } },
  { "@context": "https://schema.org", "@type": "ItemList", "name": "Security Film Application Types", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Schools" },
    { "@type": "ListItem", "position": 2, "name": "Retail" },
    { "@type": "ListItem", "position": 3, "name": "Healthcare" },
    { "@type": "ListItem", "position": 4, "name": "Government" },
    { "@type": "ListItem", "position": 5, "name": "Commercial Offices" }
  ] },
  { "@context": "https://schema.org", "@type": "Product", "name": "Security Window Film for Philadelphia", "description": "Security window film for Philadelphia glass holds shattered fragments together, delays forced entry, and reduces injury risk at schools, retail storefronts, healthcare facilities, and offices.", "brand": { "@type": "Brand", "name": "Window Film Philadelphia" }, "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "areaServed": "Philadelphia, PA" },  }
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Security Window Film"
  serviceDesc="Security window film for Philadelphia glass holds shattered fragments in place, delays forced entry, and reduces injury risk."
  serviceUrl="https://windowfilmphiladelphia.net/benefits/safety-and-security/"
  faqItems={faqItems}
  schemas={pageSchemas}
>

  <!-- ══ HERO — Hero Subpage (library component) ══ -->
  <section class="hs">
    <img src="/images/security-window-film-philadelphia-hero.webp" alt="Security window film for Philadelphia commercial entry glass" title="Security window film for Philadelphia commercial entry glass" class="hs__bg" loading="eager" />
    <div class="hs__overlay" aria-hidden="true"></div>
    <div class="hs__inner">
      <p class="hs__eyebrow"><span class="hs__dot" aria-hidden="true"></span>Philadelphia Glass Security</p>
      <h1 class="hs__title">Security Window Film for Philadelphia</h1>
      <p class="hs__sub">Security window film for Philadelphia holds broken fragments together, delays forced entry, and protects occupants from laceration injury — invisibly, without bars or grilles.</p>
      <div class="hs__cta"><a href="/contact/" class="hs__btn-primary">Get a Free Assessment</a><a href="/benefits/" class="hs__btn-secondary">All Benefits</a></div>
    </div>
  </section>

  <!-- ══ TRUST BAR ══ -->
  <section class="swt-trust"><div class="container"><p class="swt-trust__label">Trusted by Philadelphia schools, retailers, healthcare facilities, and commercial property managers</p><BrandLogos /></div></section>

  <!-- ══ THE SURFACES — Accordion Vertical ══ -->
  <section class="sf-accv-wrap">
    <div class="sf-accv-wrap__header">
      <div class="sf-accv-wrap__eyebrow">THE CHALLENGE</div>
      <h2 class="sf-accv-wrap__title split-reveal" data-stagger="65" aria-label="What's the biggest glass risk in your building?"><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:0">The&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:1">Glass&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:2">Risk.&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:3">The&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:4">Film&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:5">Solution.</span></span></h2>
      <p class="sf-accv-wrap__sub">Security window film for Philadelphia glass changes what happens after impact. Instead of collapsing into dangerous fragments, filmed glass stays together longer, giving occupants more protection and responders more time.</p>
    </div>
    <div class="accv">
      <div class="accv__panel is-open" data-panel style="background-image:url('/images/security-film-philadelphia-shattered-glass-safety.webp')"><button class="accv__tab" data-tab aria-expanded="true"><span class="accv__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8.4-7 10-4-1.6-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-5"/></svg></span><span class="accv__title">Safety Film</span></button><div class="accv__content"><div class="accv__desc"><h3>Safety Film — Fragment Retention</h3><p>Standard glass shatters into dangerous flying shards during storms, accidents, or impacts. Safety film (4-8 mil) bonds to the glass and holds broken fragments in place, dramatically reducing laceration and injury risk. 3M Scotchshield Ultra S800 blocks up to 99% of UV rays and meets ANSI Z97.1 Class A impact resistance — the same standard required for safety glazing in schools, hospitals, and commercial buildings. 3M Safety Series, LLumar Magnum, and Solar Gard Armorcoat are common safety film choices for Philadelphia buildings.</p></div></div></div>
      <div class="accv__panel" data-panel style="background-image:url('/images/security-film-philadelphia-forced-entry-door.webp')"><button class="accv__tab" data-tab aria-expanded="false"><span class="accv__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/><path d="M12 15v2"/></svg></span><span class="accv__title">Security Film</span></button><div class="accv__content"><div class="accv__desc"><h3>Security Film — Forced Entry Delay</h3><p>Thicker security film (8-15 mil) keeps broken glass in the frame after repeated strikes, forcing intruders to keep attacking the opening rather than stepping through on the first hit. Used at Philadelphia school entry sidelites, bank vestibules, retail storefronts, and pharmacy windows.</p></div></div></div>
      <div class="accv__panel" data-panel style="background-image:url('/images/security-film-philadelphia-government-building.webp')"><button class="accv__tab" data-tab aria-expanded="false"><span class="accv__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M9 21v-7h6v7"/><path d="M8 10h.01M12 10h.01M16 10h.01"/></svg></span><span class="accv__title">Blast Mitigation</span></button><div class="accv__content"><div class="accv__desc"><h3>Blast Mitigation Film</h3><p>Blast mitigation film is engineered to reduce glass fragmentation during explosive events, specified for government, civic, and high-security Philadelphia buildings. Solar Gard Armorcoat is independently tested to ASTM F1642, ISO 16933, and UFC 4-010-01 blast standards — achieving Hazard Level performance at minimum blast pressures of 4–7 psi-msec on standard ¼" glazing. These systems require professional specification tied to a specific threat assessment.</p></div></div></div>
    </div>
  </section>

  <!-- ══ FILM TYPES — Bento Photo Grid ══ -->
  <section class="bgp sf-film-bento"><div class="bgp__head"><div class="bgp__eyebrow">THE FILM TYPES</div><h2 class="bgp__title">The Right Film for Every Risk Level</h2><p class="bgp__sub">Security window film for Philadelphia glass is not one product — thickness, solar control, and attachment method all vary by opening, threat level, and building type.</p></div><div class="bgp__grid">
    <div class="bgp__card bgp__card--lg"><img src="/images/security-window-film-philadelphia-clear-safety-film.webp" alt="Clear safety film on Philadelphia commercial glass" title="Clear safety film on Philadelphia commercial glass" loading="lazy" /><div class="bgp__overlay"></div><div class="bgp__body"><h3>Clear Safety Film</h3><p>Optically clear, 4-8 mil. Reduces flying glass hazard from accidental breakage, storms, and low-to-moderate impacts. Completely invisible. The standard choice for Philadelphia offices and commercial buildings.</p></div></div>
    <div class="bgp__card bgp__card--sm"><img src="/images/security-window-film-philadelphia-solar-control-security.webp" alt="Solar control security film on sun-facing Philadelphia entry glass" title="Solar control security film on sun-facing Philadelphia entry glass" loading="lazy" /><div class="bgp__overlay"></div><div class="bgp__body"><h3>Solar Control Security</h3><p>Combines 8-15 mil security performance with meaningful heat and glare reduction — ideal for south- and west-facing Philadelphia entries that get hot in the afternoon.</p></div></div>
    <div class="bgp__card bgp__card--sm"><img src="/images/security-window-film-philadelphia-heavy-security-film.webp" alt="Heavy security film for high-risk Philadelphia glass openings" title="Heavy security film for high-risk Philadelphia glass openings" loading="lazy" /><div class="bgp__overlay"></div><div class="bgp__body"><h3>Heavy Security Film</h3><p>12-15 mil for Philadelphia's highest-risk openings — school sidelites, bank vestibules, pharmacy windows, and government entry points.</p></div></div>
    <div class="bgp__card bgp__card--md"><img src="/images/security-window-film-philadelphia-attachment-system.webp" alt="Attachment system anchoring filmed glass to a Philadelphia window frame" title="Attachment system anchoring filmed glass to a Philadelphia window frame" loading="lazy" /><div class="bgp__overlay"></div><div class="bgp__body"><h3>Attachment System</h3><p>Edge anchoring that keeps the filmed pane in the frame after breakage. Critical for entry-point applications where pushing the filmed pane out is a risk.</p></div></div>
  </div></section>

  <!-- ══ HOW EACH FILM WORKS — Accordion Benefits (4 rows) ══ -->
  <section class="accb"><div class="accb__head"><h2 class="accb__title">How Each Film Type Performs</h2><p class="accb__sub">Each opening gets the right balance of fragment retention, forced-entry delay, solar control, and frame attachment for the actual risk.</p></div><div class="accb__wrap"><div class="accb__list">
    <div class="accb__row is-open" data-row data-index="0"><button class="accb__trigger" data-trigger aria-expanded="true"><span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8.4-7 10-4-1.6-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-5"/></svg></span><span class="accb__row-title">Clear Safety Film — Invisible Fragment Retention</span><span class="accb__chev" aria-hidden="true">›</span></button><div class="accb__detail"><div class="accb__detail-inner"><p>Clear safety film (4-8 mil) is applied directly to glass and is completely invisible after installation. It bonds to the glass surface and holds broken fragments in place after impact — whether from an accident, storm debris, or a direct strike. The film itself absorbs tensile force across the break, containing what would otherwise be flying shards. 3M Safety Series, LLumar, and Solar Gard Armorcoat produce clear safety films used across Philadelphia schools, <a href="/applications/office/">offices</a>, and <a href="/applications/retail/">retail locations</a>.</p><img class="accb__mobile-img" src="/images/security-window-film-philadelphia-clear-film-detail.webp" alt="Clear safety film detail on Philadelphia glass" title="Clear safety film detail on Philadelphia glass" loading="lazy" /></div></div></div>
    <div class="accb__row" data-row data-index="1"><button class="accb__trigger" data-trigger aria-expanded="false"><span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg></span><span class="accb__row-title">Solar Control Security — Protection + Comfort</span><span class="accb__chev" aria-hidden="true">›</span></button><div class="accb__detail"><div class="accb__detail-inner"><p>Solar control security film combines the impact resistance of 8-15 mil security film with meaningful heat rejection and UV blocking — a practical choice for <a href="/applications/office/">Philadelphia office buildings</a> where entry glass faces south or west and gets uncomfortably hot in the afternoon. It addresses the safety and security need without sacrificing the <a href="/benefits/energy-savings/">thermal comfort</a> of the building interior. Available in tinted and reflective options.</p><img class="accb__mobile-img" src="/images/security-window-film-philadelphia-solar-security-detail.webp" alt="Solar control security film detail on Philadelphia entry glass" title="Solar control security film detail on Philadelphia entry glass" loading="lazy" /></div></div></div>
    <div class="accb__row" data-row data-index="2"><button class="accb__trigger" data-trigger aria-expanded="false"><span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 8h8v8H8z"/><path d="M4 12h4M16 12h4"/></svg></span><span class="accb__row-title">Heavy Security Film — High-Risk Openings</span><span class="accb__chev" aria-hidden="true">›</span></button><div class="accb__detail"><div class="accb__detail-inner"><p>At 12-15 mil, heavy security film is specified for Philadelphia's highest-risk entry points — <a href="/applications/schools-universities/">school</a> sidelites, bank teller windows, pharmacy dispensing areas, and government building entries. The additional thickness increases tensile strength and break strength, forcing intruders to apply significantly more force and time to breach the opening. In a documented Texas school district deployment, Madico 14 mil security film was installed across 48 school buildings covering 15,000 square feet of glazing — chosen specifically because its clear appearance does not alert would-be intruders that protection is in place. According to the nonprofit International Window Film Association (IWFA), delaying intruder entry with security window film on windows and doors "may buy time to allow for more response time and save lives." Often paired with an attachment system for maximum effectiveness. For government and critical infrastructure sites, review <a href="https://www.cisa.gov/topics/physical-security" target="_blank" rel="noopener">CISA Physical Security guidance</a> for glazing vulnerability assessment.</p><img class="accb__mobile-img" src="/images/security-window-film-philadelphia-heavy-film-detail.webp" alt="Heavy security film detail for Philadelphia high-risk glass" title="Heavy security film detail for Philadelphia high-risk glass" loading="lazy" /></div></div></div>
    <div class="accb__row" data-row data-index="3"><button class="accb__trigger" data-trigger aria-expanded="false"><span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v14H4z"/><path d="M8 5v14M16 5v14"/><path d="M4 9h4M16 9h4M4 15h4M16 15h4"/></svg></span><span class="accb__row-title">Attachment System — Completing the Security Solution</span><span class="accb__chev" aria-hidden="true">›</span></button><div class="accb__detail"><div class="accb__detail-inner"><p>An attachment system anchors the filmed glass to the window frame at its edge. Without attachment, a broken filmed pane can sometimes be pushed out of the frame despite the film holding the fragments together. With attachment, the broken filmed pane stays in the opening and must be repeatedly struck before it can be breached. For <a href="/applications/schools-universities/">school entries</a>, pharmacy windows, and <a href="/applications/retail/">retail storefronts</a> facing smash-and-grab risk, we strongly recommend security film plus an attachment system as a complete solution.</p><img class="accb__mobile-img" src="/images/security-window-film-philadelphia-attachment-detail.webp" alt="Attachment system detail for Philadelphia security film" title="Attachment system detail for Philadelphia security film" loading="lazy" /></div></div></div>
  </div><div class="accb__media"><img class="accb__img is-active" data-img data-index="0" src="/images/security-window-film-philadelphia-clear-film-detail.webp" alt="Clear safety film on Philadelphia glass" title="Clear safety film on Philadelphia glass" loading="lazy" /><img class="accb__img" data-img data-index="1" src="/images/security-window-film-philadelphia-solar-security-detail.webp" alt="Solar control security film on Philadelphia glass" title="Solar control security film on Philadelphia glass" loading="lazy" /><img class="accb__img" data-img data-index="2" src="/images/security-window-film-philadelphia-heavy-film-detail.webp" alt="Heavy security film for Philadelphia high-risk glass" title="Heavy security film for Philadelphia high-risk glass" loading="lazy" /><img class="accb__img" data-img data-index="3" src="/images/security-window-film-philadelphia-attachment-detail.webp" alt="Attachment system for Philadelphia security film" title="Attachment system for Philadelphia security film" loading="lazy" /></div></div></section>

  <!-- ══ BEFORE/AFTER SLIDER — The Sacrificial Layer in Action ══ -->
  <section class="sf-slider-wrap"><div class="sf-slider-wrap__header"><div class="sf-slider-wrap__eyebrow">THE FILM IN ACTION</div><h2 class="sf-slider-wrap__title">Security Window Film in Action</h2><p class="sf-slider-wrap__sub">Drag the handle to see the difference between unprotected glass and the same glass with security film applied — fragments held in place, opening maintained, no dangerous shards.</p></div><div class="sf-slider-wrap__slider"><div class="before-after" style="--pos:50%"><div class="before-after__frame"><img src="/images/security-film-philadelphia-before-unprotected.webp" alt="Unprotected Philadelphia glass shattered with loose fragments" title="Unprotected Philadelphia glass shattered with loose fragments" class="before-after__img before-after__img--before" draggable="false" loading="lazy" /><div class="before-after__after-wrap"><img src="/images/security-film-philadelphia-after-film-applied.webp" alt="Philadelphia glass with security film holding fragments in place" title="Philadelphia glass with security film holding fragments in place" class="before-after__img before-after__img--after" draggable="false" loading="lazy" /></div><span class="before-after__tag before-after__tag--before">Unprotected glass</span><span class="before-after__tag before-after__tag--after">Security film applied</span><div class="before-after__handle" role="slider" tabindex="0" aria-label="Drag to compare unprotected glass and security film applied" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50"><span class="before-after__handle-grip"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M8 7L3 12L8 17M16 7L21 12L16 17" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div></div></div></div></section>

  <!-- ══ WHERE IT'S NEEDED — What We Do Panels ══ -->
  <section class="sf-wwd-wrap"><div class="sf-wwd-wrap__header"><div class="sf-wwd-wrap__eyebrow">WHERE IT'S NEEDED</div><h2 class="sf-wwd-wrap__title">Where Security Window Film Protects Philadelphia</h2><p class="sf-wwd-wrap__sub">Security window film for Philadelphia is most valuable at the building openings that face the highest risk — and there is rarely just one.</p></div><div class="sf-wwd-panels">
    <a href="/applications/schools-universities/" class="wwd__panel"><div class="wwd__panel-img-wrap"><img src="/images/security-film-philadelphia-school-entry.webp" alt="Philadelphia school entry protected with security window film" title="Philadelphia school entry protected with security window film" class="wwd__panel-img" loading="lazy" /></div><div class="wwd__panel-overlay"></div><div class="wwd__panel-content"><h3>Schools &amp; Universities</h3><p class="wwd__panel-desc">Philadelphia schools install security window film at entry vestibule sidelites, ground-floor classroom windows, and main entry doors. Security window film delays forced entry and contains fragments from accidental breakage throughout the building.</p><span class="wwd__panel-arrow">Learn more →</span><span class="wwd__panel-line"></span></div></a>
    <a href="/applications/retail/" class="wwd__panel"><div class="wwd__panel-img-wrap"><img src="/images/security-film-philadelphia-retail-storefront.webp" alt="Philadelphia retail storefront with security window film" title="Philadelphia retail storefront with security window film" class="wwd__panel-img" loading="lazy" /></div><div class="wwd__panel-overlay"></div><div class="wwd__panel-content"><h3>Retail Storefronts</h3><p class="wwd__panel-desc">Smash-and-grab attacks target storefront glass specifically because it is fast to break. Security window film keeps glass in the frame after strikes, slowing access to merchandise, staff, and cash.</p><span class="wwd__panel-arrow">Learn more →</span><span class="wwd__panel-line"></span></div></a>
    <a href="/applications/office/" class="wwd__panel"><div class="wwd__panel-img-wrap"><img src="/images/security-film-philadelphia-hospital-lobby.webp" alt="Philadelphia hospital lobby glass protected with security film" title="Philadelphia hospital lobby glass protected with security film" class="wwd__panel-img" loading="lazy" /></div><div class="wwd__panel-overlay"></div><div class="wwd__panel-content"><h3>Healthcare &amp; Hospitals</h3><p class="wwd__panel-desc">Philadelphia hospitals and medical facilities use security film at accessible entries, pharmacy dispensing windows, and patient-area glass where both fragment retention and forced-entry delay protect staff, patients, and controlled substances.</p><span class="wwd__panel-arrow">Learn more →</span><span class="wwd__panel-line"></span></div></a>
    <a href="/applications/office/" class="wwd__panel"><div class="wwd__panel-img-wrap"><img src="/images/security-film-philadelphia-office-building.webp" alt="Philadelphia office building with invisible security window film" title="Philadelphia office building with invisible security window film" class="wwd__panel-img" loading="lazy" /></div><div class="wwd__panel-overlay"></div><div class="wwd__panel-content"><h3>Offices &amp; Commercial</h3><p class="wwd__panel-desc">Security window film gives Philadelphia office buildings invisible security without bars, grilles, or polycarbonate overlays. It is compatible with most existing glazing and does not alter the building's exterior appearance.</p><span class="wwd__panel-arrow">Learn more →</span><span class="wwd__panel-line"></span></div></a>
  </div></section>

  <!-- ══ GALLERY BANNER — OUR WORK ══ -->
  <section class="gallery-banner gallery-banner--light"><div class="gallery-banner__inner"><div class="gallery-banner__text"><p class="gallery-banner__eyebrow">OUR WORK</p><h2 class="gallery-banner__title" aria-label="OUR WORK."><span class="gallery-banner__title-line">OUR</span><span class="gallery-banner__title-line">WORK.</span></h2><p class="gallery-banner__desc">Real security window film installations across Philadelphia schools, retail storefronts, healthcare facilities, and office buildings — every opening assessed, filmed, and protected by our certified team.</p></div><div class="gallery-banner__gallery"><div class="gallery-banner__strips">
