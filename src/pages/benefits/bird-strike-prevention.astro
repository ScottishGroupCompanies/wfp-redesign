---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import FlipWords from '../../components/FlipWords.astro';
import CategoryBlogFeed from '../../components/CategoryBlogFeed.astro';

const title = 'Bird Strike Window Film Philadelphia | Bird-Safe Glass';
const description = 'Bird strike window film for Philadelphia buildings. UV-reflective and fritted patterns that protect birds without changing how your glass looks.';
const heroImage = '/images/bird-strike-window-film-philadelphia-hero.jpg';

const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Benefits", "item": "https://www.windowfilmphiladelphia.net/benefits/" },
      { "@type": "ListItem", "position": 3, "name": "Bird Strike Window Film", "item": "https://www.windowfilmphiladelphia.net/benefits/bird-strike-prevention/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.windowfilmphiladelphia.net/benefits/bird-strike-prevention/",
    "name": title,
    "description": description,
    "dateModified": new Date().toISOString().slice(0, 10),
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".br-hero__title", ".br-why__headline", ".swt-faq__a"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Bird Strike Window Film Types — Philadelphia",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Bird Divert UV-Reflective Film", "description": "UV-reflective dot pattern visible to birds, transparent to humans. Meets ABC 2x4 Rule with 2-inch spacing." },
      { "@type": "ListItem", "position": 2, "name": "Fritted Ceramic Dot Pattern Film", "description": "Opaque ceramic frit dots or stripes applied to glass. ABC-compliant at 50% coverage or greater." },
      { "@type": "ListItem", "position": 3, "name": "Etched and Textured Decorative Film", "description": "Decorative patterned film that creates visible surface contrast birds detect as a solid barrier." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Bird Strike Window Film Philadelphia",
    "description": "UV-reflective, fritted, and patterned bird-safe window film for Philadelphia office buildings, universities, hospitals, and government facilities. Protects birds without changing the appearance of your glass.",
    "brand": { "@type": "Brand", "name": "Window Film Philadelphia" },
    "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "areaServed": "Philadelphia, PA" },
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "43", "bestRating": "5" },
    "review": [
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Karen B." }, "reviewBody": "Our Center City office tower was killing dozens of birds every year. After the Bird Divert film went on the south facade, we've had zero strikes reported. The film is invisible from inside and looks completely normal from the street." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Thomas R." }, "reviewBody": "Temple University required bird-safe glazing for our new academic building. The fritted film solution was the most cost-effective option and the compliance documentation was thorough." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Diane M." }, "reviewBody": "The Wissahickon watershed runs right past our building. We installed bird-safe film after seeing too many casualties. The installation was done over a weekend and we've seen a dramatic reduction." }
    ]
  }
];

const faqItems = [
  { question: 'How does bird strike window film work?', answer: 'Bird strike prevention film works by making glass visible to birds. Birds cannot perceive glass as a solid barrier — they see only reflections of sky and trees. Film creates a visible pattern on the glass surface that birds recognize as a solid object and avoid. UV-reflective films like Bird Divert use UV wavelengths visible to birds but invisible to humans. Fritted and patterned films use physical contrast patterns detectable by birds under all lighting conditions.' },
  { question: 'Will bird-safe film change the appearance of my building?', answer: 'UV-reflective films like Bird Divert are visually transparent to human observers — the UV dot pattern is not visible to people and does not alter the exterior appearance of the building. Fritted and patterned films create a visible surface treatment — the degree of visual change depends on the pattern density and type. During your consultation we will review all options and show you samples so you can choose the solution that balances bird safety with the aesthetic requirements of your building.' },
  { question: 'What is the ABC 2x4 Rule for bird-friendly glass?', answer: 'The American Bird Conservancy 2x4 Rule is the most widely adopted standard for bird-friendly glass treatments. It requires that any pattern applied to glass have elements spaced no more than 2 inches apart horizontally and 4 inches apart vertically. This spacing creates a visual barrier dense enough that birds consistently detect and avoid it. Films that meet the 2x4 Rule are considered effective deterrents.' },
  { question: 'How many birds are killed by window collisions in Philadelphia each year?', answer: 'Nationwide, estimates range from 600 million to 1 billion bird deaths annually from glass collisions — making building glass one of the leading causes of bird mortality in North America. Philadelphia is a significant bird migration corridor, particularly during spring and fall migration. Buildings along the Schuylkill River and in areas adjacent to Wissahickon and Pennypack parks see elevated collision rates due to proximity to migratory routes.' },
  { question: 'Does Philadelphia require bird-safe glazing?', answer: 'Philadelphia has adopted bird-friendly building design requirements for new construction and major renovations in certain categories. The requirements reference the ABC 2x4 Rule and specify minimum coverage for glazing in bird-hazard zones. Our team is familiar with Philadelphia building code requirements and can document compliance for permit applications. We recommend consulting your architect or permit authority for the specific requirements applicable to your project.' },
  { question: 'Can bird strike film be applied to existing buildings?', answer: 'Yes. Film is a retrofit solution specifically designed for existing glass. It applies to the existing glass surface without glass removal or replacement and is far more cost-effective than replacing glass with fritted or etched glazing. Most commercial installations can be completed with minimal disruption during normal business hours.' },
  { question: 'How long does bird-safe window film last?', answer: 'Bird strike prevention films carry manufacturer warranties of 10–15 years for commercial exterior applications and 10 years for interior-applied versions. UV-reflective films like Bird Divert maintain their UV-reflective properties for the duration of the warranty period. Performance longevity depends on film type, application method, and exposure conditions.' },
  { question: 'Does UV film really work if humans cannot see it?', answer: 'Yes. Birds have tetrachromatic vision — they see four color channels including ultraviolet. Humans are trichromatic and cannot perceive UV wavelengths. Bird Divert film reflects UV light at wavelengths birds detect as bright and solid while remaining visually transparent to human observers. This is the same principle used in UV-reflective spider webs — birds see them clearly as objects to avoid.' },
  { question: 'Which Philadelphia buildings are required to have bird-safe glazing?', answer: 'Philadelphia building code applies bird-friendly glazing requirements to new construction and substantial renovations in specified building categories, particularly buildings exceeding certain square footage thresholds and those in proximity to designated natural areas. Historic buildings may have specific exemptions. Our team reviews your building type and permit category during the consultation and advises on applicable requirements.' },
  { question: 'How do I get bird strike window film installed in Philadelphia?', answer: 'Contact us for a free site assessment. We evaluate your building orientation, glass type, existing glazing treatment, and the proximity of bird flight paths and vegetation. We then recommend the appropriate film — UV-reflective, fritted pattern, or decorative — and provide a written proposal with compliance documentation if required. Most installations are completed within a single project window.' }
];

const sliderSlides = [
  {
    label: 'Bird Divert',
    step: '01',
    img: '/images/bird-divert-uv-film-philadelphia-office-glass.jpg',
    alt: 'Bird Divert UV-reflective bird strike window film in Philadelphia on office tower glass',
    title: 'Bird Divert UV-reflective bird strike window film in Philadelphia office glass',
    heading: 'Bird Divert. Invisible to You. Unmistakable to Birds.',
    desc: 'Bird strike window film in Philadelphia projects often begin with Bird Divert UV-reflective film because it applies a micro-dot pattern to glass that reflects ultraviolet light at wavelengths birds can see but humans cannot. The dots are spaced at 2-inch intervals horizontally — meeting the ABC 2x4 Rule standard. From inside the building, the glass looks completely clear. From outside, the glass appears unaltered to human observers. Birds detect the UV dots as a solid pattern and consistently avoid the glass. Bird Divert is validated to reduce bird-glass collisions by up to 76% in controlled studies according to the American Bird Conservancy testing program.',
    faqs: [
      ['Does Bird Divert actually work indoors at reducing strikes?', "Bird Divert is designed for exterior application on glass surfaces directly in the bird's flight path. Interior-applied versions can help in select conditions, but exterior placement gives birds the earliest and clearest signal."],
      ['Can I see the dots from inside my office?', 'No. The UV-reflective dots are invisible to human observers under normal lighting conditions, so the interior view remains clear while the exterior glass becomes visible to birds.'],
      ["Is Bird Divert approved for Philadelphia's bird-friendly building requirements?", "Yes. Bird Divert meets the ABC 2x4 Rule specifications referenced in Philadelphia's bird-friendly building requirements, and we provide compliance documentation for project files."]
    ],
    cta: 'Get a Bird Divert estimate →'
  },
  {
    label: 'Fritted Pattern',
    step: '02',
    img: '/images/fritted-pattern-bird-safe-film-philadelphia.jpg',
    alt: 'Fritted ceramic bird safe film in Philadelphia applied to commercial glass',
    title: 'Fritted pattern bird-safe glass film for Philadelphia commercial buildings',
    heading: 'Fritted Pattern. Visible Coverage. ABC Compliant.',
    desc: 'Fritted ceramic dot or stripe pattern films apply an opaque physical pattern to the glass surface. Unlike UV films, fritted patterns are visible to both birds and human observers — the pattern creates a clear visual barrier that birds consistently avoid. Patterns spaced at 2 inches horizontal × 4 inches vertical achieve at least 50% coverage, the threshold at which collisions are reliably prevented. This is the most widely specified bird-safe film type for Philadelphia new construction compliance. Bird safe film in Philadelphia fritted applications typically covers 50–100% of the glass area depending on the pattern density required.',
    faqs: [
      ['How visible is the fritted pattern?', 'It is visible by design. The pattern can be subtle, architectural, or graphic, but it must create enough contrast and density for birds to read the surface as solid.'],
      ['Can you provide compliance documentation?', 'Yes. For bird strike window film in Philadelphia code reviews, we provide pattern spacing, coverage, product data, and ABC 2x4 Rule documentation for architects and permit files.'],
      ['Are there aesthetic options beyond dots?', 'Yes. Dots, lines, gradients, and custom decorative layouts can be specified as long as the pattern spacing and coverage meet bird-safe criteria.']
    ],
    cta: 'Get a fritted film estimate →'
  },
  {
    label: 'Decorative',
    step: '03',
    img: '/images/bird-safe-film-philadelphia-decorative-pattern.jpg',
    alt: 'Decorative patterned bird strike window film in Philadelphia lobby glass',
    title: 'Decorative patterned bird strike prevention film for Philadelphia glass',
    heading: 'Decorative Pattern. Bird Safety Meets Design.',
    desc: 'Decorative etched, textured, and patterned films can meet bird-safe standards when the pattern density and element spacing are specified to meet the ABC 2x4 Rule. This approach is popular for bird strike window film in Philadelphia buildings where bird safety requirements intersect with design goals — the same film delivers code compliance and a distinctive architectural statement. 3M Fasara and Solyx decorative series both offer patterns that can be specified for bird-safe compliance.',
    faqs: [
      ['Do decorative patterns count for compliance?', 'They can. Decorative film must be dense enough and spaced correctly; we review the selected pattern against the ABC 2x4 Rule before recommending it for compliance use.'],
      ['Can the pattern match our architecture?', 'Yes. We can use etched, frosted, gradient, or custom graphic patterns so the bird-safe treatment looks intentional on lobbies, bridges, and campus buildings.'],
      ['Can this support LEED goals?', 'Bird-friendly design strategies may support sustainability narratives and project documentation. We provide product and pattern records your design team can include in LEED or owner requirement files.']
    ],
    cta: 'Explore decorative bird-safe options →'
  }
];

const gallery = [
  ['/images/bird-strike-window-film-installation-philadelphia.jpg', 'Office tower bird strike window film in Philadelphia installation in Center City', 'Office tower installation — Center City'],
  ['/images/bird-safe-film-philadelphia-office-tower.jpg', 'Bird-safe film on Philadelphia university campus glass in University City', 'University campus — University City'],
  ['/images/bird-strike-prevention-film-philadelphia-campus.jpg', 'Bird strike prevention film on Philadelphia hospital health campus glass', 'Hospital health campus — Philadelphia'],
  ['/images/bird-safety-window-film-philadelphia-hospital.jpg', 'Bird safety film on Philadelphia commercial high-rise glass facade', 'Commercial high-rise — Market Street'],
  ['/images/bird-divert-film-philadelphia-commercial.jpg', 'Bird Divert film on Philadelphia government building glass', 'Government building — Old City'],
  ['/images/bird-safe-glass-film-philadelphia-residential.jpg', 'Bird-safe glass film on Philadelphia residential building near Wissahickon', 'Residential building — Wissahickon']
];

const panels = [
  ['/images/bird-strike-film-philadelphia-office-building.jpg', 'Office Towers', 'Center City glass curtain walls along migration corridors', 'Bird strike window film in Philadelphia office towers treats high-reflection glass where sky, trees, and river corridors mirror into the facade. UV-reflective or fritted films preserve the commercial look while helping birds detect the barrier.'],
  ['/images/bird-safety-film-philadelphia-university-campus.jpg', 'Universities & Campuses', 'Temple, Drexel, UPenn, Jefferson with large glass facades', 'Campus buildings often combine transparent bridges, atriums, and landscaped courtyards. Bird strike window film in Philadelphia campus projects can be specified as Bird Divert, fritted pattern, or decorative film tied to architecture.'],
  ['/images/bird-strike-window-film-philadelphia-hospital.jpg', 'Hospitals & Medical', 'Jefferson Health, Penn Medicine, CHOP, campus buildings near green space', 'Medical campuses use large windows near courtyards, trees, and patient gardens. Bird-safe treatments reduce collision risk without darkening patient rooms or public corridors.'],
  ['/images/bird-safe-film-philadelphia-government-building.jpg', 'Government & Civic', 'Municipal buildings, federal facilities, civic architecture', 'Civic buildings need durable, documented treatments that respect architecture and public visibility. Patterned bird-safe glazing gives facility teams a retrofit path without replacing existing glass.']
];

const resources = [
  ['/resources/bird-strike-window-film-abc-bird-friendly-building-design-guidelines-philadelphia.pdf', 'American Bird Conservancy — Bird-Friendly Building Design Guidelines'],
  ['/resources/bird-strike-window-film-3m-scotchshield-bird-divert-spec-philadelphia.pdf', 'Bird Divert UV-Reflective Film — Product Specification'],
  ['/resources/bird-strike-window-film-solyx-fritted-pattern-spec-philadelphia.pdf', 'Solyx Fritted Pattern Film — Bird-Safe Specification'],
  ['/resources/bird-strike-window-film-llumar-bird-safe-architectural-spec-philadelphia.pdf', 'LLumar Architectural Film — Bird-Safe Application Guide'],
  ['/resources/bird-strike-window-film-collision-research-american-bird-conservancy-philadelphia.pdf', 'Bird-Glass Collision Research — American Bird Conservancy']
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={heroImage}
  serviceName="Bird Strike Window Film"
  serviceDesc="Bird strike window film in Philadelphia for office buildings, campuses, hospitals, and civic facilities that need UV-reflective, fritted, or patterned bird-safe glass."
  serviceUrl="https://www.windowfilmphiladelphia.net/benefits/bird-strike-prevention/"
  faqItems={faqItems}
  schemas={pageSchemas}
>
  <section class="br-hero">
    <div class="br-hero__bg" style={`background-image: url('${heroImage}')`} role="img" aria-label="Bird strike window film in Philadelphia on commercial bird-safe glass"></div>
    <div class="br-hero__overlay"></div>
    <div class="br-hero__content">
      <p class="br-hero__eyebrow">Philadelphia Bird-Safe Glazing</p>
      <h1 class="br-hero__title">Bird Strike Window Film for Philadelphia</h1>
      <p class="br-hero__animated-line">
        <FlipWords
          words={["for Office Towers", "for Universities", "for Hospitals", "for Government Buildings"]}
          staticText=""
          class="br-hero__flip"
        />
      </p>
      <p class="br-hero__subtitle">UV-reflective and patterned films that make your glass visible to birds — installed on Philadelphia commercial buildings without changing how your glass looks from inside or out.</p>
      <div class="br-hero__cta">
        <a href="/contact/" class="br-btn br-btn--primary">Get a Free Assessment</a>
        <a href="tel:2673947980" class="br-btn br-btn--ghost">Call (267) 394-7980</a>
      </div>
      <div class="br-hero__stats-panel" aria-label="Bird strike prevention statistics">
        <div><strong>1 Billion</strong><span>Birds/year from glass</span></div>
        <div><strong>ABC 2×4</strong><span>Rule Compliant</span></div>
        <div><strong>99%</strong><span>UV Blocked</span></div>
        <div><strong>10–15yr</strong><span>Manufacturer Warranty</span></div>
      </div>
    </div>
  </section>

  <div class="swt-body">
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by Philadelphia office buildings, universities, hospitals, and building owners along migration corridors.</p>
        <BrandLogos />
      </div>
    </section>

    <section class="br-why" id="problem">
      <div class="br-why__container">
        <div class="br-why__image-wrap">
          <img src="/images/bird-strike-window-film-philadelphia-problem.jpg" alt="Bird strike window film in Philadelphia protecting reflective glass near trees" title="Bird strike window film in Philadelphia problem glass near vegetation" class="br-why__image" loading="lazy" />
          <div class="br-why__stat-card">600M–1B birds killed by glass annually in the U.S. — American Bird Conservancy</div>
        </div>
        <div class="br-why__content">
          <p class="br-eyebrow">The Problem</p>
          <h2 class="br-why__headline">Philadelphia Glass Is Invisible to Birds — and Lethal</h2>
          <p>Bird strike window film in Philadelphia solves a glass visibility problem, not a tinting problem. Birds read reflected trees, sky, and water as flyable habitat, so a clear facade can become a lethal barrier during migration.</p>
          <ul class="br-checks">
            <li>Birds cannot perceive glass as a solid surface — they see only reflections of sky and vegetation.</li>
            <li>Philadelphia sits along the Atlantic Flyway, one of North America's busiest bird migration corridors. Buildings near the Schuylkill River, Wissahickon Valley, and Pennypack Creek see the highest collision rates.</li>
            <li>Bird safety window film for Philadelphia buildings is now required for many new construction projects under local building code referencing the ABC 2x4 Rule.</li>
            <li>Without treatment, standard commercial glass — even glass that looks tinted — is effectively invisible to migrating birds.</li>
          </ul>
          <p class="br-why__closing">"Building glass kills hundreds of millions of birds every year — it is one of the top direct human-caused sources of bird mortality," according to the <a href="https://abcbirds.org/glass-collisions/" target="_blank" rel="noopener">American Bird Conservancy</a>. Where design is also a priority, we can coordinate bird strike window film in Philadelphia with <a href="/benefits/decorative-promotional/">decorative window film</a> that gives glass a visible, intentional pattern. Philadelphia buildings near the Schuylkill corridor or Wissahickon Valley may also benefit from our <a href="/applications/office/">commercial office window film</a> services, which cover energy, glare, and safety alongside bird-safe glazing.</p>
          <a href="/contact/" class="br-link">Schedule a glass risk review →</a>
        </div>
      </div>
    </section>

    <section class="br-slider" id="brSlider" aria-label="Bird-safe film types">
      <div class="br-slider__track" id="brTrack">
        {sliderSlides.map((slide) => (
          <article class="br-slider__slide">
            <img src={slide.img} alt={slide.alt} title={slide.title} class="br-slider__bg" loading="lazy" />
            <div class="br-slider__overlay"></div>
            <div class="br-slider__content">
              <p class="br-slider__step">{slide.step}</p>
              <h2 class="br-slider__title">{slide.heading}</h2>
              <p class="br-slider__desc">{slide.desc}</p>
              <div class="br-slider__faq">
                {slide.faqs.map(([question, answer]) => (
                  <details class="br-slider__faq-item">
                    <summary>{question}</summary>
                    <p>{answer}</p>
                  </details>
                ))}
              </div>
              <a href="/contact/" class="br-slider__cta">{slide.cta}</a>
            </div>
          </article>
        ))}
      </div>
      <nav class="br-slider__nav" aria-label="Bird strike film type slides">
        {sliderSlides.map((slide, i) => <button class:list={["br-slider__nav-item", { "is-active": i === 0 }]} data-brnav={i}>{slide.label}</button>)}
      </nav>
      <button class="br-slider__arrow br-slider__arrow--prev" id="brPrev" aria-label="Previous slide">‹</button>
      <button class="br-slider__arrow br-slider__arrow--next" id="brNext" aria-label="Next slide">›</button>
    </section>

    <section class="br-bento" id="technology">
      <div class="br-section-head">
        <p class="br-eyebrow">Why It Works</p>
        <h2>The Only Solution That Makes Glass Visible</h2>
        <p>Bird-safe window film turns reflective Philadelphia glass into a readable surface while preserving daylight, views, and architectural intent.</p>
      </div>
      <div class="br-bento__grid">
        <article class="br-bento-card br-bento-card--hero">
          <svg width="58" height="58" viewBox="0 0 58 58" fill="none" aria-hidden="true"><path d="M10 40c11-4 17-14 19-28 8 6 10 16 5 28" stroke="#A8C96B" stroke-width="2" stroke-linecap="round"/><rect x="38" y="8" width="10" height="42" rx="2" stroke="#A8C96B" stroke-width="2"/><path d="M42 14h4M42 23h4M42 32h4M42 41h4" stroke="#A8C96B" stroke-width="1.5"/></svg>
          <h3>UV Wavelengths Birds See. Humans Don't.</h3>
          <p>Birds have tetrachromatic vision — they see 4 color channels including UV, which makes UV-reflective films detectable as solid objects while remaining invisible to human observers. That is why this treatment can protect Philadelphia flight paths without forcing a dark or heavy facade change.</p>
          <span class="br-pill">Bird Tetrachromatic Vision</span>
        </article>
        <article class="br-bento-card br-bento-card--photo">
          <img src="/images/bird-strike-window-film-philadelphia-building.jpg" alt="Bird strike window film in Philadelphia on reflective building exterior" title="Bird strike window film in Philadelphia building exterior" loading="lazy" />
          <div><h3>Exterior Glass Facades</h3><p>UV-reflective dots suit buildings where appearance cannot change.</p></div>
        </article>
        <article class="br-bento-card br-bento-card--photo">
          <img src="/images/bird-safety-window-film-philadelphia-high-rise.jpg" alt="Bird-safe high-rise film installation for Philadelphia office glass" title="Bird-safe high-rise film installation in Philadelphia" loading="lazy" />
          <div><h3>Campus & High-Rise Zones</h3><p>Patterned glass treatments protect migration corridors around tall glass.</p></div>
        </article>
        <article class="br-bento-card br-bento-card--dark">
          <h3>Meets ABC 2×4 Rule</h3>
          <p>Dots, stripes, or textures are specified so open spaces between pattern elements stay within the 2-inch by 4-inch standard birds detect.</p>
          <span class="br-pill">Compliance Ready</span>
        </article>
        <article class="br-bento-card br-bento-card--dark">
          <h3>No Glass Replacement Required</h3>
          <p>Bird-safe film retrofits existing glass, avoiding full glazing replacement while creating measurable contrast birds can detect.</p>
          <span class="br-pill">Retrofit Friendly</span>
        </article>
        <article class="br-bento-card br-bento-card--retail">
          <img src="/images/bird-safe-film-philadelphia-glass-wall.jpg" alt="Bird strike prevention film on Philadelphia glass wall with bird-safe pattern" title="Bird-safe film on Philadelphia glass wall" loading="lazy" />
          <div><span class="br-pill">Up to 76%</span><h3>Collision Reduction</h3><p>UV-reflective film has reduced bird-glass collisions by up to 76% in ABC testing.</p></div>
        </article>
      </div>
    </section>

    <section class="br-masonry">
      <div class="br-section-head">
        <p class="br-eyebrow">Our Work</p>
        <h2>Bird-Safe Glass Installed Across Philadelphia</h2>
        <p>Installed bird-safe glass treatments for offices, universities, hospitals, civic buildings, and residential properties near active habitat.</p>
      </div>
      <div class="br-masonry__grid">
        {gallery.map(([src, alt, caption]) => (
          <figure class="br-masonry__item">
            <img src={src} alt={alt} title={alt} loading="lazy" />
            <figcaption>{caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="br-panels">
      <div class="br-section-head">
        <p class="br-eyebrow">WHERE WE INSTALL</p>
        <h2>Bird-Safe Glass Across Philadelphia</h2>
        <p>Bird-safe glazing treatment is most urgent where Philadelphia reflective glass intersects vegetation, river corridors, campus landscapes, and night-lit facades.</p>
      </div>
      <div class="br-panels__grid">
        {panels.map(([src, title, sub, desc]) => (
          <article class="br-panels__panel">
            <img src={src} alt={`${title} bird strike window film in Philadelphia`} title={`${title} bird-safe glass in Philadelphia`} loading="lazy" />
            <div class="br-panels__overlay"></div>
            <div class="br-panels__content">
              <h3>{title}</h3>
              <p class="br-panels__sub-sm">{sub}</p>
              <p>{desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="swt-stats">
      <div class="container br-stats__row">
        <div><strong>600M–1B</strong><span>Birds killed by building glass annually (U.S.)</span></div>
        <div><strong>ABC 2×4</strong><span>Rule standard met by Bird Divert and fritted films</span></div>
        <div><strong>76%</strong><span>Collision reduction from UV-reflective film (ABC testing)</span></div>
        <div><strong>10–15yr</strong><span>Manufacturer warranty on commercial bird-safe films</span></div>
      </div>
    </section>

    <section class="br-process-split">
      <div class="br-process-split__container">
        <div>
          <p class="br-eyebrow">Process</p>
          <h2>From Collision Risk to Documented Bird-Safe Glass</h2>
          <details open>
            <summary>01 Site Assessment</summary>
            <p>We evaluate your building's glass orientation, proximity to vegetation and flight paths, and applicable Philadelphia building code requirements. We identify which glass zones require treatment.</p>
          </details>
          <details>
            <summary>02 Film Selection & Compliance Review</summary>
            <p>We recommend the appropriate bird-safe film type — UV-reflective, fritted, or decorative — and provide ABC 2x4 Rule compliance documentation for permit applications if required. Philadelphia bird-safe projects often involve architects, sustainability managers, and facilities teams — so the documentation is built for review.</p>
          </details>
          <details>
