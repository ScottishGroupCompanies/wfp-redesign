<script is:inline>
  const track = document.getElementById('brTrack');
  const slides = Array.from(document.querySelectorAll('.br-slider__slide'));
  const navButtons = Array.from(document.querySelectorAll('[data-brnav]'));
  let currentSlide = 0;
  function showSlide(index) {
    if (!track || slides.length === 0) return;
    currentSlide = (index + slides.length) % slides.length;
    track.style.transform = `translateX(-${currentSlide * 100}%)`;
    navButtons.forEach((button, i) => button.classList.toggle('is-active', i === currentSlide));
  }
  document.getElementById('brPrev')?.addEventListener('click', () => showSlide(currentSlide - 1));
  document.getElementById('brNext')?.addEventListener('click', () => showSlide(currentSlide + 1));
  navButtons.forEach((button) => button.addEventListener('click', () => showSlide(Number(button.dataset.brnav))));
  document.querySelectorAll('.swt-faq__q').forEach((button) => {
    button.addEventListener('click', () => button.closest('.swt-faq__item')?.classList.toggle('is-open'));
  });
</script>
