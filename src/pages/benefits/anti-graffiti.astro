---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Anti-Graffiti Window Film Philadelphia | Glass & Metal';
const description = 'Anti-graffiti window film protecting Philadelphia glass, metal, and mirrors from scratches, acid etching, and tagging. Replace the film — not the surface.';

const faqItems = [
  { question: 'Is anti-graffiti film clear? Will it change how my glass looks?', answer: 'Glass Shield anti-graffiti window film is optically clear and virtually invisible — it does not tint, darken, or distort glass. Metal Shield is not clear; it is finish-matched to the specific metal substrate. Both preserve the full appearance of the protected surface while acting as a sacrificial layer.' },
  { question: 'How does the sacrificial layer concept work?', answer: 'The film is designed to absorb vandalism damage rather than letting it reach the underlying surface. When scratches, acid etching, or graffiti damage the film, our team removes and replaces the film — the glass, metal, or mirror underneath is completely unaffected. The surface looks brand new each time.' },
  { question: 'Does anti-graffiti film only protect windows?', answer: 'No. This is one of the most important things to understand about anti-graffiti film. It protects glass surfaces, metal surfaces such as stainless steel elevator interiors and door hardware, and mirrors including restroom mirrors and lobby displays. Any vandalism-prone surface can be protected.' },
  { question: 'Can it stop acid etching?', answer: 'Anti-graffiti film provides meaningful protection against acid etching attacks on glass. When acid contacts the film, it damages the film rather than the glass underneath. For severe or prolonged attacks, film replacement restores the surface. It significantly reduces the likelihood of permanent damage to the substrate.' },
  { question: 'How quickly can vandalized film be replaced?', answer: 'In most cases our team can remove damaged film and reinstall fresh film in a single visit, often the same day an incident is reported. This minimal turnaround time is a key advantage over glass replacement, which can take days or weeks and requires ordering custom panels.' },
  { question: 'What surfaces work best with anti-graffiti film?', answer: 'The film is compatible with most standard glass surfaces, stainless steel, and mirrors. It is assessed on a surface-by-surface basis — our technicians evaluate each surface before installation to confirm compatibility and identify any substrate conditions that may affect performance or adhesion.' },
  { question: 'How long does the film last before it needs replacement?', answer: 'Anti-graffiti film carries manufacturer warranties of 5–10 years depending on the product and application. In high-vandalism areas the film may be replaced after incidents as designed. The protection is ongoing — each replacement restores the surface to full protection. Long-term it is significantly more cost-effective than glass replacement.' },
  { question: 'What types of vandalism does it protect against?', answer: 'Anti-graffiti film protects against scratching and scraping, spray paint and marker tagging, acid etching, and general surface abrasion. It is most effective on surfaces that face repeated, lower-intensity vandalism. It is a surface protection product, not a structural or forced-entry deterrent.' },
  { question: 'Which Philadelphia settings benefit most from anti-graffiti film?', answer: 'The highest-value applications for anti-graffiti window film in Philadelphia include SEPTA transit stations and bus shelters, retail storefronts in Old City, Center City, and South Street corridors, stainless steel elevator interiors, school and university building glass, and restroom mirrors in public and commercial facilities.' },
  { question: 'How do I get anti-graffiti film installed?', answer: 'Contact us for a free site assessment. We will evaluate your surfaces, identify the highest-risk areas, and recommend the appropriate film for each substrate. Most commercial installations are completed with minimal disruption to your business, and we work around your schedule including after-hours for retail and transit clients.' },
];

const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Benefits", "item": "https://www.windowfilmphiladelphia.net/benefits/" },
      { "@type": "ListItem", "position": 3, "name": "Anti-Graffiti Window Film", "item": "https://www.windowfilmphiladelphia.net/benefits/anti-graffiti/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.windowfilmphiladelphia.net/benefits/anti-graffiti/",
    "name": title,
    "description": description,
    "dateModified": new Date().toISOString().slice(0, 10),
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".ag-hero__title", ".ag-hero__subtitle", ".faq__a-inner"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Anti-Graffiti Film Applications",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Retail Storefronts" },
      { "@type": "ListItem", "position": 2, "name": "Transit & Transportation" },
      { "@type": "ListItem", "position": 3, "name": "Elevator Interiors" },
      { "@type": "ListItem", "position": 4, "name": "Schools & Universities" },
      { "@type": "ListItem", "position": 5, "name": "Restaurants & Hospitality" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Anti-Graffiti Window Film Philadelphia",
    "description": "Clear sacrificial protective film for glass, metal, and mirrors. Shields Philadelphia commercial surfaces from scratches, acid etching, and graffiti vandalism.",
    "brand": { "@type": "Brand", "name": "Window Film Philadelphia" },
    "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "areaServed": "Philadelphia, PA" },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "87",
      "bestRating": "5"
    },
    "review": [
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Marcus D." }, "reviewBody": "Our Old City storefront was getting scratched every few weeks. After the anti-graffiti film went on we had two incidents and both times they just swapped the film. Total cost was a fraction of what we were spending on glass repair." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Sandra K." }, "reviewBody": "The elevator mirrors in our building were a constant maintenance headache. The film is completely invisible and since installation we have not had a single permanent scratch. The maintenance crew replaces it when needed — it is seamless." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Ray O." }, "reviewBody": "We protect three SEPTA shelter installations now. The film holds up to regular abuse and when something gets through we are back to pristine in hours not days. Game-changer for transit maintenance budgets." }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Anti-Graffiti Window Film"
  serviceDesc="Clear sacrificial film protecting Philadelphia glass, metal, and mirrors from scratches, acid etching, and graffiti vandalism."
  serviceUrl="https://www.windowfilmphiladelphia.net/benefits/anti-graffiti/"
  faqItems={faqItems}
  schemas={pageSchemas}
>

  <!-- ══ HERO — Hero Subpage (library component) ══ -->
  <section class="hs">
    <img src="/images/anti-graffiti-window-film-philadelphia-hero.jpg"
         alt="Professional installer applying anti-graffiti window film to Philadelphia commercial storefront glass"
         title="Anti-graffiti window film installation on Philadelphia storefront"
         class="hs__bg" loading="eager" />
    <div class="hs__overlay" aria-hidden="true"></div>
    <div class="hs__inner">
      <p class="hs__eyebrow">
        <span class="hs__dot" aria-hidden="true"></span>
        Philadelphia Surface Protection
      </p>
      <h1 class="hs__title">Anti-Graffiti Window Film for Philadelphia</h1>
      <p class="hs__sub">A clear sacrificial layer that absorbs vandalism damage so your glass, metal, and mirror surfaces stay pristine. When vandalism strikes, you replace the film — not the surface.</p>
      <div class="hs__cta">
        <a href="/contact/" class="hs__btn-primary">Get a Free Assessment</a>
        <a href="/benefits/" class="hs__btn-secondary">All Benefits</a>
      </div>
    </div>
  </section>

  <!-- ══ TRUST BAR ══ -->
  <section class="swt-trust">
    <div class="container">
      <p class="swt-trust__label">Trusted by Philadelphia businesses that rely on anti-graffiti window film to protect their surfaces</p>
      <BrandLogos />
    </div>
  </section>

  <!-- ══ THE SURFACES — Accordion Vertical ══ -->
  <section class="ag-accv-wrap">
    <div class="ag-accv-wrap__header">
      <div class="ag-accv-wrap__eyebrow">THE CHALLENGE</div>
      <h2 class="ag-accv-wrap__title split-reveal" data-stagger="65" aria-label="Glass, Metal, and Mirror Surfaces. Each Gets Its Own Film.">
        <span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:0">Glass,&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:1">Metal,&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:2">and&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:3">Mirror&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:4">Surfaces.</span></span>
      </h2>
      <p class="ag-accv-wrap__sub">Glass, metal, and mirrors each get vandalized differently. Each requires a specific anti-graffiti window film — Glass Shield, Metal Shield, or Mirror Shield — engineered for that substrate. Anti-graffiti window film is not one product. It is a family of surface-specific solutions.</p>
    </div>
    <div class="accv">
      <div class="accv__panel is-open" data-panel style="background-image:url('/images/anti-graffiti-film-philadelphia-glass-surface-vandalism.jpg')">
        <button class="accv__tab" data-tab aria-expanded="true">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </span>
          <span class="accv__title">Glass Surfaces</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Glass Surfaces</h3>
            <p>Storefronts, lobby partitions, transit shelter glass, and display cases face scratching, acid etching, and tagging. Glass Shield anti-graffiti window film is applied directly to the glass and is completely invisible. When damaged, it peels away cleanly and a fresh layer restores the surface immediately. According to the <a href="https://ucr.fbi.gov/crime-in-the-u.s" target="_blank" rel="noopener">FBI Uniform Crime Reports</a>, vandalism is among the most frequently reported property crimes in urban centers — Philadelphia storefronts are a primary target.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/anti-graffiti-film-philadelphia-metal-surface-vandalism.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="18" rx="1"/><path d="M8 21V3M16 21V3"/></svg>
          </span>
          <span class="accv__title">Metal Surfaces</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Metal Surfaces</h3>
            <p>Stainless steel elevator interiors, door hardware, and metal panels are prime vandalism targets — and unlike glass, they require a finish-matched anti-graffiti window film rather than a clear one. Metal Shield is available in Stainless Steel, Brushed Aluminum, and Brushed Gold. It mimics the metal surface exactly, so replacement is invisible.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/anti-graffiti-film-philadelphia-mirror-surface-vandalism.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="12" cy="12" r="4"/></svg>
          </span>
          <span class="accv__title">Mirror Surfaces</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Mirror Surfaces</h3>
            <p>Restroom mirrors, lobby display mirrors, and fitting room mirrors face scratch etching and tagging that permanently clouds the reflective coating. Mirror Shield maintains full reflectivity while providing a sacrificial surface — vandalism is absorbed by the film, the mirror underneath stays undamaged indefinitely.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ FILM TYPES — Bento Photo Grid ══ -->
  <section class="bgp ag-film-bento">
    <div class="bgp__head">
      <div class="bgp__eyebrow">THE FILM TYPES</div>
      <h2 class="bgp__title">Every Surface Has a Film Designed for It</h2>
      <p class="bgp__sub">Anti-graffiti film is not one product — it’s a family of surface-specific protective films, each engineered for a different substrate.</p>
    </div>
    <div class="bgp__grid">
      <div class="bgp__card bgp__card--lg">
        <img src="/images/anti-graffiti-window-film-philadelphia-glass-shield.jpg" alt="Glass Shield — clear anti-graffiti film for Philadelphia storefront glass" title="Glass Shield — clear anti-graffiti film for Philadelphia storefront glass" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Glass Shield</h3>
          <p>Optically clear sacrificial film for glass surfaces. Completely invisible — protects against scratching, acid etching, and tagging. Peel and replace when damaged.</p>
        </div>
      </div>
      <div class="bgp__card bgp__card--sm">
        <img src="/images/anti-graffiti-window-film-philadelphia-metal-shield.jpg" alt="Metal Shield — finish-matching anti-graffiti film for stainless steel and brushed metal" title="Metal Shield — finish-matching film for stainless steel surfaces" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Metal Shield</h3>
          <p>Finish-matched to stainless steel, brushed aluminum, or brushed gold — not clear. Mimics the surface exactly so replacement is invisible.</p>
        </div>
      </div>
      <div class="bgp__card bgp__card--sm">
        <img src="/images/anti-graffiti-window-film-philadelphia-mirror-shield.jpg" alt="Mirror Shield — reflective surface anti-graffiti film for restroom and lobby mirrors" title="Mirror Shield — anti-graffiti film for mirrors" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Mirror Shield</h3>
          <p>Maintains full mirror reflectivity while protecting the backing from scratch etching and tagging — ideal for restrooms, lobbies, and fitting rooms.</p>
        </div>
      </div>
      <div class="bgp__card bgp__card--md">
        <img src="/images/anti-graffiti-window-film-philadelphia-multi-layer.jpg" alt="Multi-Layer Glass Shield — four-layer peel-and-renew anti-graffiti film system" title="Multi-Layer Glass Shield — four-layer peel system" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Multi-Layer (Peel &amp; Renew)</h3>
          <p>A four-layer clear film system. Each layer peels individually after damage — no reinstallation needed between incidents. Ideal for high-frequency vandalism locations.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ HOW EACH FILM WORKS — Accordion Benefits (4 rows) ══ -->
  <section class="accb">
    <div class="accb__head">
      <h2 class="accb__title">How Each Film Type Works</h2>
      <p class="accb__sub">Every substrate gets an anti-graffiti window film engineered for it — the chemistry, the finish, and the replacement method all vary by surface type.</p>
    </div>
    <div class="accb__wrap">
      <div class="accb__list">
        <div class="accb__row is-open" data-row data-index="0">
          <button class="accb__trigger" data-trigger aria-expanded="true">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></span>
            <span class="accb__row-title">Glass Shield — Clear Protective Film</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Applied directly to glass — storefronts, lobby partitions, display cases, transit shelter glass, and door glass. Completely optically clear and invisible after installation. Engineered with a hard coat and optimal thickness to resist scratching, carving, and acid etching. When damaged, the film is peeled and a fresh layer reinstalled — the original glass is untouched and pristine every time.</p>
              <img class="accb__mobile-img" src="/images/anti-graffiti-window-film-philadelphia-glass-shield.jpg" alt="Glass Shield clear anti-graffiti film on Philadelphia storefront" title="Glass Shield — clear anti-graffiti film" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="1">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="18" rx="1"/><path d="M8 21V3M16 21V3"/></svg></span>
            <span class="accb__row-title">Metal Shield — Finish-Matched Film</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Unlike glass film, Metal Shield is <em>not clear</em> — it is manufactured to match the specific metal finish of the substrate. Available in Stainless Steel, Brushed Aluminum, and Brushed Gold, it visually mimics the original surface so film replacement is completely undetectable. It resists the scratching, carving, and spray paint damage that permanently mar bare metal finishes in elevator interiors, door frames, hardware, and signage.</p>
              <img class="accb__mobile-img" src="/images/anti-graffiti-window-film-philadelphia-metal-shield.jpg" alt="Metal Shield finish-matched film on stainless steel elevator" title="Metal Shield — finish-matching anti-graffiti film" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="2">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="12" cy="12" r="4"/></svg></span>
            <span class="accb__row-title">Mirror Shield — Reflective Surface Protection</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Mirrors are uniquely vulnerable: once the reflective backing is scratched or etched, the damage shows from both sides and replacement is unavoidable. Mirror Shield anti-graffiti window film is engineered specifically for reflective surfaces — learn more about our <a href="/benefits/decorative-promotional/">surface film options for Philadelphia commercial interiors</a>. — maintaining full clarity while acting as a sacrificial layer. Restroom mirrors, lobby mirrors, and fitting room mirrors in Philadelphia restaurants, retail stores, and commercial buildings benefit most.</p>
              <img class="accb__mobile-img" src="/images/anti-graffiti-window-film-philadelphia-mirror-shield.jpg" alt="Mirror Shield anti-graffiti film on restroom mirror" title="Mirror Shield — reflective surface protection" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="3">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
            <span class="accb__row-title">Multi-Layer — Peel &amp; Renew System</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>For locations that face repeated, frequent vandalism — transit stations, school corridors, high-foot-traffic storefronts — the Multi-Layer system installs four individual 4-mil clear film layers at once. After each vandalism incident, only the outermost damaged layer is peeled away, revealing a fresh protected surface beneath. No reinstallation required between incidents. The full four-layer stack is replaced only once all layers have been used, dramatically reducing service calls and downtime.</p>
              <img class="accb__mobile-img" src="/images/anti-graffiti-window-film-philadelphia-multi-layer.jpg" alt="Multi-Layer anti-graffiti film peel-and-renew system" title="Multi-Layer Glass Shield — four-layer peel system" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
      <div class="accb__media">
        <img class="accb__img is-active" data-img data-index="0" src="/images/anti-graffiti-window-film-philadelphia-glass-shield.jpg" alt="Glass Shield clear anti-graffiti film" title="Glass Shield" loading="lazy" />
        <img class="accb__img" data-img data-index="1" src="/images/anti-graffiti-window-film-philadelphia-metal-shield.jpg" alt="Metal Shield finish-matched film" title="Metal Shield" loading="lazy" />
        <img class="accb__img" data-img data-index="2" src="/images/anti-graffiti-window-film-philadelphia-mirror-shield.jpg" alt="Mirror Shield reflective surface film" title="Mirror Shield" loading="lazy" />
        <img class="accb__img" data-img data-index="3" src="/images/anti-graffiti-window-film-philadelphia-multi-layer.jpg" alt="Multi-Layer peel-and-renew film system" title="Multi-Layer" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ══ BEFORE/AFTER SLIDER — The Sacrificial Layer in Action ══ -->
  <section class="ag-slider-wrap">
    <div class="ag-slider-wrap__header">
      <div class="ag-slider-wrap__eyebrow">THE FILM IN ACTION</div>
<h2 class="ag-slider-wrap__title">Anti-Graffiti Window Film in Action</h2>
      <p class="ag-slider-wrap__sub">Drag the handle to see stainless steel elevator walls restored with Metal Shield anti-graffiti window film — finish-matched to the brushed metal surface exactly. No glass involved.</p>
    </div>
    <div class="ag-slider-wrap__slider">
      <div class="before-after" style="--pos:50%">
        <div class="before-after__frame">
          <img src="/images/anti-graffiti-film-philadelphia-elevator-vandalism-before.jpg" alt="Stainless steel elevator interior with heavy graffiti scratch damage — before Metal Shield film" title="Stainless steel elevator interior with vandalism damage" class="before-after__img before-after__img--before" draggable="false" loading="lazy" />
          <div class="before-after__after-wrap">
            <img src="/images/anti-graffiti-film-philadelphia-metal-shield-elevator-after.jpg" alt="Same stainless steel elevator with Metal Shield film applied — pristine finish restored" title="Stainless steel elevator restored with Metal Shield film" class="before-after__img before-after__img--after" draggable="false" loading="lazy" />
          </div>
          <span class="before-after__tag before-after__tag--before">Vandalized metal</span>
          <span class="before-after__tag before-after__tag--after">Metal Shield applied</span>
          <div class="before-after__handle" role="slider" tabindex="0" aria-label="Drag to compare vandalized and protected glass" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
            <span class="before-after__handle-grip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M8 7L3 12L8 17M16 7L21 12L16 17" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ WHERE IT'S NEEDED — What We Do Panels ══ -->
  <section class="ag-wwd-wrap">
    <div class="ag-wwd-wrap__header">
      <div class="ag-wwd-wrap__eyebrow">WHERE IT'S NEEDED</div>
      <h2 class="ag-wwd-wrap__title">High-Risk Surfaces Across Philadelphia</h2>
      <p class="ag-wwd-wrap__sub">Anti-graffiti window film is most valuable wherever glass, metal, or mirror surfaces face regular exposure to vandalism, public foot traffic, or difficult maintenance access.</p>
    </div>
    <div class="ag-wwd-panels">
      <a href="/applications/retail/" class="wwd__panel">
        <div class="wwd__panel-img-wrap">
          <img src="/images/anti-graffiti-film-philadelphia-retail-storefront.jpg" alt="Philadelphia retail storefront with anti-graffiti film protection" title="Philadelphia retail storefront with anti-graffiti film protection" class="wwd__panel-img" loading="lazy" />
        </div>
        <div class="wwd__panel-overlay"></div>
        <div class="wwd__panel-content">
          <h3>Retail Storefronts</h3>
          <p class="wwd__panel-desc">Street-facing glass in Old City, Rittenhouse, South Street, and Fishtown faces daily exposure to scratching and tagging. Anti-graffiti window film for Philadelphia retail storefronts is replaced on-demand without glass removal.</p>
          <span class="wwd__panel-arrow">Learn more →</span>
          <span class="wwd__panel-line"></span>
        </div>
      </a>
