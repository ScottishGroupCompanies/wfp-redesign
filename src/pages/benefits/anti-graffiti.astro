<script>
  // Split Text Reveal
  var splitObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting) return;
      var el = entry.target;
      el.style.setProperty('--split-stagger', (el.dataset.stagger || '65') + 'ms');
      el.classList.add('is-visible');
      splitObs.unobserve(el);
    });
  }, { threshold: 0.35 });
  document.querySelectorAll('.split-reveal').forEach(function(el) { splitObs.observe(el); });

  // Count Up
  var cuObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting) return;
      entry.target.querySelectorAll('[data-count-end]').forEach(function(el) {
        var end = parseInt(el.dataset.countEnd || '0', 10);
        var suffix = el.dataset.countSuffix || '';
        var n = 0, step = end / 60;
        var t = setInterval(function() { n = Math.min(n + step, end); el.textContent = Math.round(n) + suffix; if (n >= end) clearInterval(t); }, 30);
      });
      cuObs.unobserve(entry.target);
    });
  }, { threshold: 0.3 });
  document.querySelectorAll('.countup').forEach(function(el) { cuObs.observe(el); });
  // Also observe the hero stats panel
  var heroStats = document.querySelector('.ag-hero__stats-panel');
  if (heroStats) { cuObs.observe(heroStats); }

  // Accordion Vertical
  document.querySelectorAll('.accv').forEach(function(el) {
    var panels = Array.from(el.querySelectorAll('[data-panel]'));
    panels.forEach(function(panel) {
      var tab = panel.querySelector('[data-tab]');
      if (!tab) return;
      tab.addEventListener('click', function() {
        panels.forEach(function(p) { p.classList.remove('is-open'); var t = p.querySelector('[data-tab]'); if(t) t.setAttribute('aria-expanded','false'); });
        panel.classList.add('is-open');
        tab.setAttribute('aria-expanded','true');
      });
    });
  });

  // Accordion Benefits
  document.querySelectorAll('.accb').forEach(function(el) {
    var rows = Array.from(el.querySelectorAll('[data-row]'));
    var imgs = Array.from(el.querySelectorAll('[data-img]'));
    rows.forEach(function(row) {
      var trigger = row.querySelector('[data-trigger]');
      if (!trigger) return;
      trigger.addEventListener('click', function() {
        var idx = row.dataset.index;
        rows.forEach(function(r) { r.classList.remove('is-open'); var t = r.querySelector('[data-trigger]'); if(t) t.setAttribute('aria-expanded','false'); });
        imgs.forEach(function(img) { img.classList.remove('is-active'); });
        row.classList.add('is-open');
        trigger.setAttribute('aria-expanded','true');
        var activeImg = imgs.find(function(img) { return img.dataset.index === idx; });
        if (activeImg) activeImg.classList.add('is-active');
      });
    });
  });

  // Before/After Slider
  document.querySelectorAll('.before-after').forEach(function(el) {
    var frame = el.querySelector('.before-after__frame');
    var afterImg = el.querySelector('.before-after__img--after');
    var handle = el.querySelector('.before-after__handle');
    function setW() { afterImg.style.setProperty('--frame-width', frame.offsetWidth + 'px'); }
    function setPos(x) {
      var rect = frame.getBoundingClientRect();
      var pct = Math.max(0, Math.min(100, (x - rect.left) / rect.width * 100));
      el.style.setProperty('--pos', pct + '%');
      handle.setAttribute('aria-valuenow', String(Math.round(pct)));
    }
    var drag = false;
    frame.addEventListener('mousedown', function(e) { drag = true; setPos(e.clientX); });
    window.addEventListener('mouseup', function() { drag = false; });
    window.addEventListener('mousemove', function(e) { if (drag) setPos(e.clientX); });
    frame.addEventListener('touchstart', function(e) { drag = true; setPos(e.touches[0].clientX); }, {passive:true});
    window.addEventListener('touchend', function() { drag = false; });
    window.addEventListener('touchmove', function(e) { if (drag) setPos(e.touches[0].clientX); }, {passive:true});
    handle.addEventListener('keydown', function(e) {
      var rect = frame.getBoundingClientRect();
      var cur = parseFloat(getComputedStyle(el).getPropertyValue('--pos')) || 50;
      if (e.key === 'ArrowLeft') setPos(rect.left + rect.width * (cur - 5) / 100);
      if (e.key === 'ArrowRight') setPos(rect.left + rect.width * (cur + 5) / 100);
    });
    window.addEventListener('resize', setW);
    setW();
  });

  // Gallery Banner pin
  document.querySelectorAll('.gallery-banner').forEach(function(el) {
    var strips = Array.from(el.querySelectorAll('.gallery-banner__strip'));
    strips.forEach(function(strip) {
      strip.addEventListener('click', function() {
        var was = strip.classList.contains('is-active');
        strips.forEach(function(s) { s.classList.remove('is-active'); });
        if (!was) strip.classList.add('is-active');
      });
    });
  });

  // Testimonial Stack
  document.querySelectorAll('.tstack').forEach(function(el) {
    var deck = el.querySelector('.tstack__deck');
    var cards = Array.from(deck.querySelectorAll('.tstack__card'));
    var order = cards.map(function(_,i){return i;});
    function restack() { order.forEach(function(ci,i){ cards[ci].style.setProperty('--i',String(i)); cards[ci].classList.remove('is-leaving'); }); }
    function advance() { var top = order[0]; cards[top].classList.add('is-leaving'); setTimeout(function(){ order.push(order.shift()); restack(); }, 450); }
    deck.addEventListener('click', advance);
    var startX = 0, dragging = false;
    deck.addEventListener('mousedown', function(e){dragging=true;startX=e.clientX;});
    window.addEventListener('mouseup', function(e){if(dragging){dragging=false;if(Math.abs(startX-e.clientX)>60)advance();}});
    deck.addEventListener('touchstart',function(e){dragging=true;startX=e.touches[0].clientX;},{passive:true});
    window.addEventListener('touchend',function(e){if(dragging){dragging=false;if(Math.abs(startX-e.changedTouches[0].clientX)>60)advance();}});
  });

  // CTA Avatars observer
  var ctavObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) { entry.target.classList.add('is-visible'); ctavObs.unobserve(entry.target); }
    });
  }, { threshold: 0.3 });
  document.querySelectorAll('.ctav').forEach(function(el) { ctavObs.observe(el); });

  // Process Roadmap observer
  document.querySelectorAll('.prm').forEach(function(el) {
    var progress = el.querySelector('.prm__progress');
    if (progress) {
      var len = progress.getTotalLength ? progress.getTotalLength() : 250;
      el.style.setProperty('--len', String(len));
    }
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) { if (e.isIntersecting) { el.classList.add('is-visible'); obs.unobserve(el); } });
    }, { threshold: 0.35 });
    obs.observe(el);
  });

  // FAQ Accordion
  document.querySelectorAll('.faq__list').forEach(function(el) {
    var single = el.dataset.single === 'true';
    var items = Array.from(el.querySelectorAll('[data-item]'));
    items.forEach(function(item) {
      var btn = item.querySelector('[data-q]');
      if (!btn) return;
      btn.addEventListener('click', function() {
        var wasOpen = item.classList.contains('is-open');
        if (single) { items.forEach(function(i){ i.classList.remove('is-open'); var q=i.querySelector('[data-q]'); if(q)q.setAttribute('aria-expanded','false'); }); }
        item.classList.toggle('is-open', !wasOpen);
        btn.setAttribute('aria-expanded', String(!wasOpen));
      });
    });
  });
</script>

