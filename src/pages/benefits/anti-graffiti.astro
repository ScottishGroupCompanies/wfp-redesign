---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Anti-Graffiti Window Film in Philadelphia | Invisible Glass Protection';
const description = 'Protect your Philadelphia glass from scratches, acid attacks, and vandalism with anti-graffiti window film. An invisible sacrificial layer that preserves clarity and saves on glass replacement costs.';

const heroImage = 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_181649_9037d3e6-c41d-4f27-8127-f2d62d3cd60f.png';

const faqItems = [
  { question: 'How does anti-graffiti film work?', answer: 'Anti-graffiti film is a optically clear, sacrifical coating applied to the surface of glass. When graffiti, scratches, or acid etching occurs, the film absorbs the damage — not the glass. The damaged film is then simply removed and replaced, restoring the surface to like-new condition at a fraction of the cost of glass replacement.' },
  { question: 'Can it be removed after vandalism?', answer: 'Yes. One of the key advantages of anti-graffiti film is that it is designed to be removed and replaced after an incident. Professional technicians can strip the damaged film cleanly without affecting the underlying glass, then apply fresh film — typically within hours. This makes it an ideal long-term maintenance solution for high-risk surfaces.' },
  { question: 'Does it affect visibility or the appearance of my windows?', answer: 'No. High-quality anti-graffiti films are optically clear and virtually invisible once installed. They do not distort views, alter colors, or change the appearance of your glass in any way. You maintain full visual clarity while gaining permanent protection against vandalism and wear.' },
  { question: "What's the lifespan of anti-graffiti film?", answer: 'Most anti-graffiti films carry a manufacturer warranty of 5–10 years, though actual lifespan depends on exposure and maintenance. Because the film is replaceable, the protection can be maintained indefinitely through periodic replacement — making it far more cost-effective than glass replacement over the life of a building.' },
  { question: 'Does it work on all glass types?', answer: 'Anti-graffiti film works on most standard glass surfaces including windows, glass doors, display cases, and mirrors. It is not recommended for laminated glass, some tempered glass configurations, or surfaces with certain coatings. Our technicians assess each surface before installation to ensure compatibility and optimal performance.' },
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Anti-Graffiti Window Film"
  serviceDesc="Invisible sacrificial protection for Philadelphia glass — shields against scratches, acid attacks, and vandalism for commercial and retail properties."
  serviceUrl="https://www.windowfilmphiladelphia.com/benefits/anti-graffiti"
  faqItems={faqItems}
>
  <!-- HERO -->
  <section class="swt-hero">
    <div class="swt-hero__img">
      <img src={heroImage} alt="Glass protected with anti-graffiti window film in Philadelphia" width="1440" height="700" />
      <div class="swt-hero__overlay"></div>
    </div>
    <div class="swt-hero__content">
      <span class="swt-badge">
        <svg width="8" height="8" viewBox="0 0 8 8" fill="none"><circle cx="4" cy="4" r="4" fill="#4E6B2A"/></svg>
        Commercial & Retail Glass Protection
      </span>
      <h1 class="swt-hero__title">
        Protect Your Glass.<br/>
        <em>Deter Vandals.</em><br/>
        Save Thousands.
      </h1>
      <p class="swt-hero__sub">An invisible sacrificial layer shields Philadelphia windows from scratches, acid attacks, and graffiti — replaceable after vandalism, without replacing your glass.</p>
      <div class="swt-hero__ctas">
        <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Quote</a>
        <a href="#benefits" class="swt-btn swt-btn--ghost-light">See Benefits</a>
      </div>
    </div>
  </section>

  <div class="swt-body">

    <!-- TRUST BAR -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted by leading Philadelphia businesses</p>
        <BrandLogos />
      </div>
    </section>

    <!-- SECTION 1: THE PROBLEM — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="problem">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">The Challenge</span>
            <h2 class="swt-h2 swt-h2--light">Graffiti and Vandalism Are a Glass Problem — Not Just a Cleanup Problem</h2>
            <p>When someone etches, scratches, or tags your glass, you're not just dealing with a cosmetic eyesore — you're facing full glass replacement. Acid graffiti can permanently cloud glass in minutes. Deep scratches cannot be buffed out. And in Philadelphia's commercial districts, repeated vandalism is a real operational cost that most businesses absorb silently.</p>
            <p>Standard glass offers no sacrifical layer. Once damaged, the only solution is replacement — costly, disruptive, and time-consuming. Meanwhile, the same surface remains vulnerable to the next incident.</p>
            <div class="swt-problem-tags">
              <span class="swt-tag swt-tag--red">Acid Etching Damage</span>
              <span class="swt-tag swt-tag--red">Scratch Permanence</span>
              <span class="swt-tag swt-tag--red">Costly Glass Replacement</span>
              <span class="swt-tag swt-tag--red">Business Disruption</span>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={heroImage} alt="Vandalized glass surface requiring expensive replacement" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: HOW IT WORKS — white bg, image left, text right -->
    <section class="swt-split" id="how-it-works">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={heroImage} alt="Anti-graffiti film installation on Philadelphia commercial glass" loading="lazy" />
            <div class="swt-img-badge">
              <strong>Invisible</strong>
              <span>Zero Visual Impact</span>
            </div>
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 01</span>
            <h2 class="swt-h2">An Invisible Sacrificial Layer That Takes the Hit</h2>
            <p>Anti-graffiti film is a optically clear, durable polymer coating applied directly to glass surfaces. It is completely invisible when installed — preserving the original appearance of your windows, doors, and display glass exactly as they are.</p>
            <p>When vandalism occurs, the film absorbs the damage — whether it is acid etching, scratching, or adhesive residue from stickers. The glass underneath remains pristine. Rather than replacing the entire pane, a technician removes the damaged film and applies a fresh one, typically within a few hours.</p>
            <ul class="swt-check-list">
              <li>Optically clear — zero distortion, zero visible change to glass</li>
              <li>Sacrifical design — absorbs damage, protects the glass beneath</li>
              <li>Quick replacement after incidents — no glass replacement needed</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: COST SAVINGS — alt cream bg, text left, image right -->
    <section class="swt-split swt-split--alt" id="cost">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 02</span>
            <h2 class="swt-h2">Replace Film — Not Glass — After Every Vandalism Incident</h2>
            <p>Glass replacement after vandalism is not just expensive — it is disruptive. A single scratched or acid-etched window panel can cost $400–$1,200 to replace, plus installation downtime and potential business closure during fitting. For retail storefronts and commercial facades with multiple panes, a single vandalism event can result in five-figure repair bills.</p>
            <p>Anti-graffiti film costs a fraction of glass replacement per panel, and film replacement after an incident costs a fraction of new glass. Over a ten-year period, properties in high-risk areas routinely save $10,000–$50,000+ per building by choosing film over glass replacement every time vandalism occurs.</p>
            <div class="swt-energy-metrics">
              <div class="swt-metric">
                <span class="swt-metric__num">80%</span>
                <span class="swt-metric__label">Less Than Glass Replacement</span>
              </div>
              <div class="swt-metric">
                <span class="swt-metric__num">Same Day</span>
                <span class="swt-metric__label">Film Replacement After Vandalism</span>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={heroImage} alt="Philadelphia storefront protected by anti-graffiti film" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: CLARITY — white bg, image left, text right -->
    <section class="swt-split" id="clarity">
      <div class="container">
        <div class="swt-split__grid swt-split__grid--rev">
          <div class="swt-split__img fade-in">
            <img src={heroImage} alt="Clear anti-graffiti film maintaining full glass visibility" loading="lazy" />
          </div>
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow">Benefit 03</span>
            <h2 class="swt-h2">Maximum Protection. Zero Compromise on Clarity.</h2>
            <p>Unlike some protective coatings that tint, haze, or distort glass, high-quality anti-graffiti film is optically clear and maintains the full visual characteristics of your original glass installation. Customers, tenants, and employees will not notice any difference in appearance — only in the knowledge that the glass is protected.</p>
            <p>This is especially critical for retail storefronts where curb appeal and storefront visibility drive foot traffic and sales. A slightly tinted or hazy protective coating can actually reduce business. Anti-graffiti film eliminates that trade-off entirely.</p>
            <blockquote class="swt-inline-quote">
              "You cannot tell the film is there at all. It looks exactly like our original glass — only now we know it is protected."
              <cite>— Store Manager, retail chain, Center City Philadelphia</cite>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: APPLICATIONS — dark bg, text left, image right -->
    <section class="swt-split swt-split--dark" id="applications">
      <div class="container">
        <div class="swt-split__grid">
          <div class="swt-split__text fade-in">
            <span class="swt-eyebrow swt-eyebrow--green">Benefit 04</span>
            <h2 class="swt-h2 swt-h2--light">Built for Commercial and Retail Environments</h2>
            <p>Anti-graffiti film is one of the highest-ROI protective investments for any business with exterior glass. Retail storefronts, transit-adjacent buildings, school facades, government buildings, and any property in a high-foot-traffic or historically targeted area benefits from the protection it provides.</p>
            <p>It is also used inside — on glass display cases, elevator panels, partition glass, and anywhere accumulated wear creates ongoing maintenance costs. The flexibility of film means it can be applied to flat glass virtually anywhere in a building.</p>
            <div class="swt-security-features">
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Retail Storefronts</strong>
                  <p>Protect prime display glass from etching, scratching, and tagging</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Transit & Municipal Buildings</strong>
                  <p>High-traffic public glass that is frequently targeted</p>
                </div>
              </div>
              <div class="swt-security-feature">
                <div class="swt-feature-dot"></div>
                <div>
                  <strong>Interior Display Cases & Elevators</strong>
                  <p>Interior glass protection against accumulated wear and tear</p>
                </div>
              </div>
            </div>
          </div>
          <div class="swt-split__img fade-in">
            <img src={heroImage} alt="Commercial building glass protected with anti-graffiti film" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- STATS BAR — accent green -->
    <section class="swt-stats">
      <div class="container">
        <div class="swt-stats__row">
          <div class="swt-stats__item fade-in">
            <span class="swt-stats__num">16+</span>
            <span class="swt-stats__label">Years in Philadelphia</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 80ms">
            <span class="swt-stats__num">500+</span>
            <span class="swt-stats__label">Commercial Projects</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 160ms">
            <span class="swt-stats__num">80%</span>
            <span class="swt-stats__label">Savings vs Glass Replacement</span>
          </div>
          <div class="swt-stats__div"></div>
          <div class="swt-stats__item fade-in" style="--delay: 240ms">
            <span class="swt-stats__num">Same Day</span>
            <span class="swt-stats__label">Film Replacement After Vandalism</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS — 3 steps -->
    <section class="swt-process">
      <div class="container">
        <div class="swt-gallery__header fade-in">
          <span class="swt-eyebrow">How It Works</span>
          <h2 class="swt-h2 swt-h2--center">3 Simple Steps to Protected Glass</h2>
        </div>
        <div class="swt-process__steps">
          <div class="swt-process__step fade-in">
            <div class="swt-process__num">01</div>
            <div class="swt-process__body">
              <h3>Free Site Assessment</h3>
              <p>We visit your property and assess every glass surface that needs protection. You receive a detailed proposal with film specifications, coverage areas, and transparent pricing — typically within 24 hours. No obligation.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 80ms">
            <div class="swt-process__num">02</div>
            <div class="swt-process__body">
              <h3>Professional Installation in Hours</h3>
              <p>Our factory-trained technicians install anti-graffiti film cleanly and precisely, with no disruption to your business operations. Most commercial installations are completed in a single day.</p>
            </div>
          </div>
          <div class="swt-process__step fade-in" style="--delay: 160ms">
            <div class="swt-process__num">03</div>
            <div class="swt-process__body">
              <h3>Incident Response — Film Replacement</h3>
              <p>If vandalism occurs, we respond quickly to remove the damaged film and apply fresh protection — often the same day or next day. Your glass is restored to full protection without the cost or delay of glass replacement.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="swt-faq" id="faq">
      <div class="container">
        <div class="swt-faq__layout">
          <div class="swt-faq__header fade-in">
            <span class="swt-eyebrow">Questions</span>
            <h2 class="swt-h2">Frequently Asked Questions</h2>
            <p>Honest answers from people who have been installing window film in Philadelphia for over 16 years.</p>
            <a href="/contact/" class="swt-btn swt-btn--primary">Talk to a Specialist</a>
          </div>
          <div class="swt-faq__list fade-in">
            {faqItems.map((item) => (
              <div class="swt-faq__item">
                <div class="swt-faq__q">
                  <span>{item.question}</span>
                  <span class="swt-faq__toggle">+</span>
                </div>
                <div class="swt-faq__a">
                  <p>{item.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA BANNER -->
    <section class="swt-cta">
      <div class="swt-cta__inner">
        <div class="swt-cta__text">
          <h2>Ready to <em>protect</em> your glass?</h2>
          <p>Get a free assessment and quote. No obligation — just honest advice from Philadelphia's window film experts.</p>
        </div>
        <div class="swt-cta__btns">
          <a href="/contact/" class="swt-btn swt-btn--primary">Get a Free Quote</a>
          <a href="tel:+126****7980" class="swt-btn swt-btn--ghost-light">Call (267) 394-7980</a>
        </div>
      </div>
    </section>

  </div><!-- /swt-body -->
</BaseLayout>

<style>
  /* ══════════════════════════════════════
     BRAND TOKENS (local override)
     ══════════════════════════════════════ */
  :root {
    --swt-green:        #4E6B2A;
    --swt-green-accent: #83A94A;
    --swt-dark:         #2A241E;
    --swt-cream:        #F4EFE6;
    --swt-alt:          #ECE4D4;
    --swt-border:       #E1D6C1;
    --swt-text-sec:     #6E665C;
    --swt-gold:         #846212;
    --swt-white:        #ffffff;
    --swt-radius:       5px;
  }

  /* ══════════════════════════════════════
     HERO
     ══════════════════════════════════════ */
  .swt-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .swt-hero__img {
    position: absolute;
    inset: 0;
  }
  .swt-hero__img img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .swt-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(42,36,30,0.9) 0%, rgba(42,36,30,0.6) 50%, rgba(42,36,30,0.35) 100%);
  }
  .swt-hero__content {
    position: relative;
    z-index: 1;
    padding: 110px 8% 90px;
    max-width: 720px;
  }
  .swt-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
    background: rgba(78,107,42,0.25);
    color: rgba(255,255,255,0.75);
    border: 1px solid rgba(78,107,42,0.4);
  }
  .swt-hero__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(38px, 5.5vw, 66px);
    font-weight: 400;
    color: var(--swt-white);
    line-height: 1.1;
    margin: 0 0 20px;
  }
  .swt-hero__title em {
    font-style: italic;
    color: var(--swt-green-accent);
  }
  .swt-hero__sub {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 17px;
    color: rgba(255,255,255,0.65);
    line-height: 1.7;
    margin: 0 0 36px;
    max-width: 500px;
  }
  .swt-hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ══════════════════════════════════════
     BUTTONS
     ══════════════════════════════════════ */
  .swt-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .swt-btn--primary {
    background: var(--swt-green);
    color: var(--swt-white);
    border-color: var(--swt-green);
  }
  .swt-btn--primary:hover {
    background: #3D5620;
    border-color: #3D5620;
    transform: translateY(-2px);
  }
  .swt-btn--ghost-light {
    background: transparent;
    color: rgba(255,255,255,0.8);
    border-color: rgba(255,255,255,0.35);
  }
  .swt-btn--ghost-light:hover {
    color: #fff;
    border-color: rgba(255,255,255,0.65);
    background: rgba(255,255,255,0.06);
  }

  /* ══════════════════════════════════════
     SHARED
     ══════════════════════════════════════ */
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 5%;
  }
  .swt-body { background: var(--swt-white); }

  .swt-eyebrow {
    display: inline-block;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--swt-green);
    margin-bottom: 12px;
  }
  .swt-eyebrow--green { color: var(--swt-green-accent); }

  .swt-h2 {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 400;
    color: var(--swt-dark);
    line-height: 1.15;
    margin: 0 0 18px;
  }
  .swt-h2--light { color: var(--swt-white); }
  .swt-h2--center { text-align: center; }

  .swt-subhead {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 16px;
    color: var(--swt-text-sec);
    margin: 8px 0 0;
    text-align: center;
  }

  /* ── Trust Bar ── */
  .swt-trust {
    background: var(--swt-cream);
    padding: 32px 0;
    border-bottom: 1px solid var(--swt-border);
  }
  .swt-trust__label {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--swt-text-sec);
    text-align: center;
    margin: 0 0 20px;
    opacity: 0.7;
  }

  /* ── Split Sections ── */
  .swt-split {
    padding: 96px 0;
    background: var(--swt-white);
  }
  .swt-split--dark { background: var(--swt-dark); }
  .swt-split--alt { background: var(--swt-alt); }

  .swt-split__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }
  .swt-split__grid--rev .swt-split__img { order: -1; }

  .swt-split__text p {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 16px;
    line-height: 1.85;
    color: var(--swt-text-sec);
    margin: 0 0 14px;
  }
  .swt-split--dark .swt-split__text p { color: rgba(255,255,255,0.55); }

  .swt-split__img {
    position: relative;
  }
  .swt-split__img img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: var(--swt-radius);
    display: block;
    box-shadow: 0 20px 60px rgba(42,36,30,0.12);
  }

  .swt-img-badge {
    position: absolute;
    bottom: -12px;
    right: -12px;
    background: var(--swt-green);
    color: var(--swt-white);
    border-radius: var(--swt-radius);
    padding: 16px 24px;
    text-align: center;
    box-shadow: 0 8px 24px rgba(42,36,30,0.2);
  }
  .swt-img-badge strong {
    display: block;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1;
  }
  .swt-img-badge span {
    display: block;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 600;
    opacity: 0.85;
    margin-top: 3px;
  }

  /* ── Problem Tags ── */
  .swt-problem-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .swt-tag {
    padding: 8px 16px;
    border-radius: var(--swt-radius);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 600;
  }
  .swt-tag--red {
    background: rgba(180,60,60,0.1);
    color: #e8a0a0;
    border: 1px solid rgba(180,60,60,0.2);
  }

  /* ── Check List ── */
  .swt-check-list {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
  }
  .swt-check-list li {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 15px;
    color: var(--swt-text-sec);
    padding: 9px 0;
    border-bottom: 1px solid var(--swt-border);
    display: flex;
