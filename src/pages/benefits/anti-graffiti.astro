---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import FlipWords from '../../components/FlipWords.astro';

const title = 'Anti-Graffiti Window Film Philadelphia | Protect Glass, Metal & Mirrors';
const description = 'Clear sacrificial film that protects Philadelphia glass, metal, and mirrors from scratches, acid etching, and graffiti. Replace the film — not the surface.';

const faqItems = [
  { question: 'Is anti-graffiti film clear? Will it change how my glass looks?', answer: 'Yes — it is optically clear and virtually invisible. Anti-graffiti film does not tint, darken, or distort your glass in any way. It preserves the full appearance and visibility of the protected surface while acting as a transparent sacrificial layer underneath.' },
  { question: 'How does the sacrificial layer concept work?', answer: 'The film is designed to absorb vandalism damage rather than letting it reach the underlying surface. When scratches, acid etching, or graffiti damage the film, our team removes and replaces the film — the glass, metal, or mirror underneath is completely unaffected. The surface looks brand new each time.' },
  { question: 'Does anti-graffiti film only protect windows?', answer: 'No. This is one of the most important things to understand about anti-graffiti film. It protects glass surfaces, metal surfaces such as stainless steel elevator interiors and door hardware, and mirrors including restroom mirrors and lobby displays. Any vandalism-prone surface can be protected.' },
  { question: 'Can it stop acid etching?', answer: 'Anti-graffiti film provides meaningful protection against acid etching attacks on glass. When acid contacts the film, it damages the film rather than the glass underneath. For severe or prolonged attacks, film replacement restores the surface. It significantly reduces the likelihood of permanent damage to the substrate.' },
  { question: 'How quickly can vandalized film be replaced?', answer: 'In most cases our team can remove damaged film and reinstall fresh film in a single visit, often the same day an incident is reported. This minimal turnaround time is a key advantage over glass replacement, which can take days or weeks and requires ordering custom panels.' },
  { question: 'What surfaces work best with anti-graffiti film?', answer: 'The film is compatible with most standard glass surfaces, stainless steel, and mirrors. It is assessed on a surface-by-surface basis — our technicians evaluate each surface before installation to confirm compatibility and identify any substrate conditions that may affect performance or adhesion.' },
  { question: 'How long does the film last before it needs replacement?', answer: 'Anti-graffiti film carries manufacturer warranties of 5–10 years depending on the product and application. In high-vandalism areas the film may be replaced after incidents as designed. The protection is ongoing — each replacement restores the surface to full protection. Long-term it is significantly more cost-effective than glass replacement.' },
  { question: 'What types of vandalism does it protect against?', answer: 'Anti-graffiti film protects against scratching and scraping, spray paint and marker tagging, acid etching, and general surface abrasion. It is most effective on surfaces that face repeated, lower-intensity vandalism. It is a surface protection product, not a structural or forced-entry deterrent.' },
  { question: 'Which Philadelphia settings benefit most from anti-graffiti film?', answer: 'The highest-value applications in Philadelphia include transit stations and bus shelter glass, retail storefronts in high-foot-traffic corridors, elevator interiors with stainless steel and mirror finishes, school and university building glass, and restroom mirrors in public and commercial facilities.' },
  { question: 'How do I get anti-graffiti film installed?', answer: 'Contact us for a free site assessment. We will evaluate your surfaces, identify the highest-risk areas, and recommend the appropriate film for each substrate. Most commercial installations are completed with minimal disruption to your business, and we work around your schedule including after-hours for retail and transit clients.' },
];

const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Benefits", "item": "https://www.windowfilmphiladelphia.net/benefits/" },
      { "@type": "ListItem", "position": 3, "name": "Anti-Graffiti Window Film", "item": "https://www.windowfilmphiladelphia.net/benefits/anti-graffiti/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.windowfilmphiladelphia.net/benefits/anti-graffiti/",
    "name": title,
    "description": description,
    "dateModified": new Date().toISOString().slice(0, 10),
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".ag-hero__title", ".ag-whatis__body", ".swt-faq__a"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Anti-Graffiti Film Applications",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Retail Storefronts" },
      { "@type": "ListItem", "position": 2, "name": "Transit & Transportation" },
      { "@type": "ListItem", "position": 3, "name": "Elevator Interiors" },
      { "@type": "ListItem", "position": 4, "name": "Schools & Universities" },
      { "@type": "ListItem", "position": 5, "name": "Restaurants & Hospitality" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Anti-Graffiti Window Film Philadelphia",
    "description": "Clear sacrificial protective film for glass, metal, and mirrors. Shields Philadelphia commercial surfaces from scratches, acid etching, and graffiti vandalism.",
    "brand": { "@type": "Brand", "name": "Window Film Philadelphia" },
    "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "areaServed": "Philadelphia, PA" },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "87",
      "bestRating": "5"
    },
    "review": [
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Marcus D." }, "reviewBody": "Our Old City storefront was getting scratched every few weeks. After the anti-graffiti film went on we had two incidents and both times they just swapped the film. Total cost was a fraction of what we were spending on glass repair." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Sandra K." }, "reviewBody": "The elevator mirrors in our building were a constant maintenance headache. The film is completely invisible and since installation we have not had a single permanent scratch. The maintenance crew replaces it when needed — it is seamless." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Ray O." }, "reviewBody": "We protect three SEPTA shelter installations now. The film holds up to regular abuse and when something gets through we are back to pristine in hours not days. Game-changer for transit maintenance budgets." }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Anti-Graffiti Window Film"
  serviceDesc="Clear sacrificial film protecting Philadelphia glass, metal, and mirrors from scratches, acid etching, and graffiti vandalism."
  serviceUrl="https://www.windowfilmphiladelphia.net/benefits/anti-graffiti/"
  faqItems={faqItems}
  schemas={pageSchemas}
>

  <!-- ══ HERO ══ -->
  <section class="ag-hero">
    <div class="ag-hero__bg" style="background-image:url('/images/ag-hero.jpg')"></div>
    <div class="ag-hero__overlay"></div>
    <div class="ag-hero__inner">
      <div class="ag-hero__eyebrow">
        <span class="ag-hero__eyebrow-dot" aria-hidden="true"></span>
        ANTI-GRAFFITI WINDOW FILM
        <span class="ag-hero__eyebrow-dot" aria-hidden="true"></span>
      </div>
      <h1 class="ag-hero__title">Protect Your Glass.<br/>Protect Your Metal.<br/>Protect Your Mirrors.</h1>
      <p class="ag-hero__animated-line">
        <FlipWords
          words={["for Philadelphia Storefronts","for Center City Transit Stations","for Philadelphia School Buildings","for Old City Elevator Interiors","for Philadelphia Restrooms & Lobbies"]}
          staticText=""
          class="ag-hero__flip"
        />
      </p>
      <p class="ag-hero__subtitle">A clear, optically invisible sacrificial layer applied directly to your vulnerable surfaces. When vandalism strikes, replace the film — not the glass, not the metal, not the mirror.</p>
      <div class="ag-hero__cta">
        <a href="/contact/" class="ag-hero__btn-primary">Get a Free Assessment</a>
        <a href="tel:2673947980" class="ag-hero__btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/></svg>
          (267) 394-7980
        </a>
      </div>
      <div class="ag-hero__stats-panel">
        <div class="ag-hero__stat">
          <span class="ag-hero__stat-number countup" data-count-end="80" data-count-suffix="%">80%</span>
          <span class="ag-hero__stat-label">Savings vs Glass Replacement</span>
        </div>
        <div class="ag-hero__stat-divider" aria-hidden="true"></div>
        <div class="ag-hero__stat">
          <span class="ag-hero__stat-number">Same Day</span>
          <span class="ag-hero__stat-label">Film Replacement</span>
        </div>
        <div class="ag-hero__stat-divider" aria-hidden="true"></div>
        <div class="ag-hero__stat">
          <span class="ag-hero__stat-number countup" data-count-end="500" data-count-suffix="+">500+</span>
          <span class="ag-hero__stat-label">Commercial Projects</span>
        </div>
        <div class="ag-hero__stat-divider" aria-hidden="true"></div>
        <div class="ag-hero__stat">
          <span class="ag-hero__stat-number countup" data-count-end="16" data-count-suffix="+">16+</span>
          <span class="ag-hero__stat-label">Years in Philadelphia</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ TRUST BAR ══ -->
  <section class="swt-trust">
    <div class="container">
      <p class="swt-trust__label">Trusted by Philadelphia businesses, transit authorities, schools, and property managers</p>
      <BrandLogos />
    </div>
  </section>

  <!-- ══ THE VANDALISM PROBLEM — Accordion Vertical ══ -->
  <section class="ag-accv-wrap">
    <div class="ag-accv-wrap__header">
      <div class="ag-accv-wrap__eyebrow">THE CHALLENGE</div>
      <h2 class="ag-accv-wrap__title split-reveal" data-stagger="65" aria-label="Three Types of Surface Vandalism. One Solution.">
        <span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:0">Three&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:1">Types&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:2">of&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:3">Surface&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:4">Vandalism.&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:5">One&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:6">Solution.</span></span>
      </h2>
      <p class="ag-accv-wrap__sub">Glass, metal, and mirrors in Philadelphia face three distinct types of vandalism damage — each expensive to address without a protective layer in place.</p>
    </div>
    <div class="accv">
      <div class="accv__panel is-open" data-panel style="background-image:url('/images/ag-accv-scratch.jpg')">
        <button class="accv__tab" data-tab aria-expanded="true">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </span>
          <span class="accv__title">Scratches & Tags</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Scratches & Tags</h3>
            <p>Keys, coins, tools, and sharp objects gouge glass surfaces permanently — and marker tags on glass require aggressive chemical removal that can damage seals and frames. Anti-graffiti film absorbs the scratch so the glass underneath stays pristine.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/ag-accv-acid.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
          </span>
          <span class="accv__title">Acid Etching</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Acid Etching</h3>
            <p>Acid attacks create cloudy, permanent damage to glass that cannot be buffed or polished out — the only fix is glass replacement. Anti-graffiti film intercepts the acid before it reaches the substrate, turning a glass-replacement event into a simple film swap.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/ag-accv-paint.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a5 5 0 015 5c0 5-5 11-5 11S7 12 7 7a5 5 0 015-5z"/><circle cx="12" cy="7" r="2"/></svg>
          </span>
          <span class="accv__title">Paint & Spray Tags</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Paint & Spray Tags</h3>
            <p>Spray paint and markers bond to bare metal and glass surfaces, requiring harsh solvents that can damage finishes. On film-protected surfaces, paint lifts cleanly with the film removal — stainless steel elevator interiors, restroom mirrors, and metal signage stay protected and easily maintained.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ WHAT FILM PROTECTS — Accordion Benefits (Glass / Metal / Mirror) ══ -->
  <section class="accb">
    <div class="accb__head">
      <h2 class="accb__title">Not Just Windows. Glass, Metal, and Mirrors.</h2>
      <p class="accb__sub">Anti-graffiti film protects three distinct surface types — each with different vulnerabilities and different cost implications when vandalism occurs.</p>
    </div>
    <div class="accb__wrap">
      <div class="accb__list">
        <div class="accb__row is-open" data-row data-index="0">
          <button class="accb__trigger" data-trigger aria-expanded="true">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></span>
            <span class="accb__row-title">Glass Surfaces</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Storefronts, glass doors, display cases, lobby partitions, transit shelter glass. Clear anti-graffiti film is applied directly to the glass surface and is completely invisible. When scratched or etched, the film is peeled and replaced — the glass underneath is untouched. Manufacturers include 3M, LLumar, and Solar Gard GraffitiGard.</p>
              <img class="accb__mobile-img" src="/images/ag-accb-glass.jpg" alt="Protected Philadelphia commercial glass storefront" title="Protected Philadelphia commercial glass storefront" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="1">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="18" rx="1"/><path d="M8 21V3M16 21V3"/></svg></span>
            <span class="accb__row-title">Metal Surfaces</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Stainless steel elevator interiors, door frames, metal panels, signage, and hardware are among the most vandalism-prone surfaces in commercial buildings. Anti-graffiti film adheres to polished and brushed metal finishes, providing the same sacrificial protection as on glass — spray paint and scratches lift with the film, leaving the metal surface unharmed.</p>
              <img class="accb__mobile-img" src="/images/ag-accb-metal.jpg" alt="Stainless steel elevator interior with anti-graffiti protection" title="Stainless steel elevator interior with anti-graffiti protection" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="2">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="12" cy="12" r="4"/><path d="M12 8v.01M12 16v.01M8 12h.01M16 12h.01"/></svg></span>
            <span class="accb__row-title">Mirror Surfaces</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Restroom mirrors, lobby display mirrors, and retail fitting room mirrors are frequent targets for scratching and tagging. Mirror replacement is expensive and disruptive — anti-graffiti film extends the life of existing mirrors indefinitely by absorbing damage before it reaches the reflective coating. Philadelphia restaurants, transit facilities, and commercial buildings protect mirrors as part of a comprehensive anti-vandalism strategy.</p>
              <img class="accb__mobile-img" src="/images/ag-accb-mirror.jpg" alt="Clean protected restroom mirror in Philadelphia commercial building" title="Clean protected restroom mirror in Philadelphia commercial building" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
      <div class="accb__media">
        <img class="accb__img is-active" data-img data-index="0" src="/images/ag-accb-glass.jpg" alt="Protected Philadelphia commercial glass storefront" title="Protected Philadelphia commercial glass storefront" loading="lazy" />
        <img class="accb__img" data-img data-index="1" src="/images/ag-accb-metal.jpg" alt="Stainless steel elevator interior with anti-graffiti protection" title="Stainless steel elevator interior with anti-graffiti protection" loading="lazy" />
        <img class="accb__img" data-img data-index="2" src="/images/ag-accb-mirror.jpg" alt="Clean protected restroom mirror" title="Clean protected restroom mirror" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ══ BEFORE/AFTER SLIDER — The Sacrificial Layer in Action ══ -->
  <section class="ag-slider-wrap">
    <div class="ag-slider-wrap__header">
      <div class="ag-slider-wrap__eyebrow">THE FILM IN ACTION</div>
      <h2 class="ag-slider-wrap__title">Replace the Film. Not the Glass.</h2>
      <p class="ag-slider-wrap__sub">Drag the handle to see the difference between vandalized glass and glass protected with anti-graffiti film — completely clear, zero tinting, zero distortion.</p>
    </div>
    <div class="ag-slider-wrap__slider">
      <div class="before-after" style="--pos:50%">
        <div class="before-after__frame">
          <img src="/images/ag-ba-before.jpg" alt="Philadelphia storefront glass with graffiti scratches and tags — before anti-graffiti film" title="Philadelphia storefront glass with graffiti scratches and tags — before anti-graffiti film" class="before-after__img before-after__img--before" draggable="false" loading="lazy" />
          <div class="before-after__after-wrap">
            <img src="/images/ag-ba-after.jpg" alt="Same Philadelphia storefront glass after clear anti-graffiti film installation — pristine surface" title="Same Philadelphia storefront glass after clear anti-graffiti film installation — pristine surface" class="before-after__img before-after__img--after" draggable="false" loading="lazy" />
          </div>
          <span class="before-after__tag before-after__tag--before">Vandalized glass</span>
          <span class="before-after__tag before-after__tag--after">With anti-graffiti film</span>
          <div class="before-after__handle" role="slider" tabindex="0" aria-label="Drag to compare vandalized and protected glass" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
            <span class="before-after__handle-grip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M8 7L3 12L8 17M16 7L21 12L16 17" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ WHERE IT'S NEEDED — What We Do Panels ══ -->
  <section class="ag-wwd-wrap">
    <div class="ag-wwd-wrap__header">
      <div class="ag-wwd-wrap__eyebrow">WHERE IT'S NEEDED</div>
      <h2 class="ag-wwd-wrap__title">High-Risk Surfaces Across Philadelphia</h2>
      <p class="ag-wwd-wrap__sub">Anti-graffiti film is most valuable wherever glass, metal, or mirror surfaces face regular exposure to vandalism, public foot traffic, or difficult maintenance access.</p>
    </div>
    <div class="ag-wwd-panels">
      <a href="/applications/retail/" class="wwd__panel">
        <div class="wwd__panel-img-wrap">
          <img src="/images/ag-wwd-storefront.jpg" alt="Philadelphia retail storefront with anti-graffiti film protection" title="Philadelphia retail storefront with anti-graffiti film protection" class="wwd__panel-img" loading="lazy" />
        </div>
        <div class="wwd__panel-overlay"></div>
        <div class="wwd__panel-content">
          <h3>Retail Storefronts</h3>
          <p class="wwd__panel-desc">Street-facing glass in high-traffic Philadelphia corridors — Old City, Rittenhouse, South Street, and Fishtown — faces daily exposure to scratching and tagging.</p>
          <span class="wwd__panel-arrow">Learn more →</span>
          <span class="wwd__panel-line"></span>
        </div>
      </a>
      <a href="/applications/office/" class="wwd__panel">
        <div class="wwd__panel-img-wrap">
          <img src="/images/ag-wwd-transit.jpg" alt="Philadelphia transit station glass panels with anti-graffiti film" title="Philadelphia transit station glass panels with anti-graffiti film" class="wwd__panel-img" loading="lazy" />
        </div>
        <div class="wwd__panel-overlay"></div>
        <div class="wwd__panel-content">
          <h3>Transit & Transportation</h3>
          <p class="wwd__panel-desc">SEPTA stations, bus shelters, and transit hubs face some of the highest vandalism rates in the city. Film replacement is fast, low-cost, and keeps surfaces looking maintained.</p>
          <span class="wwd__panel-arrow">Learn more →</span>
          <span class="wwd__panel-line"></span>
        </div>
      </a>
      <a href="/applications/office/" class="wwd__panel">
        <div class="wwd__panel-img-wrap">
          <img src="/images/ag-wwd-elevator.jpg" alt="Philadelphia elevator interior with anti-graffiti film on stainless steel and mirrors" title="Philadelphia elevator interior with anti-graffiti film on stainless steel and mirrors" class="wwd__panel-img" loading="lazy" />
        </div>
        <div class="wwd__panel-overlay"></div>
        <div class="wwd__panel-content">
          <h3>Elevator Interiors</h3>
          <p class="wwd__panel-desc">Stainless steel and mirrored elevator interiors in Philadelphia office towers, residential buildings, and parking facilities are prime targets. Film covers the metal and mirror surfaces that face the most abuse.</p>
          <span class="wwd__panel-arrow">Learn more →</span>
          <span class="wwd__panel-line"></span>
        </div>
      </a>
      <a href="/applications/schools-universities/" class="wwd__panel">
        <div class="wwd__panel-img-wrap">
          <img src="/images/ag-wwd-school.jpg" alt="Philadelphia school building with anti-graffiti film on glass doors" title="Philadelphia school building with anti-graffiti film on glass doors" class="wwd__panel-img" loading="lazy" />
        </div>
        <div class="wwd__panel-overlay"></div>
        <div class="wwd__panel-content">
          <h3>Schools & Universities</h3>
          <p class="wwd__panel-desc">Philadelphia school districts and university campuses protect entry glass, hallway partitions, and restroom mirrors — reducing costly and disruptive glass replacement calls throughout the academic year.</p>
          <span class="wwd__panel-arrow">Learn more →</span>
          <span class="wwd__panel-line"></span>
        </div>
      </a>
    </div>
  </section>

  <!-- ══ GALLERY BANNER — OUR WORK ══ -->
  <section class="gallery-banner gallery-banner--light">
    <div class="gallery-banner__inner">
      <div class="gallery-banner__text">
        <p class="gallery-banner__eyebrow">OUR WORK</p>
        <h2 class="gallery-banner__title" aria-label="PROTECTED SURFACES.">
