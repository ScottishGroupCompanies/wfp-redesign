/* ── FADE IN ── */
.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.fade-in.visible { opacity: 1; transform: translateY(0); }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .auron-stats__inner { grid-template-columns: 1fr; gap: 48px; }
  .auron-feat { grid-template-columns: 1fr; gap: 40px; }
  .auron-feat--rev .auron-feat__img { order: 0; }
  .auron-feat--rev .auron-feat__content { order: 1; }
  .auron-mission__inner { grid-template-columns: 1fr; }
  .auron-benefits__grid { grid-template-columns: repeat(2, 1fr); }
  .auron-benefit:nth-child(4n) { border-right: 1px solid #E8E8E0; }
  .auron-benefit:nth-child(2n) { border-right: none; }
  .auron-faq__inner { grid-template-columns: 1fr; gap: 40px; }
  .auron-cta-banner__inner { flex-direction: column; text-align: center; }
}
@media (max-width: 768px) {
  .auron-hero__content { padding: 80px 5%; }
  .auron-hero__ctas { flex-direction: column; }
  .auron-stats, .auron-features, .auron-benefits, .auron-faq, .auron-cta-banner { padding: 60px 5%; }
  .auron-mission { padding: 60px 5%; }
  .auron-feat__img { height: 280px; }
  .auron-benefits__grid { grid-template-columns: 1fr; }
  .auron-benefit { border-right: none !important; }
  .auron-stat-card { padding: 24px 20px; }
  .auron-cta-banner__btns { flex-direction: column; width: 100%; }
  .auron-hero__title { font-size: 36px; }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));

  document.querySelectorAll('.auron-faq__item').forEach(item => {
    item.querySelector('.auron-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('auron-faq__item--open');
      document.querySelectorAll('.auron-faq__item').forEach(i => i.classList.remove('auron-faq__item--open'));
      if (!isOpen) item.classList.add('auron-faq__item--open');
    });
  });
</script>
