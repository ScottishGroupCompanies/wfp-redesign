---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
import BrandLogos from '../components/BrandLogos.astro';

const title = 'Government Building Window Film | Philadelphia Civic Buildings';
const description = 'Window film solutions for Philadelphia government buildings: energy savings, UV protection, safety and security. Trusted by civic facilities across the Delaware Valley.';

const heroUrl = 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_154529_dd0a44bd-33a0-48fb-85e5-37873ce1f6f6.png';

const benefits = [
  {
    icon: 'lucide:trending-down',
    title: 'Energy Savings',
    body: 'Reduce HVAC costs with advanced solar control film that rejects up to 86% of heat gain — lowering energy bills year-round without window replacement.',
  },
  {
    icon: 'lucide:sun',
    title: 'UV Protection',
    body: 'Block 99% of harmful UV rays to protect building occupants, preserve historical artifacts, and prevent interior furnishings from fading.',
  },
  {
    icon: 'lucide:shield-check',
    title: 'Safety & Security',
    body: 'Security window film holds glass together during forced entry attempts, blasts, or severe weather — buying critical response time and reducing injury risk.',
  },
  {
    icon: 'lucide:eye-off',
    title: 'Privacy & Glare Reduction',
    body: 'Control sightlines into sensitive areas and eliminate glare on screens and workstations, creating a more comfortable and productive environment.',
  },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/government-buildings/">

  <InnerPageHero
    title="Government Buildings"
    desc="Energy savings · Safety · Trusted by civic facilities"
    bgImage={heroUrl}
  />

  <div class="ip-page-body">

    <section class="gb-intro">
      <div class="gb-intro__inner">
        <div class="gb-intro__content">
          <span class="gb-eyebrow">Civic Window Film Solutions</span>
          <h2 class="gb-intro__title">Protecting Philadelphia Government Buildings Since 2008</h2>
          <p class="gb-intro__lead">Government window film in Philadelphia assists public offices with better energy savings, privacy, and enhanced security without costly renovations. Our certified team supports federal, state, and city buildings by reducing glare, improving HVAC efficiency, and reinforcing glass against break-ins or accidental impact.</p>
          <div class="gb-intro__ctas">
            <a href="/contact/" class="gb-btn gb-btn--primary">Get a Free Quote</a>
            <a href="/benefits/" class="gb-btn gb-btn--ghost">All Benefits</a>
          </div>
        </div>
        <div class="gb-intro__stats">
          <div class="gb-stat">
            <span class="gb-stat__num">16+</span>
            <span class="gb-stat__label">Years Serving PA & NJ</span>
          </div>
          <div class="gb-stat">
            <span class="gb-stat__num">100+</span>
            <span class="gb-stat__label">Government Projects</span>
          </div>
          <div class="gb-stat">
            <span class="gb-stat__num">99%</span>
            <span class="gb-stat__label">UV Blocked</span>
          </div>
          <div class="gb-stat">
            <span class="gb-stat__num">86%</span>
            <span class="gb-stat__label">Heat Gain Rejected</span>
          </div>
        </div>
      </div>
    </section>

    <section class="gb-benefits">
      <div class="gb-benefits__inner">
        <div class="gb-benefits__hd">
          <span class="gb-eyebrow">Why Window Film</span>
          <h2 class="gb-benefits__title">Key Benefits for Civic Facilities</h2>
        </div>
        <div class="gb-benefits__grid">
          {benefits.map((b) => (
            <div class="gb-card">
              <div class="gb-card__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={b.icon === 'lucide:trending-down' ? 'M3 7v6h6M21 15a9 9 0 11-18 0 9 9 0 0118 0z' : b.icon === 'lucide:sun' ? 'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z' : b.icon === 'lucide:shield-check' ? 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z' : 'M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88'} />
                </svg>
              </div>
              <h3 class="gb-card__title">{b.title}</h3>
              <p class="gb-card__body">{b.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="gb-cta">
      <div class="gb-cta__inner">
        <div class="gb-cta__content">
          <h2 class="gb-cta__title">Ready for a free consultation?</h2>
          <p class="gb-cta__sub">Our team has decades of experience protecting civic facilities across the Delaware Valley. Let's discuss your building's needs.</p>
          <div class="gb-cta__btns">
            <a href="/contact/" class="gb-btn gb-btn--green">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 16a2 2 0 001.985-1.75c.017-.137-.097-.25-.235-.25h-1.5c-.138 0-.252.113-.235.25A2 2 0 008 16zM7.002 11a1 1 0 112 0 1 1 0 01-2 0zM.102 4.01a.46.46 0 01.052-.051c2.548 0 4.916.907 6.672 2.55.12.112.084.275-.038.412-.122.137-.308.164-.412.038C7.038 5.94 5.678 5.033 3.13 3.126a.46.46 0 01-.052-.052z"/></svg>
              Get a Free Quote
            </a>
            <a href="tel:+12154270227" class="gb-btn gb-btn--outline">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.654 1.328a.678.678 0 01-.708 0l-1.5-1.5a.678.678 0 010-.707l.68-.681a.678.678 0 01.707 0l1.5 1.5a.678.678 0 010 .707l-.68.681zm7 0a.678.678 0 01-.707 0l-1.5-1.5a.678.678 0 010-.707l.68-.681a.678.678 0 01.707 0l1.5 1.5a.678.678 0 010 .707l-.68.681z"/><path d="M2.343 4.343a.5.5 0 01.707 0l.035.035a.5.5 0 010 .707L2.343 6.94l-.035-.035a.5.5 0 010-.707zm7.071 0a.5.5 0 01.707 0l.035.035a.5.5 0 010 .707L9.414 6.94l-.035-.035a.5.5 0 010-.707zM1.082 8.082a.5.5 0 01.354-.146l4.95-4.95a.5.5 0 01.707 0l.035.035a.5.5 0 010 .707l-4.95 4.95a.5.5 0 01-.708 0l-.035-.035a.5.5 0 010-.707zm8.854 0a.5.5 0 01.354-.146l4.95-4.95a.5.5 0 01.707 0l.035.035a.5.5 0 010 .707l-4.95 4.95a.5.5 0 01-.708 0l-.035-.035a.5.5 0 010-.707zM8.027 9.927a.5.5 0 01.207.05l4.95 4.95a.5.5 0 01-.236.72l-4.95-4.95a.5.5 0 01-.236-.72zm-4.69.276a.5.5 0 01.5 0l4.95 4.95a.5.5 0 010 .707l-4.95 4.95a.5.5 0 01-.707-.707l4.95-4.95a.5.5 0 010-.707zm4.69.276a.5.5 0 01.5 0l4.95 4.95a.5.5 0 010 .707l-4.95 4.95a.5.5 0 01-.707-.707l4.95-4.95a.5.5 0 010-.707z"/></svg>
              (215) 427-0227
            </a>
          </div>
        </div>
      </div>
    </section>

    <BrandLogos />

  </div><!-- end ip-page-body -->

</BaseLayout>

<style>
.ip-page-body {
  position: relative;
  background: var(--off-white, #F7F6F3);
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

.gb-eyebrow {
  display: block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

/* Intro */
.gb-intro {
  padding: 80px 5% 60px;
}
.gb-intro__inner {
  max-width: 1400px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.gb-intro__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: var(--brand, #272E32);
  line-height: 1.1;
  margin: 0 0 24px;
}
.gb-intro__lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  line-height: 1.7;
  color: #4a4a4a;
  margin: 0 0 32px;
}
.gb-intro__ctas {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}
.gb-intro__stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}
.gb-stat {
  background: var(--white, #ffffff);
  border-radius: 18px;
  padding: 28px 24px;
  box-shadow: 0 2px 16px rgba(39,46,50,0.08);
  text-align: center;
}
.gb-stat__num {
  display: block;
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 42px;
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
  margin-bottom: 8px;
}
.gb-stat__label {
  display: block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  color: #888;
  line-height: 1.4;
}

/* Buttons */
.gb-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 600;
  padding: 14px 28px;
  border-radius: 100px;
  text-decoration: none;
  transition: all 0.2s ease;
  cursor: pointer;
}
.gb-btn--primary {
  background: var(--brand, #272E32);
  color: #fff;
}
.gb-btn--primary:hover {
  background: #1a1f22;
}
.gb-btn--ghost {
  background: transparent;
  color: var(--brand, #272E32);
  border: 2px solid var(--brand, #272E32);
}
.gb-btn--ghost:hover {
  background: var(--brand, #272E32);
  color: #fff;
}
.gb-btn--green {
  background: var(--green, #81AB4C);
  color: #fff;
}
.gb-btn--green:hover {
  background: #6e9440;
}
.gb-btn--outline {
  background: transparent;
  color: #fff;
  border: 2px solid rgba(255,255,255,0.5);
}
.gb-btn--outline:hover {
  border-color: #fff;
  background: rgba(255,255,255,0.1);
}

/* Benefits */
.gb-benefits {
  padding: 60px 5%;
  background: var(--white, #ffffff);
}
.gb-benefits__inner {
  max-width: 1400px;
  margin: 0 auto;
}
.gb-benefits__hd {
  text-align: center;
  margin-bottom: 48px;
}
.gb-benefits__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: var(--brand, #272E32);
  margin: 0;
}
.gb-benefits__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.gb-card {
  background: var(--white, #ffffff);
  border-radius: 18px;
  padding: 32px 24px;
  box-shadow: 0 4px 24px rgba(39,46,50,0.1);
}
.gb-card__icon {
  width: 56px;
  height: 56px;
  background: var(--green-light, #eef4e4);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  color: var(--green, #81AB4C);
}
.gb-card__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 22px;
  font-weight: 700;
  color: var(--brand, #272E32);
  margin: 0 0 12px;
}
.gb-card__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  line-height: 1.65;
  color: #4a4a4a;
  margin: 0;
}

/* CTA */
.gb-cta {
  margin: 40px 5% 0;
  background: var(--brand, #272E32);
  border-radius: 24px;
  padding: 64px 5%;
}
.gb-cta__inner {
  max-width: 1400px;
  margin: 0 auto;
}
.gb-cta__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 16px;
}
.gb-cta__sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  line-height: 1.6;
  color: rgba(255,255,255,0.7);
  margin: 0 0 36px;
  max-width: 560px;
}
.gb-cta__btns {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}

@media (max-width: 1024px) {
  .gb-benefits__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 768px) {
  .gb-intro__inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .gb-benefits__grid {
    grid-template-columns: 1fr;
  }
  .gb-cta__btns {
    flex-direction: column;
  }
}
</style>