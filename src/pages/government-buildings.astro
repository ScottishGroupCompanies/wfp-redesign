    bottom: 0; left: 0; right: 0;
    padding: 28px;
    z-index: 5;
  }
  .of-space-card__photo-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: #F3F6F1;
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .of-space-card__photo-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: rgba(243,246,241,0.75);
    line-height: 1.5;
    margin: 0;
  }

  /* Cards 4 & 5: Dark — each spans 4 cols */
  .of-space-card--dark,
  .of-space-card--dark-pattern {
    grid-column: span 4;
    border-radius: 24px;
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-shadow: 0 4px 20px rgba(0,0,0,0.18);
    position: relative;
    overflow: hidden;
    min-height: 280px;
  }
