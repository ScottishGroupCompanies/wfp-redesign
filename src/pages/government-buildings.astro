---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogos from '../components/BrandLogos.astro';
import FlipWords from '../components/FlipWords.astro';
import CategoryBlogFeed from '../components/CategoryBlogFeed.astro';

const title = 'Government Window Film for Philadelphia | Civic Buildings';
const description = 'Government window film for Philadelphia — blast mitigation, security, UV protection, and energy savings for civic and federal buildings. Free site assessment.';
const dateModified = new Date().toISOString().slice(0, 10);

const testimonialOne = 'The security film installation was handled professionally and quietly. Court operations continued without disruption, and our team received the product documentation we needed for internal review.';
const testimonialTwo = 'The solar control film made our west-facing offices more comfortable for staff and visitors. It helped us address energy performance without changing the historic appearance of the building.';
const testimonialThree = 'The GSA-compatible documentation package was exactly what our review team needed. The installation crew understood federal building requirements and kept communication clear from assessment through completion.';

const faqItems = [
  {
    question: 'Does window film meet GSA blast mitigation standards?',
    answer: 'Yes. Government-grade 3M Scotchshield Ultra safety films can be specified for GSA-compatible glazing upgrades and UFC 4-010-01 blast mitigation goals. For government window film for Philadelphia projects, we provide film data sheets, attachment-system details, and compliance documentation so facility teams can review the product before approval.'
  },
  {
    question: "Can film be installed on Philadelphia's historic government buildings?",
    answer: 'Yes. Clear UV, security, and solar control films are often appropriate for historic civic buildings because they improve performance while preserving existing glass and exterior character. We assess single-pane glass, frame condition, thermal stress risk, and preservation requirements before recommending a product.'
  },
  {
    question: 'What security performance standards does anti-intrusion film meet?',
    answer: 'Security and anti-intrusion window films can be specified with ANSI Z97.1 safety glazing data, ASTM impact testing, and manufacturer documentation for forced-entry delay. The product holds broken glass together and keeps the pane in the frame longer when paired with the correct attachment system.'
  },
  {
    question: 'Does window film qualify for LEED energy credits on government buildings?',
    answer: 'Solar control film can support LEED Energy and Atmosphere documentation by improving modeled solar heat gain, visible light transmission, and cooling-load performance. We provide SHGC, VLT, TSER, and manufacturer data for the film selected for your government building.'
  },
  {
    question: 'Can installation happen without disrupting public-facing government operations?',
    answer: 'Yes. Government window film can be sequenced by zone, department, entrance, or floor so public counters, courts, and administrative offices can remain accessible. We coordinate with facility managers and security staff to protect public service hours while the film is installed.'
  },
  {
    question: 'Does window film help meet Pennsylvania government energy efficiency mandates?',
    answer: 'Yes. Solar control and low-e window films can help aging civic buildings reduce solar heat gain and improve envelope performance without full window replacement. We provide energy-performance documentation that can support Pennsylvania, federal, and internal sustainability review.'
  },
  {
    question: 'What privacy film options are appropriate for sensitive government offices?',
    answer: 'One-way daytime privacy film, frosted privacy film, and decorative opaque bands can all be specified for HR offices, permit counters, interview rooms, jury spaces, and administrative glass. We match the product to lighting conditions and sensitivity level so the space keeps daylight while controlling sightlines.'
  },
  {
    question: 'Can film be applied to older single-pane windows in historic civic buildings?',
    answer: 'Yes, when the glass is compatible. Many Philadelphia civic buildings have older single-pane windows that can receive clear UV film, security film, or selected solar control films after a glass assessment. We review glass age, frame condition, shading, and thermal stress before specifying the product.'
  },
  {
    question: 'How is window film procurement handled for government buildings?',
    answer: 'We support procurement with product specifications, manufacturer data sheets, insurance documentation, safety certifications, and written scope language. For government window film for Philadelphia facilities, we can align film recommendations with GSA-compatible specs, security-review requirements, and energy documentation needs.'
  },
  {
    question: 'What documentation can you provide for government compliance review?',
    answer: 'We provide manufacturer technical data, film performance specs, safety and blast documentation, attachment-system details, warranty information, LEED-relevant energy data, and post-installation records. The package is designed for facility managers, procurement teams, security reviewers, and sustainability officers.'
  }
];

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Government Building Window Film', item: 'https://www.windowfilmphiladelphia.net/government-buildings/' }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://www.windowfilmphiladelphia.net/government-buildings/',
    url: 'https://www.windowfilmphiladelphia.net/government-buildings/',
    name: 'Government Window Film for Philadelphia',
    description,
    dateModified,
    primaryImageOfPage: { '@type': 'ImageObject', url: 'https://www.windowfilmphiladelphia.net/images/gv-hero.jpg' },
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.of-hero__title', '.of-whatis__title', '.swt-faq'] }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Government Window Film Solutions Philadelphia',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Blast Mitigation Film', description: 'GSA-compatible 3M Scotchshield Ultra film for Philadelphia government buildings, courthouses, and federal facilities.' },
      { '@type': 'ListItem', position: 2, name: 'Security & Anti-Intrusion Film', description: 'Safety and forced-entry delay film for public-facing civic glass, police precincts, and municipal offices.' },
      { '@type': 'ListItem', position: 3, name: 'Solar Control & Energy Film', description: 'Solar control window film that rejects up to 86% heat gain and supports LEED energy documentation.' },
      { '@type': 'ListItem', position: 4, name: 'UV Protection Film', description: 'Clear UV-blocking film protecting records, awards, furnishings, and historic civic interiors.' },
      { '@type': 'ListItem', position: 5, name: 'Privacy Film', description: 'One-way and frosted privacy film for HR, permit, jury, and sensitive administrative areas.' },
      { '@type': 'ListItem', position: 6, name: 'Decorative & Wayfinding Film', description: 'Frosted, branded, and wayfinding films for public counters, interior partitions, and agency spaces.' }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Government Window Film Philadelphia',
    description: 'Government window film for Philadelphia civic facilities, including blast mitigation, security, solar control, UV protection, privacy, and compliance documentation.',
    brand: { '@type': 'Brand', name: 'Window Film Philadelphia' },
    aggregateRating: { '@type': 'AggregateRating', ratingValue: '5.0', ratingCount: '47', bestRating: '5', worstRating: '1' },
    review: [
      { '@type': 'Review', author: { '@type': 'Person', name: 'Marcus T., Facilities Manager, Philadelphia Municipal Court' }, reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }, reviewBody: testimonialOne },
      { '@type': 'Review', author: { '@type': 'Person', name: 'Director of Operations, Philadelphia City Agency' }, reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }, reviewBody: testimonialTwo },
      { '@type': 'Review', author: { '@type': 'Person', name: 'Federal Property Administrator' }, reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }, reviewBody: testimonialThree }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.windowfilmphiladelphia.net/government-buildings/"
  serviceName="Government Window Film Philadelphia"
  serviceDesc="Government window film for Philadelphia civic buildings — security, blast mitigation, solar control, UV protection, and privacy with compliance documentation."
  serviceUrl="https://www.windowfilmphiladelphia.net/government-buildings/"
  faqItems={faqItems}
  schemas={pageSchemas}
>

  <!-- ══ HERO ══ -->
  <section class="of-hero gv-hero">
    <div
      class="of-hero__bg gv-hero__bg"
      role="img"
      aria-label="Philadelphia civic building interior with protected government window film on tall public-facing glass"
      style="background-image: url('/images/gv-hero.jpg')"
    ></div>
    <div class="of-hero__overlay"></div>

    <div class="of-hero__content">
      <div class="of-hero__eyebrow">
        <span>Government Window Film</span>
        <span class="of-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Philadelphia</span>
        <span class="of-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>3M Certified Dealer</span>
      </div>

      <h1 class="of-hero__title">Government Window Film</h1>

      <p class="of-hero__animated-line">
        <FlipWords
          words={["for Philadelphia Civic Buildings", "for Philadelphia City Hall", "for Philadelphia Courthouses", "for Philadelphia Federal Buildings", "for Philadelphia Public Safety Buildings", "for Philadelphia Municipal Offices"]}
          staticText=""
          class="of-hero__flip"
        />
      </p>

      <p class="of-hero__subtitle">
        Government window film for Philadelphia civic facilities covers the full range of public-building needs: security, blast mitigation, UV protection, energy savings, and privacy for courthouses, municipal offices, police precincts, and federal buildings.
      </p>

      <div class="of-hero__cta">
        <a href="/contact/" class="of-hero__btn-primary">Request a Government Assessment</a>
        <a href="tel:2673947980" class="of-hero__btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z" fill="currentColor"/></svg>
          Call (267) 394-7980
        </a>
      </div>

      <div class="of-hero__stats-panel" aria-label="Government window film performance statistics">
        <div class="of-hero__stats-inner">
          <div class="of-hero__stat"><span class="of-hero__stat-number">GSA</span><span class="of-hero__stat-label">Compatible Specs</span></div>
          <div class="of-hero__stat-divider" aria-hidden="true"></div>
          <div class="of-hero__stat"><span class="of-hero__stat-number">86%</span><span class="of-hero__stat-label">Heat Rejected</span></div>
          <div class="of-hero__stat-divider" aria-hidden="true"></div>
          <div class="of-hero__stat"><span class="of-hero__stat-number">99%</span><span class="of-hero__stat-label">UV Blocked</span></div>
          <div class="of-hero__stat-divider" aria-hidden="true"></div>
          <div class="of-hero__stat"><span class="of-hero__stat-number">3M</span><span class="of-hero__stat-label">Certified Dealer</span></div>
        </div>
      </div>
    </div>
  </section>

  <div class="swt-body">

    <!-- ══ TRUST BAR ══ -->
    <section class="swt-trust">
      <div class="container">
        <p class="swt-trust__label">Trusted window film specifications for Philadelphia civic, commercial, and public-facing buildings</p>
        <BrandLogos />
      </div>
    </section>

    <!-- ══ WHAT IS ══ -->
    <section class="of-whatis">
      <div class="of-whatis__container">
        <div class="of-whatis__content">
          <span class="of-whatis__eyebrow">Philadelphia's Certified Window Film Installer</span>
          <h2 class="of-whatis__title">The Film Philadelphia Government Buildings Actually Need</h2>
          <p class="of-whatis__body">Government buildings need more from window film than basic tint. City halls, courthouses, police precincts, post offices, and federal offices must balance public access with security, documented specifications, occupant comfort, and preservation of existing civic architecture.</p>
          <p class="of-whatis__body">For Philadelphia facilities, that often means GSA-compatible blast mitigation film, forced-entry delay at public-facing glass, solar control for aging single-pane windows, and clear UV protection for documents and interior materials. Our team specifies films from 3M, LLumar, Solar Gard, and Madico with the performance data procurement teams need.</p>
          <p class="of-whatis__body">Window Film Philadelphia is a 3M Certified Dealer, which matters on government window film for Philadelphia projects where product documentation, attachment systems, and installation standards have to stand up to review. We provide the film data, warranty records, and compliance package before work begins.</p>
          <div class="of-whatis__stats">
            <div class="of-whatis__stat"><strong>UFC</strong><span>4-010-01 alignment</span></div>
            <div class="of-whatis__stat-div"></div>
            <div class="of-whatis__stat"><strong>LEED</strong><span>Energy data available</span></div>
            <div class="of-whatis__stat-div"></div>
            <div class="of-whatis__stat"><strong>3M</strong><span>Certified dealer</span></div>
          </div>
        </div>
        <div class="of-whatis__image-wrap">
          <img src="/images/gv-whatis.jpg" alt="Philadelphia government building interior with existing civic windows prepared for certified window film" title="Philadelphia government building interior with existing civic windows prepared for certified window film" class="of-whatis__image" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- ══ THE PROBLEM ══ -->
    <section class="of-why" id="problem">
      <div class="of-why__container">
        <div class="of-why__image-wrap">
          <img src="/images/gv-why.jpg" alt="Aging Philadelphia civic building with large public-facing windows and afternoon sun exposure" title="Aging Philadelphia civic building with large public-facing windows and afternoon sun exposure" class="of-why__image" loading="lazy" />
          <div class="of-why__stat-card">
            <div class="of-why__stat-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>Pre-1970 glass stock needs performance upgrades</span></div>
            <div class="of-why__stat-divider"></div>
            <div class="of-why__stat-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>Security, energy, and privacy needs overlap</span></div>
          </div>
        </div>
        <div class="of-why__content">
          <div class="of-why__eyebrow">The Challenge</div>
          <h2 class="of-why__headline">Philadelphia's Civic Buildings Face Compounding Challenges</h2>
          <p class="of-why__intro">Many Philadelphia government buildings were built before modern thermal glass, security glazing, or LEED-driven energy performance became part of facility planning. Their windows are often beautiful, historically important, and inefficient at the same time.</p>
          <ul class="of-why__bullets">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Aging pre-1970 window stock often lacks modern thermal performance, creating heat gain across public offices and administrative wings.</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Post-9/11 security requirements put more attention on entry glass, lobby glazing, courtroom windows, and public-safety facilities.</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Federal and state energy mandates push facility teams toward envelope improvements that avoid full window replacement.</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Public-facing transparency has to coexist with privacy for HR, permit processing, jury, records, and law-enforcement areas.</li>
          </ul>
          <div class="of-why__climate-facts">
            <div class="of-why__climate-item"><span class="of-why__climate-num">86%</span><span class="of-why__climate-label">Solar heat rejected by selected films</span></div>
            <div class="of-why__climate-item"><span class="of-why__climate-num">99%</span><span class="of-why__climate-label">UV rejection for records and interiors</span></div>
            <div class="of-why__climate-item"><span class="of-why__climate-num">GSA</span><span class="of-why__climate-label">Documentation-ready specifications</span></div>
          </div>
          <a href="/contact/" class="of-why__cta">Schedule a government site assessment <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg></a>
        </div>
      </div>
    </section>

    <!-- ══ BENTO BAND ══ -->
    <section class="of-bento">
      <div class="of-bento__header">
        <h2 class="of-bento__title">One Certified Installer. Every Civic Need Covered.</h2>
        <p class="of-bento__sub">Government window film for Philadelphia facilities can combine safety, energy, UV, and privacy performance in one specification package.</p>
      </div>
      <div class="of-bento__compact">
        <div class="of-bento-item"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M14 3L5 8v7c0 5 4 9 9 10 5-1 9-5 9-10V8L14 3z" stroke="#7CB342" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 14l3 3 5-5" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><div><h3 class="of-bento-item__title">GSA-Compliant Film</h3><p class="of-bento-item__text">Blast mitigation films can be specified for UFC 4-010-01 standards with supporting manufacturer documentation.</p></div></div>
        <div class="of-bento-item"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M16 2L6 16h7l-1 10 10-15h-7l1-9z" stroke="#7CB342" stroke-width="1.5" stroke-linejoin="round"/></svg><div><h3 class="of-bento-item__title">86% Heat Rejected</h3><p class="of-bento-item__text">Solar control film improves comfort in west-facing offices, counters, lobbies, and civic wings.</p></div></div>
        <div class="of-bento-item"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><circle cx="14" cy="14" r="9" stroke="#7CB342" stroke-width="1.5"/><path d="M10 14l3 3 5-6" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><div><h3 class="of-bento-item__title">3M Certified Dealer</h3><p class="of-bento-item__text">Certified product selection and installation support for Philadelphia-region government projects.</p></div></div>
        <div class="of-bento-item"><svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><circle cx="14" cy="14" r="5" stroke="#7CB342" stroke-width="1.5"/><path d="M14 2v4M14 22v4M2 14h4M22 14h4M5.5 5.5l3 3M19.5 19.5l3 3M22.5 5.5l-3 3M8.5 19.5l-3 3" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round"/></svg><div><h3 class="of-bento-item__title">99% UV Blocked</h3><p class="of-bento-item__text">Documents, furnishings, awards, artwork, and civic interior materials stay protected from irreversible fading.</p></div></div>
      </div>
    </section>

    <!-- ══ SPACE TYPE GRID ══ -->
    <section class="of-spaces">
      <div class="of-spaces__container">
        <div class="of-spaces__header"><div class="of-spaces__eyebrow">Where We Install</div><h2 class="of-spaces__headline">Window Film for Every Philadelphia Government Facility</h2><p class="of-spaces__sub">Each facility type carries different security, privacy, procurement, and energy considerations.</p></div>
        <div class="of-spaces__grid">

          <!-- Card 1: Courthouses — hero -->
          <div class="of-space-card of-space-card--hero">
            <div class="of-space-card__hero-icon">
              <svg width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true">
                <path d="M8 36V20M22 36V12M36 36V20" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M4 20h36M4 36h36" stroke="#7CB342" stroke-width="1.5" opacity="0.5"/>
                <path d="M14 12h16l4 8H10l4-8z" stroke="#7CB342" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="of-space-card__hero-title">Courthouses &amp; Legal Facilities</h3>
            <p class="of-space-card__hero-text">Courtrooms, jury deliberation rooms, and legal corridors require a layered approach — blast-mitigation film on exterior glazing, one-way privacy film on public-facing conference glass, and security film on entry doors. We provide compliance documentation for facility review.</p>
            <div class="of-space-card__pill">Security + Privacy + Blast</div>
          </div>

          <!-- Card 2: City Hall — photo -->
          <div class="of-space-card of-space-card--photo">
            <img src="/images/gv-type-cityhall.jpg" alt="City hall and municipal office windows with solar control and privacy window film Philadelphia" title="City hall and municipal office windows with solar control and privacy window film Philadelphia" width="400" height="480" loading="lazy" class="of-space-card__img" />
            <div class="of-space-card__photo-overlay"></div>
            <div class="of-space-card__photo-content">
              <h3 class="of-space-card__photo-title">City Hall &amp; Municipal Offices</h3>
              <p class="of-space-card__photo-text">Permit counters, HR offices, and west-facing wings — glare reduction on workstation screens, one-way privacy film for sensitive areas.</p>
            </div>
          </div>

          <!-- Card 3: Police — photo -->
          <div class="of-space-card of-space-card--photo">
            <img src="/images/gv-type-police.jpg" alt="Philadelphia police precinct entry glass with security and anti-intrusion window film" title="Philadelphia police precinct entry glass with security and anti-intrusion window film" width="400" height="480" loading="lazy" class="of-space-card__img" />
            <div class="of-space-card__photo-overlay"></div>
            <div class="of-space-card__photo-content">
              <h3 class="of-space-card__photo-title">Police Precincts &amp; Public Safety</h3>
              <p class="of-space-card__photo-text">Anti-intrusion film delays forced entry; privacy film controls sightlines in processing and records areas.</p>
            </div>
          </div>

          <!-- Card 4: Permit Offices — dark -->
          <div class="of-space-card of-space-card--dark">
            <div class="of-space-card__accent-line" aria-hidden="true"></div>
            <div class="of-space-card__icon-row">
              <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <rect x="6" y="4" width="22" height="26" rx="2" stroke="#7CB342" stroke-width="1.5"/>
                <path d="M11 12h12M11 17h12M11 22h8" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
              </svg>
            </div>
            <h3 class="of-space-card__dark-title">Permit Offices &amp; Public Counters</h3>
            <p class="of-space-card__dark-text">Public-facing permit windows need to balance transparency with privacy. One-way reflective film blocks views into records and HR areas while keeping counter glass open and welcoming from the front.</p>
            <div class="of-space-card__micro-pill">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l3 6.5L22 9l-5 5 1.18 7L12 18l-6.18 3L7 14 2 9l7-.5L12 2z" stroke="#7CB342" stroke-width="2" stroke-linejoin="round"/></svg>
              Privacy + Glare Control
            </div>
          </div>

          <!-- Card 5: Lobbies & Entries — dark-pattern -->
          <div class="of-space-card of-space-card--dark-pattern">
            <div class="of-space-card__icon-row">
              <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
                <path d="M17 4L5 10v14l12 6 12-6V10L17 4z" stroke="#7CB342" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M12 17l3 3 7-7" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="of-space-card__dark-title">Government Lobbies &amp; Entry Glass</h3>
            <p class="of-space-card__dark-text">Security film on lobby entry doors and vestibule glass holds shattered panels together under impact — critical for public buildings with high pedestrian traffic and limited security staffing at every entrance.</p>
            <div class="of-space-card__micro-pill">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l3 6.5L22 9l-5 5 1.18 7L12 18l-6.18 3L7 14 2 9l7-.5L12 2z" stroke="#7CB342" stroke-width="2" stroke-linejoin="round"/></svg>
              Security + Blast Mitigation
            </div>
          </div>

          <!-- Card 6: Federal Buildings — badge -->
