---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogos from '../components/BrandLogos.astro';
import BentoGridSymmetric from '../components/BentoGridSymmetric.astro';
import AccordionFAQ from '../components/AccordionFAQ.astro';
import CTAAvatars from '../components/CTAAvatars.astro';

const title = 'Window Film Applications in Philadelphia | Homes, Offices, Retail & More';
const description = 'Professional window film applications in Philadelphia — homes, offices, retail, restaurants, hotels, schools, healthcare, government, museums, and churches. Find the right film for your space.';
const dateModified = new Date().toISOString().slice(0, 10);

// All 12 application subpages from the nav menu (including Homes & Condos)
const applicationItems = [
  { title: 'Homes & Condos', desc: 'Energy savings, UV protection, privacy, and safety film for Philadelphia rowhomes, condos, and historic residences.', img: '/images/applications/residential-window-film-philadelphia-homes-condos.jpg', href: '/applications/homes-condos/' },
  { title: 'Office Buildings', desc: 'Glare reduction, solar control, and security film for productive workspaces across Center City and beyond.', img: '/images/applications/office-window-film-philadelphia.jpg', href: '/applications/office/' },
  { title: 'Retail & Storefronts', desc: 'Security, anti-graffiti, and decorative film that protects merchandise and enhances your storefront.', img: '/images/applications/retail-window-film-philadelphia.jpg', href: '/applications/retail/' },
  { title: 'Restaurants', desc: 'Solar control film that eliminates afternoon glare and keeps dining rooms comfortable for every seat.', img: '/images/applications/restaurant-window-tinting-philadelphia.jpg', href: '/applications/restaurants/' },
  { title: 'Hotels & Hospitality', desc: 'Guest comfort, energy savings, and decorative film for lobbies, guest rooms, and common areas.', img: '/images/applications/hotel-window-film-philadelphia.jpg', href: '/applications/hotel-window-film/' },
  { title: 'Mass Transit & Airport', desc: 'Safety and security film for transit hubs, airport terminals, and high-traffic public glass.', img: '/images/applications/transit-window-film-philadelphia.jpg', href: '/applications/mass-transit/' },
  { title: 'Schools & Universities', desc: 'Safety, security, and UV protection film for classrooms, dormitories, and campus buildings.', img: '/images/applications/school-window-film-philadelphia.jpg', href: '/applications/schools-universities/' },
  { title: 'Hospitals & Healthcare', desc: 'UV blocking, privacy, and energy-saving film for patient rooms, clinics, and medical offices.', img: '/images/applications/healthcare-window-film-philadelphia.jpg', href: '/applications/healthcare/' },
  { title: 'Government Buildings', desc: 'Security film, blast mitigation, and forced-entry delay for courthouses, municipal offices, and federal facilities.', img: '/images/applications/government-window-tinting-philadelphia.jpg', href: '/government-buildings/' },
  { title: 'Secured Buildings', desc: 'Ballistic-resistant and forced-entry film for facilities that require the highest level of glass protection.', img: '/images/applications/security-window-film-philadelphia.jpg', href: '/applications/secured-buildings/' },
  { title: 'Museums & Libraries', desc: 'Conservation-grade UV filtering film that protects artwork, archives, and irreplaceable collections from fading.', img: '/images/applications/museum-window-film-philadelphia.jpg', href: '/applications/museums-libraries/' },
  { title: 'Churches & Faith Centers', desc: 'UV and glare protection for historic stained glass, worship spaces, and community gathering halls.', img: '/images/applications/church-window-film-philadelphia.jpg', href: '/applications/churches/' },
];

const faqItems = [
  { question: 'What are the most common window film applications in Philadelphia?', answer: 'The most common window film applications in Philadelphia span residential and commercial properties. Homes and condos use solar control and UV protection film to reduce cooling costs and protect furnishings. Office buildings install glare reduction and privacy film for occupant comfort. Retail storefronts rely on security and anti-graffiti film. Government and secured buildings require blast mitigation and forced-entry film. Schools, healthcare facilities, museums, and churches each have specialized film needs based on their unique operational priorities.' },
  { question: 'How do I know which window film is right for my building?', answer: 'The right film depends on your glass type, building orientation, and what you need the film to do — reduce heat, block UV, add privacy, improve security, or all of the above. We assess every pane individually, checking thermal stress risk, glass age, and frame condition before recommending a product. Different zones of the same building often need different films: solar control on the west facade, glare reduction on the south, security film on the ground floor.' },
  { question: 'Does every glass type work with every window film application?', answer: 'Window film can be applied to most glass types including single-pane, double-pane IGUs, tempered, laminated, and low-E glass. However, not every film is suitable for every glass type — using the wrong film on the wrong glass can cause thermal breakage. Our team evaluates each pane individually during a free site assessment before recommending a product. We carry the documentation property managers and compliance teams need.' },
  { question: 'Does window film really reduce energy costs?', answer: 'Yes. Solar heat gain through untreated glass is a major contributor to cooling load. Spectrally selective films reject up to 78% of solar heat gain without darkening interiors, which reduces the demand on your HVAC system. Many Philadelphia clients see measurable energy savings within the first billing cycle. The exact reduction depends on glass orientation, film type, and building envelope.' },
  { question: 'What is the expected lifespan of professional window film?', answer: 'Professional-grade window films typically last 12–20 years depending on film type, glass orientation, and environmental exposure. South- and west-facing windows with direct sun exposure may see shorter lifespans than north-facing windows. All our installations include manufacturer warranty coverage and our own labor guarantee. We never use lifetime warranty language — we provide the manufacturer warranty terms for your specific product.' },
  { question: 'Can security window film be applied to existing glass?', answer: 'Yes. Security and safety window films are applied directly to existing glass and provide meaningful protection without replacing the glass. For high-security applications, we also offer attachment systems that anchor the film to the window frame, helping hold the glass in place during explosions or severe storms. We assess each project to recommend the appropriate film and attachment method.' },
  { question: 'What Philadelphia neighborhoods do you cover for window film installations?', answer: 'We serve the entire Delaware Valley including Center City, Old City, South Philly, Fishtown, Northern Liberties, Manayunk, University City, King of Prussia, Camden NJ, and surrounding areas. Our installation crews are Philadelphia-based — no travel surcharge within the standard service area.' },
  { question: 'Do you work with property managers and building owners?', answer: 'Yes. A significant portion of our work is through property management firms and building managers who oversee multiple properties. We provide site assessments, detailed proposals, and coordinate installations across portfolios. We are licensed and insured in both Pennsylvania and New Jersey, and we carry the documentation most management companies require.' },
];

const faqAccordionItems = faqItems.map(f => ({ q: f.question, a: f.answer }));

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Applications', item: 'https://www.windowfilmphiladelphia.net/applications/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://www.windowfilmphiladelphia.net/applications/',
    url: 'https://www.windowfilmphiladelphia.net/applications/',
    name: 'Window Film Applications in Philadelphia',
    description,
    dateModified,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Window Film Applications in Philadelphia',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Homes & Condos', description: 'Energy savings, UV protection, privacy, and safety film for Philadelphia residences.', url: 'https://www.windowfilmphiladelphia.net/applications/homes-condos/' },
      { '@type': 'ListItem', position: 2, name: 'Office Buildings', description: 'Glare reduction, solar control, and security film for productive workspaces.', url: 'https://www.windowfilmphiladelphia.net/applications/office/' },
      { '@type': 'ListItem', position: 3, name: 'Retail & Storefronts', description: 'Security, anti-graffiti, and decorative film for retail storefronts.', url: 'https://www.windowfilmphiladelphia.net/applications/retail/' },
      { '@type': 'ListItem', position: 4, name: 'Restaurants', description: 'Solar control film that eliminates afternoon glare for dining rooms.', url: 'https://www.windowfilmphiladelphia.net/applications/restaurants/' },
      { '@type': 'ListItem', position: 5, name: 'Hotels & Hospitality', description: 'Guest comfort, energy savings, and decorative film for hospitality properties.', url: 'https://www.windowfilmphiladelphia.net/applications/hotel-window-film/' },
      { '@type': 'ListItem', position: 6, name: 'Mass Transit & Airport', description: 'Safety and security film for transit hubs and airport terminals.', url: 'https://www.windowfilmphiladelphia.net/applications/mass-transit/' },
      { '@type': 'ListItem', position: 7, name: 'Schools & Universities', description: 'Safety, security, and UV protection film for educational campuses.', url: 'https://www.windowfilmphiladelphia.net/applications/schools-universities/' },
      { '@type': 'ListItem', position: 8, name: 'Hospitals & Healthcare', description: 'UV blocking, privacy, and energy-saving film for medical facilities.', url: 'https://www.windowfilmphiladelphia.net/applications/healthcare/' },
      { '@type': 'ListItem', position: 9, name: 'Government Buildings', description: 'Security film, blast mitigation, and forced-entry delay for public facilities.', url: 'https://www.windowfilmphiladelphia.net/government-buildings/' },
      { '@type': 'ListItem', position: 10, name: 'Secured Buildings', description: 'Ballistic-resistant and forced-entry film for high-security facilities.', url: 'https://www.windowfilmphiladelphia.net/applications/secured-buildings/' },
      { '@type': 'ListItem', position: 11, name: 'Museums & Libraries', description: 'Conservation-grade UV filtering film for artwork and archive protection.', url: 'https://www.windowfilmphiladelphia.net/applications/museums-libraries/' },
      { '@type': 'ListItem', position: 12, name: 'Churches & Faith Centers', description: 'UV and glare protection for historic stained glass and worship spaces.', url: 'https://www.windowfilmphiladelphia.net/applications/churches/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Window Film Applications Philadelphia',
    description: 'Professional window film installation for every application in Philadelphia — homes, offices, retail, restaurants, hotels, schools, healthcare, government, secured buildings, museums, and churches. Solar control, UV protection, security, anti-graffiti, privacy, and decorative film applied to existing glass.',
    brand: { '@type': 'Brand', name: 'Window Film Philadelphia' },
    aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', ratingCount: '2400', bestRating: '5', worstRating: '1' },
    offers: { '@type': 'Offer', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.windowfilmphiladelphia.net/applications/"
  faqItems={faqItems}
  serviceName="Window Film Applications Philadelphia"
  serviceDesc="Professional window film installation for every application in Philadelphia — homes, offices, retail, restaurants, hotels, schools, healthcare, government, and more."
  serviceUrl="https://www.windowfilmphiladelphia.net/applications/"
  schemas={pageSchemas}
>

<!-- ═══ HERO ═══ -->
<section class="ap-hero">
  <div class="ap-hero__bg" style="background-image: url('/images/applications/window-film-applications-philadelphia-hero.jpg')" role="img" aria-label="Philadelphia buildings with professional window film installed across different property types"></div>
  <div class="ap-hero__overlay"></div>
  <div class="ap-hero__content">
    <div class="ap-hero__eyebrow">
      <span class="ap-hero__eyebrow-dot" aria-hidden="true"></span>
      WINDOW FILM APPLICATIONS
      <span class="ap-hero__eyebrow-dot" aria-hidden="true"></span>
    </div>
    <h1 class="ap-hero__title">Window Film Applications in Philadelphia</h1>
    <p class="ap-hero__subtitle">From rowhomes to high-rises, storefronts to schools — professional window film for every type of Philadelphia property. Explore each application and find the right film for your space.</p>
    <div class="ap-hero__cta">
      <a href="/contact/" class="ap-hero__btn-primary">Get a Free Consultation</a>
      <a href="tel:2673947980" class="ap-hero__btn-secondary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
        Call (267) 394-7980
      </a>
    </div>
    <div class="ap-hero__stats-panel" aria-label="Key statistics">
      <div class="ap-hero__stats-inner">
        <div class="ap-hero__stat">
          <span class="ap-hero__stat-number">PA &amp; NJ</span>
          <span class="ap-hero__stat-label">Licensed In</span>
        </div>
        <div class="ap-hero__stat-divider" aria-hidden="true"></div>
        <div class="ap-hero__stat">
          <span class="ap-hero__stat-number">2008</span>
          <span class="ap-hero__stat-label">Serving Since</span>
        </div>
        <div class="ap-hero__stat-divider" aria-hidden="true"></div>
        <div class="ap-hero__stat">
          <span class="ap-hero__stat-number">1.2M+</span>
          <span class="ap-hero__stat-label">Sq Ft Installed</span>
        </div>
        <div class="ap-hero__stat-divider" aria-hidden="true"></div>
        <div class="ap-hero__stat">
          <span class="ap-hero__stat-number">4.9</span>
          <span class="ap-hero__stat-label">Google Rating</span>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="ap-body">

<!-- TRUST BAR -->
<section class="ap-trust">
  <div class="ap-container">
    <p class="ap-trust__label">Trusted by Philadelphia homeowners, businesses, and institutions since 2008</p>
  </div>
</section>

<BrandLogos />

<!-- ═══ INTRO — 2-col with image ═══ -->
<section class="ap-intro">
  <div class="ap-intro__container">
    <div class="ap-intro__content">
      <span class="ap-eyebrow">Every Application</span>
      <h2 class="ap-intro__title">One team. Every type of Philadelphia property.</h2>
      <p class="ap-intro__lead">Window film isn't a one-size-fits-all product. A <a href="/applications/homes-condos/" style="color: var(--ap-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">South Philly rowhome</a> needs different film than a <a href="/applications/office/" style="color: var(--ap-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">Center City office tower</a>. A <a href="/applications/museums-libraries/" style="color: var(--ap-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">museum gallery</a> has different priorities than a <a href="/applications/retail/" style="color: var(--ap-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">retail storefront on South Street</a>. We've spent over 15 years installing the right film for the right application across the Delaware Valley — and we've built a dedicated page for each one.</p>
      <p class="ap-intro__lead">Browse all twelve window film applications in Philadelphia below. Each page breaks down the specific film recommendations, common challenges, and installation approach for that property type. Whether you're a <a href="/services/residential/" style="color: var(--ap-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">homeowner looking to cut cooling costs</a> or a facility manager evaluating <a href="/government-buildings/" style="color: var(--ap-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">security film for a government building</a>, there's a page tailored to your situation. According to the U.S. Department of Energy, <a href="https://www.energy.gov/cmei/buildings/retrofit-existing-buildings" target="_blank" rel="noopener noreferrer" style="color: var(--ap-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">retrofitting existing buildings</a> with energy-saving measures like window film is one of the most cost-effective ways to improve performance without full glass replacement.</p>
    </div>
    <div class="ap-intro__image-wrap">
      <img src="/images/applications/window-film-applications-philadelphia-intro.jpg" alt="Philadelphia interior showing professional window film installed across different building types" title="Window film applications in Philadelphia — Window Film Philadelphia" class="ap-intro__image" loading="lazy" />
    </div>
  </div>
</section>

<!-- ═══ BENTO GRID SYMMETRIC — all 12 application subpages ═══ -->
<BentoGridSymmetric
  heading="Window film applications in Philadelphia"
  sub="Explore each application in detail — film recommendations, common challenges, and our installation approach for every property type."
  items={applicationItems}
/>

<!-- ═══ FAQ ═══ -->
<AccordionFAQ
  eyebrow="FAQ"
  heading="Window film applications — frequently asked questions"
  sub="Everything you need to know before exploring the right film for your Philadelphia property."
  items={faqAccordionItems}
/>

<!-- ═══ CTA ═══ -->
<CTAAvatars
  title="Not sure which application fits your property?"
  subtitle="Tell us about your building and your goals. We'll help you find the right film — no pressure, no obligation. Free consultation and detailed proposal."
  count="Trusted by 2,400+ Philadelphia property owners"
  btnLabel="Get a Free Consultation"
  btnHref="/contact/"
/>

<!-- ═══ GEO BLOCK (hidden SEO/AEO content) ═══ -->
<div class="ap-geo" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;">
  <h2>Window Film Applications in Philadelphia — Every Property Type</h2>
  <p>Window Film Philadelphia installs window film for every application in Philadelphia and the Delaware Valley. Our certified installation team applies solar control, UV protection, glare reduction, security, anti-graffiti, privacy, safety, and decorative window film to residential, commercial, institutional, and government properties. Window film applications in Philadelphia include homes and condos, office buildings, retail storefronts, restaurants, hotels and hospitality, mass transit and airports, schools and universities, hospitals and healthcare facilities, government buildings, secured buildings, museums and libraries, and churches and faith centers. Each application requires a different film selection based on glass type, orientation, and operational priorities. We serve Center City, Old City, South Philly, Fishtown, Northern Liberties, Manayunk, University City, King of Prussia, Camden NJ, and the broader Delaware Valley. Contact Window Film Philadelphia for a free consultation.</p>
  <dl>
    <dt>What are window film applications in Philadelphia?</dt>
    <dd>Window film applications in Philadelphia cover every property type where film is installed on existing glass — residential homes and condos, commercial offices and retail, hospitality venues, educational and healthcare facilities, government and secured buildings, and cultural institutions like museums and churches.</dd>
    <dt>How many window film applications do you serve in Philadelphia?</dt>
    <dd>We serve twelve distinct window film applications in Philadelphia, each with a dedicated page: homes and condos, office buildings, retail, restaurants, hotels and hospitality, mass transit and airport, schools and universities, hospitals and healthcare, government buildings, secured buildings, museums and libraries, and churches and faith centers.</dd>
    <dt>Which Philadelphia neighborhoods do you serve for window film applications?</dt>
    <dd>We serve window film applications throughout Greater Philadelphia including Center City, Old City, South Street, Fishtown, Northern Liberties, Manayunk, University City, King of Prussia, Camden NJ, and the broader Delaware Valley. No travel surcharge within the standard service area.</dd>
    <dt>What is the best window film for my Philadelphia application?</dt>
    <dd>The best film depends on your property type, glass type, and goals. Solar control film is popular for west-facing offices and homes. Security film is recommended for ground-floor retail and government buildings. UV protection film is essential for museums and healthcare. We assess each property individually during a free consultation.</dd>
    <dt>Do you serve both residential and commercial window film applications?</dt>
    <dd>Yes. We install window film for both residential and commercial applications in Philadelphia. Residential applications include homes, condos, and historic residences. Commercial applications include offices, retail, restaurants, hotels, schools, healthcare, government, and institutional properties.</dd>
  </dl>
  <ul>
    <li>Window film applications in Philadelphia</li>
    <li>Philadelphia window film applications</li>
    <li>Window film applications Philadelphia PA</li>
    <li>Residential window film applications Philadelphia</li>
    <li>Commercial window film applications Philadelphia</li>
    <li>Office window film applications Philadelphia</li>
    <li>Retail window film applications Philadelphia</li>
    <li>Restaurant window film applications Philadelphia</li>
    <li>Hotel window film applications Philadelphia</li>
    <li>School window film applications Philadelphia</li>
    <li>Healthcare window film applications Philadelphia</li>
    <li>Government window film applications Philadelphia</li>
    <li>Museum window film applications Philadelphia</li>
    <li>Church window film applications Philadelphia</li>
    <li>Security window film applications Philadelphia</li>
    <li>UV protection window film applications Philadelphia</li>
  </ul>
</div>

</div>

</BaseLayout>

<style>
/* ── DESIGN TOKENS — site palette ══ */
:root {
  --ap-radius: 5px;
  --ap-charcoal: #272E32;
  --ap-green: #81AB4C;
  --ap-green-light: #eef4e4;
  --ap-green-dark: #7CB342;
  --ap-off-white: #F7F6F3;
  --ap-text-dark: #1a1a1a;
  --ap-text-mid: #4a4a4a;
  --ap-text-light: #888;
}

.ap-body { background: #ffffff; }
.ap-container { max-width: 1280px; margin: 0 auto; padding: 0 5%; }

/* ── EYEBROW ══ */
.ap-eyebrow {
  display: inline-block;
  font-family: 'DM Sans', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--ap-green);
  margin-bottom: 16px;
}

/* ── HERO ══ */
.ap-hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.ap-hero__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
.ap-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(39,46,50,0.68) 0%, rgba(39,46,50,0.82) 55%, rgba(39,46,50,0.95) 100%);
}
.ap-hero__content {
  position: relative;
  z-index: 10;
  max-width: 860px;
  padding: 120px 24px 80px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ap-hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: 'Space Mono', monospace;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: rgba(124, 179, 66, 0.85);
  margin-bottom: 28px;
  background: rgba(124, 179, 66, 0.08);
  border: 1px solid rgba(124, 179, 66, 0.2);
  padding: 8px 18px;
  border-radius: 100px;
}
.ap-hero__eyebrow-dot {
  width: 4px; height: 4px; border-radius: 50%;
  background: rgba(124, 179, 66, 0.4);
  flex-shrink: 0;
}
.ap-hero__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.25rem, 5.5vw, 3.75rem);
  font-weight: 700;
  color: #F3F6F1;
  line-height: 1.1;
  margin: 0 0 20px;
  letter-spacing: -0.01em;
}
.ap-hero__subtitle {
  font-family: 'DM Sans', sans-serif;
  font-size: clamp(0.9rem, 1.5vw, 1.05rem);
  color: rgba(243, 246, 241, 0.72);
  max-width: 680px;
  margin: 0 0 36px;
  line-height: 1.75;
}
.ap-hero__cta {
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 56px;
}
.ap-hero__btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--ap-green-dark);
  color: #fff;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  padding: 14px 32px;
  border-radius: 100px;
  border: 2px solid var(--ap-green-dark);
  transition: background 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
}
.ap-hero__btn-primary:hover {
  background: #6aa032;
  border-color: #6aa032;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(124, 179, 66, 0.3);
}
.ap-hero__btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  color: #F3F6F1;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  padding: 12px 28px;
  border-radius: 100px;
  border: 2px solid rgba(243, 246, 241, 0.35);
  transition: border-color 0.25s ease, background 0.25s ease, transform 0.2s ease;
}
.ap-hero__btn-secondary:hover {
  border-color: var(--ap-green-dark);
  color: var(--ap-green-dark);
  transform: translateY(-2px);
  background: rgba(124, 179, 66, 0.06);
}
.ap-hero__stats-panel {
  width: 100%;
  max-width: 720px;
  background: rgba(39, 46, 50, 0.6);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  padding: 4px;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.25);
}
.ap-hero__stats-inner {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
