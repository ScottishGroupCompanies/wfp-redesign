<style>
/* ─── HERO NEW — full-bleed video overlay, superpower.com style ─── */
.hero-new {
  position: relative;
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

/* Full-bleed background */
.hero-new__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.hero-new__bg-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.hero-new__bg-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    rgba(10,10,10,0.88) 0%,
    rgba(10,10,10,0.72) 38%,
    rgba(10,10,10,0.30) 65%,
    rgba(10,10,10,0.15) 100%
  );
}

/* Content — left-aligned, on top of overlay */
.hero-new__content {
  position: relative;
  z-index: 2;
  padding: 9rem 7vw 0;
  max-width: 640px;
}

.hero-new__eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.22em;
  color: var(--green, #7CB342);
  margin-bottom: 1.5rem;
  font-weight: 500;
}

.hero-new__h1 {
  font-family: var(--font-serif, 'Fraunces', serif);
  font-weight: 800;
  font-size: clamp(3.2rem, 5.5vw, 5.5rem);
  color: #fff;
  letter-spacing: -0.03em;
  line-height: 1.0;
  margin-bottom: 1.5rem;
}

.hero-new__sub {
  font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
  font-weight: 300;
  font-size: 1.05rem;
  color: rgba(255,255,255,0.68);
  line-height: 1.75;
  margin-bottom: 2.5rem;
  max-width: 480px;
}

.hero-new__ctas {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.hero-new__cta-primary {
  background: var(--green, #4E6B2A);
  color: #fff;
  padding: 15px 36px;
  border-radius: 9999px;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.95rem;
  text-decoration: none;
  transition: background 0.2s ease, transform 0.2s ease;
  display: inline-block;
  letter-spacing: 0.01em;
}
.hero-new__cta-primary:hover {
  background: var(--green-hover, #3D5620);
  color: #fff;
  transform: translateY(-2px);
}

.hero-new__cta-ghost {
  border: 1.5px solid rgba(255,255,255,0.85);
  color: #fff;
  padding: 15px 36px;
  border-radius: 9999px;
  font-family: var(--font-body);
  font-weight: 400;
  font-size: 0.95rem;
  text-decoration: none;
  transition: border-color 0.2s ease, transform 0.2s ease;
  display: inline-block;
  letter-spacing: 0.01em;
}
.hero-new__cta-ghost:hover {
  border-color: rgba(255,255,255,0.8);
  color: #fff;
  transform: translateY(-2px);
}

/* Hero word stagger animation */
.hero-word {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  display: inline-block;
  margin-right: 0.28em;
  white-space: nowrap;
}
.hero-word.visible { opacity: 1; transform: translateY(0); }

@media (max-width: 768px) {
  .hero-new__content { padding: 8rem 6vw 0; }
  .hero-new__h1 { font-size: clamp(2.4rem, 9vw, 3.5rem); }
}

/* ─── WHAT WE DO — scroll-driven horizontal carousel ─── */
.wwd {
  background: #FFFFFF;
  padding: 0 0 80px;
  overflow: hidden;
}

/* ── Trust strip — framer-motion infinite slider ── */
.wwd__trust-wrap {
  padding: 3rem 0 0;
  text-align: center;
}
.wwd__trust-text {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: rgba(74,92,72,0.65);
  margin: 0 0 2rem;
}
.wwd__line {
  height: 1px;
  background: rgba(74,92,72,0.12);
  margin: 0 7vw 2rem;
}
.wwd__slider-outer {
  position: relative;
}
.wwd__slider-mask {
  mask-image: linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%);
