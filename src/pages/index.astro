---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Benefits from '../components/Benefits.astro';

const title = "Window Film Philadelphia — Scottish Window Solutions";
const description = "Professional window film installation in Philadelphia. UV protection, energy savings, safety & security, and decorative film for homes and businesses.";

---

<BaseLayout title={title} description={description}>
  <Header />

  <!-- ═══════════════════════════════════════════════════════
       SECTION 2: HERO — 100vh, dark overlay, centered content
  ═══════════════════════════════════════════════════════ -->
  <!-- ═══════════════════════════════════════════════════════════
     HERO — full-bleed video overlay, superpower.com style
  ═══════════════════════════════════════════════════════════ -->
  <section class="hero-new">
    <!-- Full-bleed background video -->
    <div class="hero-new__bg">
      <video class="hero-new__bg-video" src="https://res.cloudinary.com/deunehrew/video/upload/f_auto,q_auto,vc_auto/v1781724884/philadelphia-dramatic-sunset-aerial-panorama-dow-2026-01-22-02-38-52-utc_1_ijkuix.mp4" autoplay muted loop playsinline preload="metadata" poster="/images/wfp-landing-hero.webp"></video>
      <div class="hero-new__bg-overlay"></div>
    </div>

    <!-- Overlay content — left-aligned -->
    <div class="hero-new__content">
      <p class="hero-new__eyebrow">● PHILADELPHIA'S #1 WINDOW FILM COMPANY</p>
      <h1 class="hero-new__h1">
        <span class="hero-word">Philadelphia's</span>
        <span class="hero-word">glass,</span>
        <span class="hero-word">transformed.</span>
      </h1>
      <p class="hero-new__sub">Energy savings. UV protection. Safety &amp; security. Done right, every time.</p>
      <div class="hero-new__ctas">
        <a href="/contact/" class="hero-new__cta-primary">Get a free quote</a>
        <a href="/services/" class="hero-new__cta-ghost">See our services</a>
      </div>
    </div>

  </section>

  <!-- ═══════════════════════════════════════════════════════════
       STATS BAR — video background, count-up animation
  ═══════════════════════════════════════════════════════════ -->
  <section class="stats-bar">
    <div class="stats-bar__inner">
      <div class="stats-bar__stat">
        <span class="stats-bar__num" data-count-end="20" data-count-suffix="+">0</span>
        <span class="stats-bar__label">Years in Business</span>
      </div>
      <div class="stats-bar__divider"></div>
      <div class="stats-bar__stat">
        <span class="stats-bar__num" data-count-end="2400" data-count-suffix="+">0</span>
        <span class="stats-bar__label">Projects Completed</span>
      </div>
      <div class="stats-bar__divider"></div>
      <div class="stats-bar__stat">
        <span class="stats-bar__num" data-count-end="99" data-count-suffix="%">0</span>
        <span class="stats-bar__label">UV Block Rate</span>
      </div>
      <div class="stats-bar__divider"></div>
      <div class="stats-bar__stat">
        <span class="stats-bar__num" data-count-end="4" data-count-suffix=".9★">0</span>
        <span class="stats-bar__label">Google Rating</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       WHAT WE DO — scroll-driven horizontal carousel
  ═══════════════════════════════════════════════════════════ -->
  <section class="wwd">

    <!-- Trust strip — all 12 brand logos, clean infinite scroll -->
    <div class="trust-strip">
      <p class="trust-strip__title">TRUSTED BY LEADING PHILADELPHIA BUSINESSES</p>
      <div class="trust-strip__mask">
        <div class="trust-strip__track">

          <!-- Set 1 -->
          <span class="trust-strip__logo"><a href="/products/3m-window-films"><img src="/images/2021-09-3m-window-film-philadelphia.webp" alt="3M Window Film" title="3M Window Film" /></a></span>
          <span class="trust-strip__logo"><a href="/products/llumar"><img src="/images/2021-09-llumar-window-film-philadelphia.webp" alt="LLumar Window Film" title="LLumar Window Film" /></a></span>
          <span class="trust-strip__logo"><a href="/products/vista"><img src="/images/2021-09-vista-window-film-philadelphia.webp" alt="Vista Window Film" title="Vista Window Film" /></a></span>
          <span class="trust-strip__logo"><a href="/products/solar-gard"><img src="/images/2021-09-solar-gard-window-film-philadelphia.webp" alt="Solar Gard Window Film" title="Solar Gard Window Film" /></a></span>
          <span class="trust-strip__logo"><a href="/products/huper-optik"><img src="/images/2021-09-huper-optik-window-film-philadelphia.webp" alt="Huper Optik" title="Huper Optik" /></a></span>
          <span class="trust-strip__logo"><a href="/products/casper"><img src="/images/2021-09-casper-window-film-philadelphia.webp" alt="Casper" title="Casper" /></a></span>
          <span class="trust-strip__logo"><a href="/products/"><img src="/images/2021-09-cbond-window-film-philadelphia.webp" alt="C-Bond Systems" title="C-Bond Systems" /></a></span>
          <span class="trust-strip__logo"><a href="/products/madico"><img src="/images/2021-09-madico-window-film-philadelphia.webp" alt="Madico" title="Madico" /></a></span>
          <span class="trust-strip__logo"><a href="/products/hd-clear"><img src="/images/2021-09-hdclear-window-film-philadelphia.webp" alt="HDClear" title="HDClear" /></a></span>
          <span class="trust-strip__logo"><a href="/products/hanita"><img src="/images/2021-09-hanita-coatings-window-film-philadelphia.webp" alt="Hanita Coatings" title="Hanita Coatings" /></a></span>
          <span class="trust-strip__logo"><a href="/products/solyx"><img src="/images/2021-09-solyx-window-film-philadelphia.webp" alt="Solyx" title="Solyx" /></a></span>
          <span class="trust-strip__logo"><a href="/products/graffiti-shield"><img src="/images/2021-09-graffiti-shield-window-film-philadelphia.webp" alt="Graffiti Shield" title="Graffiti Shield" /></a></span>

          <!-- Set 2 — duplicate for seamless loop -->
          <span class="trust-strip__logo"><a href="/products/3m-window-films"><img src="/images/2021-09-3m-window-film-philadelphia.webp" alt="3M Window Film" title="3M Window Film" /></a></span>
          <span class="trust-strip__logo"><a href="/products/llumar"><img src="/images/2021-09-llumar-window-film-philadelphia.webp" alt="LLumar Window Film" title="LLumar Window Film" /></a></span>
          <span class="trust-strip__logo"><a href="/products/vista"><img src="/images/2021-09-vista-window-film-philadelphia.webp" alt="Vista Window Film" title="Vista Window Film" /></a></span>
          <span class="trust-strip__logo"><a href="/products/solar-gard"><img src="/images/2021-09-solar-gard-window-film-philadelphia.webp" alt="Solar Gard Window Film" title="Solar Gard Window Film" /></a></span>
          <span class="trust-strip__logo"><a href="/products/huper-optik"><img src="/images/2021-09-huper-optik-window-film-philadelphia.webp" alt="Huper Optik" title="Huper Optik" /></a></span>
          <span class="trust-strip__logo"><a href="/products/casper"><img src="/images/2021-09-casper-window-film-philadelphia.webp" alt="Casper" title="Casper" /></a></span>
          <span class="trust-strip__logo"><a href="/products/"><img src="/images/2021-09-cbond-window-film-philadelphia.webp" alt="C-Bond Systems" title="C-Bond Systems" /></a></span>
          <span class="trust-strip__logo"><a href="/products/madico"><img src="/images/2021-09-madico-window-film-philadelphia.webp" alt="Madico" title="Madico" /></a></span>
          <span class="trust-strip__logo"><a href="/products/hd-clear"><img src="/images/2021-09-hdclear-window-film-philadelphia.webp" alt="HDClear" title="HDClear" /></a></span>
          <span class="trust-strip__logo"><a href="/products/hanita"><img src="/images/2021-09-hanita-coatings-window-film-philadelphia.webp" alt="Hanita Coatings" title="Hanita Coatings" /></a></span>
          <span class="trust-strip__logo"><a href="/products/solyx"><img src="/images/2021-09-solyx-window-film-philadelphia.webp" alt="Solyx" title="Solyx" /></a></span>
          <span class="trust-strip__logo"><a href="/products/graffiti-shield"><img src="/images/2021-09-graffiti-shield-window-film-philadelphia.webp" alt="Graffiti Shield" title="Graffiti Shield" /></a></span>

        </div>
      </div>
    </div>

    <!-- Section heading — centered -->
    <div class="wwd__heading">
      <p class="wwd__eyebrow">WHAT WE DO</p>
      <h2 class="wwd__title">Window film solutions<br/>for every need</h2>
      <p class="wwd__sub">Professional installation across Philadelphia and surrounding areas</p>
    </div>

    <!-- Cards — full width cinematic panels -->
    <div class="wwd__panels">

      <!-- Card 1: Residential -->
      <a href="/services/residential/" class="wwd__panel" style="animation-delay: 0s">
        <img
          src="/images/residential-card.jpg"
          alt="Residential window film" title="Residential window film"
          class="wwd__panel-img"
        />
        <div class="wwd__panel-overlay"></div>
        <div class="wwd__panel-content">
          <h3 class="wwd__panel-title">Residential</h3>
          <p class="wwd__panel-subtitle">Home window film solutions</p>
          <p class="wwd__panel-desc">Privacy, UV protection, safety and decorative films for homes and condos across Philadelphia.</p>
          <span class="wwd__panel-arrow">→</span>
        </div>
        <div class="wwd__panel-line"></div>
      </a>

      <!-- Card 2: Commercial -->
      <a href="/services/commercial/" class="wwd__panel" style="animation-delay: 0.1s">
        <img
          src="/images/commercial-card.jpg"
          alt="Commercial window film" title="Commercial window film"
          class="wwd__panel-img"
        />
        <div class="wwd__panel-overlay"></div>
        <div class="wwd__panel-content">
          <h3 class="wwd__panel-title">Commercial</h3>
          <p class="wwd__panel-subtitle">Built for business performance</p>
          <p class="wwd__panel-desc">Solar control, anti-graffiti, safety and branding films for offices, retail, and commercial buildings.</p>
          <span class="wwd__panel-arrow">→</span>
        </div>
        <div class="wwd__panel-line"></div>
      </a>

      <!-- Card 3: Government & Public -->
      <a href="/applications/government-municipal/" class="wwd__panel" style="animation-delay: 0.2s">
        <img
          src="/images/government-card.jpg"
          alt="Government window film" title="Government window film"
          class="wwd__panel-img"
        />
        <div class="wwd__panel-overlay"></div>
        <div class="wwd__panel-content">
          <h3 class="wwd__panel-title">Government & Public</h3>
          <p class="wwd__panel-subtitle">Trusted by institutions across Philadelphia</p>
          <p class="wwd__panel-desc">Specialized films for government buildings, schools, museums, churches, and mass transit.</p>
          <span class="wwd__panel-arrow">→</span>
        </div>
        <div class="wwd__panel-line"></div>
      </a>

      <!-- Card 4: Specialty -->
      <a href="/benefits/blast-mitigation/" class="wwd__panel" style="animation-delay: 0.3s">
        <img
          src="/images/specialty-card.jpg"
          alt="Specialty security film" title="Specialty security film"
          class="wwd__panel-img"
        />
        <div class="wwd__panel-overlay"></div>
        <div class="wwd__panel-content">
          <h3 class="wwd__panel-title">Specialty</h3>
          <p class="wwd__panel-subtitle">Advanced protection solutions</p>
          <p class="wwd__panel-desc">Bomb blast, ballistic resistant, bird strike, and exterior refinishing for demanding applications.</p>
          <span class="wwd__panel-arrow">→</span>
        </div>
        <div class="wwd__panel-line"></div>
      </a>

    </div>

  </section>

  <!-- ═══════════════════════════════════════════════════════════
       MESSAGE FROM THE OWNER — centered card
  ═══════════════════════════════════════════════════════════ -->
  <section class="owner-msg scroll-reveal">
    <div class="owner-msg__card">

      <!-- LEFT: Circular photo -->
      <div class="owner-msg__photo-col">
        <img
          src="/images/mike-kinsey.jpg"
          alt="Mike Kinsey, President" title="Mike Kinsey, President"
          class="owner-msg__photo"
          width="100"
          height="100"
          loading="lazy"
        />
      </div>

      <!-- RIGHT: Quote & info -->
      <div class="owner-msg__content">
        <div class="owner-msg__quote-mark">"</div>
        <blockquote class="owner-msg__quote">
          I started Window Film Philadelphia because I believed Philadelphia
          homeowners deserved better. Better products, better installation,
          and someone who actually stands behind their work. Every job we
          do, we do it like it's our own home.
        </blockquote>
        <div class="owner-msg__divider"></div>
        <p class="owner-msg__name">Mike Kinsey</p>
        <p class="owner-msg__title">President, Window Film Philadelphia</p>
        <p class="owner-msg__detail">SERVING PHILADELPHIA SINCE 2008</p>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       HOW IT WORKS — horizontal auto-play slideshow
  ═══════════════════════════════════════════════════════════ -->
  <section class="hiw-slideshow" id="hiwSlideshow">
  
    <!-- Track container — holds all 4 slides, translates horizontally -->
    <div class="hiw-slideshow__track" id="hiwTrack">

      <!-- SLIDE 01: Free Consultation -->
      <div class="hiw-slideshow__slide" data-slide="0">
        <img 
          src="https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_1920/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_1920/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260617_213616_509bcc09-ab60-49ed-a07e-c5f867aca22e.png" 
          alt="Free consultation - Window Film Philadelphia specialist meeting with homeowner" title="Free consultation - Window Film Philadelphia specialist meeting with homeowner" 
          class="hiw-slideshow__bg"
        />
        <div class="hiw-slideshow__overlay"></div>
        
        <div class="hiw-slideshow__content">
          <div class="hiw-slideshow__step">01</div>
          <h2 class="hiw-slideshow__title">We come to you.<br/>No pressure, ever.</h2>
          <p class="hiw-slideshow__desc">A certified Window Film Philadelphia specialist visits your home or business. We assess your space and recommend the perfect solution.</p>
          
          <div class="hiw-slideshow__faq">
            <div class="hiw-slideshow__faq-item">
              <button class="hiw-slideshow__faq-q" aria-expanded="false">
                How long does a consultation take?
                <span class="hiw-slideshow__faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="hiw-slideshow__faq-a" hidden>Most consultations take about 30–45 minutes. We walk through your space, discuss your goals, and answer every question you have — no rush.</div>
            </div>
            <div class="hiw-slideshow__faq-item">
              <button class="hiw-slideshow__faq-q" aria-expanded="false">
                Is the consultation really free?
                <span class="hiw-slideshow__faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="hiw-slideshow__faq-a" hidden>Yes — 100% free, no obligation. We'll give you an honest recommendation whether you move forward with us or not.</div>
            </div>
            <div class="hiw-slideshow__faq-item">
              <button class="hiw-slideshow__faq-q" aria-expanded="false">
                Do you serve all Philadelphia areas?
                <span class="hiw-slideshow__faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="hiw-slideshow__faq-a" hidden>We cover all of Philadelphia and the greater Delaware Valley — Center City, the suburbs, and surrounding counties.</div>
            </div>
          </div>
          
          <a href="/contact/" class="hiw-slideshow__cta">Book your free consultation →</a>
        </div>
      </div>

      <!-- SLIDE 02: Custom Quote -->
      <div class="hiw-slideshow__slide" data-slide="1">
        <img 
          src="https://res.cloudinary.com/deunehrew/image/upload/f_auto,q_auto,w_1920/v1781633639/hf_20260616_180915_3906a1d8-06ae-4639-9856-389f27f8e776_mhzkno.jpg" 
          alt="Custom quote - measuring windows" title="Custom quote - measuring windows" 
          class="hiw-slideshow__bg"
        />
        <div class="hiw-slideshow__overlay"></div>
        
        <div class="hiw-slideshow__content">
          <div class="hiw-slideshow__step">02</div>
          <h2 class="hiw-slideshow__title">Transparent pricing.<br/>No surprises.</h2>
          <p class="hiw-slideshow__desc">Window Film Philadelphia delivers a detailed written quote with product options, pricing, and timeline. No hidden fees, no pressure to decide on the spot.</p>
          
          <div class="hiw-slideshow__faq">
            <div class="hiw-slideshow__faq-item">
              <button class="hiw-slideshow__faq-q" aria-expanded="false">
                How quickly do I get my quote?
                <span class="hiw-slideshow__faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="hiw-slideshow__faq-a" hidden>Most quotes are delivered within 24 hours of the consultation. We send a detailed PDF with product options, square footage, and pricing.</div>
            </div>
            <div class="hiw-slideshow__faq-item">
              <button class="hiw-slideshow__faq-q" aria-expanded="false">
                Can I choose different film options?
                <span class="hiw-slideshow__faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="hiw-slideshow__faq-a" hidden>Absolutely. We present 2-3 film options tailored to your goals and budget. You choose what works best for your space.</div>
            </div>
            <div class="hiw-slideshow__faq-item">
              <button class="hiw-slideshow__faq-q" aria-expanded="false">
                Do prices vary by film type?
                <span class="hiw-slideshow__faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="hiw-slideshow__faq-a" hidden>Yes — pricing depends on the film brand, performance level, and warranty. We explain the differences clearly so you can make an informed decision.</div>
            </div>
          </div>
          
          <a href="/contact/" class="hiw-slideshow__cta">Book your free consultation →</a>
        </div>
      </div>

      <!-- SLIDE 03: Expert Installation -->
      <div class="hiw-slideshow__slide" data-slide="2">
        <img 
          src="/images/how-it-works-installation.png" 
          alt="Expert installation - Window Film Philadelphia professional applying window film" title="Expert installation - Window Film Philadelphia professional applying window film" 
          class="hiw-slideshow__bg"
        />
        <div class="hiw-slideshow__overlay"></div>
        
        <div class="hiw-slideshow__content">
          <div class="hiw-slideshow__step">03</div>
          <h2 class="hiw-slideshow__title">Installed right<br/>the first time.</h2>
          <p class="hiw-slideshow__desc">Window Film Philadelphia's certified installers arrive on time, protect your space, and complete the job cleanly. Most installations are done in a single day — we've completed over 2,400 projects since 2008.</p>
          
          <div class="hiw-slideshow__faq">
            <div class="hiw-slideshow__faq-item">
              <button class="hiw-slideshow__faq-q" aria-expanded="false">
                How long does installation take?
                <span class="hiw-slideshow__faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="hiw-slideshow__faq-a" hidden>Most single-family homes are completed in one day. Larger properties or commercial projects may take 2–3 days. We work quickly but never rush.</div>
            </div>
            <div class="hiw-slideshow__faq-item">
              <button class="hiw-slideshow__faq-q" aria-expanded="false">
                Do I need to prepare anything?
                <span class="hiw-slideshow__faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="hiw-slideshow__faq-a" hidden>Very little. Clear window sills of personal items and ensure our team can access all windows. We bring all tools and materials.</div>
            </div>
            <div class="hiw-slideshow__faq-item">
              <button class="hiw-slideshow__faq-q" aria-expanded="false">
                What brands do you install?
                <span class="hiw-slideshow__faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="hiw-slideshow__faq-a" hidden>We install all major brands — 3M, LLumar, Vista, Solar Gard, Madico, Hanita, and more. We help you pick the right film for your needs.</div>
            </div>
          </div>
          
          <a href="/contact/" class="hiw-slideshow__cta">Book your free consultation →</a>
        </div>
      </div>

      <!-- SLIDE 04: Lifetime Warranty -->
      <div class="hiw-slideshow__slide" data-slide="3">
        <img 
          src="https://res.cloudinary.com/deunehrew/image/upload/f_auto,q_auto,w_1920/v1781633582/hf_20260616_180939_e45884d8-f457-4af5-b265-5e38857235d4_the5fc.jpg" 
          alt="Lifetime warranty - beautiful result" title="Lifetime warranty - beautiful result" 
          class="hiw-slideshow__bg"
        />
        <div class="hiw-slideshow__overlay"></div>
        
        <div class="hiw-slideshow__content">
          <div class="hiw-slideshow__step">04</div>
          <h2 class="hiw-slideshow__title">We stand behind<br/>every install.</h2>
          <p class="hiw-slideshow__desc">Every Window Film Philadelphia installation comes with a manufacturer warranty and our own satisfaction guarantee. If anything is wrong, we make it right.</p>
          
          <div class="hiw-slideshow__faq">
            <div class="hiw-slideshow__faq-item">
              <button class="hiw-slideshow__faq-q" aria-expanded="false">
                What does the warranty cover?
                <span class="hiw-slideshow__faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="hiw-slideshow__faq-a" hidden>Our labor warranty covers any installation-related issues for life. The manufacturer warranty covers the film itself — bubbling, peeling, delaminating — for 5–15 years depending on the product.</div>
            </div>
            <div class="hiw-slideshow__faq-item">
              <button class="hiw-slideshow__faq-q" aria-expanded="false">
                How do I make a warranty claim?
                <span class="hiw-slideshow__faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="hiw-slideshow__faq-a" hidden>Call or email us directly. We handle the entire claim process with the manufacturer on your behalf — no runaround, no fine print.</div>
            </div>
            <div class="hiw-slideshow__faq-item">
              <button class="hiw-slideshow__faq-q" aria-expanded="false">
                Does the warranty transfer if I sell my home?
                <span class="hiw-slideshow__faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="hiw-slideshow__faq-a" hidden>Most manufacturer warranties are transferable to the new property owner. Check your specific film warranty or ask us for details.</div>
            </div>
          </div>
          
          <a href="/warranty/" class="hiw-slideshow__cta">Book your free consultation →</a>
        </div>
      </div>

    </div>

    <!-- Right side index navigation -->
    <nav class="hiw-slideshow__nav" aria-label="Process steps">
      <button class="hiw-slideshow__nav-item hiw-slideshow__nav-item--active" data-nav="0">
        <span class="hiw-slideshow__nav-line"></span>
        <span class="hiw-slideshow__nav-label">Free Consultation</span>
      </button>
      <button class="hiw-slideshow__nav-item" data-nav="1">
        <span class="hiw-slideshow__nav-line"></span>
        <span class="hiw-slideshow__nav-label">Custom Quote</span>
      </button>
      <button class="hiw-slideshow__nav-item" data-nav="2">
        <span class="hiw-slideshow__nav-line"></span>
        <span class="hiw-slideshow__nav-label">Expert Installation</span>
      </button>
      <button class="hiw-slideshow__nav-item" data-nav="3">
        <span class="hiw-slideshow__nav-line"></span>
        <span class="hiw-slideshow__nav-label">Lifetime Warranty</span>
      </button>
    </nav>

    <!-- Navigation arrows -->
    <button class="hiw-slideshow__arrow hiw-slideshow__arrow--prev" id="hiwPrev" aria-label="Previous slide">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
