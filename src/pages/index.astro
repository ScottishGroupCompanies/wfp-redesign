  display: flex;
  flex-direction: column;
}
.svc-card--large {
  flex-direction: row;
  min-height: 340px;
}
.svc-card--green-accent { background: var(--green-accent); }
.svc-card--brand { background: var(--brand); }
.svc-card--small {
  background: #fff;
  border: 1px solid var(--border);
  padding: 32px;
  flex-direction: column;
}
.svc-card__content {
  flex: 1;
  padding: 48px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.svc-card--small .svc-card__content { padding: 0; }
.svc-card__label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: rgba(255,255,255,0.7);
  margin-bottom: 0.75rem;
}
.svc-card__label--teal { color: var(--green-accent); }
.svc-card__h3 {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: clamp(1.4rem, 2.5vw, 2rem);
  color: #fff;
  margin-bottom: 1rem;
  line-height: 1.2;
}
.svc-card--small .svc-card__h3 { color: var(--brand); font-size: 1.2rem; margin-bottom: 0.5rem; }
.svc-card__body {
  font-family: var(--font-body);
  font-size: 0.95rem;
  color: rgba(255,255,255,0.85);
  line-height: 1.7;
  margin-bottom: 1.5rem;
}
.svc-card--small .svc-card__body { color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 0; }
.svc-card__badge {
  display: flex;
  flex-direction: column;
}
.badge-num {
  font-family: var(--font-serif);
  font-weight: 800;
  font-size: 3rem;
  color: #fff;
  line-height: 1;
}
.badge-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: rgba(255,255,255,0.6);
}
.svc-card__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.svc-card__list li {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--font-body);
  font-size: 0.9rem;
  color: rgba(255,255,255,0.85);
}
.svc-card__list svg { color: var(--green-accent); flex-shrink: 0; }
.svc-card__img {
  width: 45%;
  flex-shrink: 0;
}
.svc-card__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.svc-card__icon { margin-bottom: 1rem; }
.svc-card__body-sm { font-size: 0.875rem; }

/* Override global grid for services layout */
.services__grid .svc-card--large:first-child {
  grid-column: 1;
  grid-row: 1;
}
.services__grid .svc-card--large:nth-child(2) {
  grid-column: 2;
  grid-row: 1;
}
.services__grid .svc-card--small:nth-child(3) {
  grid-column: 1;
  grid-row: 2;
}
.services__grid .svc-card--small:nth-child(4) {
  grid-column: 2;
  grid-row: 2;
}
.services__grid .svc-card--small:nth-child(5) {
  grid-column: 3;
  grid-row: 2;
}
.services__grid {
  grid-template-columns: 1fr 1fr 1fr;
}

/* ─── STATS BAR (Section 3A) ─── */
.stats-bar {
  background: #14201A;
  padding: 80px 7vw;
}
.stats-bar__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1100px;
  margin: 0 auto;
  gap: 0;
}
.stats-bar__stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  flex: 1;
  text-align: center;
}
.stats-bar__num {
  font-family: 'Space Mono', monospace;
  font-size: clamp(2.5rem, 4vw, 3.25rem);
  font-weight: 700;
  color: #7CB342;
  letter-spacing: -0.02em;
  line-height: 1;
}
.stats-bar__label {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: rgba(255,255,255,0.5);
}
.stats-bar__divider {
  width: 1px;
  height: 60px;
  background: rgba(255,255,255,0.12);
  flex-shrink: 0;
}

/* ─── HOW IT WORKS — 4 photo cards ─── */
/* ─── HOW IT WORKS — sticky scroll, 4 crossfade panels ─── */
.hiw-sticky {
  position: relative;
  height: 400vh;
}
.hiw-panel {
  position: sticky;
  top: 0;
  height: 100vh;
  width: 100%;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.6s ease;
}
.hiw-panel.is-active {
  opacity: 1;
  pointer-events: auto;
}
.hiw-panel__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.hiw-panel__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.hiw-panel__bg-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(20,32,26,0.55) 0%,
    rgba(20,32,26,0.25) 60%,
    rgba(20,32,26,0.40) 100%
  );
}
.hiw-panel__inner {
  position: relative;
  z-index: 1;
  height: 100vh;
  display: flex;
  align-items: flex-end;
  padding: 0 7vw 80px;
  gap: 60px;
}
.hiw-panel__content {
  max-width: 520px;
  color: #fff;
  transform: translateY(24px);
  transition: transform 0.5s ease 0.1s;
}
.hiw-panel.is-active .hiw-panel__content {
  transform: translateY(0);
}
.hiw-panel__h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.2rem, 4vw, 3.25rem);
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
  line-height: 1.12;
  margin: 0 0 1.25rem;
}
.hiw-panel__body {
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  font-weight: 400;
  color: rgba(255,255,255,0.75);
  line-height: 1.65;
  margin: 0 0 2rem;
}
.hiw-panel__faq {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 2rem;
}
.hiw-panel__faq-item {
  border-radius: 8px;
  overflow: hidden;
}
.hiw-panel__faq-q {
  width: 100%;
  background: rgba(255,255,255,0.12);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 8px;
  color: rgba(255,255,255,0.88);
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  font-weight: 500;
  padding: 12px 16px;
  text-align: left;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  transition: background 0.2s ease;
}
.hiw-panel__faq-q:hover {
  background: rgba(255,255,255,0.18);
}
.hiw-panel__faq-icon {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.6);
  flex-shrink: 0;
  font-style: normal;
  transition: transform 0.3s ease;
}
.hiw-panel__faq-q[aria-expanded="true"] .hiw-panel__faq-icon {
  transform: rotate(45deg);
}
.hiw-panel__faq-a {
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.10);
  border-top: none;
  border-radius: 0 0 8px 8px;
  color: rgba(255,255,255,0.70);
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  line-height: 1.6;
  padding: 12px 16px;
  margin-top: -4px;
}
.hiw-panel__link {
  display: inline-block;
  background: #7CB342;
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  padding: 13px 28px;
  border-radius: 9999px;
  text-decoration: none;
  transition: background 0.25s ease, transform 0.2s ease;
  letter-spacing: 0.01em;
}
.hiw-panel__link:hover {
  background: #2E6B30;
  transform: translateY(-2px);
}

/* Right index nav */
.hiw-panel__index {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-left: auto;
  justify-content: center;
  flex-shrink: 0;
}
.hiw-panel__index-item {
  display: grid;
  grid-template-columns: 2px 1fr auto;
  grid-template-rows: auto auto;
  column-gap: 14px;
  row-gap: 0;
  align-items: center;
  opacity: 0.35;
  transition: opacity 0.4s ease;
}
.hiw-panel__index-item--active {
  opacity: 1;
}
.hiw-panel__index-line {
  display: block;
  width: 2px;
  height: 40px;
  background: rgba(255,255,255,0.4);
  border-radius: 1px;
  grid-row: 1 / 3;
  grid-column: 1;
  transition: background 0.4s ease, height 0.4s ease;
}
.hiw-panel__index-item--active .hiw-panel__index-line {
  background: #7CB342;
  height: 52px;
}
.hiw-panel__index-label {
  font-family: 'Inter', sans-serif;
  font-size: 0.8rem;
  font-weight: 500;
  color: #fff;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  grid-row: 1;
  grid-column: 2;
  white-space: nowrap;
}
.hiw-panel__index-num {
  font-family: 'Space Mono', monospace;
  font-size: 0.75rem;
  color: rgba(255,255,255,0.6);
  grid-row: 1;
  grid-column: 3;
  letter-spacing: 0.05em;
}
.hiw-panel__index-item--active .hiw-panel__index-num {
  color: #7CB342;
}

@media (max-width: 900px) {
  .hiw-panel__inner {
    padding: 0 5vw 60px;
    gap: 32px;
  }
  .hiw-panel__index {
    display: none;
  }
  .hiw-panel__content {
    max-width: 100%;
  }
}
@media (max-width: 600px) {
  .hiw-panel__h2 { font-size: clamp(1.8rem, 8vw, 2.4rem); }
  .hiw-panel__inner { padding-bottom: 48px; }
}

/* ─── BEFORE / AFTER SLIDER ─── */
.ba-section {
  background: var(--off-white);
  padding: 100px 0 80px;
}
.ba-section .eyebrow { text-align: center; display: block; margin-bottom: 1rem; }
.ba-section .section-h2 { text-align: center; margin-bottom: 3rem; }
.ba-slider {
  position: relative;
  max-width: 1000px;
  margin: 0 auto;
  aspect-ratio: 16/9;
  overflow: hidden;
  border-radius: 5px;
  cursor: ew-resize;
  user-select: none;
}
.ba-before,
.ba-after-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.ba-after {
  position: absolute;
  inset: 0;
  transition: clip-path 0.05s linear;
}
.ba-handle {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--green);
  cursor: ew-resize;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ba-handle::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: -12px;
  right: -12px;
}
.ba-handle__line {
  width: 3px;
  height: 100%;
  background: var(--green);
  position: absolute;
}
.ba-handle svg { position: relative; z-index: 1; }
.ba-label {
  position: absolute;
  bottom: 20px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #fff;
  background: rgba(42,36,30,0.6);
  padding: 6px 14px;
  border-radius: 100px;
  z-index: 5;
}
.ba-label--before { left: 20px; }
.ba-label--after { right: 20px; }


/* ─── HOW IT WORKS — bg image + steps + accordion ─── */
.hiw {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hiw__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.hiw__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: grayscale(20%) brightness(0.92);
}
.hiw__bg-overlay {
  position: absolute;
  inset: 0;
  background: rgba(240,244,240,0.82);
}

.hiw__inner {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 7rem 5vw;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rem;
  align-items: start;
}

/* Left: heading + accordion */
.hiw__heading { margin-bottom: 2.5rem; }
.hiw__title {
  font-family: var(--font-serif, 'Fraunces', serif);
  font-weight: 700;
  font-size: clamp(2.4rem, 3.8vw, 4rem);
  color: #2A241E;
  letter-spacing: -0.025em;
  line-height: 1.1;
  margin-bottom: 1rem;
}
.hiw__sub {
  font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
  font-size: 1rem;
  font-weight: 300;
  color: #6E665C;
  line-height: 1.65;
  max-width: 420px;
}

/* Accordion */
.hiw__accordion {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.hiw__acc-item {
  background: rgba(255,255,255,0.72);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(42,36,30,0.08);
  border-radius: 12px;
  overflow: hidden;
}
.hiw__acc-trigger {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.1rem 1.4rem;
  background: none;
  border: none;
  cursor: pointer;
  font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
  font-size: 0.9rem;
  font-weight: 600;
  color: #2A241E;
  text-align: left;
  gap: 1rem;
}
.hiw__acc-trigger span:first-child { flex: 1; }
.hiw__acc-icon {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  background: rgba(42,36,30,0.08);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2A241E;
  transition: transform 0.25s ease, background 0.2s;
}
.hiw__acc-item.is-open .hiw__acc-icon {
  transform: rotate(45deg);
  background: var(--green, #4E6B2A);
  color: #fff;
}
.hiw__acc-body {
  padding: 0 1.4rem 1.2rem;
  font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
  font-size: 0.875rem;
  font-weight: 300;
  color: #6E665C;
  line-height: 1.7;
}
.hiw__acc-body p { margin: 0; }

/* Right: numbered steps */
.hiw__steps {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0;
  padding-top: 2rem;
}
.hiw__step {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 1.2rem;
  padding: 1.1rem 0;
  border-bottom: 1px solid rgba(42,36,30,0.10);
}
.hiw__step:first-child { border-top: 1px solid rgba(42,36,30,0.10); }
.hiw__step-num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 1.1rem;
  font-weight: 400;
  color: rgba(42,36,30,0.25);
  flex-shrink: 0;
  letter-spacing: 0.05em;
}
.hiw__step-text {
  font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
  font-size: 1.1rem;
  font-weight: 300;
  color: rgba(42,36,30,0.45);
  text-align: right;
}
.hiw__step-text--active {
  font-weight: 700;
  color: #2A241E;
}

@media (max-width: 900px) {
  .hiw__inner {
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 5rem 6vw;
  }
  .hiw__steps { padding-top: 0; }
  .hiw__step { justify-content: flex-start; gap: 1rem; }
  .hiw__step-text { text-align: left; }
  .hiw__step-num { font-size: 0.9rem; }
}


/* ─── APPLICATIONS — 2×4 photo grid ─── */
.apps-grid {
  background: #FFFFFF;
  padding: 80px 0;
}
.apps-grid__header {
  max-width: 1300px;
  margin: 0 auto;
  padding: 0 7vw 48px;
}
.apps-grid__eyebrow {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: #7CB342;
  margin: 0 0 0.875rem;
}
.apps-grid__title {
  font-family: 'Playfair Display', serif;
  font-size: 56px;
  font-weight: 700;
  color: #14201A;
  letter-spacing: -0.025em;
  line-height: 1.1;
  margin: 0;
}
.apps-grid__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  max-width: 1300px;
  margin: 0 auto;
  padding: 0 7vw;
}
.apps-grid__card {
  display: block;
  text-decoration: none;
  position: relative;
  height: 280px;
  border-radius: 12px;
  overflow: hidden;
  cursor: pointer;
}
.apps-grid__card-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform 0.3s ease;
}
.apps-grid__card-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.40);
  border-radius: 12px;
  transition: background 0.3s ease;
}
.apps-grid__card-label {
  position: absolute;
  bottom: 16px;
  left: 16px;
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  color: #fff;
  z-index: 1;
  letter-spacing: 0.01em;
}
.apps-grid__card:hover .apps-grid__card-img {
  transform: scale(1.03);
}
.apps-grid__card:hover .apps-grid__card-overlay {
  background: rgba(0,0,0,0.25);
}

@media (max-width: 1024px) {
  .apps-grid__grid { grid-template-columns: repeat(2, 1fr); }
  .apps-grid { padding: 60px 0; }
  .apps-grid__header { padding-bottom: 32px; }
  .apps-grid__title { font-size: 42px; }
}
@media (max-width: 600px) {
  .apps-grid__grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .apps-grid__header { padding: 0 5vw 24px; }
  .apps-grid__card { height: 200px; }
  .apps-grid__title { font-size: 32px; }
}


/* ─── REVIEWS — horizontal scroll carousel ─── */
.reviews {
  background: #FFFFFF;
  padding: 100px 0 80px;
  overflow: hidden;
}
.reviews__header {
  padding: 0 7vw 56px;
  max-width: 1400px;
  margin: 0 auto;
}
.reviews__badge-text {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  font-weight: 500;
  color: #4A5C48;
  margin-bottom: 1.25rem;
}
.reviews__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.2rem, 3.5vw, 3.25rem);
  font-weight: 700;
  color: #14201A;
  letter-spacing: -0.02em;
  line-height: 1.12;
  margin: 0 0 1rem;
}
.reviews__subtitle {
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  color: #4A5C48;
  margin: 0;
  line-height: 1.6;
}

/* Carousel */
.reviews__carousel-outer {
  position: relative;
  padding: 0 calc(50vw - min(210px, 20vw));
}
.reviews__carousel-outer::before,
.reviews__carousel-outer::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: calc(50vw - min(210px, 20vw));
  z-index: 2;
  pointer-events: none;
}
.reviews__carousel-outer::before {
  left: 0;
  background: linear-gradient(to right, #fff 60%, transparent);
}
.reviews__carousel-outer::after {
  right: 0;
  background: linear-gradient(to left, #fff 60%, transparent);
}
.reviews__carousel {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  padding: 4px 0 16px;
  cursor: grab;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.reviews__carousel::-webkit-scrollbar { display: none; }
.reviews__carousel:active { cursor: grabbing; }

/* Card */
.reviews__card {
  flex: 0 0 420px;
  scroll-snap-align: start;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(20,32,26,0.08);
  transition: box-shadow 0.3s ease, transform 0.3s ease;
  user-select: none;
}
.reviews__card:hover {
  box-shadow: 0 8px 32px rgba(20,32,26,0.14);
  transform: translateY(-3px);
}
.reviews__card-photo {
  height: 380px;
  overflow: hidden;
}
.reviews__card-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform 0.4s ease;
}
.reviews__card:hover .reviews__card-photo img {
  transform: scale(1.03);
}
.reviews__card-body {
  padding: 20px 22px 22px;
}
