---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Window Film Philadelphia — Scottish Window Solutions";
const description = "Professional window film installation in Philadelphia and the Delaware Valley. UV protection, energy savings, safety & security, and decorative film for homes and businesses.";

---

<BaseLayout title={title} description={description}>
  <Header />

  <!-- ═══════════════════════════════════════════════════════
       SECTION 2: HERO — 100vh, dark overlay, centered content
  ═══════════════════════════════════════════════════════ -->
  <!-- ═══════════════════════════════════════════════════════════
     HERO — full-bleed video overlay, superpower.com style
  ═══════════════════════════════════════════════════════════ -->
  <section class="hero-new">
    <!-- Full-bleed background video -->
    <div class="hero-new__bg">
      <video class="hero-new__bg-video" src="https://res.cloudinary.com/deunehrew/video/upload/v1781627724/hf_20260615_215550_351f234d-19f5-43f3-805b-96552d2e9ea0_i271kv.mp4" autoplay muted loop playsinline poster="/images/wfp-landing-hero.webp"></video>
      <div class="hero-new__bg-overlay"></div>
    </div>

    <!-- Overlay content — left-aligned -->
    <div class="hero-new__content">
      <p class="hero-new__eyebrow">● PHILADELPHIA'S #1 WINDOW FILM COMPANY</p>
      <h1 class="hero-new__h1">
        <span class="hero-word">Philadelphia's</span>
        <span class="hero-word">glass,</span>
        <span class="hero-word">transformed.</span>
      </h1>
      <p class="hero-new__sub">Energy savings. UV protection. Safety &amp; security. Done right, every time.</p>
      <div class="hero-new__ctas">
        <a href="/contact/" class="hero-new__cta-primary">Get a free quote</a>
        <a href="/services/" class="hero-new__cta-ghost">See our services</a>
      </div>
    </div>

  </section>

  <!-- ═══════════════════════════════════════════════════════════
       STATS BAR — video background, count-up animation
  ═══════════════════════════════════════════════════════════ -->
  <section class="stats-bar">
    <div class="stats-bar__inner">
      <div class="stats-bar__stat">
        <span class="stats-bar__num" data-count-end="20" data-count-suffix="">0</span>
        <span class="stats-bar__label">Years Experience</span>
      </div>
      <div class="stats-bar__divider"></div>
      <div class="stats-bar__stat">
        <span class="stats-bar__num" data-count-end="2400" data-count-suffix="+">0</span>
        <span class="stats-bar__label">Projects Completed</span>
      </div>
      <div class="stats-bar__divider"></div>
      <div class="stats-bar__stat">
        <span class="stats-bar__num" data-count-end="99" data-count-suffix="%">0</span>
        <span class="stats-bar__label">UV Block Rate</span>
      </div>
      <div class="stats-bar__divider"></div>
      <div class="stats-bar__stat">
        <span class="stats-bar__num" data-count-end="4" data-count-suffix=".9★">0</span>
        <span class="stats-bar__label">Google Rating</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       WHAT WE DO — scroll-driven horizontal carousel
  ═══════════════════════════════════════════════════════════ -->
  <section class="wwd">

    <!-- Trust strip -->
    <div class="wwd__trust-wrap">
      <p class="wwd__trust-text">Trusted by Philadelphia homeowners &amp; businesses since 2008</p>
      <div class="wwd__line"></div>
      <div class="wwd__slider-outer">
        <div class="wwd__slider-mask">
          <div class="wwd__slider-track" id="wwdSlider">
            <!-- Looped twice for seamless infinite scroll -->
            <span class="wwd__logo-item">3M&trade;</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">LLumar</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">SunTek</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">Vista by Eastman</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">Madico</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">NanoTint</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">Hanita Coatings</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">Solyx</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">3M&trade;</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">LLumar</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">SunTek</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">Vista by Eastman</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">Madico</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">NanoTint</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">Hanita Coatings</span><span class="wwd__logo-dot">·</span>
            <span class="wwd__logo-item">Solyx</span><span class="wwd__logo-dot">·</span>
          </div>
        </div>
      </div>
      <div class="wwd__line-bottom"></div>
    </div>

    <!-- Section heading — centered -->
    <div class="wwd__heading">
      <p class="wwd__eyebrow">WHAT WE DO</p>
      <h2 class="wwd__title">Window film solutions<br/>for every need</h2>
      <p class="wwd__sub">Professional installation across Philadelphia and surrounding areas</p>
    </div>

    <!-- Scroll container -->
    <div class="wwd__scroll-outer" id="wwdScroll">
      <div class="wwd__track" id="wwdTrack">

        <!-- Card 1: Commercial -->
        <a href="/applications/office/" class="wwd__card">
          <div class="wwd__card-img">
            <img
              src="https://images.unsplash.com/photo-1486325212027-8081e485255e?w=900&h=1100&fit=crop&q=85"
              alt="Philadelphia glass skyscraper at night — commercial window film"
              width="900" height="1100"
              loading="lazy"
            />
            <div class="wwd__card-overlay"></div>
            <span class="wwd__card-num">1</span>
            <div class="wwd__card-text">
              <h3 class="wwd__card-title">Commercial film</h3>
              <p class="wwd__card-sub">Reduce glare &amp; energy costs</p>
            </div>
            <div class="wwd__card-arrow">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </div>
        </a>

        <!-- Card 2: Residential -->
        <a href="/applications/residential/" class="wwd__card">
          <div class="wwd__card-img">
            <img
              src="https://images.unsplash.com/photo-1600210492493-0946911123ea?w=900&h=1100&fit=crop&q=85"
              alt="Luxury Philadelphia home interior with floor-to-ceiling windows — residential window film"
              width="900" height="1100"
              loading="lazy"
            />
            <div class="wwd__card-overlay"></div>
            <span class="wwd__card-num">2</span>
            <div class="wwd__card-text">
              <h3 class="wwd__card-title">Residential film</h3>
              <p class="wwd__card-sub">Comfort, privacy &amp; UV protection</p>
            </div>
            <div class="wwd__card-arrow">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </div>
        </a>

        <!-- Card 3: Safety & Security -->
        <a href="/benefits/safety-and-security/" class="wwd__card">
          <div class="wwd__card-img">
            <img
              src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=900&h=1100&fit=crop&q=85"
              alt="Safety film holding shattered glass together — safety and security window film"
              width="900" height="1100"
              loading="lazy"
            />
            <div class="wwd__card-overlay"></div>
            <span class="wwd__card-num">3</span>
            <div class="wwd__card-text">
              <h3 class="wwd__card-title">Safety &amp; security film</h3>
              <p class="wwd__card-sub">Hold glass together when it matters</p>
            </div>
            <div class="wwd__card-arrow">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </div>
        </a>

        <!-- Card 4: Decorative -->
        <a href="/benefits/privacy-window-film-philadelphia/" class="wwd__card">
          <div class="wwd__card-img">
            <img
              src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=900&h=1100&fit=crop&q=85"
              alt="Elegant frosted glass partition in modern Philadelphia office — decorative window film"
              width="900" height="1100"
              loading="lazy"
            />
            <div class="wwd__card-overlay"></div>
            <span class="wwd__card-num">4</span>
            <div class="wwd__card-text">
              <h3 class="wwd__card-title">Decorative film</h3>
              <p class="wwd__card-sub">Frosted, patterned &amp; custom designs</p>
            </div>
            <div class="wwd__card-arrow">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </div>
        </a>

        <!-- Card 5: Anti-Graffiti -->
        <a href="/benefits/anti-graffiti/" class="wwd__card">
          <div class="wwd__card-img">
            <img
              src="https://images.unsplash.com/photo-1568605117036-5fe5e7bab0b7?w=900&h=1100&fit=crop&q=85"
              alt="Philadelphia building exterior with large windows — anti-graffiti window film"
              width="900" height="1100"
              loading="lazy"
            />
            <div class="wwd__card-overlay"></div>
            <span class="wwd__card-num">5</span>
            <div class="wwd__card-text">
              <h3 class="wwd__card-title">Anti-graffiti film</h3>
              <p class="wwd__card-sub">Protect surfaces from vandalism</p>
            </div>
            <div class="wwd__card-arrow">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </div>
        </a>

      </div>
    </div>

    <!-- Scroll indicators -->
    <div class="wwd__dots" id="wwdDots"></div>

    <!-- Scroll hint arrow -->
    <div class="wwd__scroll-hint" id="wwdScrollHint">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </div>

  </section>

  <!-- ═══════════════════════════════════════════════════════════
       HOW IT WORKS — 4 photo cards
  ═══════════════════════════════════════════════════════════ -->
  <!-- ═══════════════════════════════════════════════════════════
       HOW IT WORKS — sticky scroll, 4 crossfade panels
  ═══════════════════════════════════════════════════════════ -->
  <section class="hiw-sticky" id="hiwSticky">

    <!-- PANEL 01: Free Consultation -->
    <div class="hiw-panel" data-hiw="0">
      <div class="hiw-panel__bg">
        <img src="https://res.cloudinary.com/deunehrew/image/upload/v1781633582/hf_20260616_180905_08380ebf-5c89-494a-a09c-0253284962e3_lcoe4b.jpg" alt="Consultant meeting homeowner" class="hiw-panel__bg-img" width="1800" height="1013" loading="lazy" />
        <div class="hiw-panel__bg-overlay"></div>
      </div>
      <div class="hiw-panel__inner">
        <div class="hiw-panel__content">
          <h2 class="hiw-panel__h2">We come to you.<br/>No pressure, ever.</h2>
          <p class="hiw-panel__body">A certified window film specialist visits your home or business. We assess your space and recommend the perfect solution.</p>
          <div class="hiw-panel__faq">
            <div class="hiw-panel__faq-item">
              <button class="hiw-panel__faq-q" aria-expanded="false">How long does a consultation take?<span class="hiw-panel__faq-icon">+</span></button>
              <div class="hiw-panel__faq-a" hidden>Most consultations take about 30–45 minutes. We walk through your space, discuss your goals, and answer every question you have — no rush.</div>
            </div>
            <div class="hiw-panel__faq-item">
              <button class="hiw-panel__faq-q" aria-expanded="false">Is the consultation really free?<span class="hiw-panel__faq-icon">+</span></button>
              <div class="hiw-panel__faq-a" hidden>Yes — 100% free, no obligation. We'll give you an honest recommendation whether you move forward with us or not.</div>
            </div>
            <div class="hiw-panel__faq-item">
              <button class="hiw-panel__faq-q" aria-expanded="false">Do you serve all Philadelphia areas?<span class="hiw-panel__faq-icon">+</span></button>
              <div class="hiw-panel__faq-a" hidden>We cover all of Philadelphia and the greater Delaware Valley — Center City, the suburbs, and surrounding counties.</div>
            </div>
          </div>
          <a href="/contact/" class="hiw-panel__link">Book your free consultation →</a>
        </div>
        <nav class="hiw-panel__index" aria-label="Process steps">
          <div class="hiw-panel__index-item hiw-panel__index-item--active" data-index="0">
            <span class="hiw-panel__index-line"></span>
            <span class="hiw-panel__index-label">Free Consultation</span>
            <span class="hiw-panel__index-num">01</span>
          </div>
          <div class="hiw-panel__index-item" data-index="1">
            <span class="hiw-panel__index-line"></span>
            <span class="hiw-panel__index-label">Custom Quote</span>
            <span class="hiw-panel__index-num">02</span>
          </div>
          <div class="hiw-panel__index-item" data-index="2">
            <span class="hiw-panel__index-line"></span>
            <span class="hiw-panel__index-label">Expert Installation</span>
            <span class="hiw-panel__index-num">03</span>
          </div>
          <div class="hiw-panel__index-item" data-index="3">
            <span class="hiw-panel__index-line"></span>
            <span class="hiw-panel__index-label">Lifetime Warranty</span>
            <span class="hiw-panel__index-num">04</span>
          </div>
        </nav>
      </div>
    </div>

    <!-- PANEL 02: Custom Quote -->
    <div class="hiw-panel" data-hiw="1">
      <div class="hiw-panel__bg">
        <img src="https://res.cloudinary.com/deunehrew/image/upload/v1781633639/hf_20260616_180915_3906a1d8-06ae-4639-9856-389f27f8e776_mhzkno.jpg" alt="Measuring windows precisely" class="hiw-panel__bg-img" width="1800" height="1013" loading="lazy" />
        <div class="hiw-panel__bg-overlay"></div>
      </div>
      <div class="hiw-panel__inner">
        <div class="hiw-panel__content">
          <h2 class="hiw-panel__h2">Transparent pricing.<br/>Zero surprises.</h2>
          <p class="hiw-panel__body">Same-day custom quote based on your exact windows. No hidden fees, no pressure. Just clear honest pricing.</p>
          <div class="hiw-panel__faq">
            <div class="hiw-panel__faq-item">
              <button class="hiw-panel__faq-q" aria-expanded="false">How is pricing calculated?<span class="hiw-panel__faq-icon">+</span></button>
              <div class="hiw-panel__faq-a" hidden>Pricing is based on the total square footage of glass, the film type selected, and the number of windows. We measure every window precisely during the consultation.</div>
            </div>
            <div class="hiw-panel__faq-item">
              <button class="hiw-panel__faq-q" aria-expanded="false">How long is a quote valid?<span class="hiw-panel__faq-icon">+</span></button>
              <div class="hiw-panel__faq-a" hidden>Quotes are valid for 30 days. If prices change due to product availability, we'll let you know right away.</div>
            </div>
            <div class="hiw-panel__faq-item">
              <button class="hiw-panel__faq-q" aria-expanded="false">Can I get a quote online?<span class="hiw-panel__faq-icon">+</span></button>
              <div class="hiw-panel__faq-a" hidden>Yes — send us photos and approximate measurements through our contact form and we'll give you a ballpark estimate before the in-home visit.</div>
            </div>
          </div>
          <a href="/contact/" class="hiw-panel__link">Get your quote →</a>
        </div>
        <nav class="hiw-panel__index" aria-label="Process steps">
          <div class="hiw-panel__index-item" data-index="0">
            <span class="hiw-panel__index-line"></span>
            <span class="hiw-panel__index-label">Free Consultation</span>
            <span class="hiw-panel__index-num">01</span>
          </div>
          <div class="hiw-panel__index-item hiw-panel__index-item--active" data-index="1">
            <span class="hiw-panel__index-line"></span>
            <span class="hiw-panel__index-label">Custom Quote</span>
            <span class="hiw-panel__index-num">02</span>
          </div>
          <div class="hiw-panel__index-item" data-index="2">
            <span class="hiw-panel__index-line"></span>
            <span class="hiw-panel__index-label">Expert Installation</span>
            <span class="hiw-panel__index-num">03</span>
          </div>
          <div class="hiw-panel__index-item" data-index="3">
            <span class="hiw-panel__index-line"></span>
            <span class="hiw-panel__index-label">Lifetime Warranty</span>
            <span class="hiw-panel__index-num">04</span>
          </div>
        </nav>
      </div>
    </div>

    <!-- PANEL 03: Expert Installation -->
    <div class="hiw-panel" data-hiw="2">
      <div class="hiw-panel__bg">
        <img src="https://res.cloudinary.com/deunehrew/image/upload/v1781633582/hf_20260616_181110_cd801226-8344-4617-9726-35d8141be239_whirhf.png" alt="Certified installer applying window film" class="hiw-panel__bg-img" width="1800" height="1013" loading="lazy" />
        <div class="hiw-panel__bg-overlay"></div>
      </div>
      <div class="hiw-panel__inner">
        <div class="hiw-panel__content">
          <h2 class="hiw-panel__h2">Certified installers.<br/>Done in one day.</h2>
          <p class="hiw-panel__body">Our trained technicians handle everything. Most residential jobs completed in a single day. Clean, precise, professional every time.</p>
          <div class="hiw-panel__faq">
            <div class="hiw-panel__faq-item">
              <button class="hiw-panel__faq-q" aria-expanded="false">How long does installation take?<span class="hiw-panel__faq-icon">+</span></button>
              <div class="hiw-panel__faq-a" hidden>Most single-family homes are completed in one day. Larger properties or commercial projects may take 2–3 days. We work quickly but never rush.</div>
            </div>
            <div class="hiw-panel__faq-item">
              <button class="hiw-panel__faq-q" aria-expanded="false">Will it disrupt my home or business?<span class="hiw-panel__faq-icon">+</span></button>
              <div class="hiw-panel__faq-a" hidden>Minimal disruption. Our team arrives prepared, works room by room, and leaves your space spotless. You can use your space the same day in rooms we've finished.</div>
            </div>
            <div class="hiw-panel__faq-item">
              <button class="hiw-panel__faq-q" aria-expanded="false">What films do you install?<span class="hiw-panel__faq-icon">+</span></button>
              <div class="hiw-panel__faq-a" hidden>We install all major film brands — 3M, LLumar, SunTek, Vista, Madico, and more. We help you pick the right film for your specific needs and budget.</div>
            </div>
          </div>
          <a href="/contact/" class="hiw-panel__link">See our installation process →</a>
        </div>
        <nav class="hiw-panel__index" aria-label="Process steps">
          <div class="hiw-panel__index-item" data-index="0">
            <span class="hiw-panel__index-line"></span>
            <span class="hiw-panel__index-label">Free Consultation</span>
            <span class="hiw-panel__index-num">01</span>
          </div>
          <div class="hiw-panel__index-item" data-index="1">
            <span class="hiw-panel__index-line"></span>
            <span class="hiw-panel__index-label">Custom Quote</span>
            <span class="hiw-panel__index-num">02</span>
          </div>
          <div class="hiw-panel__index-item hiw-panel__index-item--active" data-index="2">
            <span class="hiw-panel__index-line"></span>
            <span class="hiw-panel__index-label">Expert Installation</span>
            <span class="hiw-panel__index-num">03</span>
          </div>
          <div class="hiw-panel__index-item" data-index="3">
            <span class="hiw-panel__index-line"></span>
            <span class="hiw-panel__index-label">Lifetime Warranty</span>
            <span class="hiw-panel__index-num">04</span>
          </div>
        </nav>
      </div>
    </div>

    <!-- PANEL 04: Lifetime Warranty -->
    <div class="hiw-panel" data-hiw="3">
      <div class="hiw-panel__bg">
        <img src="https://res.cloudinary.com/deunehrew/image/upload/v1781633582/hf_20260616_180939_e45884d8-f457-4af5-b265-5e38857235d4_the5fc.jpg" alt="Beautiful result — warm filtered light" class="hiw-panel__bg-img" width="1800" height="1013" loading="lazy" />
        <div class="hiw-panel__bg-overlay"></div>
      </div>
      <div class="hiw-panel__inner">
        <div class="hiw-panel__content">
          <h2 class="hiw-panel__h2">We stand behind<br/>every single install.</h2>
          <p class="hiw-panel__body">Every installation comes with our lifetime warranty on labor plus manufacturer warranty on the film. Done right, every time.</p>
          <div class="hiw-panel__faq">
            <div class="hiw-panel__faq-item">
              <button class="hiw-panel__faq-q" aria-expanded="false">What does the warranty cover?<span class="hiw-panel__faq-icon">+</span></button>
              <div class="hiw-panel__faq-a" hidden>Our labor warranty covers any installation-related issues for life. The manufacturer warranty covers the film itself — bubbling, peeling, delaminating — for the film's warranted period, typically 5–15 years.</div>
            </div>
            <div class="hiw-panel__faq-item">
              <button class="hiw-panel__faq-q" aria-expanded="false">How do I make a warranty claim?<span class="hiw-panel__faq-icon">+</span></button>
              <div class="hiw-panel__faq-a" hidden>Call or email us directly. We handle the entire claim process with the manufacturer on your behalf — no runaround, no fine print to decode yourself.</div>
            </div>
            <div class="hiw-panel__faq-item">
              <button class="hiw-panel__faq-q" aria-expanded="false">Is the warranty transferable?<span class="hiw-panel__faq-icon">+</span></button>
              <div class="hiw-panel__faq-a" hidden>Manufacturer warranties are typically transferable to a new property owner. Ask us about your specific film for full details.</div>
            </div>
          </div>
          <a href="/warranty/" class="hiw-panel__link">Read our warranty →</a>
        </div>
