---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Window Film Philadelphia — Scottish Window Solutions";
const description = "Professional window film installation in Philadelphia and the Delaware Valley. UV protection, energy savings, safety & security, and decorative film for homes and businesses.";

const applications = [
  { label: "Offices",             img: "/images/2021-09-office-window-film-philadelphia.webp",       href: "/applications/office/" },
  { label: "Retail & Restaurants",img: "/images/bar-window-film-philadelphia-1.webp",                  href: "/applications/retail/" },
  { label: "Schools & Universities", img: "/images/2021-09-classroom-window-film-philadelphia.webp",  href: "/applications/schools-universities/" },
  { label: "Government Buildings", img: "/images/2021-09-government-building-window-film-philadelphia.webp", href: "/government-buildings/" },
  { label: "Hotels & Hospitality",img: "/images/2021-09-3m-window-film-philadelphia.webp",             href: "/applications/hotel-window-film/" },
  { label: "Museums & Libraries", img: "/images/2021-09-museum-window-film-philadelphia.webp",         href: "/applications/museums-libraries/" },
  { label: "Arenas & Stadiums",   img: "/images/2021-09-arena-window-film-philadelphia.webp",           href: "/applications/arenas-stadiums/" },
  { label: "Churches",            img: "/images/2021-09-church-window-film-philadelphia.webp",         href: "/applications/churches/" },
];
---

<BaseLayout title={title} description={description}>
  <Header />

  <!-- ═══════════════════════════════════════════════════════
       SECTION 2: HERO — 100vh, dark overlay, centered content
  ═══════════════════════════════════════════════════════ -->
  <!-- ═══════════════════════════════════════════════════════════
     HERO — full-bleed video overlay, superpower.com style
  ═══════════════════════════════════════════════════════════ -->
  <section class="hero-new">
    <!-- Full-bleed background video -->
    <div class="hero-new__bg">
      <video class="hero-new__bg-video" src="https://res.cloudinary.com/deunehrew/video/upload/v1781627724/hf_20260615_215550_351f234d-19f5-43f3-805b-96552d2e9ea0_i271kv.mp4" autoplay muted loop playsinline poster="/images/wfp-landing-hero.webp"></video>
      <div class="hero-new__bg-overlay"></div>
    </div>

    <!-- Overlay content — left-aligned -->
    <div class="hero-new__content">
      <p class="hero-new__eyebrow">● PHILADELPHIA'S #1 WINDOW FILM COMPANY</p>
      <h1 class="hero-new__h1">
        <span class="hero-word">Philadelphia's</span>
        <span class="hero-word">glass,</span>
        <span class="hero-word">transformed.</span>
      </h1>
      <p class="hero-new__sub">Energy savings. UV protection. Safety &amp; security. Done right, every time.</p>
      <div class="hero-new__ctas">
        <a href="/contact/" class="hero-new__cta-primary">Get a free quote</a>
        <a href="/services/" class="hero-new__cta-ghost">See our services</a>
      </div>
    </div>

    <!-- Stats bar — bottom left -->
    <div class="hero-new__stats">
      <div class="hero-new__stat">
        <span class="hero-new__stat-num">20+</span>
        <span class="hero-new__stat-label">Years Experience</span>
      </div>
      <div class="hero-new__stat-divider"></div>
      <div class="hero-new__stat">
        <span class="hero-new__stat-num">2,400+</span>
        <span class="hero-new__stat-label">Projects Completed</span>
      </div>
      <div class="hero-new__stat-divider"></div>
      <div class="hero-new__stat">
        <span class="hero-new__stat-num">99%</span>
        <span class="hero-new__stat-label">UV Block Rate</span>
      </div>
      <div class="hero-new__stat-divider"></div>
      <div class="hero-new__stat">
        <span class="hero-new__stat-num">4.9★</span>
        <span class="hero-new__stat-label">Google Rating</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
     WHAT WE DO — modern 4-card section
  ═══════════════════════════════════════════════════════════ -->
  <section class="wwd">
    <!-- Trust banner -->
    <div class="wwd__trust">
      <p class="wwd__trust-text">Trusted by Philadelphia homeowners &amp; businesses since 2008</p>
    </div>

    <!-- Brand logos -->
    <div class="wwd__logos">
      <span class="wwd__logo-chip">3M&trade;</span>
      <span class="wwd__logo-chip">Madico</span>
      <span class="wwd__logo-chip">Vista by Eastman</span>
      <span class="wwd__logo-chip">NanoTint</span>
      <span class="wwd__logo-chip">Hanita Coatings</span>
      <span class="wwd__logo-chip">Solyx</span>
    </div>

    <!-- Heading -->
    <div class="wwd__heading">
      <h2 class="wwd__title">What we do</h2>
      <p class="wwd__sub">Professional window film for every space and every need.</p>
    </div>

    <!-- 4 Service cards -->
    <div class="wwd__grid">
      <a href="/applications/office/" class="wwd__card">
        <div class="wwd__card-img">
          <img src="https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&q=80" alt="Glass skyscraper facade — commercial window film" width="800" height="560" loading="lazy" />
          <span class="wwd__card-num">1</span>
        </div>
        <div class="wwd__card-body">
          <h3 class="wwd__card-title">Commercial film</h3>
          <p class="wwd__card-desc">Reduce glare and energy costs across your entire building</p>
        </div>
      </a>
      <a href="/applications/residential/" class="wwd__card">
        <div class="wwd__card-img">
          <img src="https://images.unsplash.com/photo-1600210492493-0946911123ea?w=800&q=80" alt="Bright living room with floor-to-ceiling windows — residential window film" width="800" height="560" loading="lazy" />
          <span class="wwd__card-num">2</span>
        </div>
        <div class="wwd__card-body">
          <h3 class="wwd__card-title">Residential film</h3>
          <p class="wwd__card-desc">Keep your home cool, private and protected year-round</p>
        </div>
      </a>
      <a href="/benefits/safety-and-security/" class="wwd__card">
        <div class="wwd__card-img">
          <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800&q=80" alt="Glass and windows — safety and security window film" width="800" height="560" loading="lazy" />
          <span class="wwd__card-num">3</span>
        </div>
        <div class="wwd__card-body">
          <h3 class="wwd__card-title">Safety &amp; security film</h3>
          <p class="wwd__card-desc">Hold glass together when it matters most</p>
        </div>
      </a>
      <a href="/benefits/privacy-window-film-philadelphia/" class="wwd__card">
        <div class="wwd__card-img">
          <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&q=80" alt="Modern office interior with glass partitions — decorative window film" width="800" height="560" loading="lazy" />
          <span class="wwd__card-num">4</span>
        </div>
        <div class="wwd__card-body">
          <h3 class="wwd__card-title">Decorative film</h3>
          <p class="wwd__card-desc">Frosted, patterned and custom privacy designs</p>
        </div>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SECTION 3A: STATS BAR
  ═══════════════════════════════════════════════════════════ -->
  <section class="stats-bar">
    <div class="stats-bar__inner">
      <div class="stats-bar__stat">
        <span class="stats-bar__num" data-count-end="20" data-count-suffix="">0</span>
        <span class="stats-bar__label">Years Experience</span>
      </div>
      <div class="stats-bar__divider"></div>
      <div class="stats-bar__stat">
        <span class="stats-bar__num" data-count-end="2400" data-count-suffix="+">0</span>
        <span class="stats-bar__label">Projects Completed</span>
      </div>
      <div class="stats-bar__divider"></div>
      <div class="stats-bar__stat">
        <span class="stats-bar__num" data-count-end="99" data-count-suffix="%">0</span>
        <span class="stats-bar__label">UV Block Rate</span>
      </div>
      <div class="stats-bar__divider"></div>
      <div class="stats-bar__stat">
        <span class="stats-bar__num" data-count-end="4" data-count-suffix=".9★">0</span>
        <span class="stats-bar__label">Google Rating</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SECTION 3B: HOW IT WORKS
  ═══════════════════════════════════════════════════════════ -->
  <section class="hiw2">
    <p class="hiw2__eyebrow">THE PROCESS</p>
    <h2 class="hiw2__title">From first call to finished install</h2>

    <div class="hiw2__steps">
      <!-- Step 1 -->
      <div class="hiw2__step scroll-reveal">
        <div class="hiw2__step-num">1</div>
        <div class="hiw2__step-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.73a16 16 0 0 0 6 6l.95-.95a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.73 16.92z"/><path d="M14.05 2a9 9 0 0 1 8 7.94"/><path d="M14.05 6A5 5 0 0 1 18 10"/></svg>
        </div>
        <h3 class="hiw2__step-title">Free Consultation</h3>
        <p class="hiw2__step-desc">We assess your space and recommend the perfect film for your needs</p>
      </div>

      <div class="hiw2__connector"></div>

      <!-- Step 2 -->
      <div class="hiw2__step scroll-reveal">
        <div class="hiw2__step-num">2</div>
        <div class="hiw2__step-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <h3 class="hiw2__step-title">Custom Quote</h3>
        <p class="hiw2__step-desc">Same-day transparent pricing. No surprises, no pressure — ever</p>
      </div>

      <div class="hiw2__connector"></div>

      <!-- Step 3 -->
      <div class="hiw2__step scroll-reveal">
        <div class="hiw2__step-num">3</div>
        <div class="hiw2__step-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <h3 class="hiw2__step-title">Expert Installation</h3>
        <p class="hiw2__step-desc">Certified installers. Clean work. Most jobs done in a single day</p>
      </div>

      <div class="hiw2__connector"></div>

      <!-- Step 4 -->
      <div class="hiw2__step scroll-reveal">
        <div class="hiw2__step-num">4</div>
        <div class="hiw2__step-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        </div>
        <h3 class="hiw2__step-title">Lifetime Warranty</h3>
        <p class="hiw2__step-desc">We stand behind every install with our lifetime warranty</p>
      </div>
    </div>

    <div class="hiw2__cta">
      <p class="hiw2__cta-text">Ready to get started?</p>
      <a href="/contact/" class="hiw2__cta-btn">Book Free Consultation →</a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SECTION 5: BEFORE / AFTER SLIDER
  ═══════════════════════════════════════════════════════════ -->
  <section class="ba-section">
    <div class="container">
      <span class="eyebrow scroll-reveal">SEE THE DIFFERENCE</span>
      <h2 class="section-h2 scroll-reveal">Before and after: the film advantage</h2>
    </div>
    <div class="ba-slider" id="baSlider">
      <img src="/images/glare-reduction-window-film-philadelphia.jpg" alt="Before: harsh glare without film" class="ba-before" width="1200" height="600" loading="lazy" />
      <div class="ba-after">
        <img src="/images/window-film-philadelphia-uv-protection-glare-control-1.webp" alt="After: with window film" class="ba-after-img" width="1200" height="600" loading="lazy" />
      </div>
      <div class="ba-handle" id="baHandle">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
        <div class="ba-handle__line"></div>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      </div>
      <span class="ba-label ba-label--before">Before</span>
      <span class="ba-label ba-label--after">After</span>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
     HOW IT WORKS — bg image + left text + right steps + accordion
  ═══════════════════════════════════════════════════════ -->
  <section class="hiw">
    <div class="hiw__bg">
      <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1600&q=80"
        alt="Modern Philadelphia home"
        class="hiw__bg-img"
        width="1600"
        height="900"
        loading="lazy"
      />
      <div class="hiw__bg-overlay"></div>
    </div>

    <div class="hiw__inner">

      <!-- Left: title + accordion -->
      <div class="hiw__left">
        <div class="hiw__heading">
          <h2 class="hiw__title">Window film that<br/>pays for itself.</h2>
          <p class="hiw__sub">Professional installation across the Delaware Valley. Most jobs done in a single day — no mess, no hassle.</p>
        </div>

        <div class="hiw__accordion">
          <div class="hiw__acc-item" data-acc>
            <button class="hiw__acc-trigger" aria-expanded="false">
              <span>How long does installation take?</span>
              <span class="hiw__acc-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
              </span>
            </button>
            <div class="hiw__acc-body" hidden>
              <p>Most residential installations are completed in a single day. Larger commercial projects may take 2–3 days. Our team arrives early and leaves your space spotless.</p>
            </div>
          </div>

          <div class="hiw__acc-item" data-acc>
            <button class="hiw__acc-trigger" aria-expanded="false">
              <span>Will window film damage my windows?</span>
              <span class="hiw__acc-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
              </span>
            </button>
            <div class="hiw__acc-body" hidden>
              <p>No. When professionally installed by our certified team, window film is completely safe for your glass. We use manufacturer-approved methods and materials on every job.</p>
            </div>
          </div>

          <div class="hiw__acc-item" data-acc>
            <button class="hiw__acc-trigger" aria-expanded="false">
              <span>Is there a warranty?</span>
              <span class="hiw__acc-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
              </span>
            </button>
            <div class="hiw__acc-body" hidden>
              <p>Yes. All installations are backed by the manufacturer's warranty — typically 5 to 15 years depending on the film. We handle any warranty claims directly on your behalf.</p>
            </div>
          </div>

          <div class="hiw__acc-item" data-acc>
            <button class="hiw__acc-trigger" aria-expanded="false">
              <span>Can I install it myself?</span>
              <span class="hiw__acc-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
              </span>
            </button>
            <div class="hiw__acc-body" hidden>
              <p>DIY kits exist, but bubbles, peeling edges, and scratches are common. Our professional installation ensures a flawless finish and full warranty coverage.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: numbered steps -->
      <div class="hiw__steps">
        <div class="hiw__step">
          <span class="hiw__step-num">01</span>
          <span class="hiw__step-text hiw__step-text--active">Free in-home consultation</span>
        </div>
        <div class="hiw__step">
          <span class="hiw__step-num">02</span>
          <span class="hiw__step-text">Custom film selection</span>
        </div>
        <div class="hiw__step">
          <span class="hiw__step-num">03</span>
          <span class="hiw__step-text">Expert installation</span>
        </div>
        <div class="hiw__step">
          <span class="hiw__step-num">04</span>
          <span class="hiw__step-text">Backed by manufacturer warranty</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 6: PERFORMANCE NUMBERS
  ═══════════════════════════════════════════════════════ -->
  <section class="perf-section">
    <div class="container">
      <span class="eyebrow eyebrow--teal scroll-reveal">BY THE NUMBERS</span>
      <h2 class="section-h2 section-h2--white scroll-reveal">Performance you can measure</h2>
      <div class="stats-grid">
        <div class="stat-card scroll-reveal">
          <div class="stat-card__num" data-count="78" data-suffix="%">0%</div>
          <div class="stat-card__label">Heat rejected</div>
        </div>
        <div class="stat-card scroll-reveal">
          <div class="stat-card__num" data-count="99" data-suffix="%">0%</div>
          <div class="stat-card__label">UV rays blocked</div>
        </div>
        <div class="stat-card scroll-reveal">
          <div class="stat-card__num" data-count="87" data-suffix="%">0%</div>
          <div class="stat-card__label">Glare reduction</div>
        </div>
        <div class="stat-card scroll-reveal">
          <div class="stat-card__num" data-count="30" data-suffix="%">0%</div>
          <div class="stat-card__label">Cooling cost reduction</div>
        </div>
        <div class="stat-card scroll-reveal">
          <div class="stat-card__num" data-suffix="mil">0mil</div>
          <div class="stat-card__label">Security film thickness</div>
        </div>
        <div class="stat-card scroll-reveal">
          <div class="stat-card__num" data-suffix="yr+">0yr+</div>
          <div class="stat-card__label">Years in Philadelphia</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 7: APPLICATIONS GRID
  ═══════════════════════════════════════════════════════ -->
  <section class="apps-section">
    <div class="container">
      <span class="eyebrow scroll-reveal">APPLICATIONS</span>
      <h2 class="section-h2 scroll-reveal">Every glass surface. Every industry.</h2>
      <div class="apps-grid">
        {applications.map((app, i) => (
          <a href={app.href} class="app-card scroll-reveal" aria-label={`Window film for ${app.label}`}>
            <div class="app-card__img-wrap">
              <img
                src={app.img}
                alt={`Window film for ${app.label}`}
                class="app-card__img"
                loading="lazy"
                width="400"
                height="300"
              />
              <div class="app-card__overlay"></div>
              <div class="app-card__label-wrap">
                <span class="app-card__label">{app.label}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 8: BRANDS
  ═══════════════════════════════════════════════════════ -->
  <section class="brands-section">
    <div class="container">
      <span class="eyebrow scroll-reveal">CERTIFIED PARTNERS</span>
      <div class="brands-pills scroll-reveal">
        {['3M', 'Madico', 'Vista by Eastman', 'NanoTint', 'Hanita Coatings', 'Solyx'].map(brand => (
          <span class="brand-pill">{brand}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 9: TESTIMONIAL
  ═══════════════════════════════════════════════════════ -->
  <section class="testi-section">
    <div class="container">
      <div class="testi-inner scroll-reveal">
        <span class="testi-eyebrow">PHILLY SCHOOLS</span>
        <div class="testi-quote-mark" aria-hidden="true">"</div>
        <blockquote class="testi-quote">
          We had 47 windows treated across two campuses. The glare reduction alone made the project worth it — my teachers can actually use their smartboards now. Installation was done in four days with zero disruption to classes.
        </blockquote>
        <div class="testi-stars" aria-label="5 stars">
          {[1,2,3,4,5].map(() => (
