/* ─── WHAT WE DO — scroll-driven horizontal carousel ─── */
.wwd {
  background: #FFFFFF;
  padding: 0;
  overflow: hidden;
}

/* ── Trust strip — brand logo slider ── */
/* ── Trust strip — clean logo slider ── */
.trust-strip {
  background: transparent;
  padding: 32px 0;
  border: none;
}
.trust-strip__title {
  font-family: 'Space Mono', monospace;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: rgba(0,0,0,0.40);
  text-align: center;
  margin: 0 0 24px;
}
.trust-strip__mask {
  overflow: hidden;
  mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
  -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
}
.trust-strip__track {
  display: flex;
  gap: 48px;
  align-items: center;
  width: max-content;
  animation: scroll-left 32s linear infinite;
}
.trust-strip__logo {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.trust-strip__logo a {
  display: block;
  transition: transform 0.3s ease;
}
.trust-strip__logo a:hover {
  transform: scale(1.05);
}
.trust-strip__logo img {
  height: 52px;
  width: auto;
  max-width: 140px;
  object-fit: contain;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
  margin: 0;
  filter: none;
  opacity: 1;
  display: block;
}
@keyframes scroll-left {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* Heading — centered */
.wwd__heading {
  padding: 80px 7vw 48px;
  text-align: center;
}
.wwd__eyebrow {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.22em;
  color: #7CB342;
  margin-bottom: 0.75rem;
}
.wwd__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.2rem, 4vw, 3.25rem);
  font-weight: 700;
  color: #14201A;
  letter-spacing: -0.02em;
  line-height: 1.15;
  max-width: 600px;
  margin: 0 auto 1rem;
}
.wwd__sub {
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  font-weight: 400;
  color: #4A5C48;
  margin: 0 0 48px;
}

/* Full-width cinematic panels */
.wwd__panels {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  width: 100%;
  max-width: 100vw;
  margin: 0;
}

/* Panel */
.wwd__panel {
  position: relative;
  min-height: 600px;
  overflow: hidden;
  text-decoration: none;
  display: block;
  opacity: 0;
  transform: translateY(40px);
  animation: wwd-fade-in 0.8s ease forwards;
}
@keyframes wwd-fade-in {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Panel image — full bleed */
.wwd__panel-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 0.6s ease;
}
.wwd__panel:hover .wwd__panel-img {
  transform: scale(1.05);
}

/* Gradient overlay — heavy at bottom */
.wwd__panel-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.85) 0%,
    rgba(0,0,0,0.2) 60%,
    transparent 100%
  );
  pointer-events: none;
  transition: background 0.4s ease;
}
.wwd__panel:hover .wwd__panel-overlay {
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.90) 0%,
    rgba(0,0,0,0.35) 60%,
    transparent 100%
  );
}

/* Content — pinned bottom left */
.wwd__panel-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32px;
  z-index: 2;
}

/* Title */
.wwd__panel-title {
  font-family: 'Playfair Display', serif;
  font-size: 32px;
  font-weight: 700;
  color: #FFFFFF;
  margin: 0 0 8px;
  line-height: 1.2;
}

/* Subtitle */
.wwd__panel-subtitle {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  font-weight: 400;
  color: rgba(255,255,255,0.75);
  margin: 0 0 12px;
  line-height: 1.5;
}

/* Description — slides up on hover */
.wwd__panel-desc {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-weight: 400;
  color: #FFFFFF;
  line-height: 1.7;
  margin: 0;
  max-width: 90%;
  opacity: 0;
  transform: translateY(12px);
  transition: opacity 0.4s ease, transform 0.4s ease;
}
.wwd__panel:hover .wwd__panel-desc {
  opacity: 1;
  transform: translateY(0);
}

/* Arrow — bottom right on hover */
.wwd__panel-arrow {
  position: absolute;
  bottom: 32px;
  right: 32px;
  font-size: 24px;
  color: #7CB342;
  opacity: 0;
  transform: translateX(-8px);
  transition: opacity 0.4s ease, transform 0.4s ease;
}
.wwd__panel:hover .wwd__panel-arrow {
  opacity: 1;
  transform: translateX(0);
}

/* Green bottom line — animates in on hover */
.wwd__panel-line {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 3px;
  width: 0;
  background: #7CB342;
  transition: width 0.4s ease;
  z-index: 3;
}
.wwd__panel:hover .wwd__panel-line {
  width: 100%;
}

/* Mobile responsive */
@media (max-width: 1024px) {
  .wwd__panels {
    grid-template-columns: repeat(2, 1fr);
  }
  .wwd__panel {
    min-height: 480px;
  }
}

@media (max-width: 768px) {
  .wwd__title { font-size: 2rem; }
  .wwd__heading { padding: 60px 5vw 40px; }
  .wwd__panel {
    min-height: 420px;
  }
  .wwd__panel-content {
    padding: 24px;
  }
  .wwd__panel-title {
    font-size: 26px;
  }
  .wwd__panel-arrow {
    bottom: 24px;
    right: 24px;
  }
}

@media (max-width: 480px) {
  .wwd__panels {
    grid-template-columns: 1fr;
  }
  .wwd__panel {
    min-height: 380px;
  }
  .wwd__panel-desc { font-size: 12px; }
}

/* ─── OWNER MESSAGE — mobile ─── */
@media (max-width: 768px) {
  .owner-msg { padding: 40px 0; }
  .owner-msg__grid {
    grid-template-columns: 1fr;
    min-height: auto;
    max-height: none;
  }
