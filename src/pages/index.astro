---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Window Film Philadelphia — Scottish Window Solutions";
const description = "Professional window film installation in Philadelphia and the Delaware Valley. UV protection, energy savings, safety & security, and decorative film for homes and businesses.";

const applications = [
  { label: "Offices",             img: "/images/2021-09-office-window-film-philadelphia.webp",       href: "/applications/office/" },
  { label: "Retail & Restaurants",img: "/images/bar-window-film-philadelphia-1.webp",                  href: "/applications/retail/" },
  { label: "Schools & Universities", img: "/images/2021-09-classroom-window-film-philadelphia.webp",  href: "/applications/schools-universities/" },
  { label: "Government Buildings", img: "/images/2021-09-government-building-window-film-philadelphia.webp", href: "/government-buildings/" },
  { label: "Hotels & Hospitality",img: "/images/2021-09-3m-window-film-philadelphia.webp",             href: "/applications/hotel-window-film/" },
  { label: "Museums & Libraries", img: "/images/2021-09-museum-window-film-philadelphia.webp",         href: "/applications/museums-libraries/" },
  { label: "Arenas & Stadiums",   img: "/images/2021-09-arena-window-film-philadelphia.webp",           href: "/applications/arenas-stadiums/" },
  { label: "Churches",            img: "/images/2021-09-church-window-film-philadelphia.webp",         href: "/applications/churches/" },
];
---

<BaseLayout title={title} description={description}>
  <Header />

  <!-- ═══════════════════════════════════════════════════════
       SECTION 2: HERO — 100vh, dark overlay, centered content
  ═══════════════════════════════════════════════════════ -->
  <!-- ═══════════════════════════════════════════════════════════
     HERO — modern split layout
  ═══════════════════════════════════════════════════════════ -->
  <section class="hero-new">
    <div class="hero-new__left">
      <p class="hero-new__eyebrow">SCOTTISH WINDOW SOLUTIONS</p>
      <h1 class="hero-new__h1">
        <span class="hero-word">Philadelphia's</span>
        <span class="hero-word">glass,</span>
        <span class="hero-word">transformed.</span>
      </h1>
      <p class="hero-new__sub">Professional window film for homes and businesses across the Delaware Valley. Energy savings. UV protection. Safety & security. Done right, every time.</p>
      <div class="hero-new__ctas">
        <a href="/contact/" class="hero-new__cta-primary">Get a free quote</a>
        <a href="/benefits/" class="hero-new__cta-ghost">See our services</a>
      </div>
      <div class="hero-new__features">
        <div class="hero-new__feat">
          <span class="hero-new__feat-num">78%</span>
          <span class="hero-new__feat-label">Heat rejected</span>
        </div>
        <div class="hero-new__feat">
          <span class="hero-new__feat-num">99%</span>
          <span class="hero-new__feat-label">UV blocked</span>
        </div>
        <div class="hero-new__feat">
          <span class="hero-new__feat-num">15yr+</span>
          <span class="hero-new__feat-label">In business</span>
        </div>
      </div>
    </div>
    <div class="hero-new__right">
      <video class="hero-new__video" src="https://res.cloudinary.com/deunehrew/video/upload/v1781627724/hf_20260615_215550_351f234d-19f5-43f3-805b-96552d2e9ea0_i271kv.mp4" autoplay muted loop playsinline poster="/images/wfp-landing-hero.webp"></video>
      <div class="hero-new__img-overlay"></div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 3: MARQUEE TICKER
  ═══════════════════════════════════════════════════════ -->
  <div class="marquee-wrap">
    <div class="marquee-track">
      <span>3M Window Film · Madico · Vista by Eastman · NanoTint · Hanita Coatings · Solyx · Window Film Philadelphia · Energy Savings · UV Protection · Safety Film · School Security · Anti-Graffiti · Privacy Film · Glare Reduction · </span>
      <span>3M Window Film · Madico · Vista by Eastman · NanoTint · Hanita Coatings · Solyx · Window Film Philadelphia · Energy Savings · UV Protection · Safety Film · School Security · Anti-Graffiti · Privacy Film · Glare Reduction · </span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 4: SERVICES
  ═══════════════════════════════════════════════════════ -->
  <section class="services">
    <div class="container">
      <span class="eyebrow scroll-reveal">WHAT WE DO</span>
      <h2 class="section-h2 scroll-reveal">Complete glass protection<br/>for Philadelphia</h2>

      <div class="services__grid">
        <!-- Large card 1: Energy & Solar -->
        <div class="svc-card svc-card--large svc-card--green-accent scroll-reveal">
          <div class="svc-card__content">
            <p class="svc-card__label">ENERGY & SOLAR</p>
            <h3 class="svc-card__h3">Energy savings & solar control</h3>
            <p class="svc-card__body">Block 78% of solar heat and 99% of UV rays. Reduce cooling costs by up to 30%.</p>
            <div class="svc-card__badge">
              <span class="badge-num">78% / 99%</span>
              <span class="badge-label">Heat / UV</span>
            </div>
          </div>
          <div class="svc-card__img">
            <img src="/images/window-film-philadelphia-uv-protection-glare-control-1.webp" alt="Energy savings window film" width="600" height="420" loading="lazy" />
          </div>
        </div>

        <!-- Large card 2: Safety & Security -->
        <div class="svc-card svc-card--large svc-card--brand scroll-reveal">
          <div class="svc-card__content">
            <p class="svc-card__label svc-card__label--teal">SAFETY & SECURITY</p>
            <h3 class="svc-card__h3">Safety & security film</h3>
            <p class="svc-card__body">Hold glass together during storms, break-ins, and accidents.</p>
            <ul class="svc-card__list">
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Storm protection
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Break-in deterrent
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Injury reduction
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Shatter resistance
              </li>
            </ul>
          </div>
          <div class="svc-card__img">
            <img src="/images/safety-window-film-philadelphia.webp" alt="Safety window film" width="600" height="420" loading="lazy" />
          </div>
        </div>

        <!-- Small cards -->
        <div class="svc-card svc-card--small scroll-reveal">
          <div class="svc-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#83A94A" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>
          </div>
          <h4 class="svc-card__h4">UV Protection</h4>
          <p class="svc-card__body-sm">Block 99.9% of harmful UV rays that fade furniture and damage skin.</p>
        </div>

        <div class="svc-card svc-card--small scroll-reveal">
          <div class="svc-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#83A94A" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
          </div>
          <h4 class="svc-card__h4">Privacy Film</h4>
          <p class="svc-card__body-sm">Transform plain glass into frosted privacy panels or decorative designs.</p>
        </div>

        <div class="svc-card svc-card--small scroll-reveal">
          <div class="svc-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#83A94A" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 12c0 6.627 5.373 12 12 12s12-5.373 12-12c0-2.157-.574-4.18-1.591-5.914z"/></svg>
          </div>
          <h4 class="svc-card__h4">Anti-Graffiti</h4>
          <p class="svc-card__body-sm">Invisible sacrificial layer protects glass from scratches and graffiti.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 5: BEFORE / AFTER SLIDER
  ═══════════════════════════════════════════════════════ -->
  <section class="ba-section">
    <div class="container">
      <span class="eyebrow scroll-reveal">SEE THE DIFFERENCE</span>
      <h2 class="section-h2 scroll-reveal">Before and after: the film advantage</h2>
    </div>
    <div class="ba-slider" id="baSlider">
      <img src="/images/glare-reduction-window-film-philadelphia.jpg" alt="Before: harsh glare without film" class="ba-before" width="1200" height="600" loading="lazy" />
      <div class="ba-after">
        <img src="/images/window-film-philadelphia-uv-protection-glare-control-1.webp" alt="After: with window film" class="ba-after-img" width="1200" height="600" loading="lazy" />
      </div>
      <div class="ba-handle" id="baHandle">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
        <div class="ba-handle__line"></div>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
      </div>
      <span class="ba-label ba-label--before">Before</span>
      <span class="ba-label ba-label--after">After</span>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 6: PERFORMANCE NUMBERS
  ═══════════════════════════════════════════════════════ -->
  <section class="perf-section">
    <div class="container">
      <span class="eyebrow eyebrow--teal scroll-reveal">BY THE NUMBERS</span>
      <h2 class="section-h2 section-h2--white scroll-reveal">Performance you can measure</h2>
      <div class="stats-grid">
        <div class="stat-card scroll-reveal">
          <div class="stat-card__num" data-count="78" data-suffix="%">0%</div>
          <div class="stat-card__label">Heat rejected</div>
        </div>
        <div class="stat-card scroll-reveal">
          <div class="stat-card__num" data-count="99" data-suffix="%">0%</div>
          <div class="stat-card__label">UV rays blocked</div>
        </div>
        <div class="stat-card scroll-reveal">
          <div class="stat-card__num" data-count="87" data-suffix="%">0%</div>
          <div class="stat-card__label">Glare reduction</div>
        </div>
        <div class="stat-card scroll-reveal">
          <div class="stat-card__num" data-count="30" data-suffix="%">0%</div>
          <div class="stat-card__label">Cooling cost reduction</div>
        </div>
        <div class="stat-card scroll-reveal">
          <div class="stat-card__num" data-suffix="mil">0mil</div>
          <div class="stat-card__label">Security film thickness</div>
        </div>
        <div class="stat-card scroll-reveal">
          <div class="stat-card__num" data-suffix="yr+">0yr+</div>
          <div class="stat-card__label">Years in Philadelphia</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 7: APPLICATIONS GRID
  ═══════════════════════════════════════════════════════ -->
  <section class="apps-section">
    <div class="container">
      <span class="eyebrow scroll-reveal">APPLICATIONS</span>
      <h2 class="section-h2 scroll-reveal">Every glass surface. Every industry.</h2>
      <div class="apps-grid">
        {applications.map((app, i) => (
          <a href={app.href} class="app-card scroll-reveal" aria-label={`Window film for ${app.label}`}>
            <div class="app-card__img-wrap">
              <img
                src={app.img}
                alt={`Window film for ${app.label}`}
                class="app-card__img"
                loading="lazy"
                width="400"
                height="300"
              />
              <div class="app-card__overlay"></div>
              <div class="app-card__label-wrap">
                <span class="app-card__label">{app.label}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 8: BRANDS
  ═══════════════════════════════════════════════════════ -->
  <section class="brands-section">
    <div class="container">
      <span class="eyebrow scroll-reveal">CERTIFIED PARTNERS</span>
      <div class="brands-pills scroll-reveal">
        {['3M', 'Madico', 'Vista by Eastman', 'NanoTint', 'Hanita Coatings', 'Solyx'].map(brand => (
          <span class="brand-pill">{brand}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 9: TESTIMONIAL
  ═══════════════════════════════════════════════════════ -->
  <section class="testi-section">
    <div class="container">
      <div class="testi-inner scroll-reveal">
        <span class="testi-eyebrow">PHILLY SCHOOLS</span>
        <div class="testi-quote-mark" aria-hidden="true">"</div>
        <blockquote class="testi-quote">
          We had 47 windows treated across two campuses. The glare reduction alone made the project worth it — my teachers can actually use their smartboards now. Installation was done in four days with zero disruption to classes.
        </blockquote>
        <div class="testi-stars" aria-label="5 stars">
          {[1,2,3,4,5].map(() => (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>
          ))}
        </div>
        <p class="testi-attribution">— Sarah K., Principal, Northwest Philadelphia Elementary School</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 10: QUOTE FORM
  ═══════════════════════════════════════════════════════ -->
  <section class="quote-section">
    <div class="container">
      <div class="quote-grid">
        <div class="quote-left scroll-reveal">
          <span class="eyebrow">GET STARTED</span>
          <h2 class="section-h2">Ready to transform your glass?</h2>
          <ul class="quote-perks">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#83A94A" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Free on-site consultation and measurement
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#83A94A" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Custom film recommendation for your building
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#83A94A" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Certified 3M and Madico installation
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#83A94A" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Lifetime warranty on residential installations
            </li>
          </ul>
          <img src="/images/madico-window-film-contractor-philadelphia.png" alt="Madico certified installer" class="quote-photo" width="480" height="320" loading="lazy" />
        </div>
        <div class="quote-right scroll-reveal">
          <form class="quote-form" id="quoteForm">
            <div class="form-group">
              <input type="text" name="name" placeholder="Your Name" required />
            </div>
            <div class="form-group">
              <input type="tel" name="phone" placeholder="Phone Number" required />
            </div>
            <div class="form-group">
              <input type="email" name="email" placeholder="Email Address" required />
            </div>
            <div class="form-group">
              <select name="property_type" required>
                <option value="" disabled selected>Property type</option>
                <option value="residential">Residential</option>
                <option value="commercial">Commercial</option>
                <option value="government">Government</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="form-group">
              <textarea name="message" rows="4" placeholder="Tell us about your project..."></textarea>
            </div>
            <button type="submit" class="btn btn--primary btn--full">Get a free quote</button>
            <p class="form-note">No obligation. Response within 24 hours.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- ═══════════════════════════════════════════════════════
       SECTION 12: MOBILE STICKY CTA
  ═══════════════════════════════════════════════════════ -->
  <div class="mobile-sticky-cta">
    <a href="tel:+12673947980" class="mobile-sticky-cta__btn">Call now</a>
  </div>

</BaseLayout>

<style>
/* ─── HERO NEW — split layout, superpower.com style ─── */
.hero-new {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: var(--brand, #2A241E);
  overflow: hidden;
}
.hero-new__left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 8rem 5rem 5rem 5rem;
  position: relative;
  z-index: 2;
}
.hero-new__right {
  position: relative;
  overflow: hidden;
}
.hero-new__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.hero-new__video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.hero-new__img-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, var(--brand, #2A241E) 0%, transparent 30%);
}
.hero-new__eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--green-accent, #83A94A);
  margin-bottom: 1.5rem;
  font-weight: 500;
}
.hero-new__h1 {
  font-family: var(--font-serif, 'Fraunces', serif);
  font-weight: 800;
  font-size: clamp(2.8rem, 4.5vw, 5rem);
  color: #fff;
  letter-spacing: -0.03em;
  line-height: 1.05;
  margin-bottom: 1.5rem;
}
.hero-new__sub {
  font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
  font-weight: 300;
  font-size: 1.05rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.7;
  margin-bottom: 2.5rem;
  max-width: 480px;
}
.hero-new__ctas {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 3.5rem;
}
.hero-new__cta-primary {
  background: var(--green, #4E6B2A);
  color: #fff;
  padding: 14px 32px;
  border-radius: 9999px;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.95rem;
  text-decoration: none;
  transition: background 0.2s ease, transform 0.2s ease;
  display: inline-block;
}
.hero-new__cta-primary:hover {
  background: var(--green-hover, #3D5620);
  color: #fff;
  transform: translateY(-2px);
}
.hero-new__cta-ghost {
  border: 1.5px solid rgba(255,255,255,0.4);
  color: #fff;
  padding: 14px 32px;
  border-radius: 9999px;
  font-family: var(--font-body);
  font-weight: 400;
  font-size: 0.95rem;
  text-decoration: none;
  transition: border-color 0.2s ease, transform 0.2s ease;
  display: inline-block;
}
.hero-new__cta-ghost:hover {
  border-color: #fff;
  color: #fff;
  transform: translateY(-2px);
}
.hero-new__features {
  display: flex;
  gap: 2.5rem;
  padding-top: 2rem;
  border-top: 1px solid rgba(255,255,255,0.12);
}
.hero-new__feat {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.hero-new__feat-num {
  font-family: var(--font-serif, 'Fraunces', serif);
  font-weight: 800;
  font-size: 2rem;
  color: var(--green-accent, #83A94A);
  letter-spacing: -0.02em;
  line-height: 1;
}
.hero-new__feat-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: rgba(255,255,255,0.5);
}

/* Hero word animation */
.hero-word {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.55s ease-out, transform 0.55s ease-out;
  display: inline-block;
  margin-right: 0.28em;
  white-space: nowrap;
}
.hero-word.visible { opacity: 1; transform: translateY(0); }

/* ─── Responsive ─── */
@media (max-width: 768px) {
  .hero-new {
    grid-template-columns: 1fr;
    min-height: auto;
  }
  .hero-new__left {
    padding: 7rem 1.5rem 3rem;
    order: 2;
  }
  .hero-new__right {
    height: 55vw;
    min-height: 260px;
    order: 1;
  }
  .hero-new__img-overlay {
