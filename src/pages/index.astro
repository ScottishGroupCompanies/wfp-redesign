---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Window Film Philadelphia — Scottish Window Solutions";
const description = "Professional window film installation in Philadelphia and the Delaware Valley. UV protection, energy savings, safety & security, and decorative film for homes and businesses.";
---

<BaseLayout title={title} description={description}>
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@300;400;600;800&family=JetBrains+Mono:wght@400;500&display=swap');

    :root {
      --dark: #0d1a17;
      --teal: #6ec4b0;
      --canvas: #f0f4f3;
      --white: #ffffff;
      --text-dark: #0d1a17;
      --border-subtle: #1e3330;
      --border-light: #e0e8e5;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Bricolage Grotesque', sans-serif;
      background: var(--white);
      color: var(--text-dark);
      line-height: 1.6;
      overflow-x: hidden;
    }

    .eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--teal);
      margin-bottom: 1rem;
    }

    .section-h2 {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      color: var(--text-dark);
      line-height: 1.1;
      margin-bottom: 1.5rem;
    }

    .section-h2--white { color: var(--white); }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 600;
      font-size: 1rem;
      border-radius: 9999px;
      cursor: pointer;
      transition: all 0.25s ease;
      text-decoration: none;
      border: none;
    }

    .btn-primary {
      background: var(--teal);
      color: var(--white);
      padding: 14px 32px;
    }

    .btn-primary:hover { background: #5ab39d; transform: translateY(-2px); }

    .btn-ghost {
      background: transparent;
      color: var(--white);
      border: 1.5px solid var(--white);
      padding: 14px 32px;
    }

    .btn-ghost:hover { background: rgba(255,255,255,0.1); }

    /* Reveal animations */
    .reveal {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.7s ease-out, transform 0.7s ease-out;
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    .card-reveal {
      opacity: 0;
      transform: translateY(60px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .card-reveal.visible { opacity: 1; transform: translateY(0); }

    .hero-word {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
      display: inline-block;
      margin-right: 0.25em;
    }
    .hero-word.visible { opacity: 1; transform: translateY(0); }

    /* Marquee */
    .marquee-wrapper { overflow: hidden; background: var(--dark); }
    .marquee-row { display: flex; gap: 3rem; white-space: nowrap; }
    .marquee-row-1 { animation: marquee1 30s linear infinite; }
    .marquee-row-2 { animation: marquee2 45s linear infinite reverse; font-size: 0.85em; opacity: 0.7; }
    .marquee-item { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--white); display: flex; align-items: center; gap: 3rem; }
    .marquee-item::after { content: '·'; color: var(--teal); }

    @keyframes marquee1 { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    @keyframes marquee2 { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    /* Nav */
    .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; padding: 20px 0; transition: background 0.3s ease, backdrop-filter 0.3s ease; }
    .nav.scrolled { background: rgba(13, 26, 23, 0.95); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.05); }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    .nav-logo { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 1.1rem; color: var(--white); text-decoration: none; letter-spacing: -0.03em; }
    .nav-links { display: flex; gap: 2.5rem; }
    .nav-links a { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 400; font-size: 0.95rem; color: rgba(255,255,255,0.85); text-decoration: none; transition: color 0.2s; }
    .nav-links a:hover { color: var(--teal); }
    .nav-phone { font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: var(--teal); text-decoration: none; letter-spacing: 0.05em; }
    .nav-hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 8px; background: none; border: none; }
    .nav-hamburger span { width: 24px; height: 2px; background: var(--white); transition: all 0.3s; }
    .nav-mobile { display: none; position: fixed; top: 70px; left: 0; right: 0; background: var(--dark); padding: 24px; flex-direction: column; gap: 1.5rem; border-top: 1px solid rgba(255,255,255,0.1); }
    .nav-mobile.open { display: flex; }
    .nav-mobile a { color: var(--white); text-decoration: none; font-size: 1.1rem; font-family: 'Bricolage Grotesque', sans-serif; }

    @media (max-width: 768px) {
      .nav-links, .nav-phone { display: none; }
      .nav-hamburger { display: flex; }
    }

    /* Hero */
    .hero { position: relative; height: 100vh; min-height: 700px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
    .hero-fallback { position: absolute; inset: 0; background-image: url('/images/wfp-landing-hero.webp'); background-size: cover; background-position: center; z-index: 0; }
    .hero-overlay { position: absolute; inset: 0; background: rgba(13, 26, 23, 0.65); z-index: 1; }
    .hero-content { position: relative; z-index: 2; text-align: center; max-width: 900px; padding: 0 24px; }
    .hero-content .eyebrow { color: var(--teal); margin-bottom: 1.5rem; }
    .hero-h1 { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(2.5rem, 5vw, 5rem); letter-spacing: -0.04em; color: var(--white); line-height: 1.05; margin-bottom: 1.5rem; }
    .hero-subhead { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 300; font-size: 1.25rem; color: rgba(255,255,255,0.8); margin-bottom: 2.5rem; }
    .hero-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .hero-stats-bar { position: absolute; bottom: 0; left: 0; right: 0; z-index: 3; background: var(--dark); padding: 20px 24px; }
    .hero-stats-inner { max-width: 1200px; margin: 0 auto; display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap; }
    .hero-stat { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--white); display: flex; align-items: center; gap: 2rem; }
    .hero-stat::before { content: ''; }
    .hero-stat:first-child::before { display: none; }

    /* Services */
    .services { background: var(--canvas); padding: 120px 0; }
    .services-header { text-align: center; margin-bottom: 60px; }
    .services-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px; }
    .service-card { border-radius: 16px; padding: 48px; position: relative; overflow: hidden; }
    .service-card--teal { background: var(--teal); }
    .service-card--dark { background: var(--dark); }
    .service-card-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 1rem; }
    .service-card--teal .service-card-label { color: rgba(255,255,255,0.7); }
    .service-card--dark .service-card-label { color: var(--teal); }
    .service-card h3 { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 1.75rem; letter-spacing: -0.03em; margin-bottom: 1rem; }
    .service-card--teal h3 { color: var(--white); }
    .service-card--dark h3 { color: var(--white); }
    .service-card p { font-size: 0.95rem; line-height: 1.7; }
    .service-card--teal p { color: rgba(255,255,255,0.85); }
    .service-card--dark p { color: rgba(255,255,255,0.7); }
    .service-badge { margin-top: 2rem; }
    .service-badge-num { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 3rem; color: var(--white); line-height: 1; }
    .service-badge-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.6); margin-top: 0.25rem; }
    .service-card-img { position: absolute; bottom: 0; right: 0; width: 45%; height: 50%; object-fit: cover; border-radius: 16px 0 0 0; }
    .service-bullets { list-style: none; margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .service-bullets li { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--teal); padding-left: 1.5rem; position: relative; }
    .service-bullets li::before { content: '—'; position: absolute; left: 0; }

    .services-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .small-card { background: var(--white); border-radius: 16px; padding: 32px; box-shadow: 0 4px 24px rgba(0,0,0,0.06); transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .small-card:hover { transform: translateY(-4px); box-shadow: 0 8px 32px rgba(0,0,0,0.1); }
    .small-card-icon { width: 48px; height: 48px; background: rgba(110, 196, 176, 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; }
    .small-card-icon svg { width: 24px; height: 24px; color: var(--teal); }
    .small-card h4 { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 1.1rem; letter-spacing: -0.02em; margin-bottom: 0.75rem; color: var(--text-dark); }
    .small-card p { font-size: 0.9rem; color: rgba(13,26,23,0.7); line-height: 1.6; margin-bottom: 1.25rem; }
    .small-card a { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--teal); text-decoration: none; font-weight: 500; }
    .small-card a:hover { text-decoration: underline; }

    @media (max-width: 900px) {
      .services-grid-2 { grid-template-columns: 1fr; }
      .services-grid-3 { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 600px) {
      .services-grid-3 { grid-template-columns: 1fr; }
    }

    /* Before/After */
    .comparison { background: var(--white); padding: 120px 0; }
    .comparison-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
    .comparison-text p { font-size: 1.05rem; line-height: 1.8; color: rgba(13,26,23,0.8); margin-bottom: 1.5rem; }
    .comparison-slider { position: relative; border-radius: 16px; overflow: hidden; cursor: ew-resize; user-select: none; aspect-ratio: 4/3; }
    .comparison-slider img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .comparison-slider .img-after { clip-path: inset(0 50% 0 0); }
    .comparison-slider .img-before { filter: saturate(1.3) contrast(1.1) brightness(0.95); }
    .comparison-divider { position: absolute; top: 0; bottom: 0; left: 50%; width: 3px; background: var(--teal); transform: translateX(-50%); z-index: 5; }
    .comparison-handle { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 48px; height: 48px; background: var(--teal); border-radius: 50%; display: flex; align-items: center; justify-content: center; z-index: 6; box-shadow: 0 4px 16px rgba(0,0,0,0.3); }
    .comparison-handle svg { width: 20px; height: 20px; color: var(--white); }
    .comparison-label { position: absolute; bottom: 16px; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--white); background: rgba(13,26,23,0.7); padding: 6px 14px; border-radius: 9999px; z-index: 4; }
    .comparison-label--before { left: 16px; }
    .comparison-label--after { right: 16px; }
    .comparison-hint { text-align: center; margin-top: 1rem; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(13,26,23,0.5); }

    @media (max-width: 768px) {
      .comparison-grid { grid-template-columns: 1fr; gap: 40px; }
    }

    /* Stats */
    .stats { background: var(--dark); padding: 120px 0; }
    .stats-header { text-align: center; margin-bottom: 60px; }
    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .stat-card { background: var(--dark); border: 1px solid var(--border-subtle); border-radius: 16px; padding: 40px; text-align: center; }
    .stat-num { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(2.5rem, 4vw, 4rem); color: var(--teal); line-height: 1; margin-bottom: 0.5rem; }
    .stat-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.6); }

    @media (max-width: 768px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 480px) {
      .stats-grid { grid-template-columns: 1fr 1fr; }
    }

    /* Applications */
    .applications { background: var(--canvas); padding: 120px 0; }
    .applications-header { text-align: center; margin-bottom: 60px; }
    .apps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
    .app-card { position: relative; aspect-ratio: 4/3; border-radius: 12px; overflow: hidden; cursor: pointer; transition: transform 0.3s ease; }
    .app-card:hover { transform: scale(1.03); }
    .app-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .app-card-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(13,26,23,0.7) 0%, rgba(13,26,23,0.2) 50%, transparent 100%); }
    .app-card-label { position: absolute; bottom: 16px; left: 0; right: 0; text-align: center; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; font-size: 0.95rem; color: var(--white); }

    @media (max-width: 900px) { .apps-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 500px) { .apps-grid { grid-template-columns: 1fr; } }

    /* Brands */
    .brands { background: var(--white); padding: 80px 0; }
    .brands-header { text-align: center; margin-bottom: 40px; }
    .brands-pills { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
    .brand-pill { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(13,26,23,0.6); border: 1px solid var(--border-light); border-radius: 9999px; padding: 8px 20px; transition: all 0.2s; cursor: default; }
    .brand-pill:hover { border-color: var(--teal); color: var(--teal); }

    /* Testimonial */
    .testimonial { background: var(--dark); padding: 120px 0; }
    .testimonial-inner { max-width: 800px; margin: 0 auto; text-align: center; }
    .testimonial-quote-mark { font-family: 'Bricolage Grotesque', sans-serif; font-size: 6rem; color: var(--teal); line-height: 0.5; margin-bottom: 2rem; }
    .testimonial-text { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 300; font-size: clamp(1.1rem, 2vw, 1.4rem); color: var(--white); line-height: 1.7; margin-bottom: 2rem; }
    .testimonial-stars { display: flex; justify-content: center; gap: 4px; margin-bottom: 1.5rem; }
    .testimonial-stars svg { width: 20px; height: 20px; fill: var(--teal); }
    .testimonial-author { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.1em; color: rgba(255,255,255,0.6); }

    /* Quote Form */
    .quote-form-section { background: var(--canvas); padding: 120px 0; }
    .quote-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
    .quote-perks { list-style: none; display: flex; flex-direction: column; gap: 1rem; margin: 2rem 0 3rem; }
    .quote-perks li { display: flex; align-items: flex-start; gap: 1rem; font-size: 0.95rem; color: rgba(13,26,23,0.8); }
    .quote-perks li svg { width: 20px; height: 20px; color: var(--teal); flex-shrink: 0; margin-top: 2px; }
    .quote-photo { border-radius: 16px; overflow: hidden; margin-top: 2rem; }
    .quote-photo img { width: 100%; height: 280px; object-fit: cover; }
    .form-card { background: var(--white); border-radius: 20px; padding: 48px; box-shadow: 0 8px 40px rgba(0,0,0,0.08); }
    .form-group { margin-bottom: 1.25rem; }
    .form-group label { display: block; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(13,26,23,0.6); margin-bottom: 0.5rem; }
    .form-group input, .form-group select, .form-group textarea { width: 100%; font-family: 'Bricolage Grotesque', sans-serif; font-size: 0.95rem; border: 1px solid var(--border-light); border-radius: 12px; padding: 14px 18px; color: var(--text-dark); background: var(--white); transition: border-color 0.2s; outline: none; }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--teal); }
    .form-group textarea { resize: vertical; min-height: 120px; }
    .form-submit { width: 100%; background: var(--teal); color: var(--white); padding: 16px; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; font-size: 1rem; border: none; border-radius: 9999px; cursor: pointer; transition: background 0.25s; margin-top: 0.5rem; }
    .form-submit:hover { background: #5ab39d; }
    .form-note { text-align: center; margin-top: 1rem; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.08em; color: rgba(13,26,23,0.5); }

    @media (max-width: 768px) {
      .quote-grid { grid-template-columns: 1fr; gap: 40px; }
    }

    /* Footer */
    .footer { background: var(--dark); padding: 80px 0 0; }
    .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 60px; max-width: 1200px; margin: 0 auto; padding: 0 24px 60px; }
    .footer-brand-logo { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 1.2rem; color: var(--white); letter-spacing: -0.03em; margin-bottom: 1rem; }
    .footer-tagline { font-size: 0.9rem; color: rgba(255,255,255,0.6); line-height: 1.6; margin-bottom: 1.5rem; }
    .footer-contact-item { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; font-size: 0.9rem; }
    .footer-contact-item a { color: var(--teal); text-decoration: none; }
    .footer-contact-item a:hover { text-decoration: underline; }
    .footer h4 { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 0.9rem; letter-spacing: -0.01em; color: var(--white); margin-bottom: 1.25rem; }
    .footer-links { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
    .footer-links a { font-size: 0.85rem; color: rgba(255,255,255,0.6); text-decoration: none; transition: color 0.2s; }
    .footer-links a:hover { color: var(--teal); }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.08); padding: 24px; text-align: center; }
    .footer-bottom-inner { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.08em; color: rgba(255,255,255,0.3); }
    .footer-bottom-inner a { color: rgba(255,255,255,0.3); text-decoration: none; }
    .footer-bottom-inner a:hover { color: var(--teal); }

    @media (max-width: 900px) {
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 500px) {
      .footer-grid { grid-template-columns: 1fr; gap: 40px; }
      .footer-bottom-inner { flex-direction: column; gap: 0.5rem; }
    }

    /* Mobile CTA */
    .mobile-cta { display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 999; background: var(--dark); border-top: 1px solid var(--border-subtle); padding: 16px 20px; }
    .mobile-cta a { display: block; text-align: center; background: var(--teal); color: var(--white); padding: 14px; border-radius: 9999px; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; text-decoration: none; transition: background 0.2s; }
    .mobile-cta a:hover { background: #5ab39d; }

    @media (max-width: 768px) {
      .mobile-cta { display: block; }
      body { padding-bottom: 80px; }
    }
  </style>

  <!-- NAV -->
  <nav class="nav" id="mainNav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">Window Film Philadelphia</a>
      <div class="nav-links">
        <a href="#services">Services</a>
        <a href="#applications">Applications</a>
        <a href="#benefits">Benefits</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </div>
      <a href="tel:+12673947980" class="nav-phone">(267) 394-7980</a>
      <button class="nav-hamburger" id="hamburger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="nav-mobile" id="mobileMenu">
      <a href="#services">Services</a>
      <a href="#applications">Applications</a>
      <a href="#benefits">Benefits</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
      <a href="tel:+12673947980" style="color: var(--teal);">(267) 394-7980</a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <video class="hero-video" autoplay muted loop playsinline>
      <!-- VIDEO PLACEHOLDER: Add philly-hero.mp4 source here -->
    </video>
    <div class="hero-fallback"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="eyebrow">Scottish Window Solutions</p>
      <h1 class="hero-h1">
        <span class="hero-word">Philadelphia's</span>
        <span class="hero-word">glass,</span>
