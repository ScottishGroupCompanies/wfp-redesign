/* ─── HOW IT WORKS — 4 photo cards ─── */
/* ─── HOW IT WORKS — sticky scroll, 4 crossfade panels ─── */
/* ═════════════════════════════════════════════════════════════
   HOW IT WORKS — Horizontal Auto-Play Slideshow
═════════════════════════════════════════════════════════════ */

.hiw-slideshow {
  position: relative;
  width: 100%;
  min-height: 90vh;
  overflow: hidden;
  background: #14201A;
}

.hiw-slideshow__track {
  display: flex;
  width: 100%;
  height: 100%;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform;
}

.hiw-slideshow__slide {
  position: relative;
  min-width: 100%;
  min-height: 90vh;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.hiw-slideshow__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: 0;
}

.hiw-slideshow__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    rgba(0,0,0,0.75) 0%,
    rgba(0,0,0,0.2) 60%,
    transparent 100%
  );
  z-index: 1;
}

.hiw-slideshow__content {
  position: relative;
  z-index: 2;
  max-width: 560px;
  padding-left: 80px;
  color: #fff;
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.5s ease 0.1s, transform 0.5s ease 0.1s;
}

.hiw-slideshow__slide[data-slide="0"] .hiw-slideshow__content {
  opacity: 1;
  transform: translateY(0);
}

.hiw-slideshow__step {
  font-family: 'Space Mono', monospace;
  font-size: 13px;
  color: #7CB342;
  letter-spacing: 0.2em;
  margin-bottom: 1rem;
  opacity: 0;
  animation: fadeInUp 0.4s ease 0.2s forwards;
}

.hiw-slideshow__title {
  font-family: 'Playfair Display', serif;
  font-size: 52px;
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
  margin: 0 0 1.5rem;
  opacity: 0;
  animation: fadeInUp 0.4s ease 0.3s forwards;
}

.hiw-slideshow__desc {
  font-family: 'Inter', sans-serif;
  font-size: 16px;
  line-height: 1.8;
  color: rgba(255,255,255,0.85);
  max-width: 460px;
  margin-bottom: 2rem;
  opacity: 0;
  animation: fadeInUp 0.4s ease 0.4s forwards;
}

.hiw-slideshow__faq {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 2rem;
  opacity: 0;
  animation: fadeInUp 0.4s ease 0.5s forwards;
}

.hiw-slideshow__faq-item {
  border-radius: 8px;
  overflow: hidden;
}

.hiw-slideshow__faq-q {
  width: 100%;
  background: rgba(255,255,255,0.12);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 8px;
  color: rgba(255,255,255,0.88);
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  font-weight: 500;
  padding: 12px 16px;
  text-align: left;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  transition: background 0.2s ease;
}

.hiw-slideshow__faq-q:hover {
  background: rgba(255,255,255,0.18);
}

.hiw-slideshow__faq-icon {
  font-size: 1.2rem;
  color: #7CB342;
  flex-shrink: 0;
  font-style: normal;
  transition: transform 0.3s ease;
}

.hiw-slideshow__faq-q[aria-expanded="true"] .hiw-slideshow__faq-icon {
  transform: rotate(45deg);
}

.hiw-slideshow__faq-a {
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.10);
  border-top: none;
  border-radius: 0 0 8px 8px;
  color: rgba(255,255,255,0.70);
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  line-height: 1.6;
  padding: 12px 16px;
  margin-top: -4px;
}

.hiw-slideshow__cta {
  display: inline-block;
  background: #7CB342;
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  padding: 14px 32px;
  border-radius: 9999px;
  text-decoration: none;
  transition: background 0.25s ease, transform 0.2s ease;
  letter-spacing: 0.01em;
  opacity: 0;
  animation: fadeInUp 0.4s ease 0.6s forwards;
}

.hiw-slideshow__cta:hover {
  background: #2E6B30;
  transform: translateY(-2px);
}

/* Right side vertical nav */
.hiw-slideshow__nav {
  position: absolute;
  top: 50%;
  right: 48px;
  transform: translateY(-50%);
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.hiw-slideshow__nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
  opacity: 0.35;
  transition: opacity 0.3s ease;
}

.hiw-slideshow__nav-item:hover {
  opacity: 0.65;
}

.hiw-slideshow__nav-item--active {
  opacity: 1;
}

.hiw-slideshow__nav-line {
  display: block;
  width: 3px;
  height: 32px;
  background: rgba(255,255,255,0.4);
  border-radius: 2px;
  transition: background 0.3s ease, height 0.3s ease;
}

.hiw-slideshow__nav-item--active .hiw-slideshow__nav-line {
  background: #7CB342;
  height: 48px;
}

.hiw-slideshow__nav-label {
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  font-weight: 500;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  white-space: nowrap;
}

/* Navigation arrows */
.hiw-slideshow__arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: 48px;
  height: 48px;
  background: rgba(0,0,0,0.4);
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #fff;
  transition: background 0.3s ease, color 0.3s ease;
}

.hiw-slideshow__arrow:hover {
  background: rgba(0,0,0,0.6);
  color: #7CB342;
}

.hiw-slideshow__arrow--prev {
  left: 32px;
}

.hiw-slideshow__arrow--next {
  right: 32px;
}

/* Progress bar at bottom */
.hiw-slideshow__progress {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: rgba(255,255,255,0.15);
  z-index: 10;
}

.hiw-slideshow__progress-bar {
  height: 100%;
  background: #7CB342;
  width: 0;
  transition: width 0.05s linear;
}

/* Staggered content animation on slide change */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Active slide content animations */
.hiw-slideshow__slide.active .hiw-slideshow__content {
  opacity: 1;
  transform: translateY(0);
}

.hiw-slideshow__slide.active .hiw-slideshow__step {
  animation: fadeInUp 0.4s ease 0.2s forwards;
}

.hiw-slideshow__slide.active .hiw-slideshow__title {
  animation: fadeInUp 0.4s ease 0.3s forwards;
}

.hiw-slideshow__slide.active .hiw-slideshow__desc {
  animation: fadeInUp 0.4s ease 0.4s forwards;
}

.hiw-slideshow__slide.active .hiw-slideshow__faq {
  animation: fadeInUp 0.4s ease 0.5s forwards;
}

.hiw-slideshow__slide.active .hiw-slideshow__cta {
  animation: fadeInUp 0.4s ease 0.6s forwards;
}

/* Responsive */
@media (max-width: 1024px) {
  .hiw-slideshow__nav {
    right: 32px;
    gap: 20px;
  }
  .hiw-slideshow__content {
    padding-left: 60px;
  }
  .hiw-slideshow__title {
    font-size: 42px;
  }
}

@media (max-width: 768px) {
  .hiw-slideshow__nav {
    display: none;
  }
  .hiw-slideshow__content {
    padding-left: 40px;
    padding-right: 40px;
    max-width: calc(100% - 80px);
  }
  .hiw-slideshow__title {
    font-size: 36px;
  }
  .hiw-slideshow__arrow {
    width: 40px;
    height: 40px;
  }
  .hiw-slideshow__arrow--prev {
    left: 20px;
  }
  .hiw-slideshow__arrow--next {
    right: 20px;
  }
}

@media (max-width: 480px) {
  .hiw-slideshow__content {
    padding-left: 24px;
    padding-right: 24px;
    max-width: calc(100% - 48px);
  }
  .hiw-slideshow__title {
    font-size: 28px;
  }
  .hiw-slideshow__desc {
    font-size: 14px;
  }
  .hiw-slideshow__step {
    font-size: 11px;
  }
}

/* ─── BEFORE / AFTER SLIDER ─── */
.ba-section {
  background: var(--off-white);
  padding: 100px 0 80px;
}
.ba-section .eyebrow { text-align: center; display: block; margin-bottom: 1rem; }
.ba-section .section-h2 { text-align: center; margin-bottom: 3rem; }
.ba-slider {
  position: relative;
  max-width: 1000px;
  margin: 0 auto;
  aspect-ratio: 16/9;
  overflow: hidden;
  border-radius: 5px;
  cursor: ew-resize;
  user-select: none;
}
.ba-before,
.ba-after-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.ba-after {
  position: absolute;
  inset: 0;
  transition: clip-path 0.05s linear;
}
.ba-handle {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--green);
  cursor: ew-resize;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ba-handle::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: -12px;
  right: -12px;
}
.ba-handle__line {
  width: 3px;
  height: 100%;
  background: var(--green);
  position: absolute;
}
.ba-handle svg { position: relative; z-index: 1; }
.ba-label {
  position: absolute;
  bottom: 20px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #fff;
  background: rgba(42,36,30,0.6);
  padding: 6px 14px;
  border-radius: 100px;
  z-index: 5;
}
.ba-label--before { left: 20px; }
.ba-label--after { right: 20px; }


/* ─── HOW IT WORKS — bg image + steps + accordion ─── */
.hiw {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hiw__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.hiw__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: grayscale(20%) brightness(0.92);
}
.hiw__bg-overlay {
  position: absolute;
  inset: 0;
  background: rgba(240,244,240,0.82);
}

.hiw__inner {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 7rem 5vw;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rem;
  align-items: start;
}

/* Left: heading + accordion */
.hiw__heading { margin-bottom: 2.5rem; }
.hiw__title {
  font-family: var(--font-serif, 'Fraunces', serif);
  font-weight: 700;
  font-size: clamp(2.4rem, 3.8vw, 4rem);
  color: #2A241E;
  letter-spacing: -0.025em;
  line-height: 1.1;
  margin-bottom: 1rem;
}
.hiw__sub {
  font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
  font-size: 1rem;
  font-weight: 300;
  color: #6E665C;
  line-height: 1.65;
  max-width: 420px;
}

/* Accordion */
.hiw__accordion {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.hiw__acc-item {
  background: rgba(255,255,255,0.72);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(42,36,30,0.08);
  border-radius: 12px;
  overflow: hidden;
}
.hiw__acc-trigger {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.1rem 1.4rem;
  background: none;
  border: none;
  cursor: pointer;
  font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
  font-size: 0.9rem;
  font-weight: 600;
  color: #2A241E;
  text-align: left;
  gap: 1rem;
}
.hiw__acc-trigger span:first-child { flex: 1; }
.hiw__acc-icon {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  background: rgba(42,36,30,0.08);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2A241E;
  transition: transform 0.25s ease, background 0.2s;
}
.hiw__acc-item.is-open .hiw__acc-icon {
  transform: rotate(45deg);
  background: var(--green, #4E6B2A);
  color: #fff;
}
.hiw__acc-body {
  padding: 0 1.4rem 1.2rem;
  font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
  font-size: 0.875rem;
  font-weight: 300;
  color: #6E665C;
  line-height: 1.7;
}
.hiw__acc-body p { margin: 0; }

/* Right: numbered steps */
.hiw__steps {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0;
  padding-top: 2rem;
}
.hiw__step {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 1.2rem;
  padding: 1.1rem 0;
  border-bottom: 1px solid rgba(42,36,30,0.10);
}
.hiw__step:first-child { border-top: 1px solid rgba(42,36,30,0.10); }
.hiw__step-num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 1.1rem;
  font-weight: 400;
  color: rgba(42,36,30,0.25);
  flex-shrink: 0;
  letter-spacing: 0.05em;
}
.hiw__step-text {
  font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
  font-size: 1.1rem;
  font-weight: 300;
  color: rgba(42,36,30,0.45);
  text-align: right;
}
.hiw__step-text--active {
  font-weight: 700;
  color: #2A241E;
}

@media (max-width: 900px) {
  .hiw__inner {
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 5rem 6vw;
  }
  .hiw__steps { padding-top: 0; }
  .hiw__step { justify-content: flex-start; gap: 1rem; }
  .hiw__step-text { text-align: left; }
  .hiw__step-num { font-size: 0.9rem; }
}


