---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Window Film Philadelphia — Scottish Window Solutions";
const description = "Professional window film installation in Philadelphia and the Delaware Valley. UV protection, energy savings, safety & security, and decorative film for homes and businesses.";

// Hero comparison — same image, left side shows "untreated" treatment
const heroBefore = "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203051_9e201b35-80e5-4e3d-bc85-32561bb9d0ee.png";
const heroAfter = "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203051_9e201b35-80e5-4e3d-bc85-32561bb9d0ee.png";

const stats = [
  { label: "Heat Rejected", value: 78, display: "78%" },
  { label: "Glare Cut", value: 62, display: "62%" },
  { label: "UV Blocked", value: 99, display: "99%" },
];

const services = [
  { title: "Energy Savings", desc: "Cut cooling costs up to 30% with heat-rejecting window film. Most clients see payback in under 3 years.", img: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203053_b846664d-a70e-442d-833b-4267bf184a18.png", stat: "30%", statLabel: "Cooling Cut", href: "/benefits/energy-savings/" },
  { title: "UV Protection", desc: "Block 99.9% of harmful UV rays that fade furniture, damage skin, and overheat interiors.", img: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203056_43daeb3e-3501-4a9c-8e55-14df1c103bbd.png", stat: "99.9%", statLabel: "UV Blocked", href: "/benefits/uv-blocking/" },
  { title: "Safety & Security", desc: "Hold glass together on impact. Delay intruders. Buy precious minutes in any emergency.", img: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203058_7ea2c065-74e1-4ca1-80be-bae2fec0e6af.png", stat: "4–15", statLabel: "Mil Range", href: "/benefits/safety-and-security/" },
  { title: "Privacy & Decorative", desc: "Transform glass into frosted privacy panels, brand graphics, or custom decorative designs.", img: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203100_6704eb3d-7f96-439b-a760-c0a7097bf459.png", stat: "100%", statLabel: "Custom", href: "/benefits/decorative-promotional/" },
];

const applications = [
  { label: "Homes", icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>`, href: "/applications/residential/", img: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203058_7ea2c065-74e1-4ca1-80be-bae2fec0e6af.png" },
  { label: "Offices", icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21"/></svg>`, href: "/applications/commercial/", img: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203053_b846664d-a70e-442d-833b-4267bf184a18.png" },
  { label: "Retail", icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z"/></svg>`, href: "/applications/retail/", img: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203100_6704eb3d-7f96-439b-a760-c0a7097bf459.png" },
  { label: "Healthcare", icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12.75 9 12.75s9-5.53 9-12.75z"/></svg>`, href: "/applications/healthcare/", img: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203101_282a9879-8679-4e33-b8b3-b10a4dffdf38.png" },
  { label: "Government", icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z"/></svg>`, href: "/government-buildings/", img: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203056_43daeb3e-3501-4a9c-8e55-14df1c103bbd.png" },
  { label: "Schools", icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-13.5 0A48.369 48.369 0 006.75 15.75"/></svg>`, href: "/benefits/school-security-window-film/", img: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203058_7ea2c065-74e1-4ca1-80be-bae2fec0e6af.png" },
  { label: "Industrial", icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21"/></svg>`, href: "/applications/industrial/", img: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203101_282a9879-8679-4e33-b8b3-b10a4dffdf38.png" },
  { label: "Automotive", icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>`, href: "/applications/automotive/", img: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203100_6704eb3d-7f96-439b-a760-c0a7097bf459.png" },
];

const benefits = [
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>`, title: "Heat & Energy", desc: "Reject up to 78% of solar heat, cut cooling costs, and reduce hotspots in any room." },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`, title: "Glare Reduction", desc: "Cut glare up to 62% and eliminate eye strain without blocking your view." },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 12c0 6.627 5.373 12 12 12s12-5.373 12-12c0-2.157-.574-4.18-1.591-5.914z"/></svg>`, title: "UV Protection", desc: "Block 99.9% of harmful UV rays. Protect furniture, flooring, art, and skin." },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>`, title: "Privacy & Frost", desc: "Frosted, tinted, or decorative film. Privacy without sacrificing natural light." },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 12c0 6.627 5.373 12 12 12s12-5.373 12-12c0-2.157-.574-4.18-1.591-5.914z"/></svg>`, title: "Safety & Security", desc: "Hold glass together on impact, delay intruders, and buy critical time in emergencies." },
  { icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.238-1.923l-3.876 5.814a15.995 15.995 0 01-4.764 4.648z"/></svg>`, title: "Decorative & Brand", desc: "Custom graphics, branding, and decorative designs for storefronts and interiors." },
];

const testimonials = [
  { stars: "★★★★★", text: "Our electric bills dropped 28% the first summer after the window film was installed. The crew was professional, on time, and the install was spotless.", author: "Mike T., Fishtown" },
  { stars: "★★★★★", text: "We needed anti-graffiti film on our transit facility. Scottish handled the whole job in one weekend with zero disruption to service. Highly recommend.", author: "SEPTA Facility Manager" },
  { stars: "★★★★★", text: "The decorative frosted film on our conference rooms is absolutely stunning. Clients comment on it every time.", author: "Sarah K., King of Prussia" },
];

const trustItems = [
  { label: "Local Experts", sub: "Serving Philly 18+ years" },
  { label: "3M Authorized", sub: "Certified dealer" },
  { label: "Lifetime Warranty", sub: "On all work" },
];
---

<BaseLayout title={title} description={description}>
  <Header />

  <!-- ═══ HERO — SPLIT COMPARISON ═══ -->
  <section class="hero">
    <div class="hero__layout">
      <!-- Left: Text -->
      <div class="hero__text">
        <div class="hero__badge reveal-in">
          <span class="badge-dot"></span>
          Philadelphia's Trusted Window Film Company
        </div>
        <h1 class="hero__title reveal-in delay-1">
          See the difference<br />
          <span class="accent">window film makes</span>
        </h1>
        <p class="hero__sub reveal-in delay-2">
          Energy savings. UV protection. Safety & security.<br />
          Decorative style. Done right, every time.
        </p>
        <div class="hero__ctas reveal-in delay-3">
          <a href="/contact/" class="btn btn--primary btn--lg">
            Get a Free Quote
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
          </a>
          <a href="/process/" class="btn btn--outline btn--lg">Our Process</a>
        </div>
        <div class="hero__trust reveal-in delay-4">
          {trustItems.map(t => (
            <div class="trust-chip">
              <span class="trust-chip__label">{t.label}</span>
              <span class="trust-chip__sub">{t.sub}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Before/After Comparison -->
      <div class="hero__compare reveal-in delay-2">
        <div class="compare" id="compareSlider">
          <!-- After (right) — treated side -->
          <div class="compare__after">
            <img src={heroAfter} alt="With window film — cooler, clearer" class="compare__img" width="700" height="500" />
            <div class="compare__label compare__label--after">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75"/></svg>
              With Film
            </div>
          </div>
          <!-- Before (left) — untreated side with overlay -->
          <div class="compare__before" id="compareBefore">
            <img src={heroBefore} alt="Untreated glass — harsh glare" class="compare__img" width="700" height="500" />
            <div class="compare__label compare__label--before">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
              Untreated
            </div>
          </div>
          <!-- Divider line with handle -->
          <div class="compare__divider" id="compareDivider">
            <div class="compare__handle">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 15L12 18.75 15.75 15m-7.5-6L12 5.25 15.75 9"/></svg>
            </div>
          </div>
        </div>
        <!-- Stats below comparison -->
        <div class="compare__stats">
          {stats.map(s => (
            <div class="prog-stat">
              <div class="prog-stat__head">
                <span class="prog-stat__label">{s.label}</span>
                <span class="prog-stat__val">{s.display}</span>
              </div>
              <div class="prog-stat__bar">
                <div class="prog-stat__fill" data-width={s.value}></div>
              </div>
            </div>
          ))}
        </div>
        <div class="compare__hint">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3"/></svg>
          Drag to compare
        </div>
      </div>
    </div>
    <!-- Scroll indicator -->
    <div class="hero__scroll reveal-in delay-4">
      <div class="hero__scroll-line"></div>
    </div>
  </section>

  <!-- ═══ SERVICES ═══ -->
  <section class="services">
    <div class="services__hd reveal-up">
      <span class="eyebrow">What We Do</span>
      <h2 class="section-title">Powerful benefits.<br/>Real results.</h2>
    </div>
    <div class="services__grid">
      {services.map((s, i) => (
        <a href={s.href} class={`svc-card reveal-up delay-${i}`}>
          <div class="svc-card__img">
            <img src={s.img} alt={s.title} width="600" height="420" loading="lazy" />
          </div>
          <div class="svc-card__body">
            <div class="svc-card__stat">
              <span class="svc-card__stat-val">{s.stat}</span>
              <span class="svc-card__stat-label">{s.statLabel}</span>
            </div>
            <h3 class="svc-card__title">{s.title}</h3>
            <p class="svc-card__desc">{s.desc}</p>
            <div class="svc-card__cta">
              Learn More
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ STATS BANNER ═══ -->
  <section class="stats-banner">
    <div class="stats-banner__inner">
      {[
        { num: "99%", label: "UV Blocked" },
        { num: "78%", label: "Heat Rejected" },
        { num: "18+", label: "Years in Philly" },
        { num: "2,400+", label: "Projects Done" },
        { num: "4.9★", label: "Google Rating" },
      ].map((s, i) => (
        <div class={`stats-banner__item reveal-up delay-${i}`}>
          <span class="stats-banner__num">{s.num}</span>
          <span class="stats-banner__label">{s.label}</span>
        </div>
      ))}
    </div>
    <div class="stats-banner__tag">
      REAL RESULTS · LOCAL EXPERTS · PREMIUM FILM · LIFETIME WARRANTY
    </div>
  </section>

  <!-- ═══ EVERY SPACE ═══ -->
  <section class="spaces">
    <div class="spaces__hd reveal-up">
      <span class="eyebrow">Applications</span>
      <h2 class="section-title">Window film for<br/>every space</h2>
    </div>
    <div class="spaces__grid">
      {applications.map((app, i) => (
        <a href={app.href} class={`space-card reveal-up delay-${i % 4}`}>
          <div class="space-card__img">
            <img src={app.img} alt={app.label} width="400" height="280" loading="lazy" />
            <div class="space-card__overlay"></div>
          </div>
          <div class="space-card__body">
            <div class="space-card__icon" set:html={app.icon} />
            <span class="space-card__label">{app.label}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ BENEFITS GRID ═══ -->
  <section class="benefits">
    <div class="benefits__inner">
      <div class="benefits__text reveal-up">
        <span class="eyebrow">Why Window Film?</span>
        <h2 class="section-title">One upgrade.<br/>Six benefits.</h2>
        <p class="benefits__sub">A single window film installation solves heat, glare, UV, privacy, safety, and style — all at once.</p>
        <a href="/contact/" class="btn btn--primary btn--lg">Get a Free Assessment</a>
      </div>
      <div class="benefits__grid">
        {benefits.map((b, i) => (
          <div class={`benefit-card reveal-up delay-${i % 3}`}>
            <div class="benefit-card__icon" set:html={b.icon} />
            <h3 class="benefit-card__title">{b.title}</h3>
            <p class="benefit-card__desc">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="testimonials">
    <div class="testimonials__hd reveal-up">
      <span class="eyebrow">What Clients Say</span>
      <h2 class="section-title">Philadelphia trusts us</h2>
    </div>
    <div class="testimonials__grid">
      {testimonials.map((t, i) => (
