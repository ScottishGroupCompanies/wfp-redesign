---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Window Film Philadelphia — Scottish Window Solutions";
const description = "Professional window film installation in Philadelphia and the Delaware Valley. UV protection, energy savings, safety & security, and decorative film for homes and businesses.";

const heroImg = "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203051_9e201b35-80e5-4e3d-bc85-32561bb9d0ee.png";
const featuredImages = {
  commercial: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203053_b846664d-a70e-442d-833b-4267bf184a18.png",
  residential: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203056_43daeb3e-3501-4a9c-8e55-14df1c103bbd.png",
  trust: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203058_7ea2c065-74e1-4ca1-80be-bae2fec0e6af.png",
  retail: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203100_6704eb3d-7f96-439b-a760-c0a7097bf459.png",
  industrial: "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203101_282a9879-8679-4e33-b8b3-b10a4dffdf38.png",
};

const stats = [
  { value: "18", suffix: "+", label: "Years Experience", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>` },
  { value: "2,400", suffix: "+", label: "Projects Completed", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 12c0 6.627 5.373 12 12 12s12-5.373 12-12c0-2.157-.574-4.18-1.591-5.914z"/></svg>` },
  { value: "99.9", suffix: "%", label: "UV Block Rate", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>` },
  { value: "4.9", suffix: "★", label: "Google Rating", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>` },
];

const services = [
  {
    title: "Energy Savings",
    desc: "Cut cooling costs up to 30% with heat-rejecting window film. Most clients see payback in under 3 years.",
    img: featuredImages.commercial,
    alt: "Philadelphia commercial building with energy-efficient window film",
    href: "/benefits/energy-savings/",
    stat: "30%",
    statLabel: "Cooling Cost Cut",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>`,
  },
  {
    title: "UV Protection",
    desc: "Block 99.9% of harmful UV rays that fade furniture, damage skin, and heat up interiors.",
    img: featuredImages.residential,
    alt: "Philadelphia home interior with UV-blocking window film",
    href: "/benefits/uv-blocking/",
    stat: "99.9%",
    statLabel: "UV Blocked",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>`,
  },
  {
    title: "Safety & Security",
    desc: "Hold glass together on impact. Delay intruders. Buy precious minutes in any emergency.",
    img: featuredImages.trust,
    alt: "Security window film protecting Philadelphia commercial building",
    href: "/benefits/safety-and-security/",
    stat: "4–15",
    statLabel: "Mil Thickness",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 12c0 6.627 5.373 12 12 12s12-5.373 12-12c0-2.157-.574-4.18-1.591-5.914z"/></svg>`,
  },
  {
    title: "Privacy & Decorative",
    desc: "Transform plain glass into frosted privacy panels, brand graphics, or custom decorative designs.",
    img: featuredImages.retail,
    alt: "Decorative window film on Philadelphia retail storefront",
    href: "/benefits/decorative-promotional/",
    stat: "100%",
    statLabel: "Customizable",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.238-1.923l-3.876 5.814a15.995 15.995 0 01-4.764 4.648z"/></svg>`,
  },
];

const applications = [
  { label: "Homes", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>`, href: "/applications/residential/" },
  { label: "Offices", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m0 0v9m0-9H3"/></svg>`, href: "/applications/commercial/" },
  { label: "Retail", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>`, href: "/applications/retail/" },
  { label: "Healthcare", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12.75 9 12.75s9-5.53 9-12.75z"/></svg>`, href: "/applications/healthcare/" },
  { label: "Government", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z"/></svg>`, href: "/government-buildings/" },
  { label: "Schools", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-13.5 0A48.369 48.369 0 006.75 15.75"/></svg>`, href: "/benefits/school-security-window-film/" },
  { label: "Industrial", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21"/></svg>`, href: "/applications/industrial/" },
  { label: "Automotive", icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>`, href: "/applications/automotive/" },
];

const testimonials = [
  { stars: "★★★★★", text: "Our electric bills dropped 28% the first summer after the window film was installed. The crew was professional, on time, and the install was spotless.", author: "Mike T., Fishtown" },
  { stars: "★★★★★", text: "We needed anti-graffiti film on our transit facility. Scottish handled the whole job in one weekend with zero disruption to service. Highly recommend.", author: "SEPTA Facility Manager" },
  { stars: "★★★★★", text: "The decorative frosted film on our conference rooms is absolutely stunning. Clients comment on it every time. Worth every penny.", author: "Sarah K., King of Prussia" },
];
---

<BaseLayout title={title} description={description}>
  <Header />

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero__bg">
      <img src={heroImg} alt="Philadelphia skyline at golden hour" class="hero__bg-img" width="1440" height="800" />
      <div class="hero__bg-overlay"></div>
      <!-- Floating geometric shapes -->
      <div class="hero__shape hero__shape--1"></div>
      <div class="hero__shape hero__shape--2"></div>
      <div class="hero__shape hero__shape--3"></div>
    </div>
    <div class="hero__content">
      <div class="hero__badge animate-in">
        <span class="hero__badge-dot"></span>
        <span>Philadelphia's Trusted Window Film Company</span>
      </div>
      <h1 class="hero__title animate-in delay-1">
        <span class="hero__title-line">Window Film</span>
        <span class="hero__title-line hero__title-accent">Philadelphia</span>
        <span class="hero__title-line">Depends On</span>
      </h1>
      <p class="hero__sub animate-in delay-2">
        Energy savings · UV protection · Safety & security<br />
        Decorative style · Done right, every time
      </p>
      <div class="hero__ctas animate-in delay-3">
        <a href="/contact/" class="btn btn--primary btn--lg">
          Get a Free Quote
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
        </a>
        <a href="/process/" class="btn btn--ghost btn--lg">
          Our Process
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
        </a>
      </div>
    </div>
    <!-- Scroll indicator -->
    <div class="hero__scroll animate-in delay-4">
      <span>Scroll</span>
      <div class="hero__scroll-line"></div>
    </div>
  </section>

  <!-- ═══ STATS ═══ -->
  <section class="stats">
    <div class="stats__grid">
      {stats.map((s, i) => (
        <div class={`stat-card reveal-up delay-${i}`}>
          <div class="stat-card__icon" set:html={s.icon} />
          <div class="stat-card__num" data-target={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</div>
          <div class="stat-card__label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ TRUST STRIP ═══ -->
  <section class="trust">
    <div class="trust__inner">
      <div class="trust__item reveal-up">
        <div class="trust__item-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 12c0 6.627 5.373 12 12 12s12-5.373 12-12c0-2.157-.574-4.18-1.591-5.914z"/></svg>
        </div>
        <div>
          <strong>3M Authorized Dealer</strong>
          <span>Certified window film installation</span>
        </div>
      </div>
      <div class="trust__divider"></div>
      <div class="trust__item reveal-up delay-1">
        <div class="trust__item-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 12c0 6.627 5.373 12 12 12s12-5.373 12-12c0-2.157-.574-4.18-1.591-5.914z"/></svg>
        </div>
        <div>
          <strong>Lifetime Warranty</strong>
          <span>On materials and labor</span>
        </div>
      </div>
      <div class="trust__divider"></div>
      <div class="trust__item reveal-up delay-2">
        <div class="trust__item-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 12c0 6.627 5.373 12 12 12s12-5.373 12-12c0-2.157-.574-4.18-1.591-5.914z"/></svg>
        </div>
        <div>
          <strong>Free Consultations</strong>
          <span>On-site or virtual</span>
        </div>
      </div>
      <div class="trust__divider"></div>
      <div class="trust__item reveal-up delay-3">
        <div class="trust__item-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 12c0 6.627 5.373 12 12 12s12-5.373 12-12c0-2.157-.574-4.18-1.591-5.914z"/></svg>
        </div>
        <div>
          <strong>18+ Years Serving Philly</strong>
          <span>Local team, local knowledge</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SERVICES ═══ -->
  <section class="services">
    <div class="services__hd">
      <span class="eyebrow reveal-up">What We Do</span>
      <h2 class="services__title reveal-up delay-1">Window film solutions<br/>for every need</h2>
    </div>
    <div class="services__grid">
      {services.map((s, i) => (
        <a href={s.href} class={`svc-card reveal-up delay-${i % 4}`}>
          <div class="svc-card__img">
            <img src={s.img} alt={s.alt} width="600" height="420" loading="lazy" />
            <div class="svc-card__img-overlay"></div>
          </div>
          <div class="svc-card__body">
            <div class="svc-card__icon" set:html={s.icon} />
            <h3 class="svc-card__title">{s.title}</h3>
            <p class="svc-card__desc">{s.desc}</p>
            <div class="svc-card__stat">
              <span class="svc-card__stat-val">{s.stat}</span>
              <span class="svc-card__stat-label">{s.statLabel}</span>
            </div>
            <div class="svc-card__cta">
              Learn More
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ MISSION ═══ -->
  <section class="mission">
    <div class="mission__bg-shape"></div>
    <div class="mission__inner">
      <div class="mission__text reveal-up">
        <span class="eyebrow eyebrow--light">Our Story</span>
        <h2 class="mission__title">Philadelphia's trusted<br/><em>window film contractor</em></h2>
        <p class="mission__body">Scottish Window Solutions has served the Philadelphia region for over 18 years. We've transformed thousands of homes and commercial spaces with professional window film — from Center City high-rises to suburban family homes.</p>
        <p class="mission__body">As a 3M Authorized Dealer, we bring world-class products and certified installation to every project, backed by industry-leading warranties.</p>
        <div class="mission__btns">
          <a href="/about/" class="btn btn--outline-green btn--lg">About Us</a>
          <a href="/contact/" class="btn btn--text btn--lg">Get a Free Quote →</a>
        </div>
      </div>
      <div class="mission__cards">
        {[
          { num: "18+", label: "Years in Business" },
          { num: "2,400+", label: "Projects Completed" },
          { num: "3M", label: "Authorized Dealer" },
          { num: "4.9★", label: "Google Rating" },
        ].map((c, i) => (
          <div class={`mission-card reveal-up delay-${i}`}>
            <span class="mission-card__num">{c.num}</span>
            <span class="mission-card__label">{c.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ APPLICATIONS ═══ -->
  <section class="apps">
    <div class="apps__hd">
      <span class="eyebrow reveal-up">Applications</span>
      <h2 class="apps__title reveal-up delay-1">Window film for every space</h2>
    </div>
    <div class="apps__grid">
      {applications.map((app, i) => (
        <a href={app.href} class={`app-card reveal-up delay-${i % 4}`}>
          <div class="app-card__icon" set:html={app.icon} />
          <span class="app-card__label">{app.label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="testimonials">
    <div class="testimonials__hd">
      <span class="eyebrow reveal-up">What Clients Say</span>
      <h2 class="testimonials__title reveal-up delay-1">Philadelphia trusts us</h2>
    </div>
    <div class="testimonials__grid">
      {testimonials.map((t, i) => (
        <div class={`testi-card reveal-up delay-${i}`}>
