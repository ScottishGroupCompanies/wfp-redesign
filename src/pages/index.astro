<script>
  // ── Scroll reveal ──
  const observer = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal-up').forEach(el => observer.observe(el));

  // ── Before/After Comparison Slider ──
  const compare = document.getElementById('compareSlider');
  const before = document.getElementById('compareBefore');
  const divider = document.getElementById('compareDivider');

  if (compare && before && divider) {
    let isDragging = false;
    let startX = 0;
    let currentPos = 50;

    function setClip(x) {
      const rect = compare.getBoundingClientRect();
      const pct = Math.max(0, Math.min(100, ((x - rect.left) / rect.width) * 100));
      currentPos = pct;
      before.style.clipPath = `inset(0 ${100 - pct}% 0 0)`;
      divider.style.left = pct + '%';
    }

    divider.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX;
      e.preventDefault();
    });
    compare.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX;
      setClip(e.clientX);
    });
    window.addEventListener('mousemove', (e) => {
      if (isDragging) setClip(e.clientX);
    });
    window.addEventListener('mouseup', () => { isDragging = false; });

    // Touch support
    divider.addEventListener('touchstart', (e) => {
      isDragging = true;
      startX = e.touches[0].clientX;
    });
    compare.addEventListener('touchmove', (e) => {
      if (isDragging) setClip(e.touches[0].clientX);
    });
    window.addEventListener('touchend', () => { isDragging = false; });
  }

  // ── Animated progress bars on scroll ──
  const progObserver = new IntersectionObserver(
    entries => entries.forEach(e => {
      if (e.isIntersecting) {
        const fill = e.target;
        const width = fill.dataset.width;
        fill.style.width = width + '%';
        progObserver.unobserve(fill);
      }
    }),
    { threshold: 0.5 }
  );
  document.querySelectorAll('.prog-stat__fill').forEach(el => progObserver.observe(el));
</script>