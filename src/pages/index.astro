<script>
// ── Hero word stagger on load ──
window.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.hero-word').forEach((word, i) => {
    word.style.transitionDelay = (i * 80) + 'ms';
    setTimeout(() => word.classList.add('visible'), 50);
  });
});

// ── Scroll reveal ──
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      const el = entry.target;
      const delay = el.dataset.delay || 0;
      setTimeout(() => el.classList.add('visible'), delay);
      observer.unobserve(el);
    }
  });
}, { threshold: 0.15 });

document.querySelectorAll('.scroll-reveal').forEach((el, i) => {
  el.dataset.delay = (i % 4) * 100;
  observer.observe(el);
});

// ── Trust strip — framer-motion infinite slider ──
(function () {
  const track = document.getElementById('wwdSlider');
  if (!track) return;
  const half = track.scrollWidth / 2;
  let pos = 0;
  const duration = 40;
  let startTime = null;
  let paused = false;

  function tick(ts) {
    if (!startTime) startTime = ts;
    if (!paused) {
      const elapsed = ts - startTime;
      pos = (elapsed / 1000 / duration) * half * -1;
      const loopPos = ((pos % half) + half) % half;
      track.style.transform = `translateX(-${loopPos}px)`;
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);

  track.addEventListener('mouseenter', () => { paused = true; });
  track.addEventListener('mouseleave', () => {
    paused = false;
    startTime = performance.now() - (Math.abs(pos % half) / half) * duration * 1000;
  });
})();

// ── Stats counter animation ──
const statsObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.querySelectorAll('[data-count]').forEach(el => {
        const target = parseInt(el.dataset.count);
        const suffix = el.dataset.suffix || '';
        let current = 0;
        const step = target / 60;
        const timer = setInterval(() => {
          current = Math.min(current + step, target);
          el.textContent = Math.round(current) + suffix;
          if (current >= target) clearInterval(timer);
        }, 30);
      });
      statsObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.3 });
const statsGrid = document.querySelector('.stats-grid');
if (statsGrid) statsObserver.observe(statsGrid);

// ── Before / After slider ──
const slider = document.querySelector('.ba-slider');
if (slider) {
  const handle = document.getElementById('baHandle');
  const after = slider.querySelector('.ba-after');
  let isDragging = false;
  const update = (x) => {
    const rect = slider.getBoundingClientRect();
    const pct = Math.max(0, Math.min(100, ((x - rect.left) / rect.width) * 100));
    after.style.clipPath = `inset(0 ${100 - pct}% 0 0)`;
    handle.style.left = pct + '%';
  };
  slider.addEventListener('pointerdown', (e) => { isDragging = true; slider.setPointerCapture(e.pointerId); });
  slider.addEventListener('pointermove', (e) => { if (isDragging) update(e.clientX); });
  slider.addEventListener('pointerup', () => { isDragging = false; });
  // Touch support
  slider.addEventListener('touchmove', (e) => { if (isDragging) update(e.touches[0].clientX); }, { passive: true });
}

// ── Hero word stagger on load ──
const words = document.querySelectorAll('.hero-word');
words.forEach((word, i) => {
  setTimeout(() => word.classList.add('visible'), 80 + i * 110);
});


// ── FAQ accordion ──
document.querySelectorAll('[data-acc]').forEach(item => {
  item.addEventListener('acc:toggle', () => {
    const isOpen = item.classList.contains('is-open');
    // close all
    document.querySelectorAll('[data-acc]').forEach(i => {
      i.classList.remove('is-open');
      i.querySelector('.hiw__acc-body').hidden = true;
      i.querySelector('.hiw__acc-trigger').setAttribute('aria-expanded', 'false');
    });
    // open clicked if it was closed
    if (!isOpen) {
      item.classList.add('is-open');
      item.querySelector('.hiw__acc-body').hidden = false;
      item.querySelector('.hiw__acc-trigger').setAttribute('aria-expanded', 'true');
    }
  });

  item.querySelector('.hiw__acc-trigger').addEventListener('click', () => {
    item.dispatchEvent(new Event('acc:toggle'));
  });
});


// ── What We Do: scroll-driven horizontal carousel ──
(function () {
  const track = document.getElementById('wwdTrack');
  const dotsContainer = document.getElementById('wwdDots');
  const hint = document.getElementById('wwdScrollHint');
  if (!track || !dotsContainer) return;

  const cards = track.querySelectorAll('.wwd__card');
  const NUM = cards.length;
  const CARD_GAP = 32;
  const CARD_WIDTH = 360 + CARD_GAP;

  // Build dots
  const dots = [];
  for (let i = 0; i < NUM; i++) {
    const d = document.createElement('div');
    d.className = 'wwd__dot' + (i === 0 ? ' active' : '');
    d.addEventListener('click', () => scrollToCard(i));
    dotsContainer.appendChild(d);
    dots.push(d);
  }

  function scrollToCard(idx) {
    const max = track.scrollWidth - track.parentElement.clientWidth;
    const target = Math.min(idx * CARD_WIDTH, max);
    track.parentElement.scrollTo({ left: target, behavior: 'smooth' });
  }

  // Update active dot on scroll
  function updateDots() {
    const container = track.parentElement;
    const scrollLeft = container.scrollLeft;
    const maxScroll = track.scrollWidth - container.clientWidth;
    const progress = maxScroll > 0 ? scrollLeft / maxScroll : 0;
    const activeIdx = Math.round(progress * (NUM - 1));
    dots.forEach((d, i) => d.classList.toggle('active', i === activeIdx));
    // Hide hint once scrolled
    if (hint) hint.style.opacity = progress > 0.05 ? '0' : '1';
  }

  track.parentElement.addEventListener('scroll', updateDots, { passive: true });
  updateDots();

  // Wheel → horizontal scroll
  track.parentElement.addEventListener('wheel', (e) => {
    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
      e.preventDefault();
      track.parentElement.scrollLeft += e.deltaY * 1.2;
    }
  }, { passive: false });

  // Drag to scroll
  let isDragging = false, startX = 0, startScrollLeft = 0;
  track.parentElement.addEventListener('mousedown', (e) => {
    isDragging = true;
    startX = e.pageX - track.parentElement.offsetLeft;
    startScrollLeft = track.parentElement.scrollLeft;
  });
  window.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    e.preventDefault();
    const x = e.pageX - track.parentElement.offsetLeft;
    track.parentElement.scrollLeft = startScrollLeft - (x - startX) * 1.5;
  });
  window.addEventListener('mouseup', () => { isDragging = false; });

  // Touch
  let tStartX = 0;
  track.parentElement.addEventListener('touchstart', (e) => {
    tStartX = e.touches[0].pageX;
  }, { passive: true });
  track.parentElement.addEventListener('touchmove', (e) => {
    const dx = tStartX - e.touches[0].pageX;
    tStartX = e.touches[0].pageX;
    track.parentElement.scrollLeft += dx;
  }, { passive: true });
})();

// ── How It Works — horizontal auto-play slideshow + arrows + nav + progress ──
window.addEventListener('DOMContentLoaded', () => {
  const track = document.getElementById('hiwTrack');
  const slides = document.querySelectorAll('.hiw-slideshow__slide');
  const navItems = document.querySelectorAll('.hiw-slideshow__nav-item');
  const prevBtn = document.getElementById('hiwPrev');
  const nextBtn = document.getElementById('hiwNext');
  const progressBar = document.getElementById('hiwProgressBar');
  
  if (!track || !slides.length) return;
  
  let currentIndex = 0;
  const totalSlides = slides.length;
  const slideInterval = 5000; // 5 seconds per slide
  let autoPlayTimer = null;
  let progressTimer = null;
  
  // Go to specific slide
  function goToSlide(index) {
    if (index < 0) index = totalSlides - 1;
    if (index >= totalSlides) index = 0;
    
    currentIndex = index;
    
    // Slide track horizontally
    track.style.transform = `translateX(-${currentIndex * 100}%)`;
    
    // Update nav items
    navItems.forEach((item, i) => {
      item.classList.toggle('hiw-slideshow__nav-item--active', i === currentIndex);
    });
    
    // Update slide active state for animations
    slides.forEach((slide, i) => {
      slide.classList.toggle('active', i === currentIndex);
    });
    
    // Reset progress bar
    resetProgressBar();
    
    // Restart auto-play timer
    resetAutoPlay();
  }
  
  // Reset progress bar animation
  function resetProgressBar() {
    if (progressBar) {
      progressBar.style.transition = 'none';
      progressBar.style.width = '0';
      
      setTimeout(() => {
        progressBar.style.transition = 'width 5s linear';
        progressBar.style.width = '100%';
      }, 50);
    }
  }
  
  // Auto-play
  function startAutoPlay() {
    autoPlayTimer = setInterval(() => {
      goToSlide(currentIndex + 1);
    }, slideInterval);
  }
  
  function stopAutoPlay() {
    if (autoPlayTimer) {
      clearInterval(autoPlayTimer);
      autoPlayTimer = null;
    }
  }
  
  function resetAutoPlay() {
    stopAutoPlay();
    startAutoPlay();
  }
  
  // Arrow buttons
  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      goToSlide(currentIndex - 1);
    });
  }
  
  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      goToSlide(currentIndex + 1);
    });
  }
  
  // Nav buttons
  navItems.forEach((item, index) => {
    item.addEventListener('click', () => {
      goToSlide(index);
    });
  });
  
  // FAQ accordion
  document.querySelectorAll('.hiw-slideshow__faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      
      // Close all FAQs in current slide
      const currentSlide = btn.closest('.hiw-slideshow__slide');
      currentSlide.querySelectorAll('.hiw-slideshow__faq-q').forEach(b => {
        b.setAttribute('aria-expanded', 'false');
      });
      currentSlide.querySelectorAll('.hiw-slideshow__faq-a').forEach(a => {
        a.setAttribute('hidden', '');
      });
      
      // Open clicked FAQ if it was closed
      if (!expanded) {
        btn.setAttribute('aria-expanded', 'true');
        btn.nextElementSibling.removeAttribute('hidden');
      }
    });
  });
  
  // Initialize first slide
  slides[0].classList.add('active');
  startAutoPlay();
  resetProgressBar();
});

// ── Reviews — drag-to-scroll carousel + dot indicators ──
window.addEventListener('DOMContentLoaded', () => {
  const outer = document.querySelector('.reviews__carousel-outer');
  const track = document.getElementById('reviewsTrack');
  const dotsContainer = document.getElementById('reviewsDots');
  if (!track || !dotsContainer) return;

  const cards = track.querySelectorAll('.reviews__card');
  const total = cards.length;

  // Build dots
  cards.forEach((_, i) => {
    const d = document.createElement('div');
    d.className = 'reviews__dot' + (i === 0 ? ' active' : '');
    d.addEventListener('click', () => {
      const cardW = cards[0].offsetWidth + 20;
      track.scrollTo({ left: i * cardW, behavior: 'smooth' });
    });
    dotsContainer.appendChild(d);
  });

  // Drag-to-scroll
  let isDragging = false, startX = 0, scrollLeft0 = 0;
  track.addEventListener('mousedown', (e) => {
    isDragging = true;
    startX = e.pageX - track.offsetLeft;
    scrollLeft0 = track.scrollLeft;
    track.style.cursor = 'grabbing';
  }, { passive: true });
  window.addEventListener('mouseup', () => {
    if (!isDragging) return;
    isDragging = false;
    track.style.cursor = 'grab';
    const cardW = cards[0].offsetWidth + 32;
    const snapped = Math.round(track.scrollLeft / cardW) * cardW;
    track.scrollTo({ left: snapped, behavior: 'smooth' });
  }, { passive: true });
  track.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    const x = e.pageX - track.offsetLeft;
    track.scrollLeft = scrollLeft0 - (x - startX);
  }, { passive: true });

  // Touch drag
  let tStartX = 0;
  track.addEventListener('touchstart', (e) => { tStartX = e.touches[0].pageX; }, { passive: true });
  track.addEventListener('touchmove', (e) => {
    const dx = tStartX - e.touches[0].pageX;
    tStartX = e.touches[0].pageX;
    track.scrollLeft += dx;
  }, { passive: true });

  // Update dots on scroll
  function updateDots() {
    const cardW = cards[0].offsetWidth + 32;
    const idx = Math.round(track.scrollLeft / cardW);
    const clamped = Math.max(0, Math.min(idx, total - 1));
    dotsContainer.querySelectorAll('.reviews__dot').forEach((d, i) => {
      d.classList.toggle('active', i === clamped);
    });
  }

  track.addEventListener('scroll', updateDots, { passive: true });

  // Initial auto-hint: scroll slightly right then snap back
  setTimeout(() => {
    track.scrollLeft = (cards[0].offsetWidth + 32) * 0.35;
    setTimeout(() => {
      track.scrollTo({ left: 0, behavior: 'smooth' });
      updateDots();
    }, 300);
  }, 800);

  updateDots();
});

// ── Reviews carousel: arrows + dots + drag ──
(function initReviewsCarousel() {
  const track   = document.getElementById('reviewsTrack');
  const dotsEl  = document.getElementById('reviewsDots');
  const btnLeft  = document.getElementById('reviewsArrowLeft');
  const btnRight = document.getElementById('reviewsArrowRight');
  if (!track) return;

  const CARD = 444; // card(420) + gap(24)

  // Build dots — one per card
  if (dotsEl) {
    const cards = track.querySelectorAll('.reviews__card');
    dotsEl.innerHTML = '';
    cards.forEach((_, i) => {
      const d = document.createElement('button');
      d.className = 'reviews__dot' + (i === 0 ? ' active' : '');
      d.setAttribute('aria-label', `Go to review ${i + 1}`);
      d.addEventListener('click', () => scrollToCard(i));
      dotsEl.appendChild(d);
    });
  }

  function scrollToCard(index) {
    const cards = track.querySelectorAll('.reviews__card');
    const clamped = Math.max(0, Math.min(index, cards.length - 1));
    track.scrollTo({ left: clamped * CARD, behavior: 'smooth' });
  }

  function updateDots() {
    if (!dotsEl) return;
    const cards = track.querySelectorAll('.reviews__card');
    const scrollLeft = track.scrollLeft;
    const idx = Math.round(scrollLeft / CARD);
    dotsEl.querySelectorAll('.reviews__dot').forEach((d, i) => {
      d.classList.toggle('active', i === idx);
    });
    // Arrow visibility
    if (btnLeft)  btnLeft.classList.toggle('hidden', idx === 0);
    if (btnRight) btnRight.classList.toggle('hidden', idx >= cards.length - 1);
  }

  // Arrow clicks
  if (btnLeft)  btnLeft.addEventListener('click',  () => scrollToCard(Math.round(track.scrollLeft / CARD) - 1));
  if (btnRight) btnRight.addEventListener('click', () => scrollToCard(Math.round(track.scrollLeft / CARD) + 1));

  // Sync dots + arrows on scroll
  track.addEventListener('scroll', updateDots, { passive: true });
  updateDots();

  // Drag-to-scroll
  let isDown = false, startX = 0, scrollLeft = 0;
  track.addEventListener('mousedown', (e) => {
    isDown = true; startX = e.pageX - track.offsetLeft; scrollLeft = track.scrollLeft;
    track.style.cursor = 'grabbing';
  });
  track.addEventListener('mouseleave', () => { isDown = false; track.style.cursor = 'grab'; });
  track.addEventListener('mouseup',   () => { isDown = false; track.style.cursor = 'grab'; });
  track.addEventListener('mousemove', (e) => {
    if (!isDown) return;
    e.preventDefault();
    const x = e.pageX - track.offsetLeft;
    track.scrollLeft = scrollLeft - (x - startX);
  });
})();

