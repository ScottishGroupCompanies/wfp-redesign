.uv-why {
  background: #F3F6F1;
  padding: 100px 24px;
}

.uv-why__container {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

/* Left column — image with rounded corners */
.uv-why__image-wrap {
  position: relative;
  border-radius: 20px;
  overflow: visible;
}

.uv-why__image {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 20px;
  object-fit: cover;
  aspect-ratio: 4/5;
}

/* Floating stat card over the image */
.uv-why__stat-card {
  position: absolute;
  bottom: 32px;
  left: -24px;
  background: rgba(14, 26, 20, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  padding: 18px 22px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 220px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
}

.uv-why__stat-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'Inter', sans-serif;
  font-size: 0.82rem;
  font-weight: 500;
  color: rgba(243, 246, 241, 0.9);
  line-height: 1.3;
}

.uv-why__stat-divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
  margin: 2px 0;
}

/* Right column — content */
.uv-why__content {
  padding-right: 20px;
}

.uv-why__headline {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.8rem, 3.5vw, 2.75rem);
  font-weight: 700;
  color: #14201A;
  line-height: 1.2;
  margin-bottom: 24px;
  letter-spacing: -0.01em;
}

.uv-why__intro {
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  color: #4A5C48;
  line-height: 1.8;
  margin-bottom: 28px;
}

.uv-why__bullets {
  list-style: none;
  padding: 0;
  margin: 0 0 28px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.uv-why__bullets li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  color: #4A5C48;
  line-height: 1.6;
}

.uv-why__bullets svg {
  flex-shrink: 0;
  margin-top: 2px;
}

.uv-why__closing {
  font-family: 'Inter', sans-serif;
  font-size: 0.85rem;
  font-style: italic;
  color: rgba(74, 92, 72, 0.75);
  line-height: 1.7;
  margin-bottom: 32px;
  padding-left: 16px;
  border-left: 2px solid rgba(124, 179, 66, 0.35);
}

.uv-why__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  color: #7CB342;
  text-decoration: none;
  transition: gap 0.2s ease;
}

.uv-why__cta:hover {
  gap: 14px;
}

/* UV Bento Grid */
.uv-bento {
  background: #F3F6F1;
  padding: 0 24px 100px;
}

.uv-bento__header {
  max-width: 1200px;
  margin: 0 auto 48px;
  text-align: center;
}

.uv-bento__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  font-weight: 700;
  color: #14201A;
  margin-bottom: 16px;
  line-height: 1.2;
  letter-spacing: -0.01em;
}

.uv-bento__sub {
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  color: #4A5C48;
  max-width: 560px;
  margin: 0 auto;
  line-height: 1.7;
}

/* 12-column grid */
.uv-bento__grid {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 20px;
}

/* Base card */
.uv-bento-card {
  border-radius: 20px;
  padding: 32px;
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              box-shadow 0.3s ease,
              border-color 0.3s ease;
}

/* White card */
.uv-bento-card--white {
  background: #fff;
  border: 1px solid rgba(20, 32, 26, 0.08);
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
}

.uv-bento-card--white:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
  border-color: rgba(20, 32, 26, 0.14);
}

/* Dark card */
.uv-bento-card--dark {
  background: #14201A;
  border: 1px solid rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
}

.uv-bento-card--dark:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  border-color: rgba(255, 255, 255, 0.1);
}

/* Green gradient card */
.uv-bento-card--green {
  background: linear-gradient(145deg, #7CB342 0%, #2E6B30 100%);
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 2px 12px rgba(46, 107, 48, 0.2);
}

.uv-bento-card--green:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(46, 107, 48, 0.3);
}

/* Image card */
.uv-bento-card--image {
  grid-column: span 4;
  position: relative;
  padding: 0;
  overflow: hidden;
  border-radius: 20px;
  min-height: 280px;
}

.uv-bento-card--image:hover .uv-bento-card__img {
  transform: scale(1.04);
}

.uv-bento-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  display: block;
  position: absolute;
  inset: 0;
}

.uv-bento-card__image-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(10, 20, 14, 0.72) 0%, rgba(10, 20, 14, 0.1) 60%, transparent 100%);
  display: flex;
  align-items: flex-end;
  padding: 24px;
}

.uv-bento-card__image-label {
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  font-weight: 500;
  color: #F3F6F1;
  line-height: 1.4;
  margin: 0;
}

/* Grid column spans */
.uv-bento-card--white:nth-child(1) { grid-column: span 5; }
.uv-bento-card--image              { grid-column: span 4; }
.uv-bento-card--dark:nth-child(3)  { grid-column: span 3; }
.uv-bento-card--green:nth-child(4) { grid-column: span 4; }
.uv-bento-card--white:nth-child(5) { grid-column: span 4; }
.uv-bento-card--dark:nth-child(6)  { grid-column: span 4; }

/* Icon */
.uv-bento-card__icon {
  margin-bottom: 18px;
}

/* Card titles */
.uv-bento-card__title {
  font-family: 'Playfair Display', serif;
  font-size: 1.35rem;
  font-weight: 700;
  color: #14201A;
  margin-bottom: 12px;
  line-height: 1.25;
}

.uv-bento-card__title--light {
  font-family: 'Playfair Display', serif;
  font-size: 1.35rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12px;
  line-height: 1.25;
}

/* Card text */
.uv-bento-card__text {
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  color: #4A5C48;
  line-height: 1.65;
  margin: 0;
}

.uv-bento-card__text--light {
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  color: rgba(243, 246, 241, 0.82);
  line-height: 1.65;
  margin: 0;
}

/* Big stat */
.uv-bento-card__big-stat {
  font-family: 'Space Mono', monospace;
  font-size: clamp(2.5rem, 4vw, 3.5rem);
  font-weight: 700;
  color: #7CB342;
  line-height: 1;
  margin-bottom: 12px;
  display: block;
}

.uv-bento-card__stat-label {
  font-family: 'Inter', sans-serif;
  font-size: 0.85rem;
  font-weight: 500;
  color: rgba(243, 246, 241, 0.7);
  line-height: 1.5;
  display: block;
}

/* Respect reduced-motion preferences */
@media (prefers-reduced-motion: reduce) {
  .uv-bento-card,
  .uv-bento-card__img {
    transition: none;
  }

  .uv-bento-card:hover {
    transform: none;
  }

  .uv-bento-card--image:hover .uv-bento-card__img {
    transform: none;
  }
}

/* Cinematic Section */
.cinematic-section {
  background: #0d1a0f;
  padding: 100px 24px;
}

.cinematic-section__container {
  max-width: 1200px;
  margin: 0 auto;
