  }

  .guide-item__body p {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: #4A5C48;
    line-height: 1.8;
    margin-bottom: 16px;
  }

  .guide-item__body p:last-child {
    margin-bottom: 0;
  }

  /* Respect reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .guide-item,
    .guide-item__toggle,
    .guide-sidebar__cta {
      transition: none;
    }

    .guide-item:hover,
    .guide-sidebar__cta:hover {
