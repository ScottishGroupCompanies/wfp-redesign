    font-size: 0.82rem;
    color: #4A5C48;
    line-height: 1.4;
    opacity: 0.75;
  }

  .guide-item[open] .guide-item__preview {
    display: none;
  }

  /* Toggle button */
  .guide-item__toggle {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1.5px solid rgba(20, 32, 26, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7CB342;
    margin-top: 2px;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.3s ease;
  }

  .guide-item:hover .guide-item__toggle {
    border-color: rgba(124, 179, 66, 0.4);
    background: rgba(124, 179, 66, 0.06);
  }

  .guide-item[open] .guide-item__toggle {
    background: #7CB342;
    border-color: #7CB342;
    color: #fff;
    transform: rotate(45deg);
  }

  /* Body */
  .guide-item__body {
    padding: 16px 24px 26px;
    border-top: 1px solid rgba(20, 32, 26, 0.06);
    margin-top: 0;
  }

  .guide-item__body p {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: #4A5C48;
    line-height: 1.8;
    margin-bottom: 16px;
  }

  .guide-item__body p:last-child {
    margin-bottom: 0;
  }

  /* Respect reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .guide-item,
    .guide-item__toggle,
    .guide-sidebar__cta {
      transition: none;
    }

    .guide-item:hover,
    .guide-sidebar__cta:hover {
      transform: none;
    }

    .guide-item[open] .guide-item__toggle {
      transform: none;
    }
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .guide-section__grid {
      grid-template-columns: 280px 1fr;
      gap: 40px;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .guide-section {
      padding: 72px 20px;
    }

    .guide-section__intro {
      text-align: left;
      margin-bottom: 40px;
    }

    .guide-section__sub {
      margin: 0;
    }

    .guide-section__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .guide-sidebar {
      position: static;
    }

    .guide-sidebar__inner {
      padding: 32px 28px;
    }

    .guide-sidebar__cta {
      width: 100%;
    }

    .guide-questions {
      gap: 12px;
    }

    .guide-item__header {
      padding: 18px 20px;
    }

    .guide-item__title {
      font-size: 0.98rem;
    }

    .guide-item__body {
      padding: 12px 20px 22px;
    }
  }

