  /* Open state: green accent line on left */
  .guide-item[open] {
    border-color: rgba(124, 179, 66, 0.3);
    box-shadow: 0 6px 24px rgba(124, 179, 66, 0.08);
  }

  .guide-item__header {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 22px 24px;
    cursor: pointer;
    list-style: none;
  }

  .guide-item__header::-webkit-details-marker {
    display: none;
  }

  .guide-item[open] .guide-item__header {
    padding-bottom: 0;
  }

  /* Number */
  .guide-item__number {
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: rgba(124, 179, 66, 0.5);
