    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.2);
  }

  /* Abstract line pattern — absolutely positioned behind content */
  .guide-sidebar__pattern {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.6;
    pointer-events: none;
  }

  .guide-sidebar__content {
    position: relative;
    z-index: 2;
  }

  .guide-sidebar__label {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
