    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(124, 179, 66, 0.7);
    margin-bottom: 12px;
  }

  .guide-sidebar__headline {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #F3F6F1;
    line-height: 1.2;
    margin-bottom: 14px;
  }

  .guide-sidebar__body {
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    color: rgba(243, 246, 241, 0.65);
    line-height: 1.65;
    margin-bottom: 24px;
  }

  /* Chips */
  .guide-sidebar__chips {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
  }

  .guide-sidebar__chip {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(243, 246, 241, 0.75);
