---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlipWords from '../../components/FlipWords.astro';

const title = "UV Protection Window Film in Philadelphia, PA | Window Film Philadelphia";
const description = "Block 99% of harmful UV rays with professional UV window film installation in Philadelphia. Protect your family, furnishings, and artwork from sun damage. Free estimates.";
const canonicalURL = "https://windowfilmphiladelphia.net/services/uv-protection-film/";
const heroImage = "/images/uv-protection-hero-philadelphia.png";
---

<BaseLayout title={title} description={description} canonical={canonicalURL}>
  
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Window Film Philadelphia",
      "description": "Professional UV protection window film installation in Philadelphia and the Delaware Valley.",
      "url": "https://windowfilmphiladelphia.net",
      "telephone": "+1-267-394-7980",
      "email": "info@windowfilmphl.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Philadelphia",
        "addressRegion": "PA",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "39.9526",
        "longitude": "-75.1652"
      },
      "openingHours": "Mo-Sa 08:00-18:00",
      "priceRange": "$$",
      "areaServed": "Philadelphia, Montgomery County, Delaware County, Chester County, Bucks County, Camden County NJ"
    }
  </script>

  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "UV Protection Window Film - Philadelphia",
      "description": "Professional installation of UV protection window film that blocks up to 99% of harmful ultraviolet rays, protecting interiors and occupants in Philadelphia properties.",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Window Film Philadelphia"
      },
      "areaServed": {
        "@type": "City",
        "name": "Philadelphia"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "UV Protection Films",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Residential UV Window Film"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Commercial UV Window Film"
            }
          }
        ]
      }
    }
  </script>

  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://windowfilmphiladelphia.net"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Services",
          "item": "https://windowfilmphiladelphia.net/services/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "UV Protection Film",
          "item": "https://windowfilmphiladelphia.net/services/uv-protection-film/"
        }
      ]
    }
  </script>

  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does UV protection window film make rooms darker?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not significantly. Most UV protection films are designed to block harmful rays while maintaining natural light. Options range from nearly invisible clear films to light tinting, depending on your needs. In Philadelphia's north-facing rooms, this distinction matters less, but south and west-facing windows benefit most from the heat and UV rejection while preserving brightness."
          }
        },
        {
          "@type": "Question",
          "name": "How much UV does window film actually block?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Professional-grade UV protection window film blocks up to 99% of ultraviolet radiation. This includes both UVA and UVB rays. The exact percentage varies by film type and manufacturer, but quality films from brands like 3M, LLumar, and Vista consistently achieve 99% UV blockage while maintaining excellent clarity and visibility."
          }
        },
        {
          "@type": "Question",
          "name": "Will UV film protect my furniture and hardwood floors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely. In Philadelphia's historic homes with original hardwood floors and antique furniture, UV protection is essential. Window film blocks the rays responsible for fading, cracking, and deterioration of wood, fabric, leather, and artwork. Properties near Rittenhouse Square, Chestnut Hill, and Old City particularly benefit from this protection."
          }
        },
        {
          "@type": "Question",
          "name": "Can UV window film help with skin protection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, significantly. Philadelphia's urban environment means extended sun exposure through windows adds up over time. UV protection film reduces the risk of skin damage and premature aging caused by daily sun exposure through glass. This is especially important for families in sun-drenched properties throughout the Main Line and surrounding suburbs."
          }
        },
        {
          "@type": "Question",
          "name": "How long does UV protection window film last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Professional UV window film typically lasts 15-20 years, with many manufacturers offering lifetime warranties. The film maintains its UV-blocking properties throughout its lifespan without yellowing or degrading. Our Philadelphia-based installation includes comprehensive warranty coverage backed by the manufacturer."
          }
        },
        {
          "@type": "Question",
          "name": "Is UV protection window film worth the investment in Philadelphia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For Philadelphia properties, the investment pays for itself in multiple ways: reduced fading damage to floors and furnishings worth thousands in preservation, lower cooling costs during humid Philadelphia summers, and protection against UV-related health concerns. Most clients see payback within 3-5 years through combined savings and avoided damage."
          }
        }
      ]
    }
  </script>

  <!-- Open Graph -->
  <meta property="og:title" content={title} slot="head" />
  <meta property="og:description" content={description} slot="head" />
  <meta property="og:image" content={heroImage} slot="head" />
  <meta property="og:url" content={canonicalURL} slot="head" />
  <meta property="og:type" content="website" slot="head" />

  <!-- Hero Section - Full Bleed Cinematic -->
  <section class="uv-hero">
    <div class="uv-hero__bg" style={`background-image: url('${heroImage}')`} role="img" aria-label="UV protection window film in a Philadelphia home with natural light through large windows"></div>
    <div class="uv-hero__overlay"></div>
    <div class="uv-hero__content">

      <!-- Eyebrow pill -->
      <div class="uv-hero__eyebrow">
        <span>Philadelphia UV Film</span>
        <span class="uv-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Clear Protection</span>
        <span class="uv-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Since 2008</span>
      </div>

      <!-- H1 -->
      <h1 class="uv-hero__title">UV Protection Window Film<br class="uv-hero__br"/> for Philadelphia</h1>

      <!-- Animated supporting line -->
      <p class="uv-hero__animated-line">
        Protect your
        <FlipWords
          words={["hardwood floors", "furniture", "artwork", "interiors", "natural light"]}
          staticText=""
          class="uv-hero__flip"
        />.
      </p>

      <!-- Subheadline -->
      <p class="uv-hero__subtitle">
        Block up to 99% of harmful UV rays while helping preserve the floors, furnishings, artwork, and interiors sunlight touches every day.
      </p>

      <!-- CTA buttons -->
      <div class="uv-hero__cta">
        <a href="/contact/" class="uv-hero__btn-primary">Get Your Free Estimate</a>
        <a href="tel:2673947980" class="uv-hero__btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z" fill="currentColor"/></svg>
          Call (267) 394-7980
        </a>
      </div>

      <!-- Stats glass panel -->
      <div class="uv-hero__stats-panel" aria-label="Key statistics">
        <div class="uv-hero__stats-inner">
          <div class="uv-hero__stat">
            <span class="uv-hero__stat-number">99%</span>
            <span class="uv-hero__stat-label">UV Blocked</span>
          </div>
          <div class="uv-hero__stat-divider" aria-hidden="true"></div>
          <div class="uv-hero__stat">
            <span class="uv-hero__stat-number">2008</span>
            <span class="uv-hero__stat-label">Serving Philadelphia Since</span>
          </div>
          <div class="uv-hero__stat-divider" aria-hidden="true"></div>
          <div class="uv-hero__stat">
            <span class="uv-hero__stat-number">2,400+</span>
            <span class="uv-hero__stat-label">Projects Completed</span>
          </div>
          <div class="uv-hero__stat-divider" aria-hidden="true"></div>
          <div class="uv-hero__stat">
            <span class="uv-hero__stat-number">Clear</span>
            <span class="uv-hero__stat-label">Film Options Available</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Animated Statement (moved after hero — secondary treatment) -->
  <!-- NOTE: flip-statement section removed from here to avoid double FlipWords on one page.
       Keeping the animated "Protect your..." line in the hero as the primary animation. -->

  <!-- Why UV Protection Matters -->
  <section class="uv-why">
    <div class="uv-why__container">

      <!-- Left: image with floating stat card -->
      <div class="uv-why__image-wrap">
        <img
          src="/images/uv-protection-philadelphia-brownstone.jpg"
          alt="Elegant Philadelphia brownstone interior with tall windows — hardwood floors, curated art, and natural light"
          width="720"
          height="900"
          loading="lazy"
          class="uv-why__image"
        />
        <!-- Floating stat card -->
        <div class="uv-why__stat-card">
          <div class="uv-why__stat-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Up to 99% UV rejection</span>
          </div>
          <div class="uv-why__stat-divider"></div>
          <div class="uv-why__stat-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Clear film options available</span>
          </div>
        </div>
      </div>

      <!-- Right: content -->
      <div class="uv-why__content">
        <div class="eyebrow-modern">Why UV Protection Matters</div>
        <h2 class="uv-why__headline">The Sun Doesn't Need to Be Harsh to Cause Damage</h2>
        <p class="uv-why__intro">UV exposure works quietly. It moves through untreated glass every day, fading hardwood floors, softening fabric color, damaging artwork, and aging the interiors you invested in.</p>
        <ul class="uv-why__bullets">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Protect hardwood floors, rugs, upholstery, and artwork from premature fading.
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Preserve natural daylight without making your windows look dark or reflective.
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Ideal for Philadelphia homes, condos, offices, retail spaces, galleries, and historic properties.
          </li>
        </ul>
        <p class="uv-why__closing">Since 2008, Window Film Philadelphia has helped protect Delaware Valley interiors with professional-grade UV protection films selected for clarity, performance, and long-term durability.</p>
        <a href="/contact/" class="uv-why__cta">
          Explore UV protection options
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
        </a>
      </div>

    </div>
  </section>

  <!-- UV Benefits — Compact Trust Band -->
  <section class="uv-bento">
    <div class="uv-bento__header">
      <h2 class="uv-bento__title">Protection You Don't Have to See to Feel</h2>
      <p class="uv-bento__sub">Professional UV protection film helps preserve the spaces, finishes, and furnishings that Philadelphia sunlight touches every day.</p>
    </div>
    <div class="uv-bento__compact">

      <div class="uv-bento-item">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <circle cx="14" cy="14" r="9" stroke="#7CB342" stroke-width="1.5"/>
          <path d="M14 7v2M14 19v2M7 14h2M19 14h2" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="14" cy="14" r="3" fill="#7CB342" fill-opacity="0.15" stroke="#7CB342" stroke-width="1"/>
        </svg>
        <div>
          <h3 class="uv-bento-item__title">Up to 99% UV Rejection</h3>
          <p class="uv-bento-item__text">Many professional films block the majority of harmful ultraviolet radiation while keeping glass clear.</p>
        </div>
      </div>

      <div class="uv-bento-item">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <rect x="3" y="7" width="22" height="14" rx="2" stroke="#7CB342" stroke-width="1.5"/>
          <path d="M3 12h22M3 18h22" stroke="#7CB342" stroke-width="1.5"/>
        </svg>
        <div>
          <h3 class="uv-bento-item__title">Built for Philly Glass</h3>
          <p class="uv-bento-item__text">Clear film options designed for historic rowhomes, tall windows, and architecturally sensitive properties.</p>
        </div>
      </div>

      <div class="uv-bento-item">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <path d="M14 4l-2.5 7.5H4l6.25 5L7.5 24 14 19l6.5 5-2.75-7.5L24 11.5h-7.5L14 4z" stroke="#7CB342" stroke-width="1.5" stroke-linejoin="round" fill="none"/>
        </svg>
        <div>
          <h3 class="uv-bento-item__title">Fade Defense</h3>
          <p class="uv-bento-item__text">Help slow fading of hardwood floors, upholstery, artwork, rugs, and decorative finishes over time.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- Key Benefits — Asymmetric Bento Grid -->
  <section class="kb-section">
    <div class="kb-section__container">

      <div class="kb-section__header">
        <div class="eyebrow-modern">Key Benefits</div>
        <h2 class="kb-section__headline">What UV Protection Film Helps Preserve</h2>
        <p class="kb-section__sub">From hardwood floors to artwork and retail displays, professional UV film helps protect the things sunlight touches every day.</p>
      </div>

      <div class="kb-grid">

        <!-- Row 1: Hero (left) + 2 image cards (right) -->

        <!-- Card 1: 99% UV Rejection — hero, spans 6 cols -->
        <div class="kb-card kb-card--hero">
          <div class="kb-card__hero-icon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
              <circle cx="24" cy="24" r="10" stroke="#7CB342" stroke-width="1.5"/>
              <path d="M24 6v4M24 38v4M6 24h4M38 24h4M10.1 10.1l2.83 2.83M35.07 35.07l2.83 2.83M10.1 37.9l2.83-2.83M35.07 12.93l2.83-2.83" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="kb-card__hero-title">99% UV Rejection Without Darkening the Room</h3>
          <p class="kb-card__hero-text">Clear and lightly tinted films can block up to 99% of harmful UV rays while preserving the natural daylight, views, and character of your glass.</p>
          <div class="kb-card__pill">Clear Film Options</div>
        </div>

        <!-- Card 2: Hardwood Floors — image, spans 3 cols -->
        <div class="kb-card kb-card--photo">
          <img
            src="/images/kb-hardwood-floors.jpg"
            alt="Sunlight streaming through tall windows onto dark walnut hardwood floors in a Philadelphia townhouse"
            width="400"
            height="560"
            loading="lazy"
            class="kb-card__img"
          />
          <div class="kb-card__photo-overlay"></div>
          <div class="kb-card__photo-content">
            <h3 class="kb-card__photo-title">Hardwood Floors</h3>
            <p class="kb-card__photo-text">Help slow uneven fading caused by daily sunlight.</p>
          </div>
        </div>

        <!-- Card 3: Artwork & Furnishings — image, spans 3 cols -->
        <div class="kb-card kb-card--photo">
          <img
            src="/images/kb-artwork-furnishings.jpg"
            alt="Elegant Philadelphia living room with framed artwork on walls, cream sofa, and warm afternoon window light"
            width="400"
            height="560"
            loading="lazy"
            class="kb-card__img"
          />
          <div class="kb-card__photo-overlay"></div>
          <div class="kb-card__photo-content">
            <h3 class="kb-card__photo-title">Artwork &amp; Furnishings</h3>
            <p class="kb-card__photo-text">Protect fabrics, framed art, rugs, and valuable finishes.</p>
          </div>
        </div>

        <!-- Row 2: Three balanced equal cards -->

        <!-- Card 4: Natural Light — dark premium, spans 4 cols -->
        <div class="kb-card kb-card--dark-accent">
          <div class="kb-card__accent-line" aria-hidden="true"></div>
          <div class="kb-card__icon-row">
            <svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true">
              <circle cx="18" cy="18" r="9" stroke="#7CB342" stroke-width="1.5"/>
              <path d="M18 11v7l5 3" stroke="#7CB342" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="18" cy="18" r="3" fill="rgba(124,179,66,0.12)"/>
            </svg>
          </div>
          <h3 class="kb-card__dark-title">Natural Light</h3>
          <p class="kb-card__dark-text">Keep rooms bright and comfortable without the heavy look of dark tint.</p>
          <div class="kb-card__micro-pill">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707" stroke="#7CB342" stroke-width="2" stroke-linecap="round"/></svg>
            70–80% light transmission
          </div>
        </div>

        <!-- Card 5: Historic Glass — dark, premium, spans 4 cols -->
        <div class="kb-card kb-card--dark-pattern">
          <div class="kb-card__icon-row">
            <svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true">
              <rect x="4" y="9" width="28" height="18" rx="2.5" stroke="#7CB342" stroke-width="1.5"/>
              <path d="M4 16h28M4 23h28" stroke="#7CB342" stroke-width="1.5"/>
              <path d="M12 9v18M20 9v18" stroke="rgba(124,179,66,0.35)" stroke-width="1"/>
            </svg>
          </div>
          <h3 class="kb-card__dark-title">Historic Glass</h3>
          <p class="kb-card__dark-text">A strong fit for Philadelphia rowhomes, older windows, museums, galleries, and properties where appearance matters.</p>
          <div class="kb-card__micro-pill">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Clear options available
          </div>
        </div>

        <!-- Card 6: Retail Displays — dark premium image, spans 4 cols -->
        <div class="kb-card kb-card--retail">
          <img
            src="/images/kb-retail-displays.png"
            alt="Boutique retail storefront with large windows, natural daylight, wooden shelving and merchandise"
            width="520"
            height="360"
            loading="lazy"
            class="kb-card__img"
          />
          <div class="kb-card__retail-overlay"></div>
          <div class="kb-card__retail-content">
            <div class="kb-card__retail-badge">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 21h8m-4-4v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              Commercial Use
            </div>
            <h3 class="kb-card__retail-title">Retail Displays</h3>
            <p class="kb-card__retail-text">Help reduce UV exposure on merchandise, flooring, and storefront interiors without darkening your space.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- UV Film Buyer's Guide — Editorial Accordion -->
  <section class="guide-section">
    <div class="guide-section__container">

      <!-- Section intro -->
      <div class="guide-section__intro">
        <div class="eyebrow-modern">UV Film Buyer's Guide</div>
        <h2 class="guide-section__headline">Everything Philadelphia Property Owners Should Know</h2>
        <p class="guide-section__sub">Explore how UV protection window film works, what it protects, and how to choose the right solution for your home, office, storefront, or historic property.</p>
      </div>

      <div class="guide-section__grid">

        <!-- Left: Premium sticky sidebar -->
        <aside class="guide-sidebar">
          <div class="guide-sidebar__inner">
            <!-- Subtle abstract line pattern -->
            <div class="guide-sidebar__pattern" aria-hidden="true">
              <svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="100" cy="100" r="80" stroke="rgba(124,179,66,0.12)" stroke-width="1"/>
                <circle cx="100" cy="100" r="60" stroke="rgba(124,179,66,0.08)" stroke-width="1"/>
                <circle cx="100" cy="100" r="40" stroke="rgba(124,179,66,0.06)" stroke-width="1"/>
                <line x1="20" y1="100" x2="180" y2="100" stroke="rgba(124,179,66,0.08)" stroke-width="1"/>
                <line x1="100" y1="20" x2="100" y2="180" stroke="rgba(124,179,66,0.08)" stroke-width="1"/>
                <line x1="43" y1="43" x2="157" y2="157" stroke="rgba(124,179,66,0.06)" stroke-width="1"/>
                <line x1="157" y1="43" x2="43" y2="157" stroke="rgba(124,179,66,0.06)" stroke-width="1"/>
              </svg>
            </div>

            <div class="guide-sidebar__content">
              <div class="guide-sidebar__label">In-Depth Guide</div>
              <h3 class="guide-sidebar__headline">Philadelphia UV Protection Film Guide</h3>
              <p class="guide-sidebar__body">Understand how UV protection film performs, what it protects, and which options make the most sense for your space.</p>

              <!-- Stat chips -->
              <div class="guide-sidebar__chips">
                <div class="guide-sidebar__chip">
