/* Key Benefits — 2-row balanced grid */
.kb-section {
  background: #0d1a0f;
  padding: 100px 24px;
}

.kb-section__container {
  max-width: 1200px;
  margin: 0 auto;
}

.kb-section__header {
  text-align: center;
  margin-bottom: 60px;
}

.kb-section__header .eyebrow-modern {
  color: #7CB342;
}

.kb-section__headline {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  font-weight: 700;
  color: #F3F6F1;
  margin-bottom: 16px;
  line-height: 1.2;
  letter-spacing: -0.01em;
}

.kb-section__sub {
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  color: rgba(243, 246, 241, 0.65);
  max-width: 520px;
  margin: 0 auto;
  line-height: 1.7;
}

/* ── 12-column grid: 6 + 3 + 3 top row, 4 + 4 + 4 bottom row ── */
.kb-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  grid-auto-rows: auto;
  gap: 20px;
}

/* ── Base card ── */
.kb-card {
  border-radius: 24px;
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              box-shadow 0.3s ease,
              border-color 0.3s ease;
}

/* ── Hero card: 6 cols, dark gradient, min-height balanced with row 2 ── */
.kb-card--hero {
  grid-column: span 6;
  background: linear-gradient(145deg, #1a3024 0%, #0d1a0f 60%);
  border: 1px solid rgba(124, 179, 66, 0.15);
  padding: 48px 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
  min-height: 420px;
}

.kb-card--hero:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
  border-color: rgba(124, 179, 66, 0.25);
}

.kb-card__hero-icon {
  margin-bottom: 24px;
}

.kb-card__hero-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.4rem, 2.5vw, 1.9rem);
  font-weight: 700;
  color: #F3F6F1;
  line-height: 1.2;
  margin-bottom: 16px;
}

.kb-card__hero-text {
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  color: rgba(243, 246, 241, 0.7);
  line-height: 1.7;
  margin-bottom: 24px;
}

.kb-card__pill {
  display: inline-block;
  font-family: 'Space Mono', monospace;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #7CB342;
  background: rgba(124, 179, 66, 0.12);
  border: 1px solid rgba(124, 179, 66, 0.25);
  padding: 6px 14px;
  border-radius: 100px;
  align-self: flex-start;
}

/* ── Photo cards: spans 3 cols each, height matches hero row ── */
.kb-card--photo {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  min-height: 420px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
}

.kb-card--photo:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
}

.kb-card--photo:hover .kb-card__img {
  transform: scale(1.04);
}

.kb-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  position: absolute;
  inset: 0;
  transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.kb-card__photo-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(10, 20, 14, 0.88) 0%,
    rgba(10, 20, 14, 0.35) 50%,
    rgba(10, 20, 14, 0.05) 100%
  );
  transition: background 0.4s ease;
}

.kb-card__photo-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 28px 28px;
  z-index: 5;
}

.kb-card__photo-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.2rem;
  font-weight: 700;
  color: #F3F6F1;
  margin-bottom: 8px;
  line-height: 1.2;
}

.kb-card__photo-text {
  font-family: 'Inter', sans-serif;
  font-size: 0.82rem;
  color: rgba(243, 246, 241, 0.75);
  line-height: 1.5;
  margin: 0;
}

/* ── Dark accent card (Natural Light) ── */
.kb-card--dark-accent {
  grid-column: span 4;
  background: linear-gradient(145deg, #14201a 0%, #0d1a0f 100%);
  border: 1px solid rgba(124, 179, 66, 0.18);
  border-radius: 24px;
  padding: 36px 32px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.18);
  position: relative;
  overflow: hidden;
  min-height: 220px;
}

.kb-card--dark-accent:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.28);
  border-color: rgba(124, 179, 66, 0.32);
}

.kb-card__accent-line {
  position: absolute;
  top: 0;
  left: 32px;
  right: 32px;
  height: 2px;
  background: linear-gradient(90deg, #7CB342, transparent);
}

/* ── Dark pattern card (Historic Glass) ── */
.kb-card--dark-pattern {
  grid-column: span 4;
  background: linear-gradient(145deg, #1a2e20 0%, #0d1a0f 100%);
  border: 1px solid rgba(124, 179, 66, 0.12);
  border-radius: 24px;
  padding: 36px 32px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.18);
  position: relative;
  overflow: hidden;
  min-height: 220px;
}

.kb-card--dark-pattern::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(124, 179, 66, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(124, 179, 66, 0.04) 1px, transparent 1px);
  background-size: 24px 24px;
  pointer-events: none;
}

.kb-card--dark-pattern:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.28);
  border-color: rgba(124, 179, 66, 0.22);
}

/* ── Shared row 2 dark card elements ── */
.kb-card__icon-row {
  margin-bottom: 18px;
}

.kb-card__dark-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: #F3F6F1;
  margin-bottom: 10px;
  line-height: 1.25;
}

.kb-card__dark-text {
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  color: rgba(243, 246, 241, 0.72);
  line-height: 1.65;
  margin: 0 0 16px;
  flex: 1;
}

.kb-card__micro-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: 'Space Mono', monospace;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  color: rgba(124, 179, 66, 0.85);
  background: rgba(124, 179, 66, 0.08);
  border: 1px solid rgba(124, 179, 66, 0.18);
  padding: 5px 10px;
  border-radius: 100px;
  align-self: flex-start;
}

/* ── Retail card: premium dark image card ── */
.kb-card--retail {
  grid-column: span 4;
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  min-height: 220px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.18);
}

.kb-card--retail:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
}

.kb-card--retail:hover .kb-card__img {
  transform: scale(1.04);
}

.kb-card__retail-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(10, 20, 14, 0.92) 0%,
    rgba(13, 26, 15, 0.80) 50%,
    rgba(10, 20, 14, 0.60) 100%
  );
  z-index: 2;
}

.kb-card__retail-content {
  position: absolute;
  inset: 0;
  z-index: 5;
  padding: 28px 28px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.kb-card__retail-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: 'Space Mono', monospace;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: #7CB342;
  background: rgba(124, 179, 66, 0.12);
  border: 1px solid rgba(124, 179, 66, 0.22);
  padding: 5px 10px;
  border-radius: 100px;
  margin-bottom: 10px;
  align-self: flex-start;
}

.kb-card__retail-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: #F3F6F1;
  margin-bottom: 8px;
  line-height: 1.2;
}

.kb-card__retail-text {
  font-family: 'Inter', sans-serif;
  font-size: 0.82rem;
  color: rgba(243, 246, 241, 0.72);
  line-height: 1.55;
  margin: 0;
}

/* ── Grid placement ── */
.kb-card--photo:nth-child(2) { grid-column: span 3; }
.kb-card--photo:nth-child(3) { grid-column: span 3; }
.kb-card--dark-accent       { grid-column: span 4; }
.kb-card--dark-pattern      { grid-column: span 4; }
.kb-card--retail           { grid-column: span 4; }

/* Respect reduced-motion */
@media (prefers-reduced-motion: reduce) {
  .kb-card,
  .kb-card__img {
    transition: none;
  }
  .kb-card:hover,
  .kb-card--photo:hover .kb-card__img {
    transform: none;
  }
}

