/* Why UV Protection Matters */
.uv-why {
  background: #F3F6F1;
  padding: 100px 24px;
}

.uv-why__container {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

/* Left column — image with rounded corners */
.uv-why__image-wrap {
  position: relative;
  border-radius: 20px;
  overflow: visible;
}

.uv-why__image {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 20px;
  object-fit: cover;
  aspect-ratio: 4/5;
}

/* Floating stat card over the image */
.uv-why__stat-card {
  position: absolute;
  bottom: 32px;
  left: -24px;
  background: rgba(14, 26, 20, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  padding: 18px 22px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 220px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
}

.uv-why__stat-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'Inter', sans-serif;
  font-size: 0.82rem;
  font-weight: 500;
  color: rgba(243, 246, 241, 0.9);
  line-height: 1.3;
}

.uv-why__stat-divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
  margin: 2px 0;
}

/* Right column — content */
.uv-why__content {
  padding-right: 20px;
}

.uv-why__headline {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.8rem, 3.5vw, 2.75rem);
  font-weight: 700;
  color: #14201A;
  line-height: 1.2;
