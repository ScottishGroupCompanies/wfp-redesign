}

/* ── Part 1: Stat band ── */
.proof-stats {
  background: rgba(20, 32, 26, 0.65);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 20px;
  padding: 4px;
  margin-bottom: 64px;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.2);
}

.proof-stats__inner {
  display: flex;
  align-items: stretch;
  border-radius: 16px;
  overflow: hidden;
}

.proof-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 28px 20px;
  gap: 6px;
}

.proof-stat__divider {
  width: 1px;
  background: rgba(255, 255, 255, 0.09);
  align-self: stretch;
  margin: 20px 0;
  flex-shrink: 0;
}

.proof-stat__number {
  display: block;
  font-family: 'Space Mono', monospace;
  font-size: clamp(1.6rem, 3vw, 2.25rem);
  font-weight: 700;
  color: #7CB342;
  line-height: 1;
  letter-spacing: -0.5px;
}

.proof-stat__label {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 0.72rem;
  font-weight: 600;
  color: rgba(243, 246, 241, 0.85);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-top: 2px;
}

.proof-stat__text {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 0.75rem;
  color: rgba(243, 246, 241, 0.5);
  line-height: 1.5;
  margin: 0;
  max-width: 160px;
}

/* ── Part 2: Reason cards ── */
.proof-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.proof-card {
  position: relative;
  background: rgba(124, 179, 66, 0.05);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(124, 179, 66, 0.15);
  border-radius: 20px;
  padding: 32px 28px;
  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  overflow: hidden;
}

.proof-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 20px;
  background: radial-gradient(ellipse at 50% 0%, rgba(124, 179, 66, 0.06) 0%, transparent 70%);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.proof-card:hover {
  transform: translateY(-6px);
  border-color: rgba(124, 179, 66, 0.45);
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(124, 179, 66, 0.1) inset;
  background: rgba(124, 179, 66, 0.08);
}

.proof-card:hover::before {
  opacity: 1;
}

.proof-card__number {
  display: block;
  font-family: 'Space Mono', monospace;
  font-size: 2rem;
  font-weight: 700;
  color: rgba(124, 179, 66, 0.3);
  line-height: 1;
  margin-bottom: 16px;
  transition: color 0.3s ease;
}

.proof-card:hover .proof-card__number {
  color: rgba(124, 179, 66, 0.5);
}

.proof-card__title {
  font-family: 'Playfair Display', serif;
  font-size: 1.05rem;
  font-weight: 700;
  color: #F3F6F1;
  margin-bottom: 12px;
  line-height: 1.3;
}

.proof-card__text {
  font-family: 'Inter', sans-serif;
  font-size: 0.85rem;
  color: rgba(243, 246, 241, 0.65);
  line-height: 1.65;
  margin: 0;
}

/* Respect reduced-motion */
@media (prefers-reduced-motion: reduce) {
  .proof-card:hover {
    transform: none;
  }
}

