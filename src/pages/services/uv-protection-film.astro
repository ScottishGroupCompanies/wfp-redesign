<style>
/* Hero Section */
.uv-hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.uv-hero__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center top;
  background-repeat: no-repeat;
}

.uv-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(13, 26, 15, 0.68) 0%,
    rgba(13, 26, 15, 0.82) 55%,
    rgba(13, 26, 15, 0.95) 100%
  );
}

.uv-hero__content {
  position: relative;
  z-index: 10;
  max-width: 860px;
  padding: 120px 24px 80px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ── Eyebrow pill ── */
.uv-hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: 'Space Mono', monospace;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: rgba(124, 179, 66, 0.85);
  margin-bottom: 28px;
  background: rgba(124, 179, 66, 0.08);
  border: 1px solid rgba(124, 179, 66, 0.2);
  padding: 8px 18px;
  border-radius: 100px;
}

.uv-hero__eyebrow-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: rgba(124, 179, 66, 0.4);
  flex-shrink: 0;
}

/* ── H1 ── */
.uv-hero__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.25rem, 5.5vw, 3.75rem);
  font-weight: 700;
  color: #F3F6F1;
  line-height: 1.1;
  margin-bottom: 20px;
  letter-spacing: -0.01em;
}

.uv-hero__br {
  display: none;
}

/* ── Animated line ── */
.uv-hero__animated-line {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.2rem, 2.5vw, 1.65rem);
  font-weight: 400;
  font-style: italic;
  color: rgba(243, 246, 241, 0.9);
  margin-bottom: 20px;
  line-height: 1.4;
}

/* Override FlipWords inside the hero animated line */
.uv-hero__flip.flipwords-wrap {
  display: inline;
}

.uv-hero__flip .fw-word-col {
  display: inline-flex;
  flex-direction: column;
  position: relative;
  vertical-align: baseline;
}

.uv-hero__flip .fw-word {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  white-space: nowrap;
  font-style: normal;
  min-width: unset;
}

.uv-hero__flip .fw-word.is-active {
  position: relative;
}

/* ── Subheadline ── */
.uv-hero__subtitle {
  font-family: 'Inter', sans-serif;
  font-size: clamp(0.9rem, 1.5vw, 1.05rem);
  color: rgba(243, 246, 241, 0.72);
  max-width: 680px;
  margin-bottom: 36px;
  line-height: 1.75;
}

/* ── CTA buttons ── */
.uv-hero__cta {
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 56px;
}

.uv-hero__btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #7CB342;
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  padding: 14px 32px;
  border-radius: 100px;
  border: 2px solid #7CB342;
  transition: background 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
}

.uv-hero__btn-primary:hover {
  background: #6aa032;
  border-color: #6aa032;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(124, 179, 66, 0.3);
}

.uv-hero__btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  color: #F3F6F1;
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  padding: 12px 28px;
  border-radius: 100px;
  border: 2px solid rgba(243, 246, 241, 0.35);
  transition: border-color 0.25s ease, background 0.25s ease, transform 0.2s ease;
}

.uv-hero__btn-secondary:hover {
  border-color: #7CB342;
  color: #7CB342;
  transform: translateY(-2px);
  background: rgba(124, 179, 66, 0.06);
}

/* ── Stats glass panel ── */
.uv-hero__stats-panel {
  width: 100%;
  max-width: 720px;
  background: rgba(20, 32, 26, 0.6);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  padding: 4px;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.25);
}

.uv-hero__stats-inner {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  border-radius: 16px;
  overflow: hidden;
}

.uv-hero__stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px 12px;
  gap: 6px;
  text-align: center;
}

.uv-hero__stat-divider {
  width: 1px;
  background: rgba(255, 255, 255, 0.1);
  align-self: stretch;
  margin: 16px 0;
  flex-shrink: 0;
}

.uv-hero__stat-number {
  display: block;
  font-family: 'Space Mono', monospace;
  font-size: clamp(1.3rem, 2.5vw, 1.75rem);
  font-weight: 700;
  color: #7CB342;
  line-height: 1;
}

.uv-hero__stat-label {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 0.68rem;
  font-weight: 500;
  color: rgba(243, 246, 241, 0.6);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  line-height: 1.3;
  max-width: 90px;
}

/* Respect reduced-motion */
@media (prefers-reduced-motion: reduce) {
  .uv-hero__btn-primary:hover,
  .uv-hero__btn-secondary:hover {
    transform: none;
  }

  .uv-hero__flip .fw-word {
    transition: none;
    filter: none;
  }
}

/* Tablet */
@media (max-width: 768px) {
  .uv-hero__content {
    padding: 100px 20px 64px;
  }

  .uv-hero__title {
    font-size: clamp(1.9rem, 8vw, 2.5rem);
  }

  .uv-hero__br {
    display: block;
  }

  .uv-hero__cta {
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 320px;
  }

  .uv-hero__btn-primary,
  .uv-hero__btn-secondary {
    width: 100%;
    justify-content: center;
  }

  .uv-hero__stats-panel {
    max-width: 100%;
  }

  .uv-hero__stat-label {
    font-size: 0.6rem;
  }
}

/* Mobile small */
@media (max-width: 480px) {
  .uv-hero__stats-inner {
    flex-wrap: wrap;
  }

  .uv-hero__stat {
    flex: 0 0 50%;
    padding: 16px 8px;
  }

  .uv-hero__stat-divider {
    display: none;
  }
}
