---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';

const title = 'Solar Control Window Film Philadelphia | Heat & Glare';
const description = 'Solar control window film for Philadelphia homes and offices. Reduce heat, glare, and UV while keeping your view. Free assessment.';

const faqItems = [
  { question: 'What is solar control window film and how does it work?', answer: 'Solar control window film is a thin polyester or ceramic film applied to glass that selectively blocks infrared heat and UV radiation while allowing visible light to pass through. Spectrally selective films use nano-ceramic or multi-layer technology to target heat-producing wavelengths without darkening the glass. The result is a cooler, more comfortable interior without blinds or tinted glass.' },
  { question: 'Will solar film make my space too dark?', answer: 'No. Modern spectrally selective solar films such as 3M Prestige 70 and LLumar ATC70 maintain visible light transmission between 60–72%. Your room stays bright. What is removed is the infrared heat component of sunlight, not the light itself. Many clients report their spaces actually feel more open after installation because they no longer need to keep blinds closed.' },
  { question: 'Does solar film work on double-pane glass?', answer: 'Yes. Solar control film is compatible with most double-pane insulated glass units when the appropriate film product is selected. Certain high-reflective or metallic films can cause thermal stress in sealed double-pane units, which is why product selection matters. We evaluate your glass type and recommend films that are manufacturer-approved for your specific window type.' },
  { question: 'How much heat does solar control film reject?', answer: 'Performance varies by product. 3M Prestige 70 rejects up to 97% of infrared heat at 70% visible light transmission. Solar Gard Panorama series products achieve Solar Heat Gain Coefficient (SHGC) values as low as 0.18 while maintaining clarity. The right product for your space depends on window orientation, climate exposure, and interior comfort goals, all of which we evaluate in your free assessment.' },
  { question: 'Can solar film reduce my energy bills in Philadelphia?', answer: 'Solar control film reduces cooling load by blocking heat before it enters your space, which reduces the work your HVAC system needs to do during Philadelphia summers. According to the 3M Building Energy Performance White Paper (2022), commercial buildings with high glass-to-wall ratios can see annual cooling cost reductions. We do not quote specific dollar savings because results depend on your glass configuration, building orientation, HVAC system, and usage patterns.' },
  { question: 'How long does solar control window film last?', answer: 'Most architectural solar control films carry manufacturer warranties of 10–15 years for commercial applications and 10 years for residential. 3M Prestige series, LLumar architectural series, and Solar Gard Panorama all carry manufacturer-backed warranties. Proper installation by a certified technician is required for warranty eligibility.' },
  { question: "What's the difference between solar film and standard window tint?", answer: 'Standard window tint reduces visible light to reduce heat — the darker the tint, the more heat blocked, but at the cost of natural light. Spectrally selective solar control film uses a different approach: it filters infrared wavelengths specifically, blocking heat without significantly reducing visible light. The result is heat rejection at 70% light transmission that standard tint cannot match without heavy darkening.' },
  { question: 'Will solar control film affect my view of Philadelphia?', answer: 'Spectrally selective films at 60–72% VLT are virtually invisible from inside. Some mild reflective quality is visible from the exterior depending on the product, but modern films are designed to look like standard glass. Films in the 15–35% VLT range will produce a mild tinting effect visible from inside and outside — we discuss this during your assessment so you can make an informed product choice.' },
  { question: 'Does solar film also block UV rays?', answer: 'Yes. Solar control films block up to 99% of UV radiation regardless of VLT level. UV protection is one of the most consistent benefits of solar film — it prevents fading of hardwood floors, upholstery, artwork, merchandise, and other interior surfaces that are damaged by prolonged UV exposure. This applies to both residential and commercial applications.' },
  { question: 'How do I get solar control window film installed in Philadelphia?', answer: 'Contact us for a free assessment. We evaluate your glass orientation, sun exposure, interior comfort goals, and glass type. We then recommend the appropriate solar film for your specific situation and provide a transparent written quote. Our certified installers work around your schedule, including after-hours for commercial clients.' }
];

const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.windowfilmphiladelphia.net/services/" },
      { "@type": "ListItem", "position": 3, "name": "Solar Control Window Film", "item": "https://www.windowfilmphiladelphia.net/services/solar/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.windowfilmphiladelphia.net/services/solar/",
    "name": title,
    "description": description,
    "dateModified": new Date().toISOString().slice(0, 10),
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".sol-hero__title", ".sol-hero__subtitle", ".faq__a-inner"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Solar Control Film Applications",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Philadelphia Rowhouses & Townhomes" },
      { "@type": "ListItem", "position": 2, "name": "Center City Office Buildings" },
      { "@type": "ListItem", "position": 3, "name": "University & Medical Campuses" },
      { "@type": "ListItem", "position": 4, "name": "Retail & Hospitality" },
      { "@type": "ListItem", "position": 5, "name": "Government & Institutional" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Solar Control Window Film Philadelphia",
    "description": "Spectrally selective and solar control window film for Philadelphia homes, offices, and commercial spaces. Reduces heat, glare, and UV while preserving natural light and views.",
    "brand": { "@type": "Brand", "name": "Window Film Philadelphia" },
    "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "areaServed": "Philadelphia, PA" },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "112",
      "bestRating": "5"
    },
    "review": [
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "David R." }, "reviewBody": "We manage a portfolio of Center City offices and the solar film on the south-facing suites made an immediate difference. Tenant complaints about hot desks near windows dropped to zero. The views stayed — the heat did not." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "Maria L." }, "reviewBody": "Our Fishtown rowhome gets brutal afternoon sun in summer. The film on our back windows cut the heat significantly and our hardwood floors stopped fading. We can actually use that room now." },
      { "@type": "Review", "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "author": { "@type": "Person", "name": "James T." }, "reviewBody": "Installed on our Old City shop storefront. The merchandise near the windows was fading constantly. No more fading, customers are more comfortable browsing, and the street view looks completely normal." }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  serviceName="Solar Control Window Film"
  serviceDesc="Spectrally selective solar control window film for Philadelphia homes and offices. Reduces heat, glare, and UV while preserving natural light and views."
  serviceUrl="https://www.windowfilmphiladelphia.net/services/solar/"
  faqItems={faqItems}
  schemas={pageSchemas}
>

  <!-- ══ HERO — Hero Subpage (library component) ══ -->
  <section class="hs">
    <img src="/images/solar-control-window-film-philadelphia-hero.jpg"
         alt="Solar control window film installed in Philadelphia rowhome — warm filtered afternoon light throughout"
         title="Solar control window film installation — Philadelphia rowhome"
         class="hs__bg" loading="eager" />
    <div class="hs__overlay" aria-hidden="true"></div>
    <div class="hs__inner">
      <p class="hs__eyebrow">
        <span class="hs__dot" aria-hidden="true"></span>
        Philadelphia Solar Control
      </p>
      <h1 class="hs__title sol-hero__title">Solar Control Window Film for Philadelphia</h1>
      <p class="hs__sub sol-hero__subtitle">Cut heat and glare without sacrificing your view. Philadelphia's climate demands smarter glass — solar control film delivers it.</p>
      <div class="hs__cta">
        <a href="/contact/" class="hs__btn-primary">Get a Free Assessment</a>
        <a href="/benefits/" class="hs__btn-secondary">All Benefits</a>
      </div>
    </div>
  </section>

  <!-- ══ TRUST BAR ══ -->
  <section class="swt-trust">
    <div class="container">
      <p class="swt-trust__label">Trusted by Philadelphia rowhouse owners, Center City offices, retailers, and university campuses.</p>
      <BrandLogos />
    </div>
  </section>

  <!-- ══ THE CHALLENGE — Accordion Vertical ══ -->
  <section class="sol-accv-wrap">
    <div class="sol-accv-wrap__header">
      <div class="sol-accv-wrap__eyebrow">THE CHALLENGE</div>
      <h2 class="sol-accv-wrap__title split-reveal" data-stagger="65" aria-label="Heat, Glare, and UV Control for Philadelphia Glass.">
        <span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:0">Heat,&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:1">Glare,&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:2">and&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:3">UV&nbsp;</span></span><span class="split-reveal__unit" aria-hidden="true"><span class="split-reveal__inner" style="--i:4">Control.</span></span>
      </h2>
      <p class="sol-accv-wrap__sub">Sun control window film in Philadelphia changes how buildings handle sun exposure — reducing infrared heat, controlling glare, and blocking UV without sacrificing natural light.</p>
    </div>
    <div class="accv">
      <div class="accv__panel is-open" data-panel style="background-image:url('/images/solar-heat-rejection-window-film-philadelphia.jpg')">
        <button class="accv__tab" data-tab aria-expanded="true">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          </span>
          <span class="accv__title">Heat Rejection</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Heat Rejection Film for Philadelphia Buildings</h3>
            <p>Philadelphia summers push surface temps on south- and west-facing glass well above comfort levels. Solar heat gain through untreated glass accounts for up to 40% of a building's total cooling load during peak summer months. Heat transfer through untreated single- or double-pane glass drives HVAC systems harder and creates hot spots near windows that make workstations and living spaces unusable. Window Film Philadelphia installs 3M Prestige 70, which rejects up to 97% of infrared heat while maintaining 70% visible light transmission (NFRC-certified performance data). According to research from the <a href="https://windows.lbl.gov/" target="_blank" rel="noopener">Lawrence Berkeley National Laboratory Windows &amp; Daylighting Group</a>, solar control films applied to existing glass are among the most effective retrofits for reducing solar heat gain and cooling energy demand in commercial and residential buildings.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/glare-reduction-solar-control-film-philadelphia.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="3"/><path d="M4 4l16 16"/></svg>
          </span>
          <span class="accv__title">Glare Control</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>Glare Control Without Losing Your View</h3>
            <p>Screen glare from direct sun forces employees to close blinds — defeating the purpose of a windowed workspace entirely. LLumar's architectural solar series achieves Visible Light Transmission (VLT) values of 15–72% with glare reduction factors up to 85%, enabling precise daylight control without blackout solutions. <a href="/applications/office/">Philadelphia offices</a> in Center City and University City can maintain their city views while eliminating the glare that drives productivity loss.</p>
          </div>
        </div>
      </div>
      <div class="accv__panel" data-panel style="background-image:url('/images/uv-blocking-solar-film-philadelphia-retail.jpg')">
        <button class="accv__tab" data-tab aria-expanded="false">
          <span class="accv__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-5"/></svg>
          </span>
          <span class="accv__title">UV &amp; Fading Protection</span>
        </button>
        <div class="accv__content">
          <div class="accv__desc">
            <h3>UV Blocking for Philadelphia Interiors</h3>
            <p>Solar control films block up to 99% of UVA and UVB radiation regardless of visible tint level. UV exposure causes fading of hardwood floors, upholstery, artwork, and <a href="/applications/retail/">retail merchandise</a> — a costly ongoing problem for Philadelphia storefronts and residential interiors with sun-exposed rooms. Solar film provides full UV protection without changing the appearance of your windows.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ FILM OPTIONS — Bento Photo Grid ══ -->
  <section class="bgp sol-film-bento">
    <div class="bgp__head">
      <div class="bgp__eyebrow">THE FILM OPTIONS</div>
      <h2 class="bgp__title">Which solar film fits your space?</h2>
      <p class="bgp__sub">From spectrally selective nano-ceramic films to low-emissivity climate control — different buildings and orientations call for different solar film solutions.</p>
    </div>
    <div class="bgp__grid">
      <div class="bgp__card bgp__card--lg">
        <img src="/images/solar-heat-rejection-window-film-philadelphia.jpg" alt="Solar heat rejection window film in Philadelphia commercial office building" title="Solar heat rejection window film — Philadelphia office" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Spectrally Selective Films</h3>
          <p>Nano-ceramic technology blocks infrared heat while transmitting 60–72% of visible light. 3M Prestige and LLumar ATC series achieve heat rejection without significant tinting. Ideal for offices and rowhomes where natural light matters.</p>
        </div>
      </div>
      <div class="bgp__card bgp__card--sm">
        <img src="/images/glare-reduction-solar-control-film-philadelphia.jpg" alt="Glare reduction window film for Philadelphia open-plan office screens" title="Glare reduction solar film — Philadelphia office" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Glare Reduction Films</h3>
          <p>Mid-range VLT (35–65%) films provide significant glare reduction for screen-heavy work environments. Solar Gard Panorama series. Suitable for south- and west-facing office windows.</p>
        </div>
      </div>
      <div class="bgp__card bgp__card--sm">
        <img src="/images/uv-blocking-solar-film-philadelphia-retail.jpg" alt="UV blocking solar film protecting Philadelphia retail merchandise from fading" title="UV blocking solar film — Philadelphia retail" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>UV Blocking Films</h3>
          <p>All solar control films block up to 99% UV. High-clarity films prioritize UV and heat rejection with minimal visible tint — ideal for Philadelphia retail, galleries, and residential rooms with artwork or hardwood floors.</p>
        </div>
      </div>
      <div class="bgp__card bgp__card--md">
        <img src="/images/energy-saving-solar-window-film-philadelphia.jpg" alt="Energy saving solar window film on Philadelphia commercial building" title="Energy saving solar control film — Philadelphia commercial" loading="lazy" />
        <div class="bgp__overlay"></div>
        <div class="bgp__body">
          <h3>Low-E Climate Control</h3>
          <p>3M Thinsulate CC75 adds insulating low-emissivity properties to existing glass — reducing both summer cooling load and winter heat loss. Valuable for Philadelphia Class B office buildings with aging single-pane or early double-pane glass.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ HOW SOLAR CONTROL WORKS — Accordion Benefits (4 rows) ══ -->
  <section class="accb">
    <div class="accb__head">
      <h2 class="accb__title">How Solar Control Film Works for Philadelphia Buildings</h2>
      <p class="accb__sub">Each benefit of solar control film addresses a distinct challenge faced by Philadelphia homes, offices, retail spaces, and institutions.</p>
    </div>
    <div class="accb__wrap">
      <div class="accb__list">
        <div class="accb__row is-open" data-row data-index="0">
          <button class="accb__trigger" data-trigger aria-expanded="true">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg></span>
            <span class="accb__row-title">Heat Rejection — Blocking Infrared Before It Enters</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Philadelphia's July and August heat index regularly exceeds 95°F. South- and west-facing glass in rowhomes and high-rises becomes a radiant heat source without film. Spectrally selective films such as 3M Prestige 70 and LLumar ATC70 use nano-ceramic technology to block near-infrared energy while preserving natural light. This reduces interior surface temperatures, eliminates hot spots near window seats and workstations in <a href="/applications/office/">Philadelphia office buildings</a>, and reduces peak cooling load without requiring additional HVAC upgrades. Heat blocking window film for Philadelphia's rowhouses and commercial spaces addresses this without structural changes to your building envelope.</p>
              <img class="accb__mobile-img" src="/images/solar-heat-rejection-window-film-philadelphia.jpg" alt="Solar heat rejection window film reducing hot spots in Philadelphia office" title="Solar heat rejection film — Philadelphia commercial" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="1">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-5"/></svg></span>
            <span class="accb__row-title">UV Protection — Blocking What Causes Fading</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Solar control films block up to 99% of UV radiation — both UVA and UVB. UV exposure is the primary cause of fading in hardwood floors, upholstery, artwork, and merchandise. For Philadelphia <a href="/applications/retail/">retail storefronts</a> on Walnut Street and Chestnut Street, where direct sun exposure through large storefront windows is constant throughout the day, UV-blocking solar film protects inventory and reduces maintenance costs without requiring tinted or reflective glass. Residential rooms with wood floors or artwork near south-facing windows in Fishtown and Society Hill benefit equally.</p>
              <img class="accb__mobile-img" src="/images/uv-blocking-solar-film-philadelphia-retail.jpg" alt="UV protection window film blocking fading in Philadelphia retail store" title="UV protection solar film — Philadelphia retail" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="2">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="3"/><path d="M4 4l16 16"/></svg></span>
            <span class="accb__row-title">Glare Control — Eliminating Screen Glare Without Blinds</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>Screen glare from direct sun costs productivity and forces occupants to close blinds — eliminating the benefits of a windowed environment entirely. Solar Gard Panorama series films achieve Solar Heat Gain Coefficient (SHGC) values as low as 0.18 while maintaining visible light transmission up to 72%. "Spectrally selective window films are the leading solar control solution for commercial buildings precisely because they deliver meaningful heat and glare reduction without sacrificing daylight," according to the International Window Film Association (IWFA). Philadelphia offices in University City and Center City can maintain their city views while eliminating the glare that makes workstations near windows uncomfortable.</p>
              <img class="accb__mobile-img" src="/images/glare-reduction-solar-control-film-philadelphia.jpg" alt="Glare reduction solar window film in Philadelphia open-plan office" title="Glare reduction solar control film — Philadelphia" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="accb__row" data-row data-index="3">
          <button class="accb__trigger" data-trigger aria-expanded="false">
            <span class="accb__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18"/><path d="M12 3v18"/><path d="M5 5l14 14"/><path d="M19 5L5 19"/></svg></span>
            <span class="accb__row-title">Energy Savings — Reducing Cooling Load and HVAC Demand</span>
            <span class="accb__chev" aria-hidden="true">›</span>
          </button>
          <div class="accb__detail">
            <div class="accb__detail-inner">
              <p>3M Thinsulate Climate Control CC75 provides low-emissivity performance on existing single- and double-pane glass — adding insulating properties that reduce both summer cooling and winter heating loads. Window Film Philadelphia recommends this solution for commercial tenants in Class B office buildings with aging glass that does not meet modern energy code standards. Solar control window films can contribute to LEED credits under Energy &amp; Atmosphere (EA) and Indoor Environmental Quality (EQ) categories. The 3M Building Energy Performance White Paper (2022) documents verified energy reductions across multiple commercial installations in comparable northern climate cities.</p>
              <img class="accb__mobile-img" src="/images/energy-saving-solar-window-film-philadelphia.jpg" alt="Energy saving solar control window film reducing cooling load in Philadelphia office" title="Energy saving solar film — Philadelphia commercial building" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
      <div class="accb__media">
        <img class="accb__img is-active" data-img data-index="0" src="/images/solar-heat-rejection-window-film-philadelphia.jpg" alt="Heat rejection solar control window film in Philadelphia commercial office" title="Heat rejection solar control film in Philadelphia" loading="lazy" />
        <img class="accb__img" data-img data-index="1" src="/images/uv-blocking-solar-film-philadelphia-retail.jpg" alt="UV-blocking solar window film protecting Philadelphia retail merchandise from fading" title="UV blocking solar film in Philadelphia" loading="lazy" />
        <img class="accb__img" data-img data-index="2" src="/images/glare-reduction-solar-control-film-philadelphia.jpg" alt="Glare reduction solar window film in Philadelphia open-plan office" title="Glare reduction solar film in Philadelphia" loading="lazy" />
        <img class="accb__img" data-img data-index="3" src="/images/energy-saving-solar-window-film-philadelphia.jpg" alt="Low-E solar control window film reducing energy use in Philadelphia commercial building" title="Energy savings solar control film in Philadelphia" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ══ BEFORE/AFTER SLIDER — Solar Control Film in Action ══ -->
  <section class="sol-slider-wrap">
    <div class="sol-slider-wrap__header">
      <div class="sol-slider-wrap__eyebrow">THE FILM IN ACTION</div>
      <h2 class="sol-slider-wrap__title">Solar Control Film in Action</h2>
      <p class="sol-slider-wrap__sub">Drag the handle to see the difference solar control film makes in a Philadelphia rowhome — cutting harsh glare and heat while preserving the view.</p>
    </div>
    <div class="sol-slider-wrap__slider">
      <div class="before-after" style="--pos:50%">
        <div class="before-after__frame">
          <img src="/images/philadelphia-rowhome-window-glare-before-solar-film.jpg" alt="Philadelphia rowhome windows with harsh glare before solar film — untreated glass" title="Philadelphia rowhome before solar control window film" class="before-after__img before-after__img--before" draggable="false" loading="lazy" />
          <div class="before-after__after-wrap">
            <img src="/images/solar-control-window-film-philadelphia-after-installation.jpg" alt="Philadelphia rowhome after solar control window film installation — soft even light, clear view" title="Solar control window film Philadelphia — rowhome after installation" class="before-after__img before-after__img--after" draggable="false" loading="lazy" />
          </div>
          <span class="before-after__tag before-after__tag--before">Untreated glass</span>
          <span class="before-after__tag before-after__tag--after">Solar film applied</span>
          <div class="before-after__handle" role="slider" tabindex="0" aria-label="Drag to compare untreated Philadelphia glass and solar film applied" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
            <span class="before-after__handle-grip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M8 7L3 12L8 17M16 7L21 12L16 17" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
