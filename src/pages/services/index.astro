/* ─── CINEMATIC BENEFIT CARDS ─── */
.benefits-grid-cinematic {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.benefit-card-cinematic {
  position: relative;
  min-height: 380px;
  border-radius: 16px;
  overflow: hidden;
  background-size: cover;
  background-position: center;
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  opacity: 0;
  transform: translateY(40px);
}
.benefit-card-cinematic.revealed {
  opacity: 1;
  transform: translateY(0);
}
.benefit-card-cinematic__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(13,26,15,0.92) 0%, rgba(13,26,15,0.55) 50%, rgba(13,26,15,0.35) 100%);
  transition: background 0.5s ease;
  z-index: 1;
}
.benefit-card-cinematic:hover .benefit-card-cinematic__overlay {
  background: linear-gradient(to top, rgba(13,26,15,0.95) 0%, rgba(13,26,15,0.65) 50%, rgba(13,26,15,0.45) 100%);
}
.benefit-card-cinematic:hover {
  transform: translateY(-8px);
  box-shadow: 0 24px 60px rgba(13,26,15,0.3);
}
.benefit-card-cinematic:hover::before {
  transform: scale(1.06);
}
.benefit-card-cinematic::before {
  content: '';
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  background-image: inherit;
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 0;
}
.benefit-card-cinematic__content {
  position: relative;
  z-index: 2;
  padding: 32px;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.benefit-card-cinematic__icon {
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}
.benefit-card-cinematic__icon svg {
  width: 32px;
  height: 32px;
  display: block;
}
.benefit-card-cinematic__title {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12px;
  line-height: 1.2;
}
.benefit-card-cinematic__text {
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.85);
  margin-bottom: 16px;
}
.benefit-card-cinematic__stat {
  display: inline-block;
