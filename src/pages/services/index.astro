---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Window Film Services in Philadelphia | Residential & Commercial Installation";
const description = "Professional window film installation services in Philadelphia. Residential, commercial, government, and specialty solutions. Free consultation and expert installation.";
---

<BaseLayout title={title} description={description}>
  
  <!-- Hero Section - Split Screen -->
  <section class="hero-split">
    <div class="hero-split__container">
      <div class="hero-split__content">
        <div class="hero-split__eyebrow">Professional Window Film Installation</div>
        <h1 class="hero-split__title">
          <span class="hero-split__highlight">15 Years</span> Of Experience,<br/>
          Your Assurance Of Quality Service
        </h1>
        <p class="hero-split__text">From residential homes to commercial buildings, we provide expert window film installation services across the Greater Philadelphia area. Our certified installers deliver exceptional results every time.</p>
        <a href="/contact/" class="btn-pill btn-pill--primary">Work With Us</a>
      </div>
      <div class="hero-split__images">
        <div class="hero-split__main-image">
          <img 
            src="https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_1200/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260618_180830_3d905ef9-c9c0-480a-86ed-7b1a99d67033.png"
            alt="Professional window film installation in Philadelphia"
            class="rounded-image"
          />
        </div>
        <div class="hero-split__badge">
          <div class="rating-badge">
            <div class="rating-badge__stars">★★★★★</div>
            <div class="rating-badge__score">4.9</div>
            <div class="rating-badge__label">Google Reviews</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section - Animated Numbers -->
  <section class="stats-modern">
    <div class="stats-modern__container">
      <div class="stat-card">
        <div class="stat-card__number" data-count="2500">0</div>
        <div class="stat-card__label">Happy Clients</div>
      </div>
      <div class="stat-card">
        <div class="stat-card__number" data-count="15">0</div>
        <div class="stat-card__label">Years Of Experience</div>
      </div>
      <div class="stat-card">
        <div class="stat-card__number" data-count="100">0</div>
        <div class="stat-card__label">Percent Satisfaction</div>
      </div>
      <div class="stat-card">
        <div class="stat-card__number" data-count="300">0</div>
        <div class="stat-card__label">5 Star Reviews</div>
      </div>
    </div>
  </section>

  <!-- Our Services - Bento Grid with Images -->
  <section class="services-bento">
    <div class="services-bento__container">
      <div class="services-bento__header">
        <div class="eyebrow-modern">Our Services</div>
        <h2 class="section-title-modern">Complete Window Film Solutions</h2>
      </div>

      <div class="bento-grid">
        
        <!-- Residential - Large Card -->
        <div class="bento-card bento-card--large">
          <div class="bento-card__image">
            <img 
              src="/images/wfp-landing-hero.webp"
              alt="Residential window film installation"
              class="rounded-image"
            />
          </div>
          <div class="bento-card__content">
            <h3 class="bento-card__title">Residential<br/>Window Film</h3>
            <p class="bento-card__description">Protect your home from UV rays, reduce energy costs, and increase privacy with professional residential window film installation.</p>
            <div class="bento-card__stats">
              <div class="mini-stat">
                <span class="mini-stat__number">99%</span>
                <span class="mini-stat__label">UV Protection</span>
              </div>
              <div class="mini-stat">
                <span class="mini-stat__number">30%</span>
                <span class="mini-stat__label">Energy Savings</span>
              </div>
            </div>
            <a href="/services/residential-window-film/" class="btn-pill btn-pill--outline">Learn More →</a>
          </div>
        </div>

        <!-- Commercial -->
        <div class="bento-card">
          <div class="bento-card__image">
            <img 
              src="/images/Window-film-Philadelphia-office-1.webp"
              alt="Commercial window film"
              class="rounded-image"
            />
          </div>
          <div class="bento-card__content">
            <h3 class="bento-card__title">Commercial</h3>
            <p class="bento-card__description">Energy-efficient solutions for offices and businesses.</p>
            <a href="/services/commercial-window-film/" class="link-arrow">Explore →</a>
          </div>
        </div>

        <!-- Government -->
        <div class="bento-card">
          <div class="bento-card__image">
            <img 
              src="/images/university-window-film-philadelphia.webp"
              alt="Government building window film"
              class="rounded-image"
            />
          </div>
          <div class="bento-card__content">
            <h3 class="bento-card__title">Government</h3>
            <p class="bento-card__description">GSA-approved security film for public buildings.</p>
            <a href="/services/government-public/" class="link-arrow">Explore →</a>
          </div>
        </div>

        <!-- Specialty -->
        <div class="bento-card">
          <div class="bento-card__image">
            <img 
              src="/images/safety-window-film-philadelphia.webp"
              alt="Specialty window film"
              class="rounded-image"
            />
          </div>
          <div class="bento-card__content">
            <h3 class="bento-card__title">Specialty Films</h3>
            <p class="bento-card__description">Custom solutions including security and decorative films.</p>
            <a href="/services/specialty/" class="link-arrow">Explore →</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Process Section - Accordion with Photos -->
  <section class="process-split">
    <div class="process-split__container">
      <div class="process-split__content">
        <div class="eyebrow-modern">Our Simple Process</div>
        <h2 class="section-title-modern">How We Work</h2>

        <div class="accordion-modern">
          
          <details class="accordion-item" open>
            <summary class="accordion-item__trigger">
              <span class="accordion-item__number">01</span>
              <span class="accordion-item__title">Free Consultation & Assessment</span>
              <span class="accordion-item__icon">+</span>
            </summary>
            <div class="accordion-item__content">
              <p>We assess your needs, measure your windows, and recommend the best film solutions for your goals and budget. Our certified team provides expert guidance on product selection and expected results.</p>
            </div>
          </details>

          <details class="accordion-item">
            <summary class="accordion-item__trigger">
              <span class="accordion-item__number">02</span>
              <span class="accordion-item__title">Custom Quote & Product Selection</span>
              <span class="accordion-item__icon">+</span>
            </summary>
            <div class="accordion-item__content">
              <p>Receive a detailed written quote with product options, pricing breakdown, and timeline. No hidden fees, no pressure to decide on the spot. We help you choose the perfect film for your specific needs.</p>
            </div>
          </details>

          <details class="accordion-item">
            <summary class="accordion-item__trigger">
              <span class="accordion-item__number">03</span>
              <span class="accordion-item__title">Professional Installation</span>
              <span class="accordion-item__icon">+</span>
            </summary>
            <div class="accordion-item__content">
              <p>Our factory-trained installers complete the job efficiently with minimal disruption to your home or business. We use industry-leading techniques and tools to ensure perfect results.</p>
            </div>
          </details>

          <details class="accordion-item">
            <summary class="accordion-item__trigger">
              <span class="accordion-item__number">04</span>
              <span class="accordion-item__title">Quality Guarantee & Warranty</span>
              <span class="accordion-item__icon">+</span>
            </summary>
            <div class="accordion-item__content">
              <p>All installations backed by our satisfaction guarantee and manufacturer warranty coverage. We stand behind our work and the products we install, giving you peace of mind for years to come.</p>
            </div>
          </details>

        </div>
      </div>

      <div class="process-split__image">
        <img 
          src="/images/madico-window-film-contractor-philadelphia.png"
          alt="Window Film Philadelphia certified installer"
          class="rounded-image-large"
        />
      </div>
    </div>
  </section>

  <!-- Why Choose Us - Split with Bubbles -->
  <section class="why-modern">
    <div class="why-modern__container">
      <div class="why-modern__image">
        <img 
          src="/images/bar-window-film-philadelphia-1.jpg"
          alt="Professional window film installation"
          class="rounded-image-large"
        />
        <div class="bubble-stat bubble-stat--1">
          <div class="bubble-stat__number">15+</div>
          <div class="bubble-stat__label">Years</div>
        </div>
        <div class="bubble-stat bubble-stat--2">
          <div class="bubble-stat__number">100%</div>
          <div class="bubble-stat__label">Satisfaction</div>
        </div>
      </div>
      <div class="why-modern__content">
        <div class="eyebrow-modern">Why Choose Window Film Philadelphia</div>
        <h2 class="section-title-modern">Trusted By Philadelphia Since 2009</h2>
        <p class="why-modern__text">We've built our reputation on quality workmanship, premium products, and exceptional customer service. Our team is factory-trained and certified by leading manufacturers including 3M, LLumar, and Madico.</p>
        
        <div class="feature-list">
          <div class="feature-item">
            <div class="feature-item__icon">✓</div>
            <div class="feature-item__content">
              <strong>Factory-Trained Installers</strong>
              <span>Certified by 3M, LLumar, Madico</span>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-item__icon">✓</div>
            <div class="feature-item__content">
              <strong>Premium Products Only</strong>
              <span>Top-tier films from trusted brands</span>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-item__icon">✓</div>
            <div class="feature-item__content">
              <strong>Lifetime Warranty</strong>
              <span>Manufacturer warranty plus installation guarantee</span>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-item__icon">✓</div>
            <div class="feature-item__content">
              <strong>Free Consultation</strong>
              <span>No-obligation assessment and quote</span>
            </div>
          </div>
        </div>

        <a href="/contact/" class="btn-pill btn-pill--primary">Schedule Free Consultation</a>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="areas-modern">
    <div class="areas-modern__container">
      <div class="areas-modern__header">
        <div class="eyebrow-modern">Service Coverage</div>
        <h2 class="section-title-modern">Serving Greater Philadelphia</h2>
      </div>

      <div class="areas-grid">
        <div class="area-bubble">
          <h3>Philadelphia</h3>
          <p>Center City · University City · South Philly · Northeast · Northwest</p>
        </div>
        <div class="area-bubble">
          <h3>Montgomery County</h3>
          <p>King of Prussia · Norristown · Lansdale · Ambler</p>
        </div>
        <div class="area-bubble">
          <h3>Delaware County</h3>
          <p>Media · Broomall · Havertown · Springfield</p>
        </div>
        <div class="area-bubble">
          <h3>Chester County</h3>
          <p>West Chester · Exton · Malvern · Phoenixville</p>
        </div>
        <div class="area-bubble">
          <h3>Bucks County</h3>
          <p>Doylestown · Newtown · Warrington · Yardley</p>
        </div>
        <div class="area-bubble">
          <h3>Camden County</h3>
          <p>Cherry Hill · Voorhees · Haddonfield · Marlton</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="cta-modern">
    <div class="cta-modern__container">
      <h2 class="cta-modern__title">Ready To Transform Your Space?</h2>
      <p class="cta-modern__subtitle">Schedule your free consultation today and discover how window film can enhance comfort, reduce costs, and protect your property.</p>
      <div class="cta-modern__buttons">
        <a href="/contact/" class="btn-pill btn-pill--primary btn-pill--large">Get Free Quote</a>
        <a href="tel:2673947980" class="btn-pill btn-pill--outline btn-pill--large">(267) 394-7980</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ─── MODERN RESET ─── */
.hero-split,
.stats-modern,
.services-bento,
.process-split,
.why-modern,
.areas-modern,
.cta-modern {
  opacity: 0;
  animation: fadeInUp 0.8s ease-out forwards;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(40px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ─── HERO SPLIT ─── */
.hero-split {
  background: #F5F3EE;
  padding: 140px 0 100px;
  position: relative;
  overflow: hidden;
}
.hero-split__container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.hero-split__eyebrow {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #7CB342;
  margin-bottom: 20px;
}
.hero-split__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 700;
  color: #14201A;
  line-height: 1.1;
  margin-bottom: 28px;
}
.hero-split__highlight {
  position: relative;
  display: inline-block;
}
.hero-split__highlight:after {
  content: '';
  position: absolute;
  bottom: 8px;
  left: 0;
  right: 0;
  height: 12px;
  background: #7CB342;
  opacity: 0.3;
  z-index: -1;
  border-radius: 4px;
}
.hero-split__text {
  font-family: 'Inter', sans-serif;
  font-size: 1.125rem;
  line-height: 1.7;
  color: #4A5C48;
  margin-bottom: 36px;
  max-width: 540px;
}
.hero-split__images {
  position: relative;
}
.hero-split__main-image {
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(20,32,26,0.15);
}
.hero-split__badge {
  position: absolute;
  bottom: 32px;
  right: 32px;
  animation: float 6s ease-in-out infinite;
}
.rating-badge {
  background: #14201A;
  color: #fff;
  border-radius: 50%;
  width: 100px;
  height: 100px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
}
.rating-badge__stars {
  color: #7CB342;
  font-size: 14px;
  margin-bottom: 4px;
}
.rating-badge__score {
  font-family: 'Playfair Display', serif;
  font-size: 28px;
  font-weight: 700;
  line-height: 1;
}
.rating-badge__label {
  font-family: 'Inter', sans-serif;
  font-size: 10px;
  opacity: 0.7;
  margin-top: 2px;
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-20px); }
}

/* ─── STATS MODERN ─── */
.stats-modern {
  background: #fff;
  padding: 0;
  margin-top: -50px;
  position: relative;
  z-index: 10;
}
.stats-modern__container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.stat-card {
  background: #F5F3EE;
  border-radius: 20px;
  padding: 48px 32px;
  text-align: center;
  transition: transform 0.3s, box-shadow 0.3s;
}
.stat-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 12px 40px rgba(20,32,26,0.12);
}
.stat-card__number {
  font-family: 'Playfair Display', serif;
  font-size: 4rem;
  font-weight: 700;
  color: #14201A;
  line-height: 1;
  margin-bottom: 12px;
}
.stat-card__number:after {
  content: '+';
  color: #7CB342;
  margin-left: 4px;
}
.stat-card__label {
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  color: #4A5C48;
  font-weight: 500;
}

/* ─── SERVICES BENTO ─── */
.services-bento {
  padding: 120px 0;
  background: #fff;
}
.services-bento__container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
}
.services-bento__header {
  text-align: center;
  margin-bottom: 60px;
}
.eyebrow-modern {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #7CB342;
  margin-bottom: 12px;
}
.section-title-modern {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 4vw, 3.5rem);
  font-weight: 700;
  color: #14201A;
  line-height: 1.15;
}
.bento-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.bento-card {
  background: #F5F3EE;
  border-radius: 24px;
  overflow: hidden;
  transition: transform 0.4s ease, box-shadow 0.4s ease;
}
.bento-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 60px rgba(20,32,26,0.15);
}
.bento-card--large {
  grid-column: span 2;
  grid-row: span 2;
}
.bento-card__image {
  width: 100%;
  height: 200px;
  overflow: hidden;
}
.bento-card--large .bento-card__image {
  height: 320px;
}
.bento-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.bento-card:hover .bento-card__image img {
  transform: scale(1.05);
}
.bento-card__content {
  padding: 32px;
}
.bento-card--large .bento-card__content {
  padding: 40px;
}
.bento-card__title {
  font-family: 'Playfair Display', serif;
  font-size: 1.75rem;
  font-weight: 700;
  color: #14201A;
  line-height: 1.2;
  margin-bottom: 16px;
}
.bento-card__description {
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  line-height: 1.7;
  color: #4A5C48;
  margin-bottom: 24px;
}
.bento-card__stats {
  display: flex;
  gap: 32px;
  margin-bottom: 24px;
}
.mini-stat__number {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  font-weight: 700;
  color: #7CB342;
  display: block;
  line-height: 1;
}
.mini-stat__label {
  font-family: 'Inter', sans-serif;
  font-size: 0.75rem;
  color: #4A5C48;
  display: block;
  margin-top: 4px;
}
.link-arrow {
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  color: #7CB342;
  text-decoration: none;
  transition: gap 0.3s;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.link-arrow:hover {
  gap: 12px;
}

/* ─── BUTTON PILLS ─── */
.btn-pill {
  display: inline-block;
  padding: 14px 32px;
  border-radius: 100px;
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s;
  cursor: pointer;
}
.btn-pill--primary {
  background: #7CB342;
  color: #fff;
  border: 2px solid #7CB342;
}
.btn-pill--primary:hover {
  background: #2E6B30;
  border-color: #2E6B30;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(124,179,66,0.3);
}
.btn-pill--outline {
  background: transparent;
  color: #14201A;
  border: 2px solid #14201A;
}
.btn-pill--outline:hover {
  background: #14201A;
  color: #fff;
  transform: translateY(-2px);
}
.btn-pill--large {
  padding: 18px 42px;
  font-size: 1.05rem;
}

/* ─── PROCESS SPLIT ─── */
.process-split {
  padding: 120px 0;
  background: #F5F3EE;
}
.process-split__container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: start;
}
.accordion-modern {
  margin-top: 40px;
}
.accordion-item {
  background: #fff;
  border-radius: 16px;
  margin-bottom: 16px;
  overflow: hidden;
  transition: box-shadow 0.3s;
}
.accordion-item:hover {
  box-shadow: 0 8px 32px rgba(20,32,26,0.08);
}
.accordion-item__trigger {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 28px 32px;
  cursor: pointer;
  list-style: none;
  user-select: none;
}
.accordion-item__trigger::-webkit-details-marker {
  display: none;
}
.accordion-item__number {
  font-family: 'Space Mono', monospace;
  font-size: 1.25rem;
  font-weight: 700;
  color: #7CB342;
  flex-shrink: 0;
}
.accordion-item__title {
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  font-weight: 600;
  color: #14201A;
  flex: 1;
}
.accordion-item__icon {
  font-size: 2rem;
  color: #7CB342;
  font-weight: 300;
  transition: transform 0.3s;
  flex-shrink: 0;
  line-height: 1;
}
.accordion-item[open] .accordion-item__icon {
  transform: rotate(45deg);
}
.accordion-item__content {
  padding: 0 32px 32px 32px;
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  line-height: 1.7;
  color: #4A5C48;
}
.rounded-image-large {
  width: 100%;
  height: auto;
  border-radius: 24px;
  box-shadow: 0 20px 60px rgba(20,32,26,0.15);
}

/* ─── WHY MODERN ─── */
.why-modern {
  padding: 120px 0;
  background: #fff;
}
.why-modern__container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.why-modern__image {
  position: relative;
}
.bubble-stat {
  position: absolute;
  background: #fff;
  border-radius: 50%;
  width: 120px;
  height: 120px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12px 40px rgba(20,32,26,0.2);
  animation: float 6s ease-in-out infinite;
}
.bubble-stat--1 {
  top: 40px;
  right: -20px;
  animation-delay: 0s;
}
.bubble-stat--2 {
  bottom: 60px;
  left: -30px;
