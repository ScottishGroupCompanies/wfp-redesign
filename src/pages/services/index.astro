---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Professional Window Film Services in Philadelphia | Window Film Philadelphia";
const description = "Residential, commercial, government, and specialty window film installation services across Philadelphia and the Delaware Valley. UV protection, energy savings, security film, and more. Free consultation.";

const serviceCategories = [
  {
    id: 'residential',
    title: 'Residential',
    subtitle: 'Home Window Film',
    icon: '🏠',
    gradient: 'from-emerald-500 to-teal-600',
    image: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_1200/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260618_180830_3d905ef9-c9c0-480a-86ed-7b1a99d67033.png',
    description: `Transform your home with professional window film that blocks 99% UV rays, reduces energy costs, and enhances privacy—all while maintaining your views.`,
    features: [
      { label: 'UV Protection', value: '99%', icon: '☀️' },
      { label: 'Energy Savings', value: '30%', icon: '⚡' },
      { label: 'Privacy', value: '100%', icon: '🔒' },
    ],
    href: '/services/residential-window-film',
  },
  {
    id: 'commercial',
    title: 'Commercial',
    subtitle: 'Office & Retail',
    icon: '🏢',
    gradient: 'from-blue-500 to-indigo-600',
    image: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_1200/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260618_180834_da6c0b4c-131e-4533-a508-e5062f7151bf.png',
    description: `Professional-grade window film for commercial properties. Lower HVAC costs, improve employee comfort, and protect your assets.`,
    features: [
      { label: 'Cost Reduction', value: '30%', icon: '💰' },
      { label: 'Glare Control', value: '95%', icon: '👁️' },
      { label: 'LEED Certified', value: '✓', icon: '🌱' },
    ],
    href: '/services/commercial-window-film',
  },
  {
    id: 'government',
    title: 'Government',
    subtitle: 'Public Buildings',
    icon: '🏛️',
    gradient: 'from-purple-500 to-pink-600',
    image: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_1200/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260618_180838_c6204d09-6df5-4ce1-9ce1-88e6beb2edf3.png',
    description: `GSA-compliant security film for government facilities, schools, and public institutions. Blast mitigation and forced-entry protection.`,
    features: [
      { label: 'GSA Approved', value: '✓', icon: '🛡️' },
      { label: 'Blast Protection', value: 'Level 3', icon: '💥' },
      { label: 'Safety Rating', value: 'A+++', icon: '⭐' },
    ],
    href: '/services/government-public',
  },
  {
    id: 'specialty',
    title: 'Specialty',
    subtitle: 'Advanced Solutions',
    icon: '⚙️',
    gradient: 'from-orange-500 to-red-600',
    image: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_1200/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260618_180843_4208f147-4ab4-48b8-a0b3-2dfac307e265.png',
    description: `Bomb blast protection, ballistic resistance, bird strike prevention, and exterior refinishing—engineered to your exact specifications.`,
    features: [
      { label: 'Blast Rated', value: 'DoD', icon: '💣' },
      { label: 'Ballistic', value: 'UL 752', icon: '🎯' },
      { label: 'Bird Safe', value: '90%', icon: '🦅' },
    ],
    href: '/services/specialty',
  },
];

const neighborhoods = [
  'Center City', 'Rittenhouse Square', 'Fishtown', 'Chestnut Hill',
  'Old City', 'University City', 'Northern Liberties', 'Queen Village',
  'Society Hill', 'Graduate Hospital', 'Manayunk', 'East Falls',
  'Fairmount', 'Passyunk Square', 'Bella Vista', 'Washington Square West',
  'Mt. Airy', 'West Philadelphia', 'South Philadelphia',
];

const processSteps = [
  {
    number: '01',
    title: 'Free Consultation',
    description: `We visit your property, assess your needs, and recommend the right film for your specific challenges—whether it's heat, glare, privacy, or security.`,
  },
  {
    number: '02',
    title: 'Precise Measurement',
    description: `Every window is measured to the millimeter. We template complex shapes and custom cuts in our shop before installation day.`,
  },
  {
    number: '03',
    title: 'Expert Installation',
    description: `Factory-trained technicians apply film using professional tools and techniques. Most projects complete in 1-2 days with minimal disruption.`,
  },
  {
    number: '04',
    title: 'Lifetime Warranty',
    description: `All installations backed by manufacturer and workmanship warranties. We stand behind our work—done right, every time.`,
  },
];

const stats = [
  { value: '2,500+', label: 'Installations', icon: '📊' },
  { value: '15+', label: 'Years Experience', icon: '🏆' },
  { value: '4.9/5', label: 'Rating', icon: '⭐' },
  { value: '99%', label: 'Satisfaction', icon: '💯' },
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section with Animated Gradient Background -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Animated Gradient Mesh Background -->
    <div class="absolute inset-0 bg-gradient-to-br from-emerald-50 via-teal-50 to-cyan-50">
      <div class="absolute inset-0 opacity-30">
        <div class="absolute top-0 -left-4 w-96 h-96 bg-emerald-400 rounded-full mix-blend-multiply filter blur-3xl animate-blob"></div>
        <div class="absolute top-0 -right-4 w-96 h-96 bg-teal-400 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"></div>
        <div class="absolute -bottom-8 left-20 w-96 h-96 bg-cyan-400 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-4000"></div>
      </div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 text-center">
      <!-- Floating Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 backdrop-blur-sm rounded-full shadow-lg mb-8 animate-fade-in-down">
        <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
        <span class="text-sm font-medium text-gray-700">Philadelphia's Trusted Window Film Experts</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-6xl md:text-7xl lg:text-8xl font-bold text-gray-900 mb-6 animate-fade-in-up">
        Professional
        <span class="block bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent">
          Window Film Services
        </span>
      </h1>

      <p class="text-xl md:text-2xl text-gray-600 max-w-3xl mx-auto mb-12 animate-fade-in-up animation-delay-200">
        Transform your space with advanced window film technology. Energy savings, UV protection, security, and privacy solutions for homes and businesses across Philadelphia.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-fade-in-up animation-delay-400">
        <a 
          href="/contact" 
          class="group relative px-8 py-4 bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-semibold rounded-full overflow-hidden transition-all duration-300 hover:shadow-2xl hover:scale-105"
        >
          <span class="relative z-10">Get Free Quote</span>
          <div class="absolute inset-0 bg-gradient-to-r from-teal-600 to-emerald-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </a>
        <a 
          href="tel:2673947980" 
          class="px-8 py-4 bg-white/80 backdrop-blur-sm text-gray-900 font-semibold rounded-full border-2 border-gray-200 hover:border-emerald-500 transition-all duration-300 hover:shadow-xl"
        >
          (267) 394-7980
        </a>
      </div>

      <!-- Floating Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-20 max-w-4xl mx-auto">
        {stats.map((stat, i) => (
          <div 
            class="bg-white/80 backdrop-blur-sm rounded-2xl p-6 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 animate-fade-in-up"
            style={`animation-delay: ${600 + i * 100}ms`}
          >
            <div class="text-4xl mb-2">{stat.icon}</div>
            <div class="text-3xl font-bold text-gray-900 mb-1">{stat.value}</div>
            <div class="text-sm text-gray-600">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- Service Categories - Bento Grid -->
  <section class="py-32 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2 class="text-5xl md:text-6xl font-bold text-gray-900 mb-4">
          Our <span class="bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent">Services</span>
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Specialized window film solutions for every application
        </p>
      </div>

      <!-- Bento Grid Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {serviceCategories.map((service, index) => (
          <a 
            href={service.href}
            class="group relative overflow-hidden rounded-3xl bg-white shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-2"
            style={`animation: fade-in-up 0.6s ease-out ${index * 0.1}s both`}
          >
            <!-- Background Image with Parallax Effect -->
            <div class="absolute inset-0 overflow-hidden">
              <img 
                src={service.image} 
                alt={service.title}
                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                loading="lazy"
              />
              <div class={`absolute inset-0 bg-gradient-to-br ${service.gradient} opacity-60 group-hover:opacity-70 transition-opacity`}></div>
            </div>

            <!-- Content -->
            <div class="relative z-10 p-8 md:p-12 min-h-[500px] flex flex-col justify-between">
              <!-- Top Section -->
              <div>
                <div class="text-6xl mb-4 transform group-hover:scale-110 transition-transform">{service.icon}</div>
                <h3 class="text-4xl font-bold text-white mb-2">{service.title}</h3>
                <p class="text-xl text-white/90 mb-6">{service.subtitle}</p>
                <p class="text-white/80 text-lg leading-relaxed">
                  {service.description}
                </p>
              </div>

              <!-- Features Grid -->
              <div class="grid grid-cols-3 gap-4 mt-8">
                {service.features.map(feature => (
                  <div class="bg-white/20 backdrop-blur-sm rounded-xl p-4 text-center">
                    <div class="text-2xl mb-1">{feature.icon}</div>
                    <div class="text-2xl font-bold text-white mb-1">{feature.value}</div>
                    <div class="text-xs text-white/80">{feature.label}</div>
                  </div>
                ))}
              </div>

              <!-- Learn More Button -->
              <div class="mt-8 flex items-center text-white font-semibold group-hover:gap-4 gap-2 transition-all">
                <span>Learn More</span>
                <svg class="w-5 h-5 transform group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section with Timeline -->
  <section class="py-32 bg-gradient-to-br from-gray-900 to-gray-800 text-white relative overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2 class="text-5xl md:text-6xl font-bold mb-4">
          How It <span class="bg-gradient-to-r from-emerald-400 to-teal-400 bg-clip-text text-transparent">Works</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Professional installation in 4 simple steps
        </p>
      </div>

      <!-- Timeline -->
      <div class="relative">
        <!-- Vertical Line -->
        <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-emerald-500 via-teal-500 to-cyan-500"></div>

        <!-- Steps -->
        <div class="space-y-16">
          {processSteps.map((step, index) => (
            <div class={`relative flex items-center ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
              <!-- Number Circle -->
              <div class="absolute left-0 md:left-1/2 md:-translate-x-1/2 w-16 h-16 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-full flex items-center justify-center shadow-2xl z-10">
                <span class="text-2xl font-bold">{step.number}</span>
              </div>

              <!-- Content Card -->
              <div class={`ml-24 md:ml-0 ${index % 2 === 0 ? 'md:mr-auto md:pr-16' : 'md:ml-auto md:pl-16'} md:w-1/2`}>
                <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 hover:bg-white/20 transition-all duration-300 hover:scale-105">
                  <h3 class="text-2xl font-bold mb-3">{step.title}</h3>
                  <p class="text-gray-300 leading-relaxed">{step.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Neighborhoods Section - Glassmorphism Cards -->
  <section class="py-32 bg-gradient-to-br from-emerald-50 via-teal-50 to-cyan-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-5xl md:text-6xl font-bold text-gray-900 mb-4">
          Serving <span class="bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent">Philadelphia</span>
        </h2>
        <p class="text-xl text-gray-600">
          Professional window film installation across the Delaware Valley
        </p>
      </div>

      <!-- Glassmorphism Grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {neighborhoods.map((hood, i) => (
          <div 
            class="group relative overflow-hidden rounded-2xl bg-white/60 backdrop-blur-md border border-white/20 p-6 hover:bg-white/80 transition-all duration-300 hover:scale-105 hover:shadow-xl"
            style={`animation: fade-in-up 0.4s ease-out ${i * 0.02}s both`}
          >
            <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/10 to-teal-500/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <p class="relative z-10 text-center font-semibold text-gray-800 group-hover:text-emerald-700 transition-colors">
              {hood}
            </p>
          </div>
        ))}
      </div>

      <div class="text-center mt-12">
        <p class="text-gray-600 mb-6">Plus Cherry Hill, Camden, Wilmington, and the entire Delaware Valley</p>
        <a 
          href="/contact" 
          class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-semibold rounded-full hover:shadow-2xl hover:scale-105 transition-all"
        >
          <span>Schedule Free Consultation</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="py-32 bg-gradient-to-br from-gray-900 to-gray-800 text-white relative overflow-hidden">
    <!-- Animated Background -->
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-emerald-500 rounded-full mix-blend-multiply filter blur-3xl animate-blob"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-teal-500 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-5xl md:text-6xl font-bold mb-6">
        Ready to Transform Your Windows?
      </h2>
      <p class="text-xl text-gray-300 mb-12 max-w-2xl mx-auto">
        Get a free consultation and quote. Our experts will assess your needs and recommend the perfect window film solution.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <a 
          href="/contact" 
          class="px-10 py-5 bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-bold rounded-full text-lg hover:shadow-2xl hover:scale-105 transition-all"
        >
          Get Free Quote
        </a>
        <a 
          href="tel:2673947980" 
          class="px-10 py-5 bg-white/10 backdrop-blur-sm text-white font-bold rounded-full text-lg border-2 border-white/20 hover:bg-white/20 transition-all"
        >
          (267) 394-7980
        </a>
      </div>

      <p class="mt-8 text-gray-400">
        Done right, every time. <span class="text-emerald-400">Lifetime warranty on all installations.</span>
      </p>
    </div>
  </section>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Window Film Installation",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Window Film Philadelphia",
      "telephone": "(267) 394-7980",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Philadelphia",
        "addressRegion": "PA"
      }
    },
    "areaServed": neighborhoods.map(hood => ({
      "@type": "City",
      "name": hood + ", Philadelphia, PA"
    }))
  })} />

  <!-- Custom Animations -->
  <style>
    @keyframes fade-in-down {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fade-in-up {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes blob {
      0%, 100% {
        transform: translate(0, 0) scale(1);
      }
      33% {
        transform: translate(30px, -50px) scale(1.1);
      }
      66% {
        transform: translate(-20px, 20px) scale(0.9);
      }
    }

    .animate-fade-in-down {
      animation: fade-in-down 0.6s ease-out;
    }

    .animate-fade-in-up {
      animation: fade-in-up 0.6s ease-out;
    }

    .animate-blob {
      animation: blob 7s infinite;
    }

    .animation-delay-200 {
      animation-delay: 200ms;
    }

    .animation-delay-400 {
      animation-delay: 400ms;
    }

    .animation-delay-2000 {
      animation-delay: 2s;
    }

    .animation-delay-4000 {
      animation-delay: 4s;
    }

    /* Smooth scroll behavior */
    html {
      scroll-behavior: smooth;
    }

    /* Glassmorphism effect */
    .backdrop-blur-sm {
      backdrop-filter: blur(8px);
    }

    .backdrop-blur-md {
      backdrop-filter: blur(12px);
    }
  </style>
</BaseLayout>
