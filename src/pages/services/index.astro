<script>
// ─── COUNT-UP ANIMATION ─── 
function animateCounter(element: HTMLElement) {
  const targetStr = element.getAttribute('data-count') || '0';
  const target = parseFloat(targetStr);
  const isDecimal = targetStr.includes('.');
  const duration = 2000;
  const frameDuration = 1000 / 60;
  const totalFrames = Math.round(duration / frameDuration);
  let frame = 0;

  const counter = setInterval(() => {
    frame++;
    const progress = frame / totalFrames;
    const current = target * progress;
    element.textContent = isDecimal ? current.toFixed(1) : Math.round(current).toString();

    if (frame === totalFrames) {
      clearInterval(counter);
      element.textContent = isDecimal ? target.toFixed(1) : target.toString();
    }
  }, frameDuration);
}

// Intersection Observer for counter animation
const observerOptions = {
  threshold: 0.5,
  rootMargin: '0px'
};

const counterObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting && !entry.target.classList.contains('counted')) {
      entry.target.classList.add('counted');
      animateCounter(entry.target as HTMLElement);
    }
  });
}, observerOptions);

// Observe all counter elements (both stat-card and hero-stat-item)
document.querySelectorAll('.stat-card__number, .hero-stat-item__number').forEach(el => {
  counterObserver.observe(el);
});

// ─── SCROLL REVEAL ANIMATION ─── 
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach((entry, index) => {
    if (entry.isIntersecting) {
      setTimeout(() => {
        entry.target.classList.add('revealed');
      }, index * 100);
    }
  });
}, {
  threshold: 0.1,
  rootMargin: '0px 0px -50px 0px'
});

document.querySelectorAll('.bento-card, .benefit-bubble, .benefit-card-cinematic, .area-bubble, .brand-card, .feature-item').forEach(el => {
  revealObserver.observe(el);
});

// ─── ACCORDION ICON ROTATION ─── 
document.querySelectorAll('.accordion-item').forEach(item => {
  item.addEventListener('toggle', () => {
    if (item.hasAttribute('open')) {
      item.querySelector('.accordion-item__icon')?.classList.add('rotated');
    } else {
      item.querySelector('.accordion-item__icon')?.classList.remove('rotated');
    }
  });
});

// ─── STATEMENT HIGHLIGHT ANIMATION ─── 
const statementObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting && !entry.target.classList.contains('active')) {
      entry.target.classList.add('active');
      // Unobserve after activation (animation runs once)
      statementObserver.unobserve(entry.target);
    }
  });
}, {
  threshold: 0.3,
  rootMargin: '0px 0px -100px 0px'
});

const statementElement = document.querySelector('[data-statement]');
if (statementElement) {
  statementObserver.observe(statementElement);
}

// ─── WHY MODERN: IMAGE CONTAINER FADE-IN & PARALLAX ───
const whyImageContainer = document.querySelector('.why-modern__image-container');
if (whyImageContainer) {
  // Fade in image container on scroll into view
  const whyObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        whyObserver.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.2,
    rootMargin: '0px 0px -50px 0px'
  });
  whyObserver.observe(whyImageContainer);

  // Parallax effect on glass-stat cards (desktop only)
  if (window.innerWidth > 1024) {
    const glassStats = document.querySelectorAll('.glass-stat');
    let ticking = false;

    function updateParallax() {
      const rect = whyImageContainer.getBoundingClientRect();
      const isInView = rect.top < window.innerHeight && rect.bottom > 0;
      
      if (isInView) {
        const scrollPercentage = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);
        
        glassStats.forEach((stat: HTMLElement) => {
          const speed = parseFloat(stat.getAttribute('data-parallax') || '0.3');
          const movement = (scrollPercentage - 0.5) * 40 * speed;
          
          // Preserve the vertical centering for glass-stat--3
          if (stat.classList.contains('glass-stat--3')) {
            stat.style.transform = `translateY(calc(-50% + ${movement}px))`;
          } else {
            stat.style.transform = `translateY(${movement}px)`;
          }
        });
      }
      
      ticking = false;
    }

    function requestParallax() {
      if (!ticking) {
        window.requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }

    window.addEventListener('scroll', requestParallax, { passive: true });
    window.addEventListener('resize', requestParallax, { passive: true });
    
    // Initial position
    updateParallax();
  }
}
</script>
