---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Window Film Services in Philadelphia | Residential & Commercial Installation";
const description = "Professional window film installation services in Philadelphia. Residential, commercial, government, and specialty solutions. Free consultation and expert installation.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <section class="services-hero">
    <div class="services-hero__container">
      <div class="services-hero__content">
        <div class="services-hero__eyebrow">Professional Installation</div>
        <h1 class="services-hero__title">Complete Window Film Solutions for Philadelphia</h1>
        <p class="services-hero__subtitle">From residential homes to commercial buildings, we provide expert window film installation services across the Greater Philadelphia area.</p>
        <div class="services-hero__ctas">
          <a href="/contact/" class="btn btn--primary">Get Free Quote</a>
          <a href="tel:2673947980" class="btn btn--outline-light">(267) 394-7980</a>
        </div>
      </div>
      <div class="services-hero__image">
        <img 
          src="https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_1200/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260618_180830_3d905ef9-c9c0-480a-86ed-7b1a99d67033.png"
          alt="Professional window film installation in Philadelphia home"
          class="services-hero__img"
        />
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="services-types">
    <div class="container">
      <div class="services-types__header">
        <h2 class="section-h2">Our Services</h2>
        <p class="section-sub">Expert window film installation for every application</p>
      </div>

      <div class="services-types__grid">
        
        <!-- Residential -->
        <div class="service-card">
          <div class="service-card__image">
            <img 
              src="/images/wfp-landing-hero.webp"
              alt="Residential window film installation Philadelphia"
            />
          </div>
          <div class="service-card__content">
            <h3 class="service-card__title">Residential Window Film</h3>
            <p class="service-card__description">Protect your home from UV rays, reduce energy costs, and increase privacy with professional residential window film installation.</p>
            <ul class="service-card__features">
              <li>UV Protection (99%)</li>
              <li>Energy Savings up to 30%</li>
              <li>Glare Reduction</li>
              <li>Privacy Enhancement</li>
              <li>Fade Protection for Furniture</li>
            </ul>
            <a href="/services/residential-window-film/" class="service-card__link">Learn More →</a>
          </div>
        </div>

        <!-- Commercial -->
        <div class="service-card">
          <div class="service-card__image">
            <img 
              src="/images/Window-film-Philadelphia-office-1.webp"
              alt="Commercial window film installation Philadelphia office"
            />
          </div>
          <div class="service-card__content">
            <h3 class="service-card__title">Commercial Window Film</h3>
            <p class="service-card__description">Enhance your workspace with energy-efficient, professional-grade window film solutions designed for commercial properties.</p>
            <ul class="service-card__features">
              <li>Reduce HVAC Costs by 30%</li>
              <li>Improve Employee Comfort</li>
              <li>LEED Certification Support</li>
              <li>Branded & Decorative Options</li>
              <li>Fast Installation, Minimal Disruption</li>
            </ul>
            <a href="/services/commercial-window-film/" class="service-card__link">Learn More →</a>
          </div>
        </div>

        <!-- Government & Public -->
        <div class="service-card">
          <div class="service-card__image">
            <img 
              src="/images/university-window-film-philadelphia.webp"
              alt="Government building window film Philadelphia"
            />
          </div>
          <div class="service-card__content">
            <h3 class="service-card__title">Government & Public Buildings</h3>
            <p class="service-card__description">GSA-approved security film solutions for government facilities, schools, and public institutions.</p>
            <ul class="service-card__features">
              <li>GSA Approved Products</li>
              <li>Blast & Impact Resistance</li>
              <li>Safety & Security Film</li>
              <li>ANSI Z97.1 Certified</li>
              <li>Compliance with Federal Standards</li>
            </ul>
            <a href="/services/government-public/" class="service-card__link">Learn More →</a>
          </div>
        </div>

        <!-- Specialty -->
        <div class="service-card">
          <div class="service-card__image">
            <img 
              src="/images/safety-window-film-philadelphia.webp"
              alt="Specialty window film installation Philadelphia"
            />
          </div>
          <div class="service-card__content">
            <h3 class="service-card__title">Specialty Film Solutions</h3>
            <p class="service-card__description">Custom and specialty window film applications for unique requirements including security, anti-graffiti, and decorative films.</p>
            <ul class="service-card__features">
              <li>Bomb Blast Protection</li>
              <li>Ballistic & Bullet Resistant Film</li>
              <li>Anti-Graffiti Film</li>
              <li>Decorative & Frosted Film</li>
              <li>Custom Solutions</li>
            </ul>
            <a href="/services/specialty/" class="service-card__link">Learn More →</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="services-process">
    <div class="container">
      <div class="services-process__header">
        <h2 class="section-h2">Our Installation Process</h2>
        <p class="section-sub">Professional installation from start to finish</p>
      </div>

      <div class="services-process__steps">
        
        <div class="process-step">
          <div class="process-step__number">01</div>
          <h3 class="process-step__title">Free Consultation</h3>
          <p class="process-step__description">We assess your needs, measure your windows, and recommend the best film solutions for your goals and budget.</p>
        </div>

        <div class="process-step">
          <div class="process-step__number">02</div>
          <h3 class="process-step__title">Custom Quote</h3>
          <p class="process-step__description">Receive a detailed written quote with product options, pricing, and timeline. No hidden fees.</p>
        </div>

        <div class="process-step">
          <div class="process-step__number">03</div>
          <h3 class="process-step__title">Expert Installation</h3>
          <p class="process-step__description">Our certified installers complete the job efficiently with minimal disruption to your home or business.</p>
        </div>

        <div class="process-step">
          <div class="process-step__number">04</div>
          <h3 class="process-step__title">Quality Guarantee</h3>
          <p class="process-step__description">All installations backed by our satisfaction guarantee and manufacturer warranty coverage.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="services-why">
    <div class="container">
      <div class="services-why__grid">
        <div class="services-why__content">
          <div class="eyebrow">Why Choose Window Film Philadelphia</div>
          <h2 class="section-h2">Over 15 Years of Excellence</h2>
          <p>Since 2009, we've been Philadelphia's trusted window film experts, serving over 2,500 satisfied customers across residential, commercial, and government sectors.</p>
          
          <ul class="services-why__list">
            <li>
              <strong>15+ Years Experience</strong> — Trusted by Philadelphia homeowners and businesses since 2009
            </li>
            <li>
              <strong>2,500+ Installations</strong> — Proven track record across residential, commercial, and government projects
            </li>
            <li>
              <strong>Factory-Trained Installers</strong> — Certified by leading manufacturers including 3M, LLumar, and Madico
            </li>
            <li>
              <strong>Premium Products</strong> — We only use top-tier films from trusted brands
            </li>
            <li>
              <strong>Lifetime Warranty</strong> — Manufacturer warranty plus our installation guarantee
            </li>
            <li>
              <strong>Free Consultation</strong> — No-obligation assessment and quote
            </li>
          </ul>

          <a href="/contact/" class="btn btn--primary">Schedule Free Consultation</a>
        </div>

        <div class="services-why__image">
          <img 
            src="/images/madico-window-film-contractor-philadelphia.png"
            alt="Window Film Philadelphia certified installer"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="services-areas">
    <div class="container">
      <div class="services-areas__header">
        <h2 class="section-h2">Serving Greater Philadelphia</h2>
        <p class="section-sub">Professional window film installation across the region</p>
      </div>

      <div class="services-areas__grid">
        <div class="area-card">
          <h3>Philadelphia</h3>
          <p>Center City, University City, South Philly, Northeast, Northwest</p>
        </div>
        <div class="area-card">
          <h3>Montgomery County</h3>
          <p>King of Prussia, Norristown, Lansdale, Ambler</p>
        </div>
        <div class="area-card">
          <h3>Delaware County</h3>
          <p>Media, Broomall, Havertown, Springfield</p>
        </div>
        <div class="area-card">
          <h3>Chester County</h3>
          <p>West Chester, Exton, Malvern, Phoenixville</p>
        </div>
        <div class="area-card">
          <h3>Bucks County</h3>
          <p>Doylestown, Newtown, Warrington, Yardley</p>
        </div>
        <div class="area-card">
          <h3>Camden County</h3>
          <p>Cherry Hill, Voorhees, Haddonfield, Marlton</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="services-faq">
    <div class="container">
      <div class="services-faq__header">
        <h2 class="section-h2">Frequently Asked Questions</h2>
      </div>

      <div class="services-faq__list">
        
        <details class="faq-item">
          <summary class="faq-item__question">How long does window film installation take?</summary>
          <div class="faq-item__answer">
            <p>Most residential projects take 4-6 hours. Commercial projects vary based on square footage, but we work efficiently to minimize disruption to your business operations.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-item__question">What's the warranty on window film?</summary>
          <div class="faq-item__answer">
            <p>All our films come with manufacturer warranties ranging from 10 years to lifetime, depending on the product. We also guarantee our installation workmanship.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-item__question">Will window film damage my windows?</summary>
          <div class="faq-item__answer">
            <p>No. Professional-grade window film is safe for all window types when properly installed. Our certified installers ensure proper application to prevent any damage.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-item__question">Can window film help reduce energy costs?</summary>
          <div class="faq-item__answer">
            <p>Yes! Energy-efficient window film can reduce HVAC costs by up to 30% by blocking heat in summer and retaining warmth in winter.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-item__question">Do you offer free consultations?</summary>
          <div class="faq-item__answer">
            <p>Absolutely. We provide free, no-obligation consultations including on-site assessment, measurements, and detailed quotes with product recommendations.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-item__question">What brands of window film do you install?</summary>
          <div class="faq-item__answer">
            <p>We install premium films from industry-leading manufacturers including 3M, LLumar, Madico, Solar Gard, and Vista. We'll help you choose the best product for your needs.</p>
          </div>
        </details>

      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="services-cta">
    <div class="container">
      <div class="services-cta__content">
        <h2 class="services-cta__title">Ready to Get Started?</h2>
        <p class="services-cta__subtitle">Schedule your free consultation today and discover how window film can transform your space.</p>
        <div class="services-cta__buttons">
          <a href="/contact/" class="btn btn--primary btn--large">Get Free Quote</a>
          <a href="tel:2673947980" class="btn btn--outline-dark btn--large">(267) 394-7980</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ─── HERO ─── */
.services-hero {
  position: relative;
  background: #14201A;
  padding: 120px 0 80px;
  overflow: hidden;
}
.services-hero__container {
  max-width: 1320px;
  margin: 0 auto;
  padding: 0 40px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.services-hero__eyebrow {
  font-family: 'Space Mono', monospace;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #7CB342;
  margin-bottom: 16px;
}
.services-hero__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.5rem, 4vw, 3.5rem);
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
  margin-bottom: 24px;
}
.services-hero__subtitle {
  font-family: 'Inter', sans-serif;
  font-size: 1.125rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.85);
  margin-bottom: 32px;
}
.services-hero__ctas {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}
.services-hero__image {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(0,0,0,0.4);
}
.services-hero__img {
  width: 100%;
  height: auto;
  display: block;
}

/* ─── SERVICES TYPES ─── */
.services-types {
  padding: 100px 0;
  background: #F3F6F1;
}
.services-types__header {
  text-align: center;
  margin-bottom: 60px;
}
.services-types__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 40px;
}
.service-card {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 16px rgba(20,32,26,0.08);
  transition: transform 0.3s, box-shadow 0.3s;
}
.service-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 12px 40px rgba(20,32,26,0.16);
}
.service-card__image {
  position: relative;
  width: 100%;
  height: 240px;
  overflow: hidden;
}
.service-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.service-card__content {
  padding: 32px;
}
.service-card__title {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  font-weight: 700;
  color: #14201A;
  margin-bottom: 12px;
}
.service-card__description {
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  line-height: 1.7;
  color: #4A5C48;
  margin-bottom: 20px;
}
.service-card__features {
  list-style: none;
  margin: 0 0 24px 0;
  padding: 0;
}
.service-card__features li {
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  color: #14201A;
  padding: 8px 0;
  padding-left: 24px;
  position: relative;
}
.service-card__features li:before {
  content: '✓';
  position: absolute;
  left: 0;
  color: #7CB342;
  font-weight: 700;
}
.service-card__link {
  font-family: 'Inter', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  color: #7CB342;
  text-decoration: none;
  transition: color 0.2s;
}
.service-card__link:hover {
  color: #2E6B30;
}

/* ─── PROCESS ─── */
.services-process {
  padding: 100px 0;
  background: #fff;
}
.services-process__header {
  text-align: center;
  margin-bottom: 60px;
}
.services-process__steps {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 40px;
}
.process-step {
  text-align: center;
}
.process-step__number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 60px;
  height: 60px;
  background: #7CB342;
  color: #fff;
  font-family: 'Space Mono', monospace;
  font-size: 1.25rem;
  font-weight: 700;
  border-radius: 50%;
  margin-bottom: 20px;
}
.process-step__title {
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: #14201A;
  margin-bottom: 12px;
}
.process-step__description {
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  line-height: 1.7;
  color: #4A5C48;
}

/* ─── WHY CHOOSE US ─── */
.services-why {
  padding: 100px 0;
  background: #F3F6F1;
}
.services-why__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.services-why__list {
  list-style: none;
  margin: 32px 0;
  padding: 0;
}
.services-why__list li {
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  line-height: 1.7;
  color: #14201A;
  padding: 12px 0;
  padding-left: 32px;
  position: relative;
}
.services-why__list li:before {
  content: '→';
  position: absolute;
  left: 0;
  color: #7CB342;
  font-weight: 700;
  font-size: 1.25rem;
}
.services-why__list strong {
  color: #7CB342;
  font-weight: 600;
}
.services-why__image {
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(20,32,26,0.12);
}
.services-why__image img {
  width: 100%;
  height: auto;
  display: block;
}

/* ─── SERVICE AREAS ─── */
.services-areas {
  padding: 100px 0;
  background: #fff;
}
.services-areas__header {
  text-align: center;
  margin-bottom: 60px;
}
.services-areas__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
}
.area-card {
  background: #F3F6F1;
  border-radius: 12px;
  padding: 28px;
  border-left: 4px solid #7CB342;
}
.area-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.125rem;
  font-weight: 700;
  color: #14201A;
  margin-bottom: 8px;
}
.area-card p {
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  line-height: 1.6;
  color: #4A5C48;
  margin: 0;
}

/* ─── FAQ ─── */
.services-faq {
  padding: 100px 0;
  background: #F3F6F1;
}
.services-faq__header {
  text-align: center;
  margin-bottom: 60px;
}
.services-faq__list {
  max-width: 800px;
  margin: 0 auto;
}
.faq-item {
  background: #fff;
  border-radius: 12px;
  margin-bottom: 16px;
  padding: 24px 28px;
  border-left: 4px solid #7CB342;
}
.faq-item__question {
  font-family: 'Inter', sans-serif;
  font-size: 1.05rem;
  font-weight: 600;
  color: #14201A;
  cursor: pointer;
  list-style: none;
  position: relative;
  padding-right: 32px;
}
.faq-item__question::-webkit-details-marker {
  display: none;
}
.faq-item__question:after {
  content: '+';
  position: absolute;
  right: 0;
  top: 0;
  color: #7CB342;
  font-size: 1.5rem;
  font-weight: 400;
  transition: transform 0.3s;
}
.faq-item[open] .faq-item__question:after {
  transform: rotate(45deg);
}
.faq-item__answer {
  padding-top: 16px;
}
.faq-item__answer p {
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  line-height: 1.7;
  color: #4A5C48;
  margin: 0;
}

/* ─── FINAL CTA ─── */
.services-cta {
  padding: 100px 0;
  background: #14201A;
  text-align: center;
}
.services-cta__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  color: #fff;
  margin-bottom: 16px;
}
.services-cta__subtitle {
  font-family: 'Inter', sans-serif;
  font-size: 1.125rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.85);
  margin-bottom: 32px;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}
.services-cta__buttons {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}
.btn--large {
  padding: 16px 36px;
  font-size: 1rem;
}

/* ─── RESPONSIVE ─── */
@media (max-width: 992px) {
  .services-hero__container {
    grid-template-columns: 1fr;
    gap: 48px;
  }
  .services-why__grid {
    grid-template-columns: 1fr;
    gap: 48px;
  }
  .services-why__image {
    order: -1;
  }
}

@media (max-width: 768px) {
  .services-hero {
    padding: 80px 0 60px;
  }
  .services-hero__container {
    padding: 0 24px;
  }
  .services-types,
  .services-process,
  .services-why,
  .services-areas,
  .services-faq,
  .services-cta {
    padding: 60px 0;
  }
  .services-types__grid {
    grid-template-columns: 1fr;
  }
  .services-process__steps {
    grid-template-columns: 1fr;
  }
  .services-areas__grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
// Smooth scroll reveal
const observerOptions = {
  threshold: 0.1,
  rootMargin: '0px 0px -50px 0px'
};

const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
    }
  });
}, observerOptions);

document.querySelectorAll('.service-card, .process-step, .area-card, .faq-item').forEach(el => {
  observer.observe(el);
});
</script>
