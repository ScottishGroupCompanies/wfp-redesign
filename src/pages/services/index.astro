}
.why-modern__container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.why-modern__image-container {
  position: relative;
  height: 100%;
  opacity: 0;
  transform: scale(0.95);
  transition: opacity 0.8s ease-out, transform 0.8s ease-out;
}
.why-modern__image-container.visible {
  opacity: 1;
  transform: scale(1);
}
.why-modern__image {
  width: 100%;
  height: 100%;
  min-height: 700px;
  object-fit: cover;
  border-radius: 20px;
  box-shadow: 0 20px 60px rgba(20,32,26,0.2);
  position: relative;
}
.why-modern__image::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 20px;
  background: linear-gradient(
    to bottom,
    rgba(13,26,15,0.15) 0%,
    rgba(13,26,15,0.05) 40%,
    rgba(13,26,15,0.25) 100%
  );
  pointer-events: none;
}

/* Glassmorphism Stat Cards */
.glass-stat {
  position: absolute;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.25);
  border-radius: 16px;
  padding: 20px 28px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
  opacity: 0;
  transform: translateY(20px);
  transition: transform 0.3s ease-out, opacity 0.6s ease-out;
}
.why-modern__image-container.visible .glass-stat {
  opacity: 1;
  transform: translateY(0);
}
.glass-stat--1 {
  top: -20px;
  left: -40px;
  transition-delay: 0.2s;
}
.glass-stat--2 {
  bottom: 40px;
  right: -30px;
  transition-delay: 0.4s;
}
.glass-stat--3 {
  top: 50%;
  left: -35px;
  transform: translateY(-50%);
  transition-delay: 0.6s;
}
.why-modern__image-container.visible .glass-stat--3 {
  transform: translateY(-50%);
}
.glass-stat__number {
  font-family: 'Space Mono', monospace;
  font-size: 2rem;
  font-weight: 700;
  color: #7CB342;
  line-height: 1;
  text-shadow: 0 2px 8px rgba(0,0,0,0.2);
}
.glass-stat__label {
  font-family: 'Inter', sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  color: #fff;
  margin-top: 6px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  text-shadow: 0 1px 4px rgba(0,0,0,0.3);
}
.why-modern__text {
  font-family: 'Inter', sans-serif;
  font-size: 1.05rem;
  line-height: 1.7;
  color: #4A5C48;
  margin-bottom: 32px;
}
.feature-list {
  margin-bottom: 36px;
}
.feature-item {
  display: flex;
  gap: 16px;
  padding: 16px 0;
  border-bottom: 1px solid #E8E6E1;
}
