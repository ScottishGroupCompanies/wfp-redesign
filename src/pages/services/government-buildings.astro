const projectTypes = [
  {
    heading: 'Federal Courthouses',
    body: 'Federal courthouses carry the highest security and compliance burden of any public building. Glazing must resist blast pressure, delay forced entry, and still admit natural light for occupants and the public. We install security film systems rated to GSA blast criteria and tested under ASTM F1233, with structural attachment that bonds the film to the frame — not just to the glass. We also deliver the manufacturer test data and certificates of insurance that federal procurement and the U.S. Marshals Service typically require. Every pane is assessed individually for thermal stress and glass type before a product is recommended.',
    imageSrc: '/images/government/federal-courthouse-window-film-philadelphia.jpg',
    imageAlt: 'Philadelphia federal courthouse with security and blast mitigation window film installed',
    flip: false,
    ctaLabel: 'Request a Site Assessment',
    ctaHref: '/contact/',
  },
