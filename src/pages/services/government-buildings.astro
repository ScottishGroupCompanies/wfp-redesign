const title = 'Government & Public Building Window Tinting in Philadelphia | Security Window Film';
const description = 'GSA-compliant government window tinting in Philadelphia. Blast mitigation, forced entry delay, UV archive protection, energy mandate compliance, and anti-graffiti film for federal courthouses, municipal buildings, and public schools. Free site assessment.';
const dateModified = new Date().toISOString().slice(0, 10);

const faqItems = [
  { question: 'Can you install window film in occupied government buildings without disrupting operations?', answer: 'Yes. Public buildings rarely have the option to close during upgrades. We schedule installations after hours, on weekends, or in phased zones so courts, offices, and public counters stay open throughout. For occupied facilities, we work floor by floor and wing by wing, coordinating directly with your facilities team, building manager, and security staff to minimize disruption to employees and the public.' },
  { question: 'How does security window film meet GSA and blast mitigation standards?', answer: 'Security window film installed with a structural attachment system is engineered to hold shattered glass in place during a blast event, reducing the hazard of flying glass — the leading cause of injury in explosions. We install film systems rated to GSA blast criteria and tested under ASTM F1233 for forced entry resistance. We provide the test data and specifications your security team and procurement officers need for documentation.' },
  { question: 'Does government window tinting help with federal energy mandate compliance?', answer: 'Yes. Federal facilities are required to meet energy reduction targets, and many state and municipal buildings follow similar mandates. Window film reduces solar heat gain and HVAC load without replacing the glazing — a cost-effective path toward EPAct and local energy mandate compliance. We document solar heat gain coefficients and performance specs so your sustainability team can verify the reduction in cooling demand.' },
  { question: 'Is window film compatible with historic government buildings?', answer: 'In many cases, yes. Historic courthouses, city halls, and landmark civic buildings often have original single-pane glass that cannot be replaced without compromising the historic character. Interior-applied window film is frequently approved by the State Historic Preservation Office (SHPO) because it does not alter the exterior appearance of the building. We coordinate with your preservation officer and provide the documentation SHPO review typically requires.' },
  { question: 'What warranty and compliance documentation is provided?', answer: 'Every government installation is backed by the manufacturer warranty covering film performance — peeling, bubbling, discoloration, and solar heat rejection. We also provide a labor warranty on every installation. Warranty terms vary by product and film type; we walk your procurement team through the specifics for each product during the site assessment and include warranty documentation in our proposal.' },
  { question: 'Do you provide the documentation required for the public procurement process?', answer: 'Yes. We work with procurement officers regularly and understand the documentation public agencies require. We provide detailed proposals, product specifications, manufacturer test data, certificates of insurance, licensing documentation, and warranty information — formatted to fit your bid or proposal process. We are licensed and insured in both Pennsylvania and New Jersey, and we carry the documentation most government contracts require.' },
  { question: 'Can anti-graffiti film protect public-facing glass in transit-adjacent and high-traffic buildings?', answer: 'Absolutely. Anti-graffiti film creates a sacrificial barrier on street-facing and public-facing glass. If it gets scratched, etched, or tagged, you peel it off and replace the film at a fraction of the cost of replacing the glass. This is essential for transit-adjacent public buildings, street-level government offices, and any facility where public-facing glass is vulnerable to vandalism.' },
  { question: 'How long does government window film last?', answer: 'Professional-grade window film typically lasts 12–20 years depending on film type, glass orientation, and environmental exposure. South- and west-facing windows with direct sun exposure may see shorter lifespans than north-facing windows. All our government installations include manufacturer warranty coverage and our own labor guarantee, documented for your facility records.' },
];

const faqAccordionItems = faqItems.map(f => ({ q: f.question, a: f.answer }));

const accordionBenefits = [
  { number: '01', title: 'Blast Mitigation & Security', detail: 'Flying glass is the leading cause of injury in a blast event. Security window film installed with a structural attachment system holds shattered glass in the frame, reducing the hazard to occupants inside. Film systems are rated to GSA blast criteria and tested under ASTM F1233 — the documentation your security team and procurement officers need. Explore our <a href="/benefits/blast-mitigation/" style="color: var(--gov-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">blast mitigation window film</a> solutions.', image: '/images/government/security-blast-window-film-philadelphia.jpg', imageAlt: 'Security blast mitigation window film on a Philadelphia federal building' },
  { number: '02', title: 'UV Archive Protection', detail: 'Government buildings house irreplaceable records — court archives, historic documents, land deeds, and public records. UV rays through untreated glass cause paper, ink, and photographic materials to fade and degrade. Window film blocks up to 99.9% of UV radiation, extending the usable life of archived materials without altering visibility. See our <a href="/benefits/uv-blocking-window-film-philadelphia/" style="color: var(--gov-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">UV protection window film</a> guide.', image: '/images/government/uv-protection-government-window-film-philadelphia.jpg', imageAlt: 'UV protection window film shielding archived documents in a Philadelphia government building' },
  { number: '03', title: 'Energy Mandate Compliance', detail: 'Federal facilities must meet energy reduction targets, and many state and municipal buildings follow similar mandates. Window film reduces solar heat gain and HVAC load without replacing the glazing — a cost-effective path toward EPAct and local energy mandate compliance. We document solar heat gain coefficients so your sustainability team can verify the reduction. Explore our <a href="/benefits/energy-savings/" style="color: var(--gov-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">energy saving window film</a> options.', image: '/images/government/energy-savings-government-window-film-philadelphia.jpg', imageAlt: 'Energy saving window film reducing HVAC load on a Philadelphia municipal building' },
  { number: '04', title: 'Glare-Free Workspaces', detail: 'Afternoon glare on screens is a productivity and ergonomic issue in every government office — from case workers to clerks to judges\' chambers. Glare reduction film eliminates screen washout while maintaining natural light. According to <a href="https://www.osha.gov/ergonomics" target="_blank" rel="noopener noreferrer" style="color: var(--gov-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">OSHA</a>, glare is a recognized workplace ergonomic hazard. Explore <a href="/benefits/glare-reduction/" style="color: var(--gov-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">glare reduction window film</a>.', image: '/images/government/glare-reduction-government-window-film-philadelphia.jpg', imageAlt: 'Glare reduction window film in a Philadelphia government office workspace' },
  { number: '05', title: 'Confidentiality & Privacy', detail: 'Public buildings handle sensitive information — case files, hearings, personnel records, and citizen data. One-way daytime privacy film keeps the interior visible to staff while shielding it from public view at the street. Frosted and decorative options add privacy to interview rooms and partition glass without blocking light. See <a href="/benefits/privacy-window-film-philadelphia/" style="color: var(--gov-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">privacy window film options</a>.', image: '/images/government/privacy-government-window-film-philadelphia.jpg', imageAlt: 'Privacy window film on a Philadelphia government office interview room partition' },
  { number: '06', title: 'Historic Preservation', detail: 'Historic courthouses and city halls often have original glass that cannot be replaced without compromising landmark character. Interior-applied film is frequently approved by the State Historic Preservation Office (SHPO) because it does not alter the exterior appearance — a non-destructive way to add security, UV, and energy performance to protected glazing. Explore <a href="/benefits/energy-savings/" style="color: var(--gov-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">energy saving window film</a> for historic structures.', image: '/images/government/historic-preservation-window-film-philadelphia.jpg', imageAlt: 'Historic preservation window film applied to original glass in a Philadelphia landmark government building' },
  { number: '07', title: 'Anti-Graffiti Shield', detail: 'Public-facing glass in transit-adjacent and high-traffic government buildings is a frequent target for scratching, etching, and tagging. Anti-graffiti film creates a sacrificial barrier — if it is vandalized, you peel it off and replace the film at a fraction of the cost of replacing the glass. See <a href="/benefits/anti-graffiti/" style="color: var(--gov-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">anti-graffiti window film</a>.', image: '/images/government/anti-graffiti-government-window-film-philadelphia.jpg', imageAlt: 'Anti-graffiti window film protecting public-facing glass on a Philadelphia government building' },
  { number: '08', title: 'Forced Entry Delay', detail: 'Security film with an attachment system bonds the glass to the frame, delaying forced entry long enough to trigger alarms and allow response. ASTM F1233 testing measures the time a glazing system resists forced entry — critical for ground-floor government offices, police facilities, and public counters. Learn about <a href="/benefits/safety-and-security/" style="color: var(--gov-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">safety and security window film</a>.', image: '/images/government/forced-entry-government-window-film-philadelphia.jpg', imageAlt: 'Forced entry delay security window film on a Philadelphia government building entrance' },
];

