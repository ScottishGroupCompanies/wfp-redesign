<script>
  const ftypeSection = document.getElementById('govFtype');
  if (ftypeSection) {
    const track = document.getElementById('govFtypeTrack');
    const slides = Array.from(ftypeSection.querySelectorAll('.gov-ftype__slide'));
    const navItems = Array.from(ftypeSection.querySelectorAll('.gov-ftype__nav-item'));
    let current = 0;
    const total = slides.length;
    let timer = null;

    function goTo(index) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      current = index;
      track.style.transform = `translateX(-${current * 100}%)`;
      slides.forEach((s, i) => s.classList.toggle('gov-ftype-active', i === current));
      navItems.forEach((n, i) => n.classList.toggle('gov-ftype__nav-item--active', i === current));
      resetTimer();
    }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(() => goTo(current + 1), 7000);
    }

    navItems.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = parseInt(btn.dataset.target || '0', 10);
        goTo(target);
      });
    });

    resetTimer();
  }
