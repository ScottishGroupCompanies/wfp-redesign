    heading: 'Municipal Buildings',
    body: 'City halls, municipal services buildings, and public works offices balance security, energy mandates, and a welcoming public counter — all on a public budget. Window film reduces solar heat gain and HVAC load toward EPAct and local energy mandate compliance, blocks UV to protect public records and interior finishes, and adds an anti-graffiti sacrificial layer to street-facing glass that gets tagged. We coordinate with your facilities team, schedule installations in phased zones so the building stays open, and provide the documentation your procurement process needs.',
    imageSrc: '/images/government/municipal-building-window-film-philadelphia.jpg',
    imageAlt: 'Philadelphia municipal building with energy and security window film installed',
    flip: true,
    ctaLabel: 'Request a Site Assessment',
    ctaHref: '/contact/',
  },
  {
    heading: 'Public Schools & Universities',
    body: 'School districts and university campuses face a different security calculus: large glazed areas, high public foot traffic, and tight budgets. Forced entry delay film with an attachment system slows an intruder long enough to trigger alarms and initiate lockdown. UV film protects classroom furnishings, library collections, and lab equipment from fading. Anti-graffiti film shields first-floor glass and partition walls in hallways and transit-adjacent campuses. We work with district facilities directors and university facilities teams to assess, prioritize, and phase installations across multiple buildings.',
    imageSrc: '/images/government/public-school-window-film-philadelphia.jpg',
    imageAlt: 'Philadelphia public school with security and UV protection window film installed',
    flip: false,
    ctaLabel: 'Request a Site Assessment',
    ctaHref: '/contact/',
  },
];

const testimonials = [
  { quote: 'After the security review, we needed blast-rated film on every ground-floor pane of the courthouse. They installed the attachment system, delivered the ASTM F1233 test data for our file, and coordinated with the U.S. Marshals Service on scheduling. The building never closed.', name: 'Col. James Whitfield', role: 'Facilities Director, federal courthouse', img: '/images/government/government-window-tinting-philadelphia-testimonial-1.jpg' },
  { quote: 'As a procurement officer, I need a contractor who shows up with everything — insurance certificates, manufacturer specs, warranty docs, all formatted for our bid process. They handed me a complete proposal package the day of the site assessment. It sailed through review.', name: 'Patricia Ng', role: 'Procurement Officer, city of Philadelphia', img: '/images/government/government-window-tinting-philadelphia-testimonial-2.jpg' },
  { quote: 'We run three public safety facilities. Forced entry delay on the ground floor and anti-graffiti on the street-facing glass was the right combination. The attachment system is serious — that film is not coming off the frame without real effort. Exactly what our threat assessment called for.', name: 'Captain Ray Morales', role: 'Chief Security Officer, police facilities', img: '/images/government/government-window-tinting-philadelphia-testimonial-3.jpg' },
  { quote: 'I manage a 12-building municipal campus. They assessed each building separately — different glass, different orientation, different film per zone — and phased the install so every office stayed open. The energy savings showed up on the first utility bill, and the documentation went straight to our sustainability team for mandate reporting.', name: 'Gerald Brooks', role: 'Building Manager, municipal services campus', img: '/images/government/government-window-tinting-philadelphia-testimonial-4.jpg' },
  { quote: 'Our campus has everything from 1920s brick academic buildings to modern glass libraries. They specified interior film for the historic structures — SHPO approved it because it does not change the exterior — and security film for the new construction. One contractor, one set of compliance docs, multiple film types done right.', name: 'Dr. Alan Ressler', role: 'University Facilities Director', img: '/images/government/government-window-tinting-philadelphia-testimonial-5.jpg' },
  { quote: 'The public counter glass was getting etched every few weeks. Anti-graffiti film changed that overnight — when it gets tagged, we peel and replace the film, not the glass. The cost difference is enormous. I wish we had done it years ago.', name: 'Sgt. Maria Delgado', role: 'Police Facilities Coordinator', img: '/images/government/government-window-tinting-philadelphia-testimonial-6.jpg' },
  { quote: 'We hold municipal archives going back to the 1800s. UV film on the archive room windows stopped the fading on the oldest bound records — the conservator confirmed the difference. The film is virtually invisible, which matters because the reading room needs the daylight.', name: 'Eleanor Briggs', role: 'Library Director, public library system', img: '/images/government/government-window-tinting-philadelphia-testimonial-7.jpg' },
  { quote: 'Coordinating film across six public works buildings meant phased scheduling, after-hours crews, and a paper trail for every pane. They handled all of it and delivered warranty documentation per building. The energy reduction helped us hit our mandate target the same fiscal year.', name: 'Warren Pierce', role: 'Public Works Project Manager', img: '/images/government/government-window-tinting-philadelphia-testimonial-8.jpg' },
];

const processSlides = [
  { step: '01', title: 'Security Assessment', desc: 'We visit your facility, assess every pane, evaluate glass type and thermal stress risk, review your security and compliance requirements, and take exact measurements — at no cost and no obligation.', img: '/images/government/government-window-film-assessment-philadelphia.jpg', imgAlt: 'Government window film consultant assessing federal building windows in Philadelphia', cta: 'Request a Site Assessment', ctaHref: '/contact/' },
  { step: '02', title: 'Compliance Preparation', desc: 'Film is pre-cut by plotter to your exact pane dimensions. We coordinate with your facilities team and security staff to schedule installation around public hours — after hours, weekends, or phased by zone.', img: '/images/government/government-window-film-preparation-philadelphia.jpg', imgAlt: 'Precision plotter cutting government window film to exact dimensions', cta: 'See Our Process', ctaHref: '/process/' },
  { step: '03', title: 'Cleared Installation', desc: 'Film is applied to prepared glass using manufacturer-specified techniques, squeegeed from center outward, edges trimmed to the pane, and every pane inspected for defects. Our crews work in coordinated zones to keep your facility operational.', img: '/images/government/government-window-film-installation-philadelphia.jpg', imgAlt: 'Professional installer applying security window film to government building glass in Philadelphia', cta: 'Request a Quote', ctaHref: '/contact/' },
