---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider.astro';
import GalleryBanner from '../../components/GalleryBanner.astro';
import HowItWorksSlideshow from '../../components/HowItWorksSlideshow.astro';
import BentoGridPhoto from '../../components/BentoGridPhoto.astro';
import AccordionBenefits from '../../components/AccordionBenefits.astro';
import AccordionFAQ from '../../components/AccordionFAQ.astro';
import TestimonialMarquee from '../../components/TestimonialMarquee.astro';
import BackAndForthSection from '../../components/BackAndForthSection.astro';
import CTAAvatars from '../../components/CTAAvatars.astro';

const title = 'Residential Window Film Philadelphia | Home Window Tinting';
const description = 'Professional residential window film installation in Philadelphia. Energy savings, UV protection, privacy, security, and decorative film for homes, condos, and apartments. Free consultation.';
const dateModified = new Date().toISOString().slice(0, 10);

const faqItems = [
  { question: 'How long does residential window film installation take?', answer: 'Most residential installations are completed in a single day. We pre-cut all film at our shop using a precision plotter, so the on-site work is efficient and clean. Larger homes or multiple-story installations may take two days — we\'ll give you a clear timeline with your quote.' },
  { question: 'Will window film make my rooms look dark?', answer: 'Not necessarily. Modern spectrally selective and nanoceramic films reject heat and UV while preserving 70–80% of visible light. Many homeowners say their rooms feel brighter and more comfortable after installation. We\'ll match the visible light level to your preference during the consultation.' },
  { question: 'Can window film be installed on older single-pane windows?', answer: 'Yes — single-pane windows actually benefit the most from window film. We assess every pane individually, checking glass age, frame condition, and thermal stress risk before recommending a product. Historic Philadelphia homes with original glass are a significant part of our work.' },
  { question: 'How long does residential window film last?', answer: 'Professional-grade residential films typically last 15–20+ years. All our installations include a manufacturer warranty — often lifetime for residential — plus our own installation guarantee. Coverage varies by film type; we\'ll explain the specifics for your chosen product.' },
  { question: 'Can window film be applied to double-pane windows?', answer: 'Yes. Modern spectrally selective films are specifically engineered for dual-pane and even triple-pane glass. They reject solar heat without trapping energy between panes, so there\'s no risk of thermal stress or seal failure when professionally installed with the correct film for your glass type.' },
  { question: 'Do I need to do anything before installation day?', answer: 'Very little. We ask that you clear access to the windows being filmed — remove valuables, window treatments if applicable, and any furniture within arm\'s reach. We handle all the prep, cleaning, installation, and cleanup. We\'ll leave a written care card before we go.' },
  { question: 'What warranty comes with residential window film?', answer: 'Every residential installation is backed by the manufacturer\'s warranty covering film performance — peeling, bubbling, discoloration, and solar performance. We also provide a labor warranty on every installation. Warranty terms vary by product; we\'ll walk you through the specifics during your consultation.' },
  { question: 'Can window film be removed if I change my mind?', answer: 'Yes. Window film is not permanent. Our team can safely remove film from any glass surface — the process involves carefully peeling the film and cleaning the adhesive residue. The glass itself is not damaged by removal when done correctly.' },
];

const faqAccordionItems = faqItems.map(f => ({ q: f.question, a: f.answer }));

const accordionBenefits = [
  { number: '01', title: 'Energy Savings', detail: 'Cut cooling costs by up to 30% with heat-rejecting film that keeps your home comfortable year-round. Spectrally selective films reject up to 78% of solar heat gain while preserving natural light. Explore our <a href="/benefits/energy-savings/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">energy saving window film</a> options.', image: '/images/residential/energy-saving-window-film-philadelphia.jpg', imageAlt: 'Energy saving window film in a Philadelphia living room' },
  { number: '02', title: 'UV Protection', detail: 'Block up to 99.9% of UV rays — protecting your furnishings, flooring, and family without reducing natural light. Clear UV-blocking films are virtually invisible on your glass. See our <a href="/benefits/uv-blocking-window-film-philadelphia/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">UV protection window film</a> guide.', image: '/images/residential/uv-protection-window-film-philadelphia.jpg', imageAlt: 'UV protection window film protecting hardwood floors in a Philadelphia home' },
  { number: '03', title: 'Safety & Security', detail: 'Hold broken glass together during break-ins, storms, and accidents with security film applied to your existing glass. An attachment system bonds the film to the frame for maximum forced-entry resistance. Learn about <a href="/benefits/safety-and-security/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">safety and security window film</a>.', image: '/images/residential/safety-security-window-film-philadelphia.jpg', imageAlt: 'Safety and security window film on a Philadelphia home window' },
  { number: '04', title: 'Glare Reduction', detail: 'Eliminate screen glare in home offices and living spaces while keeping your rooms bright and clear. Spectrally selective films reduce glare without darkening your interiors. Explore <a href="/benefits/glare-reduction/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">glare reduction window film</a>.', image: '/images/residential/glare-reduction-window-film-philadelphia.jpg', imageAlt: 'Glare reduction window film in a Philadelphia home office' },
  { number: '05', title: 'Privacy Film', detail: 'One-way daytime privacy, frosted, and decorative privacy films for bathrooms, street-facing windows, and more. Choose from clear reflective, frosted, or patterned privacy options. See <a href="/benefits/privacy-window-film-philadelphia/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">privacy window film options</a>.', image: '/images/residential/privacy-window-film-philadelphia.jpg', imageAlt: 'Privacy window film on a Philadelphia bathroom window' },
  { number: '06', title: 'Decorative Film', detail: 'Custom frosted patterns, etched designs, and branded graphics that enhance privacy and aesthetics. Transform plain glass into a design feature without replacing it. Explore <a href="/benefits/decorative-promotional/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">decorative window film</a>.', image: '/images/residential/decorative-window-film-philadelphia.jpg', imageAlt: 'Decorative window film on a Philadelphia home glass partition' },
  { number: '07', title: 'Bird Strike Prevention', detail: 'Virtually invisible fritted patterns alert birds to glass barriers, preventing collisions without obstructing your view. Required by many Philadelphia municipalities for new construction. Learn about <a href="/benefits/bird-strike-prevention/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">bird strike prevention film</a>.', image: '/images/residential/bird-strike-window-film-philadelphia.jpg', imageAlt: 'Bird strike prevention window film on a Philadelphia home' },
  { number: '08', title: 'Solar Control', detail: 'Reject up to 78% of solar heat gain with spectrally selective films that keep your home cool without darkening rooms. Maintain your view while reducing your cooling costs. See our <a href="/services/solar/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">solar control window film</a> service.', image: '/images/residential/solar-control-window-film-philadelphia.jpg', imageAlt: 'Solar control window film in a Philadelphia residential interior' },
];

const galleryPhotos = [
  '/images/residential/window-film-consultation-philadelphia.jpg',
  '/images/residential/window-film-application-philadelphia.jpg',
  '/images/residential/residential-window-film-philadelphia-gallery-finished.jpg',
  '/images/residential/condo-window-film-philadelphia.jpg',
  '/images/residential/historic-home-window-film-philadelphia.jpg',
];

const bentoItems = [
  { span: 'lg', title: 'Homes & Condos', desc: 'Privacy, UV protection and comfort for living spaces.', img: '/images/residential/residential-window-film-philadelphia-home-exterior.jpg', href: '/contact/' },
  { span: 'sm', title: 'The Installation', desc: 'Precision from start to finish.', img: '/images/residential/window-film-installation-philadelphia.jpg', href: '/contact/' },
  { span: 'sm', title: 'The Finished Result', desc: 'Comfortable, protected, and bright.', img: '/images/residential/residential-window-film-philadelphia-finished.jpg', href: '/contact/' },
  { span: 'md', title: 'Historic Homes', desc: 'Clear UV film preserves character.', img: '/images/residential/historic-window-film-philadelphia-interior.jpg', href: '/contact/' },
  { span: 'md', title: 'Modern Kitchens', desc: 'Solar control without darkening.', img: '/images/residential/window-film-philadelphia-kitchen.jpg', href: '/contact/' },
  { span: 'md', title: 'Privacy & Comfort', desc: 'Frosted film for bathrooms and street-facing windows.', img: '/images/residential/privacy-window-film-philadelphia-bento.jpg', href: '/contact/' },
];

const housingTypes = [
  { name: 'Rowhomes & Twins', desc: 'Philadelphia\'s signature housing stock. Bay windows and south-facing facades trap heat in summer. Solar control and UV protection film keep interiors cool without sacrificing light.', img: '/images/residential/window-film-philadelphia-rowhome.jpg', alt: 'South Philadelphia rowhome with window film installed' },
  { name: 'Condos & Apartments', desc: 'High-rise units with floor-to-ceiling glass face intense solar exposure and glare. Spectrally selective film rejects heat while maintaining views and natural light.', img: '/images/residential/window-film-philadelphia-condo.jpg', alt: 'Center City condo with residential window film installed' },
  { name: 'Historic & Older Homes', desc: 'Original single-pane windows in Philadelphia\'s historic neighborhoods benefit from clear UV-blocking film that protects furnishings without changing the glass appearance.', img: '/images/residential/window-film-philadelphia-historic-home.jpg', alt: 'Single historic Philadelphia brownstone with UV protection window film' },
];

const testimonials = [
  { quote: 'Our electric bill dropped nearly $400 in the first summer after the film was installed. The west side of the house is actually comfortable now — before, it was unbearable by 3pm.', name: 'Jennifer K.', role: 'Society Hill rowhome', img: '/images/residential/residential-window-film-philadelphia-testimonial-1.jpg' },
  { quote: 'I was skeptical because we tried blinds before and they didn\'t help. But window film actually solved the glare and heat. The HVAC runs half as much and the rooms are still bright.', name: 'Marcus T.', role: 'Fishtown renovation', img: '/images/residential/residential-window-film-philadelphia-testimonial-2.jpg' },
  { quote: 'We have a 1920s home with original glass. The clear UV film protects our hardwood floors and artwork without changing the look of the windows at all. You can\'t tell it\'s there.', name: 'Sarah & David L.', role: 'Chestnut Hill historic home', img: '/images/residential/residential-window-film-philadelphia-testimonial-3.jpg' },
  { quote: 'The crew was professional, on time, and cleaned up everything. They walked us through every window before they left. The privacy film on our street-facing windows is perfect.', name: 'Rachel M.', role: 'South Philly twin', img: '/images/residential/residential-window-film-philadelphia-testimonial-4.jpg' },
];

const processSlides = [
  { step: '01', title: 'Free In-Home Consultation', desc: 'We visit your home, assess every pane, discuss your goals, and take exact measurements — at no cost and no obligation.', img: '/images/residential/residential-window-film-consultation-philadelphia.jpg', imgAlt: 'Window film consultant discussing film samples with a Philadelphia homeowner', cta: 'Book a Free Consultation', ctaHref: '/contact/' },
  { step: '02', title: 'Precision Preparation', desc: 'Film is pre-cut by plotter to your exact pane dimensions. We clean every pane and apply C-Bond primer for a superior bond before the film goes on.', img: '/images/residential/window-film-preparation-philadelphia.jpg', imgAlt: 'Precision plotter cutting window film to exact dimensions in workshop', cta: 'See Our Process', ctaHref: '/process/' },
  { step: '03', title: 'Professional Installation', desc: 'Film is applied to prepared glass, squeegeed from center outward, edges trimmed, and every pane inspected for defects. Most homes done in a single day.', img: '/images/residential/window-film-installation-philadelphia-process.jpg', imgAlt: 'Installer positioning window film onto residential glass', cta: 'Get a Free Quote', ctaHref: '/contact/' },
  { step: '04', title: 'Walkthrough & Warranty', desc: 'We walk you through every window, explain care during the cure period, and provide your warranty documentation before we leave.', img: '/images/residential/residential-window-film-walkthrough-philadelphia.jpg', imgAlt: 'Installer and homeowner doing final walkthrough of completed window film installation', cta: 'Get a Free Quote', ctaHref: '/contact/' },
];

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.windowfilmphiladelphia.net/services/' },
      { '@type': 'ListItem', position: 3, name: 'Residential Window Film', item: 'https://www.windowfilmphiladelphia.net/services/residential/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://www.windowfilmphiladelphia.net/services/residential/',
    url: 'https://www.windowfilmphiladelphia.net/services/residential/',
    name: 'Residential Window Film Philadelphia',
    description,
    dateModified,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Residential Window Film Benefits Philadelphia',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Energy Savings', description: 'Heat-rejecting window film that cuts cooling costs by up to 30% for Philadelphia homes.' },
      { '@type': 'ListItem', position: 2, name: 'UV Protection', description: 'Blocks up to 99.9% of UV rays to protect furnishings, flooring, and occupants.' },
      { '@type': 'ListItem', position: 3, name: 'Safety & Security', description: 'Security film that holds broken glass together during break-ins, storms, and accidents.' },
      { '@type': 'ListItem', position: 4, name: 'Glare Reduction', description: 'Eliminates screen glare in home offices and living spaces while keeping rooms bright.' },
      { '@type': 'ListItem', position: 5, name: 'Privacy Film', description: 'One-way daytime privacy, frosted, and decorative privacy films for homes.' },
      { '@type': 'ListItem', position: 6, name: 'Decorative Film', description: 'Custom frosted patterns and etched designs that enhance privacy and aesthetics.' },
      { '@type': 'ListItem', position: 7, name: 'Bird Strike Prevention', description: 'Virtually invisible fritted film patterns that prevent bird collisions with glass.' },
      { '@type': 'ListItem', position: 8, name: 'Solar Control', description: 'Spectrally selective film that rejects up to 78% of solar heat gain without darkening rooms.' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Residential Window Film Philadelphia',
    description: 'Professional residential window film installation for Philadelphia homes, condos, and apartments. Energy savings, UV protection, privacy, security, and decorative film applied to existing glass.',
    brand: { '@type': 'Brand', name: 'Window Film Philadelphia' },
    aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', ratingCount: '2400', bestRating: '5', worstRating: '1' },
    offers: { '@type': 'Offer', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
  },
];

const howToSteps = [
  { name: 'Free In-Home Consultation', text: 'We visit your home, assess every pane, discuss your goals, and take exact measurements at no cost or obligation.' },
  { name: 'Precision Preparation', text: 'Film is pre-cut by plotter to your exact pane dimensions. We clean every pane and apply C-Bond primer for a superior bond.' },
  { name: 'Professional Installation', text: 'Film is applied to prepared glass, squeegeed from center outward, edges trimmed, and every pane inspected for defects.' },
  { name: 'Walkthrough & Warranty', text: 'We walk you through every window, explain care during the cure period, and provide your warranty documentation.' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.windowfilmphiladelphia.net/services/residential/"
  faqItems={faqItems}
  serviceName="Residential Window Film Philadelphia"
  serviceDesc="Professional residential window film installation for Philadelphia homes, condos, and apartments. Energy savings, UV protection, privacy, security, and decorative film."
  serviceUrl="https://www.windowfilmphiladelphia.net/services/residential/"
  howToSteps={howToSteps}
  howToName="Residential Window Film Installation Process"
  howToDesc="Professional residential window film installation process for Philadelphia homes."
  schemas={pageSchemas}
>

<!-- ═══ HERO ═══ -->
<section class="rsh-hero">
  <div class="rsh-hero__bg" style="background-image: url('/images/residential/residential-window-film-philadelphia-hero.jpg')" role="img" aria-label="Philadelphia home interior with residential window film installed"></div>
  <div class="rsh-hero__overlay"></div>
  <div class="rsh-hero__content">
    <div class="rsh-hero__eyebrow">
      <span class="rsh-hero__eyebrow-dot" aria-hidden="true"></span>
      RESIDENTIAL WINDOW FILM
      <span class="rsh-hero__eyebrow-dot" aria-hidden="true"></span>
    </div>
    <h1 class="rsh-hero__title">Residential Window Film in Philadelphia</h1>
    <p class="rsh-hero__subtitle">Professional installation for homes, condos, and apartments across the Delaware Valley. Energy savings, UV protection, privacy, security, and decorative film — applied to your existing windows.</p>
    <div class="rsh-hero__cta">
      <a href="/contact/" class="rsh-hero__btn-primary">Get Your Free Estimate</a>
      <a href="tel:2673947980" class="rsh-hero__btn-secondary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
        Call (267) 394-7980
      </a>
    </div>
    <div class="rsh-hero__stats-panel" aria-label="Key statistics">
      <div class="rsh-hero__stats-inner">
        <div class="rsh-hero__stat">
          <span class="rsh-hero__stat-number">99.9%</span>
          <span class="rsh-hero__stat-label">UV Rays Blocked</span>
        </div>
        <div class="rsh-hero__stat-divider" aria-hidden="true"></div>
        <div class="rsh-hero__stat">
          <span class="rsh-hero__stat-number">2008</span>
          <span class="rsh-hero__stat-label">Serving Since</span>
        </div>
        <div class="rsh-hero__stat-divider" aria-hidden="true"></div>
        <div class="rsh-hero__stat">
          <span class="rsh-hero__stat-number">2,400+</span>
          <span class="rsh-hero__stat-label">Projects Completed</span>
        </div>
        <div class="rsh-hero__stat-divider" aria-hidden="true"></div>
        <div class="rsh-hero__stat">
          <span class="rsh-hero__stat-number">1 Day</span>
          <span class="rsh-hero__stat-label">Most Installations</span>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="rsh-body">

<!-- TRUST BAR -->
<section class="rsh-trust">
  <div class="rsh-container">
    <p class="rsh-trust__label">Trusted by thousands of Philadelphia homeowners since 2008</p>
  </div>
</section>

<BrandLogos />

<!-- ═══ INTRO — 2-col with image ═══ -->
<section class="rsh-intro">
  <div class="rsh-intro__container">
    <div class="rsh-intro__content">
      <span class="rsh-eyebrow">Our Services</span>
      <h2 class="rsh-intro__title">Window film for Philadelphia homes, done right</h2>
      <p class="rsh-intro__lead">Philadelphia homeowners choose residential window film in Philadelphia as a cost-effective alternative to window replacement. Whether you live in a South Philly rowhome, a Center City high-rise, or a Main Line estate, we install film that reduces heat, blocks UV rays, adds privacy, and strengthens your glass — all applied to your existing windows with no disruption to your home.</p>
      <p class="rsh-intro__lead">We assess every pane individually — glass type, age, condition, orientation, and your goals — before recommending a product. The right film on the right glass for the right reason. That's how we've worked since 2008. According to the <a href="https://www.energy.gov/energysaver" target="_blank" rel="noopener noreferrer" style="color: var(--rsh-green); text-decoration: underline; text-underline-offset: 3px;">U.S. Department of Energy</a>, window film is one of the most cost-effective energy upgrades available for existing homes.</p>
    </div>
    <div class="rsh-intro__image-wrap">
      <img src="/images/residential/residential-window-film-philadelphia-interior.jpg" alt="Philadelphia home interior with residential window film installed" title="Philadelphia home interior with residential window film installed" class="rsh-intro__image" loading="lazy" />
    </div>
  </div>
</section>

<!-- ═══ BEFORE/AFTER SLIDER ═══ -->
<BeforeAfterSlider
  before="/images/residential/residential-window-film-philadelphia-before.jpg"
  after="/images/residential/residential-window-film-philadelphia-after.jpg"
  beforeAlt="Philadelphia living room without window film — harsh glare and overexposed windows"
  afterAlt="Same Philadelphia living room after window film installation — soft even light, no glare, comfortable atmosphere"
  beforeTag="Without film"
  afterTag="With film"
  heading="See the difference for yourself"
  sub="Drag the handle to compare a Philadelphia home before and after window film installation. Same room. Same windows. Completely different experience."
/>

<!-- ═══ GALLERY BANNER — fanned photo strips ═══ -->
<GalleryBanner
  titleLines={['OUR', 'WORK.']}
  eyebrow="RESIDENTIAL INSTALLS"
  description="A collection of real window film installations. Every project measured, applied, and finished by our own certified team."
  photos={galleryPhotos}
  hintText="Hover the photos · click to bring forward"
  theme="dark"
/>

<!-- ═══ HOUSING TYPES — alternating image/text ═══ -->
<section class="rsh-housing">
  <div class="rsh-container">
    <div class="rsh-housing__hd">
      <span class="rsh-eyebrow">Built for Philadelphia Homes</span>
      <h2 class="rsh-housing__title">The right film for how Philadelphia lives</h2>
      <p class="rsh-housing__sub">From 19th-century rowhomes to modern high-rise condos, Philadelphia's housing stock demands different film solutions. We assess your glass, orientation, and goals before recommending anything.</p>
    </div>
    <div class="rsh-housing__rows">
      {housingTypes.map((h, i) => (
        <div class={`rsh-housing__row${i % 2 === 1 ? ' rsh-housing__row--rev' : ''}`}>
          <div class="rsh-housing__img">
            <img src={h.img} alt={h.alt} title={h.alt} width="600" height="480" loading="lazy" />
          </div>
          <div class="rsh-housing__content">
            <h3 class="rsh-housing__name">{h.name}</h3>
            <p class="rsh-housing__desc">{h.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ WHY CHOOSE US — Full-bleed image slider (office of-ftype pattern) ═══ -->
<section class="rsh-ftype" id="rshFtype">
  <div class="rsh-ftype__track" id="rshFtypeTrack">

    <!-- SLIDE 01: Experience -->
    <div class="rsh-ftype__slide rsh-ftype-active" data-slide="0">
      <img src="/images/residential/residential-window-film-philadelphia-slider-experience.jpg" alt="Philadelphia home exterior with residential window film installed" title="Philadelphia home with residential window film — Window Film Philadelphia" class="rsh-ftype__bg" />
      <div class="rsh-ftype__overlay"></div>
      <div class="rsh-ftype__content">
        <div class="rsh-ftype__step">01</div>
        <h2 class="rsh-ftype__title">15+ years serving
Philadelphia homeowners</h2>
        <p class="rsh-ftype__desc">Since 2008, we've installed window film in thousands of Philadelphia homes — from South Philly rowhomes to Main Line estates. We've seen every glass type, every orientation, every problem. That experience means we recommend the right film the first time. Every installation is backed by the manufacturer's warranty and our own labor guarantee.</p>
        <a href="/contact/" class="rsh-ftype__cta">Get a Free Quote →</a>
      </div>
    </div>

    <!-- SLIDE 02: Certified -->
    <div class="rsh-ftype__slide" data-slide="1">
      <img src="/images/residential/residential-window-film-philadelphia-slider-certified.jpg" alt="Professional installer applying window film with precision tools" title="Certified window film installation — Window Film Philadelphia" class="rsh-ftype__bg" />
      <div class="rsh-ftype__overlay"></div>
      <div class="rsh-ftype__content">
        <div class="rsh-ftype__step">02</div>
        <h2 class="rsh-ftype__title">Factory-certified,
fully insured installation</h2>
        <p class="rsh-ftype__desc">Our crews are factory-certified by every major window film manufacturer. Film performance depends on correct installation — the wrong prep or application method can void the warranty and underperform. We're licensed and insured in both Pennsylvania and New Jersey. Every crew member is trained on C-Bond primer, precision plotter cutting, and manufacturer-specific installation standards.</p>
        <a href="/contact/" class="rsh-ftype__cta">Talk to a Specialist →</a>
      </div>
    </div>

    <!-- SLIDE 03: Consultation -->
    <div class="rsh-ftype__slide" data-slide="2">
      <img src="/images/residential/residential-window-film-philadelphia-slider-consultation.jpg" alt="Window film consultant measuring windows in a Philadelphia home" title="Free in-home window film consultation — Window Film Philadelphia" class="rsh-ftype__bg" />
      <div class="rsh-ftype__overlay"></div>
      <div class="rsh-ftype__content">
        <div class="rsh-ftype__step">03</div>
        <h2 class="rsh-ftype__title">Free in-home consultation,
no pressure</h2>
