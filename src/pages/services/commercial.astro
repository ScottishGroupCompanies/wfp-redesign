import BackAndForthSection from '../../components/BackAndForthSection.astro';
import CTAAvatars from '../../components/CTAAvatars.astro';

const title = 'Commercial Window Tinting Philadelphia | Office & Retail';
const description = 'Commercial window tinting in Philadelphia. Energy savings, glare reduction, security, and decorative film for offices, retail, and hotels. Free assessment.';
const dateModified = new Date().toISOString().slice(0, 10);

const faqItems = [
  { question: 'Can you install commercial window film without disrupting our business operations?', answer: 'Yes. We routinely schedule installations after hours, on weekends, or in phased zones so your business stays operational throughout. For occupied offices, we work floor by floor and section by section. We coordinate directly with your building manager or facilities team to minimize disruption to tenants, customers, and staff.' },
  { question: 'How does commercial window tinting affect our HVAC costs?', answer: 'Solar heat gain through untreated glass is a major contributor to cooling load. Spectrally selective films reject up to 78% of solar heat gain, which reduces the demand on your HVAC system. Many clients who invest in commercial window tinting in Philadelphia see measurable energy savings within the first billing cycle. The exact reduction depends on glass orientation, film type, and building envelope.' },
  { question: 'What warranty coverage comes with commercial window film?', answer: 'Every commercial installation is backed by the manufacturer warranty covering film performance — peeling, bubbling, discoloration, and solar heat rejection. We also provide a labor warranty on every commercial installation. Warranty terms vary by product and film type; we walk you through the specifics for your chosen product during the site assessment.' },
  { question: 'Can window film help our building qualify for LEED points?', answer: 'Window film can contribute to LEED certification in several categories: Energy and Atmosphere (reduced solar heat gain), Indoor Environmental Quality (glare control and thermal comfort), and Materials and Resources. We provide documentation for your LEED consultant, including solar heat gain coefficients, visible light transmission, and UV rejection specifications for each film we install.' },
  { question: 'Do you work with building managers and property management companies?', answer: 'Yes. A significant portion of our commercial work is through property management firms and building managers who oversee multiple properties. We provide site assessments, detailed proposals, and coordinate installations across portfolios. We are licensed and insured in both Pennsylvania and New Jersey, and we carry the documentation most management companies require.' },
  { question: 'Can security film be used on retail storefronts?', answer: 'Absolutely. Security and anti-graffiti films are among the most common commercial applications for retail storefronts. Security film holds broken glass together during attempted break-ins, while anti-graffiti film protects the exterior surface from scratching and etching — and can be peeled and replaced if vandalized, at a fraction of the cost of replacing the glass.' },
  { question: 'What types of glass can commercial window film be applied to?', answer: 'Commercial window film can be applied to most glass types including single-pane, double-pane IGUs, tempered, laminated, and low-E glass. However, not every film is suitable for every glass type. We assess each pane individually, checking thermal stress risk, glass age, and frame condition before recommending a product. Using the wrong film on the wrong glass can cause thermal breakage.' },
  { question: 'How long does commercial window film last?', answer: 'Professional-grade commercial films typically last 12–20 years depending on film type, glass orientation, and environmental exposure. South- and west-facing windows with direct sun exposure may see shorter lifespans than north-facing windows. All our commercial installations include manufacturer warranty coverage and our own labor guarantee.' },
];

const faqAccordionItems = faqItems.map(f => ({ q: f.question, a: f.answer }));

const accordionBenefits = [
  { number: '01', title: 'HVAC Load Reduction', detail: 'Solar heat gain through untreated glass forces your HVAC system to work overtime. Spectrally selective films reject up to 78% of solar heat gain without darkening interiors, directly reducing cooling demand. Many commercial clients see measurable energy savings within the first billing cycle. Explore our <a href="/benefits/energy-savings/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">energy saving window film</a> options.', image: '/images/commercial/energy-saving-window-film-philadelphia-commercial.jpg', imageAlt: 'Energy saving commercial window film on a Philadelphia office building' },
  { number: '02', title: 'UV & Fading Control', detail: 'Block up to 99.9% of UV rays — protecting merchandise, office furnishings, equipment, and displays from fading and degradation. Clear UV-blocking films are virtually invisible on your glass, making them ideal for retail display windows and offices with valuable equipment. See our <a href="/benefits/uv-blocking-window-film-philadelphia/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">UV protection window film</a> guide.', image: '/images/commercial/uv-protection-window-film-philadelphia-commercial.jpg', imageAlt: 'UV protection commercial window film in a Philadelphia retail space' },
  { number: '03', title: 'Security & Forced Entry', detail: 'Security film holds broken glass together during attempted break-ins, severe weather, and accidents. An attachment system bonds the film to the frame for maximum forced-entry delay — critical for ground-floor retail, jewelry stores, and street-facing offices. Learn about <a href="/benefits/safety-and-security/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">safety and security window film</a>.', image: '/images/commercial/safety-security-window-film-philadelphia-commercial.jpg', imageAlt: 'Security commercial window film on a Philadelphia storefront entrance' },
  { number: '04', title: 'Glare on Screens', detail: 'Afternoon glare on computer monitors is a top complaint in commercial offices. Glare reduction film eliminates screen washout while maintaining natural light — employees can work without squinting, and productivity improves. Explore <a href="/benefits/glare-reduction/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">glare reduction window film</a>.', image: '/images/commercial/glare-reduction-window-film-philadelphia-commercial.jpg', imageAlt: 'Glare reduction commercial window film in a Philadelphia office workspace' },
  { number: '05', title: 'Tenant Privacy', detail: 'One-way daytime privacy film keeps your conference rooms and offices visible to those inside but shielded from street view. Frosted and decorative options add privacy to glass partitions without blocking light. See <a href="/benefits/privacy-window-film-philadelphia/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">privacy window film options</a>.', image: '/images/commercial/privacy-window-film-philadelphia-commercial.jpg', imageAlt: 'Privacy commercial window film on Philadelphia office conference room glass' },
  { number: '06', title: 'Decorative & Branding', detail: 'Custom frosted patterns, etched designs, and branded graphics transform plain glass partitions into design features. Ideal for office interiors, hotel lobbies, and restaurant spaces where privacy meets aesthetics. Explore <a href="/benefits/decorative-promotional/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">decorative window film</a>.', image: '/images/commercial/decorative-window-film-philadelphia-commercial.jpg', imageAlt: 'Decorative commercial window film on Philadelphia office glass partitions' },
  { number: '07', title: 'Anti-Graffiti Protection', detail: 'Anti-graffiti film creates a sacrificial barrier on street-facing glass — if it gets scratched, etched, or tagged, you peel it off and replace it at a fraction of the cost of replacing the glass. Essential for street-level retail and transit-adjacent storefronts. See <a href="/benefits/anti-graffiti/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">anti-graffiti window film</a>.', image: '/images/commercial/anti-graffiti-window-film-philadelphia-commercial.jpg', imageAlt: 'Anti-graffiti commercial window film on a Philadelphia retail storefront' },
  { number: '08', title: 'Solar Heat Management', detail: 'Reject up to 78% of solar heat gain with spectrally selective films that keep your building cool without darkening interiors. Maintain your views and natural light while reducing your cooling costs. See our <a href="/services/solar/" style="color: var(--rsh-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">solar control window film</a> service.', image: '/images/commercial/solar-control-window-film-philadelphia-commercial.jpg', imageAlt: 'Solar control commercial window film on a Philadelphia office building interior' },
];

const galleryPhotos = [
