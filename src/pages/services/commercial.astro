    </div>

    <!-- SLIDE 02: Certified -->
    <div class="rsh-ftype__slide" data-slide="1">
      <img src="/images/commercial/commercial-window-tinting-philadelphia-slider-certified.jpg" alt="Professional installer applying commercial window film to office building glass" title="Certified commercial window film installation — Window Film Philadelphia" class="rsh-ftype__bg" />
