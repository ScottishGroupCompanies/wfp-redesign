  display: block;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.68rem;
  font-weight: 500;
  color: rgba(243, 246, 241, 0.6);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  line-height: 1.3;
  max-width: 90px;
}

/* ── TRUST BAR ══ */
.rsh-trust { padding: 32px 0; text-align: center; }
.rsh-trust__label {
  font-family: 'DM Sans', sans-serif;
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--rsh-text-mid);
  margin: 0;
}

/* ── INTRO ══ */
.rsh-intro { padding: 80px 0 60px; }
.rsh-intro__container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 5%;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 64px;
