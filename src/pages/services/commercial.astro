const projectSizes = [
  { name: 'Full Building & High-Rise', desc: 'Entire glass facades and curtain wall systems on Center City towers. Window Film Philadelphia coordinates with building management, schedules floors sequentially, and handles logistics from loading dock to rooftop. Commercial buildings with high glass-to-wall ratios can see cooling load reductions of 15-25% after solar film installation — a measurable impact on building energy performance.', img: '/images/commercial/commercial-high-rise-window-film-philadelphia.jpg', alt: 'Philadelphia high-rise office tower with window film on glass curtain wall' },
  { name: 'Small Commercial & Storefronts', desc: 'Single-location businesses, retail shops, and restaurants. Security film protects against smash-and-grab break-ins. Solar film cuts glare and heat so customers and staff stay comfortable. Most storefront installations are straightforward — one or two large panes, done cleanly.', img: '/images/commercial/commercial-storefront-window-film-philadelphia.jpg', alt: 'Philadelphia commercial storefront with window film installed' },
  { name: 'Interior Glass & Partitions', desc: 'Conference room walls, office dividers, and branded glass graphics. Decorative frosted film adds privacy without losing light. Custom-cut patterns transform plain partitions into design features. Anti-graffiti film protects elevator banks and high-traffic glass from scratching and etching.', img: '/images/commercial/commercial-glass-partition-window-film-philadelphia.jpg', alt: 'Office glass conference room partition with decorative frosted window film' },
];

const testimonials = [
  { quote: 'Our tenants were constantly complaining about afternoon glare on their screens. Since the film went on, the complaints stopped and our HVAC runs noticeably less during peak hours. The installation was phased so no tenant was disrupted.', name: 'Diane R.', role: 'Property Manager, Center City office tower', img: '/images/commercial/commercial-window-tinting-philadelphia-testimonial-1.jpg' },
  { quote: 'The anti-graffiti film on our storefront has already paid for itself twice over. Someone scratched the glass and we just peeled the film and replaced it — no glass replacement, no downtime. The security film gives us peace of mind too.', name: 'Robert K.', role: 'Retail owner, South Street', img: '/images/commercial/commercial-window-tinting-philadelphia-testimonial-2.jpg' },
  { quote: 'We reduced our cooling costs noticeably in the first summer. The film is barely visible from inside or out, but the difference in comfort is immediate. Our guests stopped asking to change rooms because of the heat.', name: 'Lisa M.', role: 'Operations Director, boutique hotel', img: '/images/commercial/commercial-window-tinting-philadelphia-testimonial-3.jpg' },
  { quote: 'As a facilities manager overseeing twelve buildings, I need a contractor who handles everything — assessment, coordination, documentation, installation. They worked with our schedule, provided all the compliance paperwork, and the energy savings showed up on the first utility bill.', name: 'Thomas H.', role: 'Facilities Manager, multi-building campus', img: '/images/commercial/commercial-window-tinting-philadelphia-testimonial-4.jpg' },
  { quote: 'We manage a 20-floor building and needed a film that wouldn\'t void our existing glass warranty. They walked us through the thermal stress analysis, got the manufacturer sign-off, and coordinated the installation floor by floor over three weekends. Zero tenant complaints.', name: 'Kevin S.', role: 'Building Engineer, Center City high-rise', img: '/images/commercial/commercial-window-tinting-philadelphia-testimonial-5.jpg' },
  { quote: 'The decorative frosted film they installed on our conference room partitions completely transformed the space. We went from a fishbowl meeting room to a private, professional environment — and the custom-cut company logo in the glass looks incredible. Fast, clean, no mess.', name: 'Linda P.', role: 'Office Manager, law firm', img: '/images/commercial/commercial-window-tinting-philadelphia-testimonial-6.jpg' },
  { quote: 'Our dining room faces west and by 4pm the glare was unbearable — customers were squinting, tables near the windows stayed empty. The solar control film fixed it completely. We can finally seat the full room during dinner service. The install was done overnight so we never closed.', name: 'Marco V.', role: 'Owner, Italian restaurant, Old City', img: '/images/commercial/commercial-window-tinting-philadelphia-testimonial-7.jpg' },
  { quote: 'We needed security film on our ground-floor windows after a break-in. The attachment system they used bonds the film to the frame — it\'s not coming off without serious effort. The insurance company even gave us a discount on our premium after the installation was documented.', name: 'Janet F.', role: 'Boutique owner, Manayunk', img: '/images/commercial/commercial-window-tinting-philadelphia-testimonial-8.jpg' },
];

const processSlides = [
  { step: '01', title: 'Free Site Assessment', desc: 'We visit your property, assess every pane, evaluate glass type and thermal stress risk, discuss your goals, and take exact measurements — at no cost and no obligation.', img: '/images/commercial/commercial-window-tinting-philadelphia-consultation.jpg', imgAlt: 'Commercial window film consultant assessing office building windows in Philadelphia', cta: 'Request a Site Assessment', ctaHref: '/contact/' },
  { step: '02', title: 'Precision Preparation', desc: 'Film is pre-cut by plotter to your exact pane dimensions. We coordinate with your building manager to schedule installation around tenant operations — after hours, weekends, or phased by zone.', img: '/images/commercial/commercial-window-film-preparation-philadelphia.jpg', imgAlt: 'Precision plotter cutting commercial window film to exact dimensions', cta: 'See Our Process', ctaHref: '/process/' },
