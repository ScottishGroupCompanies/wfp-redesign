<style>
/* ── DESIGN TOKENS — site palette, no brown ══ */
:root {
  --rsh-radius: 5px;
  --rsh-charcoal: #272E32;
  --rsh-green: #81AB4C;
  --rsh-green-light: #eef4e4;
  --rsh-green-dark: #7CB342;
  --rsh-off-white: #F7F6F3;
  --rsh-text-dark: #1a1a1a;
  --rsh-text-mid: #4a4a4a;
  --rsh-text-light: #888;
}

.rsh-body { background: #ffffff; }
.rsh-container { max-width: 1280px; margin: 0 auto; padding: 0 5%; }

/* ── EYEBROW ══ */
.rsh-eyebrow {
  display: inline-block;
  font-family: 'DM Sans', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--rsh-green);
  margin-bottom: 16px;
}
.rsh-eyebrow--light { color: var(--rsh-green-dark); }

/* ── HERO ══ */
.rsh-hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
