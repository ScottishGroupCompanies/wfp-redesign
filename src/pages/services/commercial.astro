.rsh-ftype__nav-label {
  font-family: 'DM Sans', sans-serif;
  font-size: 0.8rem;
  font-weight: 600;
  color: rgba(255,255,255,0.6);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  transition: color 0.3s;
}
.rsh-ftype__nav-item--active .rsh-ftype__nav-label {
  color: #fff;
}
@media (max-width: 768px) {
  .rsh-ftype__content { padding-left: 24px; padding-right: 24px; }
  .rsh-ftype__nav { right: 16px; gap: 14px; }
  .rsh-ftype__nav-label { display: none; }
}

/* ── SERVICE AREA — Map + neighborhoods ══ */
.rsh-local {
  padding: 80px 5%;
}
.rsh-local__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  max-width: 1280px;
  margin: 0 auto;
}
.rsh-local__map {
  border-radius: 5px;
  overflow: hidden;
  height: 500px;
}
.rsh-local__map iframe {
  width: 100%;
  height: 100%;
}
.rsh-local__content {
  display: flex;
  flex-direction: column;
}
.rsh-local__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 700;
  letter-spacing: -0.5px;
  color: var(--rsh-text-dark);
  margin: 0 0 16px;
}
.rsh-local__intro {
  font-family: 'DM Sans', sans-serif;
  font-size: 1rem;
  color: var(--rsh-text-mid);
  line-height: 1.8;
  margin: 0 0 28px;
}
.rsh-neighborhoods {
  display: flex;
  flex-direction: column;
}
.rsh-nh {
  display: flex;
  gap: 16px;
  padding: 14px 0;
  border-bottom: 1px solid #EFEFED;
}
.rsh-nh:last-child { border-bottom: none; }
.rsh-nh__name {
  font-family: 'DM Sans', sans-serif;
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--rsh-green);
  white-space: nowrap;
  min-width: 120px;
  flex-shrink: 0;
}
.rsh-nh__desc {
  font-family: 'DM Sans', sans-serif;
  font-size: 0.875rem;
  color: var(--rsh-text-mid);
  line-height: 1.6;
}
@media (max-width: 768px) {
  .rsh-local__grid { grid-template-columns: 1fr; }
  .rsh-local__map { height: 300px; }
  .rsh-nh { flex-direction: column; gap: 4px; }
  .rsh-nh__name { min-width: auto; }
}

/* ── RESPONSIVE ══ */
@media (max-width: 992px) {
  .rsh-intro__container { grid-template-columns: 1fr; gap: 32px; }
  .rsh-hero__stats-panel { max-width: 100%; }
}
@media (max-width: 720px) {
  .rsh-housing__row { grid-template-columns: 1fr; gap: 2rem; }
  .rsh-housing__row--rev { direction: ltr; }
  .rsh-housing__img { order: -1; }
  .rsh-hero__stats-inner { flex-wrap: wrap; }
  .rsh-hero__stat-divider { display: none; }
}
</style>

<script>
  const ftypeSection = document.getElementById('rshFtype');
  if (ftypeSection) {
    const track = document.getElementById('rshFtypeTrack');
    const slides = Array.from(ftypeSection.querySelectorAll('.rsh-ftype__slide'));
    const navItems = Array.from(ftypeSection.querySelectorAll('.rsh-ftype__nav-item'));
    let current = 0;
    const total = slides.length;
    let timer = null;

    function goTo(index) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      current = index;
      track.style.transform = `translateX(-${current * 100}%)`;
      slides.forEach((s, i) => s.classList.toggle('rsh-ftype-active', i === current));
      navItems.forEach((n, i) => n.classList.toggle('rsh-ftype__nav-item--active', i === current));
      resetTimer();
    }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(() => goTo(current + 1), 7000);
    }

    navItems.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = parseInt(btn.dataset.target || '0', 10);
        goTo(target);
      });
    });

    resetTimer();
  }
</script>
