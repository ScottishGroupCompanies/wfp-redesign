.rsh-intro__image-wrap { overflow: hidden; }
.rsh-intro__image {
  width: 100%;
  height: 100%;
  max-height: 480px;
  object-fit: cover;
  display: block;
}

/* ── HOUSING TYPES ══ */
.rsh-housing { padding: 60px 0; }
.rsh-housing__hd {
  max-width: 680px;
  margin: 0 auto 48px;
  text-align: center;
}
.rsh-housing__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  font-weight: 700;
  line-height: 1.15;
