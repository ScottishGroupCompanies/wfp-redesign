<script>
  // Utility bill lightbox
  (function initBillLightbox() {
    const lightbox = document.getElementById('mfLightbox');
    const lightboxImg = document.getElementById('mfLightboxImg');
    const closeBtn = document.getElementById('mfLightboxClose');

    if (!lightbox || !lightboxImg || !closeBtn) return;

    function openBill(src) {
      lightboxImg.src = src;
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeBill() {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      // Clear src after transition
      setTimeout(() => { if (!lightbox.classList.contains('is-open')) lightboxImg.src = ''; }, 300);
    }

    document.querySelectorAll('.mf-bill[data-bill]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        openBill(btn.dataset.bill);
      });
    });

    closeBtn.addEventListener('click', closeBill);
    lightbox.addEventListener('click', function(e) {
      if (e.target === lightbox) closeBill();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && lightbox.classList.contains('is-open')) closeBill();
    });
  })();
</script>