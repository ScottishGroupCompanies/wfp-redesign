---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogos from '../components/BrandLogos.astro';
import GalleryBanner from '../components/GalleryBanner.astro';
import BentoGridPhoto from '../components/BentoGridPhoto.astro';
import HowItWorksSlideshow from '../components/HowItWorksSlideshow.astro';
import TestimonialMarquee from '../components/TestimonialMarquee.astro';
import AccordionFAQ from '../components/AccordionFAQ.astro';
import CTAAvatars from '../components/CTAAvatars.astro';

const title = 'About Window Film Philadelphia | 15+ Years of Professional Window Tinting';
const description = 'Window Film Philadelphia has been installing professional window film across the Delaware Valley since 2008. Licensed in PA & NJ, 1.2M+ sq ft installed, 4.9-star rated. Learn our story.';
const dateModified = new Date().toISOString().slice(0, 10);

const galleryPhotos = [
  '/images/about/philadelphia-rowhome-window-tinting-gallery.jpg',
  '/images/about/office-window-tinting-philadelphia-gallery.jpg',
  '/images/about/retail-security-window-film-philadelphia-gallery.jpg',
  '/images/about/decorative-window-film-philadelphia-gallery.jpg',
  '/images/about/window-film-installer-philadelphia-gallery.jpg',
];

const bentoItems = [
  { span: 'lg', title: 'Center City High-Rises', desc: 'Solar control and security film on glass curtain walls across the Philadelphia skyline.', img: '/images/about/center-city-window-film-philadelphia-bento.jpg', href: '/applications/office/' },
  { span: 'sm', title: 'Precision Tools', desc: 'Plotter-cut film, factory-specified technique, no freehand trimming.', img: '/images/about/window-film-installation-tools-philadelphia-bento.jpg', href: '/process/' },
  { span: 'sm', title: 'The Film Edge', desc: 'Every pane inspected for defects before we pack up.', img: '/images/about/window-tint-film-detail-philadelphia-bento.jpg', href: '/benefits/' },
  { span: 'md', title: 'Philadelphia Rowhomes', desc: 'UV and energy-saving film for historic and modern residences.', img: '/images/about/philadelphia-rowhome-window-film-bento.jpg', href: '/applications/homes-condos/' },
  { span: 'md', title: 'Commercial Storefronts', desc: 'Security and anti-graffiti film for street-facing glass.', img: '/images/about/commercial-storefront-window-film-philadelphia-bento.jpg', href: '/applications/retail/' },
  { span: 'md', title: 'High-Rise Installation', desc: 'Scaffold-access work on multi-story glass facades.', img: '/images/about/high-rise-window-film-installation-philadelphia-bento.jpg', href: '/services/commercial/' },
];

const processSlides = [
  { step: '01', title: 'Free Consultation', desc: 'We visit your property, assess every pane, evaluate glass type and thermal stress risk, and discuss your goals — at no cost and no obligation. Whether you need <a href="/services/residential/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">residential window film</a> or <a href="/services/commercial/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">commercial window tinting</a>, the process starts with understanding your space.', img: '/images/about/window-film-consultation-philadelphia-process.jpg', imgAlt: 'Window film consultant meeting with a Philadelphia homeowner during a free consultation' },
  { step: '02', title: 'Precision Preparation', desc: 'Film is pre-cut by computer-controlled plotter to your exact pane dimensions — no freehand trimming, no waste. We coordinate scheduling around your operations, whether that means after-hours installation for an occupied office or a single-day residential appointment.', img: '/images/about/window-film-plotter-cutting-philadelphia-process.jpg', imgAlt: 'Computer-controlled plotter cutting window film to exact pane dimensions' },
  { step: '03', title: 'Professional Installation', desc: 'Film is applied using manufacturer-specified techniques: squeegeed from center outward, edges trimmed to pane edges, every pane inspected for defects. Our crews are W-2 employees — not subcontractors — which means consistent quality on every job, from a <a href="/applications/homes-condos/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">South Philly rowhome</a> to a <a href="/government-buildings/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">federal courthouse</a>.', img: '/images/about/window-film-installation-philadelphia-process.jpg', imgAlt: 'Professional installer applying window film to a large commercial window in Philadelphia' },
  { step: '04', title: 'Walkthrough & Warranty', desc: 'We walk through every pane with you, explain care during the cure period, provide manufacturer warranty documentation, and deliver compliance specs for your records. If anything looks off, we fix it before we leave — no exceptions.', img: '/images/about/window-film-walkthrough-philadelphia-process.jpg', imgAlt: 'Installer and homeowner reviewing completed window film installation in Philadelphia' },
];

const testimonials = [
  { quote: 'They installed film on every window in our 12-unit building. The crew was organized, respectful, and done in two days. Our cooling costs dropped immediately — we can actually keep the hallway comfortable in August now.', name: 'Diane R.', role: 'Property Manager · Center City', img: '/images/about/about-avatar-1.jpg' },
  { quote: 'I called three companies before choosing Window Film Philadelphia. They were the only ones who actually came out, assessed the glass, and explained why certain films would work and others would not. The installation was spotless.', name: 'Robert K.', role: 'Retail Owner · South Street', img: '/images/about/about-avatar-2.jpg' },
  { quote: 'Our Victorian has original 1890s glass. Every other company said we could not put film on it. They assessed each pane individually, found the right film, and installed it without a single issue. The floors stopped fading within months.', name: 'Lisa M.', role: 'Homeowner · Rittenhouse Square', img: '/images/about/about-avatar-3.jpg' },
  { quote: 'As a facilities manager overseeing fourteen buildings, I need a contractor who handles everything — assessment, coordination, documentation, installation. They worked with our schedule, provided all the compliance paperwork, and the energy savings showed up on the first utility bill.', name: 'Thomas H.', role: 'Facilities Manager · University City', img: '/images/about/about-avatar-4.jpg' },
  { quote: 'The security film on our storefront survived an attempted break-in. The glass cracked but stayed in place — the thief could not get through. That film paid for itself in one night. I tell every business owner on our block to call them.', name: 'Janet F.', role: 'Boutique Owner · Manayunk', img: '/images/about/about-avatar-5.jpg' },
  { quote: 'We needed decorative frosted film on our conference room partitions. They custom-cut our company logo into the film. The install was fast, clean, and the result looks like it came with the building. Could not be happier.', name: 'Linda P.', role: 'Office Manager · Old City', img: '/images/about/about-avatar-6.jpg' },
  { quote: 'Our dining room faces west and by 4pm the glare was unbearable. The solar control film fixed it completely. We can finally seat the full room during dinner service. The install was done overnight so we never closed.', name: 'Marco V.', role: 'Restaurant Owner · Old City', img: '/images/about/about-avatar-7.jpg' },
  { quote: 'I had them out for a free consultation not expecting much. The installer spent an hour explaining different films, showing me samples, and helping me pick the right one for my budget. No pressure, no upsell. The film has been perfect.', name: 'Sarah M.', role: 'Homeowner · Fishtown', img: '/images/about/about-avatar-8.jpg' },
];

const faqItems = [
  { question: 'How long has Window Film Philadelphia been in business?', answer: 'Window Film Philadelphia has been installing professional window film across the Delaware Valley since 2008. Our team has completed over 2,400 projects totaling more than 1.2 million square feet of installed film, ranging from single-pane residential installations to multi-floor commercial high-rises.' },
  { question: 'Are your installers employees or subcontractors?', answer: 'Every installer on our team is a W-2 employee — we do not use subcontractors. This means consistent training, consistent quality, and accountability on every project. Our installers are factory-certified by the manufacturers we represent, including 3M, LLumar, Vista, and Solar Gard.' },
  { question: 'What areas do you serve?', answer: 'We serve the entire Delaware Valley including Center City, Old City, South Philly, Fishtown, Northern Liberties, Manayunk, University City, King of Prussia, Camden NJ, and surrounding areas. Our installation crews are Philadelphia-based — no travel surcharge within the standard service area. We are licensed and insured in both Pennsylvania and New Jersey.' },
  { question: 'Do you offer free consultations?', answer: 'Yes. Every project starts with a free on-site consultation. We assess your glass, discuss your goals, take exact measurements, and provide a detailed proposal — no pressure and no obligation. For commercial properties, we coordinate with your building manager or facilities team to schedule around your operations.' },
  { question: 'What types of window film do you install?', answer: 'We install the full range of professional window film: solar control, UV protection, glare reduction, privacy, safety and security, anti-graffiti, decorative, blast mitigation, ballistic-resistant, exterior building wraps, and mirror refinishing. We carry products from 3M, LLumar, Vista, Solar Gard, Huper Optik, Madico, and other leading manufacturers.' },
  { question: 'Can you install film on historic glass?', answer: 'Yes. We have extensive experience working with historic properties across Philadelphia, including homes with original 19th-century glass. We assess each pane individually for thermal stress risk before recommending a film. Many clear UV-blocking films are virtually invisible on glass, making them ideal for historic preservation contexts.' },
  { question: 'Do you work with property managers and commercial portfolios?', answer: 'Yes. A significant portion of our work is through property management firms and building managers who oversee multiple properties. We provide site assessments, detailed proposals, compliance documentation, and coordinate installations across portfolios. We carry the documentation most management companies require.' },
  { question: 'What warranty coverage comes with your installations?', answer: 'Every installation includes manufacturer warranty coverage for film performance — peeling, bubbling, discoloration, and solar heat rejection. We also provide a labor warranty on every installation. Warranty terms vary by product and film type; we walk you through the specifics for your chosen product during the consultation.' },
];

const faqAccordionItems = faqItems.map(f => ({ q: f.question, a: f.answer }));

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'About', item: 'https://www.windowfilmphiladelphia.net/about/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://www.windowfilmphiladelphia.net/about/',
    url: 'https://www.windowfilmphiladelphia.net/about/',
    name: 'About Window Film Philadelphia',
    description,
    dateModified,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': 'https://www.windowfilmphiladelphia.net/about/',
    url: 'https://www.windowfilmphiladelphia.net/about/',
    name: 'About Window Film Philadelphia',
    description,
    dateModified,
    about: {
      '@type': 'LocalBusiness',
      name: 'Window Film Philadelphia',
      description: 'Professional window film installation for residential, commercial, and institutional properties in Philadelphia and the Delaware Valley since 2008.',
      foundingDate: '2008',
      areaServed: ['Philadelphia, PA', 'Camden, NJ', 'Reading, PA', 'Upper Darby, PA', 'Delaware Valley'],
      aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', ratingCount: '2400', bestRating: '5', worstRating: '1' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(f => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.windowfilmphiladelphia.net/about/"
  faqItems={faqItems}
  serviceName="Window Film Philadelphia"
  serviceDesc="Professional window film installation for residential, commercial, and institutional properties in Philadelphia and the Delaware Valley since 2008."
  serviceUrl="https://www.windowfilmphiladelphia.net/about/"
  schemas={pageSchemas}
>

<!-- ═══ HERO ═══ -->
<section class="ab-hero">
  <div class="ab-hero__bg" style="background-image: url('/images/about/window-film-philadelphia-about-hero.jpg')" role="img" aria-label="Professional window film installation team working on a Philadelphia building"></div>
  <div class="ab-hero__overlay"></div>
  <div class="ab-hero__content">
    <div class="ab-hero__eyebrow">
      <span class="ab-hero__eyebrow-dot" aria-hidden="true"></span>
      ABOUT WINDOW FILM PHILADELPHIA
      <span class="ab-hero__eyebrow-dot" aria-hidden="true"></span>
    </div>
    <h1 class="ab-hero__title">Philadelphia's Window Film Team Since 2008</h1>
    <p class="ab-hero__subtitle">Over 15 years installing professional window film across the Delaware Valley — from South Philly rowhomes to Center City high-rises. Licensed, insured, and factory-certified in Pennsylvania and New Jersey.</p>
    <div class="ab-hero__cta">
      <a href="/contact/" class="ab-hero__btn-primary">Get a Free Consultation</a>
      <a href="tel:2673947980" class="ab-hero__btn-secondary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
        Call (267) 394-7980
      </a>
    </div>
    <div class="ab-hero__stats-panel" aria-label="Key statistics">
      <div class="ab-hero__stats-inner">
        <div class="ab-hero__stat">
          <span class="ab-hero__stat-number">PA & NJ</span>
          <span class="ab-hero__stat-label">Licensed In</span>
        </div>
        <div class="ab-hero__stat-divider" aria-hidden="true"></div>
        <div class="ab-hero__stat">
          <span class="ab-hero__stat-number">2008</span>
          <span class="ab-hero__stat-label">Serving Since</span>
        </div>
        <div class="ab-hero__stat-divider" aria-hidden="true"></div>
        <div class="ab-hero__stat">
          <span class="ab-hero__stat-number">2,400+</span>
          <span class="ab-hero__stat-label">Projects Completed</span>
        </div>
        <div class="ab-hero__stat-divider" aria-hidden="true"></div>
        <div class="ab-hero__stat">
          <span class="ab-hero__stat-number">4.9</span>
          <span class="ab-hero__stat-label">Google Rating</span>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="ab-body">

<!-- TRUST BAR -->
<section class="ab-trust">
  <div class="ab-container">
    <p class="ab-trust__label">Trusted by Philadelphia homeowners, businesses, and institutions since 2008</p>
  </div>
</section>

<BrandLogos />

<!-- ═══ INTRO — Our Story ═══ -->
<section class="ab-intro">
  <div class="ab-intro__container">
    <div class="ab-intro__image-wrap">
      <img src="/images/about/window-film-installation-philadelphia-craftsmanship.jpg" alt="Professional window film installer squeegeeing film on glass in Philadelphia" class="ab-intro__image" loading="lazy" />
    </div>
    <div class="ab-intro__content">
      <span class="ab-eyebrow">Our Story</span>
      <h2 class="ab-intro__title">It started with a single window — and a difference you could feel.</h2>
      <p class="ab-intro__lead">The company behind Window Film Philadelphia was founded in 2008, born from a simple experiment: installing energy-saving window film on a home and watching the heating and cooling bills drop. That first installation proved what film could do — reduce glare, block UV, cut energy costs, and protect furnishings — all without replacing a single pane of glass.</p>
      <p class="ab-intro__lead">Today, our Philadelphia team carries that same hands-on conviction into every project. We are not a call center dispatching subcontractors. We are installers — factory-certified, W-2 employees who assess your glass, recommend the right product, and apply it with precision. From a <a href="/applications/homes-condos/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">rowhome in Fishtown</a> to a <a href="/applications/office/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">Center City office tower</a>, the approach is the same: the right film, applied right.</p>
    </div>
  </div>
</section>

<!-- ═══ WHAT WE DO — Alternating rows ═══ -->
<section class="ab-whatwedo">
  <div class="ab-container">
    <span class="ab-eyebrow ab-eyebrow--center">What We Do</span>
    <h2 class="ab-whatwedo__title">Professional window film for every type of Philadelphia glass.</h2>
    <p class="ab-whatwedo__lead">We install the full spectrum of professional window film — <a href="/benefits/energy-savings/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">solar control</a>, <a href="/benefits/uv-blocking-window-film-philadelphia/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">UV protection</a>, <a href="/benefits/glare-reduction/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">glare reduction</a>, <a href="/benefits/privacy-window-film-philadelphia/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">privacy</a>, <a href="/benefits/safety-and-security/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">security</a>, <a href="/benefits/anti-graffiti/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">anti-graffiti</a>, <a href="/benefits/decorative-promotional/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">decorative</a>, and more. Every product is backed by manufacturer warranty and applied to your existing glass — no replacement, no disruption.</p>
  </div>

  <div class="ab-whatwedo__rows">
    <div class="ab-row">
      <div class="ab-row__text">
        <span class="ab-row__num">01</span>
        <h3 class="ab-row__title">Residential Window Film</h3>
        <p class="ab-row__body">From <a href="/applications/homes-condos/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">South Philly rowhomes</a> to Rittenhouse condos and historic Victorians — we install film that cuts cooling costs, blocks UV, adds privacy, and protects floors and furnishings from fading. Every pane assessed individually for thermal stress risk before we recommend a product.</p>
      </div>
      <div class="ab-row__image">
        <img src="/images/about/philadelphia-rowhome-window-film-bento.jpg" alt="Philadelphia rowhome with professional window film installed on original windows" loading="lazy" />
      </div>
    </div>
    <div class="ab-row ab-row--rev">
      <div class="ab-row__text">
        <span class="ab-row__num">02</span>
        <h3 class="ab-row__title">Commercial Window Tinting</h3>
        <p class="ab-row__body"><a href="/services/commercial/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">Commercial window tinting in Philadelphia</a> is our largest practice area. Office towers, retail storefronts, hotels, restaurants, and multi-building portfolios. Solar control film reduces HVAC load, glare reduction film eliminates screen washout, security film protects against break-ins, and anti-graffiti film keeps street-facing glass clean.</p>
      </div>
      <div class="ab-row__image">
        <img src="/images/about/commercial-storefront-window-film-philadelphia-bento.jpg" alt="Philadelphia commercial storefront with security window film installed" loading="lazy" />
      </div>
    </div>
    <div class="ab-row">
      <div class="ab-row__text">
        <span class="ab-row__num">03</span>
        <h3 class="ab-row__title">Institutional & Government</h3>
        <p class="ab-row__body">We install <a href="/government-buildings/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">security and blast mitigation film</a> on government buildings, <a href="/applications/schools-universities/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">safety film on schools</a>, UV protection on <a href="/applications/museums-libraries/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">museum collections</a>, and privacy film in <a href="/applications/healthcare/" style="color: var(--ab-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">healthcare facilities</a>. We carry the documentation compliance teams and facility managers need.</p>
      </div>
      <div class="ab-row__image">
        <img src="/images/about/center-city-window-film-philadelphia-bento.jpg" alt="Philadelphia Center City high-rise with professional window film on glass facade" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<!-- ═══ GALLERY BANNER — Our Work ═══ -->
<GalleryBanner
  titleLines={['OUR', 'WORK.']}
  eyebrow="PHILADELPHIA INSTALLS"
  description="A collection of real window film installations across Philadelphia. Every project assessed, applied, and finished by our own certified team — no subcontractors."
  photos={galleryPhotos}
  hintText="Hover the photos · click to bring forward"
  theme="dark"
/>

<!-- ═══ VALUES — Why Choose Us ═══ -->
<section class="ab-values">
  <div class="ab-container">
    <span class="ab-eyebrow ab-eyebrow--center">Why Philadelphia Chooses Us</span>
    <h2 class="ab-values__title">Principles we install by.</h2>
    <div class="ab-values__grid">
      <div class="ab-value">
        <div class="ab-value__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--ab-green)" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h3 class="ab-value__title">W-2 Employees, Not Subcontractors</h3>
        <p class="ab-value__body">Every installer on your property is a factory-certified employee. Consistent training, consistent quality, and accountability on every job — from a single residential pane to a multi-floor commercial high-rise.</p>
      </div>
      <div class="ab-value">
        <div class="ab-value__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--ab-green)" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l4.461-4.461a2 2 0 012.828 0l.207.207a2 2 0 010 2.828l-4.461 4.461M11.42 15.17L6.75 21A2.652 2.652 0 003 17.25l5.877-5.877M11.42 15.17l-4.461-4.461a2 2 0 00-2.828 0l-.207.207a2 2 0 000 2.828l4.461 4.461"/></svg>
        </div>
        <h3 class="ab-value__title">Every Pane Assessed Individually</h3>
        <p class="ab-value__body">We check glass type, age, condition, orientation, and thermal stress risk before recommending a film. Different zones of the same building often need different films — solar control on the west, glare reduction on the south, security on the ground floor.</p>
      </div>
      <div class="ab-value">
        <div class="ab-value__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--ab-green)" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/></svg>
        </div>
        <h3 class="ab-value__title">Free Consultation, No Pressure</h3>
        <p class="ab-value__body">Every project starts with a free on-site assessment. We explain your options, show you film samples, and give you a detailed proposal. No upsell, no obligation. You decide what works for your building and your budget.</p>
      </div>
      <div class="ab-value">
        <div class="ab-value__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--ab-green)" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-.435-8.5-1.118z"/></svg>
        </div>
        <h3 class="ab-value__title">Licensed, Insured, Documented</h3>
        <p class="ab-value__body">Licensed and insured in both Pennsylvania and New Jersey. We carry the documentation property managers, compliance teams, and facility managers need — manufacturer specs, thermal stress analysis, warranty paperwork, and compliance certificates.</p>
      </div>
      <div class="ab-value">
        <div class="ab-value__icon">
