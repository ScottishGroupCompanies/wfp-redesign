---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackAndForthSection from '../components/BackAndForthSection.astro';
import BrandLogos from '../components/BrandLogos.astro';
import CTAStrip from '../components/CTAStrip.astro';

const title = 'Installation Process | Window Film Philadelphia | Auron Solar Style';
const description = 'Step-by-step window film installation process in Philadelphia — consultation, prep, precision application, and final inspection. Free consultation available.';

const steps = [
  {
    heading: 'Step One: Free Consultation & Window Assessment',
    body: 'We begin every project with a thorough, no-obligation consultation. Our window film specialists assess your glass surfaces, discuss your goals — whether it\'s energy savings, UV protection, privacy, safety, or aesthetics — and recommend the ideal film solution for your property. Same-day quotes are available.',
    imageSrc: '/images/2021-10-window-film-process-philadelphia.jpg',
    imageAlt: 'Window film consultation Philadelphia',
  },
  {
    heading: 'Step Two: Precise Measurement & Custom Film Cutting',
    body: 'Accurate measurements are critical for a flawless fit. Our technicians measure every window pane individually and custom-cut the film to exact dimensions, minimizing waste and ensuring seamless edges. Each panel is labeled for efficient installation.',
    imageSrc: '/images/2021-10-window-film-measurement-philadelphia.jpg',
    imageAlt: 'Window film measurement Philadelphia',
  },
  {
    heading: 'Step Three: Professional Glass Preparation',
    body: 'Proper adhesion starts with a perfectly clean surface. Our installers thoroughly clean the glass using specialized razor blades, squeegees, and pH-balanced cleaning solutions to remove all dirt, residue, and contaminants. This step is the foundation of a long-lasting bond.',
    imageSrc: '/images/2021-10-window-film-preparation-philadelphia.jpg',
    imageAlt: 'Window film preparation Philadelphia',
  },
  {
    heading: 'Step Four: Precision Film Application',
    body: 'Using slip solution to position the film correctly, our trained installers apply the film with care, working out air bubbles and water from the center outward. For exterior films or high-exposure applications, we apply C-Bond adhesion technology for faster cure times and superior bond strength.',
    imageSrc: '/images/2021-10-window-film-installation-philadelphia.jpg',
    imageAlt: 'Window film installation Philadelphia',
  },
  {
    heading: 'Step Five: Edge Sealing & Quality Inspection',
    body: 'Once the film is positioned, we perform a meticulous edge-sealing process to lock in the bond and prevent moisture infiltration. Every installation undergoes a multi-point quality inspection to verify clarity, adhesion, and a flawless finish before we consider the job complete.',
    imageSrc: '/images/2021-10-window-film-edge-sealing-philadelphia.jpg',
    imageAlt: 'Window film edge sealing Philadelphia',
  },
  {
    heading: 'Step Six: Final Walkthrough & Care Instructions',
    body: 'We conclude every project with a full walkthrough, demonstrating how to care for your new window film and answering any questions. Important: do not clean your window film for 30 days after installation to allow the adhesive to fully cure. We also review your manufacturer warranty coverage.',
    imageSrc: '/images/2021-10-window-film-final-inspection-philadelphia.jpg',
    imageAlt: 'Window film final inspection Philadelphia',
  },
];

const faqs = [
  {
    q: 'How long does the window film installation process take?',
    a: 'Most residential projects are completed in a single day. Commercial properties or larger builds may require multiple visits. During your consultation, we\'ll provide a detailed timeline based on the number of windows and film type selected.',
  },
  {
    q: 'Do I need to vacate my home or business during installation?',
    a: 'No — window film is applied to the interior surface of your glass, so you can remain on the property during installation. We simply ask that our installers have clear access to the windows and a clean workspace.',
  },
  {
    q: 'Can window film be installed in any weather?',
    a: 'Our interior application process is not weather-dependent, so installations can proceed year-round. Exterior films may require specific temperature conditions for proper adhesion — we\'ll advise on timing during your consultation.',
  },
  {
    q: 'What is the curing process and why is it important?',
    a: 'After installation, the adhesive in window film需要一个固化周期 to reach full bond strength. During this time — typically 30 days — the film may appear slightly hazy or have minor water pockets. This is normal and will clear as the film cures. Do not clean the film during this period.',
  },
  {
    q: 'Will window film damage my glass?',
    a: 'No. Professionally installed window film is safe for standard glass types. We conduct a full assessment during consultation to ensure compatibility. For older or damaged glass, we may recommend specific film types or a test panel before full application.',
  },
  {
    q: 'What warranty coverage comes with my installation?',
    a: 'All film products are backed by manufacturer warranties ranging from 5 years to lifetime, depending on the product line. Window Film Philadelphia also provides a limited workmanship warranty on all installations for your peace of mind.',
  },
  {
    q: 'Can existing window film be removed and replaced?',
    a: 'Yes. Our team can safely remove old or damaged film and replace it with a new solution. We handle the full removal process, including adhesive cleanup, so your glass is ready for fresh film application.',
  },
];
---

<BaseLayout title={title} description={description} canonical='https://www.windowfilmphiladelphia.net/process/'>

  <!-- Hero -->
  <section class="page-hero" style="background-image: linear-gradient(rgba(30,30,30,0.72), rgba(30,30,30,0.82)), url('/images/2021-10-window-film-process-philadelphia.jpg'); background-size: cover; background-position: center;">
    <div class="container">
      <h1>Our Installation Process</h1>
      <p>A transparent, six-step approach — from initial consultation to final walkthrough. Philadelphia's most trusted window film experts, delivering precision results every time.</p>
    </div>
  </section>

  <!-- Process Overview Strip -->
  <section class="process-strip">
    <div class="container">
      <div class="process-strip__grid">
        <div class="process-strip__item">
          <span class="process-strip__num">01</span>
          <span class="process-strip__label">Consultation</span>
        </div>
        <div class="process-strip__sep">→</div>
        <div class="process-strip__item">
          <span class="process-strip__num">02</span>
          <span class="process-strip__label">Measurement</span>
        </div>
        <div class="process-strip__sep">→</div>
        <div class="process-strip__item">
          <span class="process-strip__num">03</span>
          <span class="process-strip__label">Preparation</span>
        </div>
        <div class="process-strip__sep">→</div>
        <div class="process-strip__item">
          <span class="process-strip__num">04</span>
          <span class="process-strip__label">Application</span>
        </div>
        <div class="process-strip__sep">→</div>
        <div class="process-strip__item">
          <span class="process-strip__num">05</span>
          <span class="process-strip__label">Inspection</span>
        </div>
        <div class="process-strip__sep">→</div>
        <div class="process-strip__item">
          <span class="process-strip__num">06</span>
          <span class="process-strip__label">Walkthrough</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 Installation Steps -->
  <BackAndForthSection
    heading={steps[0].heading}
    body={steps[0].body}
    imageSrc={steps[0].imageSrc}
    imageAlt={steps[0].imageAlt}
    flip={false}
    altBg={false}
  />

  <BackAndForthSection
    heading={steps[1].heading}
    body={steps[1].body}
    imageSrc={steps[1].imageSrc}
    imageAlt={steps[1].imageAlt}
    flip={true}
    altBg={true}
  />

  <BackAndForthSection
    heading={steps[2].heading}
    body={steps[2].body}
    imageSrc={steps[2].imageSrc}
    imageAlt={steps[2].imageAlt}
    flip={false}
    altBg={false}
  />

  <BackAndForthSection
    heading={steps[3].heading}
    body={steps[3].body}
    imageSrc={steps[3].imageSrc}
    imageAlt={steps[3].imageAlt}
    flip={true}
    altBg={true}
  />

  <BackAndForthSection
    heading={steps[4].heading}
    body={steps[4].body}
    imageSrc={steps[4].imageSrc}
    imageAlt={steps[4].imageAlt}
    flip={false}
    altBg={false}
  />

  <BackAndForthSection
    heading={steps[5].heading}
    body={steps[5].body}
    imageSrc={steps[5].imageSrc}
    imageAlt={steps[5].imageAlt}
    flip={true}
    altBg={true}
  />

  <!-- FAQ Section -->
  <section class="section-pad faq-section">
    <div class="container">
      <h2 class="faq-section__title">Frequently Asked Questions — Window Film Installation</h2>
      <div class="faq-list">
        {faqs.map((item) => (
          <div class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust CTA -->
  <BackAndForthSection
    heading={"Work With Philadelphia's Trusted Window Film Installation Experts"}
    body={"Window Film Philadelphia's certified installation team brings precision, professionalism, and deep product knowledge to every project — residential or commercial. Whether you're upgrading a single window or outfitting an entire building, we deliver solutions with a great ROI and award-winning customer service. Contact us today to schedule your free consultation."}
    imageSrc={'/images/2021-10-llumar-window-film-contractor-philadelphia.jpg'}
    imageAlt={'Window film installation experts Philadelphia'}
    flip={false}
    altBg={false}
    ctaLabel={'Schedule a Free Consultation'}
    ctaHref={'/contact/'}
  />

  <BrandLogos />
  <CTAStrip />

</BaseLayout>

<style>
/* ============================================================
   Process Strip — numbered step indicator
   ============================================================ */
.process-strip {
  background: var(--color-charcoal, #2c2c2c);
  padding: 2.5rem var(--section-pad-x);
}

.process-strip__grid {
  max-width: var(--max-width);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.process-strip__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
}

.process-strip__num {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--color-brand-light, #f5a623);
  line-height: 1;
}

.process-strip__label {
  font-family: var(--font-heading);
  font-size: 0.7rem;
  font-weight: 700;
  color: rgba(255,255,255,0.75);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.process-strip__sep {
  color: rgba(255,255,255,0.3);
  font-size: 1.25rem;
  padding: 0 0.25rem;
  margin-bottom: 1.2rem;
}

@media (max-width: 640px) {
  .process-strip__grid {
    gap: 0.25rem;
  }
  .process-strip__sep {
    display: none;
  }
  .process-strip__label {
    font-size: 0.6rem;
  }
}

/* ============================================================
   FAQ Section
   ============================================================ */
.faq-section {
  background: var(--color-bg-section);
}

.faq-section__title {
  margin-bottom: 1.75rem;
  text-align: center;
  font-size: clamp(1.25rem, 3vw, 1.75rem);
}

.faq-list {
  max-width: 760px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.faq-item {
  background: var(--color-bg-white);
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-brand, #2e7d32);
  border-radius: 0 8px 8px 0;
  padding: 1.25rem 1.5rem;
  transition: box-shadow 200ms ease;
}

.faq-item:hover {
  box-shadow: 0 2px 12px rgba(0,0,0,0.08);
}

.faq-item h3 {
  font-size: 0.975rem;
  color: var(--color-charcoal, #2c2c2c);
  margin-bottom: 0.6rem;
  font-weight: 700;
}

.faq-item p {
  font-size: 0.9rem;
  margin: 0;
  color: var(--color-text-secondary);
  line-height: 1.65;
}
</style>