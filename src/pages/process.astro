---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
import BrandLogos from '../components/BrandLogos.astro';
import CTAStrip from '../components/CTAStrip.astro';

const title = 'Our Process | Free Consultation to Professional Installation | Philadelphia';
const description = 'See how Scottish Window Film handles your project: free consultation, expert measurement, professional installation, and quality guarantee.';

const heroImage = 'https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_154522_89e9101b-2c5e-4f46-8dd7-062eea44f9c4.png';

const processSteps = [
  {
    num: '01',
    title: 'Free Consultation',
    desc: 'We assess your windows, discuss your goals, and provide a detailed quote — all at no obligation.',
  },
  {
    num: '02',
    title: 'Expert Measurement',
    desc: 'Every pane is measured precisely so film is custom-cut for a flawless fit with zero waste.',
  },
  {
    num: '03',
    title: 'Professional Installation',
    desc: 'Certified installers prep the glass and apply film with care, working out all air and water.',
  },
  {
    num: '04',
    title: 'Quality Guarantee',
    desc: 'Multi-point inspection, edge sealing, and a full walkthrough with care instructions and warranty.',
  },
];

const faqs = [
  {
    q: 'How long does the window film installation process take?',
    a: 'Most residential projects are completed in a single day. Commercial properties or larger builds may require multiple visits. During your consultation, we\'ll provide a detailed timeline based on the number of windows and film type selected.',
  },
  {
    q: 'Do I need to vacate my home or business during installation?',
    a: 'No — window film is applied to the interior surface of your glass, so you can remain on the property during installation. We simply ask that our installers have clear access to the windows and a clean workspace.',
  },
  {
    q: 'Can window film be installed in any weather?',
    a: 'Our interior application process is not weather-dependent, so installations can proceed year-round. Exterior films may require specific temperature conditions for proper adhesion — we\'ll advise on timing during your consultation.',
  },
  {
    q: 'What is the curing process and why is it important?',
    a: 'After installation, the adhesive in window film需要一个固化周期 to reach full bond strength. During this time — typically 30 days — the film may appear slightly hazy or have minor water pockets. This is normal and will clear as the film cures. Do not clean the film during this period.',
  },
  {
    q: 'Will window film damage my glass?',
    a: 'No. Professionally installed window film is safe for standard glass types. We conduct a full assessment during consultation to ensure compatibility. For older or damaged glass, we may recommend specific film types or a test panel before full application.',
  },
  {
    q: 'What warranty coverage comes with my installation?',
    a: 'All film products are backed by manufacturer warranties ranging from 5 years to lifetime, depending on the product line. Window Film Philadelphia also provides a limited workmanship warranty on all installations for your peace of mind.',
  },
  {
    q: 'Can existing window film be removed and replaced?',
    a: 'Yes. Our team can safely remove old or damaged film and replace it with a new solution. We handle the full removal process, including adhesive cleanup, so your glass is ready for fresh film application.',
  },
];
---

<BaseLayout title={title} description={description} canonical='https://www.windowfilmphiladelphia.net/process/'>
  <InnerPageHero
    title="How It Works"
    bgImage={heroImage}
    desc="Simple process · Expert execution · Guaranteed results"
  />

  <div class="ip-page-body">

    <!-- ── Process Steps Strip ── -->
    <section class="steps-section">
      <div class="steps-container">
        <div class="steps-track">
          {processSteps.map((step, i) => (
            <div class="step-item">
              <div class="step-num">{step.num}</div>
              <div class="step-body">
                <h3 class="step-title">{step.title}</h3>
                <p class="step-desc">{step.desc}</p>
              </div>
              {i < processSteps.length - 1 && <div class="step-connector" />}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Process Detail Cards ── -->
    <section class="process-detail">
      <div class="container">
        <div class="process-detail__grid">
          {processSteps.map((step, i) => (
            <div class="process-card">
              <div class="process-card__num">{step.num}</div>
              <h3 class="process-card__title">{step.title}</h3>
              <p class="process-card__desc">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Trust Banner ── -->
    <section class="trust-banner">
      <div class="container">
        <div class="trust-banner__inner">
          <div class="trust-banner__text">
            <h2>Philadelphia's Trusted Window Film Experts</h2>
            <p>From first call to final walkthrough, our certified team delivers precision results on every project — residential or commercial.</p>
          </div>
          <div class="trust-banner__actions">
            <a href="/contact/" class="btn btn--primary">Schedule Free Consultation</a>
            <a href="tel:2150000000" class="btn btn--outline">Call Us Today</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── FAQ Section ── -->
    <section class="faq-section">
      <div class="container">
        <h2 class="faq-section__title">Frequently Asked Questions</h2>
        <div class="faq-list">
          {faqs.map((item, i) => (
            <div class="faq-item" data-faq>
              <button class="faq-trigger" aria-expanded="false" aria-controls={`faq-body-${i}`}>
                <span class="faq-q">{item.q}</span>
                <span class="faq-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                  </svg>
                </span>
              </button>
              <div class="faq-body" id={`faq-body-${i}`} hidden>
                <p>{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <BrandLogos />
    <CTAStrip />

  </div>
</BaseLayout>

<style>
  /* ── ip-page-body wrapper ── */
  .ip-page-body {
    position: relative;
    background: #ffffff;
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
    margin-top: -40px;
    z-index: 10;
    overflow: visible;
    padding-bottom: 80px;
  }

  /* ── Steps Strip ── */
  .steps-section {
    background: var(--brand);
    padding: 4rem 5% 3rem;
    position: relative;
    overflow: hidden;
  }

  .steps-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(to right, var(--green), #a8c97e, var(--green));
  }

  .steps-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .steps-track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    position: relative;
  }

  .step-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 1.5rem;
    position: relative;
  }

  .step-num {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--green);
    color: #ffffff;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    position: relative;
    z-index: 2;
    box-shadow: 0 0 0 6px rgba(129, 171, 76, 0.2);
  }

  .step-connector {
    position: absolute;
    top: 36px;
    left: calc(50% + 36px);
    width: calc(100% - 72px);
    height: 2px;
    background: linear-gradient(to right, rgba(129, 171, 76, 0.5), rgba(129, 171, 76, 0.15));
    z-index: 1;
  }

  .step-body {
    max-width: 200px;
  }

  .step-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.6rem;
    line-height: 1.2;
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Process Detail Cards ── */
  .process-detail {
    padding: 5rem 5%;
    background: var(--off-white);
  }

  .process-detail .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .process-detail__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .process-card {
    background: #ffffff;
    border-radius: var(--radius-lg, 24px);
    padding: 2rem 1.75rem;
    position: relative;
    border: 1px solid var(--light-gray, #EFEFED);
    transition: box-shadow 300ms ease, transform 300ms ease;
  }

  .process-card:hover {
    box-shadow: 0 8px 32px rgba(39, 46, 50, 0.1);
    transform: translateY(-4px);
  }

  .process-card__num {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--green);
    line-height: 1;
    margin-bottom: 1rem;
    opacity: 0.3;
  }

  .process-card__title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--brand);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .process-card__desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--text-mid, #4a4a4a);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Trust Banner ── */
  .trust-banner {
    background: var(--brand);
    padding: 5rem 5%;
    position: relative;
    overflow: hidden;
  }

  .trust-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_154522_89e9101b-2c5e-4f46-8dd7-062eea44f9c4.png') center/cover no-repeat;
    opacity: 0.08;
  }

  .trust-banner__inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .trust-banner__text h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .trust-banner__text p {
    font-family: var(--font-body);
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: 520px;
    margin: 0;
    line-height: 1.6;
  }

  .trust-banner__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    border-radius: var(--radius-pill, 100px);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 200ms ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn--primary {
    background: var(--green);
    color: #ffffff;
    border: 2px solid var(--green);
  }

  .btn--primary:hover {
    background: #6e9640;
    border-color: #6e9640;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(129, 171, 76, 0.4);
  }

  .btn--outline {
    background: transparent;
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.4);
  }

  .btn--outline:hover {
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }

  /* ── FAQ Section ── */
  .faq-section {
    padding: 5rem 5%;
    background: #ffffff;
  }

  .faq-section .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-section__title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--brand);
    text-align: center;
    margin: 0 0 3rem;
    line-height: 1.2;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    border: 1px solid var(--light-gray, #EFEFED);
    border-radius: var(--radius-md, 16px);
    overflow: hidden;
    transition: box-shadow 300ms ease;
    background: #ffffff;
  }

  .faq-item:hover {
    box-shadow: 0 4px 16px rgba(39, 46, 50, 0.06);
  }

  .faq-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background 200ms ease;
    background: #ffffff;
  }

  .faq-trigger:hover {
    background: var(--off-white);
  }

  .faq-q {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--brand);
    line-height: 1.4;
    flex: 1;
  }

  .faq-icon {
    flex-shrink: 0;
    color: var(--green);
    transition: transform 300ms ease;
    display: flex;
    align-items: center;
  }

  .faq-item[data-open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-item[data-open] .faq-trigger {
    border-bottom: 1px solid var(--light-gray);
  }

  .faq-body {
    padding: 1.25rem 1.5rem;
    background: #ffffff;
  }

  .faq-body p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-mid, #4a4a4a);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .steps-track {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 1rem;
    }

    .step-connector {
      display: none;
    }

    .step-item:nth-child(odd)::after {
      display: none;
    }

    .process-detail__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .steps-track {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .steps-section {
      padding: 3rem 5% 2.5rem;
    }

    .process-detail__grid {
      grid-template-columns: 1fr;
    }

    .trust-banner__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .trust-banner__actions {
      flex-direction: column;
      width: 100%;
    }

    .btn {
      width: 100%;
    }
  }
</style>

<script>
  // FAQ accordion
  document.querySelectorAll('[data-faq]').forEach((item) => {
    const trigger = item.querySelector('.faq-trigger') as HTMLButtonElement;
    const body = item.querySelector('.faq-body') as HTMLElement;

    if (!trigger || !body) return;

    trigger.addEventListener('click', () => {
      const isOpen = item.getAttribute('data-open') === 'true';

      // Close all
      document.querySelectorAll('[data-faq]').forEach((el) => {
        el.setAttribute('data-open', 'false');
        const elBody = el.querySelector('.faq-body') as HTMLElement;
        const elTrigger = el.querySelector('.faq-trigger') as HTMLButtonElement;
        if (elBody) elBody.hidden = true;
        if (elTrigger) elTrigger.setAttribute('aria-expanded', 'false');
      });

      // Toggle current
      if (!isOpen) {
        item.setAttribute('data-open', 'true');
        body.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
