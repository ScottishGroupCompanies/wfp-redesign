import { Icon } from 'astro-icon/components';
import huperOptikProducts from '../../data/huper-optik-products.json';

// Group products by series for bento catalog grid
const hoCatalogSeries = Object.values(
  huperOptikProducts.reduce((groups, product) => {
    const key = product.series;
    if (!groups[key]) groups[key] = { name: key, color: product.seriesColor, products: [] };
    groups[key].products.push(product);
    return groups;
  }, {} as Record<string, { name: string; color: string; products: typeof huperOptikProducts }>
));
const truncateCatalogDesc = (s: string) => s.length > 90 ? s.slice(0, 87) + '…' : s;

const title = 'Huper Optik Window Film in Philadelphia | Ceramic Film Experts';
const description = 'Huper Optik window film in Philadelphia — patented titanium nitride ceramic film for superior solar control, UV protection, and signal-safe installation.';
