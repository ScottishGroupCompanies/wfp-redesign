---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import products from '../../../data/hanita-products.json';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product: p } = Astro.props;
const serviceUrl = `https://windowfilmphiladelphia.net/products/hanita/${p.slug}/`;
const title = `Hanita ${p.name} | Philadelphia Installer`;
const description = `${p.shortDescription.slice(0, 155)}`;
const descriptionParagraphs = p.description.split('\n\n').slice(0, 4);
const specRows = [
  ['VLT', p.specs.vlt],
  ['Heat Rejection', p.specs.heatRejection],
  ['UV Block', p.specs.uvBlock],
  ['Thickness', p.specs.thickness],
  ['Warranty', p.specs.warranty],
  ['Series', p.series],
  ['Brand', 'Hanita Coatings'],
].filter(([, value]) => Boolean(value));
const statChips = [
  ['VLT', p.specs.vlt],
  ['Heat Rejection', p.specs.heatRejection],
  ['UV Block', p.specs.uvBlock],
  ['Thickness', p.specs.thickness],
].filter(([, value]) => Boolean(value));
const relatedProducts = p.relatedSlugs
  .map((slug) => products.find((item) => item.slug === slug))
  .filter(Boolean);
const categoryText = `${p.categories.join(' ')} ${p.series}`.toLowerCase();

const applications = categoryText.includes('safety') || categoryText.includes('security')
  ? [
      ['Philadelphia Schools', 'Safety film for K-12 school entry doors, sidelites, and classroom glass — glass retention and forced-entry delay without window replacement.'],
      ['Government Buildings', 'Retrofit safety for Philadelphia municipal offices, courts, and civic buildings with public-facing glass on high-traffic corridors.'],
      ['Retail Storefronts', 'Smash-and-grab deterrence for Philadelphia commercial corridors — Walnut Street, Old City, and Center City retail with street-level glass.'],
    ]
  : categoryText.includes('insulation') || categoryText.includes('low-e') || categoryText.includes('e-lite')
    ? [
        ['Philadelphia Rowhomes', 'Year-round thermal improvement for Fishtown, Society Hill, Graduate Hospital, and Chestnut Hill residences with older single-pane glass.'],
        ['Historic Properties', 'Low-E film upgrade for Philadelphia preservation district buildings where window replacement is restricted by historic guidelines.'],
        ['Commercial Buildings', 'Dual-season energy performance for Philadelphia commercial properties seeking HVAC savings across both summer and winter.'],
      ]
    : [
        ['Center City Offices', 'Solar heat and glare control for Philadelphia Class A towers, boutique suites, and institutional buildings from Market Street to University City.'],
        ['Philadelphia Rowhomes', 'UV and heat management for Fishtown, Chestnut Hill, Rittenhouse, and Graduate Hospital residences without window replacement.'],
        ['Retail and Commercial', 'Comfortable customer-facing glass with solar control for Walnut Street, Passyunk, and Old City storefronts and commercial corridors.'],
      ];

const faqItems = [
  {
    question: `What is Hanita Coatings ${p.name} and what is it used for in Philadelphia?`,
    answer: `${p.name} is used for ${p.categories.join(', ').toLowerCase()} applications across Philadelphia homes, offices, retail, schools, and commercial properties. It belongs to the ${p.series} and is selected based on glass type, orientation, and performance goals.`,
  },
  {
    question: `What specifications does Hanita ${p.name} offer?`,
    answer: `Key specifications include ${specRows.slice(0, 4).map(([label, value]) => `${label}: ${value}`).join('; ')}. Window Film Philadelphia confirms final compatibility during the site assessment.`,
  },
  {
    question: `Who installs Hanita Coatings ${p.name} in Philadelphia?`,
    answer: `Window Film Philadelphia is an authorized Hanita Coatings installer serving Philadelphia and the surrounding area. We evaluate the glass, document the product selection, and install Hanita films according to manufacturer guidance.`,
  },
  {
    question: `Is Hanita Coatings ${p.name} suitable for Philadelphia's four-season climate?`,
    answer: `Philadelphia sits in IECC Climate Zone 4A — hot humid summers and cold winters. ${p.series.includes('SafetyZone') ? 'SafetyZone provides year-round glass retention regardless of climate.' : 'Window Film Philadelphia selects the appropriate Hanita specification based on glass orientation, climate exposure, and year-round performance goals for each Philadelphia property.'}`,
  },
];

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://windowfilmphiladelphia.net/products/' },
      { '@type': 'ListItem', position: 3, name: 'Hanita Coatings', item: 'https://windowfilmphiladelphia.net/products/hanita-coatings-window-film/' },
      { '@type': 'ListItem', position: 4, name: `Hanita ${p.name}`, item: serviceUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `Hanita ${p.name}`,
    brand: { '@type': 'Brand', name: 'Hanita Coatings' },
    image: `https://windowfilmphiladelphia.net${p.image}`,
    description: p.shortDescription,
    category: p.series,
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      areaServed: 'Philadelphia, PA',
      url: serviceUrl,
    },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={p.image}
  serviceName={`Hanita ${p.name}`}
  serviceDesc={description}
  serviceUrl={serviceUrl}
  faqItems={faqItems}
  schemas={pageSchemas}
>
  <section class="hcsub-hero" style={`--hcsub-hero-image: url('${p.image}'); --hcsub-series: ${p.seriesColor};`}>
    <div class="hcsub-hero__overlay"></div>
    <div class="hcsub-hero__inner">
      <span class="hcsub-badge" style={`background:${p.seriesColor}`}>{p.series}</span>
      <h1 class="hcsub-hero__title">Hanita {p.name}</h1>
      <p class="hcsub-hero__sub">Philadelphia's authorized Hanita Coatings installer — site assessment, product selection, professional installation, manufacturer warranty.</p>
      {statChips.length > 0 && (
        <div class="hcsub-stat-row">
          {statChips.map(([label, value]) => (
            <span class="hcsub-stat"><strong>{value}</strong> {label}</span>
          ))}
        </div>
      )}
      <div class="hcsub-hero__btns">
        <a href="/contact/" class="hcsub-btn">Get a Quote</a>
        {p.pdfUrl && (
          <a href={p.pdfUrl} target="_blank" rel="noopener noreferrer" class="hcsub-btn hcsub-btn--outline">Spec Sheet PDF</a>
        )}
      </div>
    </div>
  </section>

  <section class="hcsub-overview fade-in">
    <div class="hcsub-overview__inner">
      <div class="hcsub-overview__image-wrap">
        <img src={p.image} alt={`Hanita ${p.name} window film Philadelphia`} title={`Hanita ${p.name} — Philadelphia`} width="640" height="480" loading="lazy" class="hcsub-overview__image" />
      </div>
      <div class="hcsub-overview__content">
        <span class="hcsub-eyebrow">{p.series}</span>
        <h2>About Hanita {p.name}</h2>
        {descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <div class="hcsub-tags">{p.categories.map((cat) => <span class="hcsub-tag">{cat}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="hcsub-benefits fade-in">
    <div class="hcsub-section-head">
      <span class="hcsub-eyebrow hcsub-eyebrow--light">Key Benefits</span>
      <h2>What Hanita {p.name} Delivers</h2>
    </div>
    <div class="hcsub-benefits__grid">
      {p.benefits.map((benefit) => (
        <article class="hcsub-benefit">
          <span class="hcsub-benefit__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="M12 3l7 3v5c0 4.4-2.8 8.4-7 10-4.2-1.6-7-5.6-7-10V6l7-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8.5 12l2.2 2.2 4.8-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <h3>{benefit.heading}</h3>
          <p>{benefit.body}</p>
        </article>
      ))}
    </div>
  </section>

  {specRows.length > 0 && (
    <section class="hcsub-specs fade-in">
      <div class="hcsub-specs__inner">
        <div class="hcsub-specs__left">
          <span class="hcsub-eyebrow">Technical Data</span>
          <h2>{p.name} Specifications</h2>
          <p>Specifications are for reference. Window Film Philadelphia confirms compatibility during your site assessment before recommending any Hanita product.</p>
          {p.pdfUrl && (
            <a href={p.pdfUrl} target="_blank" rel="noopener noreferrer" class="hcsub-pdf-link">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M14 3H6a2 2 0 00-2 2v14a2 2 0 002 2h12a2 2 0 002-2V9l-6-6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M14 3v6h6M12 18v-6M9 15h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              Download {p.name} Spec Sheet
            </a>
          )}
        </div>
        <table class="hcsub-specs__table">
          <tbody>
            {specRows.map(([label, value]) => (
              <tr><th>{label}</th><td>{value}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="hcsub-apps fade-in">
    <div class="hcsub-section-head">
      <span class="hcsub-eyebrow">Local Use Cases</span>
      <h2>Philadelphia Applications</h2>
    </div>
    <div class="hcsub-apps__grid">
      {applications.map(([heading, body]) => (
        <article class="hcsub-app">
          <span class="hcsub-app__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="M4 21V5l8-3 8 3v16" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 21v-6h6v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
          <h3>{heading}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  {relatedProducts.length > 0 && (
    <section class="hcsub-related fade-in">
      <div class="hcsub-section-head">
        <span class="hcsub-eyebrow">Related Products</span>
        <h2>Other Hanita Coatings Options</h2>
      </div>
      <div class="hcsub-related__grid">
        {relatedProducts.map((item) => (
          <a href={`/products/hanita/${item.slug}/`} class="hcsub-related__card">
            <img src={item.image} alt={`Hanita ${item.name} window film Philadelphia`} title={`Hanita ${item.name} Philadelphia`} width="280" height="180" loading="lazy" />
            <div class="hcsub-related__card-body">
              <span style={`color:${item.seriesColor}; font-size:.72rem; font-weight:800; text-transform:uppercase; letter-spacing:.1em;`}>{item.series}</span>
              <h3>{item.name}</h3>
              <p>{item.shortDescription.slice(0, 100)}…</p>
            </div>
          </a>
        ))}
      </div>
      <a href="/products/hanita-coatings-window-film/" class="hcsub-related__all">View all Hanita Coatings products →</a>
    </section>
  )}

  <section class="hcsub-cta fade-in">
    <div class="hcsub-cta__inner">
      <h2>Install Hanita {p.name} in Philadelphia</h2>
      <p>Window Film Philadelphia is an authorized Hanita Coatings installer. Contact us for a free site assessment and product recommendation.</p>
      <a href="/contact/" class="hcsub-cta__btn">Get a Free Quote</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hcsub-hero { min-height: 560px; position: relative; display: grid; place-items: center; padding: 140px 24px 100px; background-image: var(--hcsub-hero-image); background-size: cover; background-position: center; color: #fff; overflow: hidden; }
  .hcsub-hero__overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,0.84), rgba(0,0,0,0.52)); }
  .hcsub-hero__inner { position: relative; width: min(1120px,100%); z-index: 1; }
  .hcsub-badge { display: inline-flex; align-items: center; min-height: 28px; border-radius: 999px; padding: 5px 14px; color: #fff; font: 700 0.74rem/1 var(--font-body,'DM Sans',sans-serif); letter-spacing: .09em; text-transform: uppercase; }
  .hcsub-hero__title { max-width: 880px; margin: 18px 0 12px; color: #fff; font-family: var(--font-serif,'Playfair Display',serif); font-size: clamp(2.6rem,6vw,5.4rem); line-height: .95; }
  .hcsub-hero__sub { max-width: 560px; margin: 0 0 22px; color: rgba(255,255,255,.72); font-size: 1rem; line-height: 1.6; }
  .hcsub-stat-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
  .hcsub-stat { display: inline-flex; align-items: baseline; gap: 7px; min-height: 42px; border: 1px solid rgba(255,255,255,.22); border-radius: 8px; padding: 8px 14px; background: rgba(0,0,0,.34); color: rgba(255,255,255,.72); font-size: .82rem; }
  .hcsub-stat strong { color: #fff; font-size: 1rem; }
  .hcsub-hero__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .hcsub-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; border-radius: 6px; padding: 0 26px; background: #81AB4C; color: #fff; text-decoration: none; font: 800 .92rem/1 var(--font-body,'DM Sans',sans-serif); transition: background .18s; }
  .hcsub-btn:hover { background: #6b9340; }
  .hcsub-btn--outline { background: transparent; border: 1.5px solid rgba(255,255,255,.5); color: rgba(255,255,255,.9); }
  .hcsub-btn--outline:hover { background: rgba(255,255,255,.08); }
  .hcsub-eyebrow { display: inline-block; color: #81AB4C; font-size: .76rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; margin-bottom: 10px; }
  .hcsub-eyebrow--light { color: rgba(255,255,255,.55); }
  .hcsub-section-head { width: min(960px,100%); margin: 0 auto 36px; text-align: center; }
  .hcsub-section-head h2 { margin: 0; color: #151515; font-family: var(--font-serif,'Playfair Display',serif); font-size: clamp(1.9rem,3vw,2.9rem); line-height: 1.07; }
  .hcsub-overview { padding: 86px 24px; background: #fff; }
  .hcsub-overview__inner { width: min(1180px,100%); margin: 0 auto; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 60px; align-items: center; }
  .hcsub-overview__image-wrap { border-radius: 10px; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,.16); background: #111; aspect-ratio: 4/3; }
  .hcsub-overview__image { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hcsub-overview__content h2 { margin: 0 0 18px; color: #151515; font-family: var(--font-serif,'Playfair Display',serif); font-size: clamp(1.8rem,3vw,2.8rem); line-height: 1.08; }
  .hcsub-overview__content p { color: #444; line-height: 1.75; margin: 0 0 14px; }
  .hcsub-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .hcsub-tag { border: 1px solid #dce5d3; border-radius: 999px; padding: 6px 13px; color: #2f431d; background: #f6faf1; font-size: .8rem; font-weight: 700; }
  .hcsub-benefits { padding: 86px 24px; background: #161616; }
  .hcsub-benefits .hcsub-section-head h2 { color: #fff; }
  .hcsub-benefits__grid { width: min(1180px,100%); margin: 0 auto; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; }
  .hcsub-benefit { border: 1px solid rgba(255,255,255,.08); border-radius: 10px; padding: 28px; background: rgba(255,255,255,.05); color: rgba(255,255,255,.72); }
  .hcsub-benefit__icon { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 8px; margin-bottom: 16px; background: rgba(129,171,76,.14); color: #81AB4C; }
  .hcsub-benefit h3 { margin: 0 0 10px; color: #fff; font-family: var(--font-body,'DM Sans',sans-serif); font-size: 1.04rem; line-height: 1.3; }
  .hcsub-benefit p { margin: 0; line-height: 1.64; }
  .hcsub-specs { padding: 86px 24px; background: #fff; }
  .hcsub-specs__inner { width: min(1180px,100%); margin: 0 auto; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 60px; align-items: start; }
  .hcsub-specs__left h2 { margin: 0 0 14px; color: #151515; font-family: var(--font-serif,'Playfair Display',serif); font-size: clamp(1.8rem,3vw,2.6rem); line-height: 1.08; }
  .hcsub-specs__left p { color: #555; line-height: 1.68; margin: 0 0 20px; }
  .hcsub-pdf-link { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border: 1.5px solid #81AB4C; border-radius: 6px; color: #2f431d; text-decoration: none; font: 700 .88rem/1 var(--font-body,'DM Sans',sans-serif); transition: background .18s; }
  .hcsub-pdf-link:hover { background: #f6faf1; }
  .hcsub-specs__table { width: 100%; border-collapse: collapse; border: 1px solid #e6e6e6; border-radius: 8px; overflow: hidden; }
  .hcsub-specs__table th, .hcsub-specs__table td { padding: 15px 18px; border-bottom: 1px solid #e6e6e6; text-align: left; vertical-align: top; }
  .hcsub-specs__table tr:last-child th, .hcsub-specs__table tr:last-child td { border-bottom: 0; }
  .hcsub-specs__table th { width: 40%; color: #222; background: #f5f7f2; font-weight: 800; font-size: .88rem; }
  .hcsub-specs__table td { color: #444; font-size: .92rem; }
  .hcsub-apps { padding: 86px 24px; background: #f4f7f0; }
  .hcsub-apps__grid { width: min(1180px,100%); margin: 0 auto; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; }
  .hcsub-app { background: #fff; border: 1px solid #dde5d5; border-radius: 10px; padding: 28px; color: #4a4a4a; }
  .hcsub-app__icon { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 8px; margin-bottom: 16px; background: rgba(129,171,76,.1); color: #81AB4C; }
  .hcsub-app h3 { margin: 0 0 10px; color: #171717; font-family: var(--font-body,'DM Sans',sans-serif); font-size: 1.04rem; font-weight: 700; }
  .hcsub-app p { margin: 0; line-height: 1.62; }
  .hcsub-related { padding: 86px 24px; background: #fff; }
  .hcsub-related__grid { width: min(1180px,100%); margin: 0 auto; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; }
  .hcsub-related__card { display: flex; flex-direction: column; overflow: hidden; border: 1px solid #e8e8e8; border-radius: 10px; text-decoration: none; background: #fff; transition: transform .2s, border-color .2s; }
  .hcsub-related__card:hover { transform: translateY(-3px); border-color: #81AB4C; }
  .hcsub-related__card img { width: 100%; height: 180px; object-fit: cover; }
  .hcsub-related__card-body { padding: 16px 18px 20px; flex: 1; }
  .hcsub-related__card h3 { margin: 6px 0 6px; color: #151515; font-family: var(--font-body,'DM Sans',sans-serif); font-size: 1.02rem; line-height: 1.3; }
  .hcsub-related__card p { margin: 0; color: #666; font-size: .84rem; line-height: 1.5; }
  .hcsub-related__all { display: table; margin: 30px auto 0; color: #2f431d; font-weight: 800; text-decoration: none; font-size: .94rem; }
  .hcsub-related__all:hover { color: #81AB4C; }
  .hcsub-cta { padding: 80px 24px; background: #81AB4C; }
  .hcsub-cta__inner { width: min(900px,100%); margin: 0 auto; text-align: center; }
  .hcsub-cta h2 { margin: 0 0 14px; color: #fff; font-family: var(--font-serif,'Playfair Display',serif); font-size: clamp(1.9rem,3vw,2.8rem); line-height: 1.08; }
  .hcsub-cta p { max-width: 620px; margin: 0 auto 28px; color: rgba(255,255,255,.88); font-size: .97rem; line-height: 1.6; }
  .hcsub-cta__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; border-radius: 6px; padding: 0 30px; background: #111; color: #fff; text-decoration: none; font: 800 .95rem/1 var(--font-body,'DM Sans',sans-serif); transition: background .18s; }
  .hcsub-cta__btn:hover { background: #2f431d; }
  .fade-in { opacity: 0; transform: translateY(28px); transition: opacity .65s ease, transform .65s ease; }
  .fade-in.visible { opacity: 1; transform: translateY(0); }
  @media (max-width: 900px) {
    .hcsub-overview__inner, .hcsub-specs__inner { grid-template-columns: 1fr; }
    .hcsub-benefits__grid, .hcsub-apps__grid, .hcsub-related__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .hcsub-hero { padding: 110px 18px 72px; }
    .hcsub-benefits__grid, .hcsub-apps__grid, .hcsub-related__grid { grid-template-columns: 1fr; }
    .hcsub-hero__btns { flex-direction: column; }
    .hcsub-btn { width: 100%; }
  }
</style>

<script>
  const obs = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.08 }
  );
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>
