  <script>
    const vtTrack = document.getElementById('vtTrack');
    const vtProgressBar = document.getElementById('vtProgressBar');
    const vtPrev = document.querySelector('[data-vtnav="prev"]');
    const vtNext = document.querySelector('[data-vtnav="next"]');
    let vtIndex = 0;

    function vtUpdateSlider() {
      if (!vtTrack || !vtProgressBar) return;
      vtTrack.style.transform = `translateX(-${vtIndex * 100}%)`;
      vtProgressBar.style.width = vtIndex === 0 ? '50%' : '100%';
    }

    vtPrev?.addEventListener('click', () => {
      vtIndex = vtIndex === 0 ? 1 : 0;
      vtUpdateSlider();
    });

    vtNext?.addEventListener('click', () => {
      vtIndex = vtIndex === 1 ? 0 : 1;
      vtUpdateSlider();
    });

    vtUpdateSlider();

    const vtTintRange = document.getElementById('vtTintRange');
    const vtTintOverlay = document.getElementById('vtTintOverlay');
    const vtTintVlt = document.getElementById('vtTintVlt');
    const vtTintFilm = document.getElementById('vtTintFilm');
    const vtFilms = [
      { max: 20, label: 'Clear glass', vlt: 'Approx. 90% VLT' },
      { max: 40, label: 'Vista light film', vlt: 'Approx. 72% VLT' },
      { max: 60, label: 'Vista mid film', vlt: 'Approx. 52% VLT' },
      { max: 80, label: 'Vista dark film', vlt: 'Approx. 28% VLT' },
      { max: 101, label: 'Vista darkest film', vlt: 'Approx. 5% VLT' },
    ];

    function vtUpdateTint() {
      if (!vtTintRange || !vtTintOverlay || !vtTintVlt || !vtTintFilm) return;
      const value = Number(vtTintRange.value);
      vtTintOverlay.style.opacity = String((value / 100) * 0.78);
      const film = vtFilms.find((item) => value < item.max) || vtFilms[vtFilms.length - 1];
      vtTintFilm.textContent = film.label;
      vtTintVlt.textContent = film.vlt;
    }

    vtTintRange?.addEventListener('input', vtUpdateTint);
    vtUpdateTint();
  </script>
