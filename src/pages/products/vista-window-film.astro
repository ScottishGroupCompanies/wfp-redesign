  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 100px;
}

/* Content side */
.vt-pl-row__content {
  padding: 52px 52px 52px 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}
