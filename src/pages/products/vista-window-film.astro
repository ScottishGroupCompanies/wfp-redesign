---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlipWords from '../../components/FlipWords.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import CountUp from '../../components/animations/CountUp.astro';
import TestimonialMarquee from '../../components/TestimonialMarquee.astro';
import { Icon } from 'astro-icon/components';

const title = 'Vista Window Film Philadelphia | Premium Installer';
const description = 'Vista window film Philadelphia — SpectraSelect solar control, low-e, dual-reflective privacy. Authorized Vista dealer, manufacturer warranty.';
const canonical = 'https://www.windowfilmphiladelphia.net/products/vista-window-film/';

const productLines = [
  {
    pill: 'SpectraSelect',
    eyebrow: 'Vista SpectraSelect Solar Control Window Film',
    heading: 'SpectraSelect — Non-Metallic Solar Control, Near-Neutral Appearance',
    image: '/images/vista-spectraselect-solar-control-window-film-philadelphia.jpg',
    alt: 'Vista SpectraSelect solar control window film installed on Philadelphia commercial glass',
    title: 'Vista SpectraSelect solar control window film Philadelphia',
    body: [
      'Vista SpectraSelect is the flagship architectural solar control series — a non-metallized spectrally selective film that rejects up to 71% of solar energy and 99% of UV radiation while maintaining VLT options from 40% to 72%. Because SpectraSelect contains no metal, it does not interfere with Wi-Fi, cellular, or building access signals — a critical advantage in Philadelphia\'s dense commercial core and historic institutional buildings where signal infrastructure is complex.',
      'The near-neutral exterior appearance of SpectraSelect — typically 5–9% exterior reflectance — reads as clear glass from the street. This is a core requirement in Philadelphia\'s Society Hill, Old City, and Rittenhouse Square historic districts where high-reflectance coatings are restricted. SpectraSelect is available in multiple VLT levels to scale from nearly invisible to moderate tint.',
    ],
    specs: [
      ['71%', 'Max Heat Rejection'],
      ['99%', 'UV Block'],
      ['40–72%', 'VLT Range'],
      ['15yr', 'Commercial Warranty'],
    ],
    pdfs: [
      ['vista-window-film-solar-control-performance-specs-philadelphia.pdf', 'SpectraSelect Performance Data'],
      ['vista-window-film-spectraselect-solar-safety-spec-philadelphia.pdf', 'SpectraSelect Spec Sheet'],
    ],
    warranty: 'Residential: lifetime limited. Commercial: 15 years. Source: Vista by Eastman.',
  },
  {
    pill: 'Low-E Series',
    eyebrow: 'Vista Low-E Climate Control Window Film',
    heading: 'Low-E Series — Four-Season Insulation for Philadelphia Glass',
    image: '/images/vista-low-e-insulating-window-film-philadelphia.jpg',
    alt: 'Vista Low-E insulating window film on Philadelphia rowhome glass',
    title: 'Vista Low-E insulating window film Philadelphia',
    reverse: true,
    body: [
      'Vista Low-E is a dual-season low-emissivity film engineered for year-round performance. In summer, it rejects solar heat gain. In winter, it reflects interior heat back into the room instead of allowing it to escape through the glass. For Philadelphia\'s aging single-pane rowhome stock — where single-pane windows are common in pre-1950s construction — Low-E delivers a meaningful improvement in winter comfort and energy performance without requiring window replacement or historic preservation approval.',
      'Vista Low-E maintains approximately 74% visible light transmission and 15% exterior reflectance — well within the requirements of Philadelphia\'s historic neighborhood guidelines. Unlike metallized films, Low-E does not create a mirror effect that would be inconsistent with the architectural character of Germantown, Chestnut Hill, or West Philadelphia\'s Victorian rowhome streetscapes.',
    ],
    specs: [
      ['74%', 'VLT (near-clear)'],
      ['~35%', 'U-value Improvement'],
      ['~30%', 'SHGC Reduction'],
      ['Lifetime', 'Res. Warranty'],
    ],
    pdfs: [
      ['vista-window-film-low-e-energy-saving-residential-philadelphia.pdf', 'Low-E Energy Saving Spec'],
    ],
    warranty: 'Residential limited lifetime. Commercial: 15 years. Improvement on single-pane clear glass (1/4"). Source: Vista by Eastman.',
  },
  {
    pill: 'Dual Reflective',
    eyebrow: 'Vista Dual Reflective Privacy Window Film',
    heading: 'Dual Reflective Series — Daytime Privacy Without the Nighttime Fishbowl',
    image: '/images/vista-dual-reflective-privacy-window-film-philadelphia.jpg',
    alt: 'Vista Dual Reflective privacy film on Philadelphia street-facing restaurant windows',
    title: 'Vista Dual Reflective privacy window film Philadelphia',
    body: [
      'Most reflective privacy films work against you at night — the same coating that keeps people from seeing in during the day turns into a mirror from the inside after dark. Vista Dual Reflective Series solves this with asymmetric reflectance: high exterior reflectance during daylight creates a mirror effect that blocks inward views, while low interior reflectance preserves clear outward views after dark when interior lighting reverses the visual dynamic.',
      'Philadelphia applications include restaurant dining rooms and bars on Passyunk and Rittenhouse Square, west-facing conference rooms in Center City towers, and ground-floor residential windows on busy commercial streets. Available in multiple VLT levels from DR15 (15% VLT, maximum privacy) to DR35 (36% VLT, moderate tint). Note: uses a metallized coating — may attenuate Wi-Fi signals on glass-heavy facades.',
    ],
    specs: [
      ['15–36%', 'VLT Range'],
      ['Up to 71%', 'Heat Rejection'],
      ['99%', 'UV Block'],
      ['12yr', 'Commercial Warranty'],
    ],
    pdfs: [
      ['vista-window-film-dual-reflective-privacy-spec-philadelphia.pdf', 'Dual Reflective Spec'],
    ],
    warranty: 'Residential: lifetime. Commercial: 12 years. Metallized — may attenuate Wi-Fi on dense glass facades. Source: Vista by Eastman.',
  },
  {
    pill: 'Safety Series',
    eyebrow: 'Vista SpectraSelect Safety Window Film',
    heading: 'SpectraSelect Safety — Solar Control and Fragment Retention in One Film',
    image: '/images/vista-spectraselect-safety-security-window-film-philadelphia.jpg',
    alt: 'Vista SpectraSelect Safety security window film on Philadelphia healthcare glass',
    title: 'Vista SpectraSelect Safety security window film Philadelphia',
    reverse: true,
    body: [
      'Vista SpectraSelect Safety combines the solar control performance of the SpectraSelect Series with fragment retention properties — addressing two concerns with a single installation. The film rejects solar heat and UV radiation while holding glass together on impact, preventing dangerous flying fragments during break-ins, accidents, and severe weather events. This dual-purpose performance makes it the specification of choice for Philadelphia schools, healthcare facilities, and at-risk commercial glazing where both energy and security matter.',
      'For facilities directors who need to document both solar performance and safety compliance, SpectraSelect Safety provides NFRC ratings for energy performance alongside safety glazing documentation. Important: the film holds glass together — it does not prevent glass from breaking or guarantee protection from all injury.',
    ],
    specs: [
      ['~60%', 'VLT'],
      ['Up to 65%', 'Heat Rejection'],
      ['99%', 'UV Block'],
      ['12yr', 'Commercial Warranty'],
    ],
    pdfs: [
      ['vista-window-film-spectraselect-solar-safety-spec-philadelphia.pdf', 'SpectraSelect Safety Spec'],
      ['vista-window-film-spectraselect-healthcare-case-study-philadelphia.pdf', 'Healthcare Case Study'],
    ],
    warranty: 'Commercial: 12 years. Film holds glass on impact — does not prevent breakage. Source: Vista by Eastman.',
  },
];

const comparisonRows = [
  ['SpectraSelect 70', 'Vista', '72%', 'Up to 71%', '99%', 'Lifetime / 15yr'],
  ['Low-E', 'Vista', '74%', '~35% SHGC', '99%', 'Lifetime / 15yr'],
  ['Dual Reflective DR25', 'Vista', '24%', 'Up to 71%', '99%', 'Lifetime / 12yr'],
  ['SpectraSelect Safety', 'Vista', '~60%', 'Up to 65%', '99%', 'Lifetime / 12yr'],
  ['ATC 70', 'LLumar', '70%', 'Up to 74%', '99%', 'Lifetime / 15yr'],
  ['Prestige PR70', '3M', '69%', '~66% TSER', '99.9%', 'Lifetime / 15yr'],
];

const testimonialReviews = [
  {
    quote: 'Vista SpectraSelect was the only film that met our design review requirements in the Society Hill historic district. Near-neutral appearance, documented performance, and the NFRC data was thorough enough for our preservation commission submission.',
    name: 'Emily R.',
    role: 'Architect · Rittenhouse Square Project',
    img: '/images/vista-testimonial-emily-r.jpg',
  },
  {
    quote: 'We specified Vista across three Class A buildings. The SpectraSelect performance data held up exactly as documented — energy savings were measurable in the first full year. Professional installation on all three properties.',
    name: 'James B.',
    role: 'Commercial Real Estate Manager · Center City',
    img: '/images/vista-testimonial-james-b.jpg',
  },
  {
    quote: 'I was worried about altering the look of our 1910 rowhome windows. The Vista Low-E film is genuinely invisible from outside and the winter drafty feeling near the glass has improved noticeably.',
    name: 'Patricia G.',
    role: 'Homeowner · Chestnut Hill',
    img: '/images/vista-testimonial-patricia-g.jpg',
  },
  {
    quote: 'Vista SpectraSelect Safety gave us the combination of solar control and safety documentation we needed for our procurement process. One product, two performance records — that simplified approvals considerably.',
    name: 'Michael O.',
    role: 'Hospital Facilities Manager · University City',
    img: '/images/vista-testimonial-michael-o.jpg',
  },
  {
    quote: 'The glare in our south-facing conference room was making afternoon meetings difficult. Vista SpectraSelect fixed it completely without making the room feel dim. The views of Old City are still beautiful.',
    name: 'Lisa C.',
    role: 'Office Manager · Old City',
    img: '/images/vista-testimonial-lisa-c.jpg',
  },
  {
    quote: 'We used Vista Dual Reflective on our restaurant\'s street-facing windows. Daytime privacy for diners is excellent and the street view from inside at night is still clear. Exactly what we needed.',
    name: 'Andrew F.',
    role: 'Boutique Hotel Owner · Center City',
    img: '/images/vista-testimonial-andrew-f.jpg',
  },
];

const faqItems = [
  {
    question: 'What Vista window film products does Window Film Philadelphia install?',
    answer: 'Window Film Philadelphia installs the full Vista architectural lineup including SpectraSelect solar control, Low-E climate control, Dual Reflective privacy film, and SpectraSelect Safety (solar + fragment retention). Both residential and commercial specifications are available.',
  },
  {
    question: 'How long does Vista window film last?',
    answer: 'Vista films carry a residential limited lifetime warranty and a 15-year commercial warranty on solar control products. Safety and reflective products carry a 12-year commercial warranty covering film performance, adhesion, and color stability.',
  },
  {
    question: 'What is the difference between Vista SpectraSelect and Vista Low-E?',
    answer: 'Vista SpectraSelect is primarily a solar control film optimized for summer heat and glare reduction. Vista Low-E is a year-round film that also retains interior heat in winter — the better specification for Philadelphia\'s four-season climate and older single-pane glass.',
  },
  {
    question: 'Can Vista film meet Philadelphia historic district requirements?',
    answer: 'Yes. Vista SpectraSelect and Low-E films are near-neutral in exterior appearance with low reflectance — they typically meet the aesthetic requirements of Philadelphia historic commissions in Society Hill, Chestnut Hill, and Fairmount. We provide product samples and NFRC data sheets for review submissions.',
  },
  {
    question: 'Is Vista the same as LLumar?',
    answer: 'Both Vista and LLumar are Eastman Performance Films brands manufactured on the same platform. Vista is positioned as the premium design-forward line; LLumar is the established commercial workhorse. Product specifications differ by series. Window Film Philadelphia carries both.',
  },
  {
    question: 'Does Vista SpectraSelect film interfere with Wi-Fi or cellular signals?',
    answer: 'No. SpectraSelect is non-metallized and does not attenuate Wi-Fi or cellular signals. The Dual Reflective Series uses a metallized coating and may affect signal on glass-heavy facades — worth considering for signal-sensitive installations.',
  },
  {
    question: 'Can Vista film qualify for LEED credits?',
    answer: 'Several Vista products are NFRC-certified and can support LEED Energy and Atmosphere documentation. Window Film Philadelphia provides complete product data sheets and installation records for credit submissions.',
  },
  {
    question: 'Can Vista film be applied to double-pane insulated glass?',
    answer: 'Yes. Vista makes specific series rated for insulated glass units (IGUs). Selecting the wrong film for double-pane glass can cause thermal stress. We always evaluate glass type and orientation before recommending a film.',
  },
  {
    question: 'Does Vista SpectraSelect Safety prevent glass from breaking?',
    answer: 'No. SpectraSelect Safety holds glass fragments together after impact — it does not prevent glass from breaking. It significantly slows forced entry and contains the fragment hazard that causes most injuries in glass-failure events.',
  },
  {
    question: 'How do I get Vista window film installed in Philadelphia?',
    answer: 'Contact us for a free site assessment. We evaluate your glass, orientation, goals, and any documentation requirements, then recommend the appropriate Vista series and provide a written proposal before work begins.',
  },
];

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.windowfilmphiladelphia.net/products/' },
      { '@type': 'ListItem', position: 3, name: 'Vista Window Film', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonical,
    url: canonical,
    name: title,
    description,
    dateModified: new Date().toISOString().slice(0,10),
    isPartOf: { '@type': 'WebSite', '@id': 'https://www.windowfilmphiladelphia.net/#website', name: 'Window Film Philadelphia' },
    breadcrumb: { '@id': `${canonical}#breadcrumb` },
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.vt-hero__title', '.vt-why__intro'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Vista Window Film Products — Philadelphia',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'SpectraSelect', description: 'Non-metallic solar control film with 40–72% VLT, up to 71% heat rejection, and 99% UV block.' },
      { '@type': 'ListItem', position: 2, name: 'Low-E', description: 'Four-season insulating film with 74% VLT, improved U-value, and residential limited lifetime warranty.' },
      { '@type': 'ListItem', position: 3, name: 'Dual Reflective', description: 'Daytime privacy film with DR15–DR35 VLT choices, up to 71% heat rejection, and 12-year commercial warranty.' },
      { '@type': 'ListItem', position: 4, name: 'SpectraSelect Safety', description: 'Solar control and fragment retention film with about 60% VLT, up to 65% heat rejection, and 99% UV block.' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Vista Window Film Philadelphia',
    brand: { '@type': 'Brand', name: 'Vista' },
    offers: { '@type': 'Offer', availability: 'https://schema.org/InStock', areaServed: 'Philadelphia, PA', url: canonical },
    aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '54', bestRating: '5' },
    review: testimonialReviews.slice(0, 3).map((r) => ({
      '@type': 'Review',
      author: { '@type': 'Person', name: r.name },
      reviewBody: r.quote,
      reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} schemas={pageSchemas} faqItems={faqItems}>
  <div class="vt-geo" aria-hidden="true" style="display:none;">
    <p>Vista window film Philadelphia is an Eastman Performance Films brand installed across Center City, Rittenhouse Square, Old City, University City, Chestnut Hill, and Society Hill commercial and residential properties — including Class A office towers on Market Street and Broad Street, University City healthcare and academic buildings, Society Hill historic district rowhomes, Old City boutique hotels, and West Philadelphia residential properties — using the SpectraSelect spectrally selective solar control series, Low-E climate control film, Dual Reflective privacy series, and SpectraSelect Safety dual-purpose film, all NFRC-certified for VLT, SHGC, and U-value.</p>
    <dl>
      <dt>What is Vista window film in Philadelphia?</dt>
      <dd>An Eastman Performance Films premium architectural product available in spectrally selective solar control, low-e insulating, dual-reflective privacy, and combination solar-safety series — installed on Philadelphia commercial and residential glass by authorized dealers.</dd>
      <dt>How does Vista SpectraSelect work?</dt>
      <dd>Uses a non-metallic spectrally selective coating that transmits visible light while rejecting near-infrared solar heat — up to 71% solar energy rejection without a heavily tinted or reflective appearance.</dd>
      <dt>What Vista products are available in Philadelphia?</dt>
      <dd>SpectraSelect solar control (VLT 40–72%), Low-E (year-round, near-clear), Dual Reflective privacy (DR15–DR35), SpectraSelect Safety (solar + fragment retention).</dd>
      <dt>Which Philadelphia buildings use Vista window film?</dt>
      <dd>Center City Class A offices, University City healthcare campuses, Society Hill and Chestnut Hill historic rowhomes, Old City boutique hotels, and West Philadelphia residential buildings.</dd>
      <dt>Is Vista worth it for Philadelphia winters?</dt>
      <dd>Yes — Vista Low-E reduces winter heat loss through single-pane glass and improves U-value without window replacement, particularly valuable for pre-1950 Philadelphia rowhome glass.</dd>
      <dt>How much does Vista window film cost in Philadelphia?</dt>
      <dd>Cost depends on film series, glass area, building access, documentation requirements, and installation complexity. Contact us for a free assessment and written proposal.</dd>
    </dl>
    <ul>
      <li>Vista window film Philadelphia</li>
      <li>Vista window tint in Philadelphia</li>
      <li>Vista film installer for Philadelphia</li>
      <li>Vista SpectraSelect Philadelphia</li>
      <li>Vista Low-E film Philadelphia</li>
      <li>Vista Dual Reflective privacy film Philadelphia</li>
      <li>Vista SpectraSelect Safety Philadelphia</li>
      <li>Vista authorized dealer Philadelphia</li>
      <li>Vista commercial window film Center City</li>
      <li>Vista residential window film Philadelphia</li>
      <li>Vista NFRC certified film Philadelphia</li>
      <li>Vista Eastman architectural film Philadelphia</li>
      <li>Vista window film Society Hill historic district</li>
      <li>Vista solar control University City</li>
    </ul>
  </div>

  <section class="vt-hero">
    <div
      class="vt-hero__bg"
      style="background-image: url('/images/vista-window-film-philadelphia-hero.jpg')"
      role="img"
      aria-label="Vista architectural window film on a Philadelphia commercial glass facade"
      title="Vista window film Philadelphia commercial building hero"
    ></div>
    <div class="vt-hero__overlay"></div>
    <div class="vt-hero__content">
      <div class="vt-hero__eyebrow">
        <span>Vista Window Film</span>
        <span class="vt-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Philadelphia, PA</span>
        <span class="vt-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Authorized Installer</span>
      </div>
      <h1 class="vt-hero__title">Vista Window Film for Philadelphia</h1>
      <p class="vt-hero__animated-line">
        <FlipWords
          words={['for offices and commercial buildings', 'for rowhomes and residences', 'for healthcare facilities', 'for hotels and hospitality']}
          staticText=""
          class="vt-hero__flip"
        />
      </p>
      <p class="vt-hero__subtitle">
        Vista is Eastman's premium architectural window film brand — favored by architects, designers, and facilities directors who need verified solar performance without altering the look of their glass. Sun control, insulation, privacy, and safety film installed professionally in Philadelphia with a manufacturer-backed warranty.
      </p>
      <div class="vt-hero__cta">
        <a href="/contact/" class="vt-hero__btn-primary">Get Your Free Estimate</a>
        <a href="tel:2673947980" class="vt-hero__btn-secondary">
          <Icon name="lucide:phone" aria-hidden="true" />
          Call (267) 394-7980
        </a>
      </div>
      <div class="vt-hero__stats-panel" aria-label="Key Vista window film statistics">
        <div class="vt-hero__stats-inner">
          <CountUp end={71} suffix="%" label="Max Heat Rejection" />
          <div class="vt-hero__stat-divider" aria-hidden="true"></div>
          <CountUp end={99} suffix="%" label="UV Blocked" />
          <div class="vt-hero__stat-divider" aria-hidden="true"></div>
          <div class="vt-hero__stat">
            <strong>Lifetime</strong>
            <span>Residential Warranty</span>
          </div>
          <div class="vt-hero__stat-divider" aria-hidden="true"></div>
