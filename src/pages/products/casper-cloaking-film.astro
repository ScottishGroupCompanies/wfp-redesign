        <div class="cc-pl-row__spec"><span class="cc-pl-row__spec-val">Combined</span><span class="cc-pl-row__spec-label">Privacy</span></div>
      </div>
      <div class="cc-pl-row__pdfs">
        <span class="cc-pl-row__pdfs-label">Casper Technical Documents</span>
