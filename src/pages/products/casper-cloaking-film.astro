</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));

  // ── Slider ──
  (function initCCSlider() {
    const track = document.getElementById('ccTrack');
    const slides = document.querySelectorAll('.cc-slider__slide');
    const navItems = document.querySelectorAll('[data-ccnav]');
    const prevBtn = document.getElementById('ccPrev');
    const nextBtn = document.getElementById('ccNext');
    const progressBar = document.getElementById('ccProgressBar');
    if (!track || !slides.length) return;
    let current = 0;
    const total = slides.length;

    function goTo(i) {
      if (i < 0) i = total - 1;
      if (i >= total) i = 0;
      current = i;
      track.style.transform = `translateX(-${current * 100}%)`;
      navItems.forEach((n, idx) => n.classList.toggle('cc-slider__nav-item--active', idx === current));
      slides.forEach((s, idx) => s.classList.toggle('cc-active', idx === current));
      if (progressBar) {
        progressBar.style.transition = 'none';
        progressBar.style.width = '0';
        setTimeout(() => { progressBar.style.transition = 'width 6s linear'; progressBar.style.width = '100%'; }, 50);
      }
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    navItems.forEach((n, i) => n.addEventListener('click', () => goTo(i)));

    document.querySelectorAll('.cc-slider__faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const slide = btn.closest('.cc-slider__slide');
        slide.querySelectorAll('.cc-slider__faq-q').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          const a = b.nextElementSibling; if (a) a.hidden = true;
        });
        if (!expanded) {
          btn.setAttribute('aria-expanded', 'true');
          const a = btn.nextElementSibling; if (a) a.hidden = false;
        }
      });
    });

    let timer = setInterval(() => goTo(current + 1), 6000);
    document.getElementById('ccSlider')?.addEventListener('mouseenter', () => clearInterval(timer));
    document.getElementById('ccSlider')?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 6000); });
    goTo(0);
  })();

  document.querySelectorAll('.cc-faq__item').forEach(item => {
    item.querySelector('.cc-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('cc-faq__item--open');
      document.querySelectorAll('.cc-faq__item').forEach(i => i.classList.remove('cc-faq__item--open'));
      if (!isOpen) item.classList.add('cc-faq__item--open');
    });
  });

  // ══ TINT SLIDER ══
  (() => {
    const range = document.getElementById('tintRange');
    const overlay = document.getElementById('tintOverlay');
    const vltEl = document.getElementById('tintVlt');
    const filmEl = document.getElementById('tintFilm');
    if (!range) return;
    // v=0 (left) = clearest, v=100 (right) = darkest (limo)
    // VLT: clear ~90% down to limo ~5%
    // v=0 (left, CLEAR) = no tint; v=100 (right, LIMO) = darkest
    const films = [
      { minV: 0,  maxV: 40,  name: 'Casper Clear', vlt: 80 },
      { minV: 40, maxV: 70,  name: 'Casper Patterned', vlt: 60 },
      { minV: 70, maxV: 100, name: 'Custom Casper Print', vlt: 45 },
    ];
    const update = () => {
      const v = parseInt(range.value); // 0=CLEAR (light), 100=LIMO (dark)
      const vlt = Math.round(82 - (v / 100) * 38); // Clear Casper is high-VLT; patterned/custom options vary
      const opacity = (v / 100) * 0.42;
      overlay.style.background = `rgba(10,20,5,${opacity.toFixed(3)})`;
      vltEl.textContent = vlt + '%';
      const film = films.find(f => v >= f.minV && v <= f.maxV) || films[films.length - 1];
      filmEl.textContent = film.name;
    };
    range.addEventListener('input', update);
    update();
  })();
</script>

