---
/* Hallmark · redesign · macrostructure: numbered-alternating-rows · tone: professional-editorial
 * template: benefits.astro · anchor hue: green (#81AB4C) */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlipWords from '../../components/FlipWords.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import CountUp from '../../components/animations/CountUp.astro';
import TestimonialMarquee from '../../components/TestimonialMarquee.astro';
import { Icon } from 'astro-icon/components';
import hanitaProducts from '../../data/hanita-products.json';

const title = 'Hanita Coatings Window Film Philadelphia | SolarZone';
const description = 'Hanita Coatings window film in Philadelphia for SolarZone solar control, SafetyZone security, and e-Lite Low-E upgrades.';
const canonicalUrl = 'https://windowfilmphiladelphia.net/products/hanita-coatings-window-film/';

const hanitaCatalogSeries = Object.values(
  hanitaProducts.reduce((groups, product) => {
    if (!groups[product.series]) {
      groups[product.series] = {
        name: product.series,
        color: product.seriesColor,
        products: [],
      };
    }
    groups[product.series].products.push(product);
    return groups;
  }, {})
);

const truncateCatalogDescription = (text) => text.length > 80 ? `${text.slice(0, 77)}...` : text;

const hanitaReviews = [
  {
    quote: "We've installed SolarZone XTRM on two of our Philadelphia buildings now. The heat rejection is real — you feel it on the west-facing floors in July. The neutral appearance was critical for our building standards.",
    name: 'Michael T.',
    role: 'Facilities Manager, Center City Office',
    img: '/images/hanita-coatings-testimonial-michael.jpg',
  },
  {
    quote: "We needed something compatible with older single-pane glass in a historic building. Hanita's e-Lite gave us year-round performance without altering the window appearance or triggering preservation review.",
    name: 'Jennifer K.',
    role: 'Property Manager, Philadelphia',
    img: '/images/hanita-coatings-testimonial-jennifer.jpg',
  },
  {
    quote: "SafetyZone on all our entry doors and ground-floor glass. HVAC upgrade was too expensive — this was the right answer for our glass safety upgrade within budget.",
    name: 'Robert L.',
    role: 'Principal, Philadelphia K-12 School',
    img: '/images/hanita-coatings-testimonial-robert.jpg',
  },
];

const faqItems = [
  {
    question: 'What is Hanita Coatings window film and where is it made?',
    answer: 'Hanita Coatings is an Israeli manufacturer founded in 1967 at Kibbutz Hanita. Its architectural film lineup includes SolarZone solar control, SafetyZone safety and security, SkyLite Xtra high-clarity solar film, and e-Lite Low-E insulating film for residential and commercial glass.',
  },
  {
    question: 'What is SolarZone spectrally selective technology?',
    answer: 'SolarZone spectrally selective technology targets infrared heat and UV wavelengths while allowing visible light to pass through. The result is high heat rejection with a neutral, clear-looking glass appearance for offices, schools, healthcare buildings, and rowhomes.',
  },
  {
    question: 'What is the difference between SolarZone HP and SolarZone XTRM?',
    answer: 'SolarZone HP is Hanita Coatings core high-performance solar control line, with sputtered metallic construction and multiple visible light transmission options. SolarZone XTRM is the extreme-performance spectrally selective option, selected when a commercial facade needs the highest TSER and a near-neutral appearance.',
  },
  {
    question: "Is Hanita Coatings film suitable for Philadelphia's older single-pane rowhome glass?",
    answer: 'Yes. Window Film Philadelphia evaluates glass condition, orientation, and performance goals before specification. For older single-pane glass, e-Lite Low-E and high-clarity SolarZone options are often considered because they improve comfort without changing the original window appearance.',
  },
  {
    question: 'What is the e-Lite Low-E film and how does it work in Philadelphia winters?',
    answer: "e-Lite Low-E is a low-emissivity insulating film that helps retain interior heat in winter while still reducing solar gain in summer. That two-way thermal behavior is useful in Philadelphia's Zone 4A climate, where buildings face both cooling and heating seasons.",
  },
  {
    question: 'Does Hanita SolarZone work on double-pane glass?',
    answer: 'Many Hanita SolarZone films can be specified for insulated glass when the product, glass type, and exposure are compatible. Our team checks the glass construction before recommending a film so the selected product stays within approved application guidelines.',
  },
  {
    question: 'What Hanita Coatings product is right for Philadelphia schools and government buildings?',
    answer: 'SafetyZone is the primary Hanita Coatings product for schools, government buildings, retail entries, and other safety-sensitive glass. It is designed for glass retention and forced-entry delay, with thickness options from lighter safety films to heavier security specifications.',
  },
  {
    question: 'How long does Hanita Coatings window film last and what warranty does it carry?',
    answer: 'Warranty terms vary by product and installation type. SolarZone HP and e-Lite are available with residential lifetime warranty coverage, while many commercial SolarZone and SafetyZone specifications carry 10-year commercial warranty terms.',
  },
  {
    question: 'Can Hanita Coatings film be combined with safety film on the same glass?',
    answer: 'Yes, solar control and safety goals can often be addressed together through product selection or layered specifications. Window Film Philadelphia reviews the glass, threat profile, and energy goals before recommending a SolarZone, SafetyZone, or combined approach.',
  },
  {
    question: 'Who installs Hanita Coatings window film in Philadelphia?',
    answer: 'Window Film Philadelphia installs Hanita Coatings products across Philadelphia homes, offices, schools, healthcare facilities, universities, and retail properties. We handle product selection, technical documentation, installation, and warranty support.',
  },
];

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://windowfilmphiladelphia.net/products/' },
      { '@type': 'ListItem', position: 3, name: 'Hanita Coatings', item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: title,
    description,
    dateModified: new Date().toISOString().slice(0, 10),
    isPartOf: { '@type': 'WebSite', '@id': 'https://windowfilmphiladelphia.net/#website', url: 'https://windowfilmphiladelphia.net/', name: 'Window Film Philadelphia' },
    breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.hc-hero__subtitle', '.hc-why__intro', '.hc-faq__a'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Hanita Coatings Products Available in Philadelphia',
    itemListElement: hanitaProducts.map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: product.name,
      url: `https://windowfilmphiladelphia.net/products/hanita/${product.slug}/`,
      description: product.shortDescription,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Hanita Coatings Window Film Installation in Philadelphia',
    brand: { '@type': 'Brand', name: 'Hanita Coatings' },
    description: 'SolarZone, SafetyZone, SkyLite Xtra, and e-Lite Low-E architectural window films installed by Window Film Philadelphia.',
  },
];
---

<BaseLayout title={title} description={description} canonical={canonicalUrl} faqItems={faqItems} schemas={pageSchemas}>

<!-- ══ HERO ══ -->
<section class="hc-hero">
  <div
    class="hc-hero__bg"
    style="background-image: url('/images/hanita-coatings-window-film-philadelphia-hero.jpg')"
    role="img"
    aria-label="Hanita Coatings window film installed on a Philadelphia commercial building facade"
  ></div>
  <div class="hc-hero__overlay"></div>

  <div class="hc-hero__content">
    <div class="hc-hero__eyebrow">
      <span>Hanita Coatings</span>
      <span class="hc-hero__eyebrow-dot" aria-hidden="true"></span>
      <span>Philadelphia, PA</span>
      <span class="hc-hero__eyebrow-dot" aria-hidden="true"></span>
      <span>Authorized Installer</span>
    </div>

    <h1 class="hc-hero__title">Hanita Coatings Window Film<br class="hc-hero__br"/> in Philadelphia</h1>

    <p class="hc-hero__animated-line">
      Advanced film solutions for
      <FlipWords
        words={["offices", "Philadelphia rowhomes", "schools", "healthcare facilities", "commercial buildings"]}
        staticText=""
        class="hc-hero__flip"
      />.
    </p>

    <p class="hc-hero__subtitle">
      Window Film Philadelphia is an authorized Hanita Coatings installer — SolarZone, SafetyZone, and e-Lite films for Philadelphia commercial and residential properties.
    </p>

    <div class="hc-hero__cta">
      <a href="/contact/" class="hc-hero__btn-primary">Get Your Free Estimate</a>
      <a href="tel:2673947980" class="hc-hero__btn-secondary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z" fill="currentColor"/></svg>
        Call (267) 394-7980
      </a>
    </div>

    <div class="hc-hero__stats-panel" aria-label="Key Hanita Coatings window film statistics">
      <div class="hc-hero__stats-inner">
        <CountUp end={81} suffix="%" label="Max Heat Rejection" />
        <div class="hc-hero__stat-divider" aria-hidden="true"></div>
        <CountUp end={99} suffix="%+" label="UV Block" />
        <div class="hc-hero__stat-divider" aria-hidden="true"></div>
        <CountUp end={50} suffix="+" label="Years Manufacturing" />
        <div class="hc-hero__stat-divider" aria-hidden="true"></div>
        <CountUp end={14} suffix=" mil" label="SafetyZone Security" />
      </div>
    </div>
  </div>
</section>

<div class="ip-page-body">

<!-- ══════════════════════════════════════
     SECTION 2 - INTRO + TRUST BAR
     ══════════════════════════════════════ -->
<section class="hc-intro">
  <div class="hc-intro__inner">
    <div class="hc-intro__image-col">
      <div class="hc-intro__image-wrap">
        <img
          src="/images/hanita-coatings-window-film-philadelphia-intro.jpg"
          alt="Authorized installer applying Hanita Coatings window film to Philadelphia glass"
          title="Hanita Coatings window film installation Philadelphia"
          width="600"
          height="720"
          loading="lazy"
          class="hc-intro__img"
        />
        <div class="hc-intro__badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.27L12 14.54l-5.62 3.96 2.09-6.27L3 8.26h6.91L12 2z" fill="#81AB4C"/></svg>
          <span>Authorized Hanita Coatings Installer</span>
        </div>
      </div>
    </div>

    <div class="hc-intro__content">
      <span class="hc-intro__eyebrow">Authorized Hanita Coatings Installer</span>
      <h2 class="hc-intro__title">Why choose Hanita coatings for Philadelphia glass?</h2>
      <p class="hc-intro__lead">Hanita Coatings has manufactured high-performance architectural films since 1967 at Kibbutz Hanita in Israel, building SolarZone spectrally selective technology for hospitals, hotels, government buildings, universities, and commercial offices worldwide. Window Film Philadelphia brings Hanita SolarZone in Philadelphia to buildings that need high solar heat rejection without a heavy mirrored look.</p>
      <p class="hc-intro__body">For Philadelphia rowhomes, Center City offices, older historic glass, and mixed-humid IECC Zone 4A weather, the Hanita lineup gives specifiers real choices: SolarZone for solar control, SkyLite Xtra for clarity, e-Lite Low-E for single-pane insulation, and SafetyZone for glass retention.</p>
      <div class="hc-intro__creds">
        <div class="hc-intro__cred"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#81AB4C" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#81AB4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Authorized Hanita Installer</div>
        <div class="hc-intro__cred"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#81AB4C" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#81AB4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Licensed &amp; Insured</div>
        <div class="hc-intro__cred"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#81AB4C" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#81AB4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Serving Philadelphia Since 2008</div>
      </div>
      <div class="hc-intro__ctas">
        <a href="/contact/" class="pp-btn pp-btn--primary">Get a Free Quote</a>
        <a href="tel:2673947980" class="pp-btn pp-btn--ghost">Call (267) 394-7980</a>
      </div>
    </div>
  </div>
</section>

<!-- ══ TRUST BAR ══ -->
<section class="hc-trust">
  <div class="hc-trust__inner">
    <p class="hc-trust__label">Philadelphia's authorized Hanita Coatings installer</p>
    <div class="hc-trust__badges">
      {['Authorized Hanita Installer', 'Licensed & Insured', 'SolarZone Certified', 'Serving Philadelphia Since 2008'].map((badge) => (
        <>
          <div class="hc-trust__badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.27L12 14.54l-5.62 3.96 2.09-6.27L3 8.26h6.91L12 2z" fill="#81AB4C"/></svg>
            {badge}
          </div>
          <div class="hc-trust__sep" aria-hidden="true"></div>
        </>
      ))}
    </div>
  </div>
</section>
<BrandLogos />

<!-- ══════════════════════════════════════
     SECTION 3 - WHY HANITA FOR PHILADELPHIA
     ══════════════════════════════════════ -->
<section class="hc-why">
  <div class="hc-why__container">
    <div class="hc-why__image-wrap">
      <img
        src="/images/hanita-coatings-window-film-philadelphia-why.jpg"
        alt="Comfortable Philadelphia office interior after Hanita Coatings SolarZone window film installation"
        title="Hanita Coatings SolarZone for Philadelphia summer heat and winter comfort"
        width="768"
        height="960"
        loading="lazy"
        class="hc-why__image"
      />
      <div class="hc-why__stat-card">
        <div class="hc-why__stat-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>Hanita Coatings SolarZone</span></div>
        <div class="hc-why__stat-divider"></div>
        <div class="hc-why__stat-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>Up to 81% heat rejection</span></div>
      </div>
    </div>

    <div class="hc-why__content">
      <span class="hc-why__eyebrow">Why Hanita Coatings for Philadelphia</span>
      <h2 class="hc-why__headline">Hanita SolarZone Handles Philadelphia's Summer Heat — And Its Winters, Too.</h2>
      <p class="hc-why__intro">Philadelphia sits in IECC Zone 4A, where hot summers, cold winters, aging rowhome glass stock, and Center City high-rise solar load all matter. As a Hanita Coatings film installer Philadelphia property owners can call for technical specification support, Window Film Philadelphia helps match SolarZone, e-Lite, and SafetyZone products to the exposure, glass type, and building use. "Window film may be used to reduce solar heat gain through windows," according to <a href="https://www.nfrc.org/" target="_blank" rel="noopener noreferrer" class="hc-body-link">NFRC window film energy ratings</a>.</p>
      <ul class="hc-why__bullets">
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Spectrally selective SolarZone technology targets infrared heat while keeping a neutral glass appearance.</li>
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>SolarZone XTRM reaches up to 81% maximum heat rejection for high-demand <a href="/applications/office/" class="hc-body-link">Philadelphia office</a> facades.</span></li>
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>e-Lite Low-E supports <a href="/benefits/energy-savings/" class="hc-body-link">year-round energy savings</a> in Philadelphia's mixed-humid Zone 4A climate.</span></li>
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>SafetyZone adds <a href="/benefits/safety-and-security/" class="hc-body-link">safety and security</a> performance for schools, government buildings, and retail storefronts.</span></li>
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Hanita's worldwide institutional track record includes hospitals, hotels, banks, government buildings, and commercial offices.</li>
      </ul>
      <div class="hc-why__climate-facts">
        <div class="hc-why__climate-item"><span class="hc-why__climate-num">81%</span><span class="hc-why__climate-label">Max TSER</span></div>
        <div class="hc-why__climate-item"><span class="hc-why__climate-num">Zone 4A</span><span class="hc-why__climate-label">Four-Season</span></div>
        <div class="hc-why__climate-item"><span class="hc-why__climate-num">50+</span><span class="hc-why__climate-label">Years Manufacturing</span></div>
      </div>
      <a href="/contact/" class="hc-why__cta">Get a free film assessment &rarr;<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg></a>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════
     SECTION 4 - RESIDENTIAL / COMMERCIAL SLIDER
     ══════════════════════════════════════ -->
<section class="hc-slider" id="hcSlider">
  <div class="hc-slider__track" id="hcTrack">
    <div class="hc-slider__slide" data-slide="0">
      <img src="/images/hanita-coatings-window-film-philadelphia-residential.jpg" alt="Philadelphia rowhome living room with Hanita Coatings window film" title="Hanita Coatings residential window film for Philadelphia rowhomes" class="hc-slider__bg" loading="lazy" />
      <div class="hc-slider__overlay"></div>
      <div class="hc-slider__content">
        <div class="hc-slider__step">01</div>
        <h2 class="hc-slider__title">Philadelphia homes deserve Hanita</h2>
        <p class="hc-slider__desc">Older rowhome glass needs a quiet upgrade that improves comfort without changing the character of the window. Hanita e-Lite Low-E and high-clarity SolarZone options help balance summer heat, winter heat loss, and street-facing appearance.</p>
        <div class="hc-slider__faq">
          <div class="hc-slider__faq-item"><button class="hc-slider__faq-q" aria-expanded="false">Can Hanita help single-pane rowhome windows?<span class="hc-slider__faq-icon" aria-hidden="true">+</span></button><div class="hc-slider__faq-a" hidden>Yes. e-Lite Low-E is designed for year-round thermal improvement on older glass, while SolarZone options can reduce summer heat and glare.</div></div>
          <div class="hc-slider__faq-item"><button class="hc-slider__faq-q" aria-expanded="false">Is it useful beyond summer?<span class="hc-slider__faq-icon" aria-hidden="true">+</span></button><div class="hc-slider__faq-a" hidden>Yes. e-Lite Low-E helps retain interior heat in winter and reduce solar gain in summer, which fits Philadelphia's four-season climate.</div></div>
          <div class="hc-slider__faq-item"><button class="hc-slider__faq-q" aria-expanded="false">Will it work with HOA or historic guidelines?<span class="hc-slider__faq-icon" aria-hidden="true">+</span></button><div class="hc-slider__faq-a" hidden>SkyLite Xtra and e-Lite Low-E are selected when a near-clear appearance is important for historic districts, HOAs, or preservation-sensitive glass.</div></div>
        </div>
        <a href="/contact/" class="hc-slider__cta">Get a residential estimate &rarr;</a>
      </div>
    </div>

    <div class="hc-slider__slide" data-slide="1">
      <img src="/images/hanita-coatings-window-film-philadelphia-commercial.jpg" alt="Philadelphia office with Hanita SolarZone window film on large commercial glass" title="Hanita SolarZone commercial window film for Philadelphia offices" class="hc-slider__bg" loading="lazy" />
      <div class="hc-slider__overlay"></div>
      <div class="hc-slider__content">
        <div class="hc-slider__step">02</div>
        <h2 class="hc-slider__title">Philadelphia offices trust SolarZone</h2>
        <p class="hc-slider__desc">Class A offices, university buildings, healthcare spaces, and institutional glass need technical submittals as much as comfort. Hanita SolarZone and SafetyZone products support performance documentation for solar control, UV block, glass retention, and security planning.</p>
        <div class="hc-slider__faq">
          <div class="hc-slider__faq-item"><button class="hc-slider__faq-q" aria-expanded="false">Which Hanita film fits Class A offices?<span class="hc-slider__faq-icon" aria-hidden="true">+</span></button><div class="hc-slider__faq-a" hidden>SolarZone XTRM is the maximum-demand option when high TSER and a neutral exterior appearance are both required.</div></div>
          <div class="hc-slider__faq-item"><button class="hc-slider__faq-q" aria-expanded="false">Can Hanita support institutional submittals?<span class="hc-slider__faq-icon" aria-hidden="true">+</span></button><div class="hc-slider__faq-a" hidden>Yes. SolarZone and SafetyZone technical data sheets support specification review for offices, universities, hospitals, and government facilities.</div></div>
          <div class="hc-slider__faq-item"><button class="hc-slider__faq-q" aria-expanded="false">What about schools and entries?<span class="hc-slider__faq-icon" aria-hidden="true">+</span></button><div class="hc-slider__faq-a" hidden>SafetyZone is the Hanita product line for glass retention and forced-entry delay on doors, sidelites, classrooms, and ground-floor glazing.</div></div>
        </div>
        <a href="/contact/" class="hc-slider__cta">Get a commercial estimate &rarr;</a>
      </div>
    </div>
  </div>

  <nav class="hc-slider__nav" aria-label="Slide navigation">
    <button class="hc-slider__nav-item hc-slider__nav-item--active" data-hcnav="0"><span class="hc-slider__nav-line"></span><span class="hc-slider__nav-label">Residential</span></button>
    <button class="hc-slider__nav-item" data-hcnav="1"><span class="hc-slider__nav-line"></span><span class="hc-slider__nav-label">Commercial</span></button>
  </nav>
  <button class="hc-slider__arrow hc-slider__arrow--prev" id="hcPrev" aria-label="Previous slide"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
  <button class="hc-slider__arrow hc-slider__arrow--next" id="hcNext" aria-label="Next slide"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
  <div class="hc-slider__progress"><div class="hc-slider__progress-bar" id="hcProgressBar"></div></div>
</section>

<!-- ══════════════════════════════════════
     PRODUCT LINES - alternating rows
     ══════════════════════════════════════ -->
<section class="hc-products">
  <div class="hc-products__hd">
    <span class="pp-eyebrow">Product Lines</span>
    <h2 class="hc-products__title">The Hanita Coatings lineup for Philadelphia glass</h2>
    <p class="hc-products__sub">Hanita Coatings window film in Philadelphia is available through Window Film Philadelphia across SolarZone HP, SolarZone XTRM, SkyLite Xtra, e-Lite Low-E, and SafetyZone. Each product line addresses a different performance problem in Philadelphia residential, commercial, healthcare, education, and government buildings.</p>
  </div>

  <div class="hc-pl-row fade-in">
    <div class="hc-pl-row__img-wrap">
      <img src="/images/hanita-coatings-solarzone-window-film-philadelphia.jpg" alt="SolarZone HP solar control film installed on Philadelphia commercial glass" title="SolarZone HP Hanita Coatings window film Philadelphia" width="768" height="960" loading="lazy" class="hc-pl-row__img" />
      <span class="hc-pl-row__pill">SolarZone HP</span>
    </div>
    <div class="hc-pl-row__content">
      <span class="hc-pl-row__num">01</span>
      <span class="hc-pl-row__eyebrow">High-Performance Solar Control · Commercial &amp; Residential</span>
      <h3 class="hc-pl-row__heading">SolarZone HP — Hanita's Core Solar Control Film for Philadelphia Properties</h3>
      <p class="hc-pl-row__body">SolarZone HP is Hanita's standard high-performance solar control line, built with sputtered metallic construction for durable solar rejection, glare reduction, and UV protection. The series includes multiple visible light transmission options, allowing Philadelphia property owners to choose a lighter, clearer look or a stronger glare-control specification.</p>
      <p class="hc-pl-row__body">For Center City offices, retail storefronts, rowhomes, and residential glass with south or west exposure, SolarZone HP reduces peak summer heat without replacing windows. It is the practical first specification when a property needs reliable solar control and a documented product family from an established manufacturer.</p>
      <div class="hc-pl-row__specs"><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">73%</span><span class="hc-pl-row__spec-label">Heat Rejection</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">99%+</span><span class="hc-pl-row__spec-label">UV</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">Multiple</span><span class="hc-pl-row__spec-label">VLT</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">Lifetime</span><span class="hc-pl-row__spec-label">Res Warranty</span></div></div>
      <div class="hc-pl-row__pdfs"><span class="hc-pl-row__pdfs-label">Hanita Technical Documents</span><ul class="hc-pl-row__pdf-list"><li><a href="/resources/hanita-coatings-window-film-solarzone-datasheet-philadelphia.pdf" target="_blank" rel="noopener" class="hc-pl-row__pdf-link"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>SolarZone Data Sheet</a></li><li><a href="/resources/hanita-coatings-window-film-comparative-data-philadelphia.pdf" target="_blank" rel="noopener" class="hc-pl-row__pdf-link"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Comparative Data</a></li></ul></div>
    </div>
  </div>

  <div class="hc-pl-row hc-pl-row--rev fade-in">
    <div class="hc-pl-row__img-wrap"><img src="/images/hanita-coatings-solarzone-window-film-philadelphia.jpg" alt="SolarZone XTRM spectrally selective film on Philadelphia Class A office glass" title="SolarZone XTRM Hanita Coatings window film Philadelphia" width="768" height="960" loading="lazy" class="hc-pl-row__img" /><span class="hc-pl-row__pill">SolarZone XTRM</span></div>
    <div class="hc-pl-row__content"><span class="hc-pl-row__num">02</span><span class="hc-pl-row__eyebrow">Extreme Spectrally Selective · Class A Commercial</span><h3 class="hc-pl-row__heading">SolarZone XTRM — Maximum Heat Rejection for Philadelphia's Highest-Demand Facades</h3><p class="hc-pl-row__body">SolarZone XTRM is Hanita's extreme-performance spectrally selective solar control film, engineered to reject infrared heat while preserving visible light and a near-neutral glass appearance. It is the top SolarZone option when TSER matters most.</p><p class="hc-pl-row__body">For west-facing curtain walls, Class A office towers, healthcare campuses, and university buildings, SolarZone XTRM delivers up to 81% heat rejection while maintaining the architectural appearance property managers require. It is built for maximum-demand commercial specifications in Philadelphia.</p><div class="hc-pl-row__specs"><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">81%</span><span class="hc-pl-row__spec-label">Heat Rejection</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">Selective</span><span class="hc-pl-row__spec-label">Spectrum</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">99%+</span><span class="hc-pl-row__spec-label">UV</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">10 yr</span><span class="hc-pl-row__spec-label">Commercial</span></div></div><div class="hc-pl-row__pdfs"><span class="hc-pl-row__pdfs-label">Hanita Technical Documents</span><ul class="hc-pl-row__pdf-list"><li><a href="/resources/hanita-coatings-window-film-product-index-philadelphia.pdf" target="_blank" rel="noopener" class="hc-pl-row__pdf-link"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Product Index</a></li></ul></div></div>
  </div>

  <div class="hc-pl-row fade-in">
    <div class="hc-pl-row__img-wrap"><img src="/images/hanita-coatings-skylite-window-film-philadelphia.jpg" alt="SkyLite Xtra near-clear solar control film on Philadelphia historic glass" title="SkyLite Xtra Hanita Coatings window film Philadelphia" width="768" height="960" loading="lazy" class="hc-pl-row__img" /><span class="hc-pl-row__pill">SkyLite Xtra</span></div>
    <div class="hc-pl-row__content"><span class="hc-pl-row__num">03</span><span class="hc-pl-row__eyebrow">High Clarity · Near-Clear · Preservation Compatible</span><h3 class="hc-pl-row__heading">SkyLite Xtra — Near-Clear Solar Control for Philadelphia Historic and Institutional Glass</h3><p class="hc-pl-row__body">SkyLite Xtra is Hanita's high-clarity spectrally selective option, chosen when visible glass character must stay close to clear. It provides meaningful solar control while avoiding the dark or reflective appearance that can conflict with design standards.</p><p class="hc-pl-row__body">For historic districts, HOA-sensitive residential glass, hospitals, universities, and institutional buildings, SkyLite Xtra protects interiors from heat and UV while preserving daylight and facade appearance. It is a strong fit when clarity is a requirement, not a preference.</p><div class="hc-pl-row__specs"><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">High VLT</span><span class="hc-pl-row__spec-label">Near-Clear</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">65%</span><span class="hc-pl-row__spec-label">Heat Rejection</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">99%+</span><span class="hc-pl-row__spec-label">UV</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">10 yr</span><span class="hc-pl-row__spec-label">Commercial</span></div></div><div class="hc-pl-row__pdfs"><span class="hc-pl-row__pdfs-label">Hanita Technical Documents</span><ul class="hc-pl-row__pdf-list"><li><a href="/resources/hanita-coatings-window-film-titan-xtra-casestudy-philadelphia.pdf" target="_blank" rel="noopener" class="hc-pl-row__pdf-link"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Titan Xtra Case Study</a></li><li><a href="/resources/hanita-coatings-window-film-glass-application-chart-philadelphia.pdf" target="_blank" rel="noopener" class="hc-pl-row__pdf-link"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Glass Application Chart</a></li></ul></div></div>
  </div>

  <div class="hc-pl-row hc-pl-row--rev fade-in">
    <div class="hc-pl-row__img-wrap"><img src="/images/hanita-coatings-elite-window-film-philadelphia.jpg" alt="e-Lite Low-E insulating film on older Philadelphia single-pane windows" title="e-Lite Low-E Hanita Coatings window film Philadelphia" width="768" height="960" loading="lazy" class="hc-pl-row__img" /><span class="hc-pl-row__pill">e-Lite Low-E</span></div>
    <div class="hc-pl-row__content"><span class="hc-pl-row__num">04</span><span class="hc-pl-row__eyebrow">Low-Emissivity · Year-Round · Single-Pane Upgrade</span><h3 class="hc-pl-row__heading">e-Lite Low-E — Year-Round Thermal Film for Philadelphia's Older Single-Pane Glass</h3><p class="hc-pl-row__body">e-Lite Low-E is the Hanita low-emissivity insulating film for buildings that need more than summer solar control. Its low-E construction helps reflect interior heat back into the room during winter while still improving comfort during summer solar exposure.</p><p class="hc-pl-row__body">For Philadelphia rowhomes, older apartment buildings, and historic single-pane glass in Zone 4A, e-Lite offers a practical thermal upgrade without window replacement. The near-clear appearance helps preserve the look of the glass while improving seasonal comfort.</p><div class="hc-pl-row__specs"><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">Near-Clear</span><span class="hc-pl-row__spec-label">Appearance</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">Summer</span><span class="hc-pl-row__spec-label">+ Winter</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">Low-E</span><span class="hc-pl-row__spec-label">Insulating</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">Lifetime</span><span class="hc-pl-row__spec-label">Res Warranty</span></div></div><div class="hc-pl-row__pdfs"><span class="hc-pl-row__pdfs-label">Hanita Technical Documents</span><ul class="hc-pl-row__pdf-list"><li><a href="/resources/hanita-coatings-window-film-glass-application-chart-philadelphia.pdf" target="_blank" rel="noopener" class="hc-pl-row__pdf-link"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Glass Application Chart</a></li></ul></div></div>
  </div>

  <div class="hc-pl-row fade-in">
    <div class="hc-pl-row__img-wrap"><img src="/images/hanita-coatings-safetyzone-window-film-philadelphia.jpg" alt="SafetyZone safety and security film on Philadelphia school and retail glass" title="SafetyZone Hanita Coatings safety window film Philadelphia" width="768" height="960" loading="lazy" class="hc-pl-row__img" /><span class="hc-pl-row__pill">SafetyZone</span></div>
    <div class="hc-pl-row__content"><span class="hc-pl-row__num">05</span><span class="hc-pl-row__eyebrow">Safety &amp; Security · Glass Retention · Schools &amp; Retail</span><h3 class="hc-pl-row__heading">SafetyZone — Glass Retention and Forced-Entry Delay for Philadelphia Buildings</h3><p class="hc-pl-row__body">SafetyZone is Hanita Coatings' safety and security film family, available from 4 to 14 mil in clear to lightly tinted options. Applied to the interior glass surface, it helps hold broken glass together after impact and slows forced-entry attempts.</p><p class="hc-pl-row__body">For Philadelphia K-12 schools, government facilities, retail storefronts, and ground-floor commercial glass, SafetyZone adds passive protection without changing daily operations. It can support occupant safety, smash-and-grab deterrence, and specification-level security planning.</p><div class="hc-pl-row__specs"><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">4-14 mil</span><span class="hc-pl-row__spec-label">Thickness</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">Clear</span><span class="hc-pl-row__spec-label">to Tinted</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">Glass</span><span class="hc-pl-row__spec-label">Retention</span></div><div class="hc-pl-row__spec"><span class="hc-pl-row__spec-val">10 yr</span><span class="hc-pl-row__spec-label">Commercial</span></div></div><div class="hc-pl-row__pdfs"><span class="hc-pl-row__pdfs-label">Hanita Technical Documents</span><ul class="hc-pl-row__pdf-list"><li><a href="/resources/hanita-coatings-window-film-safetyzone-datasheet-philadelphia.pdf" target="_blank" rel="noopener" class="hc-pl-row__pdf-link"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2H12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>SafetyZone Data Sheet</a></li><li><a href="/resources/hanita-coatings-window-film-allegheny-county-casestudy-philadelphia.pdf" target="_blank" rel="noopener" class="hc-pl-row__pdf-link"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Allegheny County Case Study</a></li></ul></div></div>
  </div>
</section>

