.cb-pl-row__pdf-link svg { flex-shrink: 0; opacity: 0.7; }
.cb-pl-row__warranty-note {
  font-size: 11px;
  color: var(--text-mid, #999);
  margin: 10px 0 0;
  font-style: italic;
}

/* Responsive */
@media (max-width: 900px) {
  .cb-pl-row {
    grid-template-columns: 1fr;
  }
  .cb-pl-row--rev { direction: ltr; }
  .cb-pl-row__img-wrap { min-height: 280px; }
  .cb-pl-row__content { padding: 36px 28px; }
  .cb-pl-row--rev .cb-pl-row__content { padding: 36px 28px; }
  .cb-pl-row__specs { grid-template-columns: repeat(2, 1fr); }
}

