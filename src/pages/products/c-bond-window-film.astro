</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));

  // ── Slider ──
  (function initCbSlider() {
    const track = document.getElementById('cbTrack');
    const slides = document.querySelectorAll('.cb-slider__slide');
    const navItems = document.querySelectorAll('[data-cbnav]');
    const prevBtn = document.getElementById('cbPrev');
    const nextBtn = document.getElementById('cbNext');
    const progressBar = document.getElementById('cbProgressBar');
    if (!track || !slides.length) return;
    let current = 0;
    const total = slides.length;

    function goTo(i) {
      if (i < 0) i = total - 1;
      if (i >= total) i = 0;
      current = i;
      track.style.transform = `translateX(-${current * 100}%)`;
      navItems.forEach((n, idx) => n.classList.toggle('cb-slider__nav-item--active', idx === current));
      slides.forEach((s, idx) => s.classList.toggle('cb-active', idx === current));
      if (progressBar) {
        progressBar.style.transition = 'none';
        progressBar.style.width = '0';
        setTimeout(() => { progressBar.style.transition = 'width 6s linear'; progressBar.style.width = '100%'; }, 50);
      }
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    navItems.forEach((n, i) => n.addEventListener('click', () => goTo(i)));

    document.querySelectorAll('.cb-slider__faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const slide = btn.closest('.cb-slider__slide');
        slide.querySelectorAll('.cb-slider__faq-q').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          const a = b.nextElementSibling; if (a) a.hidden = true;
        });
        if (!expanded) {
          btn.setAttribute('aria-expanded', 'true');
          const a = btn.nextElementSibling; if (a) a.hidden = false;
        }
      });
    });

    let timer = setInterval(() => goTo(current + 1), 6000);
    document.getElementById('cbSlider')?.addEventListener('mouseenter', () => clearInterval(timer));
    document.getElementById('cbSlider')?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 6000); });
    goTo(0);
  })();

  document.querySelectorAll('.cb-faq__item').forEach(item => {
    item.querySelector('.cb-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('cb-faq__item--open');
      document.querySelectorAll('.cb-faq__item').forEach(i => i.classList.remove('cb-faq__item--open'));
      if (!isOpen) item.classList.add('cb-faq__item--open');
    });
  });

  // ══ TINT SLIDER ══
  (() => {
    const range = document.getElementById('cbTintRange');
    const overlay = document.getElementById('cbTintOverlay');
    const vltEl = document.getElementById('cbTintVlt');
    const filmEl = document.getElementById('cbTintFilm');
    if (!range) return;
    // v=0 (left) = clearest, v=100 (right) = darkest (limo)
    // VLT: clear ~90% down to limo ~5%
    // v=0 (left, CLEAR) = no tint; v=100 (right, LIMO) = darkest
    const films = [
      { minV: 0,  maxV: 15,  name: 'Clear — No Film',       vlt: 90 },
      { minV: 15, maxV: 35,  name: 'Light tint + C-Bond TINT', vlt: 70 },
      { minV: 35, maxV: 60,  name: 'Medium tint + C-Bond TINT', vlt: 45 },
      { minV: 60, maxV: 80,  name: 'Dark tint + C-Bond TINT', vlt: 25 },
      { minV: 80, maxV: 100, name: 'Privacy tint + C-Bond TINT', vlt: 10 },
    ];
    const update = () => {
      const v = parseInt(range.value); // 0=CLEAR (light), 100=LIMO (dark)
      const vlt = Math.round(90 - (v / 100) * 85); // 90% at CLEAR, 5% at LIMO
      const opacity = (v / 100) * 0.78;
      overlay.style.background = `rgba(10,20,5,${opacity.toFixed(3)})`;
      vltEl.textContent = vlt + '%';
      const film = films.find(f => v >= f.minV && v <= f.maxV) || films[films.length - 1];
      filmEl.textContent = film.name;
    };
    range.addEventListener('input', update);
    update();
  })();
</script>
