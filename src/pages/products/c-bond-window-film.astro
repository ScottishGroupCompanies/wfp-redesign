  line-height: 1;
}
.cb-pl-row__spec-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--text-mid, #666);
  text-align: center;
}

/* PDF links */
.cb-pl-row__pdfs {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.cb-pl-row__pdfs-label {
  font-size: 11px;
