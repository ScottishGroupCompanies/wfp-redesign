  margin-bottom: 48px;
  box-shadow: 0 2px 16px rgba(0,0,0,0.06);
}
.cb-pl-row:last-child { margin-bottom: 0; }
.cb-pl-row--rev { direction: rtl; }
.cb-pl-row--rev > * { direction: ltr; }

/* Image side */
.cb-pl-row__img-wrap {
  position: relative;
  height: 100%;
  min-height: 480px;
}
.cb-pl-row__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.cb-pl-row__pill {
  position: absolute;
  top: 20px;
  left: 20px;
  background: var(--green, #81AB4C);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 100px;
}

/* Content side */
.cb-pl-row__content {
  padding: 52px 52px 52px 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.cb-pl-row--rev .cb-pl-row__content {
  padding: 52px 0 52px 52px;
}
.cb-pl-row__num {
  font-size: 11px;
  font-weight: 700;
