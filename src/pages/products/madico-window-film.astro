---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlipWords from '../../components/FlipWords.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import CountUp from '../../components/animations/CountUp.astro';
import TestimonialMarquee from '../../components/TestimonialMarquee.astro';
import { Icon } from 'astro-icon/components';

const title = 'Madico Window Film in Philadelphia | 120 Years of Innovation';
const description = 'Madico window film in Philadelphia — solar control, SafetyShield security, and decorative film backed by 120 years of precision manufacturing.';
const heroImage = '/images/madico-window-film-philadelphia-hero.jpg';
const serviceUrl = 'https://www.windowfilmphiladelphia.net/products/madico-window-film/';

const faqItems = [
  { question: 'What is Madico window film in Philadelphia and how does it work?', answer: 'Madico architectural film uses precision-coated polyester, adhesives, and solar control layers to manage heat, glare, ultraviolet exposure, privacy, and glass fragment retention on Philadelphia residential and commercial glass.' },
  { question: 'Which Madico product is best for reducing heat in a Philadelphia rowhome?', answer: 'Madico Sunscape is the strongest fit for rowhome heat reduction because it pairs neutral gray appearance with 99% UV protection and heat rejection up to 86% while keeping rooms comfortable and naturally lit.' },
  { question: 'How does Madico SafetyShield security film protect Philadelphia businesses?', answer: 'SafetyShield helps hold broken glass together after impact, reducing flying shards and delaying forced entry for retail storefronts, offices, schools, and public-facing buildings.' },
  { question: 'Is Madico Sunscape film compatible with double-pane and Low-E windows?', answer: 'Yes. The right Madico specification can be selected for many insulated and Low-E glass systems after the glass type, orientation, and existing coating are reviewed for compatibility.' },
  { question: 'What does "99% UV block" mean for my Philadelphia furniture and flooring?', answer: 'It means Madico film blocks nearly all ultraviolet rays, one of the leading contributors to fading on hardwood floors, fabrics, artwork, merchandise, and interior finishes.' },
  { question: 'How does Madico solar control film compare to 3M Prestige or LLumar ATC?', answer: 'Madico Sunscape and Solar Control films compete closely with major architectural films by offering 99% UV block, heat rejection up to 86%, neutral finish options, and strong residential and commercial warranty coverage.' },
  { question: 'Can Madico decorative film replace frosted glass in a Philadelphia office?', answer: 'Yes. Madico Decorative Film can create frosted privacy, subtle patterns, and light diffusion on existing office glass without replacing panels or darkening the space.' },
  { question: 'What warranty does Madico offer for commercial window film in Philadelphia?', answer: 'Madico commercial solar control films commonly carry 10- to 15-year commercial warranty coverage depending on the series and glass conditions, while decorative and safety products have product-specific warranty terms.' },
  { question: 'Does Madico window film qualify for energy or tax incentives in Pennsylvania?', answer: 'Madico solar control films can support energy-efficiency documentation and LEED-oriented project goals when product data, glass details, and project requirements align with the applicable program.' },
  { question: 'What neighborhoods in Philadelphia see the most Madico window film installations?', answer: 'Madico projects are common in Center City offices, Fishtown rowhomes, Old City restaurants, Rittenhouse retail spaces, University City institutional buildings, and Navy Yard commercial facilities.' }
];

const madicoReviews = [
  { quote: 'Madico Sunscape film took care of the glare on our east-facing offices without making the space feel like a cave. The heat drop was noticeable the first week.', name: 'Marcus T.', role: 'Property Manager, Center City', img: '/images/madico-testimonial-marcus.jpg' },
  { quote: 'Our Fishtown rowhome used to be unbearable in July. The Madico Sunscape film changed that completely — we barely run the AC now.', name: 'Sarah W.', role: 'Homeowner, Fishtown', img: '/images/madico-testimonial-sarah.jpg' },
  { quote: 'We installed Madico SafetyShield in every classroom. Parents feel better knowing the glass is reinforced. I sleep better too.', name: 'Dr. James K.', role: 'Principal, Philadelphia School', img: '/images/madico-testimonial-james.jpg' },
  { quote: 'The Madico decorative film on our front windows gives us the privacy we needed without losing the natural light. Looks polished.', name: 'Elena V.', role: 'Restaurant Owner, Old City', img: '/images/madico-testimonial-elena.jpg' },
  { quote: "Madico's solar control film cut our building's cooling costs by a measurable amount. Facilities departments in Philadelphia should know about this.", name: 'Tom R.', role: 'Facilities Director, University City', img: '/images/madico-testimonial-tom.jpg' },
  { quote: "We put Madico safety film on our storefront glass after a break-in attempt on the block. It's peace of mind we didn't know we needed.", name: 'Lena B.', role: 'Retail Owner, Rittenhouse', img: '/images/madico-testimonial-lena.jpg' }
];

const productRows = [
  {
    eyebrow: 'Solar Control Flagship · Residential & Commercial',
    title: "Madico's Non-Metallic Sunscape Series Handles Philadelphia's Glare Problem",
    image: '/images/madico-sunscape-window-film-philadelphia.jpg',
    alt: 'Madico Sunscape window film on Philadelphia rowhome glass',
    flip: false,
    body: [
      "Sunscape is Madico's flagship solar control series for owners who want calmer light without a mirrored or industrial look. Its neutral gray tones work especially well on Philadelphia rowhomes, condo glass, office suites, and retail storefronts where curb appeal matters as much as comfort.",
      'The non-metallic construction helps avoid interference with Wi-Fi, cellular service, card readers, and smart home devices. It blocks 99% of UV rays, rejects heat up to 86%, and carries lifetime residential warranty coverage with 15-year commercial terms for qualifying glass.'
    ],
    specs: ['VLT: Light-Medium', 'UV Block: 99%', 'Heat Rejection: Up to 86%', 'Warranty: Lifetime res / 15yr com'],
    pdfs: [
      ['/resources/madico-sunscape-solar-control-window-film-iwfa-rating-guide-philadelphia.pdf', 'IWFA Window Film Rating Guide'],
      ['/resources/madico-solar-control-window-film-insulating-glass-compatibility-guide-philadelphia.pdf', 'IWFA Insulating Glass Compatibility Guide'],
      ['/resources/madico-iso-9001-2015-certification-manufacturing-quality-philadelphia.pdf', 'ISO 9001:2015 Quality Certification']
    ]
  },
  {
    eyebrow: 'Commercial Energy Efficiency · LEED Credit Eligible',
    title: "Philadelphia Buildings Save on HVAC with Madico's Commercial Solar Control Film",
    image: '/images/madico-solar-control-window-film-philadelphia.jpg',
    alt: 'Madico solar control window film on Philadelphia commercial building',
    flip: true,
    body: [
      'Madico Solar Control films help commercial buildings lower cooling demand by reducing solar heat gain before it enters the glass. For Center City offices, University City campuses, and Navy Yard facilities with long sun exposure, that means less glare at workstations and a more stable interior load on HVAC systems.',
      'The line includes reflective and neutral finish options for different design goals, plus product data that can support LEED credit documentation where the project requirements fit. Commercial warranty coverage commonly runs 10 to 15 years by product and application.'
    ],
    specs: ['VLT: Medium', 'UV Block: 99%', 'Heat Rejection: Up to 86%', 'Warranty: 10-15 yr commercial'],
    pdfs: [
      ['/resources/madico-solar-control-window-film-insulating-glass-compatibility-guide-philadelphia.pdf', 'IWFA Insulating Glass Guide'],
      ['/resources/madico-iso-14001-environmental-management-certification-philadelphia.pdf', 'ISO 14001 Environmental Certification'],
      ['/resources/madico-sunscape-solar-control-window-film-iwfa-rating-guide-philadelphia.pdf', 'IWFA Film Rating Standards']
    ]
  },
  {
    eyebrow: 'Safety & Security · Glazing Protection',
    title: 'SafetyShield Keeps Philadelphia Schools, Offices, and Retailers Protected 24/7',
    image: '/images/madico-safetyfirst-security-window-film-philadelphia.jpg',
    alt: 'Madico SafetyShield security film protecting Philadelphia storefront glass',
    flip: false,
    body: [
      'SafetyShield is Madico security film engineered for glass fragment retention in public-facing spaces. Available in 4- to 14-mil configurations, it helps hold glass together after impact and supports CPSC safety glazing criteria on appropriate assemblies.',
      'Philadelphia schools, offices, retailers, and civic spaces use SafetyShield to delay forced entry, reduce flying glass hazards, and add passive protection against certain impact and blast-mitigation scenarios. The film stays visually discreet while strengthening the weakest part of many buildings.'
    ],
    specs: ['Thickness: 4-14 mil', 'CPSC Compliant', 'UV Block: 99%', 'Warranty: 10 yr commercial'],
    pdfs: [
      ['/resources/madico-safety-security-window-film-iwfa-industry-guide-philadelphia.pdf', 'IWFA Safety Film Industry Guide'],
      ['/resources/madico-safety-security-window-film-bullet-resistance-statement-philadelphia.pdf', 'IWFA Bullet Resistance Statement'],
      ['/resources/madico-iso-9001-2015-certification-manufacturing-quality-philadelphia.pdf', 'ISO 9001:2015 Manufacturing Certification']
    ]
  },
  {
    eyebrow: 'Heavy-Duty Clear Protection · 14 Mil Safety Film',
    title: 'Madico Clear 14 Mil — The Invisible Shield for Philadelphia Government Buildings',
    image: '/images/madico-clear-safety-film-philadelphia.jpg',
    alt: 'Madico Clear 14 Mil safety film on Philadelphia government building glass',
    flip: true,
    body: [
      'Madico Clear 14 Mil is built for projects where security matters but appearance cannot change. The crystal-clear film adds heavy-duty thickness to glass while preserving the look of government buildings, schools, museums, transit hubs, and landmark-facing properties.',
      'For Old City institutions and Center City government buildings, Clear 14 Mil can be paired with anchored glazing systems and DOWSIL 995 Silicone Structural Sealant compatibility for stronger edge retention. It works quietly around the clock as a passive protection layer.'
    ],
    specs: ['Thickness: 14 mil', 'Clarity: Crystal clear', 'Sealant: DOWSIL 995 compatible', 'Passive Protection: 24/7'],
    pdfs: [
      ['/resources/school-window-film-madico-clear-14mil-texas-school-district-case-study-philadelphia.pdf', 'Clear 14 Mil School District Case Study'],
      ['/resources/madico-safety-security-window-film-iwfa-industry-guide-philadelphia.pdf', 'IWFA Safety Film Industry Guide'],
      ['/resources/madico-safety-security-window-film-bullet-resistance-statement-philadelphia.pdf', 'IWFA Bullet Resistance Statement']
    ]
  },
  {
    eyebrow: 'Decorative & Privacy Film · 7-Year Warranty',
    title: 'Madico Decorative Film Upgrades Philadelphia Office Interiors Without the Renovation Cost',
    image: '/images/madico-decorative-window-film-philadelphia.jpg',
    alt: 'Madico decorative privacy film in Philadelphia office interior',
    flip: false,
    body: [
      'Madico Decorative Film gives existing glass a finished architectural role, from classic frosted privacy to contemporary patterns for conference rooms, lobbies, retail entries, hotel interiors, and co-working spaces. It is a clean retrofit for glass that needs privacy, branding, or light control without full replacement.',
      'Unlike blackout treatments, decorative film can diffuse light while still keeping interiors open and polished. The 7-year warranty and wide style range make it useful for Philadelphia offices, restaurants, and hospitality spaces that need a design upgrade with minimal disruption to the glass system.'
    ],
    specs: ['Styles: Classic to Contemporary', 'Light Diffusion: Partial', 'Warranty: 7 years', 'Application: Interior retrofit'],
    pdfs: [
      ['/resources/madico-window-film-uv-protection-skin-eye-safety-guide-philadelphia.pdf', 'IWFA UV Skin & Eye Protection Guide'],
      ['/resources/madico-iso-14001-environmental-management-certification-philadelphia.pdf', 'ISO 14001 Environmental Certification'],
      ['/resources/madico-solar-control-window-film-insulating-glass-compatibility-guide-philadelphia.pdf', 'IWFA Window Film on Insulating Glass']
    ]
  }
];

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.windowfilmphiladelphia.net/products/' },
      { '@type': 'ListItem', position: 3, name: 'Madico Window Film', item: serviceUrl }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': serviceUrl,
    name: title,
    description,
    dateModified: new Date().toISOString().slice(0,10),
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.md-hero__title', '.md-why__intro'] }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Madico Window Film Products — Philadelphia',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Madico Sunscape Series', description: 'Non-metallic solar control film with neutral tones, 99% UV block, and heat rejection up to 86%.' },
      { '@type': 'ListItem', position: 2, name: 'Madico Solar Control', description: 'Commercial solar control film with reflective and neutral finishes, LEED support, and 10- to 15-year warranty terms.' },
      { '@type': 'ListItem', position: 3, name: 'Madico SafetyShield', description: '4- to 14-mil security film for fragment retention, CPSC safety glazing support, and forced-entry delay.' },
      { '@type': 'ListItem', position: 4, name: 'Madico Clear Safety Film', description: 'Crystal-clear 14-mil safety film compatible with DOWSIL 995 Silicone Structural Sealant for anchored systems.' },
      { '@type': 'ListItem', position: 5, name: 'Madico Decorative Film', description: 'Frosted, privacy, and patterned film for interior glass retrofit with 7-year warranty coverage.' }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Madico Window Film Philadelphia',
    brand: { '@type': 'Brand', name: 'Madico' },
    offers: { '@type': 'Offer', availability: 'https://schema.org/InStock', areaServed: 'Philadelphia, PA' },
    aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '6', bestRating: '5' },
    review: [
      { '@type': 'Review', reviewRating: { '@type': 'Rating', ratingValue: '5' }, author: { '@type': 'Person', name: 'Marcus T.' }, reviewBody: 'Madico Sunscape film took care of the glare on our east-facing offices without making the space feel like a cave. The heat drop was noticeable the first week.' },
      { '@type': 'Review', reviewRating: { '@type': 'Rating', ratingValue: '5' }, author: { '@type': 'Person', name: 'Sarah W.' }, reviewBody: 'Our Fishtown rowhome used to be unbearable in July. The Madico Sunscape film changed that completely — we barely run the AC now.' },
      { '@type': 'Review', reviewRating: { '@type': 'Rating', ratingValue: '5' }, author: { '@type': 'Person', name: 'Dr. James K.' }, reviewBody: 'We installed Madico SafetyShield in every classroom. Parents feel better knowing the glass is reinforced. I sleep better too.' }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={serviceUrl}
  ogImage={heroImage}
  serviceName="Madico Window Film"
  serviceDesc="Madico architectural window film for Philadelphia — Sunscape solar control, SafetyShield security, clear safety, and decorative privacy film."
  serviceUrl={serviceUrl}
  faqItems={faqItems}
  schemas={pageSchemas}
>
  <div class="md-geo" aria-hidden="true" style="display:none;">
    <p>Madico architectural film serves Center City, Fishtown, Old City, Rittenhouse Square, University City, and Navy Yard projects with Sunscape Series, SafetyShield, Clear Safety Film, Solar Control, and Decorative Film for rowhomes, commercial office buildings, schools, government facilities, and retail storefronts needing 99% UV block, up to 86% heat rejection, 4-14 mil security options, and retrofit privacy treatments.</p>
    <dl>
      <dt>What is Madico glass film in Philadelphia?</dt><dd>It is a manufacturer-backed architectural film system for solar control, security, UV protection, privacy, and decorative glass upgrades.</dd>
      <dt>How does Madico film work on glass?</dt><dd>Polyester layers, adhesives, coatings, and thickness options manage solar energy, visible light, ultraviolet radiation, and glass fragment retention.</dd>
      <dt>What Madico products are available locally?</dt><dd>Sunscape Series, Solar Control, SafetyShield, Clear Safety Film, and Decorative Film are available for residential and commercial applications.</dd>
      <dt>Which Philadelphia buildings use Madico products?</dt><dd>Rowhomes, schools, offices, retail storefronts, hotels, museums, restaurants, and civic buildings use Madico film across the city.</dd>
      <dt>Is Madico useful for Philadelphia winters?</dt><dd>Yes. The right solar control selection improves comfort during summer heat while reducing glare and UV exposure through winter sun angles.</dd>
      <dt>What affects Madico project cost?</dt><dd>Product series, glass size, access, film thickness, decorative pattern, anchoring requirements, and warranty requirements shape the final proposal.</dd>
    </dl>
    <ul>
      <li>Madico window film in Philadelphia</li>
      <li>Madico window tint Philadelphia</li>
      <li>Madico installer for Philadelphia glass</li>
      <li>Madico Sunscape Philadelphia rowhomes</li>
      <li>Madico SafetyShield Center City storefronts</li>
      <li>Madico Clear Safety Film schools Philadelphia</li>
      <li>Madico Solar Control University City offices</li>
      <li>Madico Decorative Film Old City restaurants</li>
      <li>Madico 14 mil security film Philadelphia</li>
      <li>Madico UV protection Rittenhouse Square</li>
      <li>Madico privacy film Navy Yard offices</li>
      <li>Madico commercial warranty Philadelphia</li>
      <li>Madico residential solar film Fishtown</li>
      <li>Madico safety glazing government facilities</li>
    </ul>
  </div>

  <section class="md-hero">
    <div class="md-hero__bg" style="background-image:url('/images/madico-window-film-philadelphia-hero.jpg')" role="img" aria-label="Madico window film on a Philadelphia commercial glass facade"></div>
    <div class="md-hero__overlay"></div>
    <div class="md-hero__content">
      <div class="md-hero__eyebrow">
        <span>Madico Architectural Film</span>
        <span class="md-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>Philadelphia, PA</span>
        <span class="md-hero__eyebrow-dot" aria-hidden="true"></span>
        <span>120 Years of Manufacturing</span>
      </div>
      <h1 class="md-hero__title">Madico Window Film in Philadelphia</h1>
      <p class="md-hero__animated-line">
        <FlipWords
          words={["for offices and commercial buildings", "for rowhomes and condos", "for retail storefronts and restaurants", "for schools and government facilities", "for hotels and hospitality spaces"]}
          staticText=""
          class="md-hero__flip"
        />
      </p>
      <p class="md-hero__subtitle">Sunscape solar control, SafetyShield security, Clear Safety Film, and decorative privacy options selected for Philadelphia glass, climate, and architecture.</p>
      <div class="md-hero__cta">
        <a href="/contact/" class="md-hero__btn-primary">Request a Madico Consultation</a>
        <a href="tel:2673947980" class="md-hero__btn-secondary">Call (267) 394-7980</a>
      </div>
      <div class="md-hero__stats-panel" aria-label="Madico product statistics">
        <div class="md-hero__stats-inner">
          <CountUp end={120} suffix="+ Years" label="of Innovation" />
          <div class="md-hero__stat-divider" aria-hidden="true"></div>
          <CountUp end={99} suffix="% UV" label="Protection" />
          <div class="md-hero__stat-divider" aria-hidden="true"></div>
          <CountUp end={86} suffix="% Max Heat" label="Rejection" />
          <div class="md-hero__stat-divider" aria-hidden="true"></div>
          <CountUp end={15} suffix="yr Commercial" label="Warranty" />
        </div>
      </div>
    </div>
  </section>

  <section class="md-intro">
    <div class="md-container md-intro__grid">
      <figure class="md-portrait">
        <img src="/images/madico-window-film-philadelphia-intro.jpg" alt="Installer applying Madico window film in Philadelphia" title="Madico window film Philadelphia intro" width="848" height="1264" loading="lazy" />
      </figure>
      <div class="md-intro__copy">
        <span class="md-eyebrow">Precision Manufacturing</span>
        <h2>Madico Brings 120 Years of Film Engineering to Philadelphia Glass</h2>
        <p>Madico window film in Philadelphia is a strong fit for property owners who want proven solar control, safety, and decorative glass upgrades without changing the architecture. For owners comparing Madico window tint in Philadelphia, the advantage is a broad product family that can be specified by glass type, exposure, building use, and finish preference.</p>
        <p>Madico's manufacturing credentials include more than 120 years of production experience, ISO 9001:2015 quality certification, ISO 14001 environmental management certification, and membership in Lintec Corporation. That combination matters when the project involves older rowhome glass, commercial IGUs, or high-visibility storefronts.</p>
        <div class="md-credentials">
          <span>120+ years manufacturing</span>
          <span>ISO 9001:2015</span>
          <span>ISO 14001</span>
          <span>Lintec Corporation member</span>
        </div>
      </div>
    </div>
  </section>

  <section class="md-trust">
    <div class="md-container md-trust__badges">
      <span><Icon name="lucide:factory" /> Precision manufactured</span>
      <span><Icon name="lucide:shield-check" /> SafetyShield security</span>
      <span><Icon name="lucide:sun" /> 99% UV protection</span>
      <span><Icon name="lucide:leaf" /> ISO 14001 certified</span>
    </div>
    <BrandLogos />
  </section>

  <section class="md-why">
    <div class="md-container md-why__grid">
      <div class="md-why__copy">
        <span class="md-eyebrow">Philadelphia Climate Match</span>
        <h2>Madico Handles Philadelphia's Summer Sun and Winter Swings</h2>
        <p class="md-why__intro">Madico architectural film has to work through humid summers, glare-heavy shoulder seasons, and older glass that can make winter rooms feel uneven. A Madico film installer for Philadelphia can match Sunscape, SafetyShield, Clear Safety Film, or Decorative Film to the exact glass and exposure instead of treating every window the same.</p>
        <p>"Madico has been a leader in high-quality manufacturing for over 120 years," according to Madico, Inc. That long manufacturing base supports <a href="https://www.madico.com/architectural">Madico's architectural window film line</a> for commercial, residential, safety, and decorative use.</p>
        <ul class="md-checks">
          <li><Icon name="lucide:check" /> Philadelphia sees roughly 100 days above 80°F, so solar heat rejection matters on east, south, and west glass.</li>
          <li><Icon name="lucide:check" /> About 28 inches of UV-heavy summer sun can accelerate fading on floors, furnishings, displays, and artwork.</li>
          <li><Icon name="lucide:check" /> Harsh winter swings make glare control and glass comfort valuable beyond summer cooling season.</li>
          <li><Icon name="lucide:check" /> Non-metallic Sunscape options help preserve wireless performance in dense offices and smart homes.</li>
          <li><Icon name="lucide:check" /> SafetyShield and Clear Safety Film add passive glass protection for street-level and institutional properties.</li>
        </ul>
        <p class="md-why__links">This Madico specification can support <a href="/benefits/energy-savings/">our energy savings solutions</a>, layered <a href="/benefits/safety-and-security/">safety and security film</a>, and high-performance <a href="/applications/office/">office window film applications</a>.</p>
      </div>
      <figure class="md-why__media">
        <img src="/images/madico-window-film-philadelphia-why.jpg" alt="Philadelphia interior suited for Madico solar and safety film" title="Madico Philadelphia climate fit" width="848" height="1264" loading="lazy" />
        <figcaption class="md-stat-card"><strong>86%</strong><span>maximum heat rejection in select Madico solar control films</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="md-slider" aria-label="Madico residential and commercial applications">
    <div class="md-slider__track" id="mdSliderTrack">
      <article class="md-slide is-active" style="background-image:url('/images/madico-window-film-philadelphia-residential.jpg')">
        <div class="md-slide__content">
          <span class="md-eyebrow">Residential Sunscape</span>
          <h2>Sunscape for Philadelphia Rowhomes</h2>
          <p>Madico Sunscape helps rowhomes control glare, protect interiors from 99% of UV rays, and reduce heat buildup without making rooms feel closed off. It is especially useful for older glass, narrow lots, and sun-facing bedrooms or living rooms.</p>
          <div class="md-slide__faq">
            <details open><summary>Can Madico Sunscape be applied to the older single-pane windows common in Philadelphia rowhomes?</summary><p>Yes. Many single-pane windows are good candidates after the glass condition, age, and sun exposure are reviewed.</p></details>
            <details><summary>Will Madico window film fade the colors in my Philadelphia home's interior?</summary><p>It helps reduce fading by blocking 99% of UV rays, while visible light and heat are managed by the selected Sunscape shade.</p></details>
            <details><summary>Is Madico film visible from the street, or does it change the look of my rowhome?</summary><p>Sunscape offers neutral options that can keep the exterior appearance subtle while still improving interior comfort.</p></details>
          </div>
        </div>
      </article>
      <article class="md-slide" style="background-image:url('/images/madico-window-film-philadelphia-commercial.jpg')">
        <div class="md-slide__content">
          <span class="md-eyebrow">Commercial Safety + Solar</span>
          <h2>Commercial Film for Center City</h2>
          <p>Madico SafetyShield and Solar Control films help Philadelphia commercial properties manage heat, glare, UV exposure, and glass security in one specification strategy. Storefronts, offices, restaurants, and institutional glass can be matched to thickness, tint, and performance goals.</p>
          <div class="md-slide__faq">
            <details open><summary>Does Madico window film qualify for LEED credits on Philadelphia commercial projects?</summary><p>Yes. Madico solar control film data can support LEED-oriented documentation when the project criteria and modeled performance align.</p></details>
            <details><summary>What Madico security film thickness is right for a Philadelphia retail storefront?</summary><p>Common storefront specifications use the threat profile, glass size, frame condition, and visibility goals to select SafetyShield thickness from the 4- to 14-mil range.</p></details>
            <details><summary>Can Madico SafetyShield be installed without anchoring on Philadelphia office buildings?</summary><p>Yes. SafetyShield can be specified as film-only fragment retention or paired with anchoring where the security objective calls for stronger edge retention.</p></details>
          </div>
        </div>
      </article>
    </div>
    <div class="md-slider__nav">
      <button type="button" data-md-slide="0" aria-label="Show residential Madico slide">Residential</button>
      <button type="button" data-md-slide="1" aria-label="Show commercial Madico slide">Commercial</button>
    </div>
  </section>

  <section class="md-products">
    <div class="md-container">
      {productRows.map((row) => (
        <article class={`md-pl-row ${row.flip ? 'md-pl-row--flip' : ''}`}>
          <figure class="md-pl-row__media">
            <img src={row.image} alt={row.alt} title={row.alt} width="848" height="1264" loading="lazy" />
          </figure>
          <div class="md-pl-row__copy">
            <span class="md-eyebrow">{row.eyebrow}</span>
            <h2>{row.title}</h2>
            {row.body.map((paragraph) => <p>{paragraph}</p>)}
            <div class="md-specs">{row.specs.map((spec) => <span>{spec}</span>)}</div>
            <div class="md-pdfs" aria-label={`${row.title} resources`}>
              {row.pdfs.map(([href, label]) => <a href={href}>{label}</a>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="md-compare">
