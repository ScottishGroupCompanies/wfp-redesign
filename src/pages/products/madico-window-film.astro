<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('mdSliderTrack');
    document.querySelectorAll('[data-md-slide]').forEach((button) => {
      button.addEventListener('click', () => {
        const index = Number((button as HTMLElement).dataset.mdSlide || 0);
        if (track) track.style.transform = `translateX(-${index * 100}%)`;
      });
    });

    const range = document.getElementById('mdTintRange') as HTMLInputElement | null;
    const overlay = document.getElementById('mdTintOverlay');
    const film = document.getElementById('mdTintFilm');
    const vlt = document.getElementById('mdTintVlt');
    const labels = [
      { max: 19, film: 'Clear', vlt: 'Clear' },
      { max: 44, film: 'Sunscape Light', vlt: 'Light' },
      { max: 69, film: 'Sunscape Medium', vlt: 'Medium' },
      { max: 89, film: 'Sunscape Dark', vlt: 'Dark' },
      { max: 100, film: 'Limo', vlt: 'Limo' }
    ];
    const updateTint = () => {
      if (!range || !overlay || !film || !vlt) return;
      const value = Number(range.value);
      overlay.style.opacity = String((value / 100) * 0.78);
      const label = labels.find((item) => value <= item.max) || labels[labels.length - 1];
      film.textContent = label.film;
      vlt.textContent = label.vlt;
    };
    range?.addEventListener('input', updateTint);
    updateTint();
  });
</script>
