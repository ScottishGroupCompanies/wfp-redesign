---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import products from '../../../data/v-kool-products.json';

export async function getStaticPaths() {
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;

const relatedProducts = products.filter((p) => product.relatedSlugs.includes(p.slug)).slice(0, 3);

const title = `${product.name} | V-Kool ${product.series}`;
const description = `${product.shortDescription} Authorized Solyx installer serving Philadelphia, Center City, and the surrounding region.`.slice(0, 155);
const canonical = `https://windowfilmphiladelphia.net/products/v-kool/${product.slug}/`;

const faqItems = [
  {
    question: `What is ${product.name} window film?`,
    answer: product.description.split('\n\n')[0].replace(/<[^>]+>/g, '')
  },
  {
    question: `Where is ${product.name} film used in Philadelphia?`,
    answer: product.description.split('\n\n')[1]?.replace(/<[^>]+>/g, '') || `${product.name} is used in Philadelphia offices, retail storefronts, healthcare facilities, and residential properties throughout Center City and surrounding neighborhoods.`
  },
  {
    question: `How is ${product.name} film installed in Philadelphia?`,
    answer: `${product.name} film is applied to the interior glass surface by Window Film Philadelphia's authorized installation team. We assess glass type, dimensions, and application requirements before installation to ensure compatibility and long-term performance.`
  }
];

const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://windowfilmphiladelphia.net/products/" },
      { "@type": "ListItem", "position": 3, "name": "V-Kool Window Film", "item": "https://windowfilmphiladelphia.net/products/v-kool/" },
      { "@type": "ListItem", "position": 4, "name": product.name, "item": canonical }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": canonical,
    "name": title,
    "description": description,
    "dateModified": new Date().toISOString().slice(0, 10),
    "breadcrumb": { "@type": "BreadcrumbList", "itemListElement": [] }
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": `${product.name} — V-Kool Window Film`,
    "description": product.shortDescription,
    "brand": { "@type": "Brand", "name": "V-Kool by Eastman" },
    "category": product.series,
    "offers": {
      "@type": "Offer",
      "seller": { "@type": "LocalBusiness", "name": "Window Film Philadelphia" },
      "areaServed": "Philadelphia, PA",
      "availability": "https://schema.org/InStock"
    }
  }
];



const specEntries = Object.entries(product.specs).filter(([, v]) => v && v !== 'null');
---

<BaseLayout {title} {description} {canonical} schemas={pageSchemas} faqItems={faqItems}>

<!-- ══ HERO ══ -->
<section class="vkp-hero">
  <div class="vkp-hero__bg" style={`background-image:url('${product.image}')`} role="img" aria-label={`${product.name} window film installed in Philadelphia`}></div>
  <div class="vkp-hero__overlay"></div>
  <div class="vkp-hero__content">
    <div class="vkp-hero__eyebrow">
      <a href="/products/v-kool/" class="vkp-hero__back">← V-Kool Window Film</a>
      <span class="vkp-hero__eyebrow-dot" aria-hidden="true"></span>
      <span class="vkp-hero__series-pill" style={`background:${product.seriesColor}`}>{product.series}</span>
    </div>
    <h1 class="vkp-hero__title">{product.name}</h1>
    <p class="vkp-hero__sub">{product.shortDescription}</p>
    <div class="vkp-hero__chips">
      {product.specs.vlt && <span class="vkp-hero__chip">VLT: {product.specs.vlt}</span>}
      {product.specs.uvBlock && <span class="vkp-hero__chip">UV: {product.specs.uvBlock}</span>}
      {product.specs.application && <span class="vkp-hero__chip">{product.specs.application} application</span>}
      {(product.specs as any).thickness && <span class="vkp-hero__chip">{(product.specs as any).thickness}</span>}
    </div>
    <div class="vkp-hero__ctas">
      <a href="/contact/" class="vkp-hero__btn-primary">Get a Free Quote</a>
      <a href="tel:2673947980" class="vkp-hero__btn-secondary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z" fill="currentColor"/></svg>
        (267) 394-7980
      </a>
    </div>
  </div>
</section>

<div class="ip-page-body">

<!-- ══ OVERVIEW ══ -->
<section class="vkp-overview">
  <div class="vkp-overview__inner">
    <div class="vkp-overview__img-col">
      <img
        src={product.image}
        alt={`${product.name} window film installed in Philadelphia`}
        title={`${product.name} — Solyx ${product.series} — Window Film Philadelphia`}
        width="600" height="400"
        loading="lazy"
        class="vkp-overview__img"
      />
      <div class="vkp-overview__cats">
        {product.categories.map((c) => (
          <span class="vkp-overview__cat-pill">{c}</span>
        ))}
      </div>
    </div>
    <div class="vkp-overview__content">
      <span class="vkp-overview__eyebrow" style={`color:${product.seriesColor}`}>{product.series}</span>
      <h2 class="vkp-overview__title">About {product.name}</h2>
      {product.description.split('\n\n').map((para) => (
        <p class="vkp-overview__para">{para}</p>
      ))}
      <a href="/contact/" class="vkp-overview__cta">
        Request a site assessment &rarr; <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ══ BENEFITS ══ -->
<section class="vkp-benefits">
  <div class="vkp-benefits__inner">
    <span class="pp-eyebrow">Key Benefits</span>
    <h2 class="vkp-benefits__title">Why specify {product.name} for Philadelphia glass</h2>
    <div class="vkp-benefits__grid">
      {product.benefits.map((b) => (
        <div class="vkp-benefits__card">
          <div class="vkp-benefits__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.27L12 14.54l-5.62 3.96 2.09-6.27L3 8.26h6.91L12 2z" fill="#81AB4C"/></svg>
          </div>
          <h3 class="vkp-benefits__heading">{b.heading}</h3>
          <p class="vkp-benefits__body">{b.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══ SPECS TABLE ══ -->
<section class="vkp-specs">
  <div class="vkp-specs__inner">
    <h2 class="vkp-specs__title">Technical Specifications</h2>
    <table class="vkp-specs__table" aria-label={`${product.name} technical specifications`}>
      <tbody>
        <tr class="vkp-specs__row"><td class="vkp-specs__label">Film Series</td><td class="vkp-specs__val">{product.series}</td></tr>
        <tr class="vkp-specs__row"><td class="vkp-specs__label">Brand</td><td class="vkp-specs__val">Solyx® by Decorative Films, LLC</td></tr>
        {specEntries.map(([k, v]) => (
          <tr class="vkp-specs__row">
            <td class="vkp-specs__label">{k === 'vlt' ? 'Visible Light Transmission' : k === 'uvBlock' ? 'UV Block' : k === 'application' ? 'Application' : k === 'warranty' ? 'Warranty' : k === 'thickness' ? 'Thickness' : k === 'heights' ? 'Standard Heights' : k === 'power' ? 'Power' : k === 'certification' ? 'Certification' : k === 'note' ? 'Note' : k}</td>
            <td class="vkp-specs__val">{v}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="vkp-specs__note">Source: V-Kool product specifications (v-kool-usa.com). Contact Window Film Philadelphia for product-specific technical documentation.</p>
  </div>
</section>

<!-- ══ APPLICATIONS ══ -->
<section class="vkp-apps">
  <div class="vkp-apps__inner">
    <h2 class="vkp-apps__title">Philadelphia Applications</h2>
    <div class="vkp-apps__grid">
      {product.categories.map((cat) => (
        <div class="vkp-apps__card">
          <div class="vkp-apps__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#81AB4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {cat === 'Privacy' && <><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/></>}
              {cat === 'Office' && <><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></>}
              {cat === 'Healthcare' && <><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></>}
              {cat === 'Hospitality' && <><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></>}
              {cat === 'Residential' && <><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></>}
              {cat === 'Security' && <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></>}
              {cat === 'Retail' && <><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></>}
              {cat === 'Education' && <><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></>}
              {cat === 'Solar Control' && <><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/></>}
              {cat === 'Energy' && <><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></>}
              {cat === 'Custom' && <><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 19.07A10 10 0 0 1 4.93 4.93"/></>}
              {cat === 'Branding' && <><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></>}
              {cat === 'Decorative' && <><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></>}
              {cat === 'Luxury' && <><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.27L12 14.54l-5.62 3.96 2.09-6.27L3 8.26h6.91L12 2z" fill="#81AB4C" stroke="none"/></>}
              {(cat === 'Themed' || cat === 'Seasonal') && <><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></>}
              {cat === 'Technology' && <><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></>}
              {cat === 'Smart Glass' && <><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></>}
              {cat === 'Environmental' && <><path d="M17 8C8 10 5.9 16.17 3.82 22M9.6 17C10.1 19.14 9.75 21.67 8 22"/><path d="M22 8s-4 8-14 8c-2 0-4-.5-5-1"/></>}
              {cat === 'Display' && <><rect x="2" y="3" width="20" height="14" rx="2"/><polyline points="8 21 12 17 16 21"/></>}
              {cat === 'Events' && <><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.27L12 14.54l-5.62 3.96 2.09-6.27L3 8.26h6.91L12 2z"/></>}
              {cat === 'Construction' && <><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></>}
              {cat === 'Transit' && <><rect x="2" y="7" width="20" height="13" rx="2"/><path d="M16 2H8a2 2 0 0 0-2 2v3h12V4a2 2 0 0 0-2-2z"/><circle cx="8" cy="16" r="1"/><circle cx="16" cy="16" r="1"/></>}
              {cat === 'Schools' && <><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></>}
              {cat === 'Religious' && <><path d="M18 11.5V22H6V11.5"/><path d="M2 10l10-9 10 9"/><path d="M12 22V12"/><path d="M9 15h6"/></>}
              {cat === 'Lighting' && <><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/></>}
              {cat === 'Photography' && <><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></>}
              {cat === 'Collaboration' && <><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></>}
              {!['Privacy','Office','Healthcare','Hospitality','Residential','Security','Retail','Education','Solar Control','Energy','Custom','Branding','Decorative','Luxury','Themed','Seasonal','Technology','Smart Glass','Environmental','Display','Events','Construction','Transit','Schools','Religious','Lighting','Photography','Collaboration'].includes(cat) && <><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></>}
            </svg>
          </div>
          <span class="vkp-apps__label">{cat}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══ RELATED PRODUCTS ══ -->
{relatedProducts.length > 0 && (
  <section class="vkp-related">
    <div class="vkp-related__inner">
      <span class="pp-eyebrow">Also in the V-Kool Series</span>
      <h2 class="vkp-related__title">Related Film Types</h2>
      <div class="vkp-related__grid">
        {relatedProducts.map((r) => (
          <a href={`/products/v-kool/${r.slug}/`} class="vkp-related__card">
            <img src={r.image} alt={r.name} title={`${r.name} — Solyx ${r.series}`} width="400" height="267" loading="lazy" class="vkp-related__img" />
            <div class="vkp-related__body">
              <span class="vkp-related__series" style={`color:${r.seriesColor}`}>{r.series}</span>
              <h3 class="vkp-related__name">{r.name}</h3>
              <p class="vkp-related__desc">{r.shortDescription}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="vkp-related__back">
        <a href="/products/v-kool/" class="vkp-related__back-link">← View all V-Kool films</a>
      </div>
    </div>
  </section>
)}

<!-- ══ CTA ══ -->
<section class="vkp-cta">
  <div class="vkp-cta__inner">
    <h2 class="vkp-cta__title">Install {product.name} in Philadelphia</h2>
    <p class="vkp-cta__sub">Window Film Philadelphia is an authorized V-Kool installer. Get a free assessment for your space — no obligation, just expert advice on the right film for your glass.</p>
    <div class="vkp-cta__btns">
      <a href="/contact/" class="vkp-cta__btn vkp-cta__btn--primary">Get Your Free Estimate</a>
      <a href="tel:2673947980" class="vkp-cta__btn vkp-cta__btn--secondary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z" fill="currentColor"/></svg>
        (267) 394-7980
      </a>
    </div>
  </div>
</section>

</div><!-- end ip-page-body -->
</BaseLayout>

<style>
/* ══ HERO ══ */
.vkp-hero { position: relative; min-height: 70vh; display: flex; align-items: flex-end; overflow: hidden; padding-bottom: 64px; }
.vkp-hero__bg { position: absolute; inset: 0; background-size: cover; background-position: center; }
.vkp-hero__overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(10,20,10,.2) 0%, rgba(10,20,10,.65) 60%, rgba(10,20,10,.88) 100%); }
.vkp-hero__content { position: relative; z-index: 2; width: 100%; max-width: 1400px; margin: 0 auto; padding: 0 6%; }
.vkp-hero__eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
.vkp-hero__back { font-family: var(--font-body,'DM Sans',sans-serif); font-size: 13px; font-weight: 600; color: rgba(255,255,255,.75); text-decoration: none; transition: color .2s; }
.vkp-hero__back:hover { color: #fff; }
.vkp-hero__eyebrow-dot { width: 4px; height: 4px; border-radius: 50%; background: #81AB4C; }
.vkp-hero__series-pill { display: inline-block; padding: 4px 12px; border-radius: 999px; font-family: var(--font-body,'DM Sans',sans-serif); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #fff; }
.vkp-hero__title { font-family: var(--font-serif,'Playfair Display',serif); font-size: clamp(36px,6vw,72px); font-weight: 700; color: #fff; line-height: 1.05; letter-spacing: -1px; margin: 0 0 16px; max-width: 800px; }
.vkp-hero__sub { font-family: var(--font-body,'DM Sans',sans-serif); font-size: clamp(15px,1.8vw,18px); color: rgba(255,255,255,.85); line-height: 1.6; margin: 0 0 24px; max-width: 640px; }
.vkp-hero__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
.vkp-hero__chip { display: inline-flex; align-items: center; padding: 6px 14px; border-radius: 999px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.25); font-family: var(--font-body,'DM Sans',sans-serif); font-size: 12px; font-weight: 600; color: rgba(255,255,255,.9); backdrop-filter: blur(8px); }
.vkp-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }
.vkp-hero__btn-primary { display: inline-flex; align-items: center; padding: 14px 28px; border-radius: 999px; background: #81AB4C; color: #fff; font-family: var(--font-body,'DM Sans',sans-serif); font-weight: 700; font-size: 15px; text-decoration: none; transition: background .2s, transform .2s; }
.vkp-hero__btn-primary:hover { background: #6e9640; transform: translateY(-2px); }
.vkp-hero__btn-secondary { display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; border-radius: 999px; background: rgba(255,255,255,.1); border: 1.5px solid rgba(255,255,255,.4); color: #fff; font-family: var(--font-body,'DM Sans',sans-serif); font-weight: 700; font-size: 15px; text-decoration: none; transition: background .2s; }
.vkp-hero__btn-secondary:hover { background: rgba(255,255,255,.18); }
/* ══ OVERVIEW ══ */
.vkp-overview { padding: 80px 6%; background: #fff; }
.vkp-overview__inner { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1.5fr; gap: 60px; align-items: start; }
.vkp-overview__img { width: 100%; height: 380px; object-fit: cover; border-radius: 8px; display: block; }
.vkp-overview__cats { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
.vkp-overview__cat-pill { padding: 4px 12px; border-radius: 999px; background: #f0f5e8; border: 1px solid #c8dc98; font-family: var(--font-body,'DM Sans',sans-serif); font-size: 12px; font-weight: 600; color: #4a6a20; }
.vkp-overview__eyebrow { display: block; font-family: var(--font-body,'DM Sans',sans-serif); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 12px; }
.vkp-overview__title { font-family: var(--font-serif,'Playfair Display',serif); font-size: clamp(24px,3vw,38px); font-weight: 700; color: #1a1a1a; line-height: 1.15; margin: 0 0 24px; }
.vkp-overview__para { font-family: var(--font-body,'DM Sans',sans-serif); font-size: 15px; color: #3a3a3a; line-height: 1.75; margin: 0 0 16px; }
.vkp-overview__cta { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-body,'DM Sans',sans-serif); font-size: 14px; font-weight: 700; color: #81AB4C; text-decoration: none; margin-top: 12px; }
.vkp-overview__cta:hover { color: #6e9640; }
/* ══ BENEFITS ══ */
.vkp-benefits { padding: 80px 6%; background: #0d1a0d; }
