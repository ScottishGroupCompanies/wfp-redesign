</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));

  // ── Slider ──
  (function initM3Slider() {
    const track = document.getElementById('vkTrack');
    const slides = document.querySelectorAll('.vk-slider__slide');
    const navItems = document.querySelectorAll('[data-vknav]');
    const prevBtn = document.getElementById('vkPrev');
    const nextBtn = document.getElementById('vkNext');
    const progressBar = document.getElementById('vkProgressBar');
    if (!track || !slides.length) return;
    let current = 0;
    const total = slides.length;

    function goTo(i) {
      if (i < 0) i = total - 1;
      if (i >= total) i = 0;
      current = i;
      track.style.transform = `translateX(-${current * 100}%)`;
      navItems.forEach((n, idx) => n.classList.toggle('vk-slider__nav-item--active', idx === current));
      slides.forEach((s, idx) => s.classList.toggle('vk-active', idx === current));
      if (progressBar) {
        progressBar.style.transition = 'none';
        progressBar.style.width = '0';
        setTimeout(() => { progressBar.style.transition = 'width 6s linear'; progressBar.style.width = '100%'; }, 50);
      }
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    navItems.forEach((n, i) => n.addEventListener('click', () => goTo(i)));

    document.querySelectorAll('.vk-slider__faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const slide = btn.closest('.vk-slider__slide');
        slide.querySelectorAll('.vk-slider__faq-q').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          const a = b.nextElementSibling; if (a) a.hidden = true;
        });
        if (!expanded) {
          btn.setAttribute('aria-expanded', 'true');
          const a = btn.nextElementSibling; if (a) a.hidden = false;
        }
      });
    });

    let timer = setInterval(() => goTo(current + 1), 6000);
    document.getElementById('vkSlider')?.addEventListener('mouseenter', () => clearInterval(timer));
    document.getElementById('vkSlider')?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 6000); });
    goTo(0);
  })();

  document.querySelectorAll('.vk-faq__item').forEach(item => {
    item.querySelector('.vk-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('vk-faq__item--open');
      document.querySelectorAll('.vk-faq__item').forEach(i => i.classList.remove('vk-faq__item--open'));
      if (!isOpen) item.classList.add('vk-faq__item--open');
    });
  });

  // ══ TINT SLIDER ══
  (() => {
    const range = document.getElementById('vkTintRange');
    const overlay = document.getElementById('vkTintOverlay');
    const vltEl = document.getElementById('vkTintVlt');
    const filmEl = document.getElementById('vkTintFilm');
    if (!range) return;
    // v=0 (left) = clearest, v=100 (right) = darkest (limo)
    // VLT: clear ~90% down to limo ~5%
    // v=0 (left, CLEAR) = no tint; v=100 (right, LIMO) = darkest
    const films = [
      { minV: 0,  maxV: 15,  name: 'Clear — No Film',       vlt: 90 },
      { minV: 15, maxV: 30,  name: '3M Thinsulate CC75',   vlt: 75 },
      { minV: 30, maxV: 50,  name: '3M Sun Control PR70',  vlt: 70 },
      { minV: 50, maxV: 65,  name: '3M Sun Control PR50',  vlt: 50 },
      { minV: 65, maxV: 80,  name: '3M Sun Control PR35',  vlt: 35 },
      { minV: 80, maxV: 90,  name: '3M Night Vision NV25', vlt: 24 },
      { minV: 90, maxV: 100, name: '3M Night Vision NV15', vlt: 15 },
    ];
    const update = () => {
      const v = parseInt(range.value); // 0=CLEAR (light), 100=LIMO (dark)
      const vlt = Math.round(90 - (v / 100) * 85); // 90% at CLEAR, 5% at LIMO
      const opacity = (v / 100) * 0.78;
      overlay.style.background = `rgba(10,20,5,${opacity.toFixed(3)})`;
      vltEl.textContent = vlt + '%';
      const film = films.find(f => v >= f.minV && v <= f.maxV) || films[films.length - 1];
      filmEl.textContent = film.name;
    };
    range.addEventListener('input', update);
    update();
  })();
</script>
