}
.vk-cinematic-cta__vignette {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, rgba(13,26,15,0.15) 0%, rgba(13,26,15,0.6) 100%);
}
.vk-cinematic-cta__content {
  position: relative;
  z-index: 10;
  max-width: 760px;
  padding: 80px 24px;
  text-align: center;
