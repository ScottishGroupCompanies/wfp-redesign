  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "V-Kool Window Film — Window Film Philadelphia",
    "description": "V-Kool V-Kool architectural window film installed by Window Film Philadelphia. XIR® sputtered technology, manufactured in Dresden, Germany. Authorized installer for Philadelphia.",
