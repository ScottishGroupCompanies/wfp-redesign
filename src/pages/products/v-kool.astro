      { "@type": "ListItem", "position": 2, "name": "V-KOOL 75 — Highest Clarity", "description": "77% VLT, 45% TSER, 77% IR rejection. Maximum daylight for Philadelphia historic preservation glass and clarity-sensitive applications." },
