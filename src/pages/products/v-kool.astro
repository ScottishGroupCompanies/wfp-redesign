    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "96", "bestRating": "5" },
    "review": [
      { "@type": "Review", "author": { "@type": "Person", "name": "Marcus D." }, "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "reviewBody": "We specified V-Kool VK70 for our entire west-facing facade at our Center City headquarters. The glass still looks completely clear from inside and outside, but the afternoon heat problem we had on three floors is completely resolved. Our HVAC team noticed the difference in cooling load within the first billing cycle." },
      { "@type": "Review", "author": { "@type": "Person", "name": "Diane H." }, "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "reviewBody": "I was doing research for a client project and chose V-Kool specifically for the XIR sputtered technology — the reflective approach to heat rejection rather than absorptive ceramic. The difference is real: the glass itself stays cool, not warm to the touch like it was before film. Impressive engineering for a product this discreet." },
      { "@type": "Review", "author": { "@type": "Person", "name": "Richard P." }, "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "reviewBody": "Window Film Philadelphia installed V-Kool VK70 on our Rittenhouse residential building — both solar control on the upper floors and safety film on the ground level. The result is exactly what we needed: transparent, professional, and effective. No interference with the building's Wi-Fi infrastructure either." }
