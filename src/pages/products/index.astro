---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSubpage from '../../components/HeroSubpage.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import BentoGridPhoto from '../../components/BentoGridPhoto.astro';
import AccordionVertical from '../../components/AccordionVertical.astro';
import LogoCloudBlurFlip from '../../components/LogoCloudBlurFlip.astro';
import TestimonialMarquee from '../../components/TestimonialMarquee.astro';
import AccordionFAQ from '../../components/AccordionFAQ.astro';
import CTATintSlider from '../../components/CTATintSlider.astro';
import MobileStickyCTA from '../../components/MobileStickyCTA.astro';
import SplitTextReveal from '../../components/animations/SplitTextReveal.astro';
import ScrollReveal from '../../components/animations/ScrollReveal.astro';

const title = 'Window Film Products Philadelphia | 3M, LLumar, Vista & More';
const description = 'Window Film Philadelphia installs every leading manufacturer — 3M, LLumar, Vista, Solar Gard, Huper Optik, Madico, V-Kool and more. One certified installer, every brand, manufacturer warranties.';

const ICONS = {
  cube: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>',
  sun: '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>',
  layers: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>',
};

const bentoItems = [
  { span: 'lg', title: '3M Window Film', desc: 'Science-backed solar, safety, and decorative film since 1966. The global gold standard.', img: '/images/3m-window-film-philadelphia-hero.jpg', href: '/products/3m-window-film/' },
  { span: 'sm', title: 'LLumar', desc: 'Performance solar and safety film trusted by homeowners and Fortune 500 facility managers worldwide.', img: '/images/llumar-window-film-philadelphia-hero.jpg', href: '/products/llumar/' },
  { span: 'sm', title: 'Vista Window Film', desc: 'Spectrally selective. Engineered for architects who demand performance without sacrificing natural light.', img: '/images/2021-09-vista-window-film-philadelphia.jpg', href: '/products/vista-window-film/' },
  { span: 'sm', title: 'Solar Gard', desc: "Saint-Gobain's professional-grade line for high-occupancy buildings since 1973.", img: '/images/2021-09-solar-gard-window-film-philadelphia.jpg', href: '/products/solar-gard-window-film/' },
  { span: 'sm', title: 'Huper Optik', desc: 'German-engineered 100% ceramic film. Zero signal interference. Lifetime residential warranty.', img: '/images/huper-optik-window-film-philadelphia-hero.jpg', href: '/products/huper-optik/' },
  { span: 'sm', title: 'Madico', desc: 'Over 100 years of film science. SafetyPly and ClearPly certified for government and healthcare.', img: '/images/madico-window-film-philadelphia-hero.jpg', href: '/products/madico-window-film/' },
  { span: 'sm', title: 'V-Kool', desc: 'Multi-layer sputtered precision. Maximum heat rejection at the highest VLT levels in the category.', img: '/images/2021-09-vista-window-film-philadelphia.jpg', href: '/products/v-kool/' },
];

const accordionItems = [
  {
    title: '3M Window Film',
    description: '3M invented window film in 1966 and remains the global benchmark. Prestige Series delivers up to 97% IR rejection. Scotchshield safety film is specified by government facilities and schools nationwide. Every 3M installation is backed by a manufacturer warranty.',
    img: '/images/3m-window-film-philadelphia-hero.jpg',
    icon: ICONS.cube,
    href: '/products/3m-window-film/',
    ctaText: 'Explore 3M Window Film',
  },
  {
    title: 'LLumar',
    description: "LLumar's ATC Series is one of the most widely installed commercial films in the world — non-metallic, no signal interference, NFRC-certified. Their Low-E film is the Philadelphia four-season choice, rejecting solar heat in summer while retaining indoor warmth in winter.",
    img: '/images/llumar-window-film-philadelphia-hero.jpg',
    icon: ICONS.sun,
    href: '/products/llumar/',
    ctaText: 'Explore LLumar',
  },
  {
    title: 'Vista Window Film',
    description: 'Vista by Eastman uses proprietary spectrally selective technology to filter solar energy while preserving natural light and curb appeal. Non-metallic — no GPS, Wi-Fi, or cellular degradation. Sustainably sourced materials and architectural options for design-forward properties.',
    img: '/images/2021-09-vista-window-film-philadelphia.jpg',
    icon: ICONS.layers,
    href: '/products/vista-window-film/',
    ctaText: 'Explore Vista',
  },
  {
    title: 'Solar Gard',
    description: "Saint-Gobain's Solar Gard line has served the professional installer market since 1973. Duran and Schwarz series deliver exceptional solar control for high-occupancy Philadelphia commercial buildings. Bomb-blast mitigation and anti-graffiti sacrificial films available.",
    img: '/images/2021-09-solar-gard-window-film-philadelphia.jpg',
    icon: ICONS.shield,
    href: '/products/solar-gard-window-film/',
    ctaText: 'Explore Solar Gard',
  },
];

// All 14 brands — fully clickable
const allBrands = [
  { src: '/images/2021-09-3m-window-film-philadelphia.webp', alt: '3M™ Window Film', href: '/products/3m-window-film/' },
  { src: '/images/2021-09-llumar-window-film-philadelphia.webp', alt: 'LLumar', href: '/products/llumar/' },
  { src: '/images/2021-09-vista-window-film-philadelphia.webp', alt: 'Vista Window Film', href: '/products/vista-window-film/' },
  { src: '/images/2021-09-solar-gard-window-film-philadelphia.webp', alt: 'Solar Gard', href: '/products/solar-gard-window-film/' },
  { src: '/images/2021-09-madico-window-film-philadelphia.webp', alt: 'Madico', href: '/products/madico-window-film/' },
  { src: '/images/2021-09-huper-optik-window-film-philadelphia.webp', alt: 'Huper Optik', href: '/products/huper-optik/' },
  { src: '/images/2021-09-casper-window-film-philadelphia.webp', alt: 'Casper Cloaking Film', href: '/products/casper-cloaking-film/' },
  { src: '/images/c-bond-primer-window-film-philadelphia.webp', alt: 'C-Bond Systems', href: '/products/c-bond-window-film/' },
  { src: '/images/2021-09-hdclear-window-film-philadelphia.webp', alt: 'HDClear', href: '/products/hdclear-window-film/' },
  { src: '/images/2021-09-hanita-coatings-window-film-philadelphia.webp', alt: 'Hanita Coatings', href: '/products/hanita-coatings-window-film/' },
  { src: '/images/2021-09-solyx-window-film-philadelphia.webp', alt: 'Solyx', href: '/products/solyx-window-film/' },
  { src: '/images/drywired-liquid-nanotint-philadelphia-1.webp', alt: 'NanoTint', href: '/products/nanotint-window-film/' },
  { src: '/images/bird-divert-film-philadelphia.webp', alt: 'Bird Divert', href: '/products/bird-divert/' },
  { src: '/images/v-kool-window-film-philadelphia.jpg', alt: 'V-Kool', href: '/products/v-kool/' },
];

const faqSchema = [
  { question: 'How do I know which window film brand is right for my property?', answer: "Every property is different — glass type, building orientation, occupancy type, and budget all factor in. During our free on-site consultation, we'll assess your specific situation and recommend the film brands and performance levels that make the most sense for your goals." },
  { question: 'Are all these brands available for both residential and commercial projects?', answer: 'Yes. Every brand we carry offers residential and commercial product lines. Some brands like 3M, Madico, and Solar Gard have specialized commercial-grade films for high-rise buildings, government facilities, and healthcare environments.' },
  { question: 'Do you offer manufacturer warranties on all installations?', answer: 'All our installations carry a lifetime manufacturer warranty on film adhesion, peeling, bubbling, and fading for the original property owner. Warranty terms vary by brand — we provide full documentation at the time of installation.' },
  { question: 'Can I mix different brands on different windows of the same building?', answer: 'Absolutely. Many projects use different film types on different elevations — for example, a high-performance ceramic on the west-facing facade and a decorative film on the street-level storefront. We spec each area independently.' },
  { question: 'How do I verify that a brand is genuinely premium vs. budget film?', answer: 'Look for established manufacturer warranty programs, third-party lab testing (e.g., NFRC ratings), and certified installer networks. All the brands we carry meet these criteria. Budget films often lack these safeguards and degrade within a few years.' },
  { question: 'What is the lead time for ordering these film brands?', answer: 'Most standard film orders ship within 5–10 business days. Specialty films (decorative prints, custom patterns, specialty tints) may require 2–4 weeks. We maintain a local inventory of the most popular films for same-week installation on time-sensitive projects.' },
];

const faqItems = faqSchema.map(f => ({ q: f.question, a: f.answer }));
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.windowfilmphiladelphia.net/products/"
  serviceName="Window Film Products Philadelphia"
  serviceDesc="Window Film Philadelphia installs every leading manufacturer — 3M, LLumar, Vista, Solar Gard, Huper Optik, Madico, V-Kool and more."
  serviceUrl="https://www.windowfilmphiladelphia.net/products/"
  faqItems={faqSchema}
>

  <script type="application/ld+json">{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Window Film Products Philadelphia", "item": "https://www.windowfilmphiladelphia.net/products/" }
    ]
  })}</script>

  <!-- ══ 1. HERO ══ -->
  <HeroSubpage
    eyebrow="TOP BRANDS · EVERY APPLICATION · EXPERT ADVICE"
    title={"The industry's best\nwindow film brands,\nall in one place."}
    subtitle="Window Film Philadelphia partners with every leading manufacturer to offer the most comprehensive product selection in the Greater Philadelphia region."
    bg="/images/2021-10-window-film-brands-philadelphia.jpg"
    ctaText="Get a free quote"
    ctaHref="/contact/"
    secondaryText="See all brands"
    secondaryHref="#all-brands"
  />

  <!-- ══ 2. TRUST STRIP ══ -->
  <TrustStrip title="OUR MANUFACTURER PARTNERS" />

  <!-- ══ 3. INTRO BAND ══ -->
  <section class="prod-intro">
    <div class="prod-intro__inner">
      <SplitTextReveal
        text="One installer. Every major manufacturer."
        as="h2"
        class="prod-intro__heading"
      />
      <p class="prod-intro__body">
        We're certified installers for 3M, LLumar, Vista, Solar Gard, Huper Optik, Madico, V-Kool, and more.
        That means we recommend the right film for your project — not whichever brand we happen to carry.
        Every installation is backed by a manufacturer warranty.
      </p>
    </div>
  </section>

  <!-- ══ 4. FEATURED BRANDS BENTO ══ -->
  <BentoGridPhoto
    heading="Brands we trust. Films we spec."
    sub="Every manufacturer we carry has earned its place — certified installer programs, rigorous testing, and long-term warranty backing."
    items={bentoItems}
  />

  <!-- ══ 5. BRAND DEEP DIVES — ACCORDION ══ -->
  <section class="prod-accordion">
    <div class="prod-accordion__head">
      <p class="eyebrow">FLAGSHIP BRANDS</p>
      <h2 class="prod-accordion__title">The four brands we spec most.</h2>
      <p class="prod-accordion__sub">Click any brand to see why we recommend it — and what it's built for.</p>
    </div>
    <AccordionVertical items={accordionItems} />
  </section>

  <!-- ══ 6. ALL BRANDS LOGO CLOUD ══ -->
  <section id="all-brands" class="prod-logocloud">
    <LogoCloudBlurFlip
      heading="Complete manufacturer lineup"
      sub="Every brand we install — click any logo to explore its full product line."
      items={allBrands}
    />
  </section>

  <!-- ══ 7. TESTIMONIALS ══ -->
  <TestimonialMarquee />

  <!-- ══ 8. FAQ ══ -->
  <section class="prod-faq">
    <div class="prod-faq__head">
      <p class="eyebrow">COMMON QUESTIONS</p>
      <h2 class="prod-faq__title">Window film brand FAQ</h2>
    </div>
    <AccordionFAQ items={faqItems} />
  </section>

  <!-- ══ 9. CTA ══ -->
  <CTATintSlider
    heading="Find your perfect tint."
    sub="Drag to preview how window film tames Philadelphia heat and glare — then get it installed for real."
    ctaText="Get a Free Quote"
    ctaHref="/contact/"
  />

  <!-- ══ 10. MOBILE STICKY CTA ══ -->
  <MobileStickyCTA phone="(267) 394-7980" quoteHref="/contact/" />

  <ScrollReveal />

</BaseLayout>

<style>
  /* ── Map UI-library variables → site tokens ── */
  :root {
    --ink:         var(--dark-bg);
    --brand-green: var(--green);
    --cream:       var(--off-white);
    --slate:       #1c2e20;
  }

  /* ── Intro band ── */
  .prod-intro {
    background: var(--off-white);
    padding: 5rem 1.5rem;
    text-align: center;
  }
  .prod-intro__inner { max-width: 44rem; margin: 0 auto; }
  .prod-intro__heading {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--dark-bg);
    font-weight: 700;
    margin: 0 0 1.25rem;
  }
  .prod-intro__body {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--muted);
    margin: 0;
  }

  /* ── Accordion section wrapper ── */
  .prod-accordion {
    background: var(--dark-bg);
    padding: 5rem 1.5rem;
  }
  .prod-accordion__head {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 3rem;
  }
  .prod-accordion__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    color: #fff;
    font-weight: 700;
    margin: 0.5rem 0 0.6rem;
  }
  .prod-accordion__sub {
    color: rgba(255,255,255,0.55);
    font-size: 0.95rem;
    margin: 0;
  }

  /* ── Logo cloud anchor ── */
  .prod-logocloud { scroll-margin-top: 80px; }

  /* ── FAQ section ── */
  .prod-faq {
    background: var(--off-white);
    padding: 5rem 1.5rem;
  }
  .prod-faq__head {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2.5rem;
  }
  .prod-faq__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    color: var(--dark-bg);
    font-weight: 700;
    margin: 0.5rem 0 0;
  }
</style>
