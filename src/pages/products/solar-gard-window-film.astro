const heroImage = '/images/solar-gard-window-film-philadelphia-hero.jpg';
const serviceUrl = 'https://windowfilmphiladelphia.net/products/solar-gard-window-film/';

const pageSchemas = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://windowfilmphiladelphia.net/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://windowfilmphiladelphia.net/products/" },
    { "@type": "ListItem", "position": 3, "name": "Solar Gard Window Film", "item": "https://windowfilmphiladelphia.net/products/solar-gard-window-film/" }
