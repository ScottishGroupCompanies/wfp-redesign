/* ══ TINT SLIDER CTA ══ */
.sg-tint-cta { position: relative; overflow: hidden; min-height: 580px; display: flex; align-items: center; justify-content: center; }
.sg-tint-cta__bg { position: absolute; inset: 0; background-size: cover; background-position: center; transition: filter .05s; }
.sg-tint-cta__darken { position: absolute; inset: 0; background: rgba(10,20,5,0); pointer-events: none; transition: background .05s; }
.sg-tint-cta__content { position: relative; z-index: 2; text-align: center; padding: 80px 24px; max-width: 680px; width: 100%; }
.sg-tint-cta__title { font-family: var(--font-serif,'Playfair Display',serif); font-size: clamp(36px,5vw,64px); font-weight: 700; color: #fff; line-height: 1.05; margin: 0 0 16px; text-shadow: 0 2px 24px rgba(0,0,0,.4); }
.sg-tint-cta__subtitle { font-family: var(--font-body,'DM Sans',sans-serif); font-size: 17px; color: rgba(255,255,255,.88); line-height: 1.65; margin: 0 0 40px; text-shadow: 0 1px 8px rgba(0,0,0,.5); }
.sg-tint-cta__controls { display: flex; align-items: center; gap: 14px; background: rgba(0,0,0,.38); backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,.18); border-radius: 999px; padding: 14px 22px; margin: 0 0 16px; }
.sg-tint-cta__label { font-family: var(--font-body,'DM Sans',sans-serif); font-size: 12px; font-weight: 800; letter-spacing: .12em; color: rgba(255,255,255,.7); white-space: nowrap; }
.sg-tint-cta__range { flex: 1; -webkit-appearance: none; appearance: none; height: 4px; border-radius: 2px; background: rgba(255,255,255,.3); outline: none; cursor: pointer; }
.sg-tint-cta__range::-webkit-slider-thumb { -webkit-appearance: none; width: 26px; height: 26px; border-radius: 50%; background: var(--green,#81AB4C); border: 3px solid #fff; box-shadow: 0 2px 12px rgba(0,0,0,.4); cursor: grab; transition: transform .15s; }
.sg-tint-cta__range::-webkit-slider-thumb:hover { transform: scale(1.15); }
.sg-tint-cta__range::-moz-range-thumb { width: 26px; height: 26px; border-radius: 50%; background: var(--green,#81AB4C); border: 3px solid #fff; cursor: grab; }
.sg-tint-cta__vlt { font-family: var(--font-body,'DM Sans',sans-serif); font-size: 14px; color: rgba(255,255,255,.72); margin: 0 0 36px; letter-spacing: .02em; }
.sg-tint-cta__vlt strong { color: #fff; font-size: 18px; font-weight: 800; }
.sg-tint-cta__btn { display: inline-flex; align-items: center; gap: 8px; padding: 16px 36px; border-radius: 999px; background: var(--green,#81AB4C); color: #fff; font-family: var(--font-body,'DM Sans',sans-serif); font-weight: 700; font-size: 16px; text-decoration: none; transition: background .2s, transform .2s, box-shadow .2s; box-shadow: 0 4px 24px rgba(129,171,76,.4); }
.sg-tint-cta__btn:hover { background: #6e9640; transform: translateY(-3px); box-shadow: 0 8px 32px rgba(129,171,76,.5); }
@media (max-width: 600px) { .sg-tint-cta { min-height: 520px; } .sg-tint-cta__controls { padding: 12px 16px; } }
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));

  // ── Slider ──
  (function initM3Slider() {
    const track = document.getElementById('sgTrack');
    const slides = document.querySelectorAll('.sg-slider__slide');
    const navItems = document.querySelectorAll('[data-sgnav]');
    const prevBtn = document.getElementById('sgPrev');
    const nextBtn = document.getElementById('sgNext');
    const progressBar = document.getElementById('sgProgressBar');
    if (!track || !slides.length) return;
    let current = 0;
    const total = slides.length;

    function goTo(i) {
      if (i < 0) i = total - 1;
      if (i >= total) i = 0;
      current = i;
      track.style.transform = `translateX(-${current * 100}%)`;
      navItems.forEach((n, idx) => n.classList.toggle('sg-slider__nav-item--active', idx === current));
      slides.forEach((s, idx) => s.classList.toggle('sg-active', idx === current));
      if (progressBar) {
        progressBar.style.transition = 'none';
        progressBar.style.width = '0';
        setTimeout(() => { progressBar.style.transition = 'width 6s linear'; progressBar.style.width = '100%'; }, 50);
      }
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    navItems.forEach((n, i) => n.addEventListener('click', () => goTo(i)));

    document.querySelectorAll('.sg-slider__faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const slide = btn.closest('.sg-slider__slide');
        slide.querySelectorAll('.sg-slider__faq-q').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          const a = b.nextElementSibling; if (a) a.hidden = true;
        });
        if (!expanded) {
          btn.setAttribute('aria-expanded', 'true');
          const a = btn.nextElementSibling; if (a) a.hidden = false;
        }
      });
    });

    let timer = setInterval(() => goTo(current + 1), 6000);
    document.getElementById('sgSlider')?.addEventListener('mouseenter', () => clearInterval(timer));
    document.getElementById('sgSlider')?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 6000); });
    goTo(0);
  })();

  document.querySelectorAll('.sg-faq__item').forEach(item => {
    item.querySelector('.sg-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('sg-faq__item--open');
      document.querySelectorAll('.sg-faq__item').forEach(i => i.classList.remove('sg-faq__item--open'));
      if (!isOpen) item.classList.add('sg-faq__item--open');
    });
  });

  // ══ TINT SLIDER ══
  (() => {
    const range = document.getElementById('sgTintRange');
    const overlay = document.getElementById('sgTintOverlay');
    const vltEl = document.getElementById('sgTintVlt');
    const filmEl = document.getElementById('sgTintFilm');
    if (!range) return;
    // v=0 (left) = clearest, v=100 (right) = darkest (limo)
    // VLT: clear ~90% down to limo ~5%
    // v=0 (left, CLEAR) = no tint; v=100 (right, LIMO) = darkest
    const films = [
      { minV: 0,  maxV: 15,  name: 'Clear',       vlt: 90 },
      { minV: 15, maxV: 30,  name: 'Solar Gard Sentinel',   vlt: 75 },
      { minV: 30, maxV: 50,  name: 'Panorama 70',  vlt: 70 },
      { minV: 50, maxV: 65,  name: 'Panorama 50',  vlt: 50 },
      { minV: 65, maxV: 80,  name: 'Panorama 35',  vlt: 35 },
      { minV: 80, maxV: 90,  name: 'Hilite 25', vlt: 24 },
      { minV: 90, maxV: 100, name: 'ArmorCoat 15', vlt: 15 },
    ];
    const update = () => {
      const v = parseInt(range.value); // 0=CLEAR (light), 100=LIMO (dark)
      const vlt = Math.round(90 - (v / 100) * 85); // 90% at CLEAR, 5% at LIMO
      const opacity = (v / 100) * 0.78;
      overlay.style.background = `rgba(10,20,5,${opacity.toFixed(3)})`;
      vltEl.textContent = vlt + '%';
      const film = films.find(f => v >= f.minV && v <= f.maxV) || films[films.length - 1];
      filmEl.textContent = film.name;
    };
    range.addEventListener('input', update);
    update();
  })();
</script>
