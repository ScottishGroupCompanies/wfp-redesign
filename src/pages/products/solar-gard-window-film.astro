  { "@context": "https://schema.org", "@type": "Product", "name": "Solar Gard Window Film Philadelphia", "description": "Solar Gard architectural window film for Philadelphia offices, healthcare, schools, and commercial properties. Panorama, Sentinel Plus, ArmorCoat, and Hilite series.", "brand": { "@type": "Brand", "name": "Solar Gard" }, "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "areaServed": "Philadelphia, PA" },  }
];

const faqItems = [
  { question: "What Solar Gard products does Window Film Philadelphia install?", answer: "Window Film Philadelphia installs the full Solar Gard commercial lineup including Panorama solar control series, Sentinel Plus energy-saving film, ArmorCoat safety and security series (4–14 mil), and Hilite glare control film. Residential specifications are also available." },
  { question: "How long does Solar Gard window film last?", answer: "Solar Gard films carry a residential limited lifetime warranty and a 15-year commercial warranty on Panorama and Sentinel Plus. ArmorCoat and Hilite carry a 12-year commercial warranty. All warranties cover film performance, adhesion, and color stability." },
  { question: "What is the difference between Solar Gard Panorama and Sentinel Plus?", answer: "Solar Gard Panorama is optimized for maximum solar heat rejection (up to 77%). Sentinel Plus is an energy-saving film with both summer solar control and year-round low-emissivity performance — better suited for facilities with LEED documentation requirements." },
  { question: "Can Solar Gard Panorama meet LEED requirements?", answer: "Yes. Solar Gard Panorama and Sentinel Plus both carry NFRC certification covering VLT, SHGC, and U-value — the performance metrics required for LEED Energy and Atmosphere credits. We provide Panorama and Sentinel Plus technical data sheets, installation documentation, and energy modeling inputs formatted for your project’s LEED, GSA, or institutional procurement submission." },
  { question: "Does Solar Gard Panorama interfere with Wi-Fi or cellular signals?", answer: "No. The Panorama Series is non-metallized and does not attenuate Wi-Fi or cellular signals. ArmorCoat safety films may use metallized layers in heavier specifications — worth evaluating for signal-sensitive applications." },
  { question: "Can Solar Gard film be applied to double-pane insulated glass?", answer: "Yes. Solar Gard makes specific series rated for insulated glass units. Window Film Philadelphia always evaluates glass type, orientation, and age before recommending a film to ensure long-term compatibility with existing seals." },
  { question: "Is Solar Gard ArmorCoat the same as blast mitigation film?", answer: "ArmorCoat at 8–14 mil provides fragment retention and blast mitigation performance tested to ASTM F1642. For GSA TS01-2003-rated blast performance, a specific attachment system is also required. We specify and install the correct system for each facility's risk profile." },
  { question: "How does Solar Gard compare to 3M and LLumar?", answer: "Solar Gard Panorama is competitive with 3M Prestige and LLumar ATC in performance and appearance. Solar Gard's strength is in its healthcare and institutional track record and its ArmorCoat safety series. The right brand often comes down to specific series performance, documentation needs, and application requirements." },
  { question: "Can Solar Gard film work on historic Philadelphia glass?", answer: "Yes. Solar Gard makes residential-grade series approved for single-pane glass including wavy antique glass common in Philadelphia rowhomes. We assess glass type and condition before recommending any product." },
  { question: "How do I get Solar Gard window film installed in Philadelphia?", answer: "Contact us for a free site assessment. We evaluate your glass, orientation, energy and documentation goals, then recommend the appropriate Solar Gard series. We provide a written proposal with product specifications before any work begins." }
];

const solarGardReviews = [
  { quote: "Solar Gard Panorama on our south and west facades has measurably reduced cooling costs. The NFRC documentation was thorough and the installation was professional — minimal disruption across all 12 floors.", name: "Thomas E.", role: "Property Manager · Center City Class A Tower", img: "/images/solar-gard-testimonial-thomas-e.jpg" },
  { quote: "We needed NFRC data for our sustainability report and a product with a healthcare track record. Solar Gard Sentinel Plus delivered both. The patient comfort improvement was noticeable within weeks.", name: "Karen P.", role: "Hospital Administrator · University City", img: "/images/solar-gard-testimonial-karen-p.jpg" },
  { quote: "We installed Solar Gard ArmorCoat on our main entrance glass. The security delay documentation was exactly what our school board needed for approval. You cannot tell it's there from outside.", name: "William B.", role: "School Facilities Director · Northeast Philadelphia", img: "/images/solar-gard-testimonial-william-b.jpg" },
  { quote: "Solar Gard Panorama was the only film that met our client's dual requirements — significant solar heat rejection AND a near-neutral appearance that wouldn't change the facade aesthetics. Perfect for the project.", name: "Nicole A.", role: "Interior Designer · Rittenhouse Square", img: "/images/solar-gard-testimonial-nicole-a.jpg" },
  { quote: "The afternoon sun was brutal on my west-facing dining room. Solar Gard Hilite cut the glare completely without making the space feel dark. Customers comment on how comfortable it is now.", name: "Christopher V.", role: "Restaurant Owner · Passyunk Avenue", img: "/images/solar-gard-testimonial-christopher-v.jpg" },
  { quote: "We have a south-facing rowhouse and summer was miserable upstairs. Solar Gard Panorama residential film made the second floor livable. Energy bills dropped and we didn't have to replace any windows.", name: "The Nguyens", role: "Homeowners · South Philadelphia", img: "/images/solar-gard-testimonial-the-nguyens.jpg" }
];

const solarGardCatalogSeries = Object.values(
  solarGardProducts.reduce((groups, product) => {
    if (!groups[product.series]) {
      groups[product.series] = {
        name: product.series,
        color: product.seriesColor,
        products: [],
      };
    }
    groups[product.series].products.push(product);
    return groups;
  }, {})
);

const truncateCatalogDescription = (text) => text.length > 80 ? `${text.slice(0, 77)}...` : text;
