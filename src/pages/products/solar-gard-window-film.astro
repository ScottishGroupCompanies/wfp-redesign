<script>
  (() => {
    const track = document.getElementById('sgTrack');
    const slides = Array.from(document.querySelectorAll('.sg-slider__slide'));
    const nav = Array.from(document.querySelectorAll('[data-sgnav]'));
    const prev = document.getElementById('sgPrev');
    const next = document.getElementById('sgNext');
    const progress = document.getElementById('sgProgressBar');
    let current = 0;

    const go = (index) => {
      current = (index + slides.length) % slides.length;
      if (track) track.style.transform = `translateX(-${current * 100}%)`;
      nav.forEach((btn, i) => btn.classList.toggle('sg-slider__nav-item--active', i === current));
      if (progress) progress.style.width = `${((current + 1) / slides.length) * 100}%`;
    };

    nav.forEach((btn, i) => btn.addEventListener('click', () => go(i)));
    prev?.addEventListener('click', () => go(current - 1));
    next?.addEventListener('click', () => go(current + 1));
    go(0);

    document.querySelectorAll('.sg-slider__faq-q, .sg-faq__q').forEach((button) => {
      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        const answer = button.nextElementSibling;
        button.setAttribute('aria-expanded', String(!expanded));
        if (answer) answer.hidden = expanded;
      });
    });

    const range = document.getElementById('sgTintRange');
    const overlay = document.getElementById('sgTintOverlay');
    const vlt = document.getElementById('sgTintVlt');
    const film = document.getElementById('sgTintFilm');
    const labels = [
      ['90% VLT', 'Clear Glass'],
      ['70% VLT', 'Solar Gard Panorama 70'],
      ['50% VLT', 'Solar Gard Sentinel Plus'],
      ['35% VLT', 'Solar Gard Hilite'],
      ['5% VLT', 'Limo Tint'],
    ];

    const updateTint = () => {
      const value = Number(range?.value || 0);
      const opacity = (value / 100) * 0.78;
      const labelIndex = Math.min(labels.length - 1, Math.floor(value / 25));
      if (overlay) overlay.style.opacity = String(opacity);
      if (vlt) vlt.textContent = labels[labelIndex][0];
      if (film) film.textContent = labels[labelIndex][1];
    };

    range?.addEventListener('input', updateTint);
    updateTint();
  })();
</script>

