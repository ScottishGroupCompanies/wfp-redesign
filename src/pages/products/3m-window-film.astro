  <div class="m3-pl-row m3-pl-row--rev fade-in">
    <div class="m3-pl-row__img-wrap">
      <img
        src="/images/3m-night-vision-window-film-philadelphia.png"
        alt="Philadelphia office building exterior at dusk with 3M Night Vision reflective privacy window film on glass facade"
        width="768" height="960"
        loading="lazy"
        class="m3-pl-row__img"
