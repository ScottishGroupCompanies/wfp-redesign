.m3-slider__nav-item--active { opacity: 1; }
.m3-slider__nav-line { display: block; width: 3px; height: 32px; background: rgba(255,255,255,0.4); border-radius: 2px; transition: background 0.3s ease, height 0.3s ease; }
.m3-slider__nav-item--active .m3-slider__nav-line { background: #81AB4C; height: 48px; }
.m3-slider__nav-label { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 11px; font-weight: 500; color: #fff; text-transform: uppercase; letter-spacing: 0.15em; white-space: nowrap; }
.m3-slider__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 10; width: 48px; height: 48px; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #fff; transition: background 0.3s ease, color 0.3s ease; }
.m3-slider__arrow:hover { background: rgba(0,0,0,0.6); color: #81AB4C; }
.m3-slider__arrow--prev { left: 32px; }
.m3-slider__arrow--next { right: 32px; }
.m3-slider__progress { position: absolute; bottom: 0; left: 0; width: 100%; height: 2px; background: rgba(255,255,255,0.15); z-index: 10; }
.m3-slider__progress-bar { height: 100%; background: #81AB4C; width: 0; transition: width 0.05s linear; }
@keyframes m3FadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
.m3-slider__slide.m3-active .m3-slider__content { opacity: 1; transform: translateY(0); }
.m3-slider__slide.m3-active .m3-slider__step { animation: m3FadeUp 0.4s ease 0.2s forwards; }
.m3-slider__slide.m3-active .m3-slider__title { animation: m3FadeUp 0.4s ease 0.3s forwards; }
.m3-slider__slide.m3-active .m3-slider__desc { animation: m3FadeUp 0.4s ease 0.4s forwards; }
.m3-slider__slide.m3-active .m3-slider__faq { animation: m3FadeUp 0.4s ease 0.5s forwards; }
.m3-slider__slide.m3-active .m3-slider__cta { animation: m3FadeUp 0.4s ease 0.6s forwards; }
@media (max-width: 1024px) { .m3-slider__nav { right: 32px; } .m3-slider__content { padding-left: 60px; } }
@media (max-width: 768px) { .m3-slider__nav { display: none; } .m3-slider__content { padding-left: 5%; padding-right: 5%; max-width: 100%; } .m3-slider__arrow--prev { left: 20px; } .m3-slider__arrow--next { right: 20px; } }

/* ── FEATURED SECTIONS ── */
/* ── PRODUCT LINES (m3-products) ── */
.m3-products {
  padding: 100px 10%;
  background: var(--off-white, #F7F6F3);
}
.m3-products__hd {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 80px;
}
.m3-products__title {
  font-family: var(--font-head, 'DM Serif Display', Georgia, serif);
  font-size: clamp(28px, 3vw, 42px);
  color: var(--dark, #1a1a1a);
  margin: 8px 0 16px;
  line-height: 1.15;
}
.m3-products__sub {
  font-size: 15px;
  color: var(--text-mid, #555);
  line-height: 1.6;
  margin: 0;
}

/* Each alternating row */
.m3-pl-row {
  display: grid;
  grid-template-columns: 420px 1fr;
  gap: 64px;
  align-items: start;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: 48px;
  box-shadow: 0 2px 16px rgba(0,0,0,0.06);
}
.m3-pl-row:last-child { margin-bottom: 0; }
.m3-pl-row--rev { direction: rtl; }
.m3-pl-row--rev > * { direction: ltr; }

/* Image side */
.m3-pl-row__img-wrap {
  position: relative;
  height: 100%;
  min-height: 480px;
}
.m3-pl-row__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.m3-pl-row__pill {
  position: absolute;
  top: 20px;
  left: 20px;
  background: var(--green, #81AB4C);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 100px;
}

/* Content side */
.m3-pl-row__content {
  padding: 52px 52px 52px 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.m3-pl-row--rev .m3-pl-row__content {
  padding: 52px 0 52px 52px;
}
.m3-pl-row__num {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--green, #81AB4C);
  text-transform: uppercase;
  margin-bottom: 6px;
  display: block;
}
.m3-pl-row__eyebrow {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-mid, #666);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 10px;
  display: block;
}
.m3-pl-row__heading {
  font-family: var(--font-head, 'DM Serif Display', Georgia, serif);
  font-size: clamp(20px, 2vw, 28px);
  color: var(--dark, #1a1a1a);
  line-height: 1.2;
  margin: 0 0 20px;
}
.m3-pl-row__body {
  font-size: 15px;
  color: var(--text-mid, #444);
  line-height: 1.7;
  margin: 0 0 16px;
}

/* Specs strip */
.m3-pl-row__specs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: var(--light-gray, #E8E8E4);
  border: 1px solid var(--light-gray, #E8E8E4);
  border-radius: 10px;
  overflow: hidden;
  margin: 8px 0 28px;
}
.m3-pl-row__spec {
  background: var(--off-white, #F7F6F3);
  padding: 16px 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.m3-pl-row__spec-val {
  font-family: var(--font-head, 'DM Serif Display', Georgia, serif);
  font-size: 22px;
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
}
.m3-pl-row__spec-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--text-mid, #666);
  text-align: center;
}

/* PDF links */
.m3-pl-row__pdfs {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.m3-pl-row__pdfs-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-mid, #888);
}
.m3-pl-row__pdf-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.m3-pl-row__pdf-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  font-weight: 500;
  color: var(--green, #81AB4C);
  text-decoration: none;
  transition: color 0.18s;
}
.m3-pl-row__pdf-link:hover { color: var(--dark, #1a1a1a); }
.m3-pl-row__pdf-link svg { flex-shrink: 0; opacity: 0.7; }
.m3-pl-row__warranty-note {
  font-size: 11px;
  color: var(--text-mid, #999);
  margin: 10px 0 0;
  font-style: italic;
}

/* Responsive */
@media (max-width: 900px) {
  .m3-pl-row {
    grid-template-columns: 1fr;
  }
  .m3-pl-row--rev { direction: ltr; }
  .m3-pl-row__img-wrap { min-height: 280px; }
  .m3-pl-row__content { padding: 36px 28px; }
  .m3-pl-row--rev .m3-pl-row__content { padding: 36px 28px; }
  .m3-pl-row__specs { grid-template-columns: repeat(2, 1fr); }
}

/* Keep old pp-featured CSS for fallback (can remove later) */
.pp-featured {
  padding: 100px 10%;
  background: var(--off-white, #F7F6F3);
}
.pp-featured__hd { margin-bottom: 72px; }
.pp-featured__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
}
.pp-feat-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
  margin-bottom: 100px;
}
.pp-feat-row:last-child { margin-bottom: 0; }
.pp-feat-row--rev .pp-feat-row__img { order: 2; }
.pp-feat-row--rev .pp-feat-row__content { order: 1; }
.pp-feat-row__img {
  position: relative;
  height: 480px;
  border-radius: 32px;
  overflow: hidden;
}
.pp-feat-row__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.pp-feat-row__pill {
  position: absolute; bottom: 24px; left: 24px;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(8px);
  padding: 10px 18px;
  border-radius: 100px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px; font-weight: 600;
  color: var(--brand, #272E32);
  box-shadow: 0 4px 16px rgba(0,0,0,0.1);
}
.pp-feat-row__num {
  display: block;
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 72px; font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1; opacity: 0.25;
  margin-bottom: -8px;
}
.pp-feat-row__heading {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  line-height: 1.2;
  margin-bottom: 20px;
  letter-spacing: -0.3px;
}
.pp-feat-row__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.8;
  margin-bottom: 28px;
}
.pp-feat-row__cta {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; font-weight: 600;
  color: var(--green, #81AB4C);
  text-decoration: none;
  transition: gap 0.2s;
}
.pp-feat-row__cta:hover { gap: 14px; }

/* ── PRODUCT GRID (dark) ── */
.pp-why {
  background: var(--brand, #272E32);
  padding: 100px 10%;
}
.pp-why__hd { margin-bottom: 64px; }
.pp-why__hd .pp-eyebrow { color: var(--green, #81AB4C); }
.pp-why__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.15;
  letter-spacing: -0.5px;
  margin: 0;
  max-width: 600px;
}
.pp-why__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}
.pp-why__item {
  padding: 32px 28px;
  border-right: 1px solid rgba(255,255,255,0.1);
  border-bottom: 1px solid rgba(255,255,255,0.1);
}
.pp-why__item:nth-child(4n) { border-right: none; }
.pp-why__item:nth-child(n+5) { border-bottom: none; }
.pp-why__icon {
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
  display: flex; align-items: center; line-height: 1;
}
.pp-why__icon svg { display: block; }
.pp-why__divider {
  width: 32px; height: 2px;
  background: var(--green, #81AB4C);
  margin-bottom: 16px;
}
.pp-why__item-title {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; font-weight: 700;
  color: #ffffff;
  margin-bottom: 6px;
}
.pp-why__item-sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  color: rgba(255,255,255,0.5);
  margin: 0; line-height: 1.5;
}

/* ── FAQ - two-column split ── */
.m3-faq {
  background: #ffffff;
  padding: 96px 0;
}
.m3-faq__inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 6%;
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 80px;
  align-items: start;
}
.m3-eyebrow {
  display: block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}
.m3-faq__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(24px, 2.5vw, 36px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 16px;
}
.m3-faq__header p {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  line-height: 1.75;
  color: var(--text-mid, #4a4a4a);
  margin: 0 0 24px;
}
.m3-faq__cta-btn {
  display: inline-flex;
  align-items: center;
  background: var(--green, #81AB4C);
  color: #fff;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  padding: 13px 28px;
  border-radius: 100px;
  transition: background 0.25s, transform 0.2s;
}
.m3-faq__cta-btn:hover { background: #6a9240; transform: translateY(-1px); }
.m3-faq__item {
  border-bottom: 1px solid var(--light-gray, #EFEFED);
  padding: 20px 0;
}
.m3-faq__item:first-of-type { border-top: 1px solid var(--light-gray, #EFEFED); }
.m3-faq__q {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 600;
  color: var(--text-dark, #1a1a1a);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  cursor: pointer;
  padding: 3px 0;
}
.m3-faq__toggle {
  color: var(--green, #81AB4C);
  font-size: 22px;
  flex-shrink: 0;
  font-weight: 400;
  transition: transform 0.2s;
  line-height: 1;
}
.m3-faq__a {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.8;
  margin-top: 10px;
  display: none;
}
.m3-faq__item--open .m3-faq__a { display: block; }
.m3-faq__item--open .m3-faq__toggle { transform: rotate(45deg); }
.m3-faq__a p { margin: 0; }

/* ── CTA - cinematic ── */
.m3-cinematic-cta {
  position: relative;
  min-height: 560px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.m3-cinematic-cta__media {
  position: absolute;
  inset: 0;
  background-image: url('/images/3m-window-film-philadelphia-cta.jpg');
  background-size: cover;
  background-position: center;
}
.m3-cinematic-cta__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(13,26,15,0.88) 0%, rgba(46,107,48,0.72) 40%, rgba(13,26,15,0.88) 100%);
}
.m3-cinematic-cta__vignette {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, rgba(13,26,15,0.15) 0%, rgba(13,26,15,0.6) 100%);
}
.m3-cinematic-cta__content {
  position: relative;
  z-index: 10;
  max-width: 760px;
  padding: 80px 24px;
  text-align: center;
}
.m3-cinematic-cta__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(2rem, 4.5vw, 3.25rem);
  font-weight: 700;
  color: #F3F6F1;
  margin-bottom: 20px;
  line-height: 1.1;
  letter-spacing: -0.02em;
}
.m3-cinematic-cta__title em { font-style: italic; color: #9ecf5a; }
.m3-cinematic-cta__text {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: clamp(0.95rem, 1.8vw, 1.1rem);
  color: rgba(243,246,241,0.82);
  max-width: 620px;
  margin: 0 auto 40px;
  line-height: 1.75;
}
.m3-cinematic-cta__actions {
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
}
.m3-cinematic-cta__btn-primary {
  display: inline-flex;
  align-items: center;
  background: #7CB342;
  color: #fff;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 1rem;
  font-weight: 600;
  text-decoration: none;
  padding: 16px 36px;
  border-radius: 100px;
  border: 2px solid #7CB342;
  transition: background 0.25s, border-color 0.25s, transform 0.2s, box-shadow 0.25s;
}
.m3-cinematic-cta__btn-primary:hover {
  background: #6aa032;
  border-color: #6aa032;
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(124,179,66,0.35);
}
.m3-cinematic-cta__btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(8px);
  color: #F3F6F1;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 1rem;
  font-weight: 600;
  text-decoration: none;
  padding: 14px 28px;
  border-radius: 100px;
  border: 2px solid rgba(255,255,255,0.3);
  transition: background 0.25s, border-color 0.25s, transform 0.2s;
}
.m3-cinematic-cta__btn-secondary:hover {
  background: rgba(255,255,255,0.12);
  border-color: rgba(124,179,66,0.6);
  transform: translateY(-2px);
}

/* ── FADE IN ── */
.fade-in { opacity: 0; transform: translateY(24px); transition: opacity 0.65s ease, transform 0.65s ease; }
.fade-in.visible { opacity: 1; transform: translateY(0); }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .pp-intro__inner { grid-template-columns: 1fr; gap: 40px; }
  .pp-feat-row { grid-template-columns: 1fr; gap: 40px; }
  .pp-feat-row--rev .pp-feat-row__img { order: 0; }
  .pp-feat-row--rev .pp-feat-row__content { order: 1; }
  .pp-why__grid { grid-template-columns: repeat(2, 1fr); }
  .pp-why__item:nth-child(4n) { border-right: 1px solid rgba(255,255,255,0.1); }
  .pp-why__item:nth-child(2n) { border-right: none; }
}
@media (max-width: 768px) {
  .pp-intro { padding: 60px 5%; }
  .pp-featured { padding: 60px 5%; }
  .pp-why { padding: 60px 5%; }
  .pp-feat-row__img { height: 300px; }
  .pp-why__grid { grid-template-columns: 1fr; }
  .m3-faq__inner { grid-template-columns: 1fr; gap: 40px; }
  .m3-cinematic-cta__actions { flex-direction: column; align-items: center; }
  .m3-cinematic-cta__btn-primary, .m3-cinematic-cta__btn-secondary { width: 100%; max-width: 320px; justify-content: center; }
}
@media (max-width: 480px) {
  .pp-intro__ctas { flex-direction: column; }
}

/* ══ APPLICATIONS GRID wrapper ══ */
.m3-apps { padding: 100px 10%; background: #fff; }
.m3-apps__hd { margin-bottom: 52px; }
.m3-apps__title { font-family: var(--font-serif,'Playfair Display',serif); font-size: clamp(28px,3.5vw,44px); font-weight: 700; color: var(--text-dark,#1a1a1a); line-height: 1.15; margin: 0 0 12px; }
.m3-apps__sub { font-family: var(--font-body,'DM Sans',sans-serif); font-size: 16px; color: var(--text-mid,#4a4a4a); line-height: 1.7; max-width: 620px; }
@media (max-width: 600px) { .m3-apps { padding: 60px 5%; } }

/* ══ TINT SLIDER CTA ══ */
.m3-tint-cta { position: relative; overflow: hidden; min-height: 580px; display: flex; align-items: center; justify-content: center; }
.m3-tint-cta__bg { position: absolute; inset: 0; background-size: cover; background-position: center; transition: filter .05s; }
.m3-tint-cta__darken { position: absolute; inset: 0; background: rgba(10,20,5,0); pointer-events: none; transition: background .05s; }
.m3-tint-cta__content { position: relative; z-index: 2; text-align: center; padding: 80px 24px; max-width: 680px; width: 100%; }
.m3-tint-cta__title { font-family: var(--font-serif,'Playfair Display',serif); font-size: clamp(36px,5vw,64px); font-weight: 700; color: #fff; line-height: 1.05; margin: 0 0 16px; text-shadow: 0 2px 24px rgba(0,0,0,.4); }
.m3-tint-cta__subtitle { font-family: var(--font-body,'DM Sans',sans-serif); font-size: 17px; color: rgba(255,255,255,.88); line-height: 1.65; margin: 0 0 40px; text-shadow: 0 1px 8px rgba(0,0,0,.5); }
.m3-tint-cta__controls { display: flex; align-items: center; gap: 14px; background: rgba(0,0,0,.38); backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,.18); border-radius: 999px; padding: 14px 22px; margin: 0 0 16px; }
.m3-tint-cta__label { font-family: var(--font-body,'DM Sans',sans-serif); font-size: 12px; font-weight: 800; letter-spacing: .12em; color: rgba(255,255,255,.7); white-space: nowrap; }
.m3-tint-cta__range { flex: 1; -webkit-appearance: none; appearance: none; height: 4px; border-radius: 2px; background: rgba(255,255,255,.3); outline: none; cursor: pointer; }
.m3-tint-cta__range::-webkit-slider-thumb { -webkit-appearance: none; width: 26px; height: 26px; border-radius: 50%; background: var(--green,#81AB4C); border: 3px solid #fff; box-shadow: 0 2px 12px rgba(0,0,0,.4); cursor: grab; transition: transform .15s; }
.m3-tint-cta__range::-webkit-slider-thumb:hover { transform: scale(1.15); }
.m3-tint-cta__range::-moz-range-thumb { width: 26px; height: 26px; border-radius: 50%; background: var(--green,#81AB4C); border: 3px solid #fff; cursor: grab; }
.m3-tint-cta__vlt { font-family: var(--font-body,'DM Sans',sans-serif); font-size: 14px; color: rgba(255,255,255,.72); margin: 0 0 36px; letter-spacing: .02em; }
.m3-tint-cta__vlt strong { color: #fff; font-size: 18px; font-weight: 800; }
.m3-tint-cta__btn { display: inline-flex; align-items: center; gap: 8px; padding: 16px 36px; border-radius: 999px; background: var(--green,#81AB4C); color: #fff; font-family: var(--font-body,'DM Sans',sans-serif); font-weight: 700; font-size: 16px; text-decoration: none; transition: background .2s, transform .2s, box-shadow .2s; box-shadow: 0 4px 24px rgba(129,171,76,.4); }
.m3-tint-cta__btn:hover { background: #6e9640; transform: translateY(-3px); box-shadow: 0 8px 32px rgba(129,171,76,.5); }
@media (max-width: 600px) { .m3-tint-cta { min-height: 520px; } .m3-tint-cta__controls { padding: 12px 16px; } }
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));

  // ── Slider ──
  (function initM3Slider() {
    const track = document.getElementById('m3Track');
    const slides = document.querySelectorAll('.m3-slider__slide');
    const navItems = document.querySelectorAll('[data-m3nav]');
    const prevBtn = document.getElementById('m3Prev');
    const nextBtn = document.getElementById('m3Next');
    const progressBar = document.getElementById('m3ProgressBar');
    if (!track || !slides.length) return;
    let current = 0;
    const total = slides.length;

    function goTo(i) {
      if (i < 0) i = total - 1;
      if (i >= total) i = 0;
      current = i;
      track.style.transform = `translateX(-${current * 100}%)`;
      navItems.forEach((n, idx) => n.classList.toggle('m3-slider__nav-item--active', idx === current));
      slides.forEach((s, idx) => s.classList.toggle('m3-active', idx === current));
      if (progressBar) {
        progressBar.style.transition = 'none';
        progressBar.style.width = '0';
        setTimeout(() => { progressBar.style.transition = 'width 6s linear'; progressBar.style.width = '100%'; }, 50);
      }
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    navItems.forEach((n, i) => n.addEventListener('click', () => goTo(i)));

    document.querySelectorAll('.m3-slider__faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const slide = btn.closest('.m3-slider__slide');
        slide.querySelectorAll('.m3-slider__faq-q').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          const a = b.nextElementSibling; if (a) a.hidden = true;
        });
        if (!expanded) {
          btn.setAttribute('aria-expanded', 'true');
          const a = btn.nextElementSibling; if (a) a.hidden = false;
        }
      });
    });

    let timer = setInterval(() => goTo(current + 1), 6000);
    document.getElementById('m3Slider')?.addEventListener('mouseenter', () => clearInterval(timer));
    document.getElementById('m3Slider')?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 6000); });
    goTo(0);
  })();

  document.querySelectorAll('.m3-faq__item').forEach(item => {
    item.querySelector('.m3-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('m3-faq__item--open');
      document.querySelectorAll('.m3-faq__item').forEach(i => i.classList.remove('m3-faq__item--open'));
      if (!isOpen) item.classList.add('m3-faq__item--open');
    });
  });

  // ══ TINT SLIDER ══
  (() => {
    const range = document.getElementById('tintRange');
    const overlay = document.getElementById('tintOverlay');
    const vltEl = document.getElementById('tintVlt');
    const filmEl = document.getElementById('tintFilm');
    if (!range) return;
    // v=0 (left) = clearest, v=100 (right) = darkest (limo)
    // VLT: clear ~90% down to limo ~5%
    // v=0 (left, CLEAR) = no tint; v=100 (right, LIMO) = darkest
    const films = [
      { minV: 0,  maxV: 15,  name: 'Clear — No Film',       vlt: 90 },
      { minV: 15, maxV: 30,  name: '3M Thinsulate CC75',   vlt: 75 },
      { minV: 30, maxV: 50,  name: '3M Sun Control PR70',  vlt: 70 },
      { minV: 50, maxV: 65,  name: '3M Sun Control PR50',  vlt: 50 },
      { minV: 65, maxV: 80,  name: '3M Sun Control PR35',  vlt: 35 },
      { minV: 80, maxV: 90,  name: '3M Night Vision NV25', vlt: 24 },
      { minV: 90, maxV: 100, name: '3M Night Vision NV15', vlt: 15 },
    ];
    const update = () => {
      const v = parseInt(range.value); // 0=CLEAR (light), 100=LIMO (dark)
      const vlt = Math.round(90 - (v / 100) * 85); // 90% at CLEAR, 5% at LIMO
      const opacity = (v / 100) * 0.78;
      overlay.style.background = `rgba(10,20,5,${opacity.toFixed(3)})`;
      vltEl.textContent = vlt + '%';
      const film = films.find(f => v >= f.minV && v <= f.maxV) || films[films.length - 1];
      filmEl.textContent = film.name;
    };
    range.addEventListener('input', update);
    update();
  })();
</script>
