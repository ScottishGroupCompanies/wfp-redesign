<!-- ══════════════════════════════════════
     SECTION 2 — INTRO + TRUST BAR
     ══════════════════════════════════════ -->
<section class="m3-intro">
  <div class="m3-intro__inner">

    <div class="m3-intro__image-col">
      <div class="m3-intro__image-wrap">
        <img
          src="/images/3m-window-film-philadelphia-intro.jpg"
          alt="3M certified installer applying window film to a Philadelphia row home window"
          width="600"
          height="720"
          loading="lazy"
          class="m3-intro__img"
        />
        <div class="m3-intro__badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.27L12 14.54l-5.62 3.96 2.09-6.27L3 8.26h6.91L12 2z" fill="#81AB4C"/></svg>
          <span>3M Authorized Installer</span>
        </div>
      </div>
    </div>

    <div class="m3-intro__content">
      <span class="m3-intro__eyebrow">Why 3M &amp; Window Film Philadelphia</span>
      <h2 class="m3-intro__title">The World's Most Researched Window Film. Installed by Philadelphia's Most Trusted Team.</h2>
      <p class="m3-intro__lead">3M invented the category. Their window film engineers have spent decades refining solar control, safety, insulation, and decorative film technology — backed by the same R&amp;D infrastructure behind 3M Post-its, Scotch tape, and aerospace adhesives. That matters when you're choosing a film that will perform on your glass for 15–20 years.</p>
      <p class="m3-intro__body">Window Film Philadelphia is an authorized 3M dealer and installer. That means we carry the full lineup — not just a subset — and every installation is backed by a manufacturer-issued warranty, not just a contractor's word. From a single rowhome window to a Center City high-rise, we spec, install, and warrant 3M film the way 3M requires.</p>
      <div class="m3-intro__creds">
        <div class="m3-intro__cred">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#81AB4C" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#81AB4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          3M Authorized Installer
        </div>
        <div class="m3-intro__cred">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#81AB4C" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#81AB4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Licensed &amp; Insured
        </div>
        <div class="m3-intro__cred">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#81AB4C" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#81AB4C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Serving Philadelphia Since 2008
        </div>
      </div>
      <div class="m3-intro__ctas">
        <a href="/contact/" class="pp-btn pp-btn--primary">Get a Free Quote</a>
        <a href="tel:2673947980" class="pp-btn pp-btn--ghost">Call (267) 394-7980</a>
      </div>
