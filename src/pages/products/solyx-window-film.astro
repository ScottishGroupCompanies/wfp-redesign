---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlipWords from '../../components/FlipWords.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import CountUp from '../../components/animations/CountUp.astro';
import TestimonialMarquee from '../../components/TestimonialMarquee.astro';

const title = 'Solyx Window Film Philadelphia | Decorative & Privacy';
const description = 'Solyx window film in Philadelphia for decorative privacy, frosted glass, gradient, solar control, and safety film. Authorized Solyx installer.';

const faqItems = [
  {
    question: 'What is Solyx window film?',
    answer: 'Solyx is a specialty window film brand by Decorative Films, LLC offering over 700 designs across decorative, privacy, solar control, and safety film categories. Window Film Philadelphia is an authorized Solyx installer serving residential and commercial properties throughout Philadelphia.'
  },
  {
    question: 'What makes Solyx different from other window film brands in Philadelphia?',
    answer: 'Solyx is built around the broadest decorative and specialty film library in the category — over 700 patterns across Geometric and Organic collections, plus functional solar and safety films. Where most brands focus primarily on solar control, Solyx is the right choice when design, privacy, and glass aesthetics matter as much as performance.'
  },
  {
    question: 'Does Solyx make solar control film or just decorative film?',
    answer: 'Solyx makes both. The SOLYX® UltraCool series includes solar control films with IR blocking and UV protection for heat and glare management. The UltraSafe series provides safety and security glass retention films. These functional lines pair with Solyx decorative and frosted products for comprehensive glass treatment solutions in Philadelphia properties.'
  },
  {
    question: 'What is the difference between Solyx Frosted and Gradient film?',
    answer: 'Solyx Frosted Privacy Films provide a consistent opacity across the entire glass surface — like etched or sandblasted glass. Gradient Films transition from frosted to clear across a single panel, typically frosted at the top for seated privacy and clear at the bottom to preserve sightlines. Gradient is popular for Philadelphia conference rooms and open-plan office partitions.'
  },
  {
    question: 'Can Solyx film be used in a Philadelphia rowhome bathroom?',
    answer: 'Yes. Solyx Frosted Privacy Films are among the most popular applications for Philadelphia rowhome bathrooms, sidelights, and street-facing ground-floor windows. They provide full visual privacy while allowing natural light to pass through — without changing the character of the window from the exterior.'
  },
  {
    question: 'Are Solyx decorative pattern films permanent?',
    answer: 'Solyx decorative films are semi-permanent — they use pressure-sensitive adhesive that holds firmly through normal use but can be removed when needed. This makes them a practical choice for leased Philadelphia commercial spaces where permanent modifications may not be permitted, and for properties where branding or design may evolve over time.'
  },
  {
    question: 'What is UltraCool-IR8360 and is it right for Philadelphia summers?',
    answer: 'UltraCool-IR8360 is a Nano Ceramic polyester solar control film engineered for spectrally selective IR blocking. It targets infrared heat while allowing visible light through, reducing solar heat gain without a dark or reflective appearance. For Philadelphia\'s west- and south-facing office and residential glass, it is a practical solar upgrade with a high-clarity result.'
  },
  {
    question: 'Can Solyx UltraSafe film protect Philadelphia retail against smash-and-grab?',
    answer: 'Solyx UltraSafe Safety Films hold broken glass together after impact, which slows forced entry and reduces the risk of injury from flying shards. Available in 2, 4, and 8 mil clear construction, UltraSafe is installed on interior glass surfaces at Philadelphia retail storefronts, schools, and commercial properties where glass retention is a priority. It delays entry — it does not make glass unbreakable.'
  },
  {
    question: 'Does Solyx work on double-pane or single-pane windows in Philadelphia?',
    answer: 'Solyx decorative and frosted films are generally suitable for both single-pane and double-pane glass when applied to the interior surface. For solar control films on insulated glass units, compatibility depends on the specific film and glass construction. Window Film Philadelphia assesses glass type and orientation before recommending a film to ensure compatibility and long-term performance.'
  },
  {
    question: 'How does Window Film Philadelphia install Solyx decorative film?',
    answer: 'Our team performs a site assessment to evaluate glass type, dimensions, and the installation environment. Solyx films are applied wet to the interior glass surface using professional-grade squeegees and soapy water solution, then trimmed to fit and smoothed flat. Decorative and frosted films are typically dry to the touch within a few hours, with full adhesion reached within a few days.'
  }
];

const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": "https://windowfilmphiladelphia.net/products/solyx-window-film/#breadcrumb",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://windowfilmphiladelphia.net/products/" },
      { "@type": "ListItem", "position": 3, "name": "Solyx Window Film in Philadelphia", "item": "https://windowfilmphiladelphia.net/products/solyx-window-film/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://windowfilmphiladelphia.net/products/solyx-window-film/#webpage",
    "url": "https://windowfilmphiladelphia.net/products/solyx-window-film/",
    "name": "Solyx Window Film Philadelphia | Decorative & Privacy",
    "description": "Solyx window film in Philadelphia for decorative privacy, frosted glass, gradient, solar control, and safety film. Authorized Solyx installer.",
    "dateModified": new Date().toISOString().slice(0, 10),
    "isPartOf": { "@type": "WebSite", "@id": "https://windowfilmphiladelphia.net/#website", "url": "https://windowfilmphiladelphia.net/", "name": "Window Film Philadelphia" },
    "breadcrumb": { "@id": "https://windowfilmphiladelphia.net/products/solyx-window-film/#breadcrumb" },
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".sx-hero__subtitle", ".sx-why__intro", ".sx-faq__a"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Solyx Window Film Products Available in Philadelphia",
    "description": "SOLYX® window film lineup installed in Philadelphia by an authorized dealer.",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "SOLYX® Frosted Privacy Films", "description": "Frosted and etched-look window films for Philadelphia rowhome bathrooms, sidelights, office partitions, and street-facing glass. Full visual privacy with natural light diffusion." },
      { "@type": "ListItem", "position": 2, "name": "SOLYX® Decorative Pattern Films", "description": "Over 700 Geometric and Organic designs for Philadelphia offices, hotel lobbies, retail storefronts, and healthcare interiors. Custom cut-to-size and made-to-size available." },
      { "@type": "ListItem", "position": 3, "name": "SOLYX® Gradient Films", "description": "Single and dual direction gradient fading films that transition from frosted to clear. Popular for Philadelphia conference room glass walls and open-plan office partitions." },
      { "@type": "ListItem", "position": 4, "name": "SOLYX® UltraCool Solar Films", "description": "Nano Ceramic polyester solar control films with spectrally selective IR blocking and UV protection. Available in silver, bronze, blue, and ceramic options for Philadelphia residential and commercial glass." },
      { "@type": "ListItem", "position": 5, "name": "SOLYX® UltraSafe Safety Films", "description": "2, 4, and 8 mil clear safety films for glass retention and forced-entry delay. Applied to Philadelphia retail storefronts, schools, and commercial buildings." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Solyx Window Film — Window Film Philadelphia",
    "description": "SOLYX® window film installed by Window Film Philadelphia. Authorized Solyx installer serving residential and commercial properties throughout Philadelphia.",
    "brand": { "@type": "Brand", "name": "Solyx by Decorative Films, LLC" },
  }
];
---

<BaseLayout title={title} description={description} canonical="https://windowfilmphiladelphia.net/products/solyx-window-film/" schemas={pageSchemas} faqItems={faqItems}>

