    <h1 class="sx-hero__title">Solyx Window Film<br class="sx-hero__br"/> in Philadelphia</h1>

    <p class="sx-hero__animated-line">
      Design-forward film for
      <FlipWords
        words={["Philadelphia Offices", "Rowhome Windows", "Conference Rooms", "Medical Suites", "Hotel Lobbies", "Retail Storefronts"]}
