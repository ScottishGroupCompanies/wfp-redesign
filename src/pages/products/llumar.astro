    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === current));
      nav.forEach((button, i) => button.classList.toggle('is-active', i === current));
      if (progress) progress.style.width = `${((current + 1) / slides.length) * 100}%`;
    };
    nav.forEach((button) => button.addEventListener('click', () => show(Number(button.dataset.llnav || 0))));
    prev?.addEventListener('click', () => show(current - 1));
    next?.addEventListener('click', () => show(current + 1));
    show(0);
  })();

  (() => {
    const range = document.getElementById('llTintRange') as HTMLInputElement | null;
    const overlay = document.getElementById('llTintOverlay') as HTMLElement | null;
    const vlt = document.getElementById('llTintVlt') as HTMLElement | null;
    const film = document.getElementById('llTintFilm') as HTMLElement | null;
    if (!range || !overlay || !vlt || !film) return;
    const update = () => {
      const value = Number(range.value);
      overlay.style.opacity = String(value * 0.0078);
      vlt.textContent = `${Math.max(5, 100 - value)}%`;
      film.textContent = value > 70 ? 'LLumar reflective privacy' : value > 38 ? 'LLumar ATC medium tint' : 'LLumar ATC neutral series';
    };
    range.addEventListener('input', update);
    update();
  })();
</script>
