    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".ll-hero__title", ".ll-why__intro"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "LLumar Window Film Products — Philadelphia",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "LLumar ATC Solar Control Series", "description": "Non-metallized spectrally selective solar control film. Rejects up to 74% solar energy, 99% UV block, VLT 20–70%. No Wi-Fi interference." },
      { "@type": "ListItem", "position": 2, "name": "LLumar Low-E Climate Control", "description": "Year-round low-emissivity film. Summer solar rejection + winter heat retention. Near-clear at 74% VLT. Ideal for single-pane rowhomes." },
      { "@type": "ListItem", "position": 3, "name": "LLumar Safety & Security Series", "description": "4–8 mil polyester fragment retention and forced entry delay film. For retail, schools, and commercial properties." },
      { "@type": "ListItem", "position": 4, "name": "LLumar Reflective Privacy Series", "description": "Metallized daytime privacy film. VLT 15–50%, heat rejection up to 71%. For offices, restaurants, and residential." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "LLumar Window Film Philadelphia",
    "description": "LLumar architectural window film for Philadelphia offices, rowhomes, retail, and commercial properties. ATC solar control, Low-E insulating, Safety, and Reflective Privacy series.",
    "brand": { "@type": "Brand", "name": "LLumar" },
    "offers": { "@type": "Offer", "availability": "https://schema.org/InStock", "areaServed": "Philadelphia, PA" },
  }
];
