        <div class="ll-pl-row__spec"><span class="ll-pl-row__spec-val">70%</span><span class="ll-pl-row__spec-label">Max VLT</span></div>
        <div class="ll-pl-row__spec"><span class="ll-pl-row__spec-val">15yr</span><span class="ll-pl-row__spec-label">Commercial Warranty</span></div>
