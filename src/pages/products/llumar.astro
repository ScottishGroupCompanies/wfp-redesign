    name: 'LLumar Window Film Philadelphia',
    brand: { '@type': 'Brand', name: 'LLumar' },
    description,
    aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '67' },
    review: [
      {
        '@type': 'Review',
        author: { '@type': 'Person', name: 'Jennifer M.' },
