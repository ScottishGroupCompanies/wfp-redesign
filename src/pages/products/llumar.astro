        <CountUp end={74} suffix="%" label="Max Heat Rejection" />
        <CountUp end={99} suffix="%" label="UV Blocked" />
        <CountUp end={20} suffix="yr" label="Residential Warranty" />
        <CountUp end={4} suffix="A" label="Philadelphia Climate" />
      </div>
    </div>
  </section>

  <main class="ll-page">
    <section class="ll-intro">
      <div class="ll-wrap ll-split">
        <div class="ll-intro__media">
