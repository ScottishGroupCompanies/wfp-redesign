import llumarProducts from '../../data/llumar-products.json';

const title = 'LLumar Window Film Philadelphia | Authorized Dealer';
const description = 'LLumar window film Philadelphia — ATC solar control, low-e, safety & privacy film. Authorized LLumar dealer, manufacturer warranty.';
const heroImage = '/images/llumar-window-film-philadelphia-hero.jpg';
const serviceUrl = 'https://windowfilmphiladelphia.net/products/llumar/';

const faqItems = [
  { question: "What LLumar window film products does Window Film Philadelphia install?", answer: "Window Film Philadelphia installs the full LLumar commercial lineup including the ATC solar control series, Low-E climate control film, Safety and Security series (4–8 mil), Reflective Privacy series, and decorative film options. Both residential and commercial specifications are available." },
  { question: "How long does LLumar window film last?", answer: "LLumar films carry a residential limited lifetime warranty and a 15-year commercial warranty on solar control products. Safety films carry a 12-year commercial warranty. All warranties cover film performance, adhesion, and color stability." },
  { question: "What is the difference between LLumar ATC and Low-E film?", answer: "LLumar ATC is primarily a solar control product optimized for summer heat rejection. LLumar Low-E is a year-round film that also retains indoor heat in winter — the better choice for Philadelphia's four-season climate and older single-pane glass." },
  { question: "Can LLumar film be applied to double-pane insulated glass?", answer: "Yes. LLumar makes film series specifically rated for insulated glass units (IGUs). Selecting the wrong film for double-pane glass can cause thermal stress. Window Film Philadelphia always evaluates glass type and orientation before recommending a film." },
  { question: "Is LLumar film the same as Vista film?", answer: "Both LLumar and Vista are Eastman Performance Films brands manufactured on the same platform with shared R&D. LLumar targets commercial architectural applications; Vista is positioned as the premium design-forward line. The products differ in specific series and aesthetics." },
  { question: "Does LLumar ATC film interfere with Wi-Fi or cellular signals?", answer: "No. The ATC Series is non-metallized, so it does not attenuate Wi-Fi or cellular signals — an important advantage in Philadelphia's dense commercial buildings. The Reflective Privacy Series uses a metallized coating and may affect signal in high-glass-density facades." },
  { question: "Will LLumar film qualify for LEED or energy credits?", answer: "Several LLumar products — including the ATC and Low-E series — carry NFRC-certified VLT, SHGC, and U-value ratings required for LEED Energy and Atmosphere credit documentation. We provide ATC and Low-E product data sheets, pre/post energy modeling inputs, and installation records organized for your credit submission package." },
  { question: "Can LLumar window film work on historic Philadelphia glass?", answer: "Yes. LLumar makes specific residential series approved for single-pane glass including the wavy antique glass common in Philadelphia rowhomes. We assess glass type, age, and condition before recommending a product to ensure long-term compatibility." },
  { question: "How does LLumar film compare to 3M?", answer: "Both LLumar and 3M produce high-quality architectural window film. LLumar's ATC Series is comparable in performance to 3M's Prestige Series. The choice between brands often comes down to specific series performance, aesthetic preferences, and warranty terms for your application. We carry both." },
  { question: "How do I get LLumar window film installed in Philadelphia?", answer: "Contact us for a free site assessment. We evaluate your glass, orientation, and goals, then recommend the appropriate LLumar series for each area of your building. We provide written specifications and a proposal before any work begins." }
];

