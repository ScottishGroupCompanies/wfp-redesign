  { quote: "We needed a film that would work across both our old rowhome-style buildings and modern glass office additions. LLumar gave us one consistent product spec that worked on both. The energy performance has been measurable.", name: "David S.", role: "Facilities Director · University City Campus", img: "/images/llumar-testimonial-david-s.jpg" },
  { quote: "Our 1920s rowhome has beautiful original windows we'd never replace. The LLumar Low-E film has made a noticeable difference in winter — the drafty feeling near the glass is gone. I wish we'd done it years ago.", name: "Sarah K.", role: "Homeowner · Germantown", img: "/images/llumar-testimonial-sarah-k.jpg" },
  { quote: "I needed security film after a break-in on the block. The LLumar safety film was installed quickly and you genuinely cannot tell it's there. That peace of mind is worth it.", name: "Marcus T.", role: "Retail Owner · Old City", img: "/images/llumar-testimonial-marcus-t.jpg" },
  { quote: "We were able to document LLumar's NFRC ratings for our LEED submittal. The product data sheets were thorough and the installation team knew exactly what documentation we'd need.", name: "Rachel W.", role: "Sustainability Manager · Market Street", img: "/images/llumar-testimonial-rachel-w.jpg" },
  { quote: "The LLumar installation in our lobby and restaurant glass improved the space noticeably — less heat, better ambiance, and guests have commented on the improvement to the views.", name: "Robert H.", role: "Hotel General Manager · Center City", img: "/images/llumar-testimonial-robert-h.jpg" }
];

const llumarCatalogSeries = Object.values(
  llumarProducts.reduce((groups, product) => {
    if (!groups[product.series]) {
      groups[product.series] = {
        name: product.series,
        color: product.seriesColor,
        products: [],
      };
    }
    groups[product.series].products.push(product);
    return groups;
  }, {})
);

const truncateCatalogDescription = (text) => text.length > 80 ? `${text.slice(0, 77)}...` : text;

const pageSchemas = [
