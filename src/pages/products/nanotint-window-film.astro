  </div>
</section>

<div class="ip-page-body">

<!-- ══════════════════════════════════════
     SECTION 2 - INTRO + TRUST BAR
     ══════════════════════════════════════ -->
<section class="nt-intro">
  <div class="nt-intro__inner">

    <div class="nt-intro__image-col">
      <div class="nt-intro__image-wrap">
        <img
          src="/images/nanotint-window-film-philadelphia-intro.jpg"
          alt="Certified NanoTint installer applying liquid coating to specialty Philadelphia glass"
          title="NanoTint liquid coating installation Philadelphia"
          width="600"
          height="720"
          loading="lazy"
          class="nt-intro__img"
        />
        <div class="nt-intro__badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.27L12 14.54l-5.62 3.96 2.09-6.27L3 8.26h6.91L12 2z" fill="#81AB4C"/></svg>
          <span>Certified NanoTint Installer</span>
