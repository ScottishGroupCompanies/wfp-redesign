---
/* Hallmark · redesign · macrostructure: numbered-alternating-rows · tone: professional-editorial
 * template: benefits.astro · anchor hue: green (#81AB4C) */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlipWords from '../../components/FlipWords.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import CountUp from '../../components/animations/CountUp.astro';
import TestimonialMarquee from '../../components/TestimonialMarquee.astro';

const title = 'NanoTint Window Film Philadelphia | DryWired Liquid';
const description = 'NanoTint window film in Philadelphia for curved glass, skylights, UV block, heat reduction, and specialty surfaces traditional film cannot cover.';

const faqItems = [
  { question: 'What is Liquid NanoTint and how is it different from window film?', answer: 'Liquid NanoTint is a DryWired nanotechnology coating, not an adhesive film. It is applied as a liquid and cures into a hard, optically clear coating bonded to the glass surface, which lets it work on curved glass, skylights, acrylic, polycarbonate, and other surfaces where peel-and-stick film cannot bond properly.' },
  { question: 'Can NanoTint be applied to curved glass and skylights?', answer: 'Yes. Curved glass and skylights are the main reason Philadelphia property owners choose NanoTint. Because it is brushed, rolled, or sprayed on as a liquid, it can follow domes, arches, curved bay windows, atriums, and angled skylights that traditional film cannot cover.' },
  { question: 'Does NanoTint work on polycarbonate and acrylic?', answer: 'Yes. DryWired offers NanoTint options for polycarbonate, acrylic, plastic, and specialty non-glass surfaces, including greenhouse panels, polycarbonate skylights, acrylic partitions, and selected marine glazing.' },
  { question: 'Is NanoTint optically clear or does it tint the glass?', answer: 'Liquid NanoTint Clear is designed to remain optically clear with near-full visible light transmission. NanoTint Color versions are available in light, medium, and dark options when a project needs visible tint, glare control, or a lower visible light level.' },
  { question: 'Can NanoTint be applied to the exterior of a window?', answer: 'Yes. NanoTint can be specified for interior or exterior glass surfaces depending on the substrate, exposure, access, and project requirements. Exterior application is especially useful on skylights, roof glass, and specialty glazing where interior access is limited.' },
  { question: 'Does NanoTint affect Wi-Fi, GPS, or cellular signals?', answer: 'No. NanoTint is radio and signal transparent, so it does not create the GPS, cellular, Wi-Fi, or access-control interference that can occur with some metallic films.' },
  { question: 'What UV and heat protection does NanoTint provide?', answer: 'Liquid NanoTint blocks 99%+ of ultraviolet radiation and significantly reduces infrared heat transmission while keeping the clear version visually neutral. It is commonly used to protect artwork, furnishings, flooring, merchandise, and occupants from UV exposure.' },
  { question: 'How long does NanoTint last and does it have a warranty?', answer: 'NanoTint cures into a hard, durable coating bonded to the surface. Warranty terms depend on the product version, surface type, application side, and site conditions, so Window Film Philadelphia reviews those details during the site assessment.' },
  { question: 'What Philadelphia building types use NanoTint?', answer: 'NanoTint is used on historic rowhomes, brownstones, curved bay windows, arched glass, museum skylights, healthcare atriums, university buildings, commercial curtain wall, greenhouse panels, and marine glass around Penn\'s Landing.' },
  { question: 'Who installs NanoTint in Philadelphia?', answer: 'Window Film Philadelphia installs NanoTint window film in Philadelphia as a certified NanoTint installer for residential, commercial, institutional, historic, and specialty glass projects.' }
];

const nanotintReviews = [
  { quote: "Our skylights were destroying the artwork below. Film installers all said they couldn't help with curved glass. NanoTint was the first solution that actually worked.", name: 'Diana M.', role: 'Museum Operations Director, Philadelphia', img: '/images/nanotint-testimonial-diana.jpg' },
  { quote: 'I have bay windows with curved glass — every film company I called turned me down. NanoTint went on in a single afternoon. UV problem solved.', name: 'Robert K.', role: 'Homeowner, Chestnut Hill', img: '/images/nanotint-testimonial-robert.jpg' },
  { quote: "I specify NanoTint on any project with curved glazing, atriums, or polycarbonate panels. It's the only product that handles what film can't.", name: 'Jennifer L.', role: 'Architect, Philadelphia', img: '/images/nanotint-testimonial-jennifer.jpg' }
];

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': 'https://www.windowfilmphiladelphia.net/products/nanotint-window-film/#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.windowfilmphiladelphia.net/products/' },
      { '@type': 'ListItem', position: 3, name: 'NanoTint Window Film Philadelphia', item: 'https://www.windowfilmphiladelphia.net/products/nanotint-window-film/' }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://www.windowfilmphiladelphia.net/products/nanotint-window-film/#webpage',
    url: 'https://www.windowfilmphiladelphia.net/products/nanotint-window-film/',
    name: title,
    description,
    dateModified: new Date().toISOString().slice(0, 10),
    isPartOf: { '@type': 'WebSite', '@id': 'https://www.windowfilmphiladelphia.net/#website', url: 'https://www.windowfilmphiladelphia.net/', name: 'Window Film Philadelphia' },
    breadcrumb: { '@id': 'https://www.windowfilmphiladelphia.net/products/nanotint-window-film/#breadcrumb' },
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.nt-hero__subtitle', '.nt-why__intro', '.nt-faq__a'] }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'DryWired Liquid NanoTint Products Available in Philadelphia',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Liquid NanoTint Clear', description: 'Optically clear liquid nanotechnology coating with 99%+ UV block, infrared heat reduction, and interior or exterior application on glass, curved glass, plastic, acrylic, and polycarbonate.' },
      { '@type': 'ListItem', position: 2, name: 'NanoTint Curved Glass', description: 'Liquid NanoTint specified for curved architectural glass, skylights, domes, arched glass, automobile glass, marine glass, and angled specialty glazing.' },
      { '@type': 'ListItem', position: 3, name: 'NanoTint Specialty', description: 'NanoTint options for polycarbonate, acrylic, greenhouse panels, partitions, marine glass, and specialty non-glass surfaces where adhesive film cannot bond.' }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'DryWired Liquid NanoTint Window Film Installation in Philadelphia',
    brand: { '@type': 'Brand', name: 'DryWired Liquid NanoTint' },
    description: 'Liquid nanotechnology coating installed by Window Film Philadelphia for curved glass, skylights, polycarbonate, acrylic, and specialty surfaces.',
    aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '38' },
    review: nanotintReviews.map((review) => ({
      '@type': 'Review',
      reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
      author: { '@type': 'Person', name: review.name },
      reviewBody: review.quote
    }))
  }
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/products/nanotint-window-film/" schemas={pageSchemas} faqItems={faqItems}>

