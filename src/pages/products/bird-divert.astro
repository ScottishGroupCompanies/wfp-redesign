  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.bd-pl-row__pill {
  position: absolute;
  top: 20px;
  left: 20px;
  background: var(--green, #81AB4C);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 100px;
}

/* Content side */
.bd-pl-row__content {
  padding: 52px 52px 52px 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.bd-pl-row--rev .bd-pl-row__content {
  padding: 52px 0 52px 52px;
}
.bd-pl-row__num {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--green, #81AB4C);
  text-transform: uppercase;
  margin-bottom: 6px;
  display: block;
}
.bd-pl-row__eyebrow {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-mid, #666);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 10px;
  display: block;
}
.bd-pl-row__heading {
  font-family: var(--font-head, 'DM Serif Display', Georgia, serif);
  font-size: clamp(20px, 2vw, 28px);
  color: var(--dark, #1a1a1a);
  line-height: 1.2;
  margin: 0 0 20px;
}
.bd-pl-row__body {
  font-size: 15px;
  color: var(--text-mid, #444);
  line-height: 1.7;
  margin: 0 0 16px;
}

/* Specs strip */
.bd-pl-row__specs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: var(--light-gray, #E8E8E4);
  border: 1px solid var(--light-gray, #E8E8E4);
  border-radius: 10px;
  overflow: hidden;
  margin: 8px 0 28px;
}
.bd-pl-row__spec {
  background: var(--off-white, #F7F6F3);
  padding: 16px 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.bd-pl-row__spec-val {
  font-family: var(--font-head, 'DM Serif Display', Georgia, serif);
  font-size: 22px;
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
}
.bd-pl-row__spec-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--text-mid, #666);
  text-align: center;
}

/* PDF links */
.bd-pl-row__pdfs {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.bd-pl-row__pdfs-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-mid, #888);
}
.bd-pl-row__pdf-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.bd-pl-row__pdf-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  font-weight: 500;
  color: var(--green, #81AB4C);
  text-decoration: none;
  transition: color 0.18s;
}
.bd-pl-row__pdf-link:hover { color: var(--dark, #1a1a1a); }
.bd-pl-row__pdf-link svg { flex-shrink: 0; opacity: 0.7; }
.bd-pl-row__warranty-note {
  font-size: 11px;
  color: var(--text-mid, #999);
  margin: 10px 0 0;
  font-style: italic;
}

/* Responsive */
@media (max-width: 900px) {
  .bd-pl-row {
    grid-template-columns: 1fr;
  }
  .bd-pl-row--rev { direction: ltr; }
  .bd-pl-row__img-wrap { min-height: 280px; }
  .bd-pl-row__content { padding: 36px 28px; }
  .bd-pl-row--rev .bd-pl-row__content { padding: 36px 28px; }
  .bd-pl-row__specs { grid-template-columns: repeat(2, 1fr); }
}

/* ══════════════════════════════════════
   3M PRODUCT CATALOG
══════════════════════════════════════ */
.bd-catalog {
  padding: 80px 0;
  background: #0d0d0d;
}
.bd-catalog__inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 24px;
}
.bd-catalog__hd {
  text-align: center;
  margin-bottom: 56px;
}
.bd-catalog__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  color: #fff;
  margin: 12px 0 16px;
  letter-spacing: 0;
}
.bd-catalog__sub {
  color: rgba(255,255,255,0.6);
  font-size: 1rem;
