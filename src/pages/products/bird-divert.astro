<!-- ══ WHY ══ -->
<section class="bd-why">
  <div class="bd-why__container">
    <div class="bd-why__image-wrap">
      <img src="/images/bird-divert-window-film-philadelphia-why.jpg"
        alt="Philadelphia office interior with bird-safe UV film on floor-to-ceiling glass, birds visible safely flying past outside"
