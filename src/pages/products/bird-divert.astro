}
.pp-feat-row__cta:hover { gap: 14px; }

/* ── PRODUCT GRID (dark) ── */
.pp-why {
  background: var(--brand, #272E32);
  padding: 100px 10%;
}
.pp-why__hd { margin-bottom: 64px; }
.pp-why__hd .pp-eyebrow { color: var(--green, #81AB4C); }
.pp-why__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.15;
  letter-spacing: -0.5px;
  margin: 0;
  max-width: 600px;
}
.pp-why__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}
.pp-why__item {
  padding: 32px 28px;
  border-right: 1px solid rgba(255,255,255,0.1);
  border-bottom: 1px solid rgba(255,255,255,0.1);
}
.pp-why__item:nth-child(4n) { border-right: none; }
.pp-why__item:nth-child(n+5) { border-bottom: none; }
.pp-why__icon {
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
  display: flex; align-items: center; line-height: 1;
}
.pp-why__icon svg { display: block; }
.pp-why__divider {
  width: 32px; height: 2px;
  background: var(--green, #81AB4C);
  margin-bottom: 16px;
}
.pp-why__item-title {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; font-weight: 700;
  color: #ffffff;
  margin-bottom: 6px;
}
.pp-why__item-sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  color: rgba(255,255,255,0.5);
  margin: 0; line-height: 1.5;
}

/* ── FAQ - two-column split ── */
.bd-faq {
  background: #ffffff;
  padding: 96px 0;
}
.bd-faq__inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 6%;
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 80px;
  align-items: start;
}
.bd-eyebrow {
  display: block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}
.bd-faq__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(24px, 2.5vw, 36px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 16px;
}
.bd-faq__header p {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  line-height: 1.75;
  color: var(--text-mid, #4a4a4a);
  margin: 0 0 24px;
}
.bd-faq__cta-btn {
  display: inline-flex;
  align-items: center;
  background: var(--green, #81AB4C);
  color: #fff;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  padding: 13px 28px;
  border-radius: 100px;
  transition: background 0.25s, transform 0.2s;
}
.bd-faq__cta-btn:hover { background: #6a9240; transform: translateY(-1px); }
.bd-faq__item {
  border-bottom: 1px solid var(--light-gray, #EFEFED);
  padding: 20px 0;
}
.bd-faq__item:first-of-type { border-top: 1px solid var(--light-gray, #EFEFED); }
.bd-faq__q {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 600;
  color: var(--text-dark, #1a1a1a);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  cursor: pointer;
  padding: 3px 0;
}
.bd-faq__toggle {
  color: var(--green, #81AB4C);
  font-size: 22px;
  flex-shrink: 0;
  font-weight: 400;
  transition: transform 0.2s;
  line-height: 1;
}
.bd-faq__a {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.8;
  margin-top: 10px;
  display: none;
}
.bd-faq__item--open .bd-faq__a { display: block; }
.bd-faq__item--open .bd-faq__toggle { transform: rotate(45deg); }
.bd-faq__a p { margin: 0; }

/* ── CTA - cinematic ── */
.bd-cinematic-cta {
  position: relative;
  min-height: 560px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.bd-cinematic-cta__media {
  position: absolute;
  inset: 0;
  background-image: url('/images/3m-window-film-philadelphia-cta.jpg');
  background-size: cover;
  background-position: center;
}
.bd-cinematic-cta__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(13,26,15,0.88) 0%, rgba(46,107,48,0.72) 40%, rgba(13,26,15,0.88) 100%);
}
.bd-cinematic-cta__vignette {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, rgba(13,26,15,0.15) 0%, rgba(13,26,15,0.6) 100%);
}
.bd-cinematic-cta__content {
  position: relative;
  z-index: 10;
  max-width: 760px;
  padding: 80px 24px;
  text-align: center;
}
.bd-cinematic-cta__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(2rem, 4.5vw, 3.25rem);
  font-weight: 700;
  color: #F3F6F1;
  margin-bottom: 20px;
  line-height: 1.1;
  letter-spacing: -0.02em;
}
.bd-cinematic-cta__title em { font-style: italic; color: #9ecf5a; }
.bd-cinematic-cta__text {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: clamp(0.95rem, 1.8vw, 1.1rem);
  color: rgba(243,246,241,0.82);
  max-width: 620px;
  margin: 0 auto 40px;
  line-height: 1.75;
}
.bd-cinematic-cta__actions {
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
}
.bd-cinematic-cta__btn-primary {
  display: inline-flex;
  align-items: center;
  background: #7CB342;
  color: #fff;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 1rem;
  font-weight: 600;
  text-decoration: none;
  padding: 16px 36px;
  border-radius: 100px;
  border: 2px solid #7CB342;
  transition: background 0.25s, border-color 0.25s, transform 0.2s, box-shadow 0.25s;
}
.bd-cinematic-cta__btn-primary:hover {
  background: #6aa032;
  border-color: #6aa032;
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(124,179,66,0.35);
}
.bd-cinematic-cta__btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(8px);
  color: #F3F6F1;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 1rem;
  font-weight: 600;
  text-decoration: none;
  padding: 14px 28px;
  border-radius: 100px;
  border: 2px solid rgba(255,255,255,0.3);
  transition: background 0.25s, border-color 0.25s, transform 0.2s;
}
.bd-cinematic-cta__btn-secondary:hover {
  background: rgba(255,255,255,0.12);
  border-color: rgba(124,179,66,0.6);
  transform: translateY(-2px);
}

/* ── FADE IN ── */
.fade-in { opacity: 0; transform: translateY(24px); transition: opacity 0.65s ease, transform 0.65s ease; }
.fade-in.visible { opacity: 1; transform: translateY(0); }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .pp-intro__inner { grid-template-columns: 1fr; gap: 40px; }
  .pp-feat-row { grid-template-columns: 1fr; gap: 40px; }
  .pp-feat-row--rev .pp-feat-row__img { order: 0; }
  .pp-feat-row--rev .pp-feat-row__content { order: 1; }
  .pp-why__grid { grid-template-columns: repeat(2, 1fr); }
  .pp-why__item:nth-child(4n) { border-right: 1px solid rgba(255,255,255,0.1); }
  .pp-why__item:nth-child(2n) { border-right: none; }
}
@media (max-width: 768px) {
  .pp-intro { padding: 60px 5%; }
  .pp-featured { padding: 60px 5%; }
  .pp-why { padding: 60px 5%; }
  .pp-feat-row__img { height: 300px; }
  .pp-why__grid { grid-template-columns: 1fr; }
  .bd-faq__inner { grid-template-columns: 1fr; gap: 40px; }
  .bd-cinematic-cta__actions { flex-direction: column; align-items: center; }
  .bd-cinematic-cta__btn-primary, .bd-cinematic-cta__btn-secondary { width: 100%; max-width: 320px; justify-content: center; }
}
@media (max-width: 480px) {
  .pp-intro__ctas { flex-direction: column; }
}



/* ══ TINT SLIDER CTA ══ */
.bd-tint-cta { position: relative; overflow: hidden; min-height: 580px; display: flex; align-items: center; justify-content: center; }
.bd-tint-cta__bg { position: absolute; inset: 0; background-size: cover; background-position: center; transition: filter .05s; }
.bd-tint-cta__darken { position: absolute; inset: 0; background: rgba(10,20,5,0); pointer-events: none; transition: background .05s; }
.bd-tint-cta__content { position: relative; z-index: 2; text-align: center; padding: 80px 24px; max-width: 680px; width: 100%; }
.bd-tint-cta__title { font-family: var(--font-serif,'Playfair Display',serif); font-size: clamp(36px,5vw,64px); font-weight: 700; color: #fff; line-height: 1.05; margin: 0 0 16px; text-shadow: 0 2px 24px rgba(0,0,0,.4); }
.bd-tint-cta__subtitle { font-family: var(--font-body,'DM Sans',sans-serif); font-size: 17px; color: rgba(255,255,255,.88); line-height: 1.65; margin: 0 0 40px; text-shadow: 0 1px 8px rgba(0,0,0,.5); }
.bd-tint-cta__controls { display: flex; align-items: center; gap: 14px; background: rgba(0,0,0,.38); backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,.18); border-radius: 999px; padding: 14px 22px; margin: 0 0 16px; }
.bd-tint-cta__label { font-family: var(--font-body,'DM Sans',sans-serif); font-size: 12px; font-weight: 800; letter-spacing: .12em; color: rgba(255,255,255,.7); white-space: nowrap; }
.bd-tint-cta__range { flex: 1; -webkit-appearance: none; appearance: none; height: 4px; border-radius: 2px; background: rgba(255,255,255,.3); outline: none; cursor: pointer; }
.bd-tint-cta__range::-webkit-slider-thumb { -webkit-appearance: none; width: 26px; height: 26px; border-radius: 50%; background: var(--green,#81AB4C); border: 3px solid #fff; box-shadow: 0 2px 12px rgba(0,0,0,.4); cursor: grab; transition: transform .15s; }
.bd-tint-cta__range::-webkit-slider-thumb:hover { transform: scale(1.15); }
.bd-tint-cta__range::-moz-range-thumb { width: 26px; height: 26px; border-radius: 50%; background: var(--green,#81AB4C); border: 3px solid #fff; cursor: grab; }
.bd-tint-cta__vlt { font-family: var(--font-body,'DM Sans',sans-serif); font-size: 14px; color: rgba(255,255,255,.72); margin: 0 0 36px; letter-spacing: .02em; }
.bd-tint-cta__vlt strong { color: #fff; font-size: 18px; font-weight: 800; }
.bd-tint-cta__btn { display: inline-flex; align-items: center; gap: 8px; padding: 16px 36px; border-radius: 999px; background: var(--green,#81AB4C); color: #fff; font-family: var(--font-body,'DM Sans',sans-serif); font-weight: 700; font-size: 16px; text-decoration: none; transition: background .2s, transform .2s, box-shadow .2s; box-shadow: 0 4px 24px rgba(129,171,76,.4); }
.bd-tint-cta__btn:hover { background: #6e9640; transform: translateY(-3px); box-shadow: 0 8px 32px rgba(129,171,76,.5); }
