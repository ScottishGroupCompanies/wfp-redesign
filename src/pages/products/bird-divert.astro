}
.bd-catalog__card-body {
  padding: 14px 16px 18px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
}
.bd-catalog__card-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #fff;
  padding: 2px 8px;
  border-radius: 4px;
  align-self: flex-start;
}
.bd-catalog__card-name {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 0.95rem;
  font-weight: 700;
  color: #fff;
  margin: 0;
  line-height: 1.3;
  letter-spacing: 0;
}
.bd-catalog__card-desc {
  font-size: 0.8rem;
  color: rgba(255,255,255,0.5);
  margin: 0;
  line-height: 1.5;
}
@media (max-width: 768px) {
  .bd-catalog { padding: 48px 0; }
  .bd-catalog__grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
  .bd-catalog__card-img { height: 120px; }
}

/* Keep old pp-featured CSS for fallback (can remove later) */
.pp-featured {
  padding: 100px 10%;
  background: var(--off-white, #F7F6F3);
}
.pp-featured__hd { margin-bottom: 72px; }
.pp-featured__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
}
.pp-feat-row {
