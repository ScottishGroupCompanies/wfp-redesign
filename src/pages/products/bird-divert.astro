  margin: 0 auto;
}
.bd-catalog__series {
  margin-bottom: 48px;
}
.bd-catalog__series-name {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 1rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: rgba(255,255,255,0.8);
  margin-bottom: 20px;
  padding-bottom: 12px;
