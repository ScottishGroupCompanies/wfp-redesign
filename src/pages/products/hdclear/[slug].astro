---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import products from '../../../data/hdclear-products.json';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product: p } = Astro.props;
const serviceUrl = `https://www.windowfilmphiladelphia.net/products/hdclear/${p.slug}/`;
const title = `HDClear ${p.name} | Philadelphia Installer`;
const description = `${p.shortDescription.slice(0, 150)}`;
const descriptionParagraphs = p.description.split('\n\n').slice(0, 4);
const specRows = [
  ['VLT', p.specs.vlt],
  ['UV Block', p.specs.uvBlock],
  ['Fire Rating', p.specs.fireRating],
  ['Max Width', p.specs.width],
  ['Warranty', p.specs.warranty],
  ['Series', p.series],
  ['Brand', 'HDClear Film'],
].filter(([, value]) => Boolean(value));
const statChips = [
  ['UV Block', p.specs.uvBlock],
  ['Fire Rating', p.specs.fireRating],
  ['Max Width', p.specs.width],
  ['Warranty', p.specs.warranty],
].filter(([, value]) => Boolean(value));
const relatedProducts = p.relatedSlugs
  .map((slug) => products.find((item) => item.slug === slug))
  .filter(Boolean);
const categoryText = `${p.categories.join(' ')} ${p.series}`.toLowerCase();

const applications = categoryText.includes('interlayer')
  ? [
      ['Architectural Balustrades', 'Custom printed laminated glass for Philadelphia staircases, balconies, and feature balustrade panels in commercial and residential projects.'],
      ['Feature Partition Systems', 'Decorative laminated glass partition panels for Philadelphia offices, hotels, and restaurants — permanent, cleanable, and protected inside the glass.'],
      ['Skylights and Overhead Glass', 'HDLam-specified glass for Philadelphia architectural skylights where interior-facing graphics must be permanently protected within the glass unit.'],
    ]
  : categoryText.includes('removable') || categoryText.includes('short-term')
    ? [
        ['Retail Seasonal Campaigns', 'Seasonal window graphics for Philadelphia retailers on Walnut Street, Chestnut Street, and Rittenhouse Square — change-out as often as the campaign calendar requires.'],
        ['Hospitality Event Graphics', 'Event-specific glass graphics for Philadelphia restaurants, hotels, and branded venues — installed for specific promotions and removed cleanly without residue.'],
        ['Pop-Up and Temporary Retail', 'Short-term branded glass graphics for Philadelphia pop-up locations, kiosks, and temporary retail installations that need professional visual quality on a short schedule.'],
      ]
    : categoryText.includes('one-way') || categoryText.includes('hdview')
      ? [
          ['Retail Storefront Windows', 'Large-format graphics on Philadelphia storefronts — full brand imagery visible from the street while interior displays and sightlines remain unobstructed.'],
          ['Corporate Headquarters Glass', 'Exterior glass graphics for Philadelphia commercial buildings — brand presence visible from street level while interior occupants maintain full outward views.'],
          ['Restaurant and Hospitality Glass', 'Campaign or brand imagery on Philadelphia restaurant windows — exterior visual impact without blocking the interior ambiance visible from the street.'],
        ]
      : categoryText.includes('tactile') || categoryText.includes('3d')
        ? [
            ['Corporate Lobby Feature Walls', 'Tactile glass accent panels for Philadelphia corporate headquarters reception areas — premium surface treatment at a fraction of specialty architectural glass cost.'],
            ['Hospitality Interior Design', 'Raised texture decorative glass elements for Philadelphia hotels, restaurants, and branded hospitality interiors as design focal points.'],
            ['High-End Residential Glass', 'Custom 3D texture details for Philadelphia premium residential interiors — staircases, partition screens, and feature bathroom glass.'],
          ]
        : [
            ['Office Glass Partitions', 'Privacy, branding, and visual quality for Philadelphia conference rooms, sidelites, and open-plan glass office partitions.'],
            ['Retail and Hospitality Glass', 'Custom printed decorative treatments for Philadelphia storefronts, restaurant windows, hotel lobbies, and branded interior glass surfaces.'],
            ['Healthcare and Education', 'Decorative glass solutions for Philadelphia healthcare waiting areas, clinic partitions, and university campus interior glass.'],
          ];

const faqItems = [
  {
    question: `What is HDClear ${p.name} used for in Philadelphia?`,
    answer: `${p.name} is used for ${p.categories.join(', ').toLowerCase()} applications across Philadelphia offices, retail storefronts, hospitality interiors, healthcare facilities, and commercial properties. It belongs to the ${p.series} and is specified based on design intent, glass type, and application duration.`,
  },
  {
    question: `What specifications does HDClear ${p.name} offer?`,
    answer: `Key specifications include ${specRows.slice(0, 4).map(([label, value]) => `${label}: ${value}`).join('; ')}. Window Film Philadelphia confirms compatibility during the site assessment before recommending any HDClear product.`,
  },
  {
    question: `Who installs HDClear ${p.name} in Philadelphia?`,
    answer: `Window Film Philadelphia is a certified HDClear Film installer serving Philadelphia and the surrounding area. We manage design coordination, specification, and installation of all HDClear products for commercial and residential glass.`,
  },
  {
    question: `Does HDClear ${p.name} affect natural light?`,
    answer: `HDClear products use a 100% optically clear PET substrate — unprinted areas remain optically clear and light passes through normally. The printed areas vary by design density. Window Film Philadelphia walks through light transmission expectations during the design consultation.`,
  },
];

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Products', item: 'https://www.windowfilmphiladelphia.net/products/' },
      { '@type': 'ListItem', position: 3, name: 'HDClear', item: 'https://www.windowfilmphiladelphia.net/products/hdclear-window-film/' },
      { '@type': 'ListItem', position: 4, name: `HDClear ${p.name}`, item: serviceUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `HDClear ${p.name}`,
    brand: { '@type': 'Brand', name: 'HDClear Film' },
    image: `https://www.windowfilmphiladelphia.net${p.image}`,
    description: p.shortDescription,
    category: p.series,
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      areaServed: 'Philadelphia, PA',
      url: serviceUrl,
    },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={p.image}
  serviceName={`HDClear ${p.name}`}
  serviceDesc={description}
  serviceUrl={serviceUrl}
  faqItems={faqItems}
  schemas={pageSchemas}
>
  <!-- HERO -->
  <section class="hdsub-hero" style={`--hdsub-hero-image: url('${p.image}'); --hdsub-series: ${p.seriesColor};`}>
    <div class="hdsub-hero__overlay"></div>
    <div class="hdsub-hero__inner">
      <span class="hdsub-badge" style={`background:${p.seriesColor}`}>{p.series}</span>
      <h1 class="hdsub-hero__title">HDClear {p.name}</h1>
      <p class="hdsub-hero__sub">Philadelphia's certified HDClear Film installer — custom decorative and printed glass film, design coordination, and professional installation.</p>
      {statChips.length > 0 && (
        <div class="hdsub-stat-row" aria-label="Product specifications">
          {statChips.map(([label, value]) => (
            <span class="hdsub-stat"><strong>{value}</strong> {label}</span>
          ))}
        </div>
      )}
      <div class="hdsub-hero__btns">
        <a href="/contact/" class="hdsub-btn">Get a Quote</a>
        {p.pdfUrl && (
          <a href={p.pdfUrl} target="_blank" rel="noopener noreferrer" class="hdsub-btn hdsub-btn--outline">Spec Sheet PDF</a>
        )}
      </div>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="hdsub-overview fade-in">
    <div class="hdsub-overview__inner">
      <div class="hdsub-overview__image-wrap">
        <img
          src={p.image}
          alt={`HDClear ${p.name} decorative window film Philadelphia`}
          title={`HDClear ${p.name} — Philadelphia`}
          width="640"
          height="480"
          loading="lazy"
          class="hdsub-overview__image"
        />
      </div>
      <div class="hdsub-overview__content">
        <span class="hdsub-eyebrow">{p.series}</span>
        <h2>About HDClear {p.name}</h2>
        {descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <div class="hdsub-tags" aria-label="Product categories">
          {p.categories.map((category) => <span class="hdsub-tag">{category}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="hdsub-benefits fade-in">
    <div class="hdsub-section-head">
      <span class="hdsub-eyebrow hdsub-eyebrow--light">Key Benefits</span>
      <h2>What HDClear {p.name} Delivers</h2>
    </div>
    <div class="hdsub-benefits__grid">
      {p.benefits.map((benefit) => (
        <article class="hdsub-benefit">
          <span class="hdsub-benefit__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
              <path d="M12 2l4.5 4.5L21 8l-3 3 .5 5.5L12 14l-6.5 2.5L6 11 3 8l4.5-1.5L12 2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            </svg>
          </span>
          <h3>{benefit.heading}</h3>
          <p>{benefit.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- SPECS -->
  {specRows.length > 0 && (
    <section class="hdsub-specs fade-in">
      <div class="hdsub-specs__inner">
        <div class="hdsub-specs__left">
          <span class="hdsub-eyebrow">Technical Data</span>
          <h2>{p.name} Specifications</h2>
          <p>Specifications are for reference. Window Film Philadelphia confirms compatibility and design options during your consultation.</p>
          {p.pdfUrl && (
            <a href={p.pdfUrl} target="_blank" rel="noopener noreferrer" class="hdsub-pdf-link">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                <path d="M14 3H6a2 2 0 00-2 2v14a2 2 0 002 2h12a2 2 0 002-2V9l-6-6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                <path d="M14 3v6h6M12 18v-6M9 15h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              Download {p.name} Spec Sheet
            </a>
          )}
        </div>
        <table class="hdsub-specs__table">
          <tbody>
            {specRows.map(([label, value]) => (
              <tr><th>{label}</th><td>{value}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- APPLICATIONS -->
  <section class="hdsub-apps fade-in">
    <div class="hdsub-section-head">
      <span class="hdsub-eyebrow">Local Use Cases</span>
      <h2>Philadelphia Applications</h2>
    </div>
    <div class="hdsub-apps__grid">
      {applications.map(([heading, body]) => (
        <article class="hdsub-app">
          <span class="hdsub-app__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
              <path d="M4 21V5l8-3 8 3v16" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <path d="M9 21v-6h6v6M8 8h.01M12 8h.01M16 8h.01M8 12h.01M16 12h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
          <h3>{heading}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- RELATED -->
  {relatedProducts.length > 0 && (
    <section class="hdsub-related fade-in">
      <div class="hdsub-section-head">
        <span class="hdsub-eyebrow">Related Products</span>
        <h2>Other HDClear Film Options</h2>
      </div>
      <div class="hdsub-related__grid">
        {relatedProducts.map((item) => (
          <a href={`/products/hdclear/${item.slug}/`} class="hdsub-related__card">
            <img src={item.image} alt={`HDClear ${item.name} Philadelphia`} title={`HDClear ${item.name}`} width="280" height="180" loading="lazy" />
            <div class="hdsub-related__card-body">
              <span class="hdsub-related__series" style={`color:${item.seriesColor}`}>{item.series}</span>
              <h3>{item.name}</h3>
              <p>{item.shortDescription.slice(0, 100)}…</p>
            </div>
          </a>
        ))}
      </div>
      <a href="/products/hdclear-window-film/" class="hdsub-related__all">View all HDClear products →</a>
    </section>
  )}

  <!-- CTA -->
  <section class="hdsub-cta fade-in">
    <div class="hdsub-cta__inner">
      <h2>Install HDClear {p.name} in Philadelphia</h2>
      <p>Window Film Philadelphia handles design coordination, specification, and installation of all HDClear Film products across Philadelphia and the surrounding region. Contact us to discuss your project.</p>
      <a href="/contact/" class="hdsub-cta__btn">Get a Free Quote</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hdsub-hero {
    min-height: 560px;
    position: relative;
    display: grid;
    place-items: center;
    padding: 140px 24px 100px;
    background-image: var(--hdsub-hero-image);
    background-size: cover;
    background-position: center;
    color: #fff;
    overflow: hidden;
  }
  .hdsub-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,0.84), rgba(0,0,0,0.52)), rgba(0,0,0,0.3);
  }
  .hdsub-hero__inner { position: relative; width: min(1120px, 100%); z-index: 1; }
  .hdsub-badge {
    display: inline-flex; align-items: center; min-height: 28px; border-radius: 999px;
    padding: 5px 14px; color: #fff;
    font: 700 0.74rem/1 var(--font-body, 'DM Sans', sans-serif);
    letter-spacing: 0.09em; text-transform: uppercase;
  }
  .hdsub-hero__title {
    max-width: 880px; margin: 18px 0 12px; color: #fff;
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(2.6rem, 6vw, 5.4rem); line-height: 0.95; letter-spacing: 0;
  }
  .hdsub-hero__sub { max-width: 560px; margin: 0 0 22px; color: rgba(255,255,255,0.72); font-size: 1rem; line-height: 1.6; }
  .hdsub-stat-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
  .hdsub-stat {
    display: inline-flex; align-items: baseline; gap: 7px; min-height: 42px;
    border: 1px solid rgba(255,255,255,0.22); border-radius: 8px; padding: 8px 14px;
    background: rgba(0,0,0,0.34); color: rgba(255,255,255,0.72); font-size: 0.82rem;
  }
  .hdsub-stat strong { color: #fff; font-size: 1rem; }
  .hdsub-hero__btns { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .hdsub-btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 48px;
    border-radius: 6px; padding: 0 26px; background: #81AB4C; color: #fff;
    text-decoration: none; font: 800 0.92rem/1 var(--font-body, 'DM Sans', sans-serif);
    letter-spacing: 0.02em; transition: background 0.18s;
  }
  .hdsub-btn:hover { background: #6b9340; }
  .hdsub-btn--outline { background: transparent; border: 1.5px solid rgba(255,255,255,0.5); color: rgba(255,255,255,0.9); }
  .hdsub-btn--outline:hover { background: rgba(255,255,255,0.08); }
  .hdsub-eyebrow {
    display: inline-block; color: #81AB4C; font-size: 0.76rem; font-weight: 800;
    letter-spacing: 0.13em; text-transform: uppercase; margin-bottom: 10px;
  }
  .hdsub-eyebrow--light { color: rgba(255,255,255,0.55); }
  .hdsub-section-head { width: min(960px, 100%); margin: 0 auto 36px; text-align: center; }
  .hdsub-section-head h2 {
    margin: 0; color: #151515;
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(1.9rem, 3vw, 2.9rem); line-height: 1.07;
  }
  .hdsub-overview { padding: 86px 24px; background: #fff; }
  .hdsub-overview__inner {
    width: min(1180px, 100%); margin: 0 auto;
    display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 60px; align-items: center;
  }
  .hdsub-overview__image-wrap {
    border-radius: 10px; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,0.16);
    background: #111; aspect-ratio: 4/3;
  }
  .hdsub-overview__image { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hdsub-overview__content h2 {
    margin: 0 0 18px; color: #151515;
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(1.8rem, 3vw, 2.8rem); line-height: 1.08;
  }
  .hdsub-overview__content p { color: #444; line-height: 1.75; margin: 0 0 14px; }
  .hdsub-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .hdsub-tag {
    border: 1px solid #dce5d3; border-radius: 999px; padding: 6px 13px;
    color: #2f431d; background: #f6faf1; font-size: 0.8rem; font-weight: 700;
  }
  .hdsub-benefits { padding: 86px 24px; background: #161616; }
  .hdsub-benefits .hdsub-section-head h2 { color: #fff; }
  .hdsub-benefits__grid { width: min(1180px,100%); margin: 0 auto; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; }
  .hdsub-benefit { border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 28px; background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.72); }
  .hdsub-benefit__icon { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 8px; margin-bottom: 16px; background: rgba(129,171,76,0.14); color: #81AB4C; }
  .hdsub-benefit h3 { margin: 0 0 10px; color: #fff; font-family: var(--font-body,'DM Sans',sans-serif); font-size: 1.04rem; line-height: 1.3; }
  .hdsub-benefit p { margin: 0; line-height: 1.64; }
  .hdsub-specs { padding: 86px 24px; background: #fff; }
  .hdsub-specs__inner { width: min(1180px,100%); margin: 0 auto; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 60px; align-items: start; }
  .hdsub-specs__left h2 { margin: 0 0 14px; color: #151515; font-family: var(--font-serif,'Playfair Display',serif); font-size: clamp(1.8rem,3vw,2.6rem); line-height: 1.08; }
  .hdsub-specs__left p { color: #555; line-height: 1.68; margin: 0 0 20px; }
  .hdsub-pdf-link {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px;
    border: 1.5px solid #81AB4C; border-radius: 6px; color: #2f431d;
    text-decoration: none; font: 700 0.88rem/1 var(--font-body,'DM Sans',sans-serif);
    transition: background 0.18s;
  }
  .hdsub-pdf-link:hover { background: #f6faf1; }
  .hdsub-specs__table { width: 100%; border-collapse: collapse; border: 1px solid #e6e6e6; border-radius: 8px; overflow: hidden; }
  .hdsub-specs__table th, .hdsub-specs__table td { padding: 15px 18px; border-bottom: 1px solid #e6e6e6; text-align: left; vertical-align: top; }
  .hdsub-specs__table tr:last-child th, .hdsub-specs__table tr:last-child td { border-bottom: 0; }
  .hdsub-specs__table th { width: 40%; color: #222; background: #f5f7f2; font-weight: 800; font-size: 0.88rem; }
  .hdsub-specs__table td { color: #444; font-size: 0.92rem; }
  .hdsub-apps { padding: 86px 24px; background: #f4f7f0; }
  .hdsub-apps__grid { width: min(1180px,100%); margin: 0 auto; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; }
  .hdsub-app { background: #fff; border: 1px solid #dde5d5; border-radius: 10px; padding: 28px; color: #4a4a4a; }
  .hdsub-app__icon { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 8px; margin-bottom: 16px; background: rgba(129,171,76,0.1); color: #81AB4C; }
  .hdsub-app h3 { margin: 0 0 10px; color: #171717; font-family: var(--font-body,'DM Sans',sans-serif); font-size: 1.04rem; font-weight: 700; }
  .hdsub-app p { margin: 0; line-height: 1.62; }
  .hdsub-related { padding: 86px 24px; background: #fff; }
  .hdsub-related__grid { width: min(1180px,100%); margin: 0 auto; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; }
  .hdsub-related__card { display: flex; flex-direction: column; overflow: hidden; border: 1px solid #e8e8e8; border-radius: 10px; color: inherit; text-decoration: none; background: #fff; transition: transform 0.2s, border-color 0.2s; }
  .hdsub-related__card:hover { transform: translateY(-3px); border-color: #81AB4C; }
  .hdsub-related__card img { width: 100%; height: 180px; object-fit: cover; display: block; }
  .hdsub-related__card-body { padding: 16px 18px 20px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .hdsub-related__series { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .hdsub-related__card h3 { margin: 0 0 6px; color: #151515; font-family: var(--font-body,'DM Sans',sans-serif); font-size: 1.02rem; line-height: 1.3; }
  .hdsub-related__card p { margin: 0; color: #666; font-size: 0.84rem; line-height: 1.5; }
  .hdsub-related__all { display: table; margin: 30px auto 0; color: #2f431d; font-weight: 800; text-decoration: none; font-size: 0.94rem; }
  .hdsub-related__all:hover { color: #81AB4C; }
  .hdsub-cta { padding: 80px 24px; background: #81AB4C; color: #fff; }
  .hdsub-cta__inner { width: min(900px,100%); margin: 0 auto; text-align: center; }
  .hdsub-cta h2 { margin: 0 0 14px; color: #fff; font-family: var(--font-serif,'Playfair Display',serif); font-size: clamp(1.9rem,3vw,2.8rem); line-height: 1.08; }
  .hdsub-cta p { max-width: 620px; margin: 0 auto 28px; color: rgba(255,255,255,0.88); font-size: 0.97rem; line-height: 1.6; }
  .hdsub-cta__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; border-radius: 6px; padding: 0 30px; background: #111; color: #fff; text-decoration: none; font: 800 0.95rem/1 var(--font-body,'DM Sans',sans-serif); transition: background 0.18s; }
  .hdsub-cta__btn:hover { background: #2f431d; }
  @media (max-width: 900px) {
    .hdsub-overview__inner, .hdsub-specs__inner { grid-template-columns: 1fr; }
    .hdsub-benefits__grid, .hdsub-apps__grid, .hdsub-related__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .hdsub-hero { padding: 110px 18px 72px; }
    .hdsub-benefits__grid, .hdsub-apps__grid, .hdsub-related__grid { grid-template-columns: 1fr; }
    .hdsub-hero__btns { flex-direction: column; }
    .hdsub-btn { width: 100%; }
  }
</style>
