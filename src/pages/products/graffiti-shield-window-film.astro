  <!-- ══ SLIDER JS ══ -->
  <script>
    (() => {
      const track = document.getElementById('gsTrack');
      const slides = track ? track.querySelectorAll('.gs-slider__slide') : [];
      const dots = document.querySelectorAll('[data-gsnav]');
      const bar = document.getElementById('gsProgressBar');
      let current = 0;
      let timer: ReturnType<typeof setInterval> | null = null;

      function go(n: number) {
        current = (n + slides.length) % slides.length;
        if (track) (track as HTMLElement).style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
        if (bar) { (bar as HTMLElement).style.transition = 'none'; (bar as HTMLElement).style.width = '0%'; setTimeout(() => { if (bar) { (bar as HTMLElement).style.transition = 'width 5s linear'; (bar as HTMLElement).style.width = '100%'; }}, 50); }
      }

      function startTimer() {
        if (timer) clearInterval(timer);
        timer = setInterval(() => go(current + 1), 5000);
      }

      document.getElementById('gsPrev')?.addEventListener('click', () => { go(current - 1); startTimer(); });
      document.getElementById('gsNext')?.addEventListener('click', () => { go(current + 1); startTimer(); });
      dots.forEach(d => d.addEventListener('click', () => { go(Number((d as HTMLElement).dataset.gsnav)); startTimer(); }));

      go(0); startTimer();
    })();
  </script>

  <!-- ══ FAQ JS ══ -->
  <script>
    document.querySelectorAll('[data-faq]').forEach(item => {
      const btn = item.querySelector('.gs-faq__q') as HTMLButtonElement;
      const ans = item.querySelector('.gs-faq__a') as HTMLElement;
      if (!btn || !ans) return;
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        document.querySelectorAll('[data-faq] .gs-faq__q').forEach(b => b.setAttribute('aria-expanded', 'false'));
        document.querySelectorAll('[data-faq] .gs-faq__a').forEach((a: Element) => (a as HTMLElement).style.maxHeight = '0');
        if (!open) {
          btn.setAttribute('aria-expanded', 'true');
          const inner = ans.querySelector('.gs-faq__a-inner') as HTMLElement;
          ans.style.maxHeight = inner ? inner.scrollHeight + 32 + 'px' : '500px';
        }
      });
    });
