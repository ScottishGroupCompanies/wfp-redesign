.gs-hero__stat:last-child { padding-right: 0; }
.gs-hero__stat-number {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3.5vw, 40px);
  font-weight: 700;
  color: #fff;
