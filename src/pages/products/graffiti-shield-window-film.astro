  margin-bottom: 6px;
}
.gs-hero__stat-label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  white-space: nowrap;
}
.gs-hero__stat-divider {
  width: 1px;
  height: 48px;
  background: rgba(255,255,255,0.2);
