</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));

  // ── Slider ──
  (function initM3Slider() {
    const track = document.getElementById('gsTrack');
    const slides = document.querySelectorAll('.gs-slider__slide');
    const navItems = document.querySelectorAll('[data-gsnav]');
    const prevBtn = document.getElementById('gsPrev');
    const nextBtn = document.getElementById('gsNext');
    const progressBar = document.getElementById('gsProgressBar');
    if (!track || !slides.length) return;
    let current = 0;
    const total = slides.length;

    function goTo(i) {
      if (i < 0) i = total - 1;
      if (i >= total) i = 0;
      current = i;
      track.style.transform = `translateX(-${current * 100}%)`;
      navItems.forEach((n, idx) => n.classList.toggle('gs-slider__nav-item--active', idx === current));
      slides.forEach((s, idx) => s.classList.toggle('gs-active', idx === current));
      if (progressBar) {
        progressBar.style.transition = 'none';
        progressBar.style.width = '0';
        setTimeout(() => { progressBar.style.transition = 'width 6s linear'; progressBar.style.width = '100%'; }, 50);
      }
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    navItems.forEach((n, i) => n.addEventListener('click', () => goTo(i)));

    document.querySelectorAll('.gs-slider__faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const slide = btn.closest('.gs-slider__slide');
        slide.querySelectorAll('.gs-slider__faq-q').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          const a = b.nextElementSibling; if (a) a.hidden = true;
        });
        if (!expanded) {
          btn.setAttribute('aria-expanded', 'true');
          const a = btn.nextElementSibling; if (a) a.hidden = false;
        }
      });
    });

    let timer = setInterval(() => goTo(current + 1), 6000);
    document.getElementById('gsSlider')?.addEventListener('mouseenter', () => clearInterval(timer));
    document.getElementById('gsSlider')?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 6000); });
    goTo(0);
  })();

  document.querySelectorAll('.gs-faq__item').forEach(item => {
    item.querySelector('.gs-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('gs-faq__item--open');
      document.querySelectorAll('.gs-faq__item').forEach(i => i.classList.remove('gs-faq__item--open'));
      if (!isOpen) item.classList.add('gs-faq__item--open');
    });
  });

  // (no tint slider — Graffiti Shield is not a solar control product)
</script>
