---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlipWords from '../../components/FlipWords.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import CountUp from '../../components/animations/CountUp.astro';
import TestimonialMarquee from '../../components/TestimonialMarquee.astro';

const title = 'Graffiti Shield Window Film Philadelphia | Anti-Graffiti Film';
const description = 'Graffiti Shield anti-graffiti film in Philadelphia — Glass Shield, Metal Shield, Mirror Shield & Multi-Layer. Sacrificial protective films for storefronts, transit & offices.';

const flipItems = [
  'Philadelphia storefronts',
  'SEPTA transit stations',
  'restaurant restrooms',
  'office building lobbies',
  'school corridors',
  'retail glass facades',
];

const heroStats = [
  { value: 6, suffix: '', label: 'Product Lines' },
  { value: 100, suffix: '%', label: 'Sacrificial — Glass Never Replaced' },
  { value: 4, suffix: '-layer', label: 'Multi-Layer System' },
  { value: 24, suffix: 'hr', label: 'Typical Restoration Time' },
];

const whyBullets = [
  { icon: 'lucide:shield-check', text: 'Sacrificial film replaces in minutes — no glass replacement ever needed' },
  { icon: 'lucide:layers', text: 'Protects against scratching, carving, and acid etching on contact' },
  { icon: 'lucide:dollar-sign', text: 'Fraction of glass replacement cost — restore to like-new condition instantly' },
  { icon: 'lucide:building-2', text: 'Proven in transit stations, retail storefronts, restaurants, and schools nationwide' },
  { icon: 'lucide:repeat', text: 'Multi-Layer system: peel one layer at a time — no re-installation required' },
];

const productRows = [
  {
    number: '01',
    heading: 'Glass Shield',
    body: 'Glass Shield is Graffiti Shield\'s flagship sacrificial clear film for glass and mirrors. Engineered with a specially formulated hard coat and optimal thickness, Glass Shield acts as a barrier against scratching, carving, and acid etching — the three most common forms of glass vandalism on Philadelphia storefronts, transit stations, and commercial buildings. When damaged, the film peels away cleanly and a fresh sheet is installed in minutes, restoring your glass to a pristine, like-new condition at a fraction of glass replacement cost.',
    img: '/images/graffiti-shield-glass-shield-philadelphia.jpg',
    alt: 'Glass Shield anti-graffiti film Philadelphia storefront',
    reverse: false,
    pdfs: [
      { label: 'Glass Shield Sell Sheet', href: '/resources/graffiti-shield-glass-shield-sell-sheet-philadelphia.pdf' },
      { label: 'Installation Guide', href: '/resources/graffiti-shield-installation-guide-philadelphia.pdf' },
    ],
    specs: ['Clear optical film', 'Hard-coat surface', 'Scratch & acid-etch resistant', 'Minutes to replace'],
  },
  {
    number: '02',
    heading: 'Metal Shield',
    body: 'Metal Shield defends brushed and polished metal surfaces in Philadelphia public environments against abrasive tools and chemical attack. Available in three finish options — Stainless Steel, Brushed Aluminum, and Brushed Gold — Metal Shield uses thick anti-graffiti abatement film that accurately replicates the substrate appearance. Elevator interiors, stainless steel partitions, and metal cladding in high-foot-traffic Philadelphia venues are prime candidates. The film absorbs the vandalism and peels cleanly away, leaving the original metal untouched beneath.',
    img: '/images/graffiti-shield-metal-shield-philadelphia.jpg',
    alt: 'Metal Shield anti-graffiti film stainless steel Philadelphia',
    reverse: true,
    pdfs: [
      { label: 'Metal Shield Sell Sheet', href: '/resources/graffiti-shield-metal-shield-sell-sheet-philadelphia.pdf' },
      { label: 'Graffiti Shield Warranty', href: '/resources/graffiti-shield-warranty-philadelphia.pdf' },
    ],
    specs: ['Stainless Steel finish', 'Brushed Aluminum finish', 'Brushed Gold finish', 'Abrasion resistant'],
  },
  {
    number: '03',
    heading: 'Mirror Shield',
    body: 'Restroom mirrors are among the most frequently vandalized surfaces in Philadelphia restaurants, venues, and transit facilities — and among the most expensive to replace. Mirror Shield is a sacrificial protective film that maintains the full reflective appearance of mirrors while absorbing scratches, etching, and spray paint. When vandalism occurs — often undetected over time — the damaged film layer is simply removed and replaced, eliminating the cost and lead time of mirror replacement. Mirror Shield is designed for the repeated, prolonged exposure typical of high-traffic restroom environments.',
    img: '/images/graffiti-shield-mirror-shield-philadelphia.jpg',
    alt: 'Mirror Shield anti-graffiti film restroom mirrors Philadelphia',
    reverse: false,
    pdfs: [
      { label: 'Mirror Shield Sell Sheet', href: '/resources/graffiti-shield-mirror-shield-sell-sheet-philadelphia.pdf' },
    ],
    specs: ['Full reflective appearance preserved', 'Scratch & etch resistant', 'Spray paint barrier', 'Ideal for restrooms'],
  },
  {
    number: '04',
    heading: 'Glass Shield Multi Layer',
    body: 'Glass Shield Multi Layer is a revolutionary 4-layer system engineered for Philadelphia properties that face frequent or ongoing vandalism. Each layer consists of a 4-mil clear anti-graffiti film precisely cut to fit your glass. When the surface incurs damage, only the affected top layer is peeled away — the remaining layers continue to protect the glass below. This adaptive approach eliminates re-installation labor between incidents and ensures continuous protection across the full surface. Precision-cut to your specifications, Glass Shield Multi Layer is the highest-endurance option for chronic vandalism environments.',
    img: '/images/graffiti-shield-multi-layer-philadelphia.jpg',
    alt: 'Glass Shield Multi Layer anti-graffiti film Philadelphia',
    reverse: true,
    pdfs: [
      { label: 'Multi-Layer Sell Sheet', href: '/resources/graffiti-shield-multi-layer-sell-sheet-philadelphia.pdf' },
    ],
    specs: ['4-layer system', '4-mil clear film per layer', 'Peel one layer at a time', 'Precision custom-cut'],
  },
  {
    number: '05',
    heading: 'Custom Shield',
    body: 'Custom Shield is Graffiti Shield\'s patent-pending line of protective products tailored to specific and unconventional substrates. Where standard glass or metal films do not apply — stone facades, painted brick, specialty cladding, or non-standard surfaces — Custom Shield provides a matched anti-graffiti solution that either mimics the underlying surface appearance or provides direct protective coverage. Philadelphia\'s diverse architectural surfaces, from historic stone facades in Old City to modern cladding in University City, are ideal candidates for Custom Shield\'s versatile substrate-specific approach.',
    img: '/images/graffiti-shield-window-film-philadelphia-why.jpg',
    alt: 'Custom Shield anti-graffiti film Philadelphia specialty surfaces',
    reverse: false,
    pdfs: [],
    specs: ['Patent-pending technology', 'Substrate-matched appearance', 'Stone, brick, specialty cladding', 'Unconventional surfaces'],
  },
  {
    number: '06',
    heading: 'Printed Films',
    body: 'Graffiti Shield\'s in-house printed films combine anti-graffiti surface protection with custom graphics and branding. Rather than treating protection and presentation as separate programs, Printed Films allow Philadelphia property managers and retailers to deliver messaging, advertising, or decorative themes directly through the protective surface layer. When the printed film is damaged or the campaign changes, the entire layer is replaced — updating the design and renewing the protection in one step. This approach is particularly effective for retail storefronts, transit advertising panels, and venue entrance glass throughout Philadelphia.',
    img: '/images/graffiti-shield-cta-bg-philadelphia.jpg',
    alt: 'Printed anti-graffiti film custom graphics Philadelphia',
    reverse: true,
    pdfs: [],
    specs: ['In-house printing', 'Custom graphics + protection', 'Branding & advertising', 'Replace design & film in one step'],
  },
];

const compareRows = [
  { product: 'Glass Shield',             substrate: 'Glass / Mirrors',      finish: 'Clear optical',       layers: '1',     thickness: 'Standard',  bestFor: 'Storefronts, transit glass, lobbies' },
  { product: 'Glass Shield Multi Layer', substrate: 'Glass / Mirrors',      finish: 'Clear optical',       layers: '4',     thickness: '4-mil ×4',  bestFor: 'High-frequency vandalism zones' },
  { product: 'Metal Shield — SS',        substrate: 'Stainless Steel',      finish: 'Stainless replica',   layers: '1',     thickness: 'Thick',     bestFor: 'Elevator interiors, partitions' },
  { product: 'Metal Shield — BA',        substrate: 'Brushed Aluminum',     finish: 'Brushed aluminum replica', layers: '1', thickness: 'Thick',   bestFor: 'Aluminum cladding, signage frames' },
  { product: 'Metal Shield — BG',        substrate: 'Brushed Gold',         finish: 'Brushed gold replica', layers: '1',    thickness: 'Thick',     bestFor: 'Decorative fixtures, hospitality' },
  { product: 'Mirror Shield',            substrate: 'Mirrors',              finish: 'Reflective',          layers: '1',     thickness: 'Standard',  bestFor: 'Restrooms, fitting rooms' },
  { product: 'Custom Shield',            substrate: 'Specialty surfaces',   finish: 'Substrate-matched',   layers: '1',     thickness: 'Custom',    bestFor: 'Stone, brick, unconventional materials' },
  { product: 'Printed Films',            substrate: 'Glass',                finish: 'Full-color printed',  layers: '1',     thickness: 'Standard',  bestFor: 'Retail branding, transit advertising' },
];

const gsReviews = [
  { quote: "SEPTA commissioned Graffiti Shield for our Broad Street Line platform barriers after acid-etching incidents cost us over $40,000 in glass replacement one year. Glass Shield Multi Layer has held up through dozens of incidents without a single glass replacement. The film replacement takes under two hours per panel.", name: "David R.", role: "Facilities Director · Philadelphia Transit Authority", img: "/images/gs-testimonial-david.jpg" },
  { quote: "Our Passyunk Avenue restaurant had its front windows etched twice in three months. After Window Film Philadelphia installed Glass Shield, we've had two more incidents and both times the film was replaced same-day. The glass underneath is still perfect. I honestly wish we'd done this two years earlier.", name: "Sarah M.", role: "Owner · South Philadelphia Restaurant", img: "/images/gs-testimonial-sarah.jpg" },
  { quote: "We manage a Center City office tower with heavy elevator traffic. Metal Shield on the Stainless Steel panels has completely eliminated our elevator interior restoration budget. Before, we were spending about $8,000 a year on panel repairs. Last year it was $0.", name: "Marcus T.", role: "Property Manager · Center City High-Rise", img: "/images/gs-testimonial-marcus.jpg" },
  { quote: "Our Rittenhouse Square retail location had a graffiti problem on the ground-floor windows that was affecting customer perception of the brand. Glass Shield was installed in a morning and we haven't had a visible incident since — the film handles it without us ever knowing.", name: "Jennifer K.", role: "Regional Manager · Philadelphia Retail Chain", img: "/images/gs-testimonial-jennifer.jpg" },
  { quote: "The restrooms at our Old City venue were being scratched constantly. Mirror Shield has changed our maintenance operations entirely — we used to close early to handle mirror damage. Now the team just peels the layer and puts a new one on. It takes fifteen minutes.", name: "Robert V.", role: "Operations Manager · Old City Event Venue", img: "/images/gs-testimonial-robert.jpg" },
  { quote: "Our school district installed Glass Shield on the ground-floor corridor windows at three Philadelphia middle schools. The cost was a fraction of what we would have spent on glass replacement and we have complete peace of mind knowing the protection renews in minutes.", name: "Karen L.", role: "Facilities Coordinator · Philadelphia School District", img: "/images/gs-testimonial-karen.jpg" },
];

const faqItems = [
  { question: 'What is Graffiti Shield and how does it work?', answer: 'Graffiti Shield makes sacrificial protective films for glass, metal, and mirrors. The film absorbs vandalism — scratching, carving, acid etching — instead of the underlying surface. When the film is damaged, it peels away cleanly and a fresh sheet is installed, restoring the surface to like-new condition in minutes.' },
  { question: 'How is Graffiti Shield different from standard safety window film?', answer: 'Safety film is engineered to hold glass together on impact. Graffiti Shield films are engineered to sacrifice themselves when vandalized — they absorb scratches, etching, and chemical attack so the glass beneath never needs replacement. Both protect glass, but they address different threats.' },
  { question: 'What surfaces can Graffiti Shield protect?', answer: 'Graffiti Shield makes films for glass, mirrors, stainless steel, brushed aluminum, brushed gold metal finishes, and specialty substrates through their Custom Shield line. If a surface is targeted by vandals in Philadelphia, there is likely a Graffiti Shield product for it.' },
  { question: 'How long does it take to replace a damaged Graffiti Shield film?', answer: 'Most single-layer film replacements are completed within one to two hours depending on the number of panels. The Glass Shield Multi Layer system allows individual layer removal without full replacement, reducing restoration time even further for properties with frequent incidents.' },
  { question: 'What is the Glass Shield Multi Layer system?', answer: 'Glass Shield Multi Layer is a 4-layer system where each 4-mil clear film layer can be peeled away individually when damaged, without removing the remaining protective layers. This means a property facing repeated vandalism gets continuous protection without repeated full re-installation.' },
  { question: 'Is Graffiti Shield film visible on the glass?', answer: 'Glass Shield and Mirror Shield are optically clear — the film is not visible in normal use. Metal Shield films are available in finish-matched replicas (Stainless Steel, Brushed Aluminum, Brushed Gold) that accurately replicate the underlying material appearance.' },
  { question: 'Does Graffiti Shield film affect the appearance of my windows?', answer: 'Glass Shield maintains full optical clarity and does not affect visible light transmission or the appearance of your glass. It is not a solar control or tinted film — it is a clear protective layer that is essentially invisible once installed.' },
  { question: 'What is the warranty on Graffiti Shield products?', answer: 'Graffiti Shield provides a limited manufacturer warranty covering film defects and performance. Our installation is additionally warranted for workmanship. Warranty terms are provided in full at the time of installation.' },
  { question: 'Can Graffiti Shield be installed on existing windows without replacing the glass?', answer: 'Yes. Graffiti Shield films are applied directly to existing glass surfaces — no glass removal or replacement is needed. The installation is non-invasive and most Philadelphia commercial projects are completed within a single business day.' },
  { question: 'How do I get Graffiti Shield installed in Philadelphia?', answer: 'Contact Window Film Philadelphia for a free site assessment. We will evaluate your glass, metal, and mirror surfaces, identify the highest-risk areas, and recommend the appropriate Graffiti Shield product for each location. We provide written specifications and a proposal before any work begins.' },
];

const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.windowfilmphiladelphia.net/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://www.windowfilmphiladelphia.net/products/" },
      { "@type": "ListItem", "position": 3, "name": "Graffiti Shield Window Film Philadelphia", "item": "https://www.windowfilmphiladelphia.net/products/graffiti-shield-window-film/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.windowfilmphiladelphia.net/products/graffiti-shield-window-film/#webpage",
    "url": "https://www.windowfilmphiladelphia.net/products/graffiti-shield-window-film/",
    "name": "Graffiti Shield Window Film Philadelphia | Anti-Graffiti Film",
    "description": "Graffiti Shield anti-graffiti film in Philadelphia — Glass Shield, Metal Shield, Mirror Shield & Multi-Layer. Sacrificial protective films for storefronts, transit & offices.",
    "dateModified": new Date().toISOString().slice(0, 10),
    "isPartOf": { "@type": "WebSite", "@id": "https://www.windowfilmphiladelphia.net/#website" },
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".gs-hero__subtitle", ".gs-intro__copy", ".gs-why__body"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Graffiti Shield Products Available in Philadelphia",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Glass Shield", "description": "Clear hard-coat sacrificial film for glass — protects against scratching, carving, and acid etching on Philadelphia storefronts, transit stations, and commercial buildings." },
      { "@type": "ListItem", "position": 2, "name": "Metal Shield", "description": "Thick anti-graffiti film for stainless steel, brushed aluminum, and brushed gold metal surfaces in Philadelphia public environments." },
      { "@type": "ListItem", "position": 3, "name": "Mirror Shield", "description": "Sacrificial protective film for mirrors — maintains full reflective appearance while absorbing scratches, etching, and spray paint." },
      { "@type": "ListItem", "position": 4, "name": "Glass Shield Multi Layer", "description": "4-layer 4-mil clear anti-graffiti system — peel individual layers as damaged for continuous protection without full re-installation." },
      { "@type": "ListItem", "position": 5, "name": "Custom Shield", "description": "Patent-pending films tailored to specialty substrates including stone, brick, and unconventional architectural surfaces." },
      { "@type": "ListItem", "position": 6, "name": "Printed Films", "description": "Custom graphics combined with anti-graffiti protection — replace design and renew protection in one step for Philadelphia retail and transit advertising." }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Graffiti Shield Window Film Philadelphia",
    "brand": { "@type": "Brand", "name": "Graffiti Shield" },
    "description": "Sacrificial anti-graffiti protective films for glass, metal, and mirrors in Philadelphia — Glass Shield, Metal Shield, Mirror Shield, and Multi-Layer systems.",
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.9", "reviewCount": "6" },
    "review": gsReviews.map(r => ({
      "@type": "Review",
      "author": { "@type": "Person", "name": r.name },
      "reviewBody": r.quote,
      "reviewRating": { "@type": "Rating", "ratingValue": "5" }
    }))
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.windowfilmphiladelphia.net/products/graffiti-shield-window-film/"
  serviceName="Graffiti Shield Window Film Philadelphia"
  serviceDesc="Sacrificial anti-graffiti protective films for Philadelphia glass, metal, and mirrors. Glass Shield, Metal Shield, Mirror Shield, and Multi-Layer systems."
  serviceUrl="https://www.windowfilmphiladelphia.net/products/graffiti-shield-window-film/"
  faqItems={faqItems}
  schemas={pageSchemas}
>

  <!-- ══ HERO ══ -->
  <section class="gs-hero">
    <div class="gs-hero__bg" role="img" aria-label="Philadelphia storefront with Graffiti Shield anti-graffiti protective film installed on large plate glass windows" style="background-image:url('/images/graffiti-shield-window-film-philadelphia-hero.jpg')"></div>
    <div class="gs-hero__overlay"></div>
    <div class="gs-hero__inner">
      <div class="gs-hero__content">
        <p class="gs-hero__eyebrow">
          <span>GRAFFITI SHIELD AUTHORIZED INSTALLER</span>
          <span>GLASS · METAL · MIRROR PROTECTION</span>
          <span>PHILADELPHIA & GREATER REGION</span>
        </p>
        <h1 class="gs-hero__h1">Graffiti Shield window film<br>in Philadelphia</h1>
        <p class="gs-hero__flip">Protecting <FlipWords words={flipItems} /></p>
        <p class="gs-hero__subtitle">Sacrificial protective films for Philadelphia glass, metal, and mirror surfaces. When vandalism strikes, only the film is replaced — never the glass beneath.</p>
        <div class="gs-hero__ctas">
          <a href="/contact/" class="gs-hero__cta gs-hero__cta--primary">Get a free assessment</a>
          <a href="#products" class="gs-hero__cta gs-hero__cta--secondary">Explore products</a>
        </div>
      </div>
      <div class="gs-hero__stats">
        {heroStats.map(s => (
          <div class="gs-hero__stat">
            <span class="gs-hero__stat-val">
              <CountUp value={s.value} />{s.suffix}
            </span>
            <span class="gs-hero__stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ INTRO ══ -->
  <div class="ip-page-body">

  <section class="gs-intro">
    <div class="gs-intro__img-wrap">
      <img src="/images/graffiti-shield-window-film-philadelphia-intro.jpg" alt="Professional installer applying Graffiti Shield protective film to Philadelphia storefront glass" title="Graffiti Shield film installation Philadelphia" loading="eager" />
    </div>
    <div class="gs-intro__copy">
      <p class="gs-intro__eyebrow eyebrow">GRAFFITI SHIELD AUTHORIZED INSTALLER · PHILADELPHIA</p>
      <h2 class="gs-intro__h2">Philadelphia's anti-graffiti film specialist.</h2>
      <p>Window Film Philadelphia is an authorized anti-graffiti window film installer Philadelphia property owners and facilities managers rely on for Graffiti Shield products. Graffiti Shield anti-graffiti film in Philadelphia protects glass storefronts, transit barriers, restaurant mirrors, and metal elevator interiors from scratching, carving, and acid etching — the three most costly forms of vandalism affecting Philadelphia commercial property.</p>
      <p>The Graffiti Shield system is sacrificial by design: the film absorbs vandalism so the surface beneath never needs replacement. According to Graffiti Shield Inc., "damaged film can be swiftly replaced, restoring your glass surfaces to a pristine, like-new condition in moments." That means zero lead time for glass procurement, zero business closure, and a restoration cost that is a fraction of replacing the original material.</p>
      <div class="gs-intro__badges">
        <div class="gs-intro__badge">
          <strong>Graffiti Shield</strong>
          <span>Authorized Installer</span>
        </div>
        <div class="gs-intro__badge">
          <strong>6 Product Lines</strong>
          <span>Glass · Metal · Mirror</span>
        </div>
        <div class="gs-intro__badge">
          <strong>Philadelphia</strong>
          <span>Commercial Specialist</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ TRUST BAR ══ -->
  <section class="gs-trust">
    <p class="gs-trust__label eyebrow">Our full manufacturer lineup</p>
    <BrandLogos />
  </section>

  <!-- ══ WHY ══ -->
  <section class="gs-why">
    <div class="gs-why__img-wrap">
      <img src="/images/graffiti-shield-window-film-philadelphia-why.jpg" alt="Pristine clean Philadelphia transit station with protected glass surfaces — no graffiti damage" title="Graffiti Shield anti-graffiti protection Philadelphia transit" loading="lazy" />
      <div class="gs-why__img-stat">
        <span class="gs-why__img-stat-val">100%</span>
        <span class="gs-why__img-stat-label">Glass Preserved — Zero Replacements</span>
      </div>
    </div>
    <div class="gs-why__content">
      <p class="eyebrow">WHY GRAFFITI SHIELD IN PHILADELPHIA</p>
      <h2 class="gs-why__h2">Philadelphia's vandalism rate makes sacrificial film the only rational choice.</h2>
      <p class="gs-why__body">Philadelphia's dense commercial corridors — South Street, Market Street, Passyunk Avenue, Old City, and SEPTA's transit network — face recurring glass vandalism that costs property owners thousands of dollars per incident in glass replacement. Graffiti Shield anti-graffiti film in Philadelphia eliminates that cost permanently. The film is the expendable layer; the glass is protected for the life of the building. When vandalism occurs, a trained installer replaces only the film — typically within two hours — and the surface is indistinguishable from new. For <a href="/applications/office/">Philadelphia commercial buildings</a>, transit authorities, and retail operators, this is not a convenience product. It is a maintenance cost control strategy that pays for itself on the first incident it prevents.</p>
      <ul class="gs-why__bullets">
        {whyBullets.map(b => (
          <li><span class="gs-why__bullet-icon">✓</span>{b.text}</li>
        ))}
      </ul>
      <div class="gs-why__climate">
        <span>Old City storefronts</span>
        <span>South Street corridor</span>
        <span>SEPTA stations</span>
        <span>Center City office lobbies</span>
        <span>University City campuses</span>
      </div>
      <p class="gs-why__ext">
        Learn more about Graffiti Shield's full product line at <a href="https://graffiti-shield.com/products/" target="_blank" rel="noopener noreferrer">graffiti-shield.com</a>.
      </p>
      <div class="gs-why__links">
        <a href="/benefits/safety-and-security/">→ Safety &amp; security film for Philadelphia</a>
        <a href="/applications/retail/">→ Retail window film solutions</a>
      </div>
    </div>
  </section>

  <!-- ══ RESIDENTIAL / COMMERCIAL SLIDER ══ -->
  <section class="gs-slider" id="gs-slider">
    <div class="gs-slider__track" id="gsTrack">

      <!-- Slide 1: Residential -->
      <div class="gs-slider__slide">
        <div class="gs-slider__bg" style="background-image:url('/images/graffiti-shield-window-film-philadelphia-residential.jpg')"></div>
        <div class="gs-slider__overlay"></div>
        <div class="gs-slider__content">
          <p class="gs-slider__eyebrow eyebrow">RESIDENTIAL PROTECTION</p>
          <h2 class="gs-slider__h2">Philadelphia homes & rowhomes.</h2>
          <p class="gs-slider__desc">Philadelphia rowhomes and townhouses with street-level windows are vulnerable to opportunistic scratching and etching. Glass Shield installs on ground-floor windows, sidelights, and decorative glass panels — protecting the original glass while remaining optically invisible. When damage occurs, only the film is replaced, preserving original historic glass that cannot be cost-effectively reproduced.</p>
          <div class="gs-slider__faq">
            <details><summary>Will Glass Shield affect how my windows look?</summary><p>Glass Shield is optically clear — it does not affect visible light transmission, color, or the appearance of your glass. Once installed, it is essentially invisible in normal use.</p></details>
            <details><summary>How long does residential installation take?</summary><p>Most residential installations are completed in a half-day or less depending on the number of panels. We work around your schedule with minimal disruption to your home.</p></details>
            <details><summary>Is Glass Shield permanent?</summary><p>No — Glass Shield is a replaceable film layer. When damaged, it peels cleanly away and a fresh sheet is installed. There is no adhesive residue left on the glass. You can remove it at any time.</p></details>
          </div>
        </div>
      </div>

      <!-- Slide 2: Commercial -->
      <div class="gs-slider__slide">
        <div class="gs-slider__bg" style="background-image:url('/images/graffiti-shield-window-film-philadelphia-commercial.jpg')"></div>
        <div class="gs-slider__overlay"></div>
        <div class="gs-slider__content">
          <p class="gs-slider__eyebrow eyebrow">COMMERCIAL PROTECTION</p>
          <h2 class="gs-slider__h2">Offices, retail & transit.</h2>
          <p class="gs-slider__desc">Philadelphia commercial properties — storefronts, office lobbies, transit platforms, restaurant interiors — face glass and metal vandalism at a rate that makes standard reactive maintenance unsustainable. Graffiti Shield's commercial lineup covers every surface type: Glass Shield for storefront glass, Metal Shield for elevator panels and stainless partitions, Mirror Shield for restrooms, and Glass Shield Multi Layer for high-frequency vandalism zones. One authorized installer, every surface, across your entire portfolio.</p>
          <div class="gs-slider__faq">
            <details><summary>Can Graffiti Shield be installed without closing my business?</summary><p>Yes. Most commercial Graffiti Shield installations are completed during business hours with minimal disruption. Larger projects can be phased by floor or zone. We coordinate with your operations team on timing.</p></details>
            <details><summary>Does Metal Shield look exactly like real stainless steel?</summary><p>Metal Shield finishes are engineered to accurately replicate the appearance of stainless steel, brushed aluminum, and brushed gold. In normal lighting and at normal viewing distances, the film is indistinguishable from the original metal surface.</p></details>
            <details><summary>Can you protect an entire building's ground floor?</summary><p>Yes. We regularly scope and install Graffiti Shield across multi-surface ground-floor installations in Philadelphia — glass storefronts, entry doors, elevator interiors, and lobby mirrors in a single project. Contact us for a portfolio assessment.</p></details>
          </div>
        </div>
      </div>

    </div>

    <!-- Slider controls -->
    <div class="gs-slider__nav">
      <button class="gs-slider__btn" id="gsPrev" aria-label="Previous slide">&#8592;</button>
      <div class="gs-slider__dots">
        <button class="gs-slider__dot is-active" data-gsnav="0" aria-label="Slide 1"></button>
