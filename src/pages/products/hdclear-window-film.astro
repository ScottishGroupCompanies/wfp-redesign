</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));

  // ── Slider ──
  (function initM3Slider() {
    const track = document.getElementById('hdTrack');
    const slides = document.querySelectorAll('.hd-slider__slide');
    const navItems = document.querySelectorAll('[data-hdnav]');
    const prevBtn = document.getElementById('hdPrev');
    const nextBtn = document.getElementById('hdNext');
    const progressBar = document.getElementById('hdProgressBar');
    if (!track || !slides.length) return;
    let current = 0;
    const total = slides.length;

    function goTo(i) {
      if (i < 0) i = total - 1;
      if (i >= total) i = 0;
      current = i;
      track.style.transform = `translateX(-${current * 100}%)`;
      navItems.forEach((n, idx) => n.classList.toggle('hd-slider__nav-item--active', idx === current));
      slides.forEach((s, idx) => s.classList.toggle('hd-active', idx === current));
      if (progressBar) {
        progressBar.style.transition = 'none';
        progressBar.style.width = '0';
        setTimeout(() => { progressBar.style.transition = 'width 6s linear'; progressBar.style.width = '100%'; }, 50);
      }
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    navItems.forEach((n, i) => n.addEventListener('click', () => goTo(i)));

    document.querySelectorAll('.hd-slider__faq-q').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const slide = btn.closest('.hd-slider__slide');
        slide.querySelectorAll('.hd-slider__faq-q').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
          const a = b.nextElementSibling; if (a) a.hidden = true;
        });
        if (!expanded) {
          btn.setAttribute('aria-expanded', 'true');
          const a = btn.nextElementSibling; if (a) a.hidden = false;
        }
      });
    });

    let timer = setInterval(() => goTo(current + 1), 6000);
    document.getElementById('hdSlider')?.addEventListener('mouseenter', () => clearInterval(timer));
    document.getElementById('hdSlider')?.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 6000); });
    goTo(0);
  })();

  document.querySelectorAll('.hd-faq__item').forEach(item => {
    item.querySelector('.hd-faq__q')?.addEventListener('click', () => {
      const isOpen = item.classList.contains('hd-faq__item--open');
      document.querySelectorAll('.hd-faq__item').forEach(i => i.classList.remove('hd-faq__item--open'));
      if (!isOpen) item.classList.add('hd-faq__item--open');
    });
  });

  // ══ TINT SLIDER ══
  (() => {
    const range = document.getElementById('hdTintRange');
    const overlay = document.getElementById('hdTintOverlay');
    const vltEl = document.getElementById('hdTintVlt');
    const filmEl = document.getElementById('hdTintFilm');
    if (!range) return;
    // v=0 (left) = clearest, v=100 (right) = darkest frost preview
    // Clarity: clear ~90% down to dense frost ~5%
    // v=0 (left, CLEAR) = no treatment; v=100 (right, FROST) = darkest
    const films = [
      { minV: 0,  maxV: 15,  name: 'Clear — No Film',       vlt: 90 },
      { minV: 15, maxV: 30,  name: 'Clear Unprinted Glass',   vlt: 75 },
      { minV: 30, maxV: 50,  name: 'Light HDFrost',  vlt: 70 },
      { minV: 50, maxV: 65,  name: 'Medium HDFrost',  vlt: 50 },
      { minV: 65, maxV: 80,  name: 'Dense HDFrost',  vlt: 35 },
      { minV: 80, maxV: 90,  name: 'Full HDFrost', vlt: 24 },
      { minV: 90, maxV: 100, name: 'Maximum HDFrost', vlt: 15 },
    ];
    const update = () => {
      const v = parseInt(range.value); // 0=CLEAR (light), 100=FROST (dark)
      const vlt = Math.round(90 - (v / 100) * 85); // 90% at CLEAR, 5% at FROST
      const opacity = (v / 100) * 0.78;
      overlay.style.background = `rgba(10,20,5,${opacity.toFixed(3)})`;
      vltEl.textContent = vlt + '%';
      const film = films.find(f => v >= f.minV && v <= f.maxV) || films[films.length - 1];
      filmEl.textContent = film.name;
    };
    range.addEventListener('input', update);
    update();
  })();
</script>
