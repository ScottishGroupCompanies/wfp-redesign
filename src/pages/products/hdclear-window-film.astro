/* ══════════════════════════════════════
   SECTION 4 - SLIDER
══════════════════════════════════════ */
.hd-slider { position: relative; width: 100%; min-height: 90vh; overflow: hidden; background: #14201A; }
.hd-slider__track { display: flex; width: 100%; height: 100%; transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); will-change: transform; }
.hd-slider__slide { position: relative; min-width: 100%; min-height: 90vh; flex-shrink: 0; display: flex; align-items: center; }
.hd-slider__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; z-index: 0; }
.hd-slider__overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.80) 0%, rgba(0,0,0,0.25) 60%, transparent 100%); z-index: 1; }
.hd-slider__content { position: relative; z-index: 2; max-width: 560px; padding-left: 8%; color: #fff; opacity: 0; transform: translateY(20px); transition: opacity 0.5s ease 0.1s, transform 0.5s ease 0.1s; }
.hd-slider__slide[data-slide="0"] .hd-slider__content { opacity: 1; transform: translateY(0); }
.hd-slider__step { font-family: 'Space Mono', monospace; font-size: 13px; color: #81AB4C; letter-spacing: 0.2em; margin-bottom: 1rem; opacity: 0; animation: m3FadeUp 0.4s ease 0.2s forwards; }
.hd-slider__title { font-family: var(--font-serif, 'Playfair Display', serif); font-size: clamp(2.2rem, 4vw, 3.25rem); font-weight: 700; color: #fff; line-height: 1.1; margin: 0 0 1.5rem; opacity: 0; animation: m3FadeUp 0.4s ease 0.3s forwards; }
.hd-slider__desc { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 16px; line-height: 1.8; color: rgba(255,255,255,0.85); max-width: 460px; margin-bottom: 2rem; opacity: 0; animation: m3FadeUp 0.4s ease 0.4s forwards; }
.hd-slider__faq { display: flex; flex-direction: column; gap: 8px; margin-bottom: 2rem; opacity: 0; animation: m3FadeUp 0.4s ease 0.5s forwards; }
.hd-slider__faq-item { border-radius: 8px; overflow: hidden; }
.hd-slider__faq-q { width: 100%; background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: rgba(255,255,255,0.88); font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 0.9rem; font-weight: 500; padding: 12px 16px; text-align: left; display: flex; justify-content: space-between; align-items: center; gap: 12px; cursor: pointer; transition: background 0.2s ease; }
.hd-slider__faq-q:hover { background: rgba(255,255,255,0.18); }
.hd-slider__faq-icon { font-size: 1.2rem; color: #81AB4C; flex-shrink: 0; font-style: normal; transition: transform 0.3s ease; }
.hd-slider__faq-q[aria-expanded="true"] .hd-slider__faq-icon { transform: rotate(45deg); }
.hd-slider__faq-a { background: rgba(255,255,255,0.08); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.10); border-top: none; border-radius: 0 0 8px 8px; color: rgba(255,255,255,0.70); font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 0.875rem; line-height: 1.6; padding: 12px 16px; margin-top: -4px; }
.hd-slider__cta { display: inline-block; background: var(--green, #81AB4C); color: #fff; font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 0.9rem; font-weight: 600; padding: 14px 32px; border-radius: 9999px; text-decoration: none; transition: background 0.25s ease, transform 0.2s ease; opacity: 0; animation: m3FadeUp 0.4s ease 0.6s forwards; }
.hd-slider__cta:hover { background: #6e9640; transform: translateY(-2px); }
.hd-slider__nav { position: absolute; top: 50%; right: 48px; transform: translateY(-50%); z-index: 10; display: flex; flex-direction: column; gap: 24px; }
.hd-slider__nav-item { display: flex; align-items: center; gap: 12px; background: transparent; border: none; cursor: pointer; padding: 0; opacity: 0.35; transition: opacity 0.3s ease; }
.hd-slider__nav-item:hover { opacity: 0.65; }
.hd-slider__nav-item--active { opacity: 1; }
.hd-slider__nav-line { display: block; width: 3px; height: 32px; background: rgba(255,255,255,0.4); border-radius: 2px; transition: background 0.3s ease, height 0.3s ease; }
.hd-slider__nav-item--active .hd-slider__nav-line { background: #81AB4C; height: 48px; }
.hd-slider__nav-label { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 11px; font-weight: 500; color: #fff; text-transform: uppercase; letter-spacing: 0.15em; white-space: nowrap; }
.hd-slider__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 10; width: 48px; height: 48px; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #fff; transition: background 0.3s ease, color 0.3s ease; }
.hd-slider__arrow:hover { background: rgba(0,0,0,0.6); color: #81AB4C; }
.hd-slider__arrow--prev { left: 32px; }
.hd-slider__arrow--next { right: 32px; }
.hd-slider__progress { position: absolute; bottom: 0; left: 0; width: 100%; height: 2px; background: rgba(255,255,255,0.15); z-index: 10; }
.hd-slider__progress-bar { height: 100%; background: #81AB4C; width: 0; transition: width 0.05s linear; }
@keyframes m3FadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
.hd-slider__slide.hd-active .hd-slider__content { opacity: 1; transform: translateY(0); }
.hd-slider__slide.hd-active .hd-slider__step { animation: m3FadeUp 0.4s ease 0.2s forwards; }
.hd-slider__slide.hd-active .hd-slider__title { animation: m3FadeUp 0.4s ease 0.3s forwards; }
.hd-slider__slide.hd-active .hd-slider__desc { animation: m3FadeUp 0.4s ease 0.4s forwards; }
.hd-slider__slide.hd-active .hd-slider__faq { animation: m3FadeUp 0.4s ease 0.5s forwards; }
.hd-slider__slide.hd-active .hd-slider__cta { animation: m3FadeUp 0.4s ease 0.6s forwards; }
@media (max-width: 1024px) { .hd-slider__nav { right: 32px; } .hd-slider__content { padding-left: 60px; } }
@media (max-width: 768px) { .hd-slider__nav { display: none; } .hd-slider__content { padding-left: 5%; padding-right: 5%; max-width: 100%; } .hd-slider__arrow--prev { left: 20px; } .hd-slider__arrow--next { right: 20px; } }

/* ── FEATURED SECTIONS ── */
/* ── PRODUCT LINES (hd-products) ── */
.hd-products {
  padding: 100px 10%;
  background: var(--off-white, #F7F6F3);
}
.hd-products__hd {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 80px;
}
.hd-products__title {
  font-family: var(--font-head, 'DM Serif Display', Georgia, serif);
  font-size: clamp(28px, 3vw, 42px);
  color: var(--dark, #1a1a1a);
  margin: 8px 0 16px;
  line-height: 1.15;
}
.hd-products__sub {
  font-size: 15px;
  color: var(--text-mid, #555);
  line-height: 1.6;
  margin: 0;
}

/* Each alternating row */
.hd-pl-row {
  display: grid;
  grid-template-columns: 420px 1fr;
  gap: 64px;
  align-items: start;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: 48px;
  box-shadow: 0 2px 16px rgba(0,0,0,0.06);
}
.hd-pl-row:last-child { margin-bottom: 0; }
.hd-pl-row--rev { direction: rtl; }
.hd-pl-row--rev > * { direction: ltr; }

/* Image side */
.hd-pl-row__img-wrap {
  position: relative;
  height: 100%;
  min-height: 480px;
  display: flex;
  align-items: stretch;
}
.hd-pl-row__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.hd-pl-row__pill {
  position: absolute;
  top: 20px;
  left: 20px;
  background: var(--green, #81AB4C);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 100px;
}

/* Content side */
.hd-pl-row__content {
  padding: 52px 52px 52px 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.hd-pl-row--rev .hd-pl-row__content {
  padding: 52px 0 52px 52px;
}
.hd-pl-row__num {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--green, #81AB4C);
  text-transform: uppercase;
  margin-bottom: 6px;
  display: block;
}
.hd-pl-row__eyebrow {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-mid, #666);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 10px;
  display: block;
}
.hd-pl-row__heading {
  font-family: var(--font-head, 'DM Serif Display', Georgia, serif);
  font-size: clamp(20px, 2vw, 28px);
  color: var(--dark, #1a1a1a);
  line-height: 1.2;
  margin: 0 0 20px;
}
.hd-pl-row__body {
  font-size: 15px;
  color: var(--text-mid, #444);
  line-height: 1.7;
  margin: 0 0 16px;
}

/* Specs strip */
.hd-pl-row__specs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: var(--light-gray, #E8E8E4);
  border: 1px solid var(--light-gray, #E8E8E4);
  border-radius: 10px;
  overflow: hidden;
  margin: 8px 0 28px;
}
.hd-pl-row__spec {
  background: var(--off-white, #F7F6F3);
  padding: 16px 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.hd-pl-row__spec-val {
  font-family: var(--font-head, 'DM Serif Display', Georgia, serif);
  font-size: 22px;
  font-weight: 700;
  color: var(--green, #81AB4C);
  line-height: 1;
}
.hd-pl-row__spec-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--text-mid, #666);
  text-align: center;
}

/* PDF links */
.hd-pl-row__pdfs {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.hd-pl-row__pdfs-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-mid, #888);
}
.hd-pl-row__pdf-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.hd-pl-row__pdf-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  font-weight: 500;
  color: var(--green, #81AB4C);
  text-decoration: none;
  transition: color 0.18s;
}
.hd-pl-row__pdf-link:hover { color: var(--dark, #1a1a1a); }
.hd-pl-row__pdf-link svg { flex-shrink: 0; opacity: 0.7; }
.hd-pl-row__warranty-note {
  font-size: 11px;
  color: var(--text-mid, #999);
  margin: 10px 0 0;
  font-style: italic;
}

/* Responsive */
@media (max-width: 900px) {
  .hd-pl-row {
    grid-template-columns: 1fr;
  }
  .hd-pl-row--rev { direction: ltr; }
  .hd-pl-row__img-wrap { min-height: 280px; }
  .hd-pl-row__content { padding: 36px 28px; }
  .hd-pl-row--rev .hd-pl-row__content { padding: 36px 28px; }
  .hd-pl-row__specs { grid-template-columns: repeat(2, 1fr); }
}

/* ══════════════════════════════════════
   HDCLEAR PRODUCT CATALOG
