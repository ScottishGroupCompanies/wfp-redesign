---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const heroImage = "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203105_1637eef9-8612-44e0-9a15-19473f6f0b06.jpeg";
const f1Image = "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203916_598b3b49-a12b-47df-9adb-38db8dcc49b3.png";
const f2Image = "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203917_ba5975b9-b15f-4cf8-a6b9-25013c6d53f1.png";
const f3Image = "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203920_0d13e3ec-b7f1-461f-a0fd-87a8eb68edf8.png";
const f4Image = "https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203921_1dcfef39-3a0a-482d-a1b5-2ec9a71ecd3d.png";
---

<BaseLayout title="Window Film Philadelphia | Auron Solar">
  <Header />
  
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg" style={`background-image: url('${heroImage}')`}></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>Window Film for Philadelphia Properties</h1>
      <p>Professional window film installation for homes and businesses across the City of Brotherly Love</p>
      <a href="/contact" class="cta-button">Get a Free Quote</a>
    </div>
  </section>

  <!-- About Philadelphia -->
  <section class="about-section">
    <div class="container">
      <h2>Serving the Philadelphia Area</h2>
      <p>Philadelphia, Pennsylvania's largest city, is home to over 1.5 million residents across diverse neighborhoods from Center City to the suburbs. Whether you own a historic rowhouse in Old City, a modern condo in Fishtown, or manage commercial properties throughout the Delaware Valley, Auron Solar provides expert window film solutions tailored to the Philadelphia metropolitan area's unique architecture and climate needs.</p>
      <p>From the iconic Liberty Bell and Independence Hall to the thriving University City corridor, Philadelphia's buildings span centuries of architectural styles. Our team understands the specific requirements of historic properties, new construction, and everything in between.</p>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="gallery-section">
    <div class="container">
      <h2>Our Philadelphia Work</h2>
      <div class="gallery-grid">
        <div class="gallery-item">
          <img src={f1Image} alt="Philadelphia window film installation" />
        </div>
        <div class="gallery-item">
          <img src={f2Image} alt="Philadelphia commercial window film" />
        </div>
        <div class="gallery-item">
          <img src={f3Image} alt="Philadelphia residential window film" />
        </div>
        <div class="gallery-item">
          <img src={f4Image} alt="Philadelphia window film project" />
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="service-areas-section">
    <div class="container">
      <h2>Service Areas in Philadelphia</h2>
      <div class="areas-grid">
        <div class="area-column">
          <h3>Philadelphia Neighborhoods</h3>
          <ul>
            <li>Center City</li>
            <li>Old City</li>
            <li>Fishtown</li>
            <li>Manayunk</li>
            <li>University City</li>
            <li>South Philly</li>
            <li>Northern Liberties</li>
            <li>Passyunk</li>
          </ul>
        </div>
        <div class="area-column">
          <h3>Surrounding Areas</h3>
          <ul>
            <li>King of Prussia</li>
            <li>Wayne</li>
            <li>Conshohocken</li>
            <li>Bala Cynwyd</li>
            <li>Cherry Hill, NJ</li>
            <li>Moorestown, NJ</li>
            <li>Bucks County</li>
            <li>Chester County</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="benefits-section">
    <div class="container">
      <h2>Why Philadelphia Chooses Auron Solar</h2>
      <div class="benefits-grid">
        <div class="benefit-card">
          <h3>Energy Efficiency</h3>
          <p>Reduce cooling costs by up to 30% during Philadelphia's hot summers while keeping warmth in during winter months.</p>
        </div>
        <div class="benefit-card">
          <h3>UV Protection</h3>
          <p>Block 99% of harmful UV rays, protecting your furniture, flooring, artwork, and family's skin from sun damage.</p>
        </div>
        <div class="benefit-card">
          <h3>Glare Reduction</h3>
          <p>Enjoy natural light without the glare — perfect for home offices, media rooms, and commercial spaces.</p>
        </div>
        <div class="benefit-card">
          <h3>Privacy & Security</h3>
          <p>Add an extra layer of privacy and security to your Philadelphia property with our specialized films.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to Transform Your Philadelphia Property?</h2>
      <p>Contact Auron Solar today for a free consultation and quote. Our Philadelphia experts are ready to help you find the perfect window film solution.</p>
      <div class="cta-buttons">
        <a href="/contact" class="cta-button cta-primary">Get a Free Quote</a>
        <a href="/services" class="cta-button cta-secondary">Our Services</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.4) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    color: white;
    padding: 2rem;
    max-width: 800px;
  }

  .hero-content h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .hero-content p {
    font-size: clamp(1rem, 2vw, 1.25rem);
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2rem;
    background: #f59e0b;
    color: #1a1a1a;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(245, 158, 11, 0.4);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  section {
    padding: 4rem 0;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    text-align: center;
    margin-bottom: 2rem;
    color: #1a1a1a;
  }

  h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: #1a1a1a;
  }

  .about-section {
    background: #fff;
  }

  .about-section p {
    max-width: 800px;
    margin: 0 auto 1rem;
    line-height: 1.8;
    color: #4a4a4a;
  }

  .gallery-section {
    background: #f8f8f8;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .gallery-item {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

  .gallery-item img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    display: block;
  }

  .service-areas-section {
    background: #fff;
  }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .area-column {
    background: #f8f8f8;
    padding: 2rem;
    border-radius: 12px;
  }

  .area-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .area-column li {
    padding: 0.5rem 0;
    border-bottom: 1px solid #e5e5e5;
    color: #4a4a4a;
  }

  .area-column li:last-child {
    border-bottom: none;
  }

  .benefits-section {
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    color: white;
  }

  .benefits-section h2 {
    color: white;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .benefit-card {
    background: rgba(255,255,255,0.1);
    padding: 2rem;
    border-radius: 12px;
    backdrop-filter: blur(10px);
  }

  .benefit-card h3 {
    color: #f59e0b;
    margin-bottom: 0.75rem;
  }

  .benefit-card p {
    color: rgba(255,255,255,0.8);
    line-height: 1.6;
  }

  .cta-section {
    background: #f59e0b;
    text-align: center;
  }

  .cta-section h2 {
    color: #1a1a1a;
  }

  .cta-section p {
    max-width: 600px;
    margin: 0 auto 2rem;
    color: #1a1a1a;
    opacity: 0.9;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-primary {
    background: #1a1a1a;
    color: white;
  }

  .cta-secondary {
    background: white;
    color: #1a1a1a;
  }

  @media (max-width: 768px) {
    .hero {
      height: 60vh;
      min-height: 400px;
    }

    section {
      padding: 3rem 0;
    }

    .gallery-item img {
      height: 200px;
    }
  }
</style>
