---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import AccordionBenefits from '../../components/AccordionBenefits.astro';
import AccordionFAQ from '../../components/AccordionFAQ.astro';
import GalleryBanner from '../../components/GalleryBanner.astro';
import TestimonialSpotlight from '../../components/TestimonialSpotlight.astro';
import CtaLightRays from '../../components/CtaLightRays.astro';
import ScrollReveal from '../../components/animations/ScrollReveal.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import CategoryBlogFeed from '../../components/CategoryBlogFeed.astro';

const title = 'Window Film Philadelphia PA | Window Film Contractor PA';
const description = 'Window film installation in Philadelphia, PA — solar control, security, privacy, and decorative film. Free estimates, certified installers.';

const filmBenefits = [
  {
    number: '01',
    title: 'Energy Savings',
    detail: `<p>Philadelphia's dense brick rowhouse neighborhoods trap summer heat, pushing indoor temperatures well past 90°F on west-facing floors. Solar control film blocks up to <strong>78% of solar heat</strong> before it enters your space. South Philly and Fishtown rowhouses with west-facing glass can see interior temperature drops of 10–15°F on peak summer days.</p><ul><li>Reduces HVAC run time and cooling costs across Center City high-rises and rowhomes alike</li><li>Most Philadelphia homeowners see measurable bill reductions within the first summer</li><li>Low-E film also cuts winter heating loss through glass — year-round savings for the city's older building stock</li></ul>`,
    image: '/images/window-film-philadelphia-pa-film-energy.jpg',
    imageAlt: 'Energy-saving window film in a Philadelphia PA rowhouse living room — natural light filtered, cooler interior',
  },
  {
    number: '02',
    title: 'UV Protection',
    detail: `<p>Schuylkill and Delaware river humidity combined with intense summer sun accelerates UV damage to flooring, furniture, and artwork throughout Philadelphia. UV film blocks <strong>99% of UV-A and UV-B rays</strong> — the primary cause of fading in hardwood floors, rugs, drapes, and upholstery.</p><ul><li>Critical for healthcare facilities like Penn Medicine and Jefferson Health buildings</li><li>Optically clear — no visible tint, no impact on natural light or views</li><li>Reduces fading by up to 60% compared to unprotected glass</li></ul>`,
    image: '/images/window-film-philadelphia-pa-film-uv.jpg',
    imageAlt: 'UV-blocking window film protecting a Philadelphia home interior from sun damage and fading',
  },
  {
    number: '03',
    title: 'Privacy Film',
    detail: `<p>Philadelphia's dense rowhouse layout puts homes and ground-floor offices in close view of pedestrians and neighboring properties across Center City, South Philly, and Northern Liberties. Privacy film solves this <strong>without sacrificing natural light</strong>.</p><ul><li>Rittenhouse Square condo buildings benefit from one-way reflective film that preserves skyline views</li><li>Frosted film for healthcare exam rooms, legal offices along Market Street, and conference rooms</li><li>Available in clear frosted, custom patterns, gradient, and branded designs — all fully removable</li></ul>`,
    image: '/images/window-film-philadelphia-pa-film-privacy.jpg',
    imageAlt: 'Frosted privacy window film on a conference room partition in a Philadelphia PA office',
  },
  {
    number: '04',
    title: 'Safety & Security',
    detail: `<p>Philadelphia's property crime rate makes smash-and-grab a real risk for businesses across the city, from Center City retail corridors to neighborhood storefronts. Security film <strong>holds glass together on impact</strong>, significantly slowing forced entry.</p><ul><li>Prevents glass from shattering into shards during break-ins, accidents, or severe weather</li><li>Government and institutional facilities use security film to meet ANSI and GSA glass safety standards</li><li>Bomb blast mitigation configurations available for federal-standard secured facilities</li></ul>`,
    image: '/images/window-film-philadelphia-pa-film-safety.jpg',
    imageAlt: 'Secure commercial building entrance in Philadelphia PA with safety and security window film on glass doors',
  },
  {
    number: '05',
    title: 'Anti-Graffiti',
    detail: `<p>Philadelphia's commercial corridors — from South Street to Broad Street to Frankford Avenue — see recurring glass etching and acid graffiti. Anti-graffiti film acts as a <strong>sacrificial layer</strong> — when tagged or etched, you replace the film, not the expensive glass panel.</p><ul><li>Each replacement costs a fraction of glass replacement</li><li>Most business owners recoup the initial film cost within 1–2 incidents prevented</li><li>Available in clear or lightly tinted versions — invisible protection</li></ul>`,
    image: '/images/window-film-philadelphia-pa-film-graffiti.jpg',
    imageAlt: 'Clean commercial storefront glass in Philadelphia protected by anti-graffiti window film',
  },
  {
    number: '06',
    title: 'Glare Reduction',
    detail: `<p>East- and west-facing rowhouse windows in Fishtown, Graduate Hospital, and Point Breeze create peak glare during morning and afternoon work hours. Glare reduction film filters up to <strong>85% of glare-causing visible light</strong> while preserving natural daylight.</p><ul><li>Center City conference rooms and open offices benefit immediately — screens and monitors become fully visible</li><li>Compatible with all glass types, including single-pane windows common in Philadelphia's older building stock</li></ul>`,
    image: '/images/window-film-philadelphia-pa-film-glare.jpg',
    imageAlt: 'Philadelphia PA office worker at computer desk near window with no screen glare after window film installation',
  },
  {
    number: '07',
    title: 'Decorative Film',
    detail: `<p>Philadelphia's booming restaurant, coworking, and hospitality scenes have created demand for decorative glass design across the city. Frosted, patterned, and gradient films create an <strong>etched-glass appearance at a fraction of the cost</strong>.</p><ul><li>Branded window graphics for Philadelphia businesses — logos, signage, and custom patterns</li><li>Ideal for healthcare waiting rooms in University City, law firm lobbies along Market Street, and school libraries</li><li>Fully removable without permanent modification to the glass</li></ul>`,
    image: '/images/window-film-philadelphia-pa-film-decorative.jpg',
    imageAlt: 'Decorative frosted glass pattern on a partition wall in a Philadelphia PA office or lobby',
  },
  {
    number: '08',
    title: 'Solar Control',
    detail: `<p>Solar control film is the broadest-purpose film we install in Philadelphia — addressing heat gain, glare, and UV in a single application for homes, offices, retail, and institutional properties.</p><ul><li>Spectrally selective options preserve natural light and views while rejecting significant solar heat — ideal for Center City glass towers</li><li>Ceramic films contain no metal — safe for buildings with Wi-Fi, cellular, and sensitive electronic equipment</li><li>NFRC-rated films available with documented VLT, SHGC, and TSER specs for LEED and energy code compliance</li></ul>`,
    image: '/images/window-film-philadelphia-pa-film-solar.jpg',
    imageAlt: 'Solar control window film on a modern Philadelphia commercial office building exterior',
  },
];

const faqItems = [
  { question: 'Can I install window film on my Philadelphia rowhouse without a permit?', answer: 'Yes — Pennsylvania does not require permits for architectural window film on residential or commercial properties. If your home is in a Philadelphia historic district (Society Hill, Old City, Germantown) or covered by an HOA, check for reflectivity restrictions in your district guidelines. We carry non-reflective and ceramic films that satisfy most historic preservation requirements, and we can help you navigate the approval process.' },
  { question: 'What does window film cost for a typical Philadelphia home?', answer: 'Every property is different — a South Philly trinity with 8 windows has very different requirements than a Rittenhouse Square condo with floor-to-ceiling glass. Film type, glass area, accessibility, and number of panes all factor in. Rather than guess, we come to your property, measure the glass, assess sun exposure, and provide a written estimate at no cost. No pressure, no charge.' },
  { question: 'How do you handle installations in Center City high-rise buildings?', answer: 'High-rise work requires coordination with building management, loading dock access, and sometimes after-hours scheduling. We have experience with Center City office towers and residential buildings — we handle logistics, protect flooring and furnishings, and work within building rules. During your consultation we assess access, glass type (curtain wall vs. operable windows), and any building-specific requirements.' },
  { question: 'Which film brands do you install and what warranties do they carry?', answer: 'We install 3M, LLumar, Vista, Solar Gard, Huper Optik, Madico, and Solyx — all with manufacturer warranties covering peeling, bubbling, delamination, and color shift. Coverage periods range from 10 years to lifetime depending on the product line and whether the installation is residential or commercial. We walk you through the specific warranty for your chosen film before we start.' },
  { question: 'Will solar control film actually make a difference in Philadelphia\'s summer heat?', answer: 'Philadelphia regularly hits 87-93°F in July with 65-70% humidity, and brick rowhouse construction amplifies that. High-performance solar control film blocks up to 85% of solar heat gain through glass — the DOE reports that windows account for 25-30% of a building\'s heating and cooling energy loss. Most Philadelphia clients see cooling cost reductions of 20-30% in the first summer after installation.' },
  { question: 'Does window film protect the original hardwood floors in older Philadelphia homes?', answer: 'Yes — this is one of the most common reasons Philadelphia homeowners call us. The city\'s housing stock is full of 19th and early 20th century homes with original old-growth pine and oak floors. UV film blocks 99% of UV-A and UV-B rays, which are the primary cause of fading. Clear UV-blocking film is invisible — you keep your natural light and views while protecting floors, artwork, and furniture.' },
  { question: 'I\'m renting — can I still get window film installed?', answer: 'Absolutely. Window film is fully removable with heat and a mild adhesive solvent — no scratches, no residue, no permanent change to the glass. Many of our Philadelphia clients are renters in Center City and University City apartments who want heat reduction or privacy without modifying the unit permanently. When you move out, the film can be professionally removed.' },
  { question: 'Is window film worth it in Philadelphia winters or only in summer?', answer: 'Both seasons. Solar control film handles summer heat gain, and low-emissivity (low-e) films also reflect interior heat back into the room during winter — the same principle as Low-E glass. Philadelphia January temperatures regularly drop into the 20s°F. Combined summer and winter performance can cut total HVAC energy use by 5-15% across the year.' },
  { question: 'What\'s the right film for a street-facing rowhouse window in South Philly?', answer: 'It depends on your goals. If afternoon sun is the problem, ceramic solar control film rejects heat without darkening the glass. If pedestrians can see directly into your living space, one-way reflective film gives daytime privacy while preserving your outward view. For bathroom or basement windows, frosted decorative film provides permanent privacy. Many South Philly clients layer solar film on upper floors and privacy film on ground-floor street-facing windows.' },
  { question: 'Do you install anti-graffiti film on storefronts along Frankford Avenue and South Street?', answer: 'Yes — anti-graffiti film is one of our most-requested commercial products in Philadelphia\'s restaurant and retail corridors. It\'s a clear sacrificial layer: when glass gets scratched or tagged, we peel off the damaged film and apply a new sheet — a fraction of what glass replacement costs. South Street, Frankford Avenue, and Broad Street corridor merchants use it specifically because vandalism is a recurring expense.' },
  { question: 'Will window film crack my older Philadelphia windows?', answer: 'No, when the correct film is matched to the glass type. Many Philadelphia rowhouses have single-pane glass, which requires different film specs than double-pane insulated units. For sealed IGUs we use films rated to prevent thermal stress cracking. Our installers inspect the glass and verify compatibility before applying anything. Major glass manufacturers do not void warranties when an IGU-rated film is properly installed.' },
  { question: 'Are there PECO or Pennsylvania rebates available for window film?', answer: 'The federal Inflation Reduction Act Section 25C tax credit covers qualifying energy-efficient window treatments up to $1,200 per year for eligible residential projects. PECO and other Pennsylvania utility programs sometimes offer commercial efficiency incentives. We recommend checking current program availability with your utility and consulting a tax professional to confirm eligibility based on your film specification and property type.' },
  { question: 'Do you serve all of Philadelphia County?', answer: 'Yes — from the Delaware River waterfront to the Schuylkill, from South Philly to Chestnut Hill to Manayunk. We offer free on-site consultations anywhere in Philadelphia County and throughout the Delaware Valley. We assess your windows, sun exposure, and goals, then provide a detailed written estimate at no charge.' },
];

const today = new Date().toISOString().slice(0, 10);
const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': 'https://www.windowfilmphiladelphia.net/cities/philadelphia/#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Cities We Serve', item: 'https://www.windowfilmphiladelphia.net/cities/' },
      { '@type': 'ListItem', position: 3, name: 'Window Film Philadelphia PA', item: 'https://www.windowfilmphiladelphia.net/cities/philadelphia/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://www.windowfilmphiladelphia.net/cities/philadelphia/#webpage',
    url: 'https://www.windowfilmphiladelphia.net/cities/philadelphia/',
    name: title,
    description: description,
    inLanguage: 'en-US',
    isPartOf: { '@id': 'https://www.windowfilmphiladelphia.net/#website' },
    about: { '@type': 'City', name: 'Philadelphia', containedInPlace: { '@type': 'State', name: 'Pennsylvania' } },
    dateModified: today,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.ph-geo', '.ph-hero__subtitle', '.faq__a-inner p'],
    },
    breadcrumb: { '@id': 'https://www.windowfilmphiladelphia.net/cities/philadelphia/#breadcrumb' },
  },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/cities/philadelphia/" faqItems={faqItems} schemas={pageSchemas}>

<!-- ══ HERO ══ -->
<section class="ph-hero">
  <div class="ph-hero__overlay"></div>
  <div class="ph-hero__container">
    <div class="ph-hero__label">WINDOW FILM INSTALLATION &middot; PHILADELPHIA, PA</div>
    <div class="ph-hero__content">
      <h1 class="ph-hero__title">Window Film in Philadelphia<br/>&mdash; Pennsylvania's Best</h1>
      <p class="ph-hero__subtitle">Professional residential and commercial window film installation in Philadelphia, PA and throughout the Delaware Valley. Window film for Philadelphia homes and businesses — free estimates, certified installers, manufacturer warranties.</p>
      <div class="ph-hero__buttons">
        <a href="/contact/" class="btn-hero btn-hero--primary">Get Your Free Estimate &rarr;</a>
        <a href="tel:+12673947980" class="btn-hero btn-hero--secondary">Call (267) 394-7980</a>
      </div>
    </div>
    <div class="ph-hero__bottom">
      <div class="ph-hero__tagline">Trusted by Philadelphia homeowners and businesses since 2008.</div>
      <div class="ph-hero__stats">
        <div class="hero-stat-item">
          <div class="hero-stat-item__number" data-count="18">0</div>
          <div class="hero-stat-item__label">Years Serving Greater Philadelphia</div>
        </div>
        <div class="hero-stat-item">
          <div class="hero-stat-item__number" data-count="2000">0</div>
          <div class="hero-stat-item__label">Philadelphia Area Installs</div>
        </div>
        <div class="hero-stat-item">
          <div class="hero-stat-item__number" data-count="99">0</div>
          <div class="hero-stat-item__label">UV Block Rate</div>
        </div>
        <div class="hero-stat-item">
          <div class="hero-stat-item__number" data-count="4.9">0</div>
          <div class="hero-stat-item__label">Google Rating</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══ LOCAL CONTEXT ══ -->
<section class="ph-why">
  <div class="ph-why__container">

    <div class="ph-why__image-wrap">
      <img
        src="/images/window-film-philadelphia-pa-urban-heat.jpg"
        alt="Philadelphia skyline and rowhouse neighborhoods along the Schuylkill and Delaware Rivers — Philadelphia's summer heat and humidity make window film essential"
        class="ph-why__image"
        loading="lazy"
      />
      <div class="ph-why__stat-card">
        <div class="ph-why__stat-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>87-93°F summer highs</span>
        </div>
        <div class="ph-why__stat-divider"></div>
        <div class="ph-why__stat-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>65-70% summer humidity</span>
        </div>
      </div>
    </div>

    <div class="ph-why__content">
      <div class="ph-why__eyebrow">Philadelphia Climate & Context</div>
      <h2 class="line-mask ph-why__headline" data-stagger="140" aria-label="Philadelphia's Brick Rowhouse Heat Problem">
        <span class="line-mask__line" aria-hidden="true"><span class="line-mask__inner" style="--i:0">Philadelphia's Brick</span></span>
        <span class="line-mask__line" aria-hidden="true"><span class="line-mask__inner" style="--i:1">Rowhouse Heat Problem</span></span>
      </h2>
      <p class="ph-why__intro">Philadelphia's building stock — predominantly brick rowhouses built in the 19th and early 20th century — absorbs and retains solar heat far more efficiently than newer construction. July averages hit 87°F, but surface temperatures on south-facing brick facades in South Philly and North Philadelphia can climb 20° higher. The <a href="https://www.epa.gov/heatislands" target="_blank" rel="noopener noreferrer" style="color:#7CB342">EPA classifies Philadelphia as an urban heat island</a>, meaning dense masonry and limited tree canopy trap heat long after sunset. Add in the Schuylkill and Delaware River humidity, and second-floor rooms with west-facing glass become routinely unbearable by mid-July. That's before considering the smash-and-grab risk that comes with any major city — security film accounts for nearly a third of our Philadelphia installs.</p>
      <ul class="ph-why__bullets">
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Brick rowhouse construction across South Philly, Fishtown, and Graduate Hospital means walls radiate stored heat into interior spaces well past sunset — solar control film cuts that gain by up to 78%
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Philadelphia's tree canopy covers only about 20% of the city — well below the 30% benchmark — leaving rowhouse blocks exposed to direct sun with no natural shade to buffer heat
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Center City and neighborhood commercial corridors see recurring storefront break-ins — security film that holds glass together on impact is one of the most cost-effective deterrents available
        </li>
      </ul>
      <div class="ph-why__climate-facts">
        <div class="ph-why__climate-item">
          <span class="ph-why__climate-num">87°F</span>
          <span class="ph-why__climate-label"><a href="https://www.weather.gov/phi/" target="_blank" rel="noopener noreferrer" style="color:#7CB342">NWS Philadelphia — avg July high</a></span>
        </div>
        <div class="ph-why__climate-item">
          <span class="ph-why__climate-num">20%</span>
          <span class="ph-why__climate-label">Citywide tree canopy coverage (below 30% target)</span>
        </div>
        <div class="ph-why__climate-item">
          <span class="ph-why__climate-num">65-70%</span>
          <span class="ph-why__climate-label">Relative humidity in peak summer months</span>
        </div>
      </div>
      <p class="ph-why__closing">Since 2008, Window Film Philadelphia has worked in neighborhoods from Society Hill to Manayunk — installing <a href="/benefits/energy-savings/" style="color:#7CB342">solar control</a>, <a href="/benefits/safety-and-security/" style="color:#7CB342">security</a>, <a href="/benefits/privacy-window-film-philadelphia/" style="color:#7CB342">privacy</a>, and <a href="/benefits/decorative-promotional/" style="color:#7CB342">decorative film</a> with certified technicians and manufacturer-backed warranties on every installation.</p>
      <a href="/contact/" class="ph-why__cta">
        Get a free Philadelphia assessment
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
      </a>
    </div>

  </div>
</section>

<!-- ══ TRUSTED EXPERTS ══ -->
<section class="ph-expert">
  <div class="ph-expert__container">
    <div class="ph-expert__content">
      <p class="ph-expert__eyebrow">PHILADELPHIA'S TRUSTED EXPERTS</p>
      <h2 class="ph-expert__title">Certified Window Film Installers Serving the Delaware Valley</h2>
      <p class="ph-expert__body">Window Film Philadelphia has been working in the city since 2008 — from Society Hill brownstones to Comcast Center office floors to Fishtown brewery taprooms. Our certified installers handle the full spectrum: solar control for rowhouses baking in afternoon sun, security film for retail storefronts on Frankford Avenue, anti-graffiti film for transit-adjacent commercial glass, and decorative frosted partitions for University City labs and co-working spaces.</p>
      <p class="ph-expert__body">What sets Philadelphia properties apart is the scale and variety — 1.6 million people across neighborhoods that range from dense Center City high-rises to leafy Chestnut Hill estates. Each building type demands a different film strategy. Rowhouses need heat rejection on west-facing glass; high-rise condos benefit from spectrally selective film that preserves views; storefronts need impact-resistant security film. We carry manufacturer certifications from 3M, LLumar, Vista, and Solar Gard, and every installer on our team is factory-trained. We also serve <a href="/cities/reading/" style="color:#7CB342">Reading</a>, <a href="/cities/camden/" style="color:#7CB342">South Jersey</a>, and communities throughout the greater metro area.</p>
      <div class="ph-expert__stats">
        <div class="ph-expert__stat">
          <span class="ph-expert__stat-num">2008</span>
          <span class="ph-expert__stat-label">Serving Greater Philadelphia since</span>
        </div>
        <div class="ph-expert__stat-divider"></div>
        <div class="ph-expert__stat">
          <span class="ph-expert__stat-num">2000+</span>
          <span class="ph-expert__stat-label">Philadelphia area installs completed</span>
        </div>
      </div>
    </div>
    <div class="ph-expert__image-col">
      <img
        src="/images/window-film-philadelphia-pa-expert-interior.jpg"
        alt="Warm Philadelphia residential interior with large windows — window film keeps this Philadelphia home comfortable year-round"
        class="ph-expert__img"
        loading="lazy"
      />
    </div>
  </div>
</section>

<!-- ══ RESIDENTIAL + COMMERCIAL SLIDER ══ -->
<section class="ph-prop-slider" id="phSlider">
  <div class="ph-prop-slider__track" id="phTrack">

    <!-- SLIDE 01: Commercial -->
    <div class="ph-prop-slider__slide" data-slide="0">
      <img src="/images/window-film-philadelphia-pa-commercial.jpg" alt="Modern commercial office in Philadelphia PA with floor-to-ceiling windows - window film for Philadelphia commercial properties" title="Modern commercial office in Philadelphia PA with floor-to-ceiling windows - window film for Philadelphia commercial properties" class="ph-prop-slider__bg" loading="lazy" />
      <div class="ph-prop-slider__overlay"></div>
      <div class="ph-prop-slider__content">
        <div class="ph-prop-slider__step">01</div>
        <h2 class="ph-prop-slider__title">Commercial Window Film
Across Center City &amp; Beyond</h2>
        <p class="ph-prop-slider__desc">Center City glass towers, University City research buildings, Market Street retail — each has different film needs. We spec spectrally selective film for offices with panoramic skyline views, security film for ground-floor retail, and anti-graffiti film for transit-adjacent storefronts along the Broad Street corridor.</p>
        <ul class="ph-prop-slider__benefits">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Spectrally selective film rejects heat without darkening skyline views from high-rise offices
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Security film delays forced entry by holding shattered glass in its frame
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Sacrificial anti-graffiti film peels off clean — replace the film, not the glass panel
          </li>
        </ul>
        <a href="/contact/" class="ph-prop-slider__cta">Get a commercial estimate →</a>
      </div>
    </div>

    <!-- SLIDE 02: Residential -->
    <div class="ph-prop-slider__slide" data-slide="1">
      <img src="/images/window-film-philadelphia-pa-residential-rowhouses.jpg" alt="Brick rowhouses in Philadelphia PA - solar control and security window film for Philadelphia residential homes" title="Brick rowhouses in Philadelphia PA - solar control and security window film for Philadelphia residential homes" class="ph-prop-slider__bg" loading="lazy" />
      <div class="ph-prop-slider__overlay"></div>
      <div class="ph-prop-slider__content">
        <div class="ph-prop-slider__step">02</div>
