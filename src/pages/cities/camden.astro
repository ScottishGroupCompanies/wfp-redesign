---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import Benefits from '../../components/Benefits.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';

const title = 'Window Film Camden NJ | Window Film Contractor Camden';
const description = 'Window Film Philadelphia is the #1 source for window film in Camden, NJ. Get 3M, energy saving, LLumar, security, or privacy film for your home or business. Free quotes!';

const faqItems = [
  { question: 'Is window film legal in New Jersey?', answer: 'Yes. New Jersey law permits residential and commercial window film without restriction. For automotive applications, NJ requires front side windows at 35% VLT or higher. We ensure all installs are fully compliant.' },
  { question: 'How long does installation take?', answer: 'Most residential jobs take 4–8 hours. Commercial projects are scoped per job. Anti-graffiti and decorative films can often be completed in a single afternoon.' },
  { question: 'What warranty comes with my installation?', answer: 'All residential and commercial installations include a lifetime manufacturer warranty against peeling, bubbling, and fading. The warranty transfers with the property.' },
  { question: 'How much does window film cost in Camden?', answer: 'Solar control film starts around $5–$8 per sq ft installed. Security film starts at $7/sq ft. Anti-graffiti starts at $4/sq ft. Request a free quote for an exact estimate.' },
  { question: 'Do you offer free consultations in Camden?', answer: 'Yes — all consultations are free. We will come to your home or business, assess your needs, and provide a detailed written estimate at no charge and no obligation.' },
  { question: 'How soon can you schedule in Camden?', answer: 'We typically have same-week availability in the Camden area. During peak summer months we recommend booking 1–2 weeks in advance.' },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/cities/camden/" faqItems={faqItems}>

<!-- ══ HERO ══ -->
<section class="cam-hero">
  <div class="cam-hero__overlay"></div>
  <div class="cam-hero__container">
    <div class="cam-hero__label">WINDOW FILM INSTALLATION &middot; CAMDEN, NJ</div>
    <div class="cam-hero__content">
      <h1 class="cam-hero__title">Window Film Camden<br/>&mdash; South Jersey's Best</h1>
      <p class="cam-hero__subtitle">Professional residential and commercial window film installation in Camden, NJ and throughout South Jersey. Free estimates. Certified installers. Lifetime warranty.</p>
      <div class="cam-hero__buttons">
        <a href="/contact/" class="btn-hero btn-hero--primary">Get Your Free Estimate &rarr;</a>
        <a href="tel:+12673947980" class="btn-hero btn-hero--secondary">Call (267) 394-7980</a>
      </div>
    </div>
    <div class="cam-hero__bottom">
      <div class="cam-hero__tagline">Trusted by Camden homeowners and businesses since 2008.</div>
      <div class="cam-hero__stats">
        <div class="hero-stat-item">
          <div class="hero-stat-item__number" data-count="18">0</div>
          <div class="hero-stat-item__label">Years Serving South Jersey</div>
        </div>
        <div class="hero-stat-item">
          <div class="hero-stat-item__number" data-count="500">0</div>
          <div class="hero-stat-item__label">Camden Area Installs</div>
        </div>
        <div class="hero-stat-item">
          <div class="hero-stat-item__number" data-count="99">0</div>
          <div class="hero-stat-item__label">UV Block Rate</div>
        </div>
        <div class="hero-stat-item">
          <div class="hero-stat-item__number" data-count="4.9">0</div>
          <div class="hero-stat-item__label">Google Rating</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══ LOCAL CONTEXT ══ -->
<section class="cam-why">
  <div class="cam-why__container">

    <div class="cam-why__image-wrap">
      <img
        src="/images/window-film-camden-nj-urban-heat.jpg"
        alt="Delaware River and Ben Franklin Bridge connecting Camden NJ and Philadelphia — South Jersey's summer heat and humidity make window film essential"
        class="cam-why__image"
        loading="lazy"
      />
      <div class="cam-why__stat-card">
        <div class="cam-why__stat-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>88–94°F summer highs</span>
        </div>
        <div class="cam-why__stat-divider"></div>
        <div class="cam-why__stat-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>72–74% summer humidity</span>
        </div>
      </div>
    </div>

    <div class="cam-why__content">
      <div class="cam-why__eyebrow">South Jersey Climate &amp; Context</div>
      <h2 class="cam-why__headline">Why Camden Needs Window Film</h2>
      <p class="cam-why__intro">Three conditions unique to Camden make window film less of an upgrade and more of a practical necessity. Summer heat regularly pushes past 88°F with 72–74% humidity. The <a href="https://dep.nj.gov/wp-content/uploads/dsr/urban-heat-island-camden-rps-2004.pdf" target="_blank" rel="noopener noreferrer" style="color:#7CB342">NJ Department of Environmental Protection formally identified Camden as an urban heat island</a> — dense brick and asphalt amplifying temperatures well beyond surrounding suburbs. And with one of New Jersey’s highest crime rates, security film is one of our most-requested installs here.</p>
      <ul class="cam-why__bullets">
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Summer highs of 88–94°F with 72–74% humidity make south- and west-facing glass uncomfortable and costly without solar control film
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Camden’s urban heat island effect — documented by the NJ DEP — means buildings absorb and retain more heat than surrounding communities
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
Camden's crime rate of 45 per 1,000 residents makes security and anti-smash film one of the highest-ROI installs we do in the area
        </li>
      </ul>
      <div class="cam-why__climate-facts">
        <div class="cam-why__climate-item">
          <span class="cam-why__climate-num">88°F</span>
          <span class="cam-why__climate-label"><a href="https://www.weather-us.com/en/new-jersey-usa/camden-climate" target="_blank" rel="noopener noreferrer" style="color:#7CB342">Avg summer high in Camden</a></span>
        </div>
        <div class="cam-why__climate-item">
          <span class="cam-why__climate-num">45/1K</span>
          <span class="cam-why__climate-label">Crime rate per 1,000 residents (FBI)</span>
        </div>
        <div class="cam-why__climate-item">
          <span class="cam-why__climate-num">72–74%</span>
          <span class="cam-why__climate-label">Relative humidity in peak summer months</span>
        </div>
      </div>
      <p class="cam-why__closing">Since 2008, Window Film Philadelphia has served Camden homeowners and businesses — solar control, security, and decorative film installed by certified technicians with a lifetime warranty on every job.</p>
      <a href="/contact/" class="cam-why__cta">
        Get a free Camden assessment
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
      </a>
    </div>

  </div>
</section>

<!-- ══ RESIDENTIAL + COMMERCIAL SLIDER ══ -->
<section class="cam-prop-slider" id="camSlider">
  <div class="cam-prop-slider__track" id="camTrack">

    <!-- SLIDE 01: Commercial -->
    <div class="cam-prop-slider__slide" data-slide="0">
      <img src="/images/window-film-camden-nj-commercial.jpg" alt="Modern commercial office in Camden NJ with floor-to-ceiling windows — window film for South Jersey commercial properties" class="cam-prop-slider__bg" loading="lazy" />
      <div class="cam-prop-slider__overlay"></div>
      <div class="cam-prop-slider__content">
        <div class="cam-prop-slider__step">01</div>
        <h2 class="cam-prop-slider__title">Commercial Window Film
in Camden, NJ</h2>
        <p class="cam-prop-slider__desc">From Ferry Avenue storefronts to Cooper University Health Care facilities to waterfront office buildings — we install window film across the full range of Camden commercial properties. Solar control, security, anti-graffiti, and decorative film all available.</p>
        <ul class="cam-prop-slider__benefits">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Solar control film cuts cooling costs 25–35% in South Jersey commercial buildings
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Security film protects storefronts from smash-and-grab and holds glass on impact
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Anti-graffiti film protects glass surfaces from etching, scratching, and tagging
          </li>
        </ul>
        <a href="/contact/" class="cam-prop-slider__cta">Get a commercial estimate →</a>
      </div>
    </div>

    <!-- SLIDE 02: Residential -->
    <div class="cam-prop-slider__slide" data-slide="1">
      <img src="/images/window-film-camden-nj-residential-rowhouses.jpg" alt="Brick rowhouses in Camden NJ — solar control and security window film for South Jersey residential homes" class="cam-prop-slider__bg" loading="lazy" />
      <div class="cam-prop-slider__overlay"></div>
      <div class="cam-prop-slider__content">
        <div class="cam-prop-slider__step">02</div>
        <h2 class="cam-prop-slider__title">Residential Window Film
in Camden, NJ</h2>
        <p class="cam-prop-slider__desc">From Cramer Hill rowhouses to Cherry Hill colonials to waterfront condos — we install window film across every residential property type in the Camden area. Solar control, security, UV protection, privacy, and decorative film all available.</p>
        <ul class="cam-prop-slider__benefits">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Solar control film cuts afternoon heat gain up to 78% through south- and west-facing glass
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Security film holds rowhouse ground-floor windows together on impact
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Blocks 99% of UV — protects hardwood floors, furniture, and artwork from fading
          </li>
        </ul>
        <a href="/contact/" class="cam-prop-slider__cta">Get a residential estimate →</a>
      </div>
    </div>

  </div>

  <!-- Right nav -->
  <nav class="cam-prop-slider__nav" aria-label="Property type navigation">
    <button class="cam-prop-slider__nav-item cam-prop-slider__nav-item--active" data-campropnav="0">
      <span class="cam-prop-slider__nav-line"></span>
      <span class="cam-prop-slider__nav-label">Commercial</span>
    </button>
    <button class="cam-prop-slider__nav-item" data-campropnav="1">
      <span class="cam-prop-slider__nav-line"></span>
      <span class="cam-prop-slider__nav-label">Residential</span>
    </button>
  </nav>

  <!-- Arrows -->
  <button class="cam-prop-slider__arrow cam-prop-slider__arrow--prev" id="camPropPrev" aria-label="Previous">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
  </button>
  <button class="cam-prop-slider__arrow cam-prop-slider__arrow--next" id="camPropNext" aria-label="Next">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
  </button>

</section>

<!-- ══ APPLICATIONS GRID ══ -->
<section class="cam-apps">
  <div class="cam-apps__container">
    <div class="cam-apps__header">
      <div class="cam-apps__eyebrow">Applications</div>
      <h2 class="cam-apps__title">Window Film for Every Camden Building</h2>
      <p class="cam-apps__intro">From Cooper University Health Care to Cramer Hill rowhouses to Rutgers-Camden — window film delivers measurable benefits across every property type in the Camden area.</p>
    </div>
    <div class="cam-apps__grid">

      <div class="cam-app-card" style="background-image: url('/images/window-film-camden-nj-app-homes.jpg')">
        <div class="cam-app-card__overlay"></div>
        <div class="cam-app-card__content">
          <h3 class="cam-app-card__title">Homes &amp; Rowhouses</h3>
          <p class="cam-app-card__text">Solar control cuts summer heat in Cramer Hill row homes. Security film protects ground-floor windows in every Camden neighborhood.</p>
          <span class="cam-app-card__stat">Up to 78% heat blocked</span>
        </div>
      </div>

      <div class="cam-app-card" style="background-image: url('/images/window-film-camden-nj-app-offices.jpg')">
        <div class="cam-app-card__overlay"></div>
        <div class="cam-app-card__content">
          <h3 class="cam-app-card__title">Commercial Offices</h3>
          <p class="cam-app-card__text">Glare-free workspaces and lower cooling bills for Camden’s commercial corridor. Spectrally selective film preserves city views.</p>
          <span class="cam-app-card__stat">25–35% cost reduction</span>
        </div>
      </div>

      <div class="cam-app-card" style="background-image: url('/images/window-film-camden-nj-app-retail.jpg')">
        <div class="cam-app-card__overlay"></div>
        <div class="cam-app-card__content">
          <h3 class="cam-app-card__title">Retail &amp; Storefronts</h3>
          <p class="cam-app-card__text">Security film holds glass together on impact — protecting Ferry Ave storefronts from smash-and-grab. Anti-graffiti film shields against etching and tagging.</p>
          <span class="cam-app-card__stat">Impact resistant</span>
        </div>
      </div>

      <div class="cam-app-card" style="background-image: url('/images/window-film-camden-nj-app-healthcare.jpg')">
        <div class="cam-app-card__overlay"></div>
        <div class="cam-app-card__content">
          <h3 class="cam-app-card__title">Healthcare Facilities</h3>
          <p class="cam-app-card__text">UV film protects patients and staff at Cooper University Health Care and surrounding medical offices. Frosted film adds privacy for patient rooms and exam areas.</p>
          <span class="cam-app-card__stat">99% UV blocked</span>
        </div>
      </div>

      <div class="cam-app-card" style="background-image: url('/images/window-film-camden-nj-app-schools.jpg')">
        <div class="cam-app-card__overlay"></div>
        <div class="cam-app-card__content">
          <h3 class="cam-app-card__title">Schools &amp; Universities</h3>
          <p class="cam-app-card__text">Safety film for Rutgers-Camden and Camden City School District buildings. Reduces glare in classrooms and blocks UV that fades displays, artwork, and flooring.</p>
          <span class="cam-app-card__stat">Safety &amp; UV rated</span>
        </div>
      </div>

      <div class="cam-app-card" style="background-image: url('/images/window-film-camden-nj-app-government.jpg')">
        <div class="cam-app-card__overlay"></div>
        <div class="cam-app-card__content">
          <h3 class="cam-app-card__title">Government Buildings</h3>
          <p class="cam-app-card__text">Security and blast-resistant film for Camden County government facilities. Privacy film for offices handling sensitive records and public services.</p>
          <span class="cam-app-card__stat">GSA compliant films</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ══ FILM TYPES ══ -->
<section class="cam-films" id="film-types">

  <div class="cam-films__header">
    <p class="cam-films__eyebrow">FILM TYPES</p>
    <h2 class="cam-films__title">Window Film Solutions for Camden Properties</h2>
    <p class="cam-films__sub">Select a film type to learn more</p>
  </div>

  <div class="cam-films__main">

    <!-- LEFT: Tab list -->
    <div class="cam-films__tabs">
      <button class="cam-films__tab cam-films__tab--active" data-camtab="energy">
        <svg class="cam-films__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/></svg>
        <span>Energy Savings</span>
      </button>
      <button class="cam-films__tab" data-camtab="uv">
        <svg class="cam-films__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>UV Protection</span>
      </button>
      <button class="cam-films__tab" data-camtab="privacy">
        <svg class="cam-films__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
        <span>Privacy Film</span>
      </button>
      <button class="cam-films__tab" data-camtab="glare">
        <svg class="cam-films__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6M5.64 5.64l4.24 4.24m4.24 4.24l4.24 4.24M1 12h6m6 0h6M5.64 18.36l4.24-4.24m4.24-4.24l4.24-4.24"/></svg>
        <span>Glare Reduction</span>
      </button>
      <button class="cam-films__tab" data-camtab="graffiti">
        <svg class="cam-films__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>Anti-Graffiti</span>
      </button>
      <button class="cam-films__tab" data-camtab="safety">
        <svg class="cam-films__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
        <span>Safety &amp; Security</span>
      </button>
      <button class="cam-films__tab" data-camtab="decorative">
        <svg class="cam-films__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span>Decorative Film</span>
      </button>
      <button class="cam-films__tab" data-camtab="solar">
        <svg class="cam-films__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/></svg>
        <span>Solar Control</span>
      </button>
    </div>

    <!-- RIGHT: Content area -->
    <div class="cam-films__content">

      <!-- Image area -->
      <div class="cam-films__images">
        <div class="cam-films__img-set cam-films__img-set--active" data-camtab="energy">
          <img src="/images/window-film-camden-film-energy.jpg" alt="Energy-saving window film in a Camden NJ rowhouse living room — natural light filtered, cooler interior" class="cam-films__img" loading="lazy" />
        </div>
        <div class="cam-films__img-set" data-camtab="uv">
          <img src="/images/window-film-camden-film-uv.jpg" alt="UV-blocking window film protecting a South Jersey home interior from sun damage and fading" class="cam-films__img" loading="lazy" />
        </div>
        <div class="cam-films__img-set" data-camtab="privacy">
          <img src="/images/window-film-camden-film-privacy.jpg" alt="Frosted privacy window film on a conference room partition in a Camden NJ office" class="cam-films__img" loading="lazy" />
        </div>
        <div class="cam-films__img-set" data-camtab="glare">
          <img src="/images/window-film-camden-film-glare.jpg" alt="Camden NJ office worker at computer desk near window with no screen glare after window film installation" class="cam-films__img" loading="lazy" />
        </div>
        <div class="cam-films__img-set" data-camtab="graffiti">
          <img src="/images/window-film-camden-film-graffiti.jpg" alt="Clean commercial storefront glass in South Jersey protected by anti-graffiti window film" class="cam-films__img" loading="lazy" />
        </div>
        <div class="cam-films__img-set" data-camtab="safety">
          <img src="/images/window-film-camden-film-safety.jpg" alt="Secure commercial building entrance in Camden NJ with safety and security window film on glass doors" class="cam-films__img" loading="lazy" />
        </div>
        <div class="cam-films__img-set" data-camtab="decorative">
          <img src="/images/window-film-camden-film-decorative.jpg" alt="Decorative frosted glass pattern on a partition wall in a Camden NJ office or lobby" class="cam-films__img" loading="lazy" />
        </div>
        <div class="cam-films__img-set" data-camtab="solar">
          <img src="/images/window-film-camden-film-solar.jpg" alt="Solar control window film on a modern South Jersey commercial office building exterior" class="cam-films__img" loading="lazy" />
        </div>
      </div>

      <!-- Panel area -->
      <div class="cam-films__panels">

        <div class="cam-films__panel cam-films__panel--active" data-camtab="energy">
          <h3 class="cam-films__panel-title">Lower Your Cooling Bills Through Camden Summers</h3>
          <ul class="cam-films__panel-list">
