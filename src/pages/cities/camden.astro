---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import AccordionBenefits from '../../components/AccordionBenefits.astro';
import AccordionFAQ from '../../components/AccordionFAQ.astro';
import GalleryBanner from '../../components/GalleryBanner.astro';
import TestimonialSpotlight from '../../components/TestimonialSpotlight.astro';
import CtaLightRays from '../../components/CtaLightRays.astro';
import ScrollReveal from '../../components/animations/ScrollReveal.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import CategoryBlogFeed from '../../components/CategoryBlogFeed.astro';

const title = 'Window Film Camden NJ | Window Film Contractor Camden';
const description = 'Window film installation in Camden, NJ — solar control, security, privacy, and decorative film for homes and businesses.';

const filmBenefits = [
  {
    number: '01',
    title: 'Energy Savings',
    detail: `<p>Camden's urban heat island pushes summer highs past 88°F. Solar control film blocks up to <strong>78% of solar heat</strong> before it enters your space. South Jersey rowhouses with west-facing glass can see interior temperature drops of 10–15°F on peak summer days.</p><ul><li>Reduces HVAC run time and cooling costs</li><li>Most Camden homeowners see measurable bill reductions within the first summer</li><li>Low-E film also cuts winter heating loss through glass — year-round savings for older building stock</li></ul>`,
    image: '/images/window-film-camden-film-energy.jpg',
    imageAlt: 'Energy-saving window film in a Camden NJ rowhouse living room — natural light filtered, cooler interior',
  },
  {
    number: '02',
    title: 'UV Protection',
    detail: `<p>Delaware River humidity combined with South Jersey sun accelerates UV damage to flooring, furniture, and artwork. UV film blocks <strong>99% of UV-A and UV-B rays</strong> — the primary cause of fading in hardwood floors, rugs, drapes, and upholstery.</p><ul><li>Critical for healthcare facilities like Cooper University Health Care</li><li>Optically clear — no visible tint, no impact on natural light or views</li><li>Reduces fading by up to 60% compared to unprotected glass</li></ul>`,
    image: '/images/window-film-camden-film-uv.jpg',
    imageAlt: 'UV-blocking window film protecting a South Jersey home interior from sun damage and fading',
  },
  {
    number: '03',
    title: 'Privacy Film',
    detail: `<p>Camden's dense urban layout puts homes and ground-floor offices in close view of pedestrians and neighboring buildings. Privacy film solves this <strong>without sacrificing natural light</strong>.</p><ul><li>Waterfront condo buildings benefit from one-way reflective film that preserves Delaware River views</li><li>Frosted film for healthcare exam rooms, legal offices, and conference rooms</li><li>Available in clear frosted, custom patterns, gradient, and branded designs — all fully removable</li></ul>`,
    image: '/images/window-film-camden-film-privacy.jpg',
    imageAlt: 'Frosted privacy window film on a conference room partition in a Camden NJ office',
  },
  {
    number: '04',
    title: 'Safety & Security',
    detail: `<p>With a crime rate of 45 per 1,000 residents, Camden businesses and homeowners face real smash-and-grab risk. Security film <strong>holds glass together on impact</strong>, significantly slowing forced entry.</p><ul><li>Prevents glass from shattering into shards during break-ins, accidents, or severe weather</li><li>Government and institutional facilities use security film to meet ANSI and GSA glass safety standards</li><li>Bomb blast mitigation configurations available for federal-standard secured facilities</li></ul>`,
    image: '/images/window-film-camden-film-safety.jpg',
    imageAlt: 'Secure commercial building entrance in Camden NJ with safety and security window film on glass doors',
  },
  {
    number: '05',
    title: 'Anti-Graffiti',
    detail: `<p>Camden's high crime rate makes glass etching and acid graffiti a real cost for businesses along Ferry Avenue, Broadway, and the Route 38 corridor. Anti-graffiti film acts as a <strong>sacrificial layer</strong> — when tagged or etched, you replace the film, not the expensive glass panel.</p><ul><li>Each replacement costs a fraction of glass replacement</li><li>Most business owners recoup the initial film cost within 1–2 incidents prevented</li><li>Available in clear or lightly tinted versions — invisible protection</li></ul>`,
    image: '/images/window-film-camden-film-graffiti.jpg',
    imageAlt: 'Clean commercial storefront glass in South Jersey protected by anti-graffiti window film',
  },
  {
    number: '06',
    title: 'Glare Reduction',
    detail: `<p>East- and west-facing rowhouse windows in Cramer Hill, Parkside, and Whitman Park create peak glare during morning and afternoon work hours. Glare reduction film filters up to <strong>85% of glare-causing visible light</strong> while preserving natural daylight.</p><ul><li>Conference rooms and open offices benefit immediately — screens and monitors become fully visible</li><li>Compatible with all glass types, including single-pane windows common in Camden's older building stock</li></ul>`,
    image: '/images/window-film-camden-film-glare.jpg',
    imageAlt: 'Camden NJ office worker at computer desk near window with no screen glare after window film installation',
  },
  {
    number: '07',
    title: 'Decorative Film',
    detail: `<p>Camden's waterfront development and Cooper Grant revitalization have brought new commercial and residential spaces that benefit from decorative glass design. Frosted, patterned, and gradient films create an <strong>etched-glass appearance at a fraction of the cost</strong>.</p><ul><li>Branded window graphics for Camden businesses — logos, signage, and custom patterns</li><li>Ideal for healthcare waiting rooms, law firm lobbies, and school libraries</li><li>Fully removable without permanent modification to the glass</li></ul>`,
    image: '/images/window-film-camden-film-decorative.jpg',
    imageAlt: 'Decorative frosted glass pattern on a partition wall in a Camden NJ office or lobby',
  },
  {
    number: '08',
    title: 'Solar Control',
    detail: `<p>Solar control film is the broadest-purpose film we install in Camden — addressing heat gain, glare, and UV in a single application for homes, offices, retail, and institutional properties.</p><ul><li>Spectrally selective options preserve natural light and views while rejecting significant solar heat</li><li>Ceramic films contain no metal — safe for buildings with Wi-Fi, cellular, and sensitive electronic equipment</li><li>NFRC-rated films available with documented VLT, SHGC, and TSER specs for LEED and energy code compliance</li></ul>`,
    image: '/images/window-film-camden-film-solar.jpg',
    imageAlt: 'Solar control window film on a modern South Jersey commercial office building exterior',
  },
];

const faqItems = [
  { question: 'Is window film legal in New Jersey?', answer: 'Yes. New Jersey state law places no restrictions on residential or commercial architectural window film. You can install solar, privacy, decorative, security, or anti-graffiti film on any home or business without a permit. If your property is governed by a Camden HOA or falls within a historic district, your documents may include reflectivity guidelines — we carry non-reflective film options that meet most requirements and can assist with the approval process.' },
  { question: 'How much does window film cost in Camden, NJ?', answer: 'Pricing varies based on film type, glass area, number of windows, and site accessibility. Solar control, privacy, decorative, security, and anti-graffiti films each carry different price points — and every Camden property is different. Rather than estimate blindly, we offer free on-site consultations and provide a detailed written estimate tailored to your specific windows and goals. No pressure, no charge.' },
  { question: 'How long does window film installation take?', answer: 'Installation timelines depend on several factors: the number and size of windows, film type, glass accessibility, building layout, and site-specific conditions. A small residential project looks very different from a multi-floor commercial installation. During your free on-site consultation, we assess the full scope and give you a realistic timeline. We schedule around your routine and handle all cleanup.' },
  { question: 'What warranty comes with window film?', answer: 'Warranty terms vary by manufacturer and product line. Many leading brands — including 3M, LLumar, Vista, and Solar Gard — offer manufacturer warranties on their architectural window films covering defects such as peeling, bubbling, delamination, and color change. Coverage periods and specific terms differ by film, so we walk you through the warranty for whichever product you choose before installation.' },
  { question: 'How much heat does window film block in South Jersey summers?', answer: 'High-performance solar control films block up to 85% of solar heat gain — the primary driver of summer overheating in Camden and South Jersey. Summers here regularly reach the upper 80s to mid-90s°F with high humidity. Window film reduces hot spots near glass, lowers peak indoor temperatures, and cuts air-conditioning load, often reducing cooling energy costs by 20–30%. The U.S. Department of Energy notes that windows account for 25–30% of a building\'s total heating and cooling energy loss.' },
  { question: 'Does window film block UV rays?', answer: 'Yes. Most architectural window films block 99% or more of UV-A and UV-B radiation — even clear, low-reflectivity films. UV radiation is the leading cause of fading in hardwood floors, upholstery, artwork, and retail merchandise. It also contributes to skin damage with prolonged exposure near windows. UV-blocking film reduces fading by up to 60% compared to unprotected glass without significantly reducing visible light.' },
  { question: 'Can window film be removed later?', answer: 'Yes. Window film is professionally removable at any time with no permanent damage to the glass surface. The removal process uses heat and a mild adhesive solvent, leaving no scratches, marks, or residue. Renters, property managers, and owners who want a non-permanent upgrade often choose window film for exactly this flexibility.' },
  { question: 'Does window film work in winter, or only in summer?', answer: 'Both. Solar control film reduces heat gain in summer. Certain low-emissivity (low-e) films also retain interior heat in winter by reflecting radiant energy back into the room — the same principle behind double-pane Low-E glass. This dual-season benefit is valuable in Camden, where January temperatures regularly dip into the 20s°F. Year-round performance can reduce total HVAC energy use by 5–15%.' },
  { question: 'What is the difference between privacy film and solar control film?', answer: 'Solar control film is designed to reduce heat gain and glare while maintaining a clear outward view — it works by filtering infrared energy. Privacy film — including frosted, whiteout, and one-way mirror film — is designed to obscure the view into a space, either all day (frosted) or from one direction during daylight (one-way/reflective). Many Camden clients combine both: solar film on main living areas for energy savings, and frosted film on bathrooms, conference rooms, or street-facing glass for privacy.' },
  { question: 'Do you install anti-graffiti film on Camden commercial properties?', answer: 'Yes. Anti-graffiti film (also called sacrificial film) is a clear protective layer applied to exterior glass and smooth surfaces. When vandalism occurs, the damaged film is simply peeled off and replaced at a fraction of the cost of glass replacement. It is popular on Camden storefronts along Federal Street, Broadway, and the waterfront commercial corridor, where scratch and spray vandalism are recurring issues.' },
  { question: 'Will window film damage my windows or void their warranty?', answer: 'No — when professionally installed on standard single-pane, double-pane, or tempered glass. For sealed insulated glass units (IGUs), we select film types rated for that glass to prevent heat-stress buildup. Our installers verify the glass specification before recommending any product. Most major glass manufacturers do not void warranties when an IGU-rated film is correctly installed.' },
  { question: 'Is there a tax credit or rebate for window film in New Jersey?', answer: 'Potentially yes. The federal Inflation Reduction Act Section 25C tax credit covers qualifying building-envelope improvements — which can include energy-efficient window treatments — up to $1,200 per year for eligible residential projects. New Jersey\'s Clean Energy Program also offers rebates for commercial building efficiency upgrades. We recommend consulting a tax professional to confirm eligibility based on film specification and property type.' },
  { question: 'Do you offer free consultations in Camden, NJ?', answer: 'Yes. We offer free, no-obligation consultations at your home or business anywhere in Camden and throughout Camden County. During the visit we assess window type, sun exposure, and your goals, then provide a detailed written estimate. No pressure, no charge.' },
];

const today = new Date().toISOString().slice(0, 10);
const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': 'https://windowfilmphiladelphia.net/cities/camden/#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Cities We Serve', item: 'https://windowfilmphiladelphia.net/cities/' },
      { '@type': 'ListItem', position: 3, name: 'Window Film Camden NJ', item: 'https://windowfilmphiladelphia.net/cities/camden/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://windowfilmphiladelphia.net/cities/camden/#webpage',
    url: 'https://windowfilmphiladelphia.net/cities/camden/',
    name: title,
    description: description,
    inLanguage: 'en-US',
    isPartOf: { '@id': 'https://windowfilmphiladelphia.net/#website' },
    about: { '@type': 'City', name: 'Camden', containedInPlace: { '@type': 'State', name: 'New Jersey' } },
    dateModified: today,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.cam-hero__subtitle', '.faq__a-inner p'],
    },
    breadcrumb: { '@id': 'https://windowfilmphiladelphia.net/cities/camden/#breadcrumb' },
  },
];
---

<BaseLayout title={title} description={description} canonical="https://windowfilmphiladelphia.net/cities/camden/" faqItems={faqItems} schemas={pageSchemas}>

<!-- ══ HERO ══ -->
<section class="cam-hero">
  <div class="cam-hero__overlay"></div>
  <div class="cam-hero__container">
    <div class="cam-hero__label">WINDOW FILM INSTALLATION &middot; CAMDEN, NJ</div>
    <div class="cam-hero__content">
      <h1 class="cam-hero__title">Window Film Camden<br/>&mdash; South Jersey's Best</h1>
      <p class="cam-hero__subtitle">Professional residential and commercial window film installation in Camden, NJ and throughout South Jersey. Window film for Camden homes and businesses — free estimates, certified installers, lifetime warranty.</p>
      <div class="cam-hero__buttons">
        <a href="/contact/" class="btn-hero btn-hero--primary">Get Your Free Estimate &rarr;</a>
        <a href="tel:+12673947980" class="btn-hero btn-hero--secondary">Call (267) 394-7980</a>
      </div>
    </div>
    <div class="cam-hero__bottom">
      <div class="cam-hero__tagline">Trusted by Camden homeowners and businesses since 2008.</div>
      <div class="cam-hero__stats">
