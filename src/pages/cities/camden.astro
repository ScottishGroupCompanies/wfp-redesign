.hero-stat-item__number {
  font-family: 'Space Mono', monospace;
  font-size: 40px; font-weight: 700; color: #fff;
  line-height: 1; margin-bottom: 8px;
}
.hero-stat-item__number::after { content: '+'; font-size: 28px; margin-left: 4px; opacity: 0.7; }
.hero-stat-item:nth-child(3) .hero-stat-item__number::after { content: '%'; }
.hero-stat-item:nth-child(4) .hero-stat-item__number::after { content: '★'; color: #7CB342; }
.hero-stat-item__label { font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.1em; }

/* ── CAMDEN CINEMATIC HERO ── */
.cam-hero {
  position: relative;
  min-height: 88vh;
  display: flex;
  align-items: center;
  background-image: url('/images/window-film-camden-nj-hero.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  overflow: hidden;
}
.cam-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(13,26,15,0.5) 0%, rgba(13,26,15,0.45) 50%, rgba(13,26,15,0.75) 100%);
  z-index: 1;
}
.cam-hero__container {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 80px;
  min-height: 88vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.cam-hero__label {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #7CB342;
  padding-top: 140px;
}
.cam-hero__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 720px;
}
.cam-hero__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.5rem, 5vw, 3.5rem);
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
  margin-bottom: 24px;
}
.cam-hero__subtitle {
  font-family: 'Inter', sans-serif;
  font-size: 16px;
  line-height: 1.7;
  color: rgba(255,255,255,0.85);
  margin-bottom: 40px;
  max-width: 480px;
}
.cam-hero__buttons {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}
.cam-hero__bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-bottom: 60px;
  gap: 40px;
  flex-wrap: wrap;
}
.cam-hero__tagline {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  line-height: 1.6;
  color: rgba(255,255,255,0.7);
  max-width: 360px;
}
.cam-hero__stats {
  display: flex;
  gap: 60px;
  flex-wrap: wrap;
  justify-content: flex-end;
}
@media (max-width: 768px) {
  .cam-hero__container { padding: 0 24px; }
  .cam-hero__label { padding-top: 100px; }
  .cam-hero__bottom { flex-direction: column; gap: 24px; }
  .cam-hero__stats { justify-content: flex-start; gap: 32px; }
}

/* ── LOCAL CONTEXT SECTION (es-why pattern) ── */
.cam-why { background: #F3F6F1; padding: 100px 24px; }
.cam-why__container { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
.cam-why__image-wrap { position: relative; border-radius: 20px; overflow: visible; }
.cam-why__image { width: 100%; height: auto; display: block; border-radius: 20px; object-fit: cover; aspect-ratio: 4/5; }
.cam-why__stat-card { position: absolute; bottom: 32px; left: -24px; background: rgba(14,26,20,0.88); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 18px 22px; display: flex; flex-direction: column; gap: 10px; min-width: 220px; box-shadow: 0 12px 40px rgba(0,0,0,0.2); }
.cam-why__stat-item { display: flex; align-items: center; gap: 10px; font-family: 'Inter', sans-serif; font-size: 0.82rem; font-weight: 500; color: rgba(243,246,241,0.9); line-height: 1.3; }
.cam-why__stat-divider { height: 1px; background: rgba(255,255,255,0.08); margin: 2px 0; }
.cam-why__content { padding-right: 20px; }
.cam-why__eyebrow { display: inline-block; font-family: 'Inter', sans-serif; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #7CB342; margin-bottom: 16px; }
.cam-why__headline { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3.5vw, 2.75rem); font-weight: 700; color: #14201A; line-height: 1.2; margin-bottom: 24px; letter-spacing: -0.01em; }
.cam-why__intro { font-family: 'Inter', sans-serif; font-size: 1rem; color: #4A5C48; line-height: 1.8; margin-bottom: 28px; }
.cam-why__bullets { list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-direction: column; gap: 14px; }
.cam-why__bullets li { display: flex; align-items: flex-start; gap: 12px; font-family: 'Inter', sans-serif; font-size: 0.9rem; color: #4A5C48; line-height: 1.6; }
.cam-why__bullets svg { flex-shrink: 0; margin-top: 2px; }
.cam-why__climate-facts { display: flex; gap: 24px; margin: 28px 0; flex-wrap: wrap; }
.cam-why__climate-item { display: flex; flex-direction: column; gap: 4px; }
.cam-why__climate-num { font-family: 'Space Mono', monospace; font-size: 1.5rem; font-weight: 700; color: #7CB342; line-height: 1; }
.cam-why__climate-label { font-family: 'Inter', sans-serif; font-size: 0.75rem; color: #4A5C48; max-width: 140px; line-height: 1.4; }
.cam-why__closing { font-family: 'Inter', sans-serif; font-size: 0.85rem; font-style: italic; color: rgba(74,92,72,0.75); line-height: 1.7; margin-bottom: 32px; padding-left: 16px; border-left: 2px solid rgba(124,179,66,0.35); }
.cam-why__cta { display: inline-flex; align-items: center; gap: 8px; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; color: #7CB342; text-decoration: none; transition: gap 0.2s ease; }
.cam-why__cta:hover { gap: 14px; }
@media (max-width: 900px) { .cam-why__container { grid-template-columns: 1fr; } .cam-why__stat-card { left: 0; } }
@media (max-width: 600px) { .cam-why { padding: 60px 16px; } }

/* ── PROPERTY TYPE SLIDER ── */
.cam-prop-slider { position: relative; width: 100%; min-height: 88vh; overflow: hidden; background: #14201A; }
.cam-prop-slider__track { display: flex; width: 100%; height: 100%; transition: transform 0.6s cubic-bezier(0.4,0,0.2,1); }
.cam-prop-slider__slide { position: relative; min-width: 100%; min-height: 88vh; flex-shrink: 0; display: flex; align-items: center; }
.cam-prop-slider__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; z-index: 0; }
.cam-prop-slider__overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.80) 0%, rgba(0,0,0,0.25) 60%, transparent 100%); z-index: 1; }
.cam-prop-slider__content { position: relative; z-index: 2; max-width: 560px; padding-left: 80px; color: #fff; }
.cam-prop-slider__step { font-family: 'Space Mono', monospace; font-size: 13px; color: #7CB342; letter-spacing: 0.2em; margin-bottom: 1rem; }
.cam-prop-slider__title { font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 4vw, 3.25rem); font-weight: 700; color: #fff; line-height: 1.1; margin: 0 0 1.25rem; white-space: pre-line; }
.cam-prop-slider__desc { font-family: 'Inter', sans-serif; font-size: 16px; line-height: 1.8; color: rgba(255,255,255,0.85); max-width: 460px; margin-bottom: 1.75rem; }
.cam-prop-slider__benefits { list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: 14px; }
.cam-prop-slider__benefits li { display: flex; align-items: flex-start; gap: 12px; font-family: 'Inter', sans-serif; font-size: 0.9rem; color: rgba(255,255,255,0.88); line-height: 1.5; }
.cam-prop-slider__benefits svg { flex-shrink: 0; margin-top: 2px; }
.cam-prop-slider__cta { display: inline-block; background: #7CB342; color: #fff; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; padding: 14px 32px; border-radius: 9999px; text-decoration: none; transition: background 0.25s ease, transform 0.2s ease; }
.cam-prop-slider__cta:hover { background: #2E6B30; transform: translateY(-2px); color: #fff; }
.cam-prop-slider__nav { position: absolute; top: 50%; right: 48px; transform: translateY(-50%); z-index: 10; display: flex; flex-direction: column; gap: 24px; }
.cam-prop-slider__nav-item { display: flex; align-items: center; gap: 12px; background: transparent; border: none; cursor: pointer; padding: 0; opacity: 0.35; transition: opacity 0.3s ease; }
.cam-prop-slider__nav-item:hover { opacity: 0.65; }
.cam-prop-slider__nav-item--active { opacity: 1; }
.cam-prop-slider__nav-line { display: block; width: 3px; height: 32px; background: rgba(255,255,255,0.4); border-radius: 2px; transition: background 0.3s ease, height 0.3s ease; }
.cam-prop-slider__nav-item--active .cam-prop-slider__nav-line { background: #7CB342; height: 48px; }
.cam-prop-slider__nav-label { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 500; color: #fff; text-transform: uppercase; letter-spacing: 0.15em; }
.cam-prop-slider__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 10; width: 48px; height: 48px; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #fff; transition: background 0.3s, color 0.3s; }
.cam-prop-slider__arrow:hover { background: rgba(0,0,0,0.6); color: #7CB342; }
.cam-prop-slider__arrow--prev { left: 32px; }
.cam-prop-slider__arrow--next { right: 32px; }
@media (max-width: 768px) { .cam-prop-slider__content { padding-left: 24px; padding-right: 24px; } .cam-prop-slider__nav { display: none; } }

/* ── APPLICATIONS GRID ── */
.cam-apps { background: #F5F3EE; padding: 96px 0; }
.cam-apps__container { max-width: 1280px; margin: 0 auto; padding: 0 40px; }
.cam-apps__header { text-align: center; margin-bottom: 56px; }
.cam-apps__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin-bottom: 0.75rem; }
.cam-apps__title { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3vw, 2.75rem); font-weight: 700; color: #14201A; line-height: 1.2; margin: 0 0 1rem; }
.cam-apps__intro { font-family: 'Inter', sans-serif; font-size: 1rem; color: #4A5C48; max-width: 640px; margin: 0 auto; line-height: 1.75; }
.cam-apps__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.cam-app-card { position: relative; min-height: 380px; border-radius: 16px; overflow: hidden; background-size: cover; background-position: center; transition: all 0.4s cubic-bezier(0.4,0,0.2,1); cursor: pointer; }
.cam-app-card:hover { transform: translateY(-6px); box-shadow: 0 20px 56px rgba(13,26,15,0.25); }
.cam-app-card__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(13,26,15,0.92) 0%, rgba(13,26,15,0.55) 50%, rgba(13,26,15,0.3) 100%); transition: background 0.4s ease; z-index: 1; }
.cam-app-card:hover .cam-app-card__overlay { background: linear-gradient(to top, rgba(13,26,15,0.96) 0%, rgba(13,26,15,0.65) 50%, rgba(13,26,15,0.4) 100%); }
.cam-app-card__content { position: relative; z-index: 2; padding: 28px; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; }
.cam-app-card__title { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 700; color: #fff; margin-bottom: 10px; line-height: 1.2; }
.cam-app-card__text { font-family: 'Inter', sans-serif; font-size: 0.85rem; line-height: 1.65; color: rgba(255,255,255,0.82); margin-bottom: 16px; }
.cam-app-card__stat { display: inline-block; background: #7CB342; color: #fff; padding: 7px 18px; border-radius: 100px; font-family: 'Space Mono', monospace; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
@media (max-width: 1024px) { .cam-apps__grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .cam-apps__grid { grid-template-columns: 1fr; } .cam-apps__container { padding: 0 20px; } .cam-apps { padding: 60px 0; } }

/* ── FILM TYPES SECTION ── */
.cam-films { background: #0d1a0f; padding: 80px 0; }
.cam-films__header { text-align: center; padding: 0 24px 56px; }
.cam-films__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin-bottom: 0.75rem; }
.cam-films__title { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; color: #fff; line-height: 1.15; margin: 0 0 0.75rem; }
.cam-films__sub { font-family: 'Inter', sans-serif; font-size: 0.95rem; color: rgba(255,255,255,0.6); margin: 0; }
.cam-films__main { max-width: 1280px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: 260px 1fr; gap: 0; }
.cam-films__tabs { display: flex; flex-direction: column; border-right: 1px solid rgba(255,255,255,0.08); padding-right: 0; }
.cam-films__tab { display: flex; align-items: center; gap: 12px; background: transparent; border: none; border-left: 3px solid transparent; padding: 16px 24px; text-align: left; cursor: pointer; color: rgba(255,255,255,0.5); font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 500; transition: all 0.2s ease; }
.cam-films__tab:hover { color: rgba(255,255,255,0.85); background: rgba(255,255,255,0.04); }
.cam-films__tab--active { color: #fff; border-left-color: #7CB342; background: rgba(124,179,66,0.08); }
.cam-films__tab-icon { width: 18px; height: 18px; flex-shrink: 0; stroke: currentColor; }
.cam-films__content { padding-left: 48px; display: flex; flex-direction: column; gap: 0; }
.cam-films__images { margin-bottom: 32px; }
.cam-films__img-set { display: none; }
.cam-films__img-set--active { display: block; }
.cam-films__img { width: 100%; height: 300px; object-fit: cover; border-radius: 12px; display: block; }
.cam-films__panels { }
.cam-films__panel { display: none; }
.cam-films__panel--active { display: block; }
.cam-films__panel-title { font-family: 'Playfair Display', serif; font-size: clamp(1.4rem, 2.2vw, 1.9rem); font-weight: 700; color: #fff; line-height: 1.25; margin: 0 0 20px; }
.cam-films__panel-list { list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-direction: column; gap: 12px; }
.cam-films__panel-list li { font-family: 'Inter', sans-serif; font-size: 0.9rem; color: rgba(255,255,255,0.8); line-height: 1.65; padding-left: 20px; position: relative; }
.cam-films__panel-list li::before { content: ''; position: absolute; left: 0; top: 8px; width: 6px; height: 6px; border-radius: 50%; background: #7CB342; }
.cam-films__panel-stat { display: flex; align-items: baseline; gap: 12px; margin-bottom: 24px; padding: 16px 0; border-top: 1px solid rgba(255,255,255,0.1); border-bottom: 1px solid rgba(255,255,255,0.1); }
.cam-films__panel-stat-num { font-family: 'Space Mono', monospace; font-size: 2rem; font-weight: 700; color: #7CB342; line-height: 1; }
.cam-films__panel-stat-label { font-family: 'Inter', sans-serif; font-size: 0.8rem; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 0.08em; }
.cam-films__panel-cta { font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; color: #7CB342; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: gap 0.2s ease; }
.cam-films__panel-cta:hover { gap: 10px; }
@media (max-width: 900px) { .cam-films__main { grid-template-columns: 1fr; } .cam-films__tabs { flex-direction: row; flex-wrap: wrap; border-right: none; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0; } .cam-films__tab { border-left: none; border-bottom: 3px solid transparent; flex: 1; justify-content: center; padding: 12px 8px; font-size: 0.78rem; } .cam-films__tab--active { border-bottom-color: #7CB342; border-left-color: transparent; } .cam-films__content { padding-left: 0; padding-top: 32px; } }
@media (max-width: 600px) { .cam-films__main { padding: 0 20px; } .cam-films { padding: 60px 0; } }

/* ── BRANDS SECTION WRAPPER ── */
.cam-brands { background: #fff; padding-top: 72px; }
.cam-brands__header { text-align: center; padding: 0 24px 48px; }
.cam-brands__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin-bottom: 0.75rem; }
.cam-brands__title { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 700; color: #14201A; line-height: 1.2; margin: 0 0 1rem; }
.cam-brands__sub { font-family: 'Inter', sans-serif; font-size: 1rem; color: #4A5C48; max-width: 600px; margin: 0 auto; line-height: 1.75; }

/* ── PAGE BODY WRAPPER ── */
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* ── PAGE HERO ── */
.ip-hero {
  padding: 80px 10%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
  background: #fff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  overflow: hidden;
}
.ip-hero__content { padding-bottom: 0; }
.ip-hero__body { padding-bottom: 0; }

.ip-hero__eyebrow {
  display: inline-flex; align-items: center;
  background: transparent;
  border: 1.5px solid var(--green, #81AB4C);
  color: var(--green, #81AB4C);
  padding: 5px 14px; border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 12px; font-weight: 600; letter-spacing: 0.5px;
  text-transform: uppercase; margin-bottom: 20px; overflow: hidden;
}
.eyebrow-marquee {
  display: block; overflow: hidden; white-space: nowrap;
}
.eyebrow-marquee span {
  display: inline-block;
  animation: marquee-scroll 8s linear infinite;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 12px; font-weight: 600; letter-spacing: 0.5px;
  text-transform: uppercase;
}
@keyframes marquee-scroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.ip-hero h1 {
  font-family: var(--font-serif);
  font-size: clamp(40px, 5vw, 64px); font-weight: 600;
  line-height: 1.1; letter-spacing: -0.8px;
  color: var(--text-dark, #1a1a1a); margin-bottom: 20px;
}
.ip-hero h1 em { font-style: italic; color: var(--green, #81AB4C); }

.ip-hero__lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px; color: var(--text-mid, #4a4a4a);
  line-height: 1.75; max-width: 560px; margin-bottom: 32px;
}

.ip-hero__ctas { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-bottom: 32px; }

/* Buttons */
.ip-btn {
  display: inline-block; padding: 14px 28px;
  border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; font-weight: 500;
  text-decoration: none; transition: all 0.2s;
  border: 2px solid transparent; white-space: nowrap;
}
.ip-btn--primary { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.ip-btn--primary:hover { background: #6e9640; border-color: #6e9640; transform: translateY(-2px); color: #fff; }
.ip-btn--ghost { background: transparent; color: var(--brand, #272E32); border-color: var(--brand, #272E32); }
.ip-btn--ghost:hover { background: var(--brand, #272E32); color: #fff; transform: translateY(-2px); }
.ip-btn--white { background: #fff; color: var(--brand, #272E32); border-color: #fff; font-weight: 600; }
.ip-btn--white:hover { background: var(--off-white, #F7F6F3); transform: translateY(-2px); color: var(--brand, #272E32); }
.ip-btn--green { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.ip-btn--green:hover { background: #6e9640; transform: translateY(-2px); color: #fff; }

/* ── HERO IMAGE ── */
.ip-hero-img-wrap { padding: 32px 5% 0; }
.ip-hero-img {
  width: 100%; height: 380px;
  border-radius: var(--radius-xl, 40px); overflow: hidden; position: relative;
}
.ip-hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ip-hero-img__caption {
  position: absolute; bottom: 20px; left: 20px;
  background: rgba(255,255,255,0.92); backdrop-filter: blur(8px);
  padding: 10px 18px; border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px; font-weight: 600; color: var(--brand, #272E32);
}

/* ── GALLERY ── */
.ip-gallery {
  padding: 64px 5%;
  background: var(--off-white, #F7F6F3);
  margin: 0 5%;
  border-radius: var(--radius-xl, 40px);
}
.ip-gallery__header {
  text-align: center;
  margin-bottom: 40px;
}
.ip-gallery__header h2 {
  font-family: var(--font-serif);
  font-size: clamp(28px, 3.5vw, 42px);
  font-weight: 700;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
