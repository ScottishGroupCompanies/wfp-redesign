<script>
  // Film types tab switcher
  document.querySelectorAll('.cam-films__tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const key = tab.getAttribute('data-camtab');
      document.querySelectorAll('.cam-films__tab').forEach(t => t.classList.remove('cam-films__tab--active'));
      document.querySelectorAll('.cam-films__img-set').forEach(s => s.classList.remove('cam-films__img-set--active'));
      document.querySelectorAll('.cam-films__panel').forEach(p => p.classList.remove('cam-films__panel--active'));
      tab.classList.add('cam-films__tab--active');
      document.querySelector(`.cam-films__img-set[data-camtab="${key}"]`)?.classList.add('cam-films__img-set--active');
      document.querySelector(`.cam-films__panel[data-camtab="${key}"]`)?.classList.add('cam-films__panel--active');
    });
  });

  // Property type slider
  (function(){
    const track = document.getElementById('camTrack');
    const navItems = document.querySelectorAll('[data-campropnav]');
    const prev = document.getElementById('camPropPrev');
    const next = document.getElementById('camPropNext');
    if (!track) return;
    let cur = 0;
    const total = 2;
    function goTo(i) {
      cur = (i + total) % total;
      track.style.transform = `translateX(-${cur * 100}%)`;
      navItems.forEach((n, idx) => n.classList.toggle('cam-prop-slider__nav-item--active', idx === cur));
    }
    prev?.addEventListener('click', () => goTo(cur - 1));
    next?.addEventListener('click', () => goTo(cur + 1));
    navItems.forEach((n, i) => n.addEventListener('click', () => goTo(i)));
    goTo(0);
  })();

  // Count-up animation for hero stats
  const countUp = (el) => {
    const target = parseFloat(el.getAttribute('data-count') || '0');
    const isDecimal = target % 1 !== 0;
    const duration = 1800;
    const start = performance.now();
    const animate = (now) => {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const ease = 1 - Math.pow(1 - progress, 3);
      const value = target * ease;
      el.textContent = isDecimal ? value.toFixed(1) : Math.round(value).toLocaleString();
      if (progress < 1) requestAnimationFrame(animate);
    };
    requestAnimationFrame(animate);
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        countUp(entry.target);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });

  document.querySelectorAll('.hero-stat-item__number[data-count]').forEach(el => observer.observe(el));
</script>