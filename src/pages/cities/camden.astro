<script>
  // Brand card carousel
  (function() {
    const track = document.getElementById('brandsTrack');
    const dotsContainer = document.getElementById('brandsDots');
    const cards = track ? Array.from(track.querySelectorAll('.cam-brands__card')) : [];
    const visibleCount = () => window.innerWidth > 1100 ? 4 : window.innerWidth > 760 ? 3 : 1;
    let dots = [];
    function buildDots() {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      dots = [];
      const pages = Math.ceil(cards.length / visibleCount());
      for (let i = 0; i < pages; i++) {
        const d = document.createElement('button');
        d.className = 'cam-brands__dot' + (i === 0 ? ' cam-brands__dot--active' : '');
        d.setAttribute('aria-label', `Brand page ${i + 1}`);
        d.addEventListener('click', () => scrollToPage(i));
        dotsContainer.appendChild(d);
        dots.push(d);
      }
    }
    function scrollToPage(i) {
      if (!track || !cards[0]) return;
      const cardW = cards[0].getBoundingClientRect().width + 24;
      track.scrollTo({ left: i * visibleCount() * cardW, behavior: 'smooth' });
    }
    function updateDots() {
      if (!track || !cards[0]) return;
      const cardW = cards[0].getBoundingClientRect().width + 24;
      const page = Math.round(track.scrollLeft / (visibleCount() * cardW));
      dots.forEach((d, i) => d.classList.toggle('cam-brands__dot--active', i === page));
    }
    if (track) {
      track.addEventListener('scroll', updateDots, { passive: true });
      document.getElementById('brandsArrowLeft')?.addEventListener('click', () => { const cardW = cards[0]?.getBoundingClientRect().width + 24 || 300; track.scrollBy({ left: -(visibleCount() * cardW), behavior: 'smooth' }); });
      document.getElementById('brandsArrowRight')?.addEventListener('click', () => { const cardW = cards[0]?.getBoundingClientRect().width + 24 || 300; track.scrollBy({ left: visibleCount() * cardW, behavior: 'smooth' }); });
      // drag to scroll
      let isDown = false, startX = 0, scrollLeft = 0;
      track.addEventListener('mousedown', e => { isDown = true; startX = e.pageX - track.offsetLeft; scrollLeft = track.scrollLeft; });
      track.addEventListener('mouseleave', () => isDown = false);
      track.addEventListener('mouseup', () => isDown = false);
      track.addEventListener('mousemove', e => { if (!isDown) return; e.preventDefault(); const x = e.pageX - track.offsetLeft; track.scrollLeft = scrollLeft - (x - startX); });
    }
    buildDots();
    window.addEventListener('resize', buildDots);
  })();

  // Film types tab switcher
  document.querySelectorAll('.cam-films__tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const key = tab.getAttribute('data-camtab');
      document.querySelectorAll('.cam-films__tab').forEach(t => t.classList.remove('cam-films__tab--active'));
      document.querySelectorAll('.cam-films__img-set').forEach(s => s.classList.remove('cam-films__img-set--active'));
      document.querySelectorAll('.cam-films__panel').forEach(p => p.classList.remove('cam-films__panel--active'));
      tab.classList.add('cam-films__tab--active');
      document.querySelector(`.cam-films__img-set[data-camtab="${key}"]`)?.classList.add('cam-films__img-set--active');
      document.querySelector(`.cam-films__panel[data-camtab="${key}"]`)?.classList.add('cam-films__panel--active');
    });
  });

  // Property type slider
  (function(){
    const track = document.getElementById('camTrack');
    const navItems = document.querySelectorAll('[data-campropnav]');
    const prev = document.getElementById('camPropPrev');
    const next = document.getElementById('camPropNext');
    if (!track) return;
    let cur = 0;
    const total = 2;
    function goTo(i) {
      cur = (i + total) % total;
      track.style.transform = `translateX(-${cur * 100}%)`;
      navItems.forEach((n, idx) => n.classList.toggle('cam-prop-slider__nav-item--active', idx === cur));
    }
    prev?.addEventListener('click', () => goTo(cur - 1));
    next?.addEventListener('click', () => goTo(cur + 1));
    navItems.forEach((n, i) => n.addEventListener('click', () => goTo(i)));
    goTo(0);
  })();

  // Count-up animation for hero stats
  const countUp = (el) => {
    const target = parseFloat(el.getAttribute('data-count') || '0');
    const isDecimal = target % 1 !== 0;
    const duration = 1800;
    const start = performance.now();
    const animate = (now) => {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const ease = 1 - Math.pow(1 - progress, 3);
      const value = target * ease;
      el.textContent = isDecimal ? value.toFixed(1) : Math.round(value).toLocaleString();
      if (progress < 1) requestAnimationFrame(animate);
    };
    requestAnimationFrame(animate);
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        countUp(entry.target);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });

  document.querySelectorAll('.hero-stat-item__number[data-count]').forEach(el => observer.observe(el));

  // Line mask reveal
  const lineMaskObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target;
      el.style.setProperty('--line-stagger', (el.dataset.stagger || '120') + 'ms');
      el.classList.add('is-visible');
      lineMaskObserver.unobserve(el);
    });
  }, { threshold: 0.3 });
  document.querySelectorAll('.line-mask').forEach((el) => lineMaskObserver.observe(el));
</script>