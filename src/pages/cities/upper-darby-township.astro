</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // FAQ accordion
  document.querySelectorAll('.ip-faq__item').forEach(item => {
    item.addEventListener('click', () => {
      const isOpen = item.classList.contains('ip-faq__item--open');
      document.querySelectorAll('.ip-faq__item').forEach(i => i.classList.remove('ip-faq__item--open'));
      if (!isOpen) item.classList.add('ip-faq__item--open');
    });
  });

  // Fade-in on scroll
  const fadeEls = document.querySelectorAll('.fade-in');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('in-view'), i * 80);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  fadeEls.forEach(el => observer.observe(el));
});
</script>