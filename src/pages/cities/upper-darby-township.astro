.ud-films__panel-title { font-family: 'Playfair Display', serif; font-size: clamp(1.4rem, 2.2vw, 1.9rem); font-weight: 700; color: #fff; line-height: 1.25; margin: 0 0 20px; }
.ud-films__panel-list { list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-direction: column; gap: 12px; }
.ud-films__panel-list li { font-family: 'Inter', sans-serif; font-size: 0.9rem; color: rgba(255,255,255,0.8); line-height: 1.65; padding-left: 20px; position: relative; }
.ud-films__panel-list li::before { content: ''; position: absolute; left: 0; top: 8px; width: 6px; height: 6px; border-radius: 50%; background: #7CB342; }
.ud-films__panel-stat { display: flex; align-items: baseline; gap: 12px; margin-bottom: 24px; padding: 16px 0; border-top: 1px solid rgba(255,255,255,0.1); border-bottom: 1px solid rgba(255,255,255,0.1); }
.ud-films__panel-stat-num { font-family: 'Space Mono', monospace; font-size: 2rem; font-weight: 700; color: #7CB342; line-height: 1; }
.ud-films__panel-stat-label { font-family: 'Inter', sans-serif; font-size: 0.8rem; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 0.08em; }
.ud-films__panel-cta { font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; color: #7CB342; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: gap 0.2s ease; }
.ud-films__panel-cta:hover { gap: 10px; }
@media (max-width: 900px) { .ud-films__main { grid-template-columns: 1fr; } .ud-films__tabs { flex-direction: row; flex-wrap: wrap; border-right: none; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0; } .ud-films__tab { border-left: none; border-bottom: 3px solid transparent; flex: 1; justify-content: center; padding: 12px 8px; font-size: 0.78rem; } .ud-films__tab--active { border-bottom-color: #7CB342; border-left-color: transparent; } .ud-films__content { padding-left: 0; padding-top: 32px; } }
@media (max-width: 600px) { .ud-films__main { padding: 0 20px; } .ud-films { padding: 60px 0; } }

/* ── TRUSTED EXPERTS SECTION ── */
.ud-expert { background: #fff; padding: 96px 0; }
.ud-expert__container { max-width: 1280px; margin: 0 auto; padding: 0 80px; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
.ud-expert__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin: 0 0 20px; }
.ud-expert__title { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 700; color: #14201A; line-height: 1.15; margin: 0 0 28px; letter-spacing: -0.02em; }
.ud-expert__body { font-family: 'Inter', sans-serif; font-size: 1rem; color: #4A5C48; line-height: 1.8; margin: 0 0 20px; }
.ud-expert__stats { display: flex; align-items: center; gap: 32px; margin-top: 40px; padding-top: 40px; border-top: 1px solid #e8ede6; }
.ud-expert__stat { display: flex; flex-direction: column; gap: 6px; }
.ud-expert__stat-num { font-family: 'Space Mono', monospace; font-size: 2rem; font-weight: 700; color: #7CB342; line-height: 1; }
.ud-expert__stat-label { font-family: 'Inter', sans-serif; font-size: 0.8rem; color: #4A5C48; }
.ud-expert__stat-divider { width: 1px; height: 52px; background: #d0dace; flex-shrink: 0; }
.ud-expert__image-col { position: relative; }
.ud-expert__img { width: 100%; height: 560px; object-fit: cover; border-radius: 20px; display: block; }
@media (max-width: 960px) { .ud-expert__container { grid-template-columns: 1fr; padding: 0 32px; } .ud-expert { padding: 64px 0; } .ud-expert__img { height: 400px; } }
@media (max-width: 600px) { .ud-expert__container { padding: 0 20px; } .ud-expert__stats { gap: 20px; } }

/* ── TRUST / WHY US SECTION ── */
.ud-trust { background: #F5F3EE; padding: 96px 0; }
.ud-trust__container { max-width: 1280px; margin: 0 auto; padding: 0 80px; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
.ud-trust__image-col { position: relative; }
.ud-trust__img { width: 100%; height: 680px; object-fit: cover; object-position: top center; border-radius: 20px; display: block; }
.ud-trust__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin: 0 0 20px; }
.ud-trust__title { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 3vw, 2.75rem); font-weight: 700; color: #14201A; line-height: 1.2; margin: 0 0 40px; letter-spacing: -0.02em; }
.ud-trust__items { display: flex; flex-direction: column; }
.ud-trust__item { display: flex; align-items: flex-start; gap: 16px; padding: 20px 0; border-bottom: 1px solid #ddd8d0; }
.ud-trust__item:first-child { border-top: 1px solid #ddd8d0; }
.ud-trust__check { flex-shrink: 0; margin-top: 1px; }
.ud-trust__item-body { flex: 1; }
.ud-trust__item-title { font-family: 'Inter', sans-serif; font-size: 0.95rem; font-weight: 600; color: #14201A; margin: 0; line-height: 1.5; }
.ud-trust__cta { display: inline-flex; align-items: center; gap: 8px; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; color: #7CB342; text-decoration: none; margin-top: 36px; transition: gap 0.2s ease; }
.ud-trust__cta:hover { gap: 14px; }
@media (max-width: 960px) { .ud-trust__container { grid-template-columns: 1fr; padding: 0 32px; } .ud-trust { padding: 64px 0; } .ud-trust__img { height: 400px; } }
@media (max-width: 600px) { .ud-trust__container { padding: 0 20px; } }

/* ── BRANDS SECTION WRAPPER ── */
.ud-brands { background: #fff; padding-top: 72px; padding-bottom: 72px; }
.ud-brands__header { text-align: center; padding: 0 24px 48px; }
.ud-brands__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin-bottom: 0.75rem; }
.ud-brands__title { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 700; color: #14201A; line-height: 1.2; margin: 0 0 1rem; }
.ud-brands__sub { font-family: 'Inter', sans-serif; font-size: 1rem; color: #4A5C48; max-width: 600px; margin: 0 auto; line-height: 1.75; }

/* ── Brand card carousel ── */
.ud-brands__carousel-outer {
  position: relative;
  padding: 48px 80px 0;
  max-width: 1440px;
  margin: 0 auto;
}
.ud-brands__carousel {
  display: flex;
  gap: 24px;
  overflow-x: scroll;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  cursor: grab;
}
.ud-brands__carousel::-webkit-scrollbar { display: none; }
.ud-brands__carousel:active { cursor: grabbing; }
.ud-brands__card {
  flex: 0 0 calc(25% - 18px);
  scroll-snap-align: start;
  background: #fff;
  border: 1px solid #e8ede6;
  border-radius: 12px;
  overflow: hidden;
}
.ud-brands__card-photo {
  width: 100%;
  height: 280px;
  object-fit: cover;
  display: block;
}
.ud-brands__card-body {
  padding: 20px 22px 24px;
}
.ud-brands__card-name {
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: #14201A;
  margin: 0 0 8px;
}
.ud-brands__card-desc {
  font-family: 'Inter', sans-serif;
  font-size: 0.88rem;
  color: #3a4a38;
  line-height: 1.6;
  margin: 0 0 12px;
}
.ud-brands__card-desc em { font-style: italic; }
.ud-brands__card-sub {
  font-family: 'Space Mono', monospace;
  font-size: 0.72rem;
  color: #7CB342;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 0;
}
.ud-brands__arrow {
  position: absolute;
  top: calc(48px + 140px);
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid #d8e4d4;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 2;
  color: #14201A;
  transition: box-shadow 0.2s ease;
}
.ud-brands__arrow:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.15); }
.ud-brands__arrow--left  { left: 24px; }
.ud-brands__arrow--right { right: 24px; }
.ud-brands__dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  padding-top: 32px;
}
.ud-brands__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #d0dace;
  border: none;
  padding: 0;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
}
.ud-brands__dot--active {
  background: #7CB342;
  transform: scale(1.3);
}
@media (max-width: 1100px) {
  .ud-brands__card { flex: 0 0 calc(33.33% - 16px); }
}
@media (max-width: 760px) {
  .ud-brands__card { flex: 0 0 calc(80% - 12px); }
  .ud-brands__carousel-outer { padding: 48px 24px 0; }
  .ud-brands__arrow { display: none; }
}

/* ── PAGE BODY WRAPPER ── */
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
}

/* ── PAGE HERO ── */
.ip-hero {
  padding: 80px 10%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
  background: #fff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  overflow: hidden;
}
.ip-hero__content { padding-bottom: 0; }
.ip-hero__body { padding-bottom: 0; }

.ip-hero__eyebrow {
  display: inline-flex; align-items: center;
  background: transparent;
  border: 1.5px solid var(--green, #81AB4C);
  color: var(--green, #81AB4C);
  padding: 5px 14px; border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 12px; font-weight: 600; letter-spacing: 0.5px;
  text-transform: uppercase; margin-bottom: 20px; overflow: hidden;
}
.eyebrow-marquee {
  display: block; overflow: hidden; white-space: nowrap;
}
.eyebrow-marquee span {
  display: inline-block;
  animation: marquee-scroll 8s linear infinite;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 12px; font-weight: 600; letter-spacing: 0.5px;
  text-transform: uppercase;
}
@keyframes marquee-scroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.ip-hero h1 {
  font-family: var(--font-serif);
  font-size: clamp(40px, 5vw, 64px); font-weight: 600;
  line-height: 1.1; letter-spacing: -0.8px;
  color: var(--text-dark, #1a1a1a); margin-bottom: 20px;
}
.ip-hero h1 em { font-style: italic; color: var(--green, #81AB4C); }

.ip-hero__lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px; color: var(--text-mid, #4a4a4a);
  line-height: 1.75; max-width: 560px; margin-bottom: 32px;
}

.ip-hero__ctas { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-bottom: 32px; }

/* Buttons */
.ip-btn {
  display: inline-block; padding: 14px 28px;
  border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; font-weight: 500;
  text-decoration: none; transition: all 0.2s;
  border: 2px solid transparent; white-space: nowrap;
}
.ip-btn--primary { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.ip-btn--primary:hover { background: #6e9640; border-color: #6e9640; transform: translateY(-2px); color: #fff; }
.ip-btn--ghost { background: transparent; color: var(--brand, #272E32); border-color: var(--brand, #272E32); }
.ip-btn--ghost:hover { background: var(--brand, #272E32); color: #fff; transform: translateY(-2px); }
.ip-btn--white { background: #fff; color: var(--brand, #272E32); border-color: #fff; font-weight: 600; }
.ip-btn--white:hover { background: var(--off-white, #F7F6F3); transform: translateY(-2px); color: var(--brand, #272E32); }
.ip-btn--green { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.ip-btn--green:hover { background: #6e9640; transform: translateY(-2px); color: #fff; }

/* ── HERO IMAGE ── */
.ip-hero-img-wrap { padding: 32px 5% 0; }
.ip-hero-img {
  width: 100%; height: 380px;
  border-radius: var(--radius-xl, 40px); overflow: hidden; position: relative;
}
.ip-hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ip-hero-img__caption {
  position: absolute; bottom: 20px; left: 20px;
  background: rgba(255,255,255,0.92); backdrop-filter: blur(8px);
  padding: 10px 18px; border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px; font-weight: 600; color: var(--brand, #272E32);
}

/* ── GALLERY ── */
/* ── CAM MASONRY GALLERY ── */
.ud-masonry { background: #F5F3EE; padding: 100px 0 80px; }
.ud-masonry__header { max-width: 1200px; margin: 0 auto 56px; padding: 0 40px; text-align: center; }
.ud-masonry__eyebrow { display: block; font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em; color: #7CB342; margin-bottom: 16px; }
.ud-masonry__title { font-family: var(--font-serif, Georgia, serif); font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 700; color: #14201A; line-height: 1.2; margin: 0 0 16px; letter-spacing: -0.01em; }
.ud-masonry__sub { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 1rem; color: #4A5C48; max-width: 560px; margin: 0 auto; line-height: 1.7; }
.ud-masonry__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 1200px; margin: 0 auto; padding: 0 40px; }
.ud-masonry__item { position: relative; border-radius: 12px; overflow: hidden; cursor: pointer; }
.ud-masonry__item img { width: 100%; height: 320px; object-fit: cover; display: block; border-radius: 12px; transition: transform 0.4s ease; }
.ud-masonry__item:hover img { transform: scale(1.03); }
.ud-masonry__caption { position: absolute; bottom: 0; left: 0; right: 0; padding: 32px 16px 14px; background: linear-gradient(to top, rgba(13,26,15,0.75) 0%, transparent 100%); font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 12px; font-weight: 500; color: rgba(255,255,255,0.9); border-radius: 0 0 12px 12px; opacity: 0; transition: opacity 0.3s ease; }
.ud-masonry__item:hover .ud-masonry__caption { opacity: 1; }

/* ── CONTENT + SIDEBAR ── */
.ip-content-wrap {
  padding: 0 5%;
  display: grid; grid-template-columns: 1fr 420px;
  gap: 60px; align-items: start;
}
.ip-main { padding: 64px 0; }
.ip-sidebar { padding: 64px 0; }

/* Prose */
.prose h2 {
  font-family: var(--font-serif);
  font-size: clamp(28px, 3.5vw, 42px);
  font-weight: 700;
  letter-spacing: -0.5px;
  line-height: 1.15;
  color: var(--text-dark, #1a1a1a); margin: 48px 0 20px;
}
.prose h2:first-child { margin-top: 0; }
.prose p {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px; color: var(--text-mid, #4a4a4a); line-height: 1.8; margin-bottom: 18px;
}
.prose ul { list-style: none; padding: 0; margin-bottom: 18px; }
.prose ul li {
  display: flex; align-items: flex-start; gap: 10px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; color: var(--text-mid, #4a4a4a); padding: 5px 0; line-height: 1.6;
}
.prose ul li::before { content: '✓'; color: var(--green, #81AB4C); font-weight: 700; font-size: 13px; margin-top: 3px; flex-shrink: 0; }

/* Callout */
.ip-callout {
  background: var(--green-light, #eef4e4);
  border-left: 4px solid var(--green, #81AB4C);
  border-radius: 0 var(--radius-md, 16px) var(--radius-md, 16px) 0;
  padding: 20px 24px; margin: 32px 0;
}
.ip-callout p { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 15px; color: #3a5a1f; margin: 0; line-height: 1.7; }

/* Film grid */
.ip-film-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin: 24px 0 32px; }
.ip-film-card {
  background: var(--off-white, #F7F6F3);
  border-radius: var(--radius-lg, 24px); padding: 24px 20px;
  border: 2px solid transparent; transition: border-color 0.2s, transform 0.2s;
}
.ip-film-card:hover { border-color: var(--green, #81AB4C); transform: translateY(-2px); }
.ip-film-card--featured { border-color: var(--green, #81AB4C); background: var(--green-light, #eef4e4); }
.ip-film-icon {
  display: block;
  width: 50px; height: 50px;
  color: var(--green, #81AB4C);
  margin-bottom: 20px;
}
.ip-film-card h3 {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 16px; font-weight: 600; color: var(--text-dark, #1a1a1a); margin-bottom: 6px;
}
.ip-film-card p { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 13px; color: var(--text-mid, #4a4a4a); line-height: 1.6; margin: 0; }
.ip-film-price { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 13px; font-weight: 600; color: var(--green, #81AB4C); margin-top: 10px; }

/* Sidebar cards */
.ip-sidebar { padding: 64px 0; position: sticky; top: 100px; align-self: start; }

/* ── SIDEBAR CTA CARD ── */
.ip-sidebar-cta-card {
  border-radius: 20px;
  overflow: hidden;
  margin-bottom: 20px;
}
.ip-sidebar-cta-card__bg {
  position: relative;
  background-size: cover;
  background-position: center;
  padding: 40px 28px;
  min-height: 260px;
  display: flex;
  align-items: flex-end;
}
.ip-sidebar-cta-card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.7) 100%);
  border-radius: 20px;
}
.ip-sidebar-cta-card__content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ip-sidebar-cta-card__label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  color: rgba(255,255,255,0.75);
  margin: 0;
}
.ip-sidebar-cta-card__phone {
  font-family: var(--font-serif);
  font-size: 24px;
  font-weight: 700;
  color: #ffffff;
  text-decoration: none;
  line-height: 1.1;
}
.ip-sidebar-cta-card__btn {
  display: inline-block;
  margin-top: 8px;
  background: var(--green, #81AB4C);
  color: #fff;
  padding: 10px 20px;
  border-radius: 100px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  width: fit-content;
}

/* ── SIDEBAR CITIES LIST ── */
.ip-sidebar-cities {
  background: transparent;
  border: 1px solid var(--off-white, #F7F6F3);
  border-radius: 20px;
  padding: 24px;
  margin-bottom: 20px;
}
.ip-sidebar-cities__title {
  font-family: var(--font-serif);
  font-size: clamp(18px, 2.5vw, 22px);
  font-weight: 700;
  color: #111;
  margin-bottom: 12px;
}
.ip-sidebar-cities__list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.ip-sidebar-cities__list li {
  border-bottom: 1px solid var(--light-gray, #EFEFED);
}
.ip-sidebar-cities__list li:last-child {
  border-bottom: none;
}
.ip-sidebar-city-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 12px;
  border-radius: 8px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-dark, #1a1a1a);
  text-decoration: none;
  transition: all 0.2s;
}
.ip-sidebar-city-link span {
  font-size: 11px;
  color: var(--text-light, #888);
}
.ip-sidebar-city-link:hover {
  background: var(--green, #81AB4C);
  color: #ffffff;
}
.ip-sidebar-city-link:hover span {
  color: rgba(255,255,255,0.75);
}
.ip-sidebar-city-link--active {
  background: var(--green, #81AB4C);
  color: #ffffff;
}
.ip-sidebar-city-link--active span {
  color: rgba(255,255,255,0.75);
}

/* ── LOCAL AREA ── */
.ip-local {
  padding: 64px 5%;
  margin: 0 5%;
}
.ip-local__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
}
.ip-local__map {
  border-radius: var(--radius-xl, 40px);
  overflow: hidden;
  height: 400px;
}
.ip-local__map iframe {
  width: 100%;
  height: 100%;
}
