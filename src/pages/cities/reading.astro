@media (max-width: 960px) { .rd-expert__container { grid-template-columns: 1fr; padding: 0 32px; } .rd-expert { padding: 64px 0; } .rd-expert__img { height: 400px; } }
@media (max-width: 600px) { .rd-expert__container { padding: 0 20px; } .rd-expert__stats { gap: 20px; } }

/* ── TRUST / WHY US SECTION ── */
.rd-trust { background: #F5F3EE; padding: 96px 0; }
.rd-trust__container { max-width: 1280px; margin: 0 auto; padding: 0 80px; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
.rd-trust__image-col { position: relative; }
.rd-trust__img { width: 100%; height: 680px; object-fit: cover; object-position: top center; border-radius: 20px; display: block; }
.rd-trust__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin: 0 0 20px; }
.rd-trust__title { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 3vw, 2.75rem); font-weight: 700; color: #14201A; line-height: 1.2; margin: 0 0 40px; letter-spacing: -0.02em; }
.rd-trust__items { display: flex; flex-direction: column; }
.rd-trust__item { display: flex; align-items: flex-start; gap: 16px; padding: 20px 0; border-bottom: 1px solid #ddd8d0; }
.rd-trust__item:first-child { border-top: 1px solid #ddd8d0; }
.rd-trust__check { flex-shrink: 0; margin-top: 1px; }
.rd-trust__item-body { flex: 1; }
.rd-trust__item-title { font-family: 'Inter', sans-serif; font-size: 0.95rem; font-weight: 600; color: #14201A; margin: 0; line-height: 1.5; }
.rd-trust__cta { display: inline-flex; align-items: center; gap: 8px; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; color: #7CB342; text-decoration: none; margin-top: 36px; transition: gap 0.2s ease; }
.rd-trust__cta:hover { gap: 14px; }
@media (max-width: 960px) { .rd-trust__container { grid-template-columns: 1fr; padding: 0 32px; } .rd-trust { padding: 64px 0; } .rd-trust__img { height: 400px; } }
@media (max-width: 600px) { .rd-trust__container { padding: 0 20px; } }

/* ── BRANDS SECTION WRAPPER ── */
.rd-brands { background: #fff; padding-top: 72px; padding-bottom: 72px; }
.rd-brands__header { text-align: center; padding: 0 24px 48px; }
.rd-brands__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin-bottom: 0.75rem; }
.rd-brands__title { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 700; color: #14201A; line-height: 1.2; margin: 0 0 1rem; }
.rd-brands__sub { font-family: 'Inter', sans-serif; font-size: 1rem; color: #4A5C48; max-width: 600px; margin: 0 auto; line-height: 1.75; }

/* ── Brand card carousel ── */
.rd-brands__carousel-outer {
  position: relative;
  padding: 48px 80px 0;
  max-width: 1440px;
  margin: 0 auto;
}
.rd-brands__carousel {
  display: flex;
  gap: 24px;
  overflow-x: scroll;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  cursor: grab;
}
.rd-brands__carousel::-webkit-scrollbar { display: none; }
.rd-brands__carousel:active { cursor: grabbing; }
.rd-brands__card {
  flex: 0 0 calc(25% - 18px);
  scroll-snap-align: start;
  background: #fff;
  border: 1px solid #e8ede6;
  border-radius: 12px;
  overflow: hidden;
}
.rd-brands__card-photo {
  width: 100%;
  height: 280px;
  object-fit: cover;
  display: block;
}
.rd-brands__card-body {
  padding: 20px 22px 24px;
}
.rd-brands__card-name {
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: #14201A;
  margin: 0 0 8px;
}
.rd-brands__card-desc {
  font-family: 'Inter', sans-serif;
  font-size: 0.88rem;
  color: #3a4a38;
  line-height: 1.6;
  margin: 0 0 12px;
}
.rd-brands__card-desc em { font-style: italic; }
.rd-brands__card-sub {
  font-family: 'Space Mono', monospace;
  font-size: 0.72rem;
  color: #7CB342;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 0;
}
.rd-brands__arrow {
  position: absolute;
  top: calc(48px + 140px);
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid #d8e4d4;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 2;
  color: #14201A;
  transition: box-shadow 0.2s ease;
}
.rd-brands__arrow:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.15); }
.rd-brands__arrow--left  { left: 24px; }
.rd-brands__arrow--right { right: 24px; }
.rd-brands__dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  padding-top: 32px;
}
.rd-brands__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #d0dace;
  border: none;
  padding: 0;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
}
.rd-brands__dot--active {
  background: #7CB342;
  transform: scale(1.3);
}
@media (max-width: 1100px) {
  .rd-brands__card { flex: 0 0 calc(33.33% - 16px); }
}
@media (max-width: 760px) {
  .rd-brands__card { flex: 0 0 calc(80% - 12px); }
  .rd-brands__carousel-outer { padding: 48px 24px 0; }
  .rd-brands__arrow { display: none; }
}

/* ── PAGE BODY WRAPPER ── */
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
}

/* ── PAGE HERO ── */
.ip-hero {
  padding: 80px 10%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
  background: #fff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  overflow: hidden;
}
.ip-hero__content { padding-bottom: 0; }
.ip-hero__body { padding-bottom: 0; }

.ip-hero__eyebrow {
  display: inline-flex; align-items: center;
  background: transparent;
  border: 1.5px solid var(--green, #81AB4C);
  color: var(--green, #81AB4C);
  padding: 5px 14px; border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 12px; font-weight: 600; letter-spacing: 0.5px;
  text-transform: uppercase; margin-bottom: 20px; overflow: hidden;
}
.eyebrow-marquee {
  display: block; overflow: hidden; white-space: nowrap;
}
.eyebrow-marquee span {
  display: inline-block;
  animation: marquee-scroll 8s linear infinite;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 12px; font-weight: 600; letter-spacing: 0.5px;
  text-transform: uppercase;
}
@keyframes marquee-scroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.ip-hero h1 {
  font-family: var(--font-serif);
  font-size: clamp(40px, 5vw, 64px); font-weight: 600;
  line-height: 1.1; letter-spacing: -0.8px;
  color: var(--text-dark, #1a1a1a); margin-bottom: 20px;
}
.ip-hero h1 em { font-style: italic; color: var(--green, #81AB4C); }

.ip-hero__lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px; color: var(--text-mid, #4a4a4a);
  line-height: 1.75; max-width: 560px; margin-bottom: 32px;
}

.ip-hero__ctas { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-bottom: 32px; }

/* Buttons */
.ip-btn {
  display: inline-block; padding: 14px 28px;
  border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; font-weight: 500;
  text-decoration: none; transition: all 0.2s;
  border: 2px solid transparent; white-space: nowrap;
}
.ip-btn--primary { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.ip-btn--primary:hover { background: #6e9640; border-color: #6e9640; transform: translateY(-2px); color: #fff; }
.ip-btn--ghost { background: transparent; color: var(--brand, #272E32); border-color: var(--brand, #272E32); }
.ip-btn--ghost:hover { background: var(--brand, #272E32); color: #fff; transform: translateY(-2px); }
.ip-btn--white { background: #fff; color: var(--brand, #272E32); border-color: #fff; font-weight: 600; }
.ip-btn--white:hover { background: var(--off-white, #F7F6F3); transform: translateY(-2px); color: var(--brand, #272E32); }
.ip-btn--green { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.ip-btn--green:hover { background: #6e9640; transform: translateY(-2px); color: #fff; }

/* ── HERO IMAGE ── */
.ip-hero-img-wrap { padding: 32px 5% 0; }
.ip-hero-img {
  width: 100%; height: 380px;
  border-radius: var(--radius-xl, 40px); overflow: hidden; position: relative;
}
.ip-hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ip-hero-img__caption {
  position: absolute; bottom: 20px; left: 20px;
  background: rgba(255,255,255,0.92); backdrop-filter: blur(8px);
  padding: 10px 18px; border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px; font-weight: 600; color: var(--brand, #272E32);
}

/* ── GALLERY ── */
/* ── RD MASONRY GALLERY ── */
.rd-masonry { background: #F5F3EE; padding: 100px 0 80px; }
.rd-masonry__header { max-width: 1200px; margin: 0 auto 56px; padding: 0 40px; text-align: center; }
.rd-masonry__eyebrow { display: block; font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em; color: #7CB342; margin-bottom: 16px; }
.rd-masonry__title { font-family: var(--font-serif, Georgia, serif); font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 700; color: #14201A; line-height: 1.2; margin: 0 0 16px; letter-spacing: -0.01em; }
.rd-masonry__sub { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 1rem; color: #4A5C48; max-width: 560px; margin: 0 auto; line-height: 1.7; }
.rd-masonry__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 1200px; margin: 0 auto; padding: 0 40px; }
.rd-masonry__item { position: relative; border-radius: 12px; overflow: hidden; cursor: pointer; }
.rd-masonry__item img { width: 100%; height: 320px; object-fit: cover; display: block; border-radius: 12px; transition: transform 0.4s ease; }
.rd-masonry__item:hover img { transform: scale(1.03); }
.rd-masonry__caption { position: absolute; bottom: 0; left: 0; right: 0; padding: 32px 16px 14px; background: linear-gradient(to top, rgba(13,26,15,0.75) 0%, transparent 100%); font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 12px; font-weight: 500; color: rgba(255,255,255,0.9); border-radius: 0 0 12px 12px; opacity: 0; transition: opacity 0.3s ease; }
.rd-masonry__item:hover .rd-masonry__caption { opacity: 1; }

/* ── CONTENT + SIDEBAR ── */
.ip-content-wrap {
  padding: 0 5%;
  display: grid; grid-template-columns: 1fr 420px;
  gap: 60px; align-items: start;
}
.ip-main { padding: 64px 0; }
.ip-sidebar { padding: 64px 0; }

/* Prose */
.prose h2 {
  font-family: var(--font-serif);
  font-size: clamp(28px, 3.5vw, 42px);
  font-weight: 700;
  letter-spacing: -0.5px;
  line-height: 1.15;
  color: var(--text-dark, #1a1a1a); margin: 48px 0 20px;
}
.prose h2:first-child { margin-top: 0; }
.prose p {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px; color: var(--text-mid, #4a4a4a); line-height: 1.8; margin-bottom: 18px;
}
.prose ul { list-style: none; padding: 0; margin-bottom: 18px; }
.prose ul li {
  display: flex; align-items: flex-start; gap: 10px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; color: var(--text-mid, #4a4a4a); padding: 5px 0; line-height: 1.6;
}
.prose ul li::before { content: '✓'; color: var(--green, #81AB4C); font-weight: 700; font-size: 13px; margin-top: 3px; flex-shrink: 0; }

/* Callout */
.ip-callout {
  background: var(--green-light, #eef4e4);
  border-left: 4px solid var(--green, #81AB4C);
  border-radius: 0 var(--radius-md, 16px) var(--radius-md, 16px) 0;
  padding: 20px 24px; margin: 32px 0;
}
.ip-callout p { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 15px; color: #3a5a1f; margin: 0; line-height: 1.7; }

/* Film grid */
.ip-film-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin: 24px 0 32px; }
.ip-film-card {
  background: var(--off-white, #F7F6F3);
  border-radius: var(--radius-lg, 24px); padding: 24px 20px;
  border: 2px solid transparent; transition: border-color 0.2s, transform 0.2s;
}
.ip-film-card:hover { border-color: var(--green, #81AB4C); transform: translateY(-2px); }
.ip-film-card--featured { border-color: var(--green, #81AB4C); background: var(--green-light, #eef4e4); }
.ip-film-icon {
  display: block;
  width: 50px; height: 50px;
  color: var(--green, #81AB4C);
  margin-bottom: 20px;
}
.ip-film-card h3 {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 16px; font-weight: 600; color: var(--text-dark, #1a1a1a); margin-bottom: 6px;
}
.ip-film-card p { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 13px; color: var(--text-mid, #4a4a4a); line-height: 1.6; margin: 0; }
.ip-film-price { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 13px; font-weight: 600; color: var(--green, #81AB4C); margin-top: 10px; }

/* Sidebar cards */
.ip-sidebar { padding: 64px 0; position: sticky; top: 100px; align-self: start; }

/* ── SIDEBAR CTA CARD ── */
.ip-sidebar-cta-card {
  border-radius: 20px;
  overflow: hidden;
  margin-bottom: 20px;
}
.ip-sidebar-cta-card__bg {
  position: relative;
  background-size: cover;
  background-position: center;
  padding: 40px 28px;
  min-height: 260px;
  display: flex;
  align-items: flex-end;
}
.ip-sidebar-cta-card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.7) 100%);
  border-radius: 20px;
}
.ip-sidebar-cta-card__content {
  position: relative;
  z-index: 2;
