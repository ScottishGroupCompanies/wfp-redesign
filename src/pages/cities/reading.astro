---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import AccordionBenefits from '../../components/AccordionBenefits.astro';
import AccordionFAQ from '../../components/AccordionFAQ.astro';
import GalleryBanner from '../../components/GalleryBanner.astro';
import TestimonialSpotlight from '../../components/TestimonialSpotlight.astro';
import CtaLightRays from '../../components/CtaLightRays.astro';
import ScrollReveal from '../../components/animations/ScrollReveal.astro';
import InnerPageHero from '../../components/InnerPageHero.astro';
import CategoryBlogFeed from '../../components/CategoryBlogFeed.astro';

const title = 'Window Film Reading PA | Window Film Contractor Reading';
const description = 'Window film installation in Reading, PA — solar control, security, privacy, and decorative film. Free estimates, certified installers, warranty.';

const filmBenefits = [
  {
    number: '01',
    title: 'Energy Savings',
    detail: `<p>Reading sits in the Schuylkill River valley, where July afternoons regularly hit 85°F and humidity lingers in the 70s. Solar control film rejects up to <strong>78% of solar heat</strong> at the glass, before it ever reaches your living space. Brick rowhouses throughout Downtown Reading and Hampden Heights trap that heat well past sundown — film breaks the cycle.</p><ul><li>Cuts HVAC runtime and monthly cooling bills across the summer season</li><li>Measurable interior temperature drops of 10–15°F on west-facing rooms during peak afternoon sun</li><li>Low-E variants also reduce winter heat loss through single-pane glass common in Reading's older housing stock</li></ul>`,
    image: '/images/window-film-reading-pa-film-energy.jpg',
    imageAlt: 'Energy-saving window film in a Reading PA brick rowhome living room — natural light filtered, cooler interior',
  },
  {
    number: '02',
    title: 'UV Protection',
    detail: `<p>Pennsylvania summers deliver intense UV exposure that fades hardwood floors, rugs, and furniture long before their time. UV-blocking film stops <strong>99% of UV-A and UV-B radiation</strong> at the glass — the same rays that discolor merchandise in Penn Street storefronts and artwork in Wyomissing living rooms.</p><ul><li>Essential for Reading Hospital clinical spaces and Albright College campus buildings with large glazing</li><li>Optically clear — preserves natural light and outward views with no visible tint</li><li>Reduces fading by up to 60% versus unprotected glass</li></ul>`,
    image: '/images/window-film-reading-pa-film-uv.jpg',
    imageAlt: 'UV-blocking window film protecting a Reading PA home interior from sun damage and fading',
  },
  {
    number: '03',
    title: 'Privacy Film',
    detail: `<p>Reading's dense brick rowhome blocks and closely spaced commercial corridors leave ground-floor windows exposed to foot traffic and neighboring buildings. Privacy film adds a barrier <strong>without darkening the room</strong> — frosted, reflective, and gradient options all let daylight through.</p><ul><li>One-way reflective film preserves Schuylkill River and Mount Penn views from West Reading condos</li><li>Frosted film for Reading Hospital exam rooms, Berks County government offices, and law firm conference spaces</li><li>Available in clear frosted, custom patterns, gradient, and branded designs — every option fully removable</li></ul>`,
    image: '/images/window-film-reading-pa-film-privacy.jpg',
    imageAlt: 'Frosted privacy window film on a conference room partition in a Reading PA office',
  },
  {
    number: '04',
    title: 'Safety & Security',
    detail: `<p>Property crime remains a reality in parts of Reading, where the city has worked hard to recover from decades of economic decline. Security film <strong>bonds glass fragments together on impact</strong>, transforming a pane that would shatter into shards into a barrier that holds — slowing forced entry and protecting occupants.</p><ul><li>Keeps glass intact during break-in attempts, storms, and accidents rather than shattering into hazardous shards</li><li>Institutional and government buildings rely on security film to meet ANSI and GSA glazing safety benchmarks</li><li>Bomb blast mitigation configurations available for federally regulated facilities</li></ul>`,
    image: '/images/window-film-reading-pa-film-safety.jpg',
    imageAlt: 'Secure commercial building entrance in Reading PA with safety and security window film on glass doors',
  },
  {
    number: '05',
    title: 'Anti-Graffiti',
    detail: `<p>Storefronts along Penn Street and Fifth Street know the recurring cost of scratched and acid-etched glass. Anti-graffiti film is a <strong>sacrificial barrier</strong> — vandalism damages the film, not the pane underneath, and a quick film swap restores the surface for a fraction of glass replacement.</p><ul><li>Each film replacement costs a small percentage of what new glass would run</li><li>Most Reading business owners recover the initial investment within the first one or two incidents prevented</li><li>Comes in clear or lightly tinted versions — visually invisible on installed glass</li></ul>`,
    image: '/images/window-film-reading-pa-film-graffiti.jpg',
    imageAlt: 'Clean commercial storefront glass in Reading PA protected by anti-graffiti window film',
  },
  {
    number: '06',
    title: 'Glare Reduction',
    detail: `<p>East- and west-facing windows in Hampden Heights, Glenside, and Muhlenberg Township catch direct sun during morning and afternoon hours — making screens, monitors, and workspaces difficult to use. Glare reduction film filters up to <strong>85% of visible glare</strong> while keeping the room bright.</p><ul><li>Open-plan offices and home workspaces see immediate improvement — screens become readable without squinting</li><li>Works on every glass type, including the single-pane windows found throughout Reading's historic housing stock</li></ul>`,
    image: '/images/window-film-reading-pa-film-glare.jpg',
    imageAlt: 'Reading PA office worker at computer desk near window with no screen glare after window film installation',
  },
  {
    number: '07',
    title: 'Decorative Film',
    detail: `<p>West Reading's revitalized arts corridor and the ongoing conversion of factory buildings into loft workspaces have created demand for distinctive glass design. Frosted, patterned, and gradient films deliver an <strong>etched-glass look without etched-glass cost</strong>.</p><ul><li>Custom-branded window graphics for Reading businesses — logos, wayfinding signage, and repeating patterns</li><li>A strong fit for Reading Hospital waiting areas, Albright College library spaces, and Berks County office lobbies</li><li>Completely removable — no permanent change to the underlying glass</li></ul>`,
    image: '/images/window-film-reading-pa-film-decorative.jpg',
    imageAlt: 'Decorative frosted glass pattern on a partition wall in a Reading PA office or lobby',
  },
  {
    number: '08',
    title: 'Solar Control',
    detail: `<p>Solar control film is the most versatile category we install across Reading and Berks County — one application addresses heat gain, glare, and UV simultaneously for homes, offices, retail stores, and institutional properties.</p><ul><li>Spectrally selective films reject infrared heat while preserving natural light and clear views</li><li>Ceramic constructions contain zero metal — no interference with Wi-Fi, cellular, or sensitive medical electronics</li><li>NFRC-rated options available with documented VLT, SHGC, and TSER values for energy code and LEED compliance</li></ul>`,
    image: '/images/window-film-reading-pa-film-solar.jpg',
    imageAlt: 'Solar control window film on a modern Reading PA commercial office building exterior',
  },
];

const faqItems = [
  { question: 'Is window film permitted on Reading homes and businesses?', answer: 'Yes. Pennsylvania imposes no statewide restriction on architectural window film for residential or commercial buildings. Solar, privacy, decorative, security, and anti-graffiti films can all be installed without a permit. If your property sits within a Reading historic district or falls under an HOA, your documents may include reflectivity guidelines — we carry non-reflective film options that satisfy most requirements and can help you navigate the approval process.' },
  { question: 'How is window film priced for Berks County properties?', answer: 'Cost depends on film category, total glass area, window count, and how accessible each pane is. Solar control, privacy, decorative, security, and anti-graffiti films each sit at different price points, and no two Reading buildings are identical. Rather than guess, we offer free on-site consultations and deliver a detailed written estimate calibrated to your specific windows and objectives. No obligation, no charge.' },
  { question: 'What should I expect during a window film installation?', answer: 'Several variables shape the process: how many windows we are filming, their size and type, the film selected, glass accessibility, and the building layout. A single rowhouse looks very different from a multi-floor commercial install. During your free consultation we evaluate the full scope, give you a realistic schedule, work around your routine, and handle all cleanup when we finish.' },
  { question: 'What kind of warranty covers window film in Reading?', answer: 'Warranty coverage depends on the manufacturer and product line. Leading brands — 3M, LLumar, Vista, and Solar Gard among them — back their architectural films with manufacturer warranties against peeling, bubbling, delamination, and color shift. Coverage periods and specifics vary by film, so we review the warranty for your chosen product in full before any installation begins.' },
  { question: 'How effective is solar control film during Pennsylvania summers?', answer: 'High-performance solar control films reject up to 85% of solar heat gain — the main cause of summer overheating in Reading and across Berks County. July highs here regularly reach the mid-80s°F with humidity in the 70s. Window film reduces hot spots near glass, lowers peak indoor temperatures, and eases air-conditioning load, often cutting cooling energy costs by 20–30%. The U.S. Department of Energy reports that windows account for 25–30% of a building\'s total heating and cooling energy loss.' },
  { question: 'Does window film really block UV radiation?', answer: 'Yes. Most architectural window films block 99% or more of UV-A and UV-B radiation — including clear, low-reflectivity options. UV is the leading cause of fading in hardwood floors, upholstery, artwork, and retail merchandise, and it contributes to skin damage with prolonged exposure near windows. UV-blocking film reduces fading by up to 60% versus unprotected glass without noticeably reducing visible light.' },
  { question: 'Can window film be taken off without harming the glass?', answer: 'Yes. Window film is professionally removable at any point with no permanent damage to the glass. The process uses heat and a mild adhesive solvent, leaving no scratches, marks, or residue behind. Renters, property managers, and building owners who want a non-permanent upgrade often choose window film precisely for this flexibility.' },
  { question: 'Does window film help in winter or only in summer?', answer: 'Both. Solar control film cuts heat gain in summer. Certain low-emissivity (low-e) films also retain interior warmth in winter by reflecting radiant heat back into the room — the same principle behind double-pane Low-E glass. This dual-season performance matters in Reading, where January temperatures frequently drop into the 20s°F. Year-round use can reduce total HVAC energy consumption by 5–15%.' },
  { question: 'What distinguishes privacy film from solar control film?', answer: 'Solar control film reduces heat gain and glare while keeping a clear outward view — it works by filtering infrared energy at the glass. Privacy film — including frosted, whiteout, and one-way mirror variants — obscures the view into a space, either around the clock (frosted) or from one direction during daylight hours (reflective). Many Reading clients layer both: solar film on main living areas for energy savings, frosted film on bathrooms, conference rooms, or street-facing glass for privacy.' },
  { question: 'Do you apply anti-graffiti film to Reading storefronts?', answer: 'Yes. Anti-graffiti film — also called sacrificial film — is a clear protective layer applied to exterior glass and smooth surfaces. When vandalism happens, the damaged film peels off and is replaced for a fraction of what new glass would cost. It is a popular choice for Penn Street and Fifth Street storefronts and commercial corridors across Reading where scratching and spray tagging are recurring problems.' },
  { question: 'Will window film affect my window manufacturer\'s warranty?', answer: 'No — when professionally installed on standard single-pane, double-pane, or tempered glass. For sealed insulated glass units (IGUs), we select film types rated for that specific glass to prevent heat-stress buildup. Our installers verify the glass specification before recommending any product. Most major glass manufacturers do not void warranties when an IGU-rated film is correctly applied.' },
  { question: 'Are there tax incentives for energy-saving window film in Pennsylvania?', answer: 'Potentially yes. The federal Inflation Reduction Act Section 25C tax credit covers qualifying building-envelope improvements — which can include energy-efficient window treatments — up to $1,200 per year for eligible residential projects. Pennsylvania also offers commercial energy efficiency incentive programs. We recommend consulting a tax professional to confirm eligibility based on your film specification and property type.' },
  { question: 'Do you provide free on-site estimates across Berks County?', answer: 'Yes. We offer free, no-obligation consultations at your home or business anywhere in Reading and throughout Berks County. During the visit we assess window type, sun exposure, and your goals, then deliver a detailed written estimate. No pressure, no charge.' },
];

const today = new Date().toISOString().slice(0, 10);
const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': 'https://www.windowfilmphiladelphia.net/cities/reading/#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Cities We Serve', item: 'https://www.windowfilmphiladelphia.net/cities/' },
      { '@type': 'ListItem', position: 3, name: 'Window Film Reading PA', item: 'https://www.windowfilmphiladelphia.net/cities/reading/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://www.windowfilmphiladelphia.net/cities/reading/#webpage',
    url: 'https://www.windowfilmphiladelphia.net/cities/reading/',
    name: title,
    description: description,
    inLanguage: 'en-US',
    isPartOf: { '@id': 'https://www.windowfilmphiladelphia.net/#website' },
    about: { '@type': 'City', name: 'Reading', containedInPlace: { '@type': 'State', name: 'Pennsylvania' } },
    dateModified: today,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.rd-hero__subtitle', '.faq__a-inner p'],
    },
    breadcrumb: { '@id': 'https://www.windowfilmphiladelphia.net/cities/reading/#breadcrumb' },
  },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/cities/reading/" faqItems={faqItems} schemas={pageSchemas}>

<!-- ══ HERO ══ -->
<section class="rd-hero">
  <div class="rd-hero__overlay"></div>
  <div class="rd-hero__container">
    <div class="rd-hero__label">WINDOW FILM INSTALLATION &middot; READING, PA</div>
    <div class="rd-hero__content">
      <h1 class="rd-hero__title">Window Film in Reading<br/>&mdash; Berks County's Best</h1>
      <p class="rd-hero__subtitle">Professional residential and commercial window film installation in Reading, PA and throughout Berks County. Solar control, security, privacy, and decorative film for Reading homes and businesses — free estimates, certified installers, manufacturer warranties.</p>
      <div class="rd-hero__buttons">
        <a href="/contact/" class="btn-hero btn-hero--primary">Get Your Free Estimate &rarr;</a>
        <a href="tel:+12673947980" class="btn-hero btn-hero--secondary">Call (267) 394-7980</a>
      </div>
    </div>
    <div class="rd-hero__bottom">
      <div class="rd-hero__tagline">Trusted by Reading homeowners and businesses since 2008.</div>
      <div class="rd-hero__stats">
        <div class="hero-stat-item">
          <div class="hero-stat-item__number" data-count="18">0</div>
          <div class="hero-stat-item__label">Years Serving Berks County</div>
        </div>
        <div class="hero-stat-item">
          <div class="hero-stat-item__number" data-count="500">0</div>
          <div class="hero-stat-item__label">Reading Area Installs</div>
        </div>
        <div class="hero-stat-item">
          <div class="hero-stat-item__number" data-count="99">0</div>
          <div class="hero-stat-item__label">UV Block Rate</div>
        </div>
        <div class="hero-stat-item">
          <div class="hero-stat-item__number" data-count="4.9">0</div>
          <div class="hero-stat-item__label">Google Rating</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══ LOCAL CONTEXT ══ -->
<section class="rd-why">
  <div class="rd-why__container">

    <div class="rd-why__image-wrap">
      <img
        src="/images/window-film-reading-pa-urban-heat.jpg"
        alt="Schuylkill River flowing through Reading PA with the Reading Pagoda visible on Mount Penn — Berks County's summer heat and humidity make window film essential" title="Schuylkill River flowing through Reading PA with the Reading Pagoda visible on Mount Penn — Berks County's summer heat and humidity make window film essential"
        class="rd-why__image"
        loading="lazy"
      />
      <div class="rd-why__stat-card">
        <div class="rd-why__stat-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>83-87°F summer highs</span>
        </div>
        <div class="rd-why__stat-divider"></div>
        <div class="rd-why__stat-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>68-72% summer humidity</span>
        </div>
      </div>
    </div>

    <div class="rd-why__content">
      <div class="rd-why__eyebrow">Berks County Climate & Context</div>
      <h2 class="line-mask rd-why__headline" data-stagger="140" aria-label="Reading Buildings Deserve Better Glass">
        <span class="line-mask__line" aria-hidden="true"><span class="line-mask__inner" style="--i:0">Reading Buildings</span></span>
        <span class="line-mask__line" aria-hidden="true"><span class="line-mask__inner" style="--i:1">Deserve Better Glass</span></span>
      </h2>
      <p class="rd-why__intro">Reading's position in the Schuylkill River valley, its dense brick construction, and its ongoing economic recovery create a set of conditions that make window film a practical investment, not a luxury. July afternoons climb toward 85°F with humidity holding in the upper 60s and low 70s. The city's many historic brick rowhomes and converted factory lofts absorb and hold that heat deep into the evening. And after decades of economic hardship — <a href="https://en.wikipedia.org/wiki/Reading,_Pennsylvania" target="_blank" rel="noopener noreferrer" style="color:#7CB342">Reading was once labeled America's poorest city</a> — property crime remains a daily concern for business owners, making security film one of our most frequently requested products here.</p>
      <ul class="rd-why__bullets">
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Summer highs of 83-87°F with 68-72% humidity turn south- and west-facing glass into radiant heat sources without solar control film
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Reading's brick rowhome and factory-loft building stock absorbs and retains solar heat far longer than newer suburban construction
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
Property crime rates above the national average make security and anti-smash film one of the highest-value installs we perform across Reading and Berks County
        </li>
      </ul>
      <div class="rd-why__climate-facts">
        <div class="rd-why__climate-item">
          <span class="rd-why__climate-num">85°F</span>
          <span class="rd-why__climate-label"><a href="https://forecast.weather.gov/MapClick.php?lat=40.3356&lon=-75.9269" target="_blank" rel="noopener noreferrer" style="color:#7CB342">Reading, PA summer highs (NWS)</a></span>
        </div>
        <div class="rd-why__climate-item">
          <span class="rd-why__climate-num">~95K</span>
          <span class="rd-why__climate-label">City population (429K metro)</span>
        </div>
        <div class="rd-why__climate-item">
          <span class="rd-why__climate-num">68-72%</span>
          <span class="rd-why__climate-label">Relative humidity in peak summer months</span>
        </div>
      </div>
      <p class="rd-why__closing">Since 2008, Window Film Philadelphia has installed window film in Reading for homeowners, commercial tenants, and property managers throughout Berks County — <a href="/benefits/energy-savings/" style="color:#7CB342">solar control</a>, <a href="/benefits/safety-and-security/" style="color:#7CB342">security</a>, <a href="/benefits/privacy-window-film-philadelphia/" style="color:#7CB342">privacy</a>, and <a href="/benefits/decorative-promotional/" style="color:#7CB342">decorative film</a> applied by certified technicians with manufacturer-backed warranties on every job.</p>
      <a href="/contact/" class="rd-why__cta">
        Get a free Reading assessment
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
      </a>
    </div>

  </div>
</section>

<!-- ══ TRUSTED EXPERTS ══ -->
<section class="rd-expert">
  <div class="rd-expert__container">
    <div class="rd-expert__content">
      <p class="rd-expert__eyebrow">READING'S WINDOW FILM CREW</p>
      <h2 class="rd-expert__title">Why choose us for window film in Reading, PA?</h2>
      <p class="rd-expert__body">Window Film Philadelphia has been applying window film across Reading and the broader Berks County market since 2008. Our certified installers handle every category of project — cooling a Hampden Heights rowhouse with solar film, hardening a Penn Street storefront with security film, adding frosted privacy to a Reading Hospital clinic, or outfitting a Wyomissing home office with glare-reduction film. Every install is measured, cut, and finished by our own technicians.</p>
      <p class="rd-expert__body">Reading's built environment poses its own set of challenges: aging brick rowhomes with single-pane glass, factory buildings converted to loft use, institutional campuses with large curtain-wall glazing, and commercial corridors where property crime is a daily reality. Our film recommendations account for all of it — heat rejection, security reinforcement, UV protection, and visual privacy delivered in a single professional visit. Every window film contractor working in Reading should carry full insurance and current manufacturer certifications; ours do. We also serve <a href="/cities/philadelphia/" style="color:#7CB342">Philadelphia</a>, <a href="/cities/camden/" style="color:#7CB342">South Jersey</a>, and communities throughout the greater region.</p>
      <div class="rd-expert__stats">
        <div class="rd-expert__stat">
          <span class="rd-expert__stat-num">2008</span>
          <span class="rd-expert__stat-label">Serving Berks County since</span>
        </div>
        <div class="rd-expert__stat-divider"></div>
        <div class="rd-expert__stat">
          <span class="rd-expert__stat-num">500+</span>
          <span class="rd-expert__stat-label">Reading area installs completed</span>
        </div>
      </div>
    </div>
    <div class="rd-expert__image-col">
      <img
        src="/images/window-film-reading-pa-expert-interior.jpg"
        alt="Warm Reading PA residential interior with large windows — window film keeps this Berks County home comfortable year-round" title="Warm Reading PA residential interior with large windows — window film keeps this Berks County home comfortable year-round"
        class="rd-expert__img"
        loading="lazy"
      />
    </div>
  </div>
</section>

<!-- ══ RESIDENTIAL + COMMERCIAL SLIDER ══ -->
<section class="rd-prop-slider" id="rdSlider">
  <div class="rd-prop-slider__track" id="rdTrack">

    <!-- SLIDE 01: Commercial -->
    <div class="rd-prop-slider__slide" data-slide="0">
      <img src="/images/window-film-reading-pa-commercial.jpg" alt="Modern commercial office in Reading PA with floor-to-ceiling windows - window film for Berks County commercial properties" title="Modern commercial office in Reading PA with floor-to-ceiling windows - window film for Berks County commercial properties" class="rd-prop-slider__bg" loading="lazy" />
      <div class="rd-prop-slider__overlay"></div>
      <div class="rd-prop-slider__content">
        <div class="rd-prop-slider__step">01</div>
        <h2 class="rd-prop-slider__title">Window Film for Reading's
Commercial Spaces</h2>
        <p class="rd-prop-slider__desc">Penn Street storefronts, Fifth Street offices, Reading Hospital clinical wings, and Berks County government buildings — our crews install solar, security, anti-graffiti, and decorative film across the full spectrum of Reading commercial properties.</p>
        <ul class="rd-prop-slider__benefits">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Solar control film cuts cooling costs 25-35% in Berks County commercial buildings
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Security film reinforces storefront glass against smash-and-grab and holds fragments on impact
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="#7CB342" stroke-width="2"/><path d="M8 12l3 3 5-5" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Anti-graffiti film shields exterior glass from etching, scratching, and spray tagging
          </li>
        </ul>
        <a href="/contact/" class="rd-prop-slider__cta">Get a commercial estimate →</a>
      </div>
    </div>

    <!-- SLIDE 02: Residential -->
    <div class="rd-prop-slider__slide" data-slide="1">
      <img src="/images/window-film-reading-pa-residential-rowhouses.jpg" alt="Brick rowhouses in Reading PA - solar control and security window film for Berks County residential homes" title="Brick rowhouses in Reading PA - solar control and security window film for Berks County residential homes" class="rd-prop-slider__bg" loading="lazy" />
      <div class="rd-prop-slider__overlay"></div>
      <div class="rd-prop-slider__content">
        <div class="rd-prop-slider__step">02</div>
