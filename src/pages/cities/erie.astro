/* Buttons */
.ip-btn {
  display: inline-block; padding: 14px 28px;
  border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; font-weight: 500;
  text-decoration: none; transition: all 0.2s;
  border: 2px solid transparent; white-space: nowrap;
}
.ip-btn--primary { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.ip-btn--primary:hover { background: #6e9640; border-color: #6e9640; transform: translateY(-2px); color: #fff; }
.ip-btn--ghost { background: transparent; color: var(--brand, #272E32); border-color: var(--brand, #272E32); }
.ip-btn--ghost:hover { background: var(--brand, #272E32); color: #fff; transform: translateY(-2px); }
.ip-btn--white { background: #fff; color: var(--brand, #272E32); border-color: #fff; font-weight: 600; }
.ip-btn--white:hover { background: var(--off-white, #F7F6F3); transform: translateY(-2px); color: var(--brand, #272E32); }
.ip-btn--green { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.ip-btn--green:hover { background: #6e9640; transform: translateY(-2px); color: #fff; }

/* ── HERO IMAGE ── */
.ip-hero-img-wrap { padding: 32px 5% 0; }
.ip-hero-img {
  width: 100%; height: 380px;
  border-radius: var(--radius-xl, 40px); overflow: hidden; position: relative;
}
.ip-hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ip-hero-img__caption {
  position: absolute; bottom: 20px; left: 20px;
  background: rgba(255,255,255,0.92); backdrop-filter: blur(8px);
  padding: 10px 18px; border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px; font-weight: 600; color: var(--brand, #272E32);
}

/* ── GALLERY ── */
/* ── CAM MASONRY GALLERY ── */
.eri-masonry { background: #F5F3EE; padding: 100px 0 80px; }
.eri-masonry__header { max-width: 1200px; margin: 0 auto 56px; padding: 0 40px; text-align: center; }
.eri-masonry__eyebrow { display: block; font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em; color: #7CB342; margin-bottom: 16px; }
.eri-masonry__title { font-family: var(--font-serif, Georgia, serif); font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 700; color: #14201A; line-height: 1.2; margin: 0 0 16px; letter-spacing: -0.01em; }
.eri-masonry__sub { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 1rem; color: #4A5C48; max-width: 560px; margin: 0 auto; line-height: 1.7; }
.eri-masonry__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 1200px; margin: 0 auto; padding: 0 40px; }
.eri-masonry__item { position: relative; border-radius: 12px; overflow: hidden; cursor: pointer; }
.eri-masonry__item img { width: 100%; height: 320px; object-fit: cover; display: block; border-radius: 12px; transition: transform 0.4s ease; }
.eri-masonry__item:hover img { transform: scale(1.03); }
.eri-masonry__caption { position: absolute; bottom: 0; left: 0; right: 0; padding: 32px 16px 14px; background: linear-gradient(to top, rgba(13,26,15,0.75) 0%, transparent 100%); font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 12px; font-weight: 500; color: rgba(255,255,255,0.9); border-radius: 0 0 12px 12px; opacity: 0; transition: opacity 0.3s ease; }
.eri-masonry__item:hover .eri-masonry__caption { opacity: 1; }

/* ── CONTENT + SIDEBAR ── */
.ip-content-wrap {
  padding: 0 5%;
  display: grid; grid-template-columns: 1fr 420px;
  gap: 60px; align-items: start;
}
.ip-main { padding: 64px 0; }
.ip-sidebar { padding: 64px 0; }

/* Prose */
.prose h2 {
  font-family: var(--font-serif);
  font-size: clamp(28px, 3.5vw, 42px);
  font-weight: 700;
  letter-spacing: -0.5px;
  line-height: 1.15;
  color: var(--text-dark, #1a1a1a); margin: 48px 0 20px;
}
.prose h2:first-child { margin-top: 0; }
.prose p {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px; color: var(--text-mid, #4a4a4a); line-height: 1.8; margin-bottom: 18px;
}
.prose ul { list-style: none; padding: 0; margin-bottom: 18px; }
.prose ul li {
  display: flex; align-items: flex-start; gap: 10px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; color: var(--text-mid, #4a4a4a); padding: 5px 0; line-height: 1.6;
}
.prose ul li::before { content: '✓'; color: var(--green, #81AB4C); font-weight: 700; font-size: 13px; margin-top: 3px; flex-shrink: 0; }

/* Callout */
.ip-callout {
  background: var(--green-light, #eef4e4);
  border-left: 4px solid var(--green, #81AB4C);
  border-radius: 0 var(--radius-md, 16px) var(--radius-md, 16px) 0;
  padding: 20px 24px; margin: 32px 0;
}
.ip-callout p { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 15px; color: #3a5a1f; margin: 0; line-height: 1.7; }

/* Film grid */
.ip-film-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin: 24px 0 32px; }
.ip-film-card {
  background: var(--off-white, #F7F6F3);
  border-radius: var(--radius-lg, 24px); padding: 24px 20px;
  border: 2px solid transparent; transition: border-color 0.2s, transform 0.2s;
}
.ip-film-card:hover { border-color: var(--green, #81AB4C); transform: translateY(-2px); }
.ip-film-card--featured { border-color: var(--green, #81AB4C); background: var(--green-light, #eef4e4); }
.ip-film-icon {
  display: block;
  width: 50px; height: 50px;
  color: var(--green, #81AB4C);
  margin-bottom: 20px;
}
.ip-film-card h3 {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 16px; font-weight: 600; color: var(--text-dark, #1a1a1a); margin-bottom: 6px;
}
.ip-film-card p { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 13px; color: var(--text-mid, #4a4a4a); line-height: 1.6; margin: 0; }
.ip-film-price { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 13px; font-weight: 600; color: var(--green, #81AB4C); margin-top: 10px; }

/* Sidebar cards */
.ip-sidebar { padding: 64px 0; position: sticky; top: 100px; align-self: start; }

/* ── SIDEBAR CTA CARD ── */
.ip-sidebar-cta-card {
  border-radius: 20px;
  overflow: hidden;
  margin-bottom: 20px;
}
.ip-sidebar-cta-card__bg {
  position: relative;
  background-size: cover;
  background-position: center;
  padding: 40px 28px;
  min-height: 260px;
  display: flex;
  align-items: flex-end;
}
.ip-sidebar-cta-card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.7) 100%);
  border-radius: 20px;
}
.ip-sidebar-cta-card__content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ip-sidebar-cta-card__label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  color: rgba(255,255,255,0.75);
  margin: 0;
}
.ip-sidebar-cta-card__phone {
  font-family: var(--font-serif);
  font-size: 24px;
  font-weight: 700;
  color: #ffffff;
  text-decoration: none;
  line-height: 1.1;
}
.ip-sidebar-cta-card__btn {
  display: inline-block;
  margin-top: 8px;
  background: var(--green, #81AB4C);
  color: #fff;
  padding: 10px 20px;
  border-radius: 100px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  width: fit-content;
}

/* ── SIDEBAR CITIES LIST ── */
.ip-sidebar-cities {
  background: transparent;
  border: 1px solid var(--off-white, #F7F6F3);
  border-radius: 20px;
  padding: 24px;
  margin-bottom: 20px;
}
.ip-sidebar-cities__title {
  font-family: var(--font-serif);
  font-size: clamp(18px, 2.5vw, 22px);
  font-weight: 700;
  color: #111;
  margin-bottom: 12px;
}
.ip-sidebar-cities__list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.ip-sidebar-cities__list li {
  border-bottom: 1px solid var(--light-gray, #EFEFED);
}
.ip-sidebar-cities__list li:last-child {
  border-bottom: none;
}
.ip-sidebar-city-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 12px;
  border-radius: 8px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-dark, #1a1a1a);
  text-decoration: none;
  transition: all 0.2s;
}
.ip-sidebar-city-link span {
  font-size: 11px;
  color: var(--text-light, #888);
}
.ip-sidebar-city-link:hover {
  background: var(--green, #81AB4C);
  color: #ffffff;
}
.ip-sidebar-city-link:hover span {
  color: rgba(255,255,255,0.75);
}
.ip-sidebar-city-link--active {
  background: var(--green, #81AB4C);
  color: #ffffff;
}
.ip-sidebar-city-link--active span {
  color: rgba(255,255,255,0.75);
}

/* ── LOCAL AREA ── */
.ip-local {
  padding: 64px 5%;
  margin: 0 5%;
}
.ip-local__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
}
.ip-local__map {
  border-radius: var(--radius-xl, 40px);
  overflow: hidden;
  height: 400px;
}
.ip-local__map iframe {
  width: 100%;
  height: 100%;
}
.ip-local__content h2 {
  font-family: var(--font-serif);
  font-size: clamp(28px, 3.5vw, 42px);
  font-weight: 700;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
  margin: 12px 0 16px;
}
.ip-local__content p {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.8;
  margin-bottom: 20px;
}
.ip-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.ip-tag {
  background: #fff; border: 1px solid var(--light-gray, #EFEFED);
  padding: 6px 14px; border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px; color: var(--text-mid, #4a4a4a); font-weight: 500;
}

/* ── NEIGHBORHOOD LIST ── */
.eri-neighborhoods { display: flex; flex-direction: column; margin-top: 20px; }
.eri-nh { display: flex; align-items: flex-start; gap: 14px; padding: 11px 0; border-bottom: 1px solid var(--light-gray, #EFEFED); }
.eri-nh:last-child { border-bottom: none; }
.eri-nh__name { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 13px; font-weight: 700; color: var(--green, #81AB4C); min-width: 110px; flex-shrink: 0; line-height: 1.65; }
.eri-nh__desc { font-family: var(--font-body, 'DM Sans', sans-serif); font-size: 13px; color: var(--text-mid, #4a4a4a); line-height: 1.65; }

/* ── TESTIMONIALS ── */
.eri-testimonials { background: #F5F3EE; padding: 96px 5%; }
.eri-testimonials__header { text-align: center; margin-bottom: 56px; }
.eri-testimonials__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin-bottom: 0.75rem; display: block; }
.eri-testimonials__title { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 700; color: #14201A; line-height: 1.2; margin: 0 0 1rem; }
.eri-testimonials__sub { font-family: 'Inter', sans-serif; font-size: 1rem; color: #4A5C48; max-width: 500px; margin: 0 auto; line-height: 1.7; }
.eri-testimonials__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 1280px; margin: 0 auto; }
.eri-tcard { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 2px 16px rgba(13,26,15,0.07); display: flex; flex-direction: column; }
.eri-tcard__img-wrap { overflow: hidden; height: 220px; flex-shrink: 0; }
.eri-tcard__img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; transition: transform 0.4s ease; }
.eri-tcard:hover .eri-tcard__img { transform: scale(1.03); }
.eri-tcard__body { padding: 28px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
.eri-tcard__stars { color: #F5A623; font-size: 1.1rem; letter-spacing: 2px; }
.eri-tcard__quote { font-family: 'Inter', sans-serif; font-size: 0.92rem; color: #3a4a38; line-height: 1.75; margin: 0; font-style: italic; flex: 1; }
.eri-tcard__meta { border-top: 1px solid #e8ede6; padding-top: 14px; margin-top: auto; }
.eri-tcard__name { font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 700; color: #14201A; margin: 0 0 3px; }
.eri-tcard__role { font-family: 'Inter', sans-serif; font-size: 0.8rem; color: #7CB342; margin: 0; font-weight: 500; }
@media (max-width: 960px) { .eri-testimonials__grid { grid-template-columns: 1fr; max-width: 520px; margin: 0 auto; } .eri-testimonials { padding: 64px 5%; } }
@media (max-width: 600px) { .eri-tcard__img-wrap { height: 180px; } }

/* ── RESOURCES / SPEC SHEETS ── */
.eri-resources { background: #ffffff; padding: 96px 5%; }
.eri-resources__grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
.eri-resources__image-col { position: relative; }
.eri-resources__img { width: 100%; height: 480px; object-fit: cover; border-radius: 20px; display: block; }
.eri-resources__eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em; color: #7CB342; margin: 0 0 16px; display: block; }
.eri-resources__title { font-family: 'Playfair Display', serif; font-size: clamp(1.6rem, 2.8vw, 2.25rem); font-weight: 700; color: #14201A; line-height: 1.2; margin: 0 0 18px; }
.eri-resources__desc { font-family: 'Inter', sans-serif; font-size: 0.95rem; color: #4A5C48; line-height: 1.8; margin: 0 0 32px; }
.eri-resources__list { list-style: none; padding: 0; margin: 0 0 32px; display: flex; flex-direction: column; }
.eri-resources__item { border-bottom: 1px solid #e8ede6; }
.eri-resources__item:first-child { border-top: 1px solid #e8ede6; }
.eri-resources__link { display: flex; align-items: center; gap: 14px; padding: 14px 8px; text-decoration: none; color: #14201A; transition: background 0.2s ease, padding-left 0.2s ease; border-radius: 8px; }
.eri-resources__link:hover { background: #f3f6f1; padding-left: 14px; }
.eri-resources__pdf-icon { flex-shrink: 0; color: #7CB342; }
.eri-resources__link-text { flex: 1; display: flex; flex-direction: column; gap: 2px; }
.eri-resources__link-text strong { font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; color: #14201A; }
.eri-resources__link-text span { font-family: 'Inter', sans-serif; font-size: 0.78rem; color: #7a8a78; }
.eri-resources__arrow { font-size: 1rem; color: #7CB342; font-weight: 700; flex-shrink: 0; }
.eri-resources__cta { display: inline-flex; align-items: center; font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 600; color: #7CB342; text-decoration: none; transition: gap 0.2s ease; gap: 0; }
.eri-resources__cta:hover { gap: 4px; }
@media (max-width: 960px) { .eri-resources__grid { grid-template-columns: 1fr; } .eri-resources { padding: 64px 5%; } .eri-resources__img { height: 320px; } }

/* ── FAQ ACCORDION ── */
.ip-faq {
  padding: 64px 5%;
  margin: 0 5%;
}
.ip-faq__hd {
  text-align: center;
  margin-bottom: 40px;
}
.section-eyebrow {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px; font-weight: 700;
  letter-spacing: 2px; text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin: 0 0 8px;
}
.section-title {
  font-family: var(--font-serif);
  font-size: clamp(28px, 3.5vw, 42px);
  font-weight: 700;
  letter-spacing: -0.5px;
  color: var(--text-dark, #1a1a1a);
}
.ip-faq__item {
  border-bottom: 1px solid var(--light-gray, #EFEFED);
  cursor: pointer;
}
.ip-faq__item:last-child { border-bottom: none; }
.ip-faq__q {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 0;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px; font-weight: 500;
  color: var(--text-dark, #1a1a1a);
}
.ip-faq__toggle {
  font-size: 24px;
  color: var(--green, #81AB4C);
  font-weight: 300;
  transition: transform 0.2s;
}
.ip-faq__item--open .ip-faq__toggle { transform: rotate(45deg); }
.ip-faq__a {
  display: none;
  padding: 0 0 20px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.7;
}
.ip-faq__item--open .ip-faq__a { display: block; }

/* ── CTA BANNER ── */
.ip-cta {
  margin: 0 5% 40px;
  padding: 64px 5%;
  background: var(--brand, #272E32);
  border-radius: var(--radius-xl, 40px);
  text-align: center;
}
.ip-cta h2 {
  font-family: var(--font-serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 32px;
  letter-spacing: -0.5px;
}
.ip-cta h2 em { font-style: italic; color: var(--green, #81AB4C); }
.ip-cta__btns { display: flex; gap: 14px; justify-content: center; align-items: center; flex-wrap: wrap; }

/* ── CINEMATIC CTA ── */
.eri-cinematic-cta {
  position: relative;
  min-height: 560px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.eri-cinematic-cta__media {
  position: absolute;
  inset: 0;
}
.eri-cinematic-cta__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.eri-cinematic-cta__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(13,26,15,0.88) 0%, rgba(46,107,48,0.75) 40%, rgba(13,26,15,0.88) 100%);
}
.eri-cinematic-cta__vignette {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, rgba(13,26,15,0.2) 0%, rgba(13,26,15,0.6) 100%);
}
.eri-cinematic-cta__content {
  position: relative;
  z-index: 10;
  max-width: 760px;
  padding: 80px 24px;
  text-align: center;
}
.eri-cinematic-cta__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 4.5vw, 3.25rem);
  font-weight: 700;
  color: #F3F6F1;
  margin-bottom: 20px;
  line-height: 1.1;
  letter-spacing: -0.02em;
}
.eri-cinematic-cta__text {
  font-family: 'Inter', sans-serif;
  font-size: clamp(0.95rem, 1.8vw, 1.1rem);
  color: rgba(243,246,241,0.82);
  max-width: 620px;
  margin: 0 auto 40px;
  line-height: 1.75;
}
.eri-cinematic-cta__actions {
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
}
.eri-cinematic-cta__btn-primary {
  display: inline-flex;
  align-items: center;
  background: #7CB342;
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  font-weight: 600;
  text-decoration: none;
  padding: 16px 36px;
  border-radius: 100px;
  border: 2px solid #7CB342;
  transition: background 0.25s ease, border-color 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
}
.eri-cinematic-cta__btn-primary:hover {
  background: #6aa032;
  border-color: #6aa032;
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(124,179,66,0.35);
  color: #fff;
}
.eri-cinematic-cta__btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #F3F6F1;
  font-family: 'Inter', sans-serif;
  font-size: 1rem;
  font-weight: 600;
  text-decoration: none;
  padding: 14px 28px;
  border-radius: 100px;
  border: 2px solid rgba(255,255,255,0.3);
  transition: background 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
}
.eri-cinematic-cta__btn-secondary:hover {
  background: rgba(255,255,255,0.12);
  border-color: rgba(124,179,66,0.6);
  color: #F3F6F1;
  transform: translateY(-2px);
}

/* ── CITIES TICKER ── */
.eri-cities-ticker {
  background: #14201A;
  padding: 20px 0;
  overflow: hidden;
}
.eri-cities-ticker__track {
  display: flex;
  align-items: center;
  gap: 24px;
  animation: eri-ticker-scroll 40s linear infinite;
  white-space: nowrap;
}
.eri-cities-ticker span {
  font-family: 'Space Mono', monospace;
  font-size: 0.875rem;
  font-weight: 700;
  color: #F3F6F1;
  text-transform: uppercase;
  letter-spacing: 2px;
}
.eri-cities-ticker__dot {
  width: 6px;
  height: 6px;
  background: #7CB342;
  border-radius: 50%;
  flex-shrink: 0;
}
@keyframes eri-ticker-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
@media (prefers-reduced-motion: reduce) {
  .eri-cities-ticker__track { animation: none; }
}

/* ── GEO / SR-ONLY ── */

/* ── FADE IN ANIMATION ── */
.fade-in {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 0.6s ease forwards;
}
.fade-in-delay-1 { animation-delay: 0.15s; }
@keyframes fadeInUp {
  to { opacity: 1; transform: translateY(0); }
}

/* ── LINE MASK REVEAL (inline — avoids scoped style issues) ── */
.line-mask { display: block; }
.line-mask__line { display: block; overflow: hidden; }
.line-mask__inner {
  display: block;
  transform: translateY(105%);
  transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  transition-delay: calc(var(--i) * var(--line-stagger, 120ms));
  will-change: transform;
}
.line-mask.is-visible .line-mask__inner { transform: translateY(0); }
@media (prefers-reduced-motion: reduce) {
  .line-mask__inner { transform: none; transition: none; }
}

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .ip-content-wrap {
    grid-template-columns: 1fr;
  }
  .ip-sidebar {
    position: static;
    padding: 0 0 64px;
  }
  .ip-local__grid {
    grid-template-columns: 1fr;
  }
  .ip-gallery__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 768px) {
  .ip-hero {
    grid-template-columns: 1fr;
    padding: 48px 5%;
    gap: 24px;
  }
  .ip-gallery__grid {
    grid-template-columns: 1fr;
  }
  .eri-masonry__grid { columns: 1; }
  .eri-masonry__header { padding: 0 20px; }
  .ip-film-grid {
    grid-template-columns: 1fr;
  }
  .ip-cta__btns {
    flex-direction: column;
  }
  .ip-cta__btns .ip-btn {
    width: 100%;
    text-align: center;
  }
}
@media (max-width: 480px) {
  .eri-prop-slider__content {
    padding-left: 24px;
    padding-right: 24px;
    max-width: calc(100% - 48px);
  }
  .eri-prop-slider__title {
    font-size: 28px;
  }
  .eri-prop-slider__desc {
    font-size: 14px;
  }
  .eri-prop-slider__step {
    font-size: 11px;
  }
  .eri-prop-slider__benefits li {
    font-size: 0.75rem;
  }
}

</style>

<script>
  // Brand card carousel
  (function() {
    const track = document.getElementById('brandsTrack');
    const dotsContainer = document.getElementById('brandsDots');
    const cards = track ? Array.from(track.querySelectorAll('.eri-brands__card')) : [];
    const visibleCount = () => window.innerWidth > 1100 ? 4 : window.innerWidth > 760 ? 3 : 1;
    let dots = [];
    function buildDots() {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      dots = [];
      const pages = Math.ceil(cards.length / visibleCount());
      for (let i = 0; i < pages; i++) {
        const d = document.createElement('button');
        d.className = 'eri-brands__dot' + (i === 0 ? ' eri-brands__dot--active' : '');
        d.setAttribute('aria-label', `Brand page ${i + 1}`);
        d.addEventListener('click', () => scrollToPage(i));
        dotsContainer.appendChild(d);
        dots.push(d);
      }
    }
    function scrollToPage(i) {
      if (!track || !cards[0]) return;
      const cardW = cards[0].getBoundingClientRect().width + 24;
      track.scrollTo({ left: i * visibleCount() * cardW, behavior: 'smooth' });
    }
    function updateDots() {
      if (!track || !cards[0]) return;
      const cardW = cards[0].getBoundingClientRect().width + 24;
      const page = Math.round(track.scrollLeft / (visibleCount() * cardW));
      dots.forEach((d, i) => d.classList.toggle('eri-brands__dot--active', i === page));
    }
    if (track) {
      track.addEventListener('scroll', updateDots, { passive: true });
      document.getElementById('brandsArrowLeft')?.addEventListener('click', () => { const cardW = cards[0]?.getBoundingClientRect().width + 24 || 300; track.scrollBy({ left: -(visibleCount() * cardW), behavior: 'smooth' }); });
      document.getElementById('brandsArrowRight')?.addEventListener('click', () => { const cardW = cards[0]?.getBoundingClientRect().width + 24 || 300; track.scrollBy({ left: visibleCount() * cardW, behavior: 'smooth' }); });
      // drag to scroll
      let isDown = false, startX = 0, scrollLeft = 0;
      track.addEventListener('mousedown', e => { isDown = true; startX = e.pageX - track.offsetLeft; scrollLeft = track.scrollLeft; });
      track.addEventListener('mouseleave', () => isDown = false);
      track.addEventListener('mouseup', () => isDown = false);
      track.addEventListener('mousemove', e => { if (!isDown) return; e.preventDefault(); const x = e.pageX - track.offsetLeft; track.scrollLeft = scrollLeft - (x - startX); });
    }
    buildDots();
    window.addEventListener('resize', buildDots);
  })();

  // Film types tab switcher
  document.querySelectorAll('.eri-films__tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const key = tab.getAttribute('data-eritab');
      document.querySelectorAll('.eri-films__tab').forEach(t => t.classList.remove('eri-films__tab--active'));
      document.querySelectorAll('.eri-films__img-set').forEach(s => s.classList.remove('eri-films__img-set--active'));
      document.querySelectorAll('.eri-films__panel').forEach(p => p.classList.remove('eri-films__panel--active'));
      tab.classList.add('eri-films__tab--active');
      document.querySelector(`.eri-films__img-set[data-eritab="${key}"]`)?.classList.add('eri-films__img-set--active');
      document.querySelector(`.eri-films__panel[data-eritab="${key}"]`)?.classList.add('eri-films__panel--active');
    });
  });

  // Property type slider
  (function(){
    const track = document.getElementById('eriTrack');
    const navItems = document.querySelectorAll('[data-eripropnav]');
    const prev = document.getElementById('eriPropPrev');
    const next = document.getElementById('eriPropNext');
    if (!track) return;
    let cur = 0;
    const total = 2;
    function goTo(i) {
      cur = (i + total) % total;
      track.style.transform = `translateX(-${cur * 100}%)`;
      navItems.forEach((n, idx) => n.classList.toggle('eri-prop-slider__nav-item--active', idx === cur));
    }
    prev?.addEventListener('click', () => goTo(cur - 1));
    next?.addEventListener('click', () => goTo(cur + 1));
    navItems.forEach((n, i) => n.addEventListener('click', () => goTo(i)));
    goTo(0);
  })();

  // Count-up animation for hero stats
  const countUp = (el) => {
    const target = parseFloat(el.getAttribute('data-count') || '0');
    const isDecimal = target % 1 !== 0;
    const duration = 1800;
    const start = performance.now();
    const animate = (now) => {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const ease = 1 - Math.pow(1 - progress, 3);
      const value = target * ease;
      el.textContent = isDecimal ? value.toFixed(1) : Math.round(value).toLocaleString();
      if (progress < 1) requestAnimationFrame(animate);
    };
    requestAnimationFrame(animate);
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        countUp(entry.target);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });

  document.querySelectorAll('.hero-stat-item__number[data-count]').forEach(el => observer.observe(el));

  // Line mask reveal
  const lineMaskObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target;
      el.style.setProperty('--line-stagger', (el.dataset.stagger || '120') + 'ms');
      el.classList.add('is-visible');
      lineMaskObserver.unobserve(el);
    });
  }, { threshold: 0.3 });
  document.querySelectorAll('.line-mask').forEach((el) => lineMaskObserver.observe(el));
</script>
