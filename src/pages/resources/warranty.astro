---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogos from '../../components/BrandLogos.astro';
import GalleryBanner from '../../components/GalleryBanner.astro';
import BentoGridPhoto from '../../components/BentoGridPhoto.astro';
import AccordionFAQ from '../../components/AccordionFAQ.astro';
import CTAAvatars from '../../components/CTAAvatars.astro';

const title = 'Window Film Warranty Philadelphia | Manufacturer Coverage & Workmanship Guarantee';
const description = 'Every window film we install comes backed by manufacturer warranty. Download warranty documents for 3M, LLumar, Vista, Solar Gard, Huper Optik, Madico, and more. Plus our own workmanship guarantee.';
const dateModified = new Date().toISOString().slice(0, 10);

const galleryPhotos = [
  '/images/warranty/manufacturer-warranty-certificate-philadelphia.jpg',
  '/images/warranty/installer-warranty-card-philadelphia.jpg',
  '/images/warranty/window-film-maintenance-care-philadelphia.jpg',
  '/images/warranty/premium-window-film-rolls-philadelphia.jpg',
  '/images/warranty/flawless-window-film-installation-philadelphia.jpg',
];

const bentoItems = [
  { span: 'lg', title: 'Manufacturer Warranties', desc: 'Every brand we install — 3M, LLumar, Vista, Solar Gard, Huper Optik, Madico, and more — stands behind its products with comprehensive coverage.', img: '/images/warranty/manufacturer-warranty-certificate-philadelphia.jpg', href: '#warranty-downloads' },
  { span: 'sm', title: 'Workmanship Guarantee', desc: 'Our own warranty covers installation defects — separate from the manufacturer product warranty.', img: '/images/warranty/installer-warranty-card-philadelphia.jpg', href: '/contact/' },
  { span: 'sm', title: 'Warranty Care', desc: 'Proper maintenance protects your coverage. Follow our care guide to keep your warranty intact.', img: '/images/warranty/window-film-maintenance-care-philadelphia.jpg', href: '/resources/maintenance-and-care/' },
  { span: 'md', title: 'All Brands Covered', desc: '15 brands — residential and commercial. Every product we carry has manufacturer-backed warranty coverage.', img: '/images/warranty/premium-window-film-rolls-philadelphia.jpg', href: '/products/' },
  { span: 'md', title: 'Claim Support', desc: 'We coordinate the entire warranty claim process with the manufacturer on your behalf.', img: '/images/warranty/flawless-window-film-installation-philadelphia.jpg', href: '/contact/' },
  { span: 'md', title: 'Transferable Coverage', desc: 'Many warranties transfer with property sale. Ask us about transferability for your specific film.', img: '/images/warranty/window-film-installation-warranty-philadelphia.jpg', href: '/contact/' },
];

const warrantyBrands = [
  { brand: '3M', docs: [
    { label: '3M Commercial Window Film Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/3M-Commercial-Window-Film-Warranty-philadelphia.pdf' },
    { label: '3M Residential Window Film Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/3M-Residential-Window-Film-Warranty-philadelphia.pdf' },
  ]},
  { brand: 'LLumar', docs: [
    { label: 'LLumar Window Film Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/LLumar-Window-Film-Warranty-philadelphia.pdf' },
  ]},
  { brand: 'Vista', docs: [
    { label: 'Vista Residential Window Film Gold Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/Vista-Residential-Window-Film-Gold-Warranty-philadelphia.pdf' },
    { label: 'Vista Residential Window Film Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/Vista-Residential-Window-Film-Warranty-philadelphia.pdf' },
    { label: 'Vista Window Film Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/Vista-Window-Film-Warranty-philadelphia.pdf' },
  ]},
  { brand: 'Solar Gard', docs: [
    { label: 'SolarGard Limited Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/SolarGard-Limited-Warranty-philadelphia.pdf' },
    { label: 'Solar Gard Residential and Commercial Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/Solar-Gard-Residential-and-Commercial-Window-Film-Warranty-philadelphia.pdf' },
  ]},
  { brand: 'Huper Optik', docs: [
    { label: 'Huper Optik Standard Window Film Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/Huper-Optik-Standard-Window-Film-Warranty-philadelphia.pdf' },
    { label: 'Huper Optik Residential Window Film Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/Huper-Optik-Residential-Window-Film-Warranty-philadelphia.pdf' },
  ]},
  { brand: 'Madico', docs: [
    { label: 'Madico Residential and Commercial Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/Madico-Residential-and-Commercial-Window-Film-Warranty-philadelphia.pdf' },
  ]},
  { brand: 'C-Bond', docs: [
    { label: 'C-Bond Commercial Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/C-Bond-Commercial-Warranty-philadelphia.pdf' },
    { label: 'C-Bond Residential Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/C-Bond-Residential-Warranty-philadelphia.pdf' },
  ]},
  { brand: 'Casper Cloaking Film', docs: [
    { label: 'Designtex Casper Cloaking Film Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/Designtex-Casper-Cloaking-Film-Warranty-philadelphia.pdf' },
  ]},
  { brand: 'Graffiti Shield', docs: [
    { label: 'Graffiti Shield Limited Warranty', url: '/resources/graffiti-shield-warranty-philadelphia.pdf' },
  ]},
  { brand: 'Hanita Coatings', docs: [
    { label: 'Hanita Coatings Window Film Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/Hanita-Coatings-Window-Film-Warranty-philadelphia.pdf' },
  ]},
  { brand: 'DryWired NanoTint', docs: [
    { label: 'Drywired Liquid Nanotint Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/Drywired-Liquid-Nanotint-Warranty-philadelphia.pdf' },
  ]},
  { brand: 'SunTek', docs: [
    { label: 'SunTek Residential and Commercial Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/SunTek-Residential-and-Commercial-Window-Film-Warranty-philadelphia.pdf' },
  ]},
  { brand: 'Sunscape', docs: [
    { label: 'Sunscape Residential Window Film Warranty', url: 'https://www.windowfilmphiladelphia.net/wp-content/uploads/Sunscape-Residential-Window-Film-Warranty-philadelphia.pdf' },
  ]},
  { brand: 'HDClear', docs: [
    { label: '10 Year Warranty for flat glass applications — contact us for full details', url: '/contact/' },
  ]},
  { brand: 'Solyx', docs: [
    { label: 'Solyx Window Film Warranty', url: 'https://www.decorativefilm.com/warranty' },
  ]},
  { brand: 'V-Kool', docs: [
    { label: 'V-Kool Residential and Commercial Warranty', url: 'https://v-kool-usa.com/residential-and-commercial-warranties/' },
  ]},
];

const faqItems = [
  { question: 'Do all window film products come with a warranty?', answer: 'Yes — all major manufacturers provide warranties on their window film products. Residential films typically carry lifetime warranties for the original property owner. Commercial films vary by product series, typically ranging from 5 to 15 years of coverage. We provide full warranty documentation at the time of installation for every product we install.' },
  { question: 'What does the manufacturer warranty cover?', answer: 'Manufacturer warranties cover adhesion failure, color shift, delamination, and film degradation under normal use conditions. They do not cover physical damage from impacts, scratches, or cleaning with improper materials. Review the specific warranty document for your installed product for full terms and conditions.' },
  { question: 'What is the Window Film Philadelphia workmanship warranty?', answer: 'Our workmanship warranty covers installation defects attributable to our installation process — including edge lifting from installer error, install-related bubbling, or adhesion failure caused by our application technique. This is separate from the manufacturer product warranty and covers our craftsmanship specifically.' },
  { question: 'Does cleaning my film incorrectly void the warranty?', answer: 'Yes — using abrasives, harsh chemicals, or cleaning within the first 30 days of installation can void the manufacturer warranty. Follow the care instructions provided at installation to maintain full coverage. Our <a href="/resources/maintenance-and-care/">maintenance guide</a> outlines all approved cleaning practices.' },
  { question: 'Is my warranty transferable if I sell my property?', answer: 'Some manufacturer warranties are transferable to new property owners — this varies by brand and product series. Contact us with your installation details and we will check the specific transferability terms for your installed film. We recommend checking transferability before listing your property for sale.' },
  { question: 'How do I make a warranty claim?', answer: 'Contact Window Film Philadelphia with your installation date, product name, and a description of the issue. Our team coordinates the claim process with the manufacturer and handles all communication on your behalf. We make warranty claims as straightforward as possible — you do not need to deal with the manufacturer directly.' },
];

const faqAccordionItems = faqItems.map(f => ({ q: f.question, a: f.answer }));

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.windowfilmphiladelphia.net/' },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.windowfilmphiladelphia.net/resources/' },
      { '@type': 'ListItem', position: 3, name: 'Warranty', item: 'https://www.windowfilmphiladelphia.net/resources/warranty/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://www.windowfilmphiladelphia.net/resources/warranty/',
    url: 'https://www.windowfilmphiladelphia.net/resources/warranty/',
    name: 'Window Film Warranty Philadelphia',
    description,
    dateModified,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(f => ({
      '@type': 'Question',
      name: f.question.replace(/<[^>]+>/g, ''),
      acceptedAnswer: { '@type': 'Answer', text: f.answer.replace(/<[^>]+>/g, '') },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://www.windowfilmphiladelphia.net/resources/warranty/"
  faqItems={faqItems}
  serviceName="Window Film Philadelphia Warranty"
  serviceDesc="Manufacturer warranties and workmanship guarantee for every window film installation in Philadelphia."
  serviceUrl="https://www.windowfilmphiladelphia.net/resources/warranty/"
  schemas={pageSchemas}
>

<!-- ═══ HERO ═══ -->
<section class="wr-hero">
  <div class="wr-hero__bg" style="background-image: url('/images/warranty/window-film-warranty-philadelphia-hero.jpg')" role="img" aria-label="Window film warranty documentation and certified installer certificate"></div>
  <div class="wr-hero__overlay"></div>
  <div class="wr-hero__content">
    <div class="wr-hero__eyebrow">
      <span class="wr-hero__eyebrow-dot" aria-hidden="true"></span>
      WARRANTY INFORMATION
      <span class="wr-hero__eyebrow-dot" aria-hidden="true"></span>
    </div>
    <h1 class="wr-hero__title">Your Investment. Protected.</h1>
    <p class="wr-hero__subtitle">Every window film product we install comes backed by a manufacturer warranty — covering film performance, adhesion, and color stability. Plus our own workmanship guarantee on every installation.</p>
    <div class="wr-hero__cta">
      <a href="/contact/" class="wr-hero__btn-primary">Get a Free Quote</a>
      <a href="#warranty-downloads" class="wr-hero__btn-secondary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
        Download Warranty Docs
      </a>
    </div>
    <div class="wr-hero__stats-panel" aria-label="Key statistics">
      <div class="wr-hero__stats-inner">
        <div class="wr-hero__stat">
          <span class="wr-hero__stat-number">15</span>
          <span class="wr-hero__stat-label">Brands Covered</span>
        </div>
        <div class="wr-hero__stat-divider" aria-hidden="true"></div>
        <div class="wr-hero__stat">
          <span class="wr-hero__stat-number">2008</span>
          <span class="wr-hero__stat-label">Serving Since</span>
        </div>
        <div class="wr-hero__stat-divider" aria-hidden="true"></div>
        <div class="wr-hero__stat">
          <span class="wr-hero__stat-number">2,400+</span>
          <span class="wr-hero__stat-label">Projects Warranted</span>
        </div>
        <div class="wr-hero__stat-divider" aria-hidden="true"></div>
        <div class="wr-hero__stat">
          <span class="wr-hero__stat-number">4.9</span>
          <span class="wr-hero__stat-label">Google Rating</span>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="wr-body">

<!-- TRUST BAR -->
<section class="wr-trust">
  <div class="wr-container">
    <p class="wr-trust__label">Every brand we install is backed by manufacturer warranty — and our own workmanship guarantee</p>
  </div>
</section>

<BrandLogos />

<!-- ═══ INTRO — 2-col ═══ -->
<section class="wr-intro">
  <div class="wr-intro__container">
    <div class="wr-intro__image-wrap">
      <img src="/images/warranty/window-film-installation-warranty-philadelphia.jpg" alt="Professional window film installer showing warranty documentation to a Philadelphia homeowner" class="wr-intro__image" loading="lazy" />
    </div>
    <div class="wr-intro__content">
      <span class="wr-eyebrow">Warranty Coverage</span>
      <h2 class="wr-intro__title">Two layers of protection on every installation.</h2>
      <p class="wr-intro__lead">Every <a href="/services/residential/" style="color: var(--wr-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">residential</a> and <a href="/services/commercial/" style="color: var(--wr-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">commercial</a> window film installation we complete comes with two layers of warranty coverage. First, the manufacturer warranty — backed by brands like <a href="/products/3m-window-film/" style="color: var(--wr-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">3M</a>, <a href="/products/llumar-window-film/" style="color: var(--wr-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">LLumar</a>, <a href="/products/vista-window-film/" style="color: var(--wr-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">Vista</a>, <a href="/products/solar-gard-window-film/" style="color: var(--wr-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">Solar Gard</a>, <a href="/products/huper-optik-window-film/" style="color: var(--wr-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">Huper Optik</a>, and <a href="/products/madico-window-film/" style="color: var(--wr-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">Madico</a> — covering film performance, adhesion, and color stability. Second, our own workmanship warranty covering installation defects.</p>
      <p class="wr-intro__lead">Residential films typically carry lifetime warranties for the original property owner. Commercial films vary by product series, typically ranging from 5 to 15 years. Warranty terms cover adhesion failure, color shift, delamination, and film degradation under normal use and cleaning conditions. Download the specific warranty document for your installed product below.</p>
    </div>
  </div>
</section>

<!-- ═══ GALLERY BANNER — Our Work ═══ -->
<GalleryBanner
  titleLines={['YOUR', 'COVERAGE.']}
  eyebrow="WARRANTY DOCUMENTS"
  description="Every project we complete is backed by manufacturer warranty and our own workmanship guarantee. Download the warranty documents for your installed product below."
  photos={galleryPhotos}
  hintText="Hover the photos · click to bring forward"
  theme="dark"
/>

<!-- ═══ BENTO GRID PHOTO — warranty coverage ═══ -->
<BentoGridPhoto
  heading="Every brand. Every install. Fully warranted."
  sub="Manufacturer warranties plus our own workmanship guarantee — two layers of protection on every window film installation."
  items={bentoItems}
/>

<!-- ═══ WARRANTY DOWNLOADS ═══ -->
<section class="wr-downloads" id="warranty-downloads">
  <div class="wr-container">
    <div class="wr-downloads__head">
      <span class="wr-eyebrow wr-eyebrow--center">Downloads</span>
      <h2 class="wr-downloads__title">Warranty Documents by Brand</h2>
      <p class="wr-downloads__intro">Download the manufacturer warranty for your installed product. Don't see your brand? <a href="/contact/" style="color: var(--wr-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">Contact us</a> — we carry warranty documentation for every product we install, including <a href="/products/hdclear-window-film/" style="color: var(--wr-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">HDClear</a>, <a href="/products/solyx-window-film/" style="color: var(--wr-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">Solyx</a>, and <a href="/products/v-kool/" style="color: var(--wr-green-dark, #7CB342); text-decoration: underline; text-underline-offset: 3px;">V-Kool</a>.</p>
    </div>
    <div class="wr-downloads__grid">
      {warrantyBrands.map((brand) => (
        <div class={`wr-downloads__card${brand.docs.length === 0 ? ' wr-downloads__card--empty' : ''}`}>
          <h3 class="wr-downloads__brand">{brand.brand}</h3>
          {brand.docs.length > 0 ? (
            <ul class="wr-downloads__list">
              {brand.docs.map((doc) => (
                <li class="wr-downloads__item">
                  <a href={doc.url} target="_blank" rel="noopener noreferrer" class="wr-downloads__link">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/></svg>
                    {doc.label}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="wr-downloads__empty">Warranty handled per-project. <a href="/contact/">Contact us</a> for details.</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ FAQ ═══ -->
<AccordionFAQ
  eyebrow="FAQ"
  heading="Common questions about window film warranties"
  sub="Everything you need to know about manufacturer coverage, workmanship guarantees, and warranty claims."
  items={faqAccordionItems}
/>

<!-- ═══ CTA ═══ -->
<CTAAvatars
  title="Questions about your warranty? We're here to help."
  subtitle="Contact Window Film Philadelphia with your installation date, product name, and any warranty questions. We coordinate the entire claim process with the manufacturer on your behalf."
  count="Trusted by 2,400+ Philadelphia property owners"
  btnLabel="Get a Free Consultation"
  btnHref="/contact/"
  avatars={[
    { name: 'David R.', location: 'Center City', img: '/images/about/about-avatar-1.jpg' },
    { name: 'Lisa M.', location: 'Rittenhouse', img: '/images/about/about-avatar-3.jpg' },
    { name: 'Robert K.', location: 'South Street', img: '/images/about/about-avatar-2.jpg' },
    { name: 'Janet F.', location: 'Manayunk', img: '/images/about/about-avatar-5.jpg' },
    { name: 'Sarah M.', location: 'Fishtown', img: '/images/about/about-avatar-8.jpg' },
    { name: 'Marco V.', location: 'Old City', img: '/images/about/about-avatar-7.jpg' },
  ]}
/>

<!-- ═══ GEO BLOCK (hidden SEO/AEO content) ═══ -->
<div class="wr-geo" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;">
  <h2>Window Film Warranty Philadelphia — Manufacturer Coverage & Workmanship Guarantee</h2>
  <p>Window Film Philadelphia provides manufacturer warranty coverage on every window film installation we complete across the Delaware Valley. We carry warranty documentation for 15 brands including 3M, LLumar, Vista, Solar Gard, Huper Optik, Madico, C-Bond, Casper Cloaking Film, Graffiti Shield, Hanita Coatings, DryWired NanoTint, SunTek, Sunscape, HDClear, Solyx, and V-Kool. Residential films typically carry lifetime warranties for the original property owner. Commercial films range from 5 to 15 years depending on product series. Our workmanship warranty covers installation defects separate from the manufacturer product warranty. Download warranty documents for your installed product or contact us for warranty claim assistance. Serving Center City, Old City, South Philly, Fishtown, Northern Liberties, Manayunk, University City, King of Prussia, Camden NJ, and the broader Delaware Valley since 2008.</p>
  <dl>
    <dt>What does a window film warranty cover?</dt>
    <dd>Manufacturer warranties cover adhesion failure, color shift, delamination, and film degradation under normal use conditions. They do not cover physical damage from impacts, scratches, or improper cleaning. Our workmanship warranty covers installation defects separately.</dd>
    <dt>How long is a window film warranty valid?</dt>
    <dd>Residential window films typically carry lifetime warranties for the original property owner. Commercial films vary by product series, typically ranging from 5 to 15 years of coverage. Warranty terms vary by manufacturer and product.</dd>
    <dt>How do I make a window film warranty claim in Philadelphia?</dt>
    <dd>Contact Window Film Philadelphia with your installation date, product name, and a description of the issue. We coordinate the entire claim process with the manufacturer on your behalf and handle all communication.</dd>
    <dt>Which window film brands have warranties?</dt>
    <dd>Every brand we install carries a manufacturer warranty: 3M, LLumar, Vista, Solar Gard, Huper Optik, Madico, C-Bond, Casper Cloaking Film, Graffiti Shield, Hanita Coatings, DryWired NanoTint, SunTek, Sunscape, HDClear, Solyx, and V-Kool.</dd>
  </dl>
  <ul>
    <li>Window film warranty Philadelphia</li>
    <li>Window film manufacturer warranty Philadelphia PA</li>
    <li>Window tinting warranty Philadelphia</li>
    <li>3M window film warranty Philadelphia</li>
    <li>LLumar window film warranty Philadelphia</li>
    <li>Vista window film warranty Philadelphia</li>
    <li>Solar Gard window film warranty Philadelphia</li>
    <li>Huper Optik window film warranty Philadelphia</li>
    <li>Madico window film warranty Philadelphia</li>
    <li>Window film workmanship warranty Philadelphia</li>
  </ul>
</div>

</div>

</BaseLayout>

<style>
/* ── DESIGN TOKENS — site palette ══ */
:root {
  --wr-radius: 5px;
  --wr-charcoal: #272E32;
  --wr-green: #81AB4C;
  --wr-green-light: #eef4e4;
  --wr-green-dark: #7CB342;
  --wr-off-white: #F7F6F3;
  --wr-light-gray: #EFEFED;
  --wr-text-dark: #1a1a1a;
  --wr-text-mid: #4a4a4a;
  --wr-text-light: #888;
}

.wr-body { background: #ffffff; }
.wr-container { max-width: 1280px; margin: 0 auto; padding: 0 5%; }

/* ── EYEBROW ══ */
.wr-eyebrow {
  display: inline-block;
  font-family: 'DM Sans', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--wr-green);
  margin-bottom: 16px;
}
.wr-eyebrow--center { display: block; text-align: center; margin-bottom: 20px; }

/* ── HERO ══ */
.wr-hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.wr-hero__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
.wr-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(39,46,50,0.68) 0%, rgba(39,46,50,0.82) 55%, rgba(39,46,50,0.95) 100%);
}
.wr-hero__content {
  position: relative;
  z-index: 10;
  max-width: 860px;
  padding: 120px 24px 80px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.wr-hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: 'Space Mono', monospace;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: rgba(124, 179, 66, 0.85);
  margin-bottom: 28px;
  background: rgba(124, 179, 66, 0.08);
  border: 1px solid rgba(124, 179, 66, 0.2);
  padding: 8px 18px;
  border-radius: 100px;
}
