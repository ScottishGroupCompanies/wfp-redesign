  font-size: 22px;
  font-weight: 300;
  color: var(--green, #81AB4C);
  flex-shrink: 0;
  transition: transform 0.25s;
}
.pr-faq__item--open .pr-faq__toggle {
  transform: rotate(45deg);
}
.pr-faq__a {
  display: none;
  padding: 0 0 24px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
