  flex-shrink: 0;
}

/* ── FADE IN ── */
.fade-in {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}
.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .pr-intro__inner { grid-template-columns: 1fr; gap: 40px; }
  .pr-feat-row { grid-template-columns: 1fr; }
  .pr-feat-row--rev { direction: ltr; }
  .pr-feat-row__img { min-height: 300px; }
