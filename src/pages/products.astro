  .pr-intro { padding: 60px 5%; }
  .pr-featured { padding: 0 5% 60px; }
  .pr-feat-row__content { padding: 32px 28px; }
  .pr-feat-row__specs { grid-template-columns: 1fr; }
  .pr-all { padding: 0 5% 60px; }
  .pr-all__card-img { height: 160px; }
  .pr-faq { padding: 60px 5%; margin: 0 0 40px; border-radius: 32px; }
  .pr-cta { flex-direction: column; padding: 40px 28px; text-align: center; }
