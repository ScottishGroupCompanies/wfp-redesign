</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.08 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));

  // FAQ accordion
  document.querySelectorAll('.pr-faq__q').forEach(q => {
    q.addEventListener('click', () => {
      const item = q.parentElement;
      const isOpen = item.classList.contains('pr-faq__item--open');
      document.querySelectorAll('.pr-faq__item').forEach(i => i.classList.remove('pr-faq__item--open'));
      if (!isOpen) item.classList.add('pr-faq__item--open');
    });
  });
</script>