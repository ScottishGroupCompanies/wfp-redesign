---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerPageHero from '../components/InnerPageHero.astro';
import BrandLogos from '../components/BrandLogos.astro';
import { Icon } from 'astro-icon/components';

const title = 'Window Film Products | 3M, LLumar, Vista & More | Philadelphia';
const description = 'Browse our full line of window film products: 3M, LLumar, Vista, Huper Optik, and more. Residential, commercial, and decorative films for every budget.';

const featuredBrands = [
  {
    num: '01',
    name: '3M™ Window Film',
    tagline: 'Science-backed innovation since 1966.',
    body: '3M invented window film and remains the gold standard for commercial and residential installs worldwide. Their crystalline, ceramic, and safety film lines deliver unmatched optical clarity, heat rejection, and long-term durability backed by a comprehensive manufacturer warranty.',
    specs: ['99.9% UV rejection', 'Up to 97% IR heat rejection', 'Crystal-clear to dark tint options', 'Certified security & blast mitigation films'],
    img: '/images/2021-09-3m-window-film-philadelphia.webp',
    alt: '3M window film installation Philadelphia',
    href: '/products/3m-window-film/',
    cert: '3M Certified Installer',
  },
  {
    num: '02',
    name: 'LLumar',
    tagline: 'Performance films for every project.',
    body: 'LLumar is one of the most widely installed film brands globally, trusted by both residential homeowners and Fortune 500 facility managers. Their dual-reflective and metalized film technologies offer excellent heat rejection across a full spectrum of VLT levels.',
    specs: ['Ceramic and metalized options', 'Dual-reflective technology', 'Interior & exterior grade films', '15–20 year warranty programs'],
    img: '/images/2021-09-llumar-window-film-philadelphia.webp',
    alt: 'LLumar window film installation Philadelphia',
    href: '/products/llumar/',
    cert: 'LLumar Select Pro Dealer',
  },
  {
    num: '03',
    name: 'Vista Window Film',
    tagline: 'Spectrally selective. Visibly different.',
    body: "Vista by Eastman is engineered for architects and homeowners who demand maximum performance without sacrificing natural light or curb appeal. Their proprietary spectrally selective technology selectively filters solar energy while preserving the appearance of clear glass.",
    specs: ['Spectrally selective technology', 'Non-metalized — no signal interference', 'Architectural aesthetic options', 'Sustainably sourced materials'],
    img: '/images/2021-09-vista-window-film-philadelphia.webp',
    alt: 'Vista window film installation Philadelphia',
    href: '/products/vista-window-film/',
    cert: 'Vista Certified Dealer',
  },
  {
    num: '04',
    name: 'Solar Gard',
    tagline: 'Professional-grade performance since 1973.',
    body: "Saint-Gobain's Solar Gard line is the professional's choice for high-occupancy commercial buildings. Their Duran & Schwarz lines deliver exceptional solar control, safety, and anti-graffiti performance backed by one of the industry's most rigorous quality management systems.",
    specs: ['Professional installer network', 'Bomb-blast & safety certified', 'Anti-graffiti sacrificial films', 'Architectural program support'],
    img: '/images/2021-09-solar-gard-window-film-philadelphia.webp',
    alt: 'Solar Gard window film installation Philadelphia',
    href: '/products/solar-gard-window-film/',
    cert: 'Solar Gard Authorized Dealer',
  },
  {
    num: '05',
    name: 'Huper Optik',
    tagline: 'German engineering. Zero signal interference.',
    body: 'Huper Optik\'s proprietary ceramic particle technology delivers industry-leading heat rejection without any metallic components — meaning no signal degradation for GPS, Wi-Fi, cellular, or satellite systems. Made in Germany with strict quality controls across residential and commercial grades.',
    specs: ['100% ceramic — no metal, no interference', 'Lifetime residential warranty', 'Commercial-grade durability', 'patented particle technology'],
    img: '/images/2021-09-huper-optik-window-film-philadelphia.webp',
    alt: 'Huper Optik ceramic window film Philadelphia',
    href: '/products/huper-optik/',
    cert: 'Huper Optik Certified Installer',
  },
  {
    num: '06',
    name: 'Madico',
    tagline: 'Over 100 years of film science.',
    body: 'Madico has been at the forefront of window film innovation since 1904, developing solar, safety, decorative, and specialty films for demanding commercial and residential applications. Their ClearPly safety films are specified by leading architects for government, education, and healthcare projects across North America.',
    specs: ['SafetyPly & ClearPly certified films', 'Decorative pattern library', '100+ year brand heritage', 'ISO 9001 certified manufacturing'],
    img: '/images/2021-09-madico-window-film-philadelphia.webp',
    alt: 'Madico window film installation Philadelphia',
    href: '/products/madico-window-film/',
    cert: 'Madico Authorized Dealer',
  },
];

const allBrands = [
  { label: '3M™ Window Film', sub: 'Solar & Security Films', img: '/images/2021-09-3m-window-film-philadelphia.webp', alt: '3M window film', href: '/products/3m-window-film/' },
  { label: 'LLumar', sub: 'Performance Films', img: '/images/2021-09-llumar-window-film-philadelphia.webp', alt: 'LLumar window film', href: '/products/llumar/' },
  { label: 'Vista Window Film', sub: 'Spectrally Selective', img: '/images/2021-09-vista-window-film-philadelphia.webp', alt: 'Vista window film', href: '/products/vista-window-film/' },
  { label: 'Solar Gard', sub: 'Professional Grade', img: '/images/2021-09-solar-gard-window-film-philadelphia.webp', alt: 'Solar Gard window film', href: '/products/solar-gard-window-film/' },
  { label: 'Madico', sub: 'Safety & Decorative', img: '/images/2021-09-madico-window-film-philadelphia.webp', alt: 'Madico window film', href: '/products/madico-window-film/' },
  { label: 'Huper Optik', sub: 'Ceramic Technology', img: '/images/2021-09-huper-optik-window-film-philadelphia.webp', alt: 'Huper Optik window film', href: '/products/huper-optik/' },
  { label: 'Casper Cloaking Film', sub: 'Privacy Film', img: '/images/2021-09-casper-window-film-philadelphia.webp', alt: 'Casper cloaking film', href: '/products/casper-cloaking-film/' },
  { label: 'C-Bond Systems', sub: 'Nano-Technology', img: '/images/c-bond-primer-window-film-philadelphia.webp', alt: 'C-Bond window film', href: '/products/c-bond-window-film/' },
  { label: 'HDClear', sub: 'Decorative Films', img: '/images/2021-09-hdclear-window-film-philadelphia.webp', alt: 'HDClear decorative film', href: '/products/hdclear-window-film/' },
  { label: 'Hanita Coatings', sub: 'Specialty Films', img: '/images/2021-09-hanita-coatings-window-film-philadelphia.webp', alt: 'Hanita Coatings window film', href: '/products/hanita-coatings-window-film/' },
  { label: 'Solyx', sub: 'Decorative & Architectural', img: '/images/2021-09-solyx-window-film-philadelphia.webp', alt: 'Solyx decorative film', href: '/products/solyx-window-film/' },
  { label: 'NanoTint', sub: 'Liquid Film Technology', img: '/images/drywired-liquid-nanotint-philadelphia-1.webp', alt: 'NanoTint liquid film', href: '/products/nanotint-window-film/' },
  { label: 'Bird Divert', sub: 'Wildlife Safety', img: '/images/bird-divert-film-philadelphia.webp', alt: 'Bird Divert film', href: '/products/bird-divert/' },
];

const faqItems = [
  { q: 'How do I know which window film brand is right for my property?', a: "Every property is different — glass type, building orientation, occupancy type, and budget all factor in. During our free on-site consultation, we'll assess your specific situation and recommend the film brands and performance levels that make the most sense for your goals." },
  { q: 'Are all these brands available for both residential and commercial projects?', a: 'Yes. Every brand we carry offers residential and commercial product lines. Some brands like 3M, Madico, and Solar Gard have specialized commercial-grade films for high-rise buildings, government facilities, and healthcare environments.' },
  { q: 'Do you offer manufacturer warranties on all installations?', a: 'All our installations carry a lifetime manufacturer warranty on film adhesion, peeling, bubbling, and fading for the original property owner. Warranty terms vary by brand — we provide full documentation at the time of installation.' },
  { q: 'Can I mix different brands on different windows of the same building?', a: 'Absolutely. Many projects use different film types on different elevations — for example, a high-performance ceramic on the west-facing facade and a decorative film on the street-level storefront. We spec each area independently.' },
  { q: 'How do I verify that a brand is genuinely premium vs. budget film?', a: 'Look for established manufacturer warranty programs, third-party lab testing (e.g., NFRC ratings), and certified installer networks. All the brands we carry meet these criteria. Budget films often lack these safeguards and degrade within a few years.' },
  { q: 'What is the lead time for ordering these film brands?', a: 'Most standard film orders ship within 5–10 business days. Specialty films (decorative prints, custom patterns, specialty tints) may require 2–4 weeks. We maintain a local inventory of the most popular films for same-week installation on time-sensitive projects.' },
];
---

<BaseLayout title={title} description={description} canonical="https://www.windowfilmphiladelphia.net/products/" faqItems={faqItems}>

<InnerPageHero
  title="Our Window Film Products"
  bgImage="https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_154519_d8ca31d9-ed7f-4f76-88e9-cc2ca0867486.png"
  desc="Top brands · Every application · Expert advice"
/>

<div class="ip-page-body">

<!-- ══════════════════════════════════════
     INTRO — 2-col: heading left, lead + CTAs right
     ══════════════════════════════════════ -->
<section class="pr-intro">
  <div class="pr-intro__inner">
    <div class="pr-intro__left">
      <span class="pr-eyebrow">Our Brand Partners</span>
      <h2 class="pr-intro__title">The industry's best window film brands, all in one place</h2>
    </div>
    <div class="pr-intro__right">
      <p class="pr-intro__lead">Window Film Philadelphia partners with every leading manufacturer to offer the most comprehensive product selection in the Philadelphia region. From energy-saving solar films and ballistic-resistant security systems to custom decorative printing and specialty coatings — we carry the right film for every project. Select a brand below to explore its full product line.</p>
      <div class="pr-intro__ctas">
        <a href="/contact/" class="pr-btn pr-btn--primary">Get a Free Quote</a>
        <a href="/benefits/" class="pr-btn pr-btn--ghost">View Film Benefits</a>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════
     FEATURED BRANDS — 6 full-width spotlights
     ══════════════════════════════════════ -->
<section class="pr-featured">
  <div class="pr-featured__hd">
    <span class="pr-eyebrow">Featured Brands</span>
    <h2 class="pr-featured__title">Brands we trust. Films we spec.</h2>
  </div>

  {featuredBrands.map((b, i) => (
    <div class={`pr-feat-row fade-in${i % 2 === 1 ? ' pr-feat-row--rev' : ''}`}>
      <div class="pr-feat-row__img">
        <img src={b.img} alt={b.alt} width="640" height="480" loading="lazy" />
        <span class="pr-feat-row__num">{b.num}</span>
      </div>
      <div class="pr-feat-row__content">
        <div class="pr-feat-row__cert">
          <Icon name="lucide:badge-check" width="16" height="16" />
          {b.cert}
        </div>
        <h3 class="pr-feat-row__name">{b.name}</h3>
        <p class="pr-feat-row__tagline">{b.tagline}</p>
        <p class="pr-feat-row__body">{b.body}</p>
        <ul class="pr-feat-row__specs">
          {b.specs.map(s => (
            <li class="pr-feat-row__spec">
              <Icon name="lucide:check-circle" width="15" height="15" />
              {s}
            </li>
          ))}
        </ul>
        <a href={b.href} class="pr-feat-row__cta">
          Explore {b.name.replace('™', '')}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/></svg>
        </a>
      </div>
    </div>
  ))}
</section>

<!-- ══════════════════════════════════════
     ALL BRANDS GRID — 3 columns
     ══════════════════════════════════════ -->
<section class="pr-all">
  <div class="pr-all__hd">
    <span class="pr-eyebrow">All Brands</span>
    <h2 class="pr-all__title">Complete manufacturer lineup</h2>
  </div>
  <div class="pr-all__grid">
    {allBrands.map((b, i) => (
      <a href={b.href} class="pr-all__card fade-in" style={`transition-delay: ${(i % 3) * 80}ms`}>
        <div class="pr-all__card-img">
          <img src={b.img} alt={b.alt} loading="lazy" />
        </div>
        <div class="pr-all__card-body">
          <h3 class="pr-all__card-title">{b.label}</h3>
        </div>
      </a>
    ))}
  </div>
</section>

<!-- ══════════════════════════════════════
     FAQ ACCORDION
     ══════════════════════════════════════ -->
<section class="pr-faq">
  <div class="pr-faq__hd">
    <span class="pr-eyebrow">FAQ</span>
    <h2 class="pr-faq__title">Common questions about window film brands</h2>
  </div>
  {faqItems.map((item, i) => (
    <div class={`pr-faq__item fade-in${i === 0 ? ' pr-faq__item--open' : ''}`}>
      <div class="pr-faq__q">
        {item.q}
        <span class="pr-faq__toggle">+</span>
      </div>
      <div class="pr-faq__a">{item.a}</div>
    </div>
  ))}
</section>

<!-- ══════════════════════════════════════
     BRAND LOGOS
     ══════════════════════════════════════ -->
<BrandLogos />

<!-- ══════════════════════════════════════
     CTA BANNER
     ══════════════════════════════════════ -->
<div class="pr-cta fade-in">
  <h2>Not sure which film is right for your <em>project?</em></h2>
  <div class="pr-cta__btns">
    <a href="/contact/" class="pr-btn pr-btn--white">Get a Free Quote</a>
    <a href="tel:+126****7980" class="pr-btn pr-btn--green">Call (267) 394-7980</a>
  </div>
</div>

</div><!-- end ip-page-body -->

</BaseLayout>

<style>
/* ── PAGE BODY WRAPPER ── */
.ip-page-body {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  border-bottom-left-radius: 40px;
  border-bottom-right-radius: 40px;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* ── EYEBROW ── */
.pr-eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

/* ── BUTTONS ── */
.pr-btn {
  display: inline-block; padding: 14px 28px;
  border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; font-weight: 500;
  text-decoration: none; transition: all 0.2s;
  border: 2px solid transparent; white-space: nowrap;
}
.pr-btn--primary { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.pr-btn--primary:hover { background: #6e9640; border-color: #6e9640; transform: translateY(-2px); color: #fff; }
.pr-btn--ghost { background: transparent; color: var(--brand, #272E32); border-color: var(--brand, #272E32); }
.pr-btn--ghost:hover { background: var(--brand, #272E32); color: #fff; transform: translateY(-2px); }
.pr-btn--white { background: #fff; color: var(--brand, #272E32); border-color: #fff; font-weight: 600; }
.pr-btn--white:hover { background: var(--off-white, #F7F6F3); transform: translateY(-2px); }
.pr-btn--green { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.pr-btn--green:hover { background: #6e9640; transform: translateY(-2px); color: #fff; }

/* ── INTRO ── */
.pr-intro {
  padding: 80px 10%;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  overflow: hidden;
}
.pr-intro__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.pr-intro__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(36px, 4.5vw, 58px);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -1px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
}
.pr-intro__lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.75;
  margin-bottom: 32px;
}
.pr-intro__ctas { display: flex; gap: 14px; flex-wrap: wrap; }

/* ── FEATURED BRANDS ── */
.pr-featured {
  padding: 0 10% 80px;
  background: #ffffff;
}
.pr-featured__hd {
  text-align: center;
  padding: 60px 0 48px;
}
.pr-featured__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3vw, 44px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  letter-spacing: -0.5px;
  margin: 0;
}

.pr-feat-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  align-items: stretch;
  margin-bottom: 48px;
  border-radius: 32px;
  overflow: hidden;
  border: 1px solid var(--light-gray, #EFEFED);
  background: var(--off-white, #F7F6F3);
  transition: box-shadow 0.3s ease;
}
.pr-feat-row:hover {
  box-shadow: 0 20px 60px rgba(0,0,0,0.08);
}
.pr-feat-row--rev {
  direction: rtl;
}
.pr-feat-row--rev > * {
  direction: ltr;
}

.pr-feat-row__img {
  position: relative;
  overflow: hidden;
  min-height: 400px;
}
.pr-feat-row__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}
.pr-feat-row:hover .pr-feat-row__img img {
  transform: scale(1.04);
}
.pr-feat-row__num {
  position: absolute;
  top: 20px;
  left: 20px;
  background: var(--brand, #272E32);
  color: #fff;
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1px;
  padding: 6px 14px;
  border-radius: 100px;
}

.pr-feat-row__content {
  padding: 48px 52px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.pr-feat-row__cert {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 12px;
}
.pr-feat-row__name {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(24px, 2.5vw, 34px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 6px;
  line-height: 1.15;
}
.pr-feat-row__tagline {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-style: italic;
  color: var(--green, #81AB4C);
  margin-bottom: 20px;
}
.pr-feat-row__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.75;
  margin-bottom: 28px;
}
.pr-feat-row__specs {
  list-style: none;
  padding: 0;
  margin: 0 0 28px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.pr-feat-row__spec {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  color: var(--text-dark, #1a1a1a);
}
.pr-feat-row__spec :global(svg) {
  color: var(--green, #81AB4C);
  flex-shrink: 0;
}
.pr-feat-row__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-weight: 600;
  color: var(--green, #81AB4C);
  text-decoration: none;
  transition: gap 0.2s;
}
.pr-feat-row__cta:hover {
  gap: 12px;
  color: #6e9640;
}

/* ── ALL BRANDS GRID ── */
.pr-all {
  padding: 0 10% 80px;
  background: #ffffff;
}
.pr-all__hd {
  text-align: center;
  padding: 40px 0 48px;
}
.pr-all__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(24px, 2.5vw, 36px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
}
.pr-all__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.pr-all__card {
  background: var(--white, #ffffff);
  border-radius: 18px;
  overflow: hidden;
  text-decoration: none;
  display: block;
  position: relative;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.pr-all__card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 40px rgba(0,0,0,0.12);
}
.pr-all__card-img {
  border-radius: 18px 18px 0 0;
  overflow: hidden;
  height: 200px;
}
.pr-all__card-img img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 0.5s ease;
}
.pr-all__card:hover .pr-all__card-img img {
  transform: scale(1.07);
}
.pr-all__card-body {
  padding: 20px 20px 24px;
  text-align: center;
}
.pr-all__card-title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 17px;
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 6px;
}
.pr-all__card-sub {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
}

/* ── FAQ ACCORDION ── */
.pr-faq {
  background: var(--off-white, #F7F6F3);
  border-radius: 40px;
  padding: 80px 10%;
  margin: 0 5% 60px;
}
.pr-faq__hd {
  text-align: center;
  padding-bottom: 48px;
}
.pr-faq__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(26px, 2.5vw, 40px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
}
.pr-faq__item {
  border-bottom: 1px solid var(--light-gray, #EFEFED);
}
.pr-faq__item:first-of-type {
  border-top: 1px solid var(--light-gray, #EFEFED);
}
.pr-faq__q {
  display: flex;
  justify-content: space-between;
  align-items: center;
