---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogos from '../components/BrandLogos.astro';
import CTAAvatars from '../components/CTAAvatars.astro';

const title = 'Contact Window Film Philadelphia | Free Quote | PA & NJ';
const description = 'Contact Window Film Philadelphia for a free consultation. Call (267) 394-7980 or request a quote online. Serving Philadelphia, Camden, and the Delaware Valley.';

const contactImages = {
  img1: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203051_9e201b35-80e5-4e3d-bc85-32561bb9d0ee.png',
  img2: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203053_b846664d-a70e-442d-833b-4267bf184a18.png',
  img3: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203056_43daeb3e-3501-4a9c-8e55-14df1c103bbd.png',
  img4: 'https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260609_203058_7ea2c065-74e1-4ca1-80be-bae2fec0e6af.png',
};
---

<BaseLayout title={title} description={description} canonical="https://windowfilmphiladelphia.net/contact/">

<!-- ═══ HERO ═══ -->
<section class="ct-hero">
  <div class="ct-hero__bg" style="background-image: url('https://res.cloudinary.com/deunehrew/image/fetch/f_auto,q_auto,w_800/https://d8j0ntlcm91z4.cloudfront.net/user_39gHIafquScvuUngNf6xPBDD37B/hf_20260615_154526_2abe9c27-a9ea-468b-9a51-ca13dc27e4d1.png')" role="img" aria-label="Window Film Philadelphia — professional window film installation"></div>
  <div class="ct-hero__overlay"></div>
  <div class="ct-hero__content">
    <div class="ct-hero__eyebrow">
      <span class="ct-hero__eyebrow-dot" aria-hidden="true"></span>
      GET IN TOUCH
      <span class="ct-hero__eyebrow-dot" aria-hidden="true"></span>
    </div>
    <h1 class="ct-hero__title">Get a Free Quote</h1>
    <p class="ct-hero__subtitle">Tell us about your building and your goals — we'll help you find the right film. Free on-site consultation, transparent pricing, and manufacturer-backed warranties on every install. Serving Philadelphia, Camden, and the Delaware Valley.</p>
    <div class="ct-hero__cta">
      <a href="tel:2673947980" class="ct-hero__btn-primary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
        Call (267) 394-7980
      </a>
      <a href="#consultation" class="ct-hero__btn-secondary">Request a Quote Online</a>
    </div>
  </div>
</section>

<div class="ct-body">

  <!-- ══════════════════════════════════════
       CONTACT CARDS — 3 col
       ══════════════════════════════════════ -->
  <section class="ct-cards">
    <div class="ct-cards__grid">

      <div class="ct-card fade-in">
        <div class="ct-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.18 6.18l.93-.93a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <p class="ct-card__label">Phone</p>
        <p class="ct-card__value"><a href="tel:+12673947980">(267) 394-7980</a></p>
        <a href="tel:+12673947980" class="ct-card__btn">Call Us</a>
      </div>

      <div class="ct-card fade-in fade-in-delay-1">
        <div class="ct-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </div>
        <p class="ct-card__label">Email</p>
        <p class="ct-card__value"><a href="mailto:contact@windowfilmphiladelphia.net">contact@windowfilmphiladelphia.net</a></p>
        <a href="mailto:contact@windowfilmphiladelphia.net" class="ct-card__btn">Email Us</a>
      </div>

      <div class="ct-card fade-in fade-in-delay-2">
        <div class="ct-card__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <p class="ct-card__label">Service Area</p>
        <p class="ct-card__value">Philadelphia, Camden, Reading &amp; surrounding counties</p>
        <a href="https://maps.google.com/?q=Philadelphia,PA" target="_blank" rel="noopener" class="ct-card__btn">View on Map</a>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════
       4-IMAGE SHOWCASE STRIP
       ══════════════════════════════════════ -->
  <section class="ct-images">
    <div class="ct-images__grid">
      <div class="ct-images__item fade-in">
        <img src={contactImages.img1} alt="Philadelphia window film installation — commercial building" title="Philadelphia window film installation — commercial building" width="600" height="400" loading="lazy" />
        <div class="ct-images__overlay">
          <span>Commercial Installations</span>
        </div>
      </div>
      <div class="ct-images__item fade-in fade-in-delay-1">
        <img src={contactImages.img2} alt="Window film application process" title="Window film application process" width="600" height="400" loading="lazy" />
        <div class="ct-images__overlay">
          <span>Professional Application</span>
        </div>
      </div>
      <div class="ct-images__item fade-in fade-in-delay-2">
        <img src={contactImages.img3} alt="Residential window film Philadelphia" title="Residential window film Philadelphia" width="600" height="400" loading="lazy" />
        <div class="ct-images__overlay">
          <span>Residential Solutions</span>
        </div>
      </div>
      <div class="ct-images__item fade-in fade-in-delay-3">
        <img src={contactImages.img4} alt="Window film trust and certification" title="Window film trust and certification" width="600" height="400" loading="lazy" />
        <div class="ct-images__overlay">
          <span>3M Authorized Dealer</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       CONSULTATION FORM + SIDEBAR
       ══════════════════════════════════════ -->
  <section class="ct-consult" id="consultation">
    <div class="ct-consult__inner">

      <!-- Form column -->
      <div class="ct-consult__form-col fade-in">
        <span class="auron-badge">Free Consultation</span>
        <h2 class="ct-consult__title">Tell us about your project</h2>
        <p class="ct-consult__sub">Fill out the form below and we'll get back to you within one business day to schedule your free on-site consultation.</p>

        <form
          class="ct-consult__form"
          action="https://formsubmit.co/contact@windowfilmphiladelphia.net"
          method="POST"
        >
          <input type="hidden" name="_next" value="https://windowfilmphiladelphia.net/thank-you/" />
          <input type="hidden" name="_subject" value="New Contact — Window Film Philadelphia" />
          <input type="hidden" name="_captcha" value="false" />

          <div class="ct-form-row">
            <div class="ct-form-field">
              <label for="first_name" class="ct-form-label">First Name</label>
              <input type="text" id="first_name" name="first_name" placeholder="Jane" required class="ct-form-input" />
            </div>
            <div class="ct-form-field">
              <label for="last_name" class="ct-form-label">Last Name</label>
              <input type="text" id="last_name" name="last_name" placeholder="Smith" required class="ct-form-input" />
            </div>
          </div>

          <div class="ct-form-field">
            <label for="email" class="ct-form-label">Email Address</label>
            <input type="email" id="email" name="email" placeholder="jane@example.com" required class="ct-form-input" />
          </div>

          <div class="ct-form-field">
            <label for="phone" class="ct-form-label">Phone Number</label>
            <input type="tel" id="phone" name="phone" placeholder="(267) 000-0000" class="ct-form-input" />
          </div>

          <div class="ct-form-field">
            <label for="project_type" class="ct-form-label">Project Type</label>
            <select id="project_type" name="project_type" class="ct-form-input ct-form-select" required>
              <option value="" disabled selected>Select project type</option>
              <option value="residential">Residential</option>
              <option value="commercial">Commercial</option>
              <option value="government">Government / Municipal</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="ct-form-field">
            <label for="film_type" class="ct-form-label">Film Category</label>
            <select id="film_type" name="film_type" class="ct-form-input ct-form-select">
              <option value="" disabled selected>Select film type</option>
              <option value="sun_control">Sun Control / Energy Savings</option>
              <option value="privacy">Privacy / Decorative</option>
              <option value="security">Safety &amp; Security</option>
              <option value="uv_protection">UV Protection</option>
              <option value="not_sure">Not sure — need advice</option>
            </select>
          </div>

          <div class="ct-form-field">
            <label for="message" class="ct-form-label">Project Details</label>
            <textarea id="message" name="message" rows="5" placeholder="Describe your windows, building, or project goals…" required class="ct-form-input ct-form-textarea"></textarea>
          </div>

          <button type="submit" class="auron-btn auron-btn--primary ct-form-submit">
            Request Free Consultation
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/></svg>
          </button>
        </form>
      </div>

      <!-- Sidebar column -->
      <aside class="ct-consult__sidebar">

        <div class="ct-sidebar-card fade-in">
          <img src={contactImages.img2} alt="Window film consultation" title="Window film consultation" width="480" height="280" loading="lazy" />
          <div class="ct-sidebar-card__body">
            <h3 class="ct-sidebar-card__title">What to expect</h3>
            <ul class="ct-sidebar-list">
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                Free on-site or virtual consultation
              </li>
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                No-pressure, itemized quote
              </li>
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                Film samples to see and feel
              </li>
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                Written proposal within 24 hours
              </li>
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
                Lifetime installation warranty
              </li>
            </ul>
          </div>
        </div>

        <div class="ct-trust-box fade-in">
          <div class="ct-trust-box__item">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="var(--green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <div>
              <strong>3M Authorized Dealer</strong>
              <span>Certified installation</span>
            </div>
          </div>
          <div class="ct-trust-box__item">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="var(--green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <div>
              <strong>Lifetime Warranty</strong>
              <span>On materials and labor</span>
            </div>
          </div>
          <div class="ct-trust-box__item">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="var(--green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <div>
              <strong>18+ Years Serving Philly</strong>
              <span>Local team, local knowledge</span>
            </div>
          </div>
        </div>

        <div class="ct-phone-cta fade-in">
          <p class="ct-phone-cta__label">Prefer to call?</p>
          <a href="tel:+126****7980" class="ct-phone-cta__number">(267) 394-7980</a>
          <p class="ct-phone-cta__hours">Mon–Fri 8am–5pm · Sat by appointment</p>
        </div>

      </aside>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       BRAND LOGOS
       ══════════════════════════════════════ -->
  <BrandLogos />

  <!-- ══════════════════════════════════════
       CTA — CTAAvatars (component library)
       ══════════════════════════════════════ -->
  <CTAAvatars
    title="Ready to transform your space?"
    subtitle="Free consultations. No-pressure quotes. Professional installation backed by manufacturer warranties."
    count="Trusted by 2,400+ Philadelphia property owners"
    btnLabel="Get a Free Consultation"
    btnHref="#consultation"
    avatars={[
      { name: 'David R.', location: 'Center City', img: '/images/about/about-avatar-1.webp' },
      { name: 'Lisa M.', location: 'Rittenhouse', img: '/images/about/about-avatar-3.webp' },
      { name: 'Robert K.', location: 'South Street', img: '/images/about/about-avatar-2.webp' },
      { name: 'Thomas H.', location: 'University City', img: '/images/about/about-avatar-4.webp' },
      { name: 'Janet F.', location: 'Manayunk', img: '/images/about/about-avatar-5.webp' },
      { name: 'Sarah M.', location: 'Fishtown', img: '/images/about/about-avatar-8.webp' },
    ]}
  />

</div><!-- end ct-body -->

</BaseLayout>

<style>
  /* ── PAGE BODY (no rounded corners) ── */
  .ct-body {
    background: #ffffff;
  }

  /* ── HERO ── */
  .ct-hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .ct-hero__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .ct-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(39,46,50,0.72) 0%, rgba(39,46,50,0.85) 55%, rgba(39,46,50,0.95) 100%);
  }
  .ct-hero__content {
    position: relative;
    z-index: 10;
    max-width: 860px;
    padding: 120px 24px 80px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
  }
  .ct-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(124, 179, 66, 0.85);
    margin-bottom: 28px;
    background: rgba(124, 179, 66, 0.08);
    border: 1px solid rgba(124, 179, 66, 0.2);
    padding: 8px 18px;
    border-radius: 100px;
  }
  .ct-hero__eyebrow-dot {
    width: 4px; height: 4px; border-radius: 50%;
    background: rgba(124, 179, 66, 0.4);
    flex-shrink: 0;
  }
  .ct-hero__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 700;
    color: #F3F6F1;
    line-height: 1.1;
    margin: 0 0 20px;
    letter-spacing: -0.01em;
  }
  .ct-hero__subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    color: rgba(243, 246, 241, 0.72);
    max-width: 680px;
    margin: 0 0 36px;
    line-height: 1.75;
  }
  .ct-hero__cta {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .ct-hero__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #7CB342;
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    padding: 14px 32px;
    border-radius: 100px;
    border: 2px solid #7CB342;
    transition: background 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
  }
  .ct-hero__btn-primary:hover {
    background: #6aa032;
    border-color: #6aa032;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(124, 179, 66, 0.3);
  }
  .ct-hero__btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: #F3F6F1;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    padding: 12px 28px;
    border-radius: 100px;
    border: 2px solid rgba(243, 246, 241, 0.35);
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.2s ease;
  }
  .ct-hero__btn-secondary:hover {
    border-color: #7CB342;
    color: #7CB342;
    transform: translateY(-2px);
  }
  @media (max-width: 640px) {
    .ct-hero__cta { flex-direction: column; }
  }

  /* ── AURON BADGE (reuse from homepage) ── */
  .auron-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(129,171,76,0.12);
    border: 1px solid rgba(129,171,76,0.3);
    color: var(--green);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 100px;
  }

  /* ── AURON BUTTONS (reuse from homepage) ── */
  .auron-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 100px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    border: none;
  }
  .auron-btn--primary { background: var(--green); color: var(--brand); }
  .auron-btn--primary:hover { background: #b5ff7a; transform: translateY(-1px); color: var(--brand); }
  .auron-btn--ghost-white { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.4); }
  .auron-btn--ghost-white:hover { border-color: #fff; }

  /* ── CONTACT CARDS ── */
  .ct-cards {
    padding: 80px 60px 0;
  }
  .ct-cards__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .ct-card {
    background: var(--white);
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 18px;
    padding: 36px 28px;
    text-align: center;
    transition: all 0.25s ease;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }
  .ct-card:hover {
    border-color: rgba(129,171,76,0.4);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
  }
  .ct-card__icon {
    width: 60px;
    height: 60px;
    background: rgba(129,171,76,0.12);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    color: var(--brand);
  }
  .ct-card__label {
