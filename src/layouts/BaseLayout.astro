---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CitiesTicker from '../components/CitiesTicker.astro';
import SEOHead from '../components/SEOHead.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import '../styles/global.css';

export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  faqItems?: FaqItem[];
  serviceName?: string;
  serviceDesc?: string;
  serviceUrl?: string;
  howToSteps?: { name: string; text: string; image?: string }[];
  howToName?: string;
  howToDesc?: string;
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex,
  faqItems,
  serviceName,
  serviceDesc,
  serviceUrl,
  howToSteps,
  howToName,
  howToDesc,
  schemas: extraSchemas,
} = Astro.props;

// ─── LocalBusiness schema (sitewide) ───────────────────────────────────────
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://windowfilmphiladelphia.net/#business",
  "name": "Window Film Philadelphia",
  "url": "https://windowfilmphiladelphia.net",
  "logo": "https://windowfilmphiladelphia.net/images/window-film-philadelphia-logo-white.png",
  "image": "https://windowfilmphiladelphia.net/images/wfp-landing-hero.webp",
  "description": "Philadelphia's leading window film contractor. Professional installation for homes and businesses across the Delaware Valley. Energy savings, UV protection, safety & security.",
  "telephone": "+12673947980",
  "email": "info@windowfilmphl.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Philadelphia",
    "addressRegion": "PA",
    "postalCode": "19106",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 39.9526,
    "longitude": -75.1652
  },
  "areaServed": [
    { "@type": "City", "name": "Philadelphia", "sameAs": "https://en.wikipedia.org/wiki/Philadelphia" },
    { "@type": "City", "name": "Cherry Hill", "sameAs": "https://en.wikipedia.org/wiki/Cherry_Hill,_New_Jersey" },
    { "@type": "City", "name": "Main Line", "sameAs": "https://en.wikipedia.org/wiki/Main_Line_(Philadelphia)" }
  ],
  "priceRange": "$$",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "08:00",
      "closes": "17:00"
    }
  ],
  "sameAs": [
    "https://www.facebook.com/windowfilmphiladelphia",
    "https://www.instagram.com/windowfilmphiladelphia"
  ]
};

// ─── WebSite schema with SearchAction (sitewide) ───────────────
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://windowfilmphiladelphia.net/#website",
  "url": "https://windowfilmphiladelphia.net",
  "name": "Window Film Philadelphia",
  "publisher": {
    "@type": "LocalBusiness",
    "@id": "https://windowfilmphiladelphia.net/#business"
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://windowfilmphiladelphia.net/blog/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

// ─── FAQPage schema ─────────────────────────────────────────
const faqSchema = faqItems && faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;

// ─── Service schema ──────────────────────────────────────────
const serviceSchema = serviceName ? {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${serviceUrl || canonical || 'https://windowfilmphiladelphia.net'}#service`,
  "name": serviceName,
  "description": serviceDesc || description,
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://windowfilmphiladelphia.net/#business"
  },
  "areaServed": {
    "@type": "City",
    "name": "Philadelphia",
    "sameAs": "https://en.wikipedia.org/wiki/Philadelphia"
  },
  "url": serviceUrl || canonical || "https://windowfilmphiladelphia.net"
} : null;

// ─── HowTo schema ───────────────────────────────────────────
const howToSchema = howToSteps && howToSteps.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": howToName || "Window Film Installation Process",
  "description": howToDesc || "Professional window film installation process in the Philadelphia metro area.",
  "step": howToSteps.map((s, i) => ({
    "@type": "HowToStep",
    "name": s.name,
    "position": i + 1,
    "text": s.text,
    ...(s.image ? { "image": s.image } : {})
  })),
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://windowfilmphiladelphia.net/#business"
  }
} : null;

const schemas = [
  localBusiness,
  websiteSchema,
  ...(faqSchema ? [faqSchema] : []),
  ...(serviceSchema ? [serviceSchema] : []),
  ...(howToSchema ? [howToSchema] : []),
  ...(extraSchemas ? extraSchemas : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/window-film-philadelphia-logo.svg" />
    <link rel="shortcut icon" href="/images/window-film-philadelphia-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" />
    <link rel="preload" as="image" href="/images/wfp-landing-hero.webp" />
    <SEOHead title={title} description={description} canonical={canonical} ogImage={ogImage} noindex={noindex} />
    <SchemaOrg schemas={schemas} />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <CitiesTicker />
    <Footer />

    <!-- Scroll reveal + sticky header observer -->
    <script>
      // ── Sticky header on scroll ──
      const header = document.getElementById('site-header');
      if (header) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            header.classList.toggle('is-scrolled', !entry.isIntersecting);
          },
          { rootMargin: '-72px 0px 0px 0px', threshold: 0 }
        );
        const sentinel = document.createElement('div');
        sentinel.style.cssText = 'position:absolute;top:104px;height:1px;width:1px;pointer-events:none;';
        document.body.prepend(sentinel);
        observer.observe(sentinel);
      }

      // ── Scroll reveal ──
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll('.reveal, .reveal-group').forEach(el => revealObserver.observe(el));

      // ── Count-up animation ──
      function animateCountUp(el: Element) {
        const final = parseFloat(el.dataset.countEnd || '0');
        const suffix = el.dataset.countSuffix || '';
        const prefix = el.dataset.countPrefix || '';
        const duration = 2000;
        const start = performance.now();
        const update = (now: number) => {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          // ease-out
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = final * eased;
          el.textContent = prefix + (Number.isInteger(final) ? Math.round(current).toLocaleString() : current.toFixed(1)) + suffix;
          if (progress < 1) requestAnimationFrame(update);
        };
        requestAnimationFrame(update);
      }

      const countObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              animateCountUp(entry.target);
              countObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 }
      );
      document.querySelectorAll('[data-count-end]').forEach(el => countObserver.observe(el));
    </script>

    <!-- Floating mobile call button -->
    <a href="tel:+12673947980" class="mobile-call-btn" aria-label="Call us">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
      </svg>
    </a>

    <!-- ═══ AI CHATBOT WIDGET ═══ -->
    <!-- Trigger button -->
    <button class="wfchat__trigger" id="wfchatTrigger" aria-label="Open chat">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z"/>
      </svg>
    </button>

    <!-- Tooltip -->
    <div class="wfchat__tooltip" id="wfchatTooltip">Have a question? Ask us →</div>

    <!-- Chat window -->
    <div class="wfchat__window" id="wfchatWindow">
      <div class="wfchat__header">
        <div class="wfchat__header-left">
          <span class="wfchat__status-dot"></span>
          <div>
            <div class="wfchat__header-name">Window Film Philadelphia</div>
            <div class="wfchat__header-sub">Typically replies in minutes</div>
          </div>
        </div>
        <button class="wfchat__close" id="wfchatClose" aria-label="Close chat">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div class="wfchat__messages" id="wfchatMessages">
        <!-- Welcome message -->
        <div class="wfchat__msg wfchat__msg--bot">
          <div class="wfchat__avatar">WF</div>
          <div class="wfchat__bubble">
            Hi! 👋 Welcome to Window Film Philadelphia. I can help you with:<br><br>
            • Free consultation scheduling<br>
            • Service questions<br>
            • Pricing information<br>
            • Coverage areas<br><br>
            What can I help you with today?
          </div>
        </div>

        <!-- Quick replies -->
        <div class="wfchat__quick-replies">
          <button class="wfchat__quick-btn" data-action="quote">Get a Free Quote</button>
          <button class="wfchat__quick-btn" data-action="services">Our Services</button>
          <button class="wfchat__quick-btn" data-action="coverage">Coverage Areas</button>
          <button class="wfchat__quick-btn" data-action="call">Call Us Now</button>
        </div>
      </div>
    </div>

    <script>
    (function initWfChat() {
      const trigger  = document.getElementById('wfchatTrigger');
      const tooltip  = document.getElementById('wfchatTooltip');
      const window2  = document.getElementById('wfchatWindow');
      const closeBtn = document.getElementById('wfchatClose');
      const messages = document.getElementById('wfchatMessages');

      // ── Show tooltip after 5s ──
      setTimeout(() => {
        if (!window2.classList.contains('wfchat__window--open')) {
          tooltip.style.display = 'block';
          setTimeout(() => { tooltip.style.opacity = '1'; }, 50);
          setTimeout(() => {
            tooltip.style.opacity = '0';
            setTimeout(() => { tooltip.style.display = 'none'; }, 300);
          }, 4000);
        }
      }, 5000);

      // ── Open / close ──
      function openChat() {
        window2.classList.add('wfchat__window--open');
        tooltip.style.display = 'none';
      }
      function closeChat() {
        window2.classList.remove('wfchat__window--open');
      }

      trigger.addEventListener('click', openChat);
      closeBtn.addEventListener('click', closeChat);

      // ── Keyword response map ──
      const responses = [
        {
          keys: ['quote','price','cost','how much','pricing','estimate'],
          text: "Great! Getting a quote is easy and free. You can fill out our quote form online or call us directly at (267) 394-7980. We typically respond within 24 hours! 😊",
          btnText: 'Get Free Quote →', btnHref: '/contact'
        },
        {
          keys: ['residential','home','house','condo','apartment'],
          text: "We install professional window film in Philadelphia homes and condos. Benefits include heat reduction, UV protection, privacy and energy savings. Would you like a free consultation?",
          btnText: 'Learn More →', btnHref: '/applications/residential'
        },
        {
          keys: ['commercial','office','business','retail','restaurant'],
          text: "We serve Philadelphia businesses of all sizes — offices, retail, restaurants and more. Commercial film reduces energy costs by up to 30% and eliminates glare. Want a free site assessment?",
          btnText: 'Commercial Services →', btnHref: '/applications/offices'
        },
        {
          keys: ['safety','security','break','protect','storm'],
          text: "Our safety and security film holds glass together during break-ins, storms and accidents. Used in schools, offices and homes across Philadelphia.",
          btnText: 'Safety Film Info →', btnHref: '/benefits/safety-and-security'
        },
        {
          keys: ['area','location','serve','near','coverage','city'],
          text: "We serve all of Greater Philadelphia including: Center City, Main Line, Cherry Hill NJ, South Jersey, Montgomery, Bucks and Delaware Counties."
        },
        {
          keys: ['warranty','guarantee','lifetime','labor'],
          text: "All our installations include a lifetime warranty on labor plus manufacturer warranty on the film itself. Done right, every time. ✓",
          btnText: 'Warranty Info →', btnHref: '/warranty'
        },
        {
          keys: ['call','phone','contact'],
          text: "You can reach us at:\n📞 (267) 394-7980\n✉ info@windowfilmphl.com\nWe're available Mon-Sat 8am-6pm."
        },
        {
          keys: ['decorative','frosted','privacy','pattern','design'],
          text: "Our decorative films include frosted, patterned and custom designs for offices, bathrooms, storefronts and more. Perfect for adding privacy without sacrificing light.",
          btnText: 'View Options →', btnHref: '/benefits/privacy-window-film-philadelphia'
        },
        {
          keys: ['uv','sun','heat','glare','energy'],
          text: "Our window film blocks up to 99% of harmful UV rays, reduces heat by up to 78% and cuts glare by 85%. Perfect for Philadelphia's hot summers!"
        },
        {
          keys: ['hours','open','available','monday','time'],
          text: "We're open Monday through Saturday, 8am to 6pm. For urgent matters call (267) 394-7980 or fill out our contact form anytime!"
        }
      ];

      function addBotMessage(html) {
        const div = document.createElement('div');
        div.className = 'wfchat__msg wfchat__msg--bot';
        div.innerHTML = `<div class="wfchat__avatar">WF</div><div class="wfchat__bubble">${html}</div>`;
        messages.appendChild(div);
        messages.scrollTop = messages.scrollHeight;
      }

      function addUserMessage(text) {
        const div = document.createElement('div');
        div.className = 'wfchat__msg wfchat__msg--user';
        div.textContent = text;
        messages.appendChild(div);
        messages.scrollTop = messages.scrollHeight;
      }

      function addCTA(text, href) {
        const div = document.createElement('a');
        div.className = 'wfchat__cta';
        div.href = href;
        div.target = '_blank';
        div.textContent = text;
        messages.appendChild(div);
        messages.scrollTop = messages.scrollHeight;
      }

      // ── Quick reply buttons ──
      document.querySelectorAll('.wfchat__quick-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const action = btn.dataset.action;
          const userText = btn.textContent;
          addUserMessage(userText);
          // remove quick replies after first click
          const qb = document.querySelector('.wfchat__quick-replies');
          if (qb) qb.remove();

          if (action === 'quote') {
            addBotMessage(responses[0].text);
            addCTA(responses[0].btnText, responses[0].btnHref);
          } else if (action === 'services') {
            addBotMessage("We offer a full range of window film services for homes and businesses across Philadelphia:<br><br>• Residential Window Film<br>• Commercial & Office Film<br>• Safety & Security Film<br>• Decorative & Privacy Film<br>• Anti-Graffiti Film<br>• UV Protection<br><br>Which one interests you?");
          } else if (action === 'coverage') {
            addBotMessage(responses[4].text);
          } else if (action === 'call') {
            addBotMessage(responses[6].text);
          }
        });
      });

      // ── Free-text input ──
      function handleUserMessage(text) {
        const lower = text.toLowerCase();
        let matched = false;
        for (const r of responses) {
          if (r.keys.some(k => lower.includes(k))) {
            addBotMessage(r.text.replace(/\n/g, '<br>'));
            if (r.btnText) addCTA(r.btnText, r.btnHref);
            matched = true;
            break;
          }
        }
        if (!matched) {
          addBotMessage("Thanks for your message! For detailed answers, call us at <strong>(267) 394-7980</strong> or fill out our <a href='/contact' target='_blank'>contact form</a>. We'll get back to you within 24 hours. 😊");
        }
      }

      // ── Text input bar at bottom of chat ──
      const inputBar = document.createElement('div');
      inputBar.className = 'wfchat__input-bar';
      inputBar.innerHTML = `<input type="text" class="wfchat__input" id="wfchatInput" placeholder="Type a message..." autocomplete="off"><button class="wfchat__send" id="wfchatSend" aria-label="Send"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/></svg></button>`;
      messages.parentElement.appendChild(inputBar);

      const chatInput = document.getElementById('wfchatInput');
      const chatSend  = document.getElementById('wfchatSend');

      function sendMessage() {
        const text = chatInput.value.trim();
        if (!text) return;
        addUserMessage(text);
        chatInput.value = '';
        handleUserMessage(text);
      }

      chatSend.addEventListener('click', sendMessage);
      chatInput.addEventListener('keydown', e => { if (e.key === 'Enter') sendMessage(); });

    })();
    </script>
  </body>
</html>
