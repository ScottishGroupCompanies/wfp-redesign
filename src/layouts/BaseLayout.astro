---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import '../styles/global.css';

export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  faqItems?: FaqItem[];
  serviceName?: string;
  serviceDesc?: string;
  serviceUrl?: string;
  howToSteps?: { name: string; text: string; image?: string }[];
  howToName?: string;
  howToDesc?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex,
  faqItems,
  serviceName,
  serviceDesc,
  serviceUrl,
  howToSteps,
  howToName,
  howToDesc,
} = Astro.props;

// ─── LocalBusiness schema (sitewide) ───────────────────────────────────────
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.windowfilmphiladelphia.net/#business",
  "name": "Window Film Philadelphia",
  "url": "https://www.windowfilmphiladelphia.net",
  "logo": "https://www.windowfilmphiladelphia.net/images/window-film-philadelphia-logo-white.png",
  "image": "https://www.windowfilmphiladelphia.net/images/wfp-landing-hero.webp",
  "description": "Philadelphia's leading window film contractor. Professional installation for homes and businesses across the Delaware Valley. Energy savings, UV protection, safety & security.",
  "telephone": "+12673947980",
  "email": "info@windowfilmphl.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Philadelphia",
    "addressRegion": "PA",
    "addressCountry": "US"
  },
  "areaServed": [
    { "@type": "City", "name": "Philadelphia", "sameAs": "https://en.wikipedia.org/wiki/Philadelphia" },
    { "@type": "City", "name": "Cherry Hill", "sameAs": "https://en.wikipedia.org/wiki/Cherry_Hill,_New_Jersey" },
    { "@type": "City", "name": "Main Line", "sameAs": "https://en.wikipedia.org/wiki/Main_Line_(Philadelphia)" }
  ],
  "priceRange": "$$",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "08:00",
      "closes": "17:00"
    }
  ],
  "sameAs": [
    "https://www.facebook.com/windowfilmphiladelphia",
    "https://www.instagram.com/windowfilmphiladelphia"
  ]
};

// ─── FAQPage schema ─────────────────────────────────────────
const faqSchema = faqItems && faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;

// ─── Service schema ──────────────────────────────────────────
const serviceSchema = serviceName ? {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${serviceUrl || canonical || 'https://www.windowfilmphiladelphia.net'}#service`,
  "name": serviceName,
  "description": serviceDesc || description,
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.windowfilmphiladelphia.net/#business"
  },
  "areaServed": {
    "@type": "City",
    "name": "Philadelphia",
    "sameAs": "https://en.wikipedia.org/wiki/Philadelphia"
  },
  "url": serviceUrl || canonical || "https://www.windowfilmphiladelphia.net"
} : null;

// ─── HowTo schema ───────────────────────────────────────────
const howToSchema = howToSteps && howToSteps.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": howToName || "Window Film Installation Process",
  "description": howToDesc || "Professional window film installation process in the Philadelphia metro area.",
  "step": howToSteps.map((s, i) => ({
    "@type": "HowToStep",
    "name": s.name,
    "position": i + 1,
    "text": s.text,
    ...(s.image ? { "image": s.image } : {})
  })),
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.windowfilmphiladelphia.net/#business"
  }
} : null;

const schemas = [
  localBusiness,
  ...(faqSchema ? [faqSchema] : []),
  ...(serviceSchema ? [serviceSchema] : []),
  ...(howToSchema ? [howToSchema] : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/window-film-philadelphia-logo.svg" />
    <link rel="shortcut icon" href="/images/window-film-philadelphia-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <SEOHead title={title} description={description} canonical={canonical} ogImage={ogImage} noindex={noindex} />
    <SchemaOrg schemas={schemas} />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <!-- Scroll reveal + sticky header observer -->
    <script>
      // ── Sticky header on scroll ──
      const header = document.getElementById('site-header');
      if (header) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            header.classList.toggle('is-scrolled', !entry.isIntersecting);
          },
          { rootMargin: '-72px 0px 0px 0px', threshold: 0 }
        );
        const sentinel = document.createElement('div');
        sentinel.style.cssText = 'position:absolute;top:104px;height:1px;width:1px;pointer-events:none;';
        document.body.prepend(sentinel);
        observer.observe(sentinel);
      }

      // ── Scroll reveal ──
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll('.reveal, .reveal-group').forEach(el => revealObserver.observe(el));

      // ── Count-up animation ──
      function animateCountUp(el: Element) {
        const final = parseFloat(el.dataset.countEnd || '0');
        const suffix = el.dataset.countSuffix || '';
        const prefix = el.dataset.countPrefix || '';
        const duration = 2000;
        const start = performance.now();
        const update = (now: number) => {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          // ease-out
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = final * eased;
          el.textContent = prefix + (Number.isInteger(final) ? Math.round(current).toLocaleString() : current.toFixed(1)) + suffix;
          if (progress < 1) requestAnimationFrame(update);
        };
        requestAnimationFrame(update);
      }

      const countObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              animateCountUp(entry.target);
              countObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 }
      );
      document.querySelectorAll('[data-count-end]').forEach(el => countObserver.observe(el));
    </script>

    <!-- Floating mobile call button -->
    <a href="tel:+12673947980" class="mobile-call-btn" aria-label="Call us">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
      </svg>
    </a>
  </body>
</html>
