---
interface Props {
  words: string[];
  staticText?: string;
  tag?: string;
  class?: string;
}

const { words, staticText = '', tag = 'span', class: className } = Astro.props;
const id = `fw-${Math.random().toString(36).slice(2, 8)}`;
---

<span class={`flipwords-wrap ${className || ''}`} id={id} data-static={staticText} data-words={JSON.stringify(words)}>
  {staticText && <span class="fw-static">{staticText}</span>}
  <span class="fw-word-col" aria-live="polite" aria-atomic="true">
    {words.map((word, i) => (
      <span class={`fw-word${i === 0 ? ' is-active' : ''}`} data-index={i}>{word}</span>
    ))}
  </span>
</span>

<style>
.flipwords-wrap {
  display: inline;
  white-space: nowrap;
}

.fw-static {
  white-space: nowrap;
}

.fw-word-col {
  display: inline-flex;
  flex-direction: column;
  position: relative;
  /* Reserve width for the longest word — prevents layout shift */
  min-width: 8.5ch;
  vertical-align: bottom;
  line-height: 1.2;
}

/* Each word stacked vertically; active one is visible */
.fw-word {
  display: block;
  min-width: 8.5ch;
  white-space: nowrap;
  color: #7CB342;
  opacity: 0;
  filter: blur(4px);
  transform: translateY(10px);
  transition: filter 0.45s cubic-bezier(0.23, 1, 0.32, 1),
              opacity 0.4s ease,
              transform 0.45s cubic-bezier(0.23, 1, 0.32, 1);
  pointer-events: none;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  will-change: filter, transform, opacity;
}

/* Active word — shown */
.fw-word.is-active {
  opacity: 1;
  filter: blur(0px);
  transform: translateY(0);
  position: relative;
}
</style>

<script define:vars={{ id }}>
(function () {
  const wrap = document.getElementById(id);
  if (!wrap) return;

  const wordEls = Array.from(wrap.querySelectorAll('.fw-word'));
  if (wordEls.length <= 1) return;

  let current = 0;

  function setHeight() {
    const col = wrap.querySelector('.fw-word-col');
    if (!col) return;
    const lineH = parseFloat(window.getComputedStyle(col).fontSize) * 1.2;
    col.style.height = `${lineH}px`;
  }

  function nextWord() {
    wordEls[current].classList.remove('is-active');
    current = (current + 1) % wordEls.length;
    wordEls[current].classList.add('is-active');
  }

  setTimeout(() => {
    setHeight();
    setInterval(nextWord, 3000);
  }, 700);
})();
</script>
