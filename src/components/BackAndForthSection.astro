---
export interface Props {
  /** Heading shown above the text block */
  heading: string;
  /** Body copy */
  body: string;
  /** Path to image under /public/images/ */
  imageSrc: string;
  /** Alt text for the image */
  imageAlt: string;
  /**
   * When true, image appears on RIGHT, text on LEFT.
   * When false (default), image appears on LEFT, text on RIGHT.
   */
  flip?: boolean;
  /** Optional CTA button label */
  ctaLabel?: string;
  /** Optional CTA button href */
  ctaHref?: string;
  /** Apply alternate background to text column */
  altBg?: boolean;
}

const {
  heading,
  body,
  imageSrc,
  imageAlt,
  flip = false,
  ctaLabel,
  ctaHref,
  altBg = false,
} = Astro.props;
---

<section class={`baf-section${flip ? ' baf-section--flip' : ''}`}>
  <div class="baf-section__image">
    <img src={imageSrc} alt={imageAlt} title={imageAlt} loading="lazy" />
  </div>
  <div class={`baf-section__content${altBg ? ' baf-section__content--alt' : ''}`}>
    <div class="baf-section__inner">
      <h2>{heading}</h2>
      {body.split('\n').filter(Boolean).map((para) => (
        <p set:html={para} />
      ))}
      {ctaLabel && ctaHref && (
        <a href={ctaHref} class="btn btn--primary" style="margin-top:1.25rem; display:inline-block;">
          {ctaLabel}
        </a>
      )}
    </div>
  </div>
</section>

<style>
.baf-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: stretch;
  min-height: 480px;
}
.baf-section--flip {
  direction: rtl;
}
.baf-section--flip > * {
  direction: ltr;
}
.baf-section__image {
  position: relative;
  overflow: hidden;
}
.baf-section__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  min-height: 480px;
}
.baf-section__content {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rem 3rem;
  background: #ffffff;
}
.baf-section__content--alt {
  background: var(--off-white, #F7F6F3);
}
.baf-section__inner {
  max-width: 480px;
}
.baf-section__inner h2 {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(1.5rem, 2.5vw, 2rem);
  font-weight: 700;
  line-height: 1.2;
  color: var(--text-dark, #1a1a1a);
  margin: 0 0 1.5rem;
}
.baf-section__inner p {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 1rem;
  line-height: 1.8;
  color: var(--text-mid, #4a4a4a);
  margin: 0 0 1rem;
}
.baf-section__inner p:last-of-type {
  margin-bottom: 0;
}
.baf-section__inner .btn--primary {
  display: inline-block;
  padding: 14px 28px;
  border-radius: 100px;
  background: var(--green, #81AB4C);
  color: #fff;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  border: 2px solid var(--green, #81AB4C);
  transition: background 0.25s, transform 0.2s;
}
.baf-section__inner .btn--primary:hover {
  background: #6e9640;
  border-color: #6e9640;
  transform: translateY(-2px);
}
@media (max-width: 860px) {
  .baf-section {
    grid-template-columns: 1fr;
    min-height: auto;
  }
  .baf-section--flip {
    direction: ltr;
  }
  .baf-section__image img {
    min-height: 320px;
  }
  .baf-section__content {
    padding: 2.5rem 1.5rem;
  }
}
</style>
