</style>

<script>
// ═══════════════════════════════════════════════════════════════
//  MEGA MENU — HOVER INTENT FIX
//  Fixes the "dead space gap" problem where the dropdown closes
//  before the cursor reaches it when moving from nav → dropdown.
// ═══════════════════════════════════════════════════════════════

const CLOSE_DELAY = 1000; // ms before closing — generous delay so user can cross gaps comfortably

// Track open state and close timers per nav group
const navGroups = document.querySelectorAll('[data-nav-group]');
const closeTimers = new Map(); // navIndex → setTimeout id

function openDropdown(navIndex) {
  // Clear any pending close timer
  const timer = closeTimers.get(navIndex);
  if (timer) {
    clearTimeout(timer);
    closeTimers.delete(navIndex);
  }

  // Open the nav item
  const group = navGroups[navIndex];
  if (!group) return;

  group.classList.add('is-open');

  // Update ARIA
  const trigger = group.querySelector('[data-nav-trigger]');
  if (trigger) {
    trigger.setAttribute('aria-expanded', 'true');
  }
}

function scheduleClose(navIndex) {
  // Don't schedule if already scheduled
  if (closeTimers.has(navIndex)) return;

  const timer = setTimeout(() => {
    closeDropdown(navIndex);
  }, CLOSE_DELAY);
  closeTimers.set(navIndex, timer);
}

function clearClose(navIndex) {
  const timer = closeTimers.get(navIndex);
  if (timer) {
    clearTimeout(timer);
    closeTimers.delete(navIndex);
  }
}

function closeDropdown(navIndex) {
  const group = navGroups[navIndex];
  if (!group) return;

  group.classList.remove('is-open');

  // Update ARIA
  const trigger = group.querySelector('[data-nav-trigger]');
  if (trigger) {
    trigger.setAttribute('aria-expanded', 'false');
  }

  closeTimers.delete(navIndex);
}

// Initialize all nav groups with hover + keyboard/click handlers
navGroups.forEach((group, navIndex) => {
  const trigger = group.querySelector('[data-nav-trigger]');
  const panel = group.querySelector('[data-nav-panel]');
  const bridge = group.querySelector('[data-nav-bridge]');

  if (!trigger || !panel) return; // No dropdown — skip

  // --- MOUSE ENTER trigger → open immediately, cancel close ---
  trigger.addEventListener('mouseenter', () => {
    clearClose(navIndex);
    openDropdown(navIndex);
  });

  // --- MOUSE LEAVE trigger → schedule close ---
  trigger.addEventListener('mouseleave', (e) => {
    // Don't close immediately — let the user reach the panel/bridge
    scheduleClose(navIndex);
  });

  // --- MOUSE ENTER panel → cancel scheduled close ---
  panel.addEventListener('mouseenter', () => {
    clearClose(navIndex);
    openDropdown(navIndex); // ensure it's open
  });

  // --- MOUSE LEAVE panel → schedule close ---
  panel.addEventListener('mouseleave', (e) => {
    // Only close if mouse actually left the whole nav group area
    scheduleClose(navIndex);
  });

  // --- Bridge: mouseenter prevents close ---
  if (bridge) {
    bridge.addEventListener('mouseenter', () => {
      clearClose(navIndex);
      openDropdown(navIndex);
    });
    bridge.addEventListener('mouseleave', (e) => {
      scheduleClose(navIndex);
    });
  }

  // --- Click on trigger (mobile/touch or keyboard) ---
  trigger.addEventListener('click', (e) => {
    // If dropdown is open, clicking again closes it
    if (group.classList.contains('is-open')) {
      e.preventDefault(); // prevent navigation if re-clicking
      closeDropdown(navIndex);
    } else {
      // Open it (clicking nav link also navigates)
      openDropdown(navIndex);
    }
  });

  // --- Keyboard: Escape closes dropdown ---
  panel.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDropdown(navIndex);
      trigger.focus();
    }
  });

  // --- Focus trap inside panel ---
  const panelLinks = panel.querySelectorAll('a');
  if (panelLinks.length > 0) {
    panelLinks[0].addEventListener('keydown', (e) => {
      if (e.key === 'Tab' && e.shiftKey) {
        // Shift+Tab from first link → focus trigger
        e.preventDefault();
        trigger.focus();
        closeDropdown(navIndex);
      }
    });
    panelLinks[panelLinks.length - 1].addEventListener('keydown', (e) => {
      if (e.key === 'Tab' && !e.shiftKey) {
        // Tab from last link → close and move on
        closeDropdown(navIndex);
      }
    });
  }
});

// Close all dropdowns when clicking outside
document.addEventListener('click', (e) => {
  if (!e.target.closest('[data-nav-group]')) {
    navGroups.forEach((_, idx) => closeDropdown(idx));
  }
});

// ═══════════════════════════════════════════════════════════════
//  MOBILE NAV
// ═══════════════════════════════════════════════════════════════
const navBurger = document.getElementById('navBurger');
const navMobile = document.getElementById('navMobile');
const navMobileClose = document.getElementById('navMobileClose');
const navOverlay = document.getElementById('navOverlay');
const siteHeader = document.getElementById('site-header');

function openMobileNav() {
  navBurger?.setAttribute('aria-expanded', 'true');
  navMobile?.setAttribute('aria-hidden', 'false');
  siteHeader?.classList.add('is-mobile-open');
  document.body.style.overflow = 'hidden';
}

function closeMobileNav() {
  navBurger?.setAttribute('aria-expanded', 'false');
  navMobile?.setAttribute('aria-hidden', 'true');
  siteHeader?.classList.remove('is-mobile-open');
  document.body.style.overflow = '';
}

navBurger?.addEventListener('click', openMobileNav);
navMobileClose?.addEventListener('click', closeMobileNav);
navOverlay?.addEventListener('click', closeMobileNav);

// Mobile accordion — tap to expand/collapse
document.querySelectorAll('.mobile-nav-group__toggle').forEach((toggle) => {
  toggle.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', (!isExpanded).toString());
  });
});

// ═══════════════════════════════════════════════════════════════
//  SCROLL DETECTION
// ═══════════════════════════════════════════════════════════════
let lastScroll = 0;
window.addEventListener('scroll', () => {
  const currentScroll = window.pageYOffset;
  if (currentScroll > 50) {
    siteHeader?.classList.add('is-scrolled');
  } else {
    siteHeader?.classList.remove('is-scrolled');
  }
  lastScroll = currentScroll;
});
</script>
