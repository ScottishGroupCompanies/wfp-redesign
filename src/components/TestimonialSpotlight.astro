---
/**
 * TestimonialSpotlight — Wall of review cards where a soft green spotlight
 * follows the cursor and lights up the card underneath while the others rest dim.
 * Adapted from windowfilm-ui2.vercel.app. Uses WFP palette (charcoal/green, no blue).
 *
 * Props:
 *   eyebrow  — small label above the grid
 *   title    — H2 section heading
 *   subtitle — supporting paragraph
 *   items    — array of { quote, name, detail, avatar }
 */
interface TestimonialItem {
  quote: string;
  name: string;
  detail: string;
  avatar?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  items?: TestimonialItem[];
}

const {
  eyebrow = 'Client Reviews',
  title = 'What Clients Say',
  subtitle = '',
  items = [],
} = Astro.props;
---

<section class="tspot">
  {(eyebrow || title || subtitle) && (
    <div class="tspot__header">
      {eyebrow && <p class="tspot__eyebrow">{eyebrow}</p>}
      {title && <h2 class="tspot__title">{title}</h2>}
      {subtitle && <p class="tspot__subtitle">{subtitle}</p>}
    </div>
  )}
  <div class="tspot__grid">
    {items.map((t) => (
      <article class="tspot__card">
        <div class="tspot__glow" aria-hidden="true"></div>
        <div class="tspot__body">
          <div class="tspot__stars">★★★★★</div>
          <blockquote>"{t.quote}"</blockquote>
          <figcaption>
            {t.avatar && <img src={t.avatar} alt={t.name} title={t.name} loading="lazy" />}
            <span><b>{t.name}</b><small>{t.detail}</small></span>
          </figcaption>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .tspot { background: #14201A; padding: 96px 5%; }
  .tspot__header { text-align: center; margin-bottom: 56px; }
  .tspot__eyebrow {
    font-family: 'Space Mono', monospace;
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.22em;
    color: #7CB342; margin: 0 0 12px;
  }
  .tspot__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 700; color: #fff; line-height: 1.2; margin: 0 0 1rem;
  }
  .tspot__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 1rem; color: rgba(255,255,255,0.5);
    max-width: 500px; margin: 0 auto; line-height: 1.7;
  }

  .tspot__grid {
    max-width: 1200px; margin: 0 auto;
    display: grid; gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .tspot__card {
    position: relative;
    border-radius: 1rem;
    padding: 1px;
    background: rgba(255,255,255,0.06);
    overflow: hidden;
    transition: transform 0.3s ease;
  }
  .tspot__glow {
    position: absolute;
    left: var(--mx, 50%); top: var(--my, 50%);
    width: 300px; height: 300px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(124,179,66,0.35), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .tspot__card:hover .tspot__glow { opacity: 1; }
  .tspot__card:hover { transform: translateY(-4px); }
  .tspot__body {
    position: relative;
    height: 100%;
    padding: 1.75rem;
    border-radius: calc(1rem - 1px);
    background: #1a2e22;
  }
  .tspot__stars {
    color: #7CB342;
    letter-spacing: 2px;
    font-size: 0.8rem;
    margin-bottom: 0.6rem;
  }
  .tspot__body blockquote {
    font-family: 'Playfair Display', Georgia, serif;
    color: rgba(255,255,255,0.9);
    font-size: 1.02rem;
    line-height: 1.5;
    margin: 0 0 1.1rem;
    font-style: italic;
  }
  .tspot__body figcaption { display: flex; align-items: center; gap: 0.7rem; }
  .tspot__body img {
    width: 44px; height: 44px;
    border-radius: 9999px;
    object-fit: cover;
    border: 2px solid #7CB342;
  }
  .tspot__body b { display: block; color: #fff; font-size: 0.9rem; }
  .tspot__body small { color: rgba(255,255,255,0.5); font-size: 0.75rem; }

  @media (prefers-reduced-motion: reduce) {
    .tspot__card, .tspot__glow { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.tspot__card').forEach((card) => {
    const glow = card.querySelector<HTMLElement>('.tspot__glow');
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      glow?.style.setProperty('--mx', `${e.clientX - rect.left}px`);
      glow?.style.setProperty('--my', `${e.clientY - rect.top}px`);
    });
  });
</script>
