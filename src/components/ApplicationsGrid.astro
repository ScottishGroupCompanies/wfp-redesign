---
interface Item {
  title: string;
  img: string;
  href: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="ag-grid">
  {items.map(item => (
    <a href={item.href} class="ag-card">
      <div class="ag-card__img-wrap">
        <img src={item.img} alt={item.title} title={item.title} loading="lazy" />
      </div>
      <div class="ag-card__overlay" aria-hidden="true"></div>
      <span class="ag-card__title">{item.title}</span>
    </a>
  ))}
</div>

<style>
  .ag-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .ag-card {
    position: relative;
    display: block;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    text-decoration: none;
    background: #1a1a1a;
  }

  .ag-card__img-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .ag-card__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .ag-card:hover .ag-card__img-wrap img {
    transform: scale(1.08);
  }

  .ag-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.18) 50%, rgba(0,0,0,0) 100%);
    transition: background 0.3s ease;
  }

  .ag-card:hover .ag-card__overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.86) 0%, rgba(0,0,0,0.38) 55%, rgba(0,0,0,0.12) 100%);
  }

  .ag-card__title {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    font-family: var(--font-serif, 'Playfair Display', Georgia, serif);
    font-size: clamp(15px, 1.4vw, 20px);
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
    transition: transform 0.3s ease;
  }

  .ag-card:hover .ag-card__title {
    transform: translateY(-4px);
  }

  @media (max-width: 1024px) {
    .ag-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .ag-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .ag-card { aspect-ratio: 1 / 1; }
  }
</style>
