---
/**
 * CoveragePinMap — stylized SVG map with location pins + HTML tooltips.
 * JS-driven hover to avoid CSS transform/SVG attribute conflicts.
 * Adapted from windowfilm-ui2.vercel.app component library.
 */
interface City {
  name: string;
  stat: string;
  x: number;  // 0–800 SVG units
  y: number;  // 0–450 SVG units
}
interface Props {
  title?: string;
  subtitle?: string;
  cities?: City[];
}
const {
  title = "Cities we serve",
  subtitle = "Certified installers across the Greater Philadelphia region.",
  cities = [
    { name: "Philadelphia, PA",   stat: "Primary service area",  x: 340, y: 215 },
    { name: "Upper Darby, PA",    stat: "Delaware County",        x: 305, y: 200 },
    { name: "Camden, NJ",         stat: "South Jersey hub",       x: 365, y: 230 },
    { name: "Reading, PA",        stat: "Berks County",           x: 200, y: 160 },
    { name: "Cherry Hill, NJ",    stat: "Camden County",          x: 400, y: 252 },
    { name: "Norristown, PA",     stat: "Montgomery County",      x: 280, y: 185 },
    { name: "Wilmington, DE",     stat: "New Castle County",      x: 260, y: 320 },
    { name: "Chester, PA",        stat: "Delaware County",        x: 303, y: 273 },
    { name: "Voorhees, NJ",       stat: "Camden County",          x: 430, y: 262 },
    { name: "Haddonfield, NJ",    stat: "Camden County",          x: 390, y: 248 },
  ],
} = Astro.props;
---

<section class="cpm">
  <div class="cpm__inner">
    <div class="cpm__header">
      <p class="cpm__eyebrow">Service Area</p>
      <h2 class="cpm__title">{title}</h2>
      <p class="cpm__subtitle">{subtitle}</p>
    </div>

    <div class="cpm__wrap">
      <!-- HTML tooltips — absolutely positioned, driven by JS -->
      {cities.map((city, i) => (
        <div class="cpm__tip" id={`cpm-tip-${i}`} role="tooltip">
          <strong>{city.name}</strong>
          <span>{city.stat}</span>
        </div>
      ))}

      <svg class="cpm__svg" viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg"
           aria-label="Map of the Greater Philadelphia service region">
        <defs>
          <linearGradient id="cpm-land" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%"   stop-color="#eef4e4" />
            <stop offset="100%" stop-color="#e2ecda" />
          </linearGradient>
          <filter id="cpm-shadow" x="-100%" y="-100%" width="300%" height="300%">
            <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#27421a" flood-opacity="0.25" />
          </filter>
          <pattern id="cpm-dots" x="0" y="0" width="18" height="18" patternUnits="userSpaceOnUse">
            <circle cx="9" cy="9" r="0.9" fill="#bfcfaf" />
          </pattern>
        </defs>

        <!-- Landmass fill -->
        <path d="M60,90 Q130,55 210,68 L360,48 Q510,52 660,68 L755,95 Q782,148 774,222 L765,305 Q742,362 698,392 L548,405 Q398,415 248,406 L98,386 Q56,344 50,282 L44,202 Q50,144 60,90 Z"
          fill="url(#cpm-land)" stroke="#cddcbb" stroke-width="1.5" />
        <!-- Dot texture overlay -->
        <path d="M60,90 Q130,55 210,68 L360,48 Q510,52 660,68 L755,95 Q782,148 774,222 L765,305 Q742,362 698,392 L548,405 Q398,415 248,406 L98,386 Q56,344 50,282 L44,202 Q50,144 60,90 Z"
          fill="url(#cpm-dots)" />

        <!-- Schuylkill River -->
        <path d="M310,72 Q328,140 336,210 Q342,260 350,340"
          fill="none" stroke="#a8c4e0" stroke-width="2" opacity="0.7" stroke-linecap="round" />
        <!-- Delaware River -->
        <path d="M372,58 Q376,150 366,252 Q360,318 382,395"
          fill="none" stroke="#a8c4e0" stroke-width="2.5" opacity="0.7" stroke-linecap="round" />

        <!-- City pins — JS handles hover, no CSS transform conflict -->
        {cities.map((city, i) => (
          <g class="cpm__pin"
             data-index={i}
             transform={`translate(${city.x},${city.y})`}
             tabindex="0"
             role="button"
             aria-label={`${city.name} — ${city.stat}`}
             aria-describedby={`cpm-tip-${i}`}>
            <!-- Pulse ring (CSS animation only, no transform conflict) -->
            <circle class="cpm__pulse" cx="0" cy="0" r="16" fill="#81AB4C" opacity="0.18" />
            <!-- Pin dot -->
            <circle class="cpm__dot" cx="0" cy="0" r="8" fill="#81AB4C" filter="url(#cpm-shadow)" />
            <circle cx="0" cy="0" r="3.5" fill="#ffffff" />
          </g>
        ))}
      </svg>
    </div>
  </div>
</section>

<style>
.cpm {
  background: #F7F6F3;
  padding: 80px 5%;
}
.cpm__inner {
  max-width: 1100px;
  margin: 0 auto;
}
.cpm__header {
  text-align: center;
  margin-bottom: 40px;
}
.cpm__eyebrow {
  font-family: 'DM Sans', sans-serif;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: #81AB4C;
  margin: 0 0 12px;
}
.cpm__title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.2;
  margin: 0 0 16px;
}
.cpm__subtitle {
  font-family: 'DM Sans', sans-serif;
  font-size: 1rem;
  color: #4a4a4a;
  max-width: 520px;
  margin: 0 auto;
  line-height: 1.65;
}

/* Map wrapper — relative so HTML tooltips can position against it */
.cpm__wrap {
  position: relative;
  background: #fff;
  border-radius: 24px;
  border: 1px solid #EFEFED;
  box-shadow: 0 4px 24px rgba(39, 46, 50, 0.07);
  overflow: visible; /* allow tooltips to overflow */
}

.cpm__svg {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 24px;
  overflow: visible;
}

/* Pin cursor */
.cpm__pin {
  cursor: pointer;
}
.cpm__pin:focus {
  outline: none;
}
.cpm__pin:focus .cpm__dot {
  stroke: #fff;
  stroke-width: 2;
}

/* Pulse animation — only animates opacity/scale, never position */
.cpm__pulse {
  transform-box: fill-box;
  transform-origin: center;
  animation: cpm-pulse 2.5s ease-in-out infinite;
}
@keyframes cpm-pulse {
  0%, 100% { opacity: 0.15; transform: scale(1); }
  50%       { opacity: 0.30; transform: scale(1.4); }
}

/* Hover state — driven by JS adding .is-active class, no CSS :hover transform */
.cpm__pin.is-active .cpm__dot {
  fill: #5a8432;
}
.cpm__pin.is-active .cpm__pulse {
  opacity: 0.35;
}

/* HTML tooltips */
.cpm__tip {
  position: absolute;
  background: #81AB4C;
  color: #fff;
  font-family: 'DM Sans', sans-serif;
  font-size: 13px;
  padding: 8px 14px;
  border-radius: 10px;
  pointer-events: none;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(-4px);
  transition: opacity 0.18s ease, transform 0.18s ease;
  z-index: 20;
  /* Positioned by JS */
  top: 0;
  left: 0;
}
.cpm__tip::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  border: 6px solid transparent;
  border-top-color: #81AB4C;
}
.cpm__tip.is-visible {
  opacity: 1;
  transform: translateY(0);
}
.cpm__tip strong {
  display: block;
  font-weight: 700;
  font-size: 13px;
  line-height: 1.3;
}
.cpm__tip span {
  display: block;
  font-size: 11px;
  opacity: 0.85;
  margin-top: 1px;
}

@media (max-width: 768px) {
  .cpm { padding: 48px 5%; }
  .cpm__wrap { border-radius: 16px; }
  .cpm__svg { border-radius: 16px; }
}
</style>

<script>
(function () {
  const wrap = document.querySelector('.cpm__wrap');
  if (!wrap) return;

  const svg = wrap.querySelector('.cpm__svg');
  const pins = wrap.querySelectorAll('.cpm__pin');

  function showTip(pin) {
    const idx = pin.dataset.index;
    const tip = document.getElementById('cpm-tip-' + idx);
    if (!tip) return;

    // Get pin position in SVG coordinates, then map to wrapper-relative pixels
    const svgRect = svg.getBoundingClientRect();
    const wrapRect = wrap.getBoundingClientRect();
    const vb = svg.viewBox.baseVal; // 0 0 800 450

    // Parse translate from the pin's transform attribute
    const transform = pin.getAttribute('transform'); // "translate(x,y)"
    const match = transform.match(/translate\(([^,]+),([^)]+)\)/);
    if (!match) return;

    const svgX = parseFloat(match[1]);
    const svgY = parseFloat(match[2]);

    // Scale from SVG units to screen pixels
    const scaleX = svgRect.width  / vb.width;
    const scaleY = svgRect.height / vb.height;

    const pinScreenX = svgRect.left + svgX * scaleX;
    const pinScreenY = svgRect.top  + svgY * scaleY;

    // Position tooltip relative to wrapper
    const tipLeft = pinScreenX - wrapRect.left;
    const tipTop  = pinScreenY - wrapRect.top;

    // Temporarily show to measure width
    tip.style.visibility = 'hidden';
    tip.classList.add('is-visible');
    const tipW = tip.offsetWidth;
    const tipH = tip.offsetHeight;
    tip.classList.remove('is-visible');
    tip.style.visibility = '';

    tip.style.left = (tipLeft - tipW / 2) + 'px';
    tip.style.top  = (tipTop - tipH - 16) + 'px'; // 16px above pin

    pin.classList.add('is-active');
    tip.classList.add('is-visible');
  }

  function hideTip(pin) {
    const idx = pin.dataset.index;
    const tip = document.getElementById('cpm-tip-' + idx);
    pin.classList.remove('is-active');
    if (tip) tip.classList.remove('is-visible');
  }

  pins.forEach(pin => {
    pin.addEventListener('mouseenter', () => showTip(pin));
    pin.addEventListener('mouseleave', () => hideTip(pin));
    pin.addEventListener('focus',      () => showTip(pin));
    pin.addEventListener('blur',       () => hideTip(pin));
  });
})();
</script>
