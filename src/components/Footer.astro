---

<footer class="wfp-footer">

  <!-- ═══ MAIN FOOTER BODY ═══ -->
  <div class="wfp-footer__body">

    <!-- Column 1: Brand -->
    <div class="wfp-footer__col wfp-footer__col--brand">
      <a href="/" class="wfp-footer__logo" aria-label="Window Film Philadelphia — Home">
        <img src="https://res.cloudinary.com/deunehrew/image/upload/v1781645318/46_v0rlvs.png" alt="Window Film Philadelphia" width="200" height="50" style="width:200px;height:auto;object-fit:contain;background:transparent;" />
      </a>
      <p class="wfp-footer__tagline">Done right, every time.</p>
      <p class="wfp-footer__brand-body">Philadelphia's trusted window film professionals since 2008. Serving the Delaware Valley with premium residential and commercial window film solutions.</p>
      <div class="wfp-footer__social" role="list" aria-label="Social media links">
        {socialLinks.map(s => (
          <a href={s.href} class="wfp-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label={`Window Film Philadelphia on ${s.label}`} role="listitem">
            <span set:html={s.icon} />
          </a>
        ))}
      </div>
      <div class="wfp-footer__rating">
        <span class="wfp-footer__stars">★★★★★</span>
        <span class="wfp-footer__rating-text">4.9 Google Reviews</span>
      </div>
    </div>

    <!-- Column 2: Services -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Services</h3>
      <ul class="wfp-footer__links" role="list">
        {services.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Column 3: Applications -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Applications</h3>
      <ul class="wfp-footer__links" role="list">
        {applications.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Column 4: Cities Served -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Cities Served</h3>
      <ul class="wfp-footer__links" role="list">
        {cities.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Column 5: Resources -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Resources</h3>
      <ul class="wfp-footer__links" role="list">
        {resources.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Column 6: Company -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Company</h3>
      <ul class="wfp-footer__links" role="list">
        {company.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
      <div class="wfp-footer__contact">
        <a href="tel:+12673947980" class="wfp-footer__contact-row">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.68A2 2 0 012 .92h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 8.09a16 16 0 006 6l.83-.83a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          <span>(267) 394-7980</span>
        </a>
        <a href="mailto:info@windowfilmphl.com" class="wfp-footer__contact-row">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/></svg>
          <span>info@windowfilmphl.com</span>
        </a>
        <span class="wfp-footer__contact-row wfp-footer__contact-row--plain">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0116 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Serving Greater Philadelphia</span>
        </span>
        <span class="wfp-footer__contact-row wfp-footer__contact-row--plain">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CB342" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Mon–Sat: 8am – 6pm</span>
        </span>
      </div>
    </div>

  </div>

  <!-- ═══ BOTTOM BAR ═══ -->
  <div class="wfp-footer__bottom">
    <div class="wfp-footer__bottom-inner">
      <p class="wfp-footer__copy">© {currentYear} Window Film Philadelphia. All rights reserved.</p>
      <p class="wfp-footer__brands">3M™ Authorized · LLumar · SunTek · Vista</p>
      <div class="wfp-footer__bottom-links">
        <a href="/privacy/" class="wfp-footer__bottom-link">Privacy Policy</a>
        <span>&middot;</span>
        <a href="/terms/" class="wfp-footer__bottom-link">Terms</a>
        <span>&middot;</span>
        <a href="/sitemap/" class="wfp-footer__bottom-link">Sitemap</a>
      </div>
    </div>
  </div>

</footer>

<style>
/* ─── FOOTER BASE ─── */
.wfp-footer {
  background: #0d1a0f;
  color: rgba(255,255,255,0.55);
  font-family: 'Inter', sans-serif;
}

/* ─── MAIN BODY — 6 COLUMNS ─── */
.wfp-footer__body {
  max-width: 1400px;
  margin: 0 auto;
  padding: 80px 80px 60px;
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr 1fr;
  gap: 48px;
}

/* ─── BRAND COLUMN ─── */
.wfp-footer__logo {
  display: inline-block;
  margin-bottom: 24px;
  text-decoration: none;
  background: transparent;
}
.wfp-footer__logo img {
  display: block;
  width: 200px;
  height: auto;
  object-fit: contain;
  background: transparent;
}
.wfp-footer__tagline {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 500;
  color: #fff;
  margin: 0 0 16px;
  line-height: 1.4;
}
.wfp-footer__brand-body {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.55);
  line-height: 1.7;
  margin: 0 0 24px;
}
.wfp-footer__social {
  display: flex;
  gap: 10px;
  margin-top: 24px;
}
.wfp-footer__social-link {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.15);
  color: #fff;
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s, transform 0.2s;
}
.wfp-footer__social-link:hover {
  border-color: #7CB342;
  color: #7CB342;
  transform: translateY(-2px);
}
.wfp-footer__rating {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 20px;
}
.wfp-footer__stars {
  color: #7CB342;
  font-size: 14px;
  letter-spacing: 1px;
}
.wfp-footer__rating-text {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: #fff;
}

/* ─── COLUMN HEADINGS ─── */
.wfp-footer__col-heading {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #7CB342;
  margin: 0 0 20px;
  line-height: 1;
}

/* ─── LINKS ─── */
.wfp-footer__links {
  display: flex;
  flex-direction: column;
  gap: 12px;
  list-style: none;
  padding: 0;
  margin: 0;
}
.wfp-footer__link {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  color: rgba(255,255,255,0.60);
  text-decoration: none;
  display: inline-block;
  position: relative;
  transition: color 0.2s ease;
  line-height: 2.2;
}
.wfp-footer__link:hover {
  color: #fff;
  text-decoration: underline;
}

/* ─── CONTACT INFO ─── */
.wfp-footer__contact {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-top: 24px;
}
.wfp-footer__contact-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 0;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  color: rgba(255,255,255,0.70);
  text-decoration: none;
  transition: color 0.2s;
  flex-shrink: 0;
}
.wfp-footer__contact-row svg {
  flex-shrink: 0;
}
a.wfp-footer__contact-row:hover {
  color: #fff;
}
.wfp-footer__contact-row--plain {
  cursor: default;
}

/* ─── BOTTOM BAR ─── */
.wfp-footer__bottom {
  border-top: 1px solid rgba(255,255,255,0.08);
  padding: 24px 80px;
  display: flex;
  align-items: center;
}
.wfp-footer__bottom-inner {
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.wfp-footer__copy {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.45);
  margin: 0;
}
.wfp-footer__brands {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  color: rgba(255,255,255,0.35);
  margin: 0;
}
.wfp-footer__bottom-links {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.45);
}
.wfp-footer__bottom-link {
  color: rgba(255,255,255,0.45);
  text-decoration: none;
  transition: color 0.2s;
}
.wfp-footer__bottom-link:hover {
  color: #fff;
  text-decoration: underline;
}

/* ─── RESPONSIVE ─── */
@media (max-width: 1100px) {
  .wfp-footer__body {
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
    padding: 60px 48px 48px;
  }
  .wfp-footer__col--brand { grid-column: 1 / -1; }
  .wfp-footer__cta { padding: 60px 48px; }
  .wfp-footer__bottom { padding: 24px 48px; }
}
@media (max-width: 768px) {
  .wfp-footer__cta { padding: 48px 24px; }
  .wfp-footer__cta-headline { font-size: 28px; }
  .wfp-footer__body {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 48px 24px 40px;
  }
  .wfp-footer__bottom {
    padding: 24px;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .wfp-footer__bottom-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .wfp-footer__brands { display: none; }
}
@media (max-width: 480px) {
  .wfp-footer__body { grid-template-columns: 1fr; }
  .wfp-footer__cta-btns { flex-direction: column; width: 100%; }
  .wfp-footer__cta-btn-primary,
  .wfp-footer__cta-btn-ghost { width: 100%; justify-content: center; }
}
</style>
