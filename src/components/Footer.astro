    </div>

    <!-- ── COL 3: Benefits ── -->
    <div class="wfp-footer__resources">
      <h3 class="wfp-footer__col-header">BENEFITS</h3>
      <ul class="wfp-footer__links">
        <li><a href="/benefits/energy-savings/">Energy Savings</a></li>
        <li><a href="/benefits/uv-protection-film/">UV Protection</a></li>
        <li><a href="/benefits/solar-control/">Solar Control</a></li>
