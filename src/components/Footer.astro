        <li><a href="/applications/hotel-window-film/">Hotels &amp; Hospitality</a></li>
        <li><a href="/applications/schools-universities/">Schools &amp; Universities</a></li>
        <li><a href="/applications/healthcare/">Hospitals &amp; Healthcare</a></li>
        <li><a href="/government-buildings/">Government Buildings</a></li>
        <li><a href="/applications/museums-libraries/">Museums &amp; Libraries</a></li>
        <li><a href="/applications/churches/">Churches &amp; Faith Centers</a></li>
        <li><a href="/applications/secured-buildings/">Secured Buildings</a></li>
        <li><a href="/applications/mass-transit/">Mass Transit &amp; Airport</a></li>
        <li><a href="/applications/arenas-stadiums/">Arenas &amp; Stadiums</a></li>
