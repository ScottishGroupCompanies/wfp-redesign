---
const phone = '(267) 394-7980';
const email = 'info@windowfilmphl.com';
const tagline = 'Done right, every time.';

const footerLinks = {
  services: [
    { label: 'Residential Film',   href: '/services/residential/' },
    { label: 'Commercial Film',    href: '/services/commercial/' },
    { label: 'Safety & Security', href: '/services/security/' },
    { label: 'Decorative Film',   href: '/services/decorative/' },
    { label: 'Anti-Graffiti',     href: '/services/anti-graffiti/' },
  ],
  applications: [
    { label: 'Homes & Condos',      href: '/applications/homes-condos/' },
    { label: 'Office Buildings',      href: '/applications/office-buildings/' },
    { label: 'Retail & Storefronts', href: '/applications/retail-storefronts/' },
    { label: 'Schools & Healthcare',  href: '/applications/schools-healthcare/' },
    { label: 'Government & Municipal', href: '/applications/government-municipal/' },
  ],
  cities: [
    { label: 'Philadelphia',       href: '/cities/philadelphia/' },
    { label: 'Main Line',         href: '/cities/main-line/' },
    { label: 'Cherry Hill, NJ',   href: '/cities/cherry-hill/' },
    { label: 'South Jersey',      href: '/cities/south-jersey/' },
    { label: 'Bucks County',      href: '/cities/bucks-county/' },
  ],
  company: [
    { label: 'About Us',   href: '/about/' },
    { label: 'Contact',    href: '/contact/' },
    { label: 'Warranty',   href: '/warranty/' },
    { label: 'Products',   href: '/products/' },
    { label: 'Get a Quote', href: '/contact/' },
  ],
};

const socialLinks = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/windowfilmphiladelphia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/windowfilmphiladelphia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/company/window-film-philadelphia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="wfp-footer">

  <!-- CTA Band -->
  <div class="wfp-footer__cta">
    <div class="wfp-footer__cta-inner">
      <div class="wfp-footer__cta-text">
        <p class="eyebrow">Free Consultation</p>
        <h2 class="wfp-footer__cta-headline">Ready to transform your space?</h2>
        <p class="wfp-footer__cta-sub">No-pressure consultation. Professional installation. Lifetime warranty.</p>
      </div>
      <div class="wfp-footer__cta-actions">
        <a href="/contact/" class="btn btn--primary">
          Get a Free Quote
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
        </a>
        <a href={`tel:+1${phone.replace(/\D/g,'')}`} class="wfp-footer__phone-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
          {phone}
        </a>
      </div>
    </div>
  </div>

  <!-- Main Footer Body -->
  <div class="wfp-footer__body">

    <!-- Brand Column -->
    <div class="wfp-footer__col wfp-footer__col--brand">
      <a href="/" class="wfp-footer__logo" aria-label="Window Film Philadelphia — Home">
        <img src="/images/window-film-philadelphia-logo-white.png" alt="Window Film Philadelphia" width="240" height="60" style="width:240px;height:auto;" />
      </a>
      <p class="wfp-footer__tagline">{tagline}<br/>Serving Philadelphia and the Delaware Valley since 2008.</p>
      <div class="wfp-footer__social" role="list" aria-label="Social media links">
        {socialLinks.map(s => (
          <a href={s.href} class="wfp-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label={`Window Film Philadelphia on ${s.label}`} role="listitem">
            <span set:html={s.icon} />
          </a>
        ))}
      </div>
    </div>

    <!-- Services Column -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Services</h3>
      <ul class="wfp-footer__links" role="list">
        {footerLinks.services.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Applications Column -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Applications</h3>
      <ul class="wfp-footer__links" role="list">
        {footerLinks.applications.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Cities Column -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Cities Served</h3>
      <ul class="wfp-footer__links" role="list">
        {footerLinks.cities.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Company Column -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Company</h3>
      <ul class="wfp-footer__links" role="list">
        {footerLinks.company.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
      <div class="wfp-footer__contact">
        <a href={`tel:+1${phone.replace(/\D/g,'')}`} class="wfp-footer__contact-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
          {phone}
        </a>
        <a href={`mailto:${email}`} class="wfp-footer__contact-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
          {email}
        </a>
      </div>
    </div>

  </div>

  <!-- Bottom Row -->
  <div class="wfp-footer__bottom">
    <div class="wfp-footer__bottom-inner">
      <p class="wfp-footer__copy">&copy; {currentYear} Window Film Philadelphia. All rights reserved.</p>
      <div class="wfp-footer__bottom-links">
        <a href="/privacy-policy/" class="wfp-footer__bottom-link">Privacy Policy</a>
        <span aria-hidden="true">&middot;</span>
        <a href="/terms-of-service/" class="wfp-footer__bottom-link">Terms of Service</a>
      </div>
    </div>
  </div>

</footer>

<style>
.wfp-footer {
  background: var(--dark-bg, #14201A);
  color: rgba(255,255,255,0.65);
  font-family: var(--font-body, 'Inter', sans-serif);
}

/* ── CTA Band ── */
.wfp-footer__cta {
  background: linear-gradient(135deg, #1a2e1f 0%, #14201A 60%);
  border-top: 1px solid rgba(124,179,66,0.15);
  padding: 72px 40px;
  position: relative;
  overflow: hidden;
}
.wfp-footer__cta::before {
  content: '';
  position: absolute;
  top: -100px; left: -100px;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(124,179,66,0.06) 0%, transparent 70%);
  pointer-events: none;
}
.wfp-footer__cta-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  position: relative;
  z-index: 1;
}
.wfp-footer__cta-headline {
  font-family: var(--font-display, 'Playfair Display', serif);
  font-size: clamp(1.8rem, 3vw, 2.8rem);
  font-weight: 700;
  color: #fff;
  margin: 0 0 8px;
  line-height: 1.1;
}
.wfp-footer__cta-sub {
  font-size: 0.95rem;
  color: rgba(255,255,255,0.5);
  margin: 0;
}
.wfp-footer__cta-actions {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-shrink: 0;
  flex-wrap: wrap;
}
.wfp-footer__phone-link {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 14px 24px;
  border: 1.5px solid rgba(255,255,255,0.2);
  border-radius: 100px;
  font-size: 0.9rem;
  font-weight: 600;
  color: rgba(255,255,255,0.8);
  text-decoration: none;
  transition: all 0.2s;
}
.wfp-footer__phone-link:hover {
  border-color: rgba(124,179,66,0.5);
  color: #fff;
  background: rgba(124,179,66,0.08);
}

/* ── Main Body ── */
.wfp-footer__body {
  max-width: 1200px;
  margin: 0 auto;
  padding: 72px 40px 56px;
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr 1fr 1fr;
  gap: 40px;
}

/* ── Brand ── */
.wfp-footer__logo {
  display: inline-block;
  margin-bottom: 16px;
  text-decoration: none;
}
.wfp-footer__logo img { opacity: 0.9; transition: opacity 0.2s; }
.wfp-footer__logo:hover img { opacity: 1; }
.wfp-footer__tagline {
  font-size: 0.875rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.4);
  margin: 0 0 24px;
}
.wfp-footer__social { display: flex; gap: 8px; }
.wfp-footer__social-link {
  width: 38px; height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: rgba(255,255,255,0.06);
  color: rgba(255,255,255,0.4);
  text-decoration: none;
  transition: all 0.2s;
}
.wfp-footer__social-link:hover {
  background: rgba(124,179,66,0.15);
  color: var(--green, #7CB342);
  transform: translateY(-2px);
}

/* ── Column Headings ── */
.wfp-footer__col-heading {
  font-family: var(--font-body, 'Inter', sans-serif);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
  margin: 0 0 18px;
}

/* ── Links ── */
.wfp-footer__links {
  display: flex;
  flex-direction: column;
  gap: 10px;
  list-style: none;
  padding: 0; margin: 0;
}
.wfp-footer__link {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.5);
  text-decoration: none;
  display: inline-block;
  position: relative;
  transition: color 0.2s;
}
.wfp-footer__link::after {
  content: '';
  position: absolute;
  bottom: -1px; left: 0;
  width: 0; height: 1px;
  background: var(--green, #7CB342);
  transition: width 0.25s ease;
}
.wfp-footer__link:hover { color: rgba(255,255,255,0.9); }
.wfp-footer__link:hover::after { width: 100%; }

/* ── Contact ── */
.wfp-footer__contact {
  margin-top: 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.wfp-footer__contact-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  font-weight: 500;
  color: rgba(255,255,255,0.5);
  text-decoration: none;
  transition: color 0.2s;
}
.wfp-footer__contact-item:hover { color: var(--green, #7CB342); }

/* ── Bottom ── */
.wfp-footer__bottom {
  border-top: 1px solid rgba(255,255,255,0.06);
}
.wfp-footer__bottom-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.wfp-footer__copy {
  font-size: 0.8rem;
  color: rgba(255,255,255,0.25);
  margin: 0;
}
.wfp-footer__bottom-links {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 0.8rem;
  color: rgba(255,255,255,0.2);
}
.wfp-footer__bottom-link {
  color: rgba(255,255,255,0.3);
  text-decoration: none;
  transition: color 0.2s;
}
.wfp-footer__bottom-link:hover { color: rgba(255,255,255,0.6); }

/* ── Responsive ── */
@media (max-width: 1100px) {
  .wfp-footer__body { grid-template-columns: 1fr 1fr 1fr; gap: 32px; }
  .wfp-footer__col--brand { grid-column: 1 / -1; }
}
@media (max-width: 768px) {
  .wfp-footer__cta { padding: 48px 24px; }
  .wfp-footer__cta-inner { flex-direction: column; align-items: flex-start; }
  .wfp-footer__body { grid-template-columns: 1fr 1fr; padding: 48px 24px 40px; }
  .wfp-footer__bottom-inner { padding: 20px 24px; flex-direction: column; align-items: flex-start; }
}
@media (max-width: 480px) {
  .wfp-footer__body { grid-template-columns: 1fr; }
}
</style>
