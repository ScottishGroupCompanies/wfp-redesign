---
const phone = '(267) 394-7980';
const email = 'contact@windowfilmphiladelphia.net';

const resourcesLinks = [
  { label: 'Commercial Guide',         href: '/resources/commercial-guide/' },
  { label: 'Window Film Pricing',      href: '/resources/window-film-pricing/' },
  { label: 'Maintenance & Care',      href: '/resources/maintenance-and-care/' },
  { label: 'Window Film Alternatives',href: '/resources/window-film-alternatives/' },
  { label: 'Warranty',               href: '/resources/warranty/' },
  { label: 'FAQ',                    href: '/resources/commercial-faq/' },
];

const companyLinks = [
  { label: 'Our Process',    href: '/process/' },
  { label: 'Contact Us',     href: '/contact/' },
  { label: 'Philadelphia',   href: '/cities/philadelphia/' },
  { label: 'Camden',         href: '/cities/camden/' },
  { label: 'Reading',        href: '/cities/reading/' },
  { label: 'Upper Darby',    href: '/cities/upper-darby-township/' },
];

const socialLinks = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/windowfilmphiladelphia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/windowfilmphiladelphia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  },
  {
    label: 'Pinterest',
    href: 'https://www.pinterest.com/windowfilmphiladelphia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.406.042-3.442.218-.936 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.137.893 2.739a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.266-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>`,
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/company/window-film-philadelphia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="wfp-footer">

  <!-- ══════════════════════════════════════
       CONVERSION BAND
  ══════════════════════════════════════ -->
  <div class="wfp-footer__cta-band">
    <div class="wfp-footer__cta-inner">
      <div class="wfp-footer__cta-text">
        <h2 class="wfp-footer__cta-headline">Ready for a free quote?</h2>
        <p class="wfp-footer__cta-sub">No-pressure consultation. Professional installation. Lifetime warranty.</p>
      </div>
      <div class="wfp-footer__cta-actions">
        <a href="/contact/" class="wfp-footer__cta-btn wfp-footer__cta-btn--primary">
          Get a Free Quote
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
        </a>
        <a href={`tel:+1${phone.replace(/\D/g,'')}`} class="wfp-footer__cta-btn wfp-footer__cta-btn--outline">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
          {phone}
        </a>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       MAIN FOOTER BODY
  ══════════════════════════════════════ -->
  <div class="wfp-footer__body">

    <!-- Column 1: Brand -->
    <div class="wfp-footer__col wfp-footer__col--brand">
      <a href="/" class="wfp-footer__logo" aria-label="Window Film Philadelphia — Home">
        <img
          src="/images/window-film-philadelphia-logo-white.png"
          alt="Window Film Philadelphia"
          class="wfp-footer__logo-img"
          width="260"
          height="68"
        />
      </a>
      <p class="wfp-footer__tagline">
        Philadelphia's leading commercial and residential window film contractor.
        Serving Philadelphia, Camden, Reading, and surrounding counties since 2008.
      </p>
      <!-- Social icons -->
      <div class="wfp-footer__social" role="list" aria-label="Social media links">
        {socialLinks.map(s => (
          <a
            href={s.href}
            class="wfp-footer__social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Window Film Philadelphia on ${s.label}`}
            role="listitem"
          >
            <span set:html={s.icon} />
          </a>
        ))}
      </div>
    </div>

    <!-- Column 2: Resources -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Resources</h3>
      <ul class="wfp-footer__links" role="list">
        {resourcesLinks.map(l => (
          <li role="listitem">
            <a href={l.href} class="wfp-footer__link">{l.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 3: Company -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Company</h3>
      <ul class="wfp-footer__links" role="list">
        {companyLinks.map(l => (
          <li role="listitem">
            <a href={l.href} class="wfp-footer__link">{l.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 4: Contact -->
    <div class="wfp-footer__col wfp-footer__col--contact">
      <h3 class="wfp-footer__col-heading">Contact</h3>
      <div class="wfp-footer__contact-list">
        <a href={`tel:+1${phone.replace(/\D/g,'')}`} class="wfp-footer__contact-item" aria-label="Call us">
          <span class="wfp-footer__contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
          </span>
          <div>
            <div class="wfp-footer__contact-label">Phone</div>
            <div class="wfp-footer__contact-value">{phone}</div>
          </div>
        </a>
        <a href={`mailto:${email}`} class="wfp-footer__contact-item" aria-label="Email us">
          <span class="wfp-footer__contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
          </span>
          <div>
            <div class="wfp-footer__contact-label">Email</div>
            <div class="wfp-footer__contact-value">{email}</div>
          </div>
        </a>
        <div class="wfp-footer__contact-item wfp-footer__contact-item--static">
          <span class="wfp-footer__contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
          </span>
          <div>
            <div class="wfp-footer__contact-label">Serving</div>
            <div class="wfp-footer__contact-value">Philadelphia & the Delaware Valley</div>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /wfp-footer__body -->

  <!-- ══════════════════════════════════════
       COPYRIGHT ROW
  ══════════════════════════════════════ -->
  <div class="wfp-footer__bottom">
    <div class="wfp-footer__bottom-inner">
      <p class="wfp-footer__copy">
        &copy; {currentYear} Window Film Philadelphia. All rights reserved.
      </p>
      <div class="wfp-footer__bottom-links">
        <a href="/privacy-policy/" class="wfp-footer__bottom-link">Privacy Policy</a>
        <span aria-hidden="true">&middot;</span>
        <a href="/terms-of-service/" class="wfp-footer__bottom-link">Terms of Service</a>
      </div>
    </div>
  </div>

</footer>

<style>
/* ─── FOOTER ROOT ─── */
.wfp-footer {
  background-color: #1a2332; /* Deep navy — premium, high-contrast */
  color: #e8edf2;
  font-family: 'DM Sans', sans-serif;
}

/* ─── CTA BAND ─── */
.wfp-footer__cta-band {
  background: linear-gradient(135deg, #243347 0%, #1a2332 60%, #162030 100%);
  border-top: 1px solid rgba(129, 171, 76, 0.2);
  padding: 56px 40px;
  position: relative;
  overflow: hidden;
}
/* Decorative green glow top-left */
.wfp-footer__cta-band::before {
  content: '';
  position: absolute;
  top: -80px; left: -80px;
  width: 320px; height: 320px;
  background: radial-gradient(circle, rgba(129,171,76,0.08) 0%, transparent 70%);
  pointer-events: none;
}
/* Decorative bottom-right */
.wfp-footer__cta-band::after {
  content: '';
  position: absolute;
  bottom: -60px; right: -40px;
  width: 240px; height: 240px;
  background: radial-gradient(circle, rgba(129,171,76,0.05) 0%, transparent 70%);
  pointer-events: none;
}

.wfp-footer__cta-inner {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  position: relative;
  z-index: 1;
}

.wfp-footer__cta-text { flex: 1; }

.wfp-footer__cta-headline {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 8px;
  line-height: 1.2;
}

.wfp-footer__cta-sub {
  font-size: 0.95rem;
  color: rgba(232, 237, 242, 0.55);
  margin: 0;
  line-height: 1.5;
}

.wfp-footer__cta-actions {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
  flex-wrap: wrap;
}

.wfp-footer__cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 14px 28px;
  border-radius: 100px;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.9rem;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.wfp-footer__cta-btn--primary {
  background: #81AB4C;
  color: #fff;
  box-shadow: 0 4px 20px rgba(129,171,76,0.35);
}
.wfp-footer__cta-btn--primary:hover {
  background: #96c05e;
  transform: translateY(-2px);
  box-shadow: 0 8px 32px rgba(129,171,76,0.5);
}
.wfp-footer__cta-btn--primary svg {
  transition: transform 0.25s ease;
}
.wfp-footer__cta-btn--primary:hover svg {
  transform: translateX(3px);
}

.wfp-footer__cta-btn--outline {
  background: transparent;
  color: rgba(232, 237, 242, 0.75);
  border: 1.5px solid rgba(232, 237, 242, 0.2);
}
.wfp-footer__cta-btn--outline:hover {
  background: rgba(232, 237, 242, 0.06);
  border-color: rgba(232, 237, 242, 0.4);
  color: #fff;
}

/* ─── MAIN BODY ─── */
.wfp-footer__body {
  max-width: 1280px;
  margin: 0 auto;
  padding: 72px 40px 64px;
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
  gap: 48px;
}

/* ─── BRAND COLUMN ─── */
.wfp-footer__logo {
  display: inline-block;
  text-decoration: none;
  margin-bottom: 20px;
}
.wfp-footer__logo-img {
  height: 52px;
  width: auto;
  display: block;
  opacity: 0.9;
  transition: opacity 0.25s;
}
.wfp-footer__logo:hover .wfp-footer__logo-img { opacity: 1; }

.wfp-footer__tagline {
  font-size: 0.875rem;
  line-height: 1.7;
  color: rgba(232, 237, 242, 0.5);
  margin: 0 0 24px;
}

/* Social icons */
.wfp-footer__social {
  display: flex;
  gap: 8px;
}

.wfp-footer__social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px; height: 40px;
  border-radius: 10px;
  background: rgba(232, 237, 242, 0.06);
  color: rgba(232, 237, 242, 0.5);
  text-decoration: none;
  transition: all 0.25s ease;
}
.wfp-footer__social-link:hover {
  background: rgba(129, 171, 76, 0.15);
  color: #81AB4C;
  transform: translateY(-2px);
}
/* Focus state for accessibility */
.wfp-footer__social-link:focus-visible {
  outline: 2px solid #81AB4C;
  outline-offset: 2px;
}

/* ─── NAV COLUMNS ─── */
.wfp-footer__col-heading {
  font-family: 'DM Sans', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(232, 237, 242, 0.35);
  margin: 0 0 20px;
}

.wfp-footer__links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.wfp-footer__link {
  font-size: 0.9rem;
  color: rgba(232, 237, 242, 0.6);
  text-decoration: none;
  display: inline-block;
  position: relative;
  transition: color 0.2s ease;
  padding: 1px 0;
}
/* Slide underline hover */
.wfp-footer__link::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 0;
  height: 1px;
  background: #81AB4C;
  transition: width 0.25s ease;
}
.wfp-footer__link:hover { color: rgba(232, 237, 242, 0.95); }
.wfp-footer__link:hover::after { width: 100%; }
.wfp-footer__link:focus-visible {
  outline: 2px solid #81AB4C;
  outline-offset: 3px;
  border-radius: 2px;
}

/* ─── CONTACT COLUMN ─── */
.wfp-footer__contact-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.wfp-footer__contact-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  text-decoration: none;
  padding: 4px 0;
  transition: opacity 0.2s;
}
.wfp-footer__contact-item:not(.wfp-footer__contact-item--static):hover {
  opacity: 0.8;
}
.wfp-footer__contact-item:not(.wfp-footer__contact-item--static):hover .wfp-footer__contact-icon {
  background: rgba(129, 171, 76, 0.2);
  color: #81AB4C;
}
.wfp-footer__contact-item:focus-visible {
  outline: 2px solid #81AB4C;
  outline-offset: 3px;
  border-radius: 4px;
}

.wfp-footer__contact-icon {
  width: 36px; height: 36px;
  background: rgba(232, 237, 242, 0.07);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(232, 237, 242, 0.45);
  flex-shrink: 0;
  transition: background 0.2s, color 0.2s;
}

.wfp-footer__contact-label {
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(232, 237, 242, 0.35);
  margin-bottom: 3px;
}

.wfp-footer__contact-value {
  font-size: 0.9rem;
  color: rgba(232, 237, 242, 0.8);
  line-height: 1.4;
}

/* ─── BOTTOM COPYRIGHT ─── */
.wfp-footer__bottom {
  border-top: 1px solid rgba(232, 237, 242, 0.08);
}

.wfp-footer__bottom-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 20px 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.wfp-footer__copy {
  font-size: 0.8rem;
  color: rgba(232, 237, 242, 0.3);
  margin: 0;
}

.wfp-footer__bottom-links {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 0.8rem;
  color: rgba(232, 237, 242, 0.25);
}

.wfp-footer__bottom-link {
  color: rgba(232, 237, 242, 0.3);
  text-decoration: none;
  transition: color 0.2s;
}
.wfp-footer__bottom-link:hover { color: rgba(232, 237, 242, 0.6); }
.wfp-footer__bottom-link:focus-visible {
  outline: 2px solid #81AB4C;
  outline-offset: 2px;
  border-radius: 2px;
}

/* ─── RESPONSIVE ─── */
@media (max-width: 1100px) {
  .wfp-footer__body {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .wfp-footer__col--brand { grid-column: 1 / -1; }
  .wfp-footer__col--contact { grid-column: 1 / -1; }
}

@media (max-width: 768px) {
  .wfp-footer__cta-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
