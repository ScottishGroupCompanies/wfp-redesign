---
const currentYear = new Date().getFullYear();
---

<footer class="wfp-footer">
  <div class="wfp-footer__inner">

    <!-- ── COL 1: Brand ── -->
    <div class="wfp-footer__brand">
      <a href="/" class="wfp-footer__logo" aria-label="Window Film Philadelphia">
        <img src="/images/logo.jpg" alt="Window Film Philadelphia Logo" title="Window Film Philadelphia Logo" width="160" />
      </a>

      <p class="wfp-footer__company">A Scottish Window Tinting Company</p>

      <p class="wfp-footer__tagline">Done right, every time.</p>

      <p class="wfp-footer__body">
        Philadelphia's trusted window film<br />
        professionals since 2008. Serving<br />
        the Delaware Valley.
      </p>

      <div class="wfp-footer__divider"></div>

      <div class="wfp-footer__social">
        <!-- Facebook -->
        <a href="#" class="wfp-footer__social-icon" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
