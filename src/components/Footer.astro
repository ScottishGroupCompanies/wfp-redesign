---
const phone = '(267) 394-7980';
const email = 'info@windowfilmphl.com';
const tagline = 'Done right, every time.';
const currentYear = new Date().getFullYear();

const resources = [
  { label: 'Blog & Tips',           href: '/blog/' },
  { label: 'Window Film Guide',      href: '/resources/guide/' },
  { label: 'Energy Savings Facts',   href: '/resources/energy/' },
  { label: 'UV Protection Facts',   href: '/resources/uv-protection/' },
  { label: 'Before & After Gallery',href: '/gallery/' },
  { label: 'FAQs',                  href: '/faqs/' },
];

const socialLinks = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/windowfilmphiladelphia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/windowfilmphiladelphia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/company/window-film-philadelphia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];

// Cities for ticker band
const cities = [
  'Philadelphia', 'Main Line', 'Cherry Hill NJ', 'South Jersey',
  'Montgomery County', 'Bucks County', 'Delaware County', 'Chester County',
  'Center City', 'Manayunk', 'Fishtown', 'Old City', 'Rittenhouse Square',
  'Society Hill', 'Chestnut Hill', 'Northeast Philadelphia', 'Ardmore',
  'Wayne', 'Bryn Mawr', 'Haverford', 'Narberth', 'Newtown Square',
];
// Duplicate for seamless loop
const tickerCities = [...cities, ...cities];
---

<footer class="wfp-footer">

  <!-- ═══ CITIES TICKER BAND ═══ -->
  <div class="cities-ticker" aria-hidden="true">
    <div class="cities-ticker__track">
      {tickerCities.map((city) => (
        <span class="cities-ticker__item">
          {city}<span class="cities-ticker__sep">·</span>
        </span>
      ))}
    </div>
  </div>

  <!-- ═══ MAIN FOOTER BODY ═══ -->
  <div class="wfp-footer__body">

    <!-- Column 1: Brand -->
    <div class="wfp-footer__col wfp-footer__col--brand">
      <a href="/" class="wfp-footer__logo" aria-label="Window Film Philadelphia — Home">
        <img
          src="https://res.cloudinary.com/deunehrew/image/upload/v1781645318/46_v0rlvs.png"
          alt="Window Film Philadelphia"
          width="180"
          height="45"
          style="width:180px;height:auto;object-fit:contain;background:transparent;display:block;"
        />
      </a>
      <p class="wfp-footer__tagline">Done right, every time.</p>
      <p class="wfp-footer__brand-body">
        Philadelphia's trusted window film<br />professionals since 2008.
      </p>

      <div class="wfp-footer__social" role="list" aria-label="Social media links">
        {socialLinks.map(s => (
          <a
            href={s.href}
            class="wfp-footer__social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Window Film Philadelphia on ${s.label}`}
            role="listitem"
          >
            <span set:html={s.icon} />
          </a>
        ))}
      </div>

      <div class="wfp-footer__rating">
        <span class="wfp-footer__stars">★★★★★</span>
        <span class="wfp-footer__rating-text">4.9 Google Reviews</span>
      </div>
    </div>

    <!-- Column 2: Resources -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Resources</h3>
      <ul class="wfp-footer__links" role="list">
        {resources.map(l => (
          <li>
            <a href={l.href} class="wfp-footer__link">{l.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Column 3: Contact -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Get in Touch</h3>

      <a href={`tel:+1${phone.replace(/\D/g,'')}`} class="wfp-footer__phone">
        {phone}
      </a>

      <a href={`mailto:${email}`} class="wfp-footer__email">
        {email}
      </a>

      <p class="wfp-footer__hours">Mon–Sat: 8am – 6pm</p>

      <a href="/contact/" class="wfp-footer__cta-btn">
        Get a Free Quote
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/>
        </svg>
      </a>
    </div>

  </div>

  <!-- ═══ BOTTOM BAR ═══ -->
  <div class="wfp-footer__bottom">
    <div class="wfp-footer__bottom-inner">
      <p class="wfp-footer__copy">
        &copy; {currentYear} Window Film Philadelphia
      </p>
      <div class="wfp-footer__bottom-links">
        <a href="/privacy/" class="wfp-footer__bottom-link">Privacy</a>
        <span aria-hidden="true">&middot;</span>
        <a href="/terms/" class="wfp-footer__bottom-link">Terms</a>
        <span aria-hidden="true">&middot;</span>
        <a href="/sitemap/" class="wfp-footer__bottom-link">Sitemap</a>
      </div>
    </div>
  </div>

</footer>

<style>
/* ══════════════════════════════════════════
   CITIES TICKER BAND
   ══════════════════════════════════════════ */
.cities-ticker {
  background: #7CB342;
  height: 44px;
  overflow: hidden;
  display: flex;
  align-items: center;
  border-top: 1px solid rgba(255,255,255,0.08);
}

.cities-ticker__track {
  display: flex;
  align-items: center;
  white-space: nowrap;
  animation: ticker-scroll 40s linear infinite;
  will-change: transform;
}

.cities-ticker__track:hover {
  animation-play-state: paused;
}

.cities-ticker__item {
  font-family: 'Space Mono', monospace;
  font-size: 12px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.1em;
  padding: 0 4px;
  display: inline-flex;
  align-items: center;
}

.cities-ticker__sep {
  margin-left: 14px;
  opacity: 0.5;
}

@keyframes ticker-scroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* ══════════════════════════════════════════
   FOOTER BASE
   ══════════════════════════════════════════ */
.wfp-footer {
  background: #0d1a0f;
  color: rgba(255,255,255,0.55);
  font-family: 'Inter', sans-serif;
}

/* ─── MAIN BODY — 3 COLUMNS ─── */
.wfp-footer__body {
  max-width: 1200px;
  margin: 0 auto;
  padding: 72px 80px;
  display: grid;
  grid-template-columns: 1.2fr 1fr 1.2fr;
  gap: 80px;
  align-items: start;
}

/* ─── BRAND COLUMN ─── */
.wfp-footer__logo {
  display: inline-block;
  margin-bottom: 0;
  text-decoration: none;
  background: transparent;
  line-height: 0;
}
.wfp-footer__logo img {
  display: block;
  width: 180px;
  height: auto;
  object-fit: contain;
  background: transparent;
}
.wfp-footer__tagline {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 500;
  color: #fff;
  margin: 20px 0 0;
  line-height: 1.4;
}
.wfp-footer__brand-body {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.55);
  line-height: 1.65;
  margin: 12px 0 0;
}
.wfp-footer__social {
  display: flex;
  gap: 10px;
  margin-top: 20px;
}
.wfp-footer__social-link {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.18);
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s, transform 0.2s, background 0.2s;
}
.wfp-footer__social-link:hover {
  border-color: #7CB342;
  color: #7CB342;
  background: rgba(124,179,66,0.08);
  transform: translateY(-2px);
}
.wfp-footer__rating {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 16px;
}
.wfp-footer__stars {
  color: #7CB342;
  font-size: 14px;
  letter-spacing: 1px;
}
.wfp-footer__rating-text {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: #fff;
}

/* ─── COLUMN HEADINGS ─── */
.wfp-footer__col-heading {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #7CB342;
  margin: 0 0 20px;
  line-height: 1;
}

/* ─── LINKS ─── */
.wfp-footer__links {
  display: flex;
  flex-direction: column;
  gap: 0;
  list-style: none;
  padding: 0;
  margin: 0;
}
.wfp-footer__link {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  color: rgba(255,255,255,0.55);
  text-decoration: none;
  display: inline-block;
  transition: color 0.2s ease;
  line-height: 2.5;
}
.wfp-footer__link:hover {
  color: #fff;
}

/* ─── CONTACT COLUMN ─── */
.wfp-footer__phone {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 28px;
  font-weight: 700;
  color: #fff;
  text-decoration: none;
  letter-spacing: -0.01em;
  margin-bottom: 8px;
  transition: color 0.2s;
  line-height: 1.2;
}
.wfp-footer__phone:hover { color: #7CB342; }

.wfp-footer__email {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  margin-bottom: 8px;
  transition: color 0.2s;
}
.wfp-footer__email:hover { color: rgba(255,255,255,0.9); }

.wfp-footer__hours {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.40);
  margin: 0 0 0;
  line-height: 1.5;
}

.wfp-footer__cta-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  height: 48px;
  margin-top: 24px;
  background: #7CB342;
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  border-radius: 8px;
  transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  box-shadow: 0 4px 16px rgba(124,179,66,0.3);
}
.wfp-footer__cta-btn:hover {
  background: #8fc452;
  transform: translateY(-1px);
  box-shadow: 0 6px 24px rgba(124,179,66,0.4);
  color: #fff;
}
.wfp-footer__cta-btn:active { transform: translateY(0); }
.wfp-footer__cta-btn svg { transition: transform 0.2s; }
.wfp-footer__cta-btn:hover svg { transform: translateX(3px); }

/* ─── BOTTOM BAR ─── */
.wfp-footer__bottom {
  border-top: 1px solid rgba(255,255,255,0.08);
  padding: 20px 80px;
}
.wfp-footer__bottom-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.wfp-footer__copy {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  color: rgba(255,255,255,0.40);
  margin: 0;
}
.wfp-footer__bottom-links {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  color: rgba(255,255,255,0.40);
}
.wfp-footer__bottom-link {
  color: rgba(255,255,255,0.40);
  text-decoration: none;
  transition: color 0.2s;
}
.wfp-footer__bottom-link:hover { color: rgba(255,255,255,0.75); }

/* ─── RESPONSIVE ─── */
@media (max-width: 1100px) {
  .wfp-footer__body {
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    padding: 56px 48px 48px;
  }
  .wfp-footer__col--brand { grid-column: 1 / -1; }
  .wfp-footer__bottom { padding: 20px 48px; }
}

@media (max-width: 768px) {
  .cities-ticker { height: 40px; }
  .cities-ticker__item { font-size: 11px; }

  .wfp-footer__body {
    grid-template-columns: 1fr;
    gap: 40px;
    padding: 48px 24px 40px;
  }
  .wfp-footer__col--brand { grid-column: auto; }
  .wfp-footer__phone { font-size: 24px; }

  .wfp-footer__bottom {
    padding: 20px 24px;
  }
  .wfp-footer__bottom-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
}

@media (max-width: 480px) {
  .wfp-footer__body { padding: 40px 20px 32px; }
  .wfp-footer__bottom { padding: 16px 20px; }
  .wfp-footer__phone { font-size: 22px; }
}
</style>
