            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <!-- LinkedIn -->
        <a href="#" class="wfp-footer__social-icon" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
      </div>

      <div class="wfp-footer__reviews-badge">
        <div class="wfp-footer__stars">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="#7CB342"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="#7CB342"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="#7CB342"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="#7CB342"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="#7CB342"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <span class="wfp-footer__reviews-text">4.9 Google Reviews</span>
      </div>
    </div>

    <!-- ── COL 2: Applications ── -->
    <div class="wfp-footer__resources">
      <h3 class="wfp-footer__col-header">APPLICATIONS</h3>
      <ul class="wfp-footer__links">
        <li><a href="/applications/homes-condos/">Homes &amp; Condos</a></li>
        <li><a href="/applications/office/">Office Buildings</a></li>
        <li><a href="/applications/retail/">Retail</a></li>
