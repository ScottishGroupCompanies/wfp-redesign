---
const phone = '(267) 394-7980';
const email = 'info@windowfilmphl.com';
const tagline = 'Done right, every time.';
const currentYear = new Date().getFullYear();

const services = [
  { label: 'Residential Window Film',  href: '/services/residential/' },
  { label: 'Commercial Window Film',   href: '/services/commercial/' },
  { label: 'Safety & Security Film',   href: '/services/security/' },
  { label: 'Decorative Film',         href: '/services/decorative/' },
  { label: 'Anti-Graffiti Film',       href: '/services/anti-graffiti/' },
  { label: 'Solar Control Film',      href: '/services/solar/' },
  { label: 'Privacy Film',            href: '/services/privacy/' },
];

const applications = [
  { label: 'Homes & Condos',         href: '/applications/homes/' },
  { label: 'Office Buildings',        href: '/applications/offices/' },
  { label: 'Retail & Storefronts',    href: '/applications/retail/' },
  { label: 'Schools & Universities',  href: '/applications/schools/' },
  { label: 'Healthcare Facilities',   href: '/applications/healthcare/' },
  { label: 'Government Buildings',    href: '/applications/government/' },
  { label: 'Hotels & Hospitality',    href: '/applications/hotels/' },
  { label: 'Museums & Libraries',     href: '/applications/museums/' },
];

const cities = [
  { label: 'Philadelphia, PA',       href: '/cities/philadelphia/' },
  { label: 'Main Line, PA',          href: '/cities/main-line/' },
  { label: 'Cherry Hill, NJ',         href: '/cities/cherry-hill/' },
  { label: 'South Jersey',            href: '/cities/south-jersey/' },
  { label: 'Montgomery County',       href: '/cities/montgomery-county/' },
  { label: 'Bucks County',            href: '/cities/bucks-county/' },
  { label: 'Delaware County',         href: '/cities/delaware-county/' },
  { label: 'Chester County',          href: '/cities/chester-county/' },
];

const resources = [
  { label: 'Blog & Tips',            href: '/blog/' },
  { label: 'Window Film Guide',      href: '/resources/guide/' },
  { label: 'Energy Savings Facts',    href: '/resources/energy/' },
  { label: 'UV Protection Facts',    href: '/resources/uv-protection/' },
  { label: 'Before & After Gallery', href: '/gallery/' },
  { label: 'Film Brands We Carry',   href: '/products/' },
  { label: 'FAQs',                   href: '/faqs/' },
  { label: 'Get a Free Quote',       href: '/contact/' },
];

const company = [
  { label: 'About Us',              href: '/about/' },
  { label: 'Our Process',           href: '/process/' },
  { label: 'Warranty',              href: '/warranty/' },
  { label: 'Contact Us',            href: '/contact/' },
  { label: 'Privacy Policy',        href: '/privacy/' },
  { label: 'Terms of Service',      href: '/terms/' },
];

const socialLinks = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/windowfilmphiladelphia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/windowfilmphiladelphia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/company/window-film-philadelphia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];
---

<footer class="wfp-footer">

  <!-- ═══ CTA STRIP ═══ -->
  <div class="wfp-footer__cta">
    <div class="wfp-footer__cta-inner">
      <h3 class="wfp-footer__cta-headline">Ready to transform your space?</h3>
      <p class="wfp-footer__cta-sub">Free consultation. Same-day quotes.<br/>Done right, every time.</p>
      <div class="wfp-footer__cta-btns">
        <a href="/contact/" class="wfp-footer__cta-btn-primary">Get a Free Quote →</a>
        <a href="tel:+12673947980" class="wfp-footer__cta-btn-ghost">☎ (267) 394-7980</a>
      </div>
    </div>
  </div>

  <!-- ═══ MAIN FOOTER BODY ═══ -->
  <div class="wfp-footer__body">

    <!-- Column 1: Brand -->
    <div class="wfp-footer__col wfp-footer__col--brand">
      <a href="/" class="wfp-footer__logo" aria-label="Window Film Philadelphia — Home">
        <img src="/images/window-film-philadelphia-logo-white.png" alt="Window Film Philadelphia" width="180" height="45" style="width:180px;height:auto;filter:brightness(0) invert(1);" />
      </a>
      <p class="wfp-footer__tagline">Done right, every time.</p>
      <p class="wfp-footer__brand-body">Philadelphia's trusted window film professionals since 2008. Serving the Delaware Valley with premium residential and commercial window film solutions.</p>
      <div class="wfp-footer__social" role="list" aria-label="Social media links">
        {socialLinks.map(s => (
          <a href={s.href} class="wfp-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label={`Window Film Philadelphia on ${s.label}`} role="listitem">
            <span set:html={s.icon} />
          </a>
        ))}
      </div>
      <div class="wfp-footer__rating">
        <span class="wfp-footer__stars">★★★★★</span>
        <span class="wfp-footer__rating-text">4.9 Google Reviews</span>
      </div>
    </div>

    <!-- Column 2: Services -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Services</h3>
      <ul class="wfp-footer__links" role="list">
        {services.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Column 3: Applications -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Applications</h3>
      <ul class="wfp-footer__links" role="list">
        {applications.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Column 4: Cities Served -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Cities Served</h3>
      <ul class="wfp-footer__links" role="list">
        {cities.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Column 5: Resources -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Resources</h3>
      <ul class="wfp-footer__links" role="list">
        {resources.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Column 6: Company -->
    <div class="wfp-footer__col">
      <h3 class="wfp-footer__col-heading">Company</h3>
      <ul class="wfp-footer__links" role="list">
        {company.map(l => (
          <li><a href={l.href} class="wfp-footer__link">{l.label}</a></li>
        ))}
      </ul>
      <div class="wfp-footer__contact">
        <a href="tel:+12673947980" class="wfp-footer__contact-item">📞 (267) 394-7980</a>
        <a href="mailto:info@windowfilmphl.com" class="wfp-footer__contact-item">✉ info@windowfilmphl.com</a>
        <span class="wfp-footer__contact-item wfp-footer__contact-item--plain">📍 Serving Greater Philadelphia</span>
      </div>
    </div>

  </div>

  <!-- ═══ BOTTOM BAR ═══ -->
  <div class="wfp-footer__bottom">
    <div class="wfp-footer__bottom-inner">
      <p class="wfp-footer__copy">© {currentYear} Window Film Philadelphia. All rights reserved.</p>
      <p class="wfp-footer__brands">3M™ Authorized · LLumar · SunTek · Vista</p>
      <div class="wfp-footer__bottom-links">
        <a href="/privacy/" class="wfp-footer__bottom-link">Privacy Policy</a>
        <span>&middot;</span>
        <a href="/terms/" class="wfp-footer__bottom-link">Terms</a>
        <span>&middot;</span>
        <a href="/sitemap/" class="wfp-footer__bottom-link">Sitemap</a>
      </div>
    </div>
  </div>

</footer>

<style>
/* ─── FOOTER BASE ─── */
.wfp-footer {
  background: #0d1a0f;
  color: rgba(255,255,255,0.55);
  font-family: 'Inter', sans-serif;
}

/* ─── CTA STRIP ─── */
.wfp-footer__cta {
  background: #14201A;
  padding: 60px 80px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
  text-align: center;
}
.wfp-footer__cta-inner {
  max-width: 1400px;
  margin: 0 auto;
}
.wfp-footer__cta-headline {
  font-family: 'Playfair Display', serif;
  font-size: 36px;
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
  margin: 0 0 16px;
}
.wfp-footer__cta-sub {
  font-family: 'Inter', sans-serif;
  font-size: 16px;
  color: rgba(255,255,255,0.65);
  line-height: 1.6;
  margin: 0 0 32px;
}
.wfp-footer__cta-btns {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}
.wfp-footer__cta-btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 32px;
  background: #7CB342;
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 700;
  text-decoration: none;
  border-radius: 100px;
  transition: background 0.2s, transform 0.2s;
  box-shadow: 0 4px 16px rgba(124,179,66,0.4);
}
.wfp-footer__cta-btn-primary:hover {
  background: #2E6B30;
  color: #fff;
  transform: translateY(-2px);
}
.wfp-footer__cta-btn-ghost {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 32px;
  background: transparent;
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  border-radius: 100px;
  border: 1.5px solid rgba(255,255,255,0.5);
  transition: border-color 0.2s, background 0.2s;
}
.wfp-footer__cta-btn-ghost:hover {
  border-color: #fff;
  background: rgba(255,255,255,0.08);
  color: #fff;
}

/* ─── MAIN BODY — 6 COLUMNS ─── */
.wfp-footer__body {
  max-width: 1400px;
  margin: 0 auto;
  padding: 80px 80px 60px;
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr 1fr;
  gap: 48px;
}

/* ─── BRAND COLUMN ─── */
.wfp-footer__logo {
  display: inline-block;
  margin-bottom: 16px;
  text-decoration: none;
}
.wfp-footer__logo img { display: block; }
.wfp-footer__tagline {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 500;
  color: #fff;
  margin: 0 0 16px;
  line-height: 1.4;
}
.wfp-footer__brand-body {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.55);
  line-height: 1.7;
  margin: 0 0 24px;
}
.wfp-footer__social {
  display: flex;
  gap: 10px;
  margin-top: 24px;
}
.wfp-footer__social-link {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.15);
  color: #fff;
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s, transform 0.2s;
}
.wfp-footer__social-link:hover {
  border-color: #7CB342;
  color: #7CB342;
  transform: translateY(-2px);
}
.wfp-footer__rating {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 20px;
}
.wfp-footer__stars {
  color: #7CB342;
  font-size: 14px;
  letter-spacing: 1px;
}
.wfp-footer__rating-text {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: #fff;
}

/* ─── COLUMN HEADINGS ─── */
.wfp-footer__col-heading {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #7CB342;
  margin: 0 0 20px;
  line-height: 1;
}

/* ─── LINKS ─── */
.wfp-footer__links {
  display: flex;
  flex-direction: column;
  gap: 12px;
  list-style: none;
  padding: 0;
  margin: 0;
}
.wfp-footer__link {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  color: rgba(255,255,255,0.60);
  text-decoration: none;
  display: inline-block;
  position: relative;
  transition: color 0.2s ease;
  line-height: 2.2;
}
.wfp-footer__link:hover {
  color: #fff;
  text-decoration: underline;
}

/* ─── CONTACT INFO ─── */
.wfp-footer__contact {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 24px;
}
.wfp-footer__contact-item {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.60);
  text-decoration: none;
  transition: color 0.2s;
  line-height: 1.4;
}
a.wfp-footer__contact-item:hover {
  color: #7CB342;
}
.wfp-footer__contact-item--plain {
  cursor: default;
}

/* ─── BOTTOM BAR ─── */
.wfp-footer__bottom {
  border-top: 1px solid rgba(255,255,255,0.08);
  padding: 24px 80px;
  display: flex;
  align-items: center;
}
.wfp-footer__bottom-inner {
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.wfp-footer__copy {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.45);
  margin: 0;
}
.wfp-footer__brands {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  color: rgba(255,255,255,0.35);
  margin: 0;
}
.wfp-footer__bottom-links {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.45);
}
.wfp-footer__bottom-link {
  color: rgba(255,255,255,0.45);
  text-decoration: none;
  transition: color 0.2s;
}
.wfp-footer__bottom-link:hover {
  color: #fff;
  text-decoration: underline;
}

/* ─── RESPONSIVE ─── */
@media (max-width: 1100px) {
  .wfp-footer__body {
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
    padding: 60px 48px 48px;
  }
  .wfp-footer__col--brand { grid-column: 1 / -1; }
  .wfp-footer__cta { padding: 60px 48px; }
  .wfp-footer__bottom { padding: 24px 48px; }
}
@media (max-width: 768px) {
  .wfp-footer__cta { padding: 48px 24px; }
  .wfp-footer__cta-headline { font-size: 28px; }
  .wfp-footer__body {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 48px 24px 40px;
  }
  .wfp-footer__bottom {
    padding: 24px;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .wfp-footer__bottom-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .wfp-footer__brands { display: none; }
}
@media (max-width: 480px) {
  .wfp-footer__body { grid-template-columns: 1fr; }
  .wfp-footer__cta-btns { flex-direction: column; width: 100%; }
  .wfp-footer__cta-btn-primary,
  .wfp-footer__cta-btn-ghost { width: 100%; justify-content: center; }
}
</style>
