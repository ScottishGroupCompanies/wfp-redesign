        <li><a href="/benefits/glare-reduction/">Glare Reduction</a></li>
        <li><a href="/benefits/anti-graffiti/">Anti-Graffiti</a></li>
        <li><a href="/benefits/safety-and-security/">Safety &amp; Security</a></li>
        <li><a href="/benefits/decorative-promotional/">Decorative &amp; Promotional</a></li>
        <li><a href="/benefits/exterior-building-wraps/">Exterior Building Wraps</a></li>
        <li><a href="/benefits/exterior-refinishing/">Exterior Refinishing</a></li>
        <li><a href="/benefits/mirror-refinishing/">Mirror Refinishing</a></li>
        <li><a href="/benefits/bird-strike-prevention/">Bird Strike Prevention</a></li>
        <li><a href="/benefits/school-security-window-film/">School Security Film</a></li>
        <li><a href="/benefits/blast-mitigation/">Bomb Blast Protection</a></li>
        <li><a href="/benefits/ballistic-resistance/">Ballistic Resistant Film</a></li>
      </ul>
    </div>

    <!-- ── COL 4: Resources ── -->
    <div class="wfp-footer__resources">
      <h3 class="wfp-footer__col-header">RESOURCES</h3>
      <ul class="wfp-footer__links">
        <li><a href="/services/">Our Services</a></li>
        <li><a href="/resources/window-film-pricing/">Window Film Pricing Guide</a></li>
