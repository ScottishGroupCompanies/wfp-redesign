    <!-- ── COL 5: Get in Touch ── -->
    <div class="wfp-footer__contact">
      <h3 class="wfp-footer__col-header">GET IN TOUCH</h3>

      <a href="tel:+12673947980" class="wfp-footer__phone">(267) 394-7980</a>
      <a href="mailto:info@windowfilmphl.com" class="wfp-footer__email">info@windowfilmphl.com</a>
      <p class="wfp-footer__hours">Mon–Sat: 8am – 6pm</p>

      <div class="wfp-footer__divider"></div>

      <a href="/contact" class="wfp-footer__cta">Get a Free Quote →</a>
      <p class="wfp-footer__cta-sub">Free consultation · No pressure</p>
    </div>

  </div>

  <!-- ── BOTTOM BAR ── -->
  <div class="wfp-footer__bottom">
    <span>&copy; {currentYear} Window Film Philadelphia</span>
    <div class="wfp-footer__bottom-links">
      <a href="/contact">Contact</a>
      <a href="/sitemap-index.xml">Sitemap</a>
    </div>
  </div>
</footer>

<style>
/* ─── FOOTER BASE ─── */
.wfp-footer {
  background: #0d1a0f;
  color: #fff;
}

/* ─── MAIN INNER ─── */
.wfp-footer__inner {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr 0.8fr 1.2fr;
  gap: 40px;
  align-items: start;
  padding: 56px 80px;
}

/* ─── COL HEADER ─── */
.wfp-footer__col-header {
  font-family: 'Space Mono', monospace;
  font-size: 10px;
  font-weight: 400;
  color: #7CB342;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin: 0 0 20px 0;
}

/* ─── BRAND COLUMN ─── */
.wfp-footer__brand {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.wfp-footer__logo {
  display: block;
  margin-bottom: 16px;
  line-height: 0;
}

.wfp-footer__logo img {
  width: 160px;
  height: auto;
  display: block;
}

.wfp-footer__company {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 0.05em;
  margin: 8px 0 12px 0;
  line-height: 1.4;
}

.wfp-footer__tagline {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #fff;
  margin: 0 0 8px 0;
  line-height: 1.4;
}

.wfp-footer__body {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1.6;
  margin: 0 0 20px 0;
}

.wfp-footer__divider {
  width: 40px;
  height: 1px;
  background: #7CB342;
  margin-bottom: 20px;
  flex-shrink: 0;
}

.wfp-footer__social {
  display: flex;
  gap: 10px;
  margin-bottom: 16px;
}

.wfp-footer__social-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.7);
  text-decoration: none;
  transition: background 0.2s, color 0.2s;
  flex-shrink: 0;
}

.wfp-footer__social-icon:hover {
  background: #7CB342;
  color: #fff;
}

.wfp-footer__reviews-badge {
  display: flex;
  align-items: center;
  gap: 6px;
}

.wfp-footer__stars {
  display: flex;
  gap: 1px;
}

.wfp-footer__reviews-text {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: #fff;
}

/* ─── RESOURCES COLUMN ── */
.wfp-footer__resources {
  padding-top: 4px; /* align header with brand tagline */
}

.wfp-footer__links {
  list-style: none;
  margin: 0;
  padding: 0;
}

.wfp-footer__links li {
  line-height: 1;
}

.wfp-footer__links a {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  color: rgba(255, 255, 255, 0.65);
  text-decoration: none;
  display: inline-block;
  line-height: 2.4;
  transition: color 0.2s;
}

.wfp-footer__links a:hover {
  color: #fff;
}

/* ─── CONTACT COLUMN ── */
.wfp-footer__contact {
  padding-top: 4px; /* align header with brand tagline */
}

.wfp-footer__phone {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 32px;
  font-weight: 700;
  color: #fff;
  text-decoration: none;
  margin-bottom: 4px;
  line-height: 1.1;
  transition: color 0.2s;
}

.wfp-footer__phone:hover {
  color: #7CB342;
}

.wfp-footer__email {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  color: rgba(255, 255, 255, 0.60);
  text-decoration: none;
  margin-bottom: 4px;
  transition: color 0.2s;
}

.wfp-footer__email:hover {
  color: #fff;
}

.wfp-footer__hours {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.45);
  margin: 0 0 24px 0;
  line-height: 1.4;
}

.wfp-footer__contact .wfp-footer__divider {
  margin-bottom: 24px;
}

.wfp-footer__cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 50px;
  background: #7CB342;
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 700;
  text-decoration: none;
  border-radius: 8px;
  margin-bottom: 10px;
  transition: background 0.2s;
}

.wfp-footer__cta:hover {
  background: #2E6B30;
}

.wfp-footer__cta-sub {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.40);
  text-align: center;
  margin: 0;
  line-height: 1;
}

/* ─── BOTTOM BAR ─── */
.wfp-footer__bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  padding: 20px 80px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
}

.wfp-footer__bottom span,
.wfp-footer__bottom-links a {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.35);
  text-decoration: none;
}

.wfp-footer__bottom-links {
  display: flex;
  gap: 16px;
}

.wfp-footer__bottom-links a:hover {
  color: rgba(255, 255, 255, 0.7);
}

/* ─── RESPONSIVE ─── */
@media (max-width: 1024px) {
  .wfp-footer__inner {
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
    padding: 48px 40px;
  }

  .wfp-footer__brand {
    grid-column: 1 / -1;
  }

  .wfp-footer__contact {
    grid-column: 1 / -1;
  }

  .wfp-footer__cta {
    max-width: 320px;
  }

  .wfp-footer__bottom {
    padding: 20px 40px;
  }
}

@media (max-width: 640px) {
  .wfp-footer__inner {
    grid-template-columns: 1fr;
    gap: 40px;
    padding: 40px 24px;
  }

  .wfp-footer__contact {
    grid-column: auto;
  }

  .wfp-footer__cta {
    max-width: 100%;
  }

  .wfp-footer__phone {
    font-size: 26px;
  }

  .wfp-footer__bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 20px 24px;
  }
}
</style>
