<script>
// Tab Switching Logic
document.addEventListener('DOMContentLoaded', () => {
  const tabs = document.querySelectorAll('.benefits-new__tab');
  const imageSets = document.querySelectorAll('.benefits-new__image-set');
  const panels = document.querySelectorAll('.benefits-new__panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;

      // Update tabs
      tabs.forEach(t => t.classList.remove('benefits-new__tab--active'));
      tab.classList.add('benefits-new__tab--active');

      // Update image sets
      imageSets.forEach(set => {
        if (set.dataset.tab === target) {
          set.style.opacity = '1';
          set.style.visibility = 'visible';
        } else {
          set.style.opacity = '0';
          set.style.visibility = 'hidden';
        }
      });

      // Update content panels
      panels.forEach(panel => {
        if (panel.dataset.tab === target) {
          panel.style.display = 'block';
        } else {
          panel.style.display = 'none';
        }
      });
    });
  });
});
</script>
