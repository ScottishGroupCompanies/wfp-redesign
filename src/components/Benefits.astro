  <div class="benefits-new__main">
    
    <!-- LEFT COLUMN: Tabs Sidebar -->
    <div class="benefits-new__tabs">
      
      <button class="benefits-new__tab benefits-new__tab--active" data-tab="energy">
        <svg class="benefits-new__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
