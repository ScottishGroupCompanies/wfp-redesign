---
// Benefits — Completely rebuilt with left tabs + right content (3-image grid + content below)
---

<section class="benefits-new" id="benefits">
  
  <!-- Section Header -->
  <div class="benefits-new__header">
    <p class="benefits-new__label">BENEFITS</p>
    <h2 class="benefits-new__title">Why Philadelphia chooses window film</h2>
